{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "poke-guide",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// OP.GG使用率データ(scripts/opgg/fetch-champions-usage.mjs)の保存先。
	// GitHub Actions (fetch-opgg-champions-usage.yml) が日次でここに書き込み、
	// src/pages/data/index.astro・src/pages/box/data.astro がランタイムで読む。
	// 以前はremote: trueで本番KVを直接参照していたが、astro dev起動のたびに
	// リモートKVプロキシ接続(workerdプロセスをもう1つ起動、実測+約530MB)が必要になり、
	// dev起動失敗(30秒起動タイムアウトと際どく競合)・/api/opgg-usage系の同時リクエスト詰まり
	// (docs/perf/dashboard.md記載の既知bug)の原因になっていたため、remote: falseに変更した
	// (2026-09-08)。ローカルKVは空スタートになるため、OP.GGデータ依存ページはdevでは空表示になる。
	"kv_namespaces": [
		{
			"binding": "OPGG_USAGE",
			"id": "f165418c82fa4eac9dff837ddaa8e4ab",
			"remote": false
		}
	],
	// Phase 5-1 の集計バッチ(開発プラン §2.5, §3 Phase5-1)。集計ジョブが1種類のみのため
	// 分スロット分岐(poke-research の DAILY_SLOT_JOBS パターン)は導入せず、cron 1件から
	// src/worker.ts の scheduled ハンドラで refresh_popular_builds を直接呼ぶ。
	// ジョブが増えたら scheduled 側で event.cron の値により分岐する(Cron Trigger は
	// アカウントごと上限5件、poke-commonsはこの1件に集約する方針)。
	"triggers": {
		"crons": ["0 18 * * *"]
	}
}
