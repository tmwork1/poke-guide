{
	"name": "poke-guide",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "astro dev --host",
		"shot": "node scripts/shot.mjs",
		"test": "node --test \"tests/**/*.test.ts\"",
		"pretest:e2e": "npm run build",
		"test:e2e": "playwright test",
		"test:perf": "playwright test --config=playwright.perf.config.ts",
		"test:e2e:update-fixtures": "python tests/e2e/fixtures/generate_expected.py",
		"build:master-data": "node scripts/build-master-data/build.mjs",
		"generate:type-icons": "python scripts/type-icons/generate_type_icons.py",
		"generate:pokemon-artwork": "python scripts/pokemon-artwork/generate_pokemon_artwork.py",
		"generate:pokemon-champion-sprites": "python scripts/pokemon-champion-sprites/generate_pokemon_champion_sprites.py",
		"build": "npm run build:master-data && astro build",
		"preview": "npm run build && astro preview",
		"astro": "astro",
		"generate-types": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"migrate": "node ./scripts/db/run-migrations.mjs",
		"seed-dev-user": "node ./scripts/db/seed-dev-user.mjs",
		"seed-dummy-owned-pokemon": "node ./scripts/db/seed-dummy-owned-pokemon.mjs",
		"seed-dummy-damage-calcs": "node ./scripts/db/seed-dummy-damage-calcs.mjs",
		"refresh-suggestions": "node ./scripts/db/refresh-suggestions.mjs",
		"backfill-archetypes": "node ./scripts/db/backfill-archetypes.mjs",
		"backfill-ranked-archetypes": "node ./scripts/db/backfill-ranked-archetypes.mjs",
		"fetch:opgg-champions-usage": "node scripts/opgg/fetch-champions-usage.mjs",
		"ranker:fetch-teams": "python scripts/ranker/fetch_team_json.py",
		"ranker:fetch-articles": "python scripts/ranker/fetch_search_pages.py",
		"ranker:index": "python scripts/ranker/extract_articles.py",
		"ranker:download": "python scripts/ranker/download_articles.py",
		"ranker:refetch-naver": "python scripts/ranker/refetch_naver.py",
		"ranker:pokesol": "python scripts/ranker/build_pokesol.py",
		"ranker:text": "python scripts/ranker/html2text.py",
		"ranker:tasks": "python scripts/ranker/make_tasks.py",
		"ranker:build": "python scripts/ranker/build_ranked_teams.py",
		"ranker:seed": "node scripts/db/seed-ranked-teams.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.1",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.0.0",
		"astro": "^7.0.6",
		"pg": "^8.10.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"wrangler": "^4.107.0"
	}
}
