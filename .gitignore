# environment variables
.env
.env.local
.env.*.local
.env.production

# node dependencies (PoC計測スクリプト用に一時インストール)
node_modules/

# build output
dist/

# jpoke (別リポジトリ) から毎回のビルドで再生成するマスタデータ (scripts/build-master-data)
public/master-data/

# vendor/jpoke は src/ 一式をコミット対象として同梱するが、`python -m build` (wheel化) や
# import 実行 (extract_autocomplete.py) がその場で生成する副産物はビルドのたびに再生成
# されるためコミットしない。
vendor/jpoke/build/
vendor/jpoke/src/*.egg-info/

# Python のバイトコードキャッシュ (scripts/type-icons, scripts/ranker 等が生成する)
__pycache__/

# generated types
.astro/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# wrangler が生成する Env 型定義(実行環境依存のため通常コミットしない)
worker-configuration.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# Playwright (Phase 2-5 E2E回帰テスト) の実行結果・レポート・トレース
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# パフォーマンス計測の生データ(履歴)。実行のたびに増えるため生成物として除外し、
# docs/perf/dashboard.md(npm run test:perf で自動更新される表)だけを恒久的な記録とする。
/docs/perf/results/

# Claude Code: skills/ はチーム共有のためコミットするが、ローカル状態は除外する
.claude/settings.local.json
.claude/scheduled_tasks.lock

# UI検証で一時的に作る Playwright スクリプト (作った本人が消す運用)
/.tmp-*

# scripts/pokemon-champion-sprites/realesrgan_tool.py が初回実行時にダウンロードする
# Real-ESRGAN実行ファイル(OSごとに再取得可能なため恒久的にコミットしない)
/scripts/pokemon-champion-sprites/.cache/

