---
// Phase 4-2: 技詳細ページ。
// public/master-data/detail/moves.json はビルド時に確定する静的データ(DB非依存)なので
// getStaticPaths() でビルド時に全ページを事前生成する(pokemon/[name].astro と同じ方針。
// prerender=false は付けない)。該当技が存在しない name は getStaticPaths() の
// 対象外になるため自然に404になる。
import movesDetailRaw from '../../../public/master-data/detail/moves.json';
// ラウンド14 B-3: ヒット回数(hits: [min, max])は autocomplete/moves.json 側だけが持つ
// (detail/moves.json にはこのフィールドが無い。scripts/build-master-data/extract_autocomplete.py
// build_moves() 参照)。detail側のpower/accuracy等と技名でjoinして使う。
import movesAutocompleteRaw from '../../../public/master-data/autocomplete/moves.json';
// ラウンド14 B-10: 「この技を覚えるポケモン」の逆引きに使う。detail/pokemon.json の
// learnset は「自分が覚える技の一覧」の順方向データしか持たないため、全1290種ぶんを
// ビルド時に1回走査して技名→ポケモン名配列の逆引きマップを作る(pokemon/[name].astro の
// B-9(進化後)が preEvolution を逆引きしたのと同じ方針。追加データ生成は不要)。
import pokemonDetailRaw from '../../../public/master-data/detail/pokemon.json';
import { toPokemonPathSegment } from '../../lib/pokemon-slug';
import AppLayout from '../../layouts/AppLayout.astro';
// ラウンド13 A-9: /box が確立した「公式絵/タイプアイコンPNGによる同定」の語彙をこのページにも
// 移植する。typeIconUrl() は和名タイプ名からURLを組み立てるだけの純粋関数なので、
// クライアントJSを使わずビルド時(SSG)の静的HTMLにそのまま焼き込める。
import { typeIconUrl } from '../../lib/sprite-urls';
// ラウンド13 Coordinatorの判断(round-13.md「Coordinatorの判断」節): A-9は3段構成として
// 設計されており、2段目までの実装だけでは画面下部に大きな空白が残る。B-2(タイプ相性)と
// B-4(期待値)を3段目として追加し、A-9を完成させる。
import { getTypeEffectiveness } from '../../lib/type-chart';

type MoveCategory = 'physical' | 'special' | 'status';
type MoveTarget = 'foe' | 'self' | 'field' | 'own_side' | 'foe_side';

interface MoveDetail {
	name: string;
	type: string | null;
	category: MoveCategory;
	power: number | null;
	accuracy: number | null;
	pp: number;
	priority: number;
	critRatio: number;
	target: MoveTarget;
}

// scripts/build-master-data が生成する moves.json は連番インデックスをキーにしたオブジェクト
// (name はキーではなく値の中のフィールド)なので、静的パス生成には Object.values() を使う。
// (Cloudflareアダプタのprerender用ワーカーが getStaticPaths を単独抽出する際、
// モジュールスコープの中間変数を経由すると参照が失われるため、関数内で直接組み立てる)
export function getStaticPaths() {
	const movesDetail = movesDetailRaw as Record<string, MoveDetail>;
	return Object.values(movesDetail).map((move) => ({
		params: { name: move.name },
		props: { move },
	}));
}

interface Props {
	move: MoveDetail;
}

// ラウンド14 B-3: autocomplete/moves.json の hits ([min, max])を技名でjoinする。
// 716件中hitsを持つのは連続技23件のみ(それ以外はキー自体が無い)。
interface MoveAutocompleteEntry {
	name: string;
	type: string | null;
	category: MoveCategory;
	hits?: [number, number];
}
const movesAutocompleteMap = new Map(
	(movesAutocompleteRaw as MoveAutocompleteEntry[]).map((m) => [m.name, m]),
);

// ラウンド14 B-10: 技名 -> 覚えるポケモン名配列の逆引きマップ。モジュールスコープで1回だけ
// 全1290種のlearnsetを走査する(716ページそれぞれで毎回全件スキャンする無駄を避ける)。
interface PokemonDetailForLearners {
	name: string;
	learnset: string[];
}
const pokemonDetailForLearners = Object.values(
	pokemonDetailRaw as Record<string, PokemonDetailForLearners>,
);
const TOTAL_POKEMON_COUNT = pokemonDetailForLearners.length;
const learnerNamesByMove = new Map<string, string[]>();
for (const p of pokemonDetailForLearners) {
	for (const moveName of p.learnset) {
		const list = learnerNamesByMove.get(moveName);
		if (list) {
			list.push(p.name);
		} else {
			learnerNamesByMove.set(moveName, [p.name]);
		}
	}
}

const { move } = Astro.props as Props;

const CATEGORY_LABELS: Record<MoveCategory, string> = {
	physical: '物理',
	special: '特殊',
	status: '変化',
};

const TARGET_LABELS: Record<MoveTarget, string> = {
	foe: '相手1体',
	self: '自分',
	field: '場全体',
	own_side: '自分側の場',
	foe_side: '相手側の場',
};

// ラウンド9 A-9の指示どおり、変化技(威力を持たない技)の威力セルは列自体を消さず「–」
// (en dash, U+2013。他の値で使う半角ハイフン"-"とは別の文字。round-09.md A-9で明示された文字)
// で埋める。列を消すと技どうしを威力で見比べられなくなるため。
const powerLabel = move.power != null ? String(move.power) : '–';
const accuracyLabel = move.accuracy != null ? `${move.accuracy}%` : '必中';
const critLabel = move.critRatio > 0 ? `通常+${move.critRatio}段階` : '通常';

// タイプアイコンは既知19種のみ(sprite-urls.tsのTYPE_NAME_TO_ID参照)。moves.jsonの716件中
// 「わるあがき」1件だけtype:nullで、それ以外は全件このマップに含まれることをビルド時データで
// 確認済みなのでtypeIconUrl()は非nullを返す想定だが、念のためnullガードは残す。
const typeIconSrc = move.type ? typeIconUrl(move.type) : null;

const isStatusMove = move.category === 'status';

// --- 3段目その1: B-2 タイプ相性(round-09.md B-2 / round-13.md Coordinatorの判断) ---
// 変化技はダメージを与えないためタイプ相性の意味が変わる。相性表を出しても採用判断の材料に
// ならないので、セクション自体は残しつつ「なぜ出ないか」が読み取れる注記に置き換える。
// (わるあがきのような type:null の攻撃技は getTypeEffectiveness(null) が
// 「常に等倍」として扱う。理由は .claude/skills/jpoke/references/ruleset.md
// 「4. タイプ相性」の追記を参照: TYPE_MODIFIER.get(None, {}) が空dictを返すため。)
const typeEffectivenessGroups = isStatusMove ? [] : getTypeEffectiveness(move.type);

// --- 3段目その2: B-4 期待値(威力×命中) ---
// 「-」を並べるとデータ破損に見えるため、数値を出せない2パターン(変化技/威力が固定値でない
// 攻撃技)はそれぞれ理由の分かる注記にする。命中「必中」(accuracy: null)の技は
// 常に命中する技なので、命中率100%として計算する(必中を0%相当として扱うと期待値が0になり誤り)。
let expectedValue: { display: string; formula: string } | null = null;
let expectedValueNote: string | null = null;
if (isStatusMove) {
	expectedValueNote = '変化技はダメージを与えないため、期待値は算出できません。';
} else if (move.power == null) {
	// moves.jsonの実データ確認: カウンター/じわれ/ぜったいれいど/ミラーコート/メタルバースト等、
	// 変化技ではないのに威力が固定値ではない(相手の残りHPや受けたダメージ量などで決まる)技が
	// 14件存在する。round-09.md B-4の「威力が無い変化技」の指示は変化技のケースのみ触れているが、
	// 同じ理由(数値がないのに'-'を出すと壊れて見える)がこの14件にも当てはまるため同様に扱う。
	expectedValueNote = 'この技は威力が固定値ではなく特殊な計算式(相手の残りHPや受けたダメージ量など)で決まるため、期待値は算出できません。';
} else {
	const effectiveAccuracy = move.accuracy ?? 100;
	const raw = (move.power * effectiveAccuracy) / 100;
	const display = Number.isInteger(raw) ? String(raw) : raw.toFixed(1);
	const accuracyFormulaLabel = move.accuracy != null ? `${move.accuracy}%` : '必中(100%として計算)';
	expectedValue = { display, formula: `威力${move.power} × 命中${accuracyFormulaLabel}` };
}

// --- 2段目の下: B-3 連続技のヒット回数(round-09.md B-3) ---
// hitsが無い技(716件中693件)は単発技なので、この節自体を出さない(空枠や"-"を出さない)。
// 2〜5回技の内訳は均等ではない。出典は
// .claude/skills/jpoke/references/damage-calc.md「3. 急所・命中・多段ヒットの扱い」
// (vendor/jpoke/src/jpoke/core/move_executor.py:22-27,129-138 の MULTI_HIT_DISTRIBUTION_2_TO_5)。
//
// 【damage-calc.mdに無かったため今回ソースを読んで確認した点(→ 同ファイルに出典つきで追記済み)】
// 固定回数(min===max)の技23件中3件(ネズミざん/トリプルキック/トリプルアクセル)は
// check_hit_each_time=Trueで「1ヒットごとに命中判定」される。他の固定回数技(check_hit_each_time
// =False)は最初の1回だけ命中判定し、当たれば残りは自動で全ヒットする。この3件だけ「技が当たれば
// 必ずN回」という説明が誤りになるため、個別の文言に分ける。
// さらにふくろだたき(hits: [1,6])はこの一般ルートを通らず、ON_MODIFY_HIT_COUNTハンドラ
// (vendor/jpoke/src/jpoke/handlers/move_attack.py:3049-3054)が選出中の生存かつ状態異常でない
// ポケモン数をそのままヒット回数にする。乱数ではなくパーティ構成で決まるため、確率分布としては
// 出さない(誤解を招くため)。
const HIT_CHECK_EACH_TIME_MOVES = new Set(['ネズミざん', 'トリプルキック', 'トリプルアクセル']);
const MULTI_HIT_DISTRIBUTION_2_TO_5: [number, number][] = [
	[2, 0.375],
	[3, 0.375],
	[4, 0.125],
	[5, 0.125],
];

type HitsView =
	| { kind: 'party'; note: string }
	| { kind: 'guaranteed'; note: string }
	| { kind: 'per-hit-check'; note: string; expectedNote: string }
	| { kind: 'uniform'; note: string }
	| { kind: 'distribution'; rows: { count: number; pctLabel: string }[]; averageLabel: string };

const hits = movesAutocompleteMap.get(move.name)?.hits ?? null;
const hitsRangeLabel = hits ? (hits[0] === hits[1] ? `${hits[0]}回` : `${hits[0]}〜${hits[1]}回`) : null;
let hitsView: HitsView | null = null;
if (hits) {
	const [minHits, maxHits] = hits;
	if (move.name === 'ふくろだたき') {
		hitsView = {
			kind: 'party',
			note:
				'ランダムな抽選ではなく、選出したポケモンのうち「ひんし」でも「状態異常」でもない数だけヒットします(最小1回・最大6回)。1ヒットあたりの威力も使用者の攻撃種族値で決まるため、上の「威力」欄の値とは別物です。',
		};
	} else if (minHits === maxHits) {
		if (HIT_CHECK_EACH_TIME_MOVES.has(move.name)) {
			const p = (move.accuracy ?? 100) / 100;
			const expected = p >= 1 ? maxHits : (p * (1 - p ** maxHits)) / (1 - p);
			hitsView = {
				kind: 'per-hit-check',
				note: `最大${maxHits}回ヒットを試みますが、1回でも外れるとそこで止まります(1ヒットごとに命中率${accuracyLabel}で判定)。`,
				expectedNote: `命中率${accuracyLabel}として計算すると、期待ヒット回数は約${expected.toFixed(1)}回です。`,
			};
		} else {
			hitsView = {
				kind: 'guaranteed',
				note: `技が命中すれば、追加の抽選なく必ず${maxHits}回ヒットします(外れれば0回)。`,
			};
		}
	} else if (minHits === 2 && maxHits === 5) {
		const averageValue = MULTI_HIT_DISTRIBUTION_2_TO_5.reduce((sum, [count, prob]) => sum + count * prob, 0);
		hitsView = {
			kind: 'distribution',
			rows: MULTI_HIT_DISTRIBUTION_2_TO_5.map(([count, prob]) => ({
				count,
				pctLabel: `${(prob * 100).toFixed(1)}%`,
			})),
			averageLabel: averageValue.toFixed(1),
		};
	} else {
		// 現在の全716件データでは到達しない防御的フォールバック(2〜5回・固定回数のどちらでもない
		// 範囲が将来のデータ更新で増えた場合に、無表示や誤表示になるより一様抽選として説明する)。
		hitsView = {
			kind: 'uniform',
			note: `${minHits}〜${maxHits}回の範囲でランダムに決まります(範囲内は均等な確率)。`,
		};
	}
}

// --- 3段目その3: B-10 この技を覚えるポケモン(round-09.md B-10) ---
// round-09.md の判断: 「まもるは1267/1290種なので全件リストは無意味。件数のみ、または
// 100種未満のときだけリスト」。0種のケース(全716技中218技)も実在するため、0/1〜99/100以上の
// 3パターンに分ける。
const learnerNames = learnerNamesByMove.get(move.name) ?? [];
const learnerCount = learnerNames.length;
---
<AppLayout title={move.name} backHref="/search" backLabel="検索に戻る">
	<style>
		/* --- 1段目: identity block(technical name + type icon + category badge) ---
		   round-09.md A-9: 「/moves に画像が入るのはこれが初めて」。公式絵が無いこのページでは
		   タイプアイコンが/boxの公式絵に相当する主識別要素なので40pxと大きめに扱う。 */
		.move-identity {
			display: flex;
			align-items: center;
			gap: var(--space-4);
		}
		.move-type-icon {
			display: block;
			width: 40px;
			height: 40px;
			border-radius: 50%;
			/* box/[id].astroの.type-badge-img等と同じ理屈: 事前生成済みの正方形アイコンなので
			   object-fitでの切り出しは不要。淡い背景に重なっても輪郭が見えるよう縁取りだけ足す。 */
			filter: drop-shadow(0 0 1px var(--color-surface));
			border: 1px solid var(--color-border);
		}
		.move-name {
			/* global.cssの.panel h2(区切り線付きセクション見出し)を打ち消す。
			   ここは「タイプ」「種族値」のようなセクション見出しではなく、identity block内の
			   技名(/boxのカード見出しに相当)なので下線は不要(意図せぬ帯として見えていた)。 */
			margin: 0;
			padding-bottom: 0;
			border-bottom: none;
			font-size: var(--font-size-2xl);
			line-height: var(--line-height-tight);
		}
		.move-identity-meta {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: var(--space-3);
			margin-top: var(--space-2);
		}
		.move-type-name {
			font-weight: 600;
			color: var(--color-text-muted);
		}
		/* 分類バッジは既存の.badge(global.css)の形状をそのまま流用し、色だけ物理/特殊/変化で
		   出し分ける。severity-bar/.status-textと同じ「data属性で配色を切り替える」語彙に揃える。
		   WCAG 1.4.1対応: 色だけで分類を伝えないよう、バッジ自体がラベルテキスト(物理/特殊/変化)を
		   持つ(アイコン+色+テキストの三重化)。新色は作らずprimary/danger/mutedの既存トークンのみ使用。 */
		.category-badge[data-category="physical"] {
			background: var(--color-danger-soft);
			color: var(--color-danger-strong);
		}
		.category-badge[data-category="special"] {
			background: var(--color-primary-soft);
			color: var(--color-primary-strong);
		}
		.category-badge[data-category="status"] {
			background: var(--color-surface-alt);
			color: var(--color-text-muted);
		}

		/* --- 2段目: 威力/命中/PP/優先度/急所/対象の6列グリッド ---
		   round-09.md A-9・A-5と同じ語彙(box/[id].astroの.damage-ev-gridと同型): 素の<table>は
		   使わず、DOMは行優先(見出し6セル→値6セル)のCSSグリッドにする。数値は.tnumで桁を揃える。
		   罫線は使わない(A-5で罫線由来のコントラスト不足が問題化したのと同じ理由を避ける)。 */
		.move-stat-grid {
			display: grid;
			grid-template-columns: repeat(6, minmax(0, 1fr));
			gap: var(--space-2) var(--space-3);
		}
		.move-stat-grid-header {
			font-size: var(--font-size-sm);
			font-weight: 700;
			color: var(--color-text-muted);
			text-align: center;
		}
		.move-stat-grid-value {
			font-size: var(--font-size-xl);
			font-weight: 700;
			text-align: center;
			padding-top: 0.1rem;
		}

		/* --- 3段目: B-2 タイプ相性 + B-4 期待値(round-09.md B-2/B-4、round-13.md
		   Coordinatorの判断で/moves限定で今ラウンドに含めた項目) ---
		   round-09.md C-6「3枚の帯を推奨」に従い、段としては.panelを増やさず3段目の1枚に
		   B-2/B-4を2列で収める。640pxで1列に落とす(global.cssの「640pxはコンポーネント単位の
		   縦積み切り替え」の慣例に従う。900/1200/1600pxはレイアウト土台の段専用)。 */
		.move-extra-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-6);
		}
		@media (max-width: 640px) {
			.move-extra-grid {
				grid-template-columns: 1fr;
				gap: var(--space-5);
			}
		}
		.move-section-title {
			/* .panel h2(global.css)は罫線付きの重い見出しなので使わない(h2ではなくh3にして
			   対象外にする)。1枚のpanel内の2小見出しとして軽量にする。 */
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-md);
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.move-note {
			/* .card-hint(global.css)は「見出し直下に置く」前提の負のmargin-topを持つため、
			   見出し以外の直後にも置くここでは使わず独自クラスにする(round-13.mdで/shareが
			   同じ罠を踏んだ教訓。制約節に明記された注意)。 */
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}
		.move-type-group {
			border-radius: var(--radius-md);
			padding: var(--space-3);
			margin-bottom: var(--space-3);
		}
		.move-type-group:last-child {
			margin-bottom: 0;
		}
		.move-type-group-label {
			display: flex;
			align-items: baseline;
			gap: var(--space-2);
			margin: 0 0 var(--space-2);
			font-weight: 700;
		}
		.move-type-group-mult {
			font-size: var(--font-size-sm);
			font-weight: 700;
		}
		/* WCAG 1.4.1対応: 色だけで分類を伝えない。分類名テキスト(効果ばつぐん/いまひとつ/
		   効果がない)と倍率テキスト(×2/×0.5/×0)を必ず併記した上で、既存の
		   severity-bar(global.css)と同じ「soft背景+strong文字色」の語彙を配色トークンの
		   まま流用する(新色は作らない)。 */
		.move-type-group[data-category="super"] {
			background: var(--color-success-soft);
		}
		.move-type-group[data-category="super"] .move-type-group-label {
			color: var(--color-success-strong);
		}
		.move-type-group[data-category="not-very"] {
			background: var(--color-risky-soft);
		}
		.move-type-group[data-category="not-very"] .move-type-group-label {
			color: var(--color-risky-strong);
		}
		.move-type-group[data-category="no-effect"] {
			background: var(--color-danger-soft);
		}
		.move-type-group[data-category="no-effect"] .move-type-group-label {
			color: var(--color-danger-strong);
		}
		.move-type-group-icons {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin: 0;
			padding: 0;
			list-style: none;
		}
		.move-type-chip {
			display: inline-flex;
			align-items: center;
			gap: 0.35em;
			padding: 0.2em 0.7em 0.2em 0.4em;
			border-radius: 999px;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			font-size: var(--font-size-sm);
		}
		.move-type-chip-icon {
			display: block;
			width: 20px;
			height: 20px;
			border-radius: 50%;
		}
		.move-expected-value-body {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}
		.move-expected-value-number {
			font-size: var(--font-size-2xl);
			font-weight: 700;
			color: var(--color-primary-strong);
		}
		.move-expected-value-formula {
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}

		/* --- 2段目の下: B-3 連続技のヒット回数 ---
		   6列グリッド(既存の実測値・座標は不変)の下に続く追加ブロック。新しいpanelは作らず
		   既存panel内に収める(B-8「1行のためにパネルを作らない」の裏返しで、こちらは
		   1行に収まらない内容なので既存panel内に増築するのが妥当という判断)。 */
		.move-hits {
			margin-top: var(--space-5);
		}
		.move-hits .move-note + .move-note {
			margin-top: var(--space-2);
		}
		.move-hit-dist {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-4);
			margin: 0 0 var(--space-3);
			padding: 0;
			list-style: none;
		}
		.move-hit-dist-row {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.15em;
			min-width: 4.5em;
		}
		.move-hit-dist-count {
			font-size: var(--font-size-xl);
			font-weight: 700;
		}
		.move-hit-dist-pct {
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}

		/* --- 3段目の下: B-10 この技を覚えるポケモン ---
		   round-09.md「まもるは1267/1290種なので全件リストは無意味。件数のみ、または
		   100種未満のときだけリスト」の判断どおり、件数は必ず出しリストは条件付き。
		   タイプ相性/期待値の2列グリッドの下に続くので.move-type-chipと同じ「淡い背景の
		   ピル」語彙を流用しつつ、こちらはリンクなのでクラス名を分ける。 */
		.move-learners {
			margin-top: var(--space-5);
		}
		.move-learner-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin: var(--space-2) 0 0;
			padding: 0;
			list-style: none;
		}
		.move-learner-chip a {
			display: inline-flex;
			padding: 0.25em 0.75em;
			border-radius: 999px;
			background: var(--color-surface-alt);
			color: var(--color-text);
			text-decoration: none;
			font-size: var(--font-size-sm);
		}
		.move-learner-chip a:hover,
		.move-learner-chip a:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: -2px;
		}
	</style>
	<div class="page">
		<section class="panel">
			<div class="panel-content">
				<div class="move-identity">
					{move.type && typeIconSrc && (
						<img class="move-type-icon" src={typeIconSrc} width="40" height="40" alt="" />
					)}
					<div>
						<h2 class="move-name">{move.name}</h2>
						<div class="move-identity-meta">
							<span class="move-type-name">{move.type ?? 'タイプなし'}</span>
							<span class="badge category-badge" data-category={move.category}>{CATEGORY_LABELS[move.category]}</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="panel">
			<div class="panel-content">
				<div class="move-stat-grid">
					<span class="move-stat-grid-header">威力</span>
					<span class="move-stat-grid-header">命中</span>
					<span class="move-stat-grid-header">PP</span>
					<span class="move-stat-grid-header">優先度</span>
					<span class="move-stat-grid-header">急所</span>
					<span class="move-stat-grid-header">対象</span>
					<span class="move-stat-grid-value tnum">{powerLabel}</span>
					<span class="move-stat-grid-value tnum">{accuracyLabel}</span>
					<span class="move-stat-grid-value tnum">{move.pp}</span>
					<span class="move-stat-grid-value tnum">{move.priority}</span>
					<span class="move-stat-grid-value tnum">{critLabel}</span>
					<span class="move-stat-grid-value">{TARGET_LABELS[move.target]}</span>
				</div>
				{hits && hitsView && (
					<div class="move-hits">
						<h3 class="move-section-title">連続ヒット({hitsRangeLabel})</h3>
						{hitsView.kind === 'distribution' ? (
							<div>
								<ul class="move-hit-dist">
									{hitsView.rows.map((row) => (
										<li class="move-hit-dist-row">
											<span class="move-hit-dist-count tnum">{row.count}回</span>
											<span class="move-hit-dist-pct tnum">{row.pctLabel}</span>
										</li>
									))}
								</ul>
								<p class="move-note">技が命中した場合、平均<span class="tnum"> {hitsView.averageLabel} </span>回ヒットします。</p>
							</div>
						) : (
							<>
								<p class="move-note">{hitsView.note}</p>
								{hitsView.kind === 'per-hit-check' && <p class="move-note">{hitsView.expectedNote}</p>}
							</>
						)}
					</div>
				)}
			</div>
		</section>

		<section class="panel">
			<div class="panel-content">
				<div class="move-extra-grid">
					<div>
						<h3 class="move-section-title">タイプ相性</h3>
						{isStatusMove ? (
							<p class="move-note">変化技なのでタイプ相性でダメージは変わりません。</p>
						) : typeEffectivenessGroups.length === 0 ? (
							<p class="move-note">相手のタイプに関わらず、常に等倍(×1)のダメージになります。</p>
						) : (
							<div>
								{typeEffectivenessGroups.map((group) => (
									<div class="move-type-group" data-category={group.category}>
										<p class="move-type-group-label">
											<span>{group.label}</span>
											<span class="move-type-group-mult tnum">{group.multiplierLabel}</span>
										</p>
										<ul class="move-type-group-icons">
											{group.types.map((defType) => {
												const chipIconSrc = typeIconUrl(defType);
												return (
													<li class="move-type-chip">
														{chipIconSrc && (
															<img class="move-type-chip-icon" src={chipIconSrc} width="20" height="20" alt="" />
														)}
														<span>{defType}</span>
													</li>
												);
											})}
										</ul>
									</div>
								))}
							</div>
						)}
					</div>
					<div>
						<h3 class="move-section-title">期待値(威力 × 命中)</h3>
						{expectedValue ? (
							<div class="move-expected-value-body">
								<span class="move-expected-value-number tnum">{expectedValue.display}</span>
								<span class="move-expected-value-formula">{expectedValue.formula}</span>
							</div>
						) : (
							<p class="move-note">{expectedValueNote}</p>
						)}
					</div>
				</div>
				<div class="move-learners">
					<h3 class="move-section-title">この技を覚えるポケモン</h3>
					{learnerCount === 0 ? (
						<p class="move-note">現在のデータでは、この技を覚えるポケモンはいません。</p>
					) : (
						<>
							<p class="move-note">
								<span class="tnum">{learnerCount}</span> / <span class="tnum">{TOTAL_POKEMON_COUNT}</span> 種が覚えます。
								{learnerCount >= 100 && '(100種以上のため一覧は省略します)'}
							</p>
							{learnerCount < 100 && (
								<ul class="move-learner-list">
									{learnerNames.map((name) => (
										<li class="move-learner-chip">
											<a href={`/pokemon/${encodeURIComponent(toPokemonPathSegment(name))}`}>{name}</a>
										</li>
									))}
								</ul>
							)}
						</>
					)}
				</div>
			</div>
		</section>
	</div>
</AppLayout>
