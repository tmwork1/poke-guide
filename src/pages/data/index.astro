---
export const prerender = false;


import AppLayout from '../../layouts/AppLayout.astro';
import BattleDataCard from '../../components/data/BattleDataCard.astro';
import { hasSingleBattleData, type SingleFormatData } from '../../lib/battle-data-card';
import { getOpggUsageList, getOpggUsageManifest, sortOpggSeasons, type OpggUsageSeason } from '../../lib/opgg-usage';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import { getSupabasePublicClient } from '../../lib/supabase';
import { championSpriteUrl, officialArtworkUrl } from '../../lib/pokemon-master-data';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import { env } from 'cloudflare:workers';
import '../../styles/data-hub-page.css';
import '../../styles/battle-data-card.css';
import '../../styles/team-card.css';
import '../../styles/app-header.css';
import '../../styles/second-header.css';
import AppHeader from '../../components/AppHeader.astro';
import SecondHeader from '../../components/SecondHeader.astro';
import DataHubTabs from '../../components/data/DataHubTabs.astro';

let rankedSeasons: Awaited<ReturnType<typeof listRankedSeasons>> = [];
let rankedSeasonsError = '';
try {
  rankedSeasons = await listRankedSeasons(await getSupabasePublicClient());
} catch (error) {
  console.error('[data] ranked season loading failed:', error);
  rankedSeasonsError = 'シーズン一覧を読み込めませんでした。時間をおいて再度お試しください。';
}
const defaultRankedSeason = resolveDefaultSeason(rankedSeasons);
const isTopBuilds = Astro.props.activeTab === 'top-builds';

if (!isTopBuilds && Astro.url.searchParams.get('tab') === 'top-builds') {
  return Astro.redirect('/data/top-builds');
}

const seasonManifest = await getOpggUsageManifest(env.OPGG_USAGE);

const manifestSeasons = sortOpggSeasons(seasonManifest);

const requestedSeason = Astro.url.searchParams.get('season');
const seasonIds = manifestSeasons.map((entry) => entry.id);
const season = seasonIds.includes(requestedSeason ?? '') ? requestedSeason! : manifestSeasons[0]?.id ?? null;

// SSR出力・選択中オプション・共有URLを一致させる(box/data.astroと同じ理由)。
if (requestedSeason && season && requestedSeason !== season) {
	return Astro.redirect(`/data?season=${encodeURIComponent(season)}`);
}

const seasonEntry = manifestSeasons.find((entry) => entry.id === season);

// `:list` はsingleだけをランキング順に集約した /data 専用のキー。
const seasonList = seasonEntry ? await getOpggUsageList(env.OPGG_USAGE, seasonEntry as OpggUsageSeason) : null;

const masterByName = new Map(
  (pokemonMasterRaw as Array<{ name: string; imageId: number }>).map((entry) => [entry.name, entry.imageId]),
);

interface BattleDataEntry {
  rank: number;
  name: string;
  imageId: number | null;
  elementId: string;
  single: SingleFormatData;
}

const entries: BattleDataEntry[] = [];
if (seasonList?.pokemon) {
	for (const item of seasonList.pokemon) {
		if (!hasSingleBattleData({ formats: { single: item.single } })) continue;
		const rank = entries.length + 1;
		entries.push({
      rank,
      name: item.name,
      imageId: masterByName.get(item.name) ?? null,
      elementId: `battle-data-entry-${rank}`,
			single: item.single,
    });
  }
}
---

<AppLayout title="データ" current="data" bodyClass="data-hub-page">
	<AppHeader ariaLabel="データページの表示切り替え">
		<DataHubTabs active={isTopBuilds ? 'top-builds' : 'battle-data'} />
	</AppHeader>

	{!isTopBuilds && (
	<SecondHeader ariaLabel="バトルデータを検索・切り替え" class="battle-data-second-header" data-battle-data-header>
		<div class="second-header-search">
			<div class="search-input-wrap">
				<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input id="battle-data-search" type="search" class="field-control" placeholder="ポケモン" aria-label="ポケモンを検索" autocomplete="off" disabled={entries.length === 0} />
			</div>
		</div>
		{manifestSeasons.length > 0 && (
			<div class="battle-data-season-field">
				<label for="battle-data-season">シーズン</label>
				<select id="battle-data-season" class="field-control">
					{manifestSeasons.map((entry) => (
						<option value={entry.id} selected={entry.id === season}>{entry.label ?? entry.id}</option>
					))}
				</select>
			</div>
		)}
	</SecondHeader>
	)}

	{isTopBuilds && (
	<SecondHeader ariaLabel="上位チームを検索・切り替え" class="top-builds-second-header" data-top-builds-header>
		<div class="second-header-search">
			<div class="search-input-wrap">
				<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input id="top-builds-search" type="search" class="field-control" placeholder="ポケモン" aria-label="ポケモンを検索" autocomplete="off" />
			</div>
		</div>
		<div class="top-builds-season-field">
			<label for="top-builds-season">シーズン</label>
			<select id="top-builds-season" class="field-control" disabled={rankedSeasons.length === 0}>
				{rankedSeasons.map((entry) => <option value={entry.season} selected={entry.season === defaultRankedSeason}>{entry.season}</option>)}
			</select>
		</div>
	</SecondHeader>
	)}

	<div class="data-hub-scroll" data-data-hub-scroll>
		{!isTopBuilds && (
		<section class="panel data-hub-panel battle-data-panel" data-tab="battle-data">
			<div class="panel-content">
				{entries.length > 0 ? (
					<div class="battle-data-body">
						<nav class="battle-data-rail" aria-label="ポケモン一覧へジャンプ">
							{entries.map((entry) => (
								<a class="battle-data-rail-item" href={`#${entry.elementId}`} data-battle-data-rail-item data-species-name={entry.name} aria-label={entry.name}>
									{entry.imageId !== null && <img src={championSpriteUrl(entry.imageId)} onerror={`this.onerror=null;this.src='${officialArtworkUrl(entry.imageId)}';`} alt="" width="36" height="36" style="width:36px;height:36px;object-fit:contain;" loading="eager" />}
								</a>
							))}
						</nav>
						<div class="battle-data-list" id="battle-data-list">
							{entries.map((entry) => (
								<article class="battle-data-entry" id={entry.elementId} data-battle-data-entry data-species-name={entry.name}>
									<header class="battle-data-entry-header">
										<span class="badge battle-data-entry-rank" aria-label={`使用率順位 ${entry.rank}位`}>{entry.rank}</span>
										{entry.imageId !== null && <img class="battle-data-entry-icon" src={championSpriteUrl(entry.imageId)} onerror={`this.onerror=null;this.src='${officialArtworkUrl(entry.imageId)}';`} alt="" loading="lazy" />}
										<span class="battle-data-entry-name">{entry.name}</span>
									</header>
									<BattleDataCard single={entry.single} />
								</article>
							))}
						</div>
					</div>
				) : (
					<div class="empty-state">
						<p class="empty-state-icon" aria-hidden="true">📊</p>
						<p class="empty-state-title">{seasonEntry ? 'このシーズンのバトルデータはまだありません' : 'バトルデータはまだありません'}</p>
						<p class="empty-state-hint">対戦で役立つデータを掲載予定です。</p>
					</div>
				)}
			</div>
		</section>
		)}

		{isTopBuilds && (
		<section class="panel data-hub-panel top-builds-panel" data-tab="top-builds">
			<div class="panel-content">
				<main class="top-builds-list" data-default-season={defaultRankedSeason ?? ''} data-initial-error={rankedSeasonsError}>
					<p id="top-builds-loading" class="ranked-team-status">読み込み中…</p>
					<p id="top-builds-error" class="ranked-team-status" role="alert" hidden></p>
					<div id="top-builds-cards" class="team-grid"></div>
					<div id="top-builds-empty" class="empty-state" hidden>
						<p class="empty-state-icon" aria-hidden="true">🔍</p>
						<p class="empty-state-title">条件に一致するチームがありません</p>
						<p class="empty-state-hint">検索条件を変更してください。</p>
					</div>
					<div class="top-builds-load-more-wrap">
						<button type="button" id="top-builds-load-more" class="btn-ghost" hidden>もっと見る</button>
					</div>
				</main>
			</div>
		</section>
		)}
	</div>

	<script>
		import { setupAppHeaderSwipe } from '../../lib/app-header-swipe';

		const scrollContainer = document.querySelector<HTMLElement>('[data-data-hub-scroll]');
		setupAppHeaderSwipe(document.querySelector<HTMLElement>('.app-header'), scrollContainer);
		const activeHeader = document.querySelector<HTMLElement>('.battle-data-second-header, .top-builds-second-header');
		const bottomNav = document.querySelector<HTMLElement>('.app-bottom-nav');
		const syncScrollViewport = () => {
			if (!scrollContainer || !activeHeader) return;
			scrollContainer.style.setProperty('--data-hub-scroll-top', `calc(${activeHeader.getBoundingClientRect().bottom}px + var(--data-hub-card-scroll-inset))`);
			if (bottomNav) scrollContainer.style.setProperty('--data-hub-scroll-bottom', `calc(${window.innerHeight - bottomNav.getBoundingClientRect().top}px + var(--data-hub-card-scroll-inset))`);
		};
		syncScrollViewport();
		window.addEventListener('resize', syncScrollViewport);
		new ResizeObserver(syncScrollViewport).observe(activeHeader);
	</script>

	<script>
		import { kanaIncludes } from '../../lib/kana';

		const list = document.querySelector<HTMLElement>('#battle-data-list');
		const scrollContainer = document.querySelector<HTMLElement>('[data-data-hub-scroll]');
		const entries = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-battle-data-entry]')) : [];
		const railItems = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-battle-data-rail-item]'));
		const rail = document.querySelector<HTMLElement>('.battle-data-rail');
		const battleDataHeader = document.querySelector<HTMLElement>('.battle-data-second-header');
		const search = document.querySelector<HTMLInputElement>('#battle-data-search');
		const seasonSelect = document.querySelector<HTMLSelectElement>('#battle-data-season');
		const railBySpecies = new Map(railItems.map((item) => [item.dataset.speciesName ?? '', item]));
		let activeRailItem: HTMLAnchorElement | null = null;
		let syncFrame: number | undefined;
		let railDrivenUntil = 0;

		function markActiveRail(item: HTMLAnchorElement): void {
			if (activeRailItem === item) return;
			activeRailItem?.removeAttribute('aria-current');
			item.setAttribute('aria-current', 'true');
			activeRailItem = item;
		}

		function setActiveRail(speciesName: string): void {
			const item = railBySpecies.get(speciesName);
			if (!item || item.hidden) return;
			markActiveRail(item);
			if (!rail) return;
			const topAligned = item.offsetTop;
			railDrivenUntil = performance.now() + 100;
			rail.scrollTo({ top: Math.max(0, topAligned), behavior: 'auto' });
		}

		function visiblePairs(): Array<{ entry: HTMLElement; railItem: HTMLAnchorElement }> {
			return entries.flatMap((entry) => {
				const railItem = railBySpecies.get(entry.dataset.speciesName ?? '');
				return !entry.hidden && railItem && !railItem.hidden ? [{ entry, railItem }] : [];
			});
		}

		function interpolateOffset(position: number, source: HTMLElement[], target: HTMLElement[]): { offset: number; index: number } | null {
			if (source.length === 0 || source.length !== target.length) return null;
			let index = 0;
			while (index < source.length - 1 && source[index + 1].offsetTop <= position) index += 1;
			const nextIndex = Math.min(index + 1, source.length - 1);
			const sourceSpan = source[nextIndex].offsetTop - source[index].offsetTop;
			const ratio = sourceSpan > 0 ? Math.min(1, Math.max(0, (position - source[index].offsetTop) / sourceSpan)) : 0;
			return { offset: target[index].offsetTop + (target[nextIndex].offsetTop - target[index].offsetTop) * ratio, index };
		}

		function syncRailToCard(): void {
			if (!rail || !list || !scrollContainer || battleDataHeader?.hidden || performance.now() < railDrivenUntil) return;
			const pairs = visiblePairs();
			const scrollRect = scrollContainer.getBoundingClientRect();
			const listTop = scrollContainer.scrollTop + list.getBoundingClientRect().top - scrollRect.top;
			const mapped = interpolateOffset(
				scrollContainer.scrollTop - listTop,
				pairs.map((pair) => pair.entry),
				pairs.map((pair) => pair.railItem),
			);
			if (!mapped) return;
			markActiveRail(pairs[mapped.index].railItem);
			railDrivenUntil = performance.now() + 16;
			rail.scrollTo({ top: Math.max(0, mapped.offset), behavior: 'auto' });
		}

		function syncCardToRail(): void {
			if (!rail || !list || !scrollContainer || battleDataHeader?.hidden || performance.now() < railDrivenUntil) return;
			const pairs = visiblePairs();
			const mapped = interpolateOffset(rail.scrollTop, pairs.map((pair) => pair.railItem), pairs.map((pair) => pair.entry));
			if (!mapped) return;
			markActiveRail(pairs[mapped.index].railItem);
			railDrivenUntil = performance.now() + 16;
			const listTop = scrollContainer.scrollTop + list.getBoundingClientRect().top - scrollContainer.getBoundingClientRect().top;
			scrollContainer.scrollTo({ top: Math.max(0, listTop + mapped.offset), behavior: 'auto' });
		}

		function requestRailSync(): void {
			if (syncFrame !== undefined) return;
			syncFrame = requestAnimationFrame(() => {
				syncFrame = undefined;
				syncRailToCard();
			});
		}

		function applyFilter(): void {
			const term = search?.value ?? '';
			for (const entry of entries) {
				const name = entry.dataset.speciesName ?? '';
				const visible = term.trim() === '' || kanaIncludes(name, term);
				entry.hidden = !visible;
				const rail = railItems.find((item) => item.dataset.speciesName === name);
				if (rail) rail.hidden = !visible;
			}
			requestRailSync();
		}

		search?.addEventListener('input', applyFilter);

		for (const item of railItems) {
			item.addEventListener('click', (event) => {
				const targetId = item.getAttribute('href')?.slice(1);
				const target = targetId ? document.getElementById(targetId) : null;
				if (!target) return;
				event.preventDefault();
				setActiveRail(item.dataset.speciesName ?? '');
				// 横スワイプ用のスクロール領域へ、カードの座標を直接指定する。
				// scrollIntoView() ではページ側へスクロールが逃げることがある。
				if (!scrollContainer) return;
				const targetTop = scrollContainer.scrollTop + target.getBoundingClientRect().top - scrollContainer.getBoundingClientRect().top;
				// 一覧全体は長いため、smooth では遠い順位ほど到達まで時間が掛かる。
				// レールはジャンプ操作なので即時移動する。
				scrollContainer.scrollTo({ top: Math.max(0, targetTop), behavior: 'auto' });
			});
		}

		scrollContainer?.addEventListener('scroll', requestRailSync, { passive: true });
		rail?.addEventListener('scroll', syncCardToRail, { passive: true });
		requestRailSync();

		seasonSelect?.addEventListener('change', () => {
			const params = new URLSearchParams(window.location.search);
			params.set('season', seasonSelect.value);
			window.location.search = params.toString();
		});
	</script>

	<script>
		import type { RankedTeam } from '../../lib/ranked-teams';
		import { matchesSpeciesSearch, RANKED_TEAMS_PAGE_SIZE } from '../../lib/ranked-teams-validation';
		import { renderTopBuildCard } from '../../lib/ranked-teams/card';

		interface RankedTeamsResponse { season: string; teams: RankedTeam[]; }

		const root = document.querySelector<HTMLElement>('.top-builds-list');
		if (root) {
			const cards = document.querySelector<HTMLElement>('#top-builds-cards')!;
			const loading = document.querySelector<HTMLElement>('#top-builds-loading')!;
			const error = document.querySelector<HTMLElement>('#top-builds-error')!;
			const empty = document.querySelector<HTMLElement>('#top-builds-empty')!;
			const loadMore = document.querySelector<HTMLButtonElement>('#top-builds-load-more')!;
			const search = document.querySelector<HTMLInputElement>('#top-builds-search')!;
			const seasonSelect = document.querySelector<HTMLSelectElement>('#top-builds-season')!;
			const cache = new Map<string, RankedTeam[]>();
			let visibleCount = RANKED_TEAMS_PAGE_SIZE;
			let currentTeams: RankedTeam[] = [];
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;

			function filteredTeams(): RankedTeam[] {
				return currentTeams.filter((team) => matchesSpeciesSearch(team.members, search.value));
			}

			function render(): void {
				const filtered = filteredTeams();
				const visible = filtered.slice(0, visibleCount);
				cards.replaceChildren(...visible.map((team) => renderTopBuildCard(team)));
				empty.hidden = filtered.length !== 0;
				loadMore.hidden = visible.length >= filtered.length;
			}

			async function selectSeason(season: string): Promise<void> {
				loading.hidden = false;
				error.hidden = true;
				cards.replaceChildren();
				empty.hidden = true;
				loadMore.hidden = true;
				visibleCount = RANKED_TEAMS_PAGE_SIZE;
				try {
					if (!cache.has(season)) {
						const response = await fetch(`/api/ranked-teams?season=${encodeURIComponent(season)}`);
						if (!response.ok) throw new Error('上位チームを取得できませんでした');
						const payload = await response.json() as RankedTeamsResponse;
						cache.set(season, payload.teams);
					}
					currentTeams = cache.get(season) ?? [];
					render();
				} catch (cause) {
					currentTeams = [];
					error.textContent = cause instanceof Error ? cause.message : '上位チームを取得できませんでした';
					error.hidden = false;
				} finally {
					loading.hidden = true;
				}
			}

			search.addEventListener('input', () => {
				if (debounceTimer !== undefined) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					visibleCount = RANKED_TEAMS_PAGE_SIZE;
					render();
				}, 150);
			});
			seasonSelect.addEventListener('change', () => void selectSeason(seasonSelect.value));
			loadMore.addEventListener('click', () => {
				visibleCount += RANKED_TEAMS_PAGE_SIZE;
				render();
			});

			const initialError = root.dataset.initialError ?? '';
			const defaultSeason = root.dataset.defaultSeason ?? '';
			if (initialError || !defaultSeason) {
				loading.hidden = true;
				error.textContent = initialError || '表示できるシーズンがありません';
				error.hidden = false;
			} else {
				void selectSeason(defaultSeason);
			}
		}
	</script>
</AppLayout>
