---
export const prerender = false;


import AppLayout from '../../layouts/AppLayout.astro';
import BattleDataCard from '../../components/data/BattleDataCard.astro';
import type { SingleFormatData } from '../../lib/battle-data-card';
import { getOpggUsageBattleDataList, getOpggUsageManifest, sortOpggSeasons } from '../../lib/opgg-usage';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import { getSupabasePublicClient } from '../../lib/supabase';
import { championSpriteIconUrl, championSpriteUrl, officialArtworkUrl } from '../../lib/pokemon-master-data';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import { env } from 'cloudflare:workers';
import '../../styles/data-hub-page.css';
import '../../styles/battle-data-card.css';
import '../../styles/team-card.css';
import '../../styles/team-mate-card.css';
import '../../styles/app-header.css';
import '../../styles/second-header.css';
import '../../styles/ranked-teams-search-header.css';
import AppHeader from '../../components/AppHeader.astro';
import SecondHeader from '../../components/SecondHeader.astro';
import DataHubTabs from '../../components/data/DataHubTabs.astro';
import RankedTeamsSearchHeader from '../../components/ranked-teams/RankedTeamsSearchHeader.astro';

let rankedSeasons: Awaited<ReturnType<typeof listRankedSeasons>> = [];
let rankedSeasonsError = '';
try {
  rankedSeasons = await listRankedSeasons(await getSupabasePublicClient());
} catch (error) {
  console.error('[data] ranked season loading failed:', error);
  rankedSeasonsError = 'シーズン一覧を読み込めませんでした。時間をおいて再度お試しください。';
}
// 上位チームのシーズン取得に一時的に失敗しても、そのエラー画面を CDN に残さない。
// 成功時は従来どおりキャッシュ可能なレスポンスにする。
if (rankedSeasonsError) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const defaultRankedSeason = resolveDefaultSeason(rankedSeasons);
const isTopBuilds = Astro.props.activeTab === 'top-builds';

if (!isTopBuilds && Astro.url.searchParams.get('tab') === 'top-builds') {
  return Astro.redirect('/data/top-builds');
}

const seasonManifest = await getOpggUsageManifest(env.OPGG_USAGE);

const manifestSeasons = sortOpggSeasons(seasonManifest);

const requestedSeason = Astro.url.searchParams.get('season');
const seasonIds = manifestSeasons.map((entry) => entry.id);
const season = seasonIds.includes(requestedSeason ?? '') ? requestedSeason! : manifestSeasons[0]?.id ?? null;

// SSR出力・選択中オプション・共有URLを一致させる(box/data.astroと同じ理由)。
if (requestedSeason && season && requestedSeason !== season) {
	return Astro.redirect(`/data?season=${encodeURIComponent(season)}`);
}

const seasonEntry = manifestSeasons.find((entry) => entry.id === season);

const battleDataList = seasonEntry ? await getOpggUsageBattleDataList(env.OPGG_USAGE, seasonEntry) : [];

const masterByName = new Map(
  (pokemonMasterRaw as Array<{ name: string; imageId: number }>).map((entry) => [entry.name, entry.imageId]),
);

interface BattleDataEntry {
  rank: number;
  name: string;
  imageId: number | null;
  elementId: string;
  single: SingleFormatData;
}

const entries: BattleDataEntry[] = [];
for (const item of battleDataList) {
	const rank = entries.length + 1;
	entries.push({
      rank,
      name: item.name,
      imageId: masterByName.get(item.name) ?? null,
      elementId: `battle-data-entry-${rank}`,
		single: item.single,
    });
}

// 初期表示に必要な分だけSSRし、残りはカードを開く直前に共有レンダラーで差し込む。
// article自体は全件残すため、検索・ジャンプレールの対象と順序は従来どおりになる。
const BATTLE_DATA_SSR_CARD_COUNT = 8;
---

<AppLayout title="データ" current="data" bodyClass="data-hub-page">
	<AppHeader ariaLabel="データページの表示切り替え">
		<DataHubTabs active={isTopBuilds ? 'top-builds' : 'battle-data'} />
	</AppHeader>

	{!isTopBuilds && (
	<SecondHeader ariaLabel="バトルデータを検索・切り替え" class="battle-data-second-header" data-battle-data-header>
		<div class="second-header-search">
			<div class="search-input-wrap">
				<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input id="battle-data-search" type="search" class="field-control" placeholder="ポケモン・特性・もちもの・わざ" aria-label="ポケモン・特性・もちもの・わざを検索" autocomplete="off" disabled={entries.length === 0} />
			</div>
		</div>
		{manifestSeasons.length > 0 && (
			<div class="battle-data-season-field">
				<select id="battle-data-season" class="field-control">
					{manifestSeasons.map((entry) => (
						<option value={entry.id} selected={entry.id === season}>{entry.label ?? entry.id}</option>
					))}
				</select>
			</div>
		)}
	</SecondHeader>
	)}

	{isTopBuilds && (
		<RankedTeamsSearchHeader
			idPrefix="top-builds"
			seasons={rankedSeasons}
			defaultSeason={defaultRankedSeason}
			class="top-builds-second-header"
		/>
	)}

	<div class="data-hub-scroll" data-data-hub-scroll>
		{!isTopBuilds && (
		<section class="panel data-hub-panel battle-data-panel" data-tab="battle-data">
			<div class="panel-content">
				{entries.length > 0 ? (
					<div class="battle-data-body">
						<nav class="battle-data-rail" aria-label="ポケモン一覧へジャンプ">
							{entries.map((entry) => (
								<a class="battle-data-rail-item" href={`#${entry.elementId}`} data-battle-data-rail-item data-species-name={entry.name} aria-label={entry.name}>
									{entry.imageId !== null && <img src={championSpriteIconUrl(entry.imageId)} onerror={`this.onerror=()=>{this.onerror=()=>{this.onerror=null;this.src='${officialArtworkUrl(entry.imageId)}';};this.src='${championSpriteUrl(entry.imageId)}';};`} alt="" width="36" height="36" style="width:36px;height:36px;object-fit:contain;" loading="lazy" />}
								</a>
							))}
						</nav>
						<div class="battle-data-list" id="battle-data-list">
							{entries.map((entry) => (
								<article
									class="battle-data-entry"
									id={entry.elementId}
									data-battle-data-entry
									data-battle-data-pending={entry.rank > BATTLE_DATA_SSR_CARD_COUNT ? '' : undefined}
									data-species-name={entry.name}
									data-search-text={[
										entry.name,
										...(entry.single.abilities ?? []).map((row) => row.name),
										...(entry.single.items ?? []).map((row) => row.name),
										...(entry.single.moves ?? []).map((row) => row.name),
									].join(' ')}
								>
									<header class="battle-data-entry-header">
										<span class="badge battle-data-entry-rank" aria-label={`使用率順位 ${entry.rank}位`}>{entry.rank}</span>
										{entry.imageId !== null && <img class="battle-data-entry-icon" src={championSpriteIconUrl(entry.imageId)} onerror={`this.onerror=()=>{this.onerror=()=>{this.onerror=null;this.src='${officialArtworkUrl(entry.imageId)}';};this.src='${championSpriteUrl(entry.imageId)}';};`} alt="" loading="lazy" />}
										<span class="battle-data-entry-name">{entry.name}</span>
									</header>
									{entry.rank <= BATTLE_DATA_SSR_CARD_COUNT && <BattleDataCard single={entry.single} />}
								</article>
							))}
						</div>
					</div>
				) : (
					<div class="empty-state">
						<p class="empty-state-icon" aria-hidden="true">📊</p>
						<p class="empty-state-title">{seasonEntry ? 'このシーズンのバトルデータはまだありません' : 'バトルデータはまだありません'}</p>
						<p class="empty-state-hint">対戦で役立つデータを掲載予定です。</p>
					</div>
				)}
			</div>
		</section>
		)}

		{isTopBuilds && (
		<section class="panel data-hub-panel top-builds-panel" data-tab="top-builds">
			<div class="panel-content">
				<main class="top-builds-list" data-default-season={defaultRankedSeason ?? ''} data-initial-error={rankedSeasonsError}>
					<p id="top-builds-loading" class="ranked-team-status loading-center">読み込み中…</p>
					<p id="top-builds-error" class="ranked-team-status" role="alert" hidden></p>
					<div id="top-builds-cards" class="team-grid"></div>
					<div id="top-builds-empty" class="empty-state" hidden>
						<p class="empty-state-icon" aria-hidden="true">🔍</p>
						<p class="empty-state-title">条件に一致するチームがありません</p>
						<p class="empty-state-hint">検索条件を変更してください。</p>
					</div>
					<div class="top-builds-load-more-wrap">
						<button type="button" id="top-builds-load-more" class="btn-ghost" hidden>もっと見る</button>
					</div>
				</main>
			</div>
		</section>
		)}
	</div>

	<script>
		import { setupAppHeaderSwipe } from '../../lib/app-header-swipe';

		const scrollContainer = document.querySelector<HTMLElement>('[data-data-hub-scroll]');
		setupAppHeaderSwipe(document.querySelector<HTMLElement>('.app-header'), scrollContainer);
	</script>

	<script>
		import { kanaIncludes } from '../../lib/kana';
		import { renderBattleDataCardHtml } from '../../lib/battle-data-card-html';
		import type { SingleFormatData } from '../../lib/battle-data-card';

		const list = document.querySelector<HTMLElement>('#battle-data-list');
		const scrollContainer = document.querySelector<HTMLElement>('[data-data-hub-scroll]');
		const entries = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-battle-data-entry]')) : [];
		const railItems = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-battle-data-rail-item]'));
		const rail = document.querySelector<HTMLElement>('.battle-data-rail');
		const battleDataHeader = document.querySelector<HTMLElement>('.battle-data-second-header');
		const search = document.querySelector<HTMLInputElement>('#battle-data-search');
		const seasonSelect = document.querySelector<HTMLSelectElement>('#battle-data-season');
		const railBySpecies = new Map(railItems.map((item) => [item.dataset.speciesName ?? '', item]));
		let activeRailItem: HTMLAnchorElement | null = null;
		let syncFrame: number | undefined;
		let cardSyncFrame: number | undefined;
		let visibleEntries = entries;
		let visibleRailItems = railItems;
		let expectedRailScrollTop: number | null = null;
		let expectedCardScrollTop: number | null = null;
		let deferredCards: Record<string, SingleFormatData> | null = null;
		let deferredCardsPromise: Promise<void> | null = null;
		const pendingCardEntries = new Set<HTMLElement>();
		let cardObserver: IntersectionObserver | null = null;

		function loadDeferredCards(): void {
			if (deferredCards || deferredCardsPromise) return;
			// URLSearchParams.size は Safari 17 以降にしか無く、未対応環境では常に false 側へ落ちて
			// season 無しで取得してしまう(既定シーズン以外を選んでいると別シーズンのカードが入る)。
			// 文字列化した結果で判定して、対応環境を問わず選択中のシーズンを必ず付ける。
			const params = new URLSearchParams();
			if (seasonSelect?.value) params.set('season', seasonSelect.value);
			const query = params.toString();
			const url = `/api/opgg-usage-list${query ? `?${query}` : ''}`;
			deferredCardsPromise = fetch(url)
				.then(async (response) => {
					if (!response.ok) throw new Error(`HTTP ${response.status}`);
					return await response.json() as Record<string, SingleFormatData>;
				})
				.then((payload) => {
					deferredCards = payload;
					const pendingEntries = [...pendingCardEntries];
					pendingCardEntries.clear();
					for (const entry of pendingEntries) renderDeferredCard(entry);
					// 取得中に検索やスクロール位置が変わっていても、現在地のカードを埋める。
					renderCardAtScrollPosition();
				})
				.catch((error) => {
					console.error('[data] deferred battle data loading failed:', error);
					// 次のObserver発火や検索・ジャンプ操作で再取得できるよう、失敗結果を保持しない。
					deferredCards = null;
				})
				.finally(() => {
					deferredCardsPromise = null;
				});
		}

		function renderDeferredCard(entry: HTMLElement): void {
			if (!entry.hasAttribute('data-battle-data-pending')) return;
			const single = deferredCards?.[entry.dataset.speciesName ?? ''];
			if (!single) {
				pendingCardEntries.add(entry);
				loadDeferredCards();
				return;
			}
			entry.insertAdjacentHTML('beforeend', renderBattleDataCardHtml(single));
			entry.removeAttribute('data-battle-data-pending');
			cardObserver?.unobserve(entry);
			if (!entries.some((item) => item.hasAttribute('data-battle-data-pending'))) {
				deferredCards = null;
			}
		}

		function renderCardRange(center: HTMLElement, radius = 2): void {
			const index = entries.indexOf(center);
			if (index < 0) return;
			for (let itemIndex = Math.max(0, index - radius); itemIndex <= Math.min(entries.length - 1, index + radius); itemIndex += 1) {
				renderDeferredCard(entries[itemIndex]);
			}
		}

		function renderCardAtScrollPosition(): void {
			if (visibleEntries.length === 0 || !scrollContainer || !list) return;
			const position = scrollContainer.scrollTop - listTopInScrollContainer();
			let index = 0;
			while (index < visibleEntries.length - 1 && visibleEntries[index + 1].offsetTop <= position) index += 1;
			renderCardRange(visibleEntries[index]);
		}

		if (scrollContainer && entries.some((entry) => entry.hasAttribute('data-battle-data-pending'))) {
			if ('IntersectionObserver' in window) {
				cardObserver = new IntersectionObserver((observedEntries) => {
					for (const observed of observedEntries) {
						if (observed.isIntersecting) renderDeferredCard(observed.target as HTMLElement);
					}
				}, { root: scrollContainer, rootMargin: '1200px 0px' });
				for (const entry of entries) {
					if (entry.hasAttribute('data-battle-data-pending')) cardObserver.observe(entry);
				}
			} else {
				for (const entry of entries) renderDeferredCard(entry);
			}
			// 埋め込みJSONと違ってネットワーク待ちになるため、表示直後から共有キャッシュの取得を始める。
			loadDeferredCards();
		}

		function markActiveRail(item: HTMLAnchorElement): void {
			if (activeRailItem === item) return;
			activeRailItem?.removeAttribute('aria-current');
			item.setAttribute('aria-current', 'true');
			activeRailItem = item;
		}

		function setActiveRail(speciesName: string): void {
			const item = railBySpecies.get(speciesName);
			if (!item || item.hidden) return;
			markActiveRail(item);
		}

		function interpolateOffset(position: number, source: HTMLElement[], target: HTMLElement[]): { offset: number; index: number } | null {
			if (source.length === 0 || source.length !== target.length) return null;
			let index = 0;
			while (index < source.length - 1 && source[index + 1].offsetTop <= position) index += 1;
			const nextIndex = Math.min(index + 1, source.length - 1);
			const sourceSpan = source[nextIndex].offsetTop - source[index].offsetTop;
			const ratio = sourceSpan > 0 ? Math.min(1, Math.max(0, (position - source[index].offsetTop) / sourceSpan)) : 0;
			return { offset: target[index].offsetTop + (target[nextIndex].offsetTop - target[index].offsetTop) * ratio, index };
		}

		function listTopInScrollContainer(): number {
			if (!list || !scrollContainer) return 0;
			return scrollContainer.scrollTop + list.getBoundingClientRect().top - scrollContainer.getBoundingClientRect().top;
		}

		function requestRailSync(): void {
			if (syncFrame !== undefined) return;
			syncFrame = requestAnimationFrame(() => {
				syncFrame = undefined;
				if (!rail || !list || !scrollContainer || battleDataHeader?.hidden || visibleEntries.length === 0) return;
				const listTop = listTopInScrollContainer();
				const position = scrollContainer.scrollTop - listTop;
				const mapped = interpolateOffset(position, visibleEntries, visibleRailItems);
				if (!mapped) return;
				setActiveRail(visibleEntries[mapped.index].dataset.speciesName ?? '');
				const targetTop = Math.max(0, Math.min(mapped.offset, rail.scrollHeight - rail.clientHeight));
				if (Math.abs(rail.scrollTop - targetTop) < 1) return;
				expectedRailScrollTop = targetTop;
				rail.scrollTop = targetTop;
			});
		}

		function requestCardSync(): void {
			if (cardSyncFrame !== undefined) return;
			cardSyncFrame = requestAnimationFrame(() => {
				cardSyncFrame = undefined;
				if (!rail || !list || !scrollContainer || battleDataHeader?.hidden || visibleEntries.length === 0) return;
				const mapped = interpolateOffset(rail.scrollTop, visibleRailItems, visibleEntries);
				if (!mapped) return;
				setActiveRail(visibleEntries[mapped.index].dataset.speciesName ?? '');
				const targetTop = Math.max(0, Math.min(listTopInScrollContainer() + mapped.offset, scrollContainer.scrollHeight - scrollContainer.clientHeight));
				if (Math.abs(scrollContainer.scrollTop - targetTop) < 1) return;
				expectedCardScrollTop = targetTop;
				scrollContainer.scrollTop = targetTop;
			});
		}

		function applyFilter(): void {
			const term = search?.value ?? '';
			for (const entry of entries) {
				const name = entry.dataset.speciesName ?? '';
				const searchableText = entry.dataset.searchText ?? name;
				const visible = term.trim() === '' || kanaIncludes(searchableText, term);
				entry.hidden = !visible;
				const rail = railItems.find((item) => item.dataset.speciesName === name);
				if (rail) rail.hidden = !visible;
			}
			visibleEntries = entries.filter((entry) => !entry.hidden);
			visibleRailItems = railItems.filter((item) => !item.hidden);
			// 絞り込み直後にも表示位置の結果カードが空にならないよう、Observerを待たずに描画する。
			renderCardAtScrollPosition();
			requestRailSync();
		}

		search?.addEventListener('input', applyFilter);

		for (const item of railItems) {
			item.addEventListener('click', (event) => {
				const targetId = item.getAttribute('href')?.slice(1);
				const target = targetId ? document.getElementById(targetId) : null;
				if (!target) return;
				event.preventDefault();
				setActiveRail(item.dataset.speciesName ?? '');
				// Observerはスクロール後に非同期で発火するため、ジャンプ先を先に埋める。
				renderCardRange(target);
				// 横スワイプ用のスクロール領域へ、カードの座標を直接指定する。
				// scrollIntoView() ではページ側へスクロールが逃げることがある。
				if (!scrollContainer) return;
				const targetTop = scrollContainer.scrollTop + target.getBoundingClientRect().top - scrollContainer.getBoundingClientRect().top;
				// 一覧全体は長いため、smooth では遠い順位ほど到達まで時間が掛かる。
				// レールはジャンプ操作なので即時移動する。
				scrollContainer.scrollTo({ top: Math.max(0, targetTop), behavior: 'auto' });
			});
		}

		scrollContainer?.addEventListener('scroll', () => {
			if (expectedCardScrollTop !== null && Math.abs(scrollContainer.scrollTop - expectedCardScrollTop) < 1) {
				expectedCardScrollTop = null;
				return;
			}
			expectedCardScrollTop = null;
			requestRailSync();
		}, { passive: true });
		rail?.addEventListener('scroll', () => {
			if (expectedRailScrollTop !== null && Math.abs(rail.scrollTop - expectedRailScrollTop) < 1) {
				expectedRailScrollTop = null;
				return;
			}
			expectedRailScrollTop = null;
			requestCardSync();
		}, { passive: true });
		requestRailSync();

		seasonSelect?.addEventListener('change', () => {
			const params = new URLSearchParams(window.location.search);
			params.set('season', seasonSelect.value);
			window.location.search = params.toString();
		});
	</script>

	<script>
		import type { RankedTeam } from '../../lib/ranked-teams';
		import { matchesTopBuildSearch, RANKED_TEAMS_PAGE_SIZE } from '../../lib/ranked-teams-validation';
		import { createRankedTeamCardRenderer, setupRankedTeamsSearchHeader } from '../../lib/ranked-teams/search-header';

		interface RankedTeamsResponse { season: string; teams: RankedTeam[]; hasMore: boolean; }
		interface RankedTeamsCache { teams: RankedTeam[]; hasMore: boolean; }

		const root = document.querySelector<HTMLElement>('.top-builds-list');
		if (root) {
			const cards = document.querySelector<HTMLElement>('#top-builds-cards')!;
			const loading = document.querySelector<HTMLElement>('#top-builds-loading')!;
			const error = document.querySelector<HTMLElement>('#top-builds-error')!;
			const empty = document.querySelector<HTMLElement>('#top-builds-empty')!;
			const loadMore = document.querySelector<HTMLButtonElement>('#top-builds-load-more')!;
			const cache = new Map<string, RankedTeamsCache>();
			let currentTeams: RankedTeam[] = [];
			let hasMore = false;
			let isLoadingMore = false;

			function filteredTeams(): RankedTeam[] {
				return currentTeams.filter((team) => matchesTopBuildSearch(team.members, header.getSearchValue()));
			}

			function render(): void {
				const filtered = filteredTeams();
				cards.replaceChildren(...filtered.map((team) => cardRenderer.renderCard(team)));
				empty.hidden = filtered.length !== 0;
				loadMore.hidden = !hasMore;
			}

			const header = setupRankedTeamsSearchHeader({
				idPrefix: 'top-builds',
				onSearchChange: render,
				onDensityChange: () => {
					cardRenderer.resetTapExpandedTeams();
					render();
				},
				onSeasonChange: (season) => void selectSeason(season),
			});
			const cardRenderer = createRankedTeamCardRenderer({
				getDisplayMode: header.getDisplayMode,
				onCardExpand: render,
			});

			async function loadPage(season: string, reset = false): Promise<void> {
				if (isLoadingMore) return;
				isLoadingMore = true;
				if (reset) {
					currentTeams = [];
					hasMore = false;
				}
				loadMore.disabled = true;
				try {
					const response = await fetch(
						`/api/ranked-teams?season=${encodeURIComponent(season)}&limit=${RANKED_TEAMS_PAGE_SIZE}&offset=${currentTeams.length}`,
					);
					if (!response.ok) throw new Error('上位チームを取得できませんでした');
					const payload = await response.json() as RankedTeamsResponse;
					currentTeams = [...currentTeams, ...payload.teams];
					hasMore = payload.hasMore;
					cache.set(season, { teams: currentTeams, hasMore });
				} finally {
					isLoadingMore = false;
					loadMore.disabled = false;
				}
			}

			async function selectSeason(season: string): Promise<void> {
				loading.hidden = false;
				error.hidden = true;
				cards.replaceChildren();
				empty.hidden = true;
				loadMore.hidden = true;
				try {
					const cached = cache.get(season);
					if (cached) {
						currentTeams = cached.teams;
						hasMore = cached.hasMore;
					} else {
						await loadPage(season, true);
					}
					render();
				} catch (cause) {
					currentTeams = [];
					error.textContent = cause instanceof Error ? cause.message : '上位チームを取得できませんでした';
					error.hidden = false;
				} finally {
					loading.hidden = true;
				}
			}

			loadMore.addEventListener('click', () => {
				void loadPage(header.getSeason()).then(render).catch((cause) => {
					error.textContent = cause instanceof Error ? cause.message : '上位チームを取得できませんでした';
					error.hidden = false;
				});
			});

			const initialError = root.dataset.initialError ?? '';
			const defaultSeason = root.dataset.defaultSeason ?? '';
			if (initialError || !defaultSeason) {
				loading.hidden = true;
				error.textContent = initialError || '表示できるシーズンがありません';
				error.hidden = false;
			} else {
				void selectSeason(defaultSeason);
			}
		}
	</script>
</AppLayout>
