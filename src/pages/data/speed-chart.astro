---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AppLayout from '../../layouts/AppLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import SecondHeader from '../../components/SecondHeader.astro';
import DataHubTabs from '../../components/data/DataHubTabs.astro';
import ChartTable from '../../components/speed-chart/ChartTable.astro';
import '../../styles/speed-adjust-dialog.css';
import '../../styles/speed-chart-page.css';
import '../../styles/app-header.css';
import '../../styles/second-header.css';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { getOwnedPokemon, type OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { toJsonScriptContent } from '../../lib/json-script';
import { parseOwnedQueryParam } from '../../lib/speed-chart-validation';
import { loadSpeedChartSsr } from '../../lib/speed-chart/ssr';
import speedChartConfig from '../../config/speed-chart.json';

const ownedId = parseOwnedQueryParam(Astro.url.searchParams.get('owned'));
let ownedRecord: OwnedPokemonRecord | null = null;
if (ownedId && Astro.locals.user) {
	const result = await getOwnedPokemon(Astro.locals.user.id, ownedId, await getSupabaseAdminClient());
	if (result.ok) ownedRecord = result.data;
}
const hasOwnedPanel = ownedRecord !== null;
const chart = await loadSpeedChartSsr(env.OPGG_USAGE, Astro.url.searchParams.get('season'));
---
<AppLayout title="データ" description="使用率上位のすばやさ実数値早見表" current="data" bodyClass="speed-chart-page" preloadPokemonMaster>
	<AppHeader ariaLabel="データページの表示切り替え"><DataHubTabs active="speed-chart" /></AppHeader>
	<SecondHeader ariaLabel="すばやさ早見表の操作" class="speed-chart-second-header">
		<div class="second-header-search toolbar-item toolbar-search"><div class="search-input-wrap"><svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><input id="speed-chart-jump-input" type="text" class="field-control" placeholder="ポケモン・すばやさ実数値" aria-label="ポケモン・すばやさ実数値" autocomplete="off" /></div></div>
		<div class="toolbar-item"><label class="speed-chart-regulation-label" for="speed-chart-regulation-select">シーズン</label><select id="speed-chart-regulation-select" aria-label="シーズン">{chart.seasons.map((season) => <option value={season.id} selected={season.id === chart.selectedSeasonId}>{season.label ?? season.id}</option>)}</select></div>
		{hasOwnedPanel && <label class="speed-chart-reachable-toggle"><span class="toggle-switch"><input type="checkbox" id="speed-chart-reachable-only-toggle" class="toggle-switch-input" aria-label="すべて表示" /><span class="toggle-switch-track" aria-hidden="true"><span class="toggle-switch-thumb"></span></span></span><span>すべて表示</span></label>}
	</SecondHeader>
	<ChartTable regulation={chart.selectedSeasonId ?? ''} ownedId={ownedId} hasOwnedPanel={hasOwnedPanel} embedded={false} />
	<script type="application/json" id="speed-chart-config" set:html={toJsonScriptContent(speedChartConfig)} />
	<script type="application/json" id="speed-chart-rows-data" set:html={toJsonScriptContent(chart.rows)} />
	{hasOwnedPanel && <script type="application/json" id="speed-chart-owned-record" set:html={toJsonScriptContent(ownedRecord)} />}
</AppLayout>
