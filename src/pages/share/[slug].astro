---
// 個体管理(owned_pokemon)ベースの公開共有ページ (/share/[slug])。
// 旧 src/pages/builds/[slug].astro (廃止) の置き換え。
// PUT /api/owned-pokemon/:id/share で is_public=true にした個体の share_slug から
// 個体の内容を表示する。
// SSRページなので GET /api/share/:slug 相当のデータ取得はここで getSupabasePublicClient() を
// 直接使う (内部fetch往復を避ける、api/share/[slug].ts と同じ最小権限方針)。
import AppLayout from '../../layouts/AppLayout.astro';
import { getSupabasePublicClient } from '../../lib/supabase';
import { getPublicOwnedPokemonBySlug, type PublicOwnedPokemonRecord } from '../../lib/owned-pokemon';

// API ルート (src/pages/api/**) と同じく、動的ルートはSSRで都度サーバレンダリングする
// (ビルド時の静的プリレンダリングではなく、リクエストのたびにDBを参照するため)。
export const prerender = false;

const { slug } = Astro.params;

const STAT_LABELS: Array<{ key: 'hp' | 'atk' | 'def' | 'spa' | 'spd' | 'spe'; label: string }> = [
	{ key: 'hp', label: 'HP' },
	{ key: 'atk', label: '攻撃' },
	{ key: 'def', label: '防御' },
	{ key: 'spa', label: '特攻' },
	{ key: 'spd', label: '特防' },
	{ key: 'spe', label: '素早さ' },
];

let pokemon: PublicOwnedPokemonRecord | null = null;

if (slug) {
	const supabase = await getSupabasePublicClient();
	// getPublicOwnedPokemonBySlug は is_public = true の行のみを返すため、
	// 非公開個体はここで自然に0件になる (api/share/[slug].ts と同じ)。
	const result = await getPublicOwnedPokemonBySlug(slug, supabase);
	if (!result.ok) {
		// eslint-disable-next-line no-console
		console.error('Failed to fetch public owned pokemon:', result.error);
	} else {
		pokemon = result.data;
	}
}

if (!pokemon) {
	Astro.response.status = 404;
}

const displayName = pokemon ? (pokemon.nickname || pokemon.species_name) : '';

// species_name 等は自由入力文字列(実在ポケモン名限定のバリデーションはしていない)なので、
// <script>タグへ埋め込む際に "</script>" 等でタグを閉じて注入されないよう "</" をエスケープする
// (JSONをscriptタグに安全に埋め込む定石)。
function safeJsonForScript(value: unknown): string {
	return JSON.stringify(value).replace(/</g, '\\u003c');
}
---
<AppLayout title={pokemon ? `${displayName}の個体` : '見つかりません'}>
	<style>
		/* 帯化(.panel-content max-width:1080px)に伴い、努力値/個体値・実数値の表が
		   global.css の table { width:100% } のまま伸びると間延びするため、
		   このページの表だけ内容幅に留める(第三者が閲覧する公開ページなので読みやすさ優先)。 */
		table {
			width: auto;
			min-width: 26em;
		}
	</style>
	<div class="page">

		{!pokemon ? (
			<section class="panel">
				<div class="panel-content">
					<p>指定された個体は存在しないか、非公開に設定されています。</p>
				</div>
			</section>
		) : (
			<>
				<section class="panel">
					<div class="panel-content">
						<h2>育成内容</h2>
						<dl>
							<dt>ポケモン</dt>
							<dd>{pokemon.species_name}</dd>
							<dt>性格</dt>
							<dd>{pokemon.nature ?? '(未設定)'}</dd>
							<dt>特性</dt>
							<dd>{pokemon.ability_name ?? '(未設定)'}</dd>
							<dt>持ち物</dt>
							<dd>{pokemon.item_name ?? '(未設定)'}</dd>
							<dt>テラスタイプ</dt>
							<dd>{pokemon.tera_type ?? '(未設定)'}</dd>
							<dt>技構成</dt>
							<dd>{pokemon.move_names.length > 0 ? pokemon.move_names.join(' / ') : '(未設定)'}</dd>
						</dl>
					</div>
				</section>

				<section class="panel">
					<div class="panel-content">
						<h2>努力値・個体値</h2>
						<table>
							<thead>
								<tr>
									<th>ステータス</th>
									{STAT_LABELS.map(({ label }) => <th>{label}</th>)}
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>努力値</td>
									{STAT_LABELS.map((_, i) => <td>{pokemon!.evs[i] ?? 0}</td>)}
								</tr>
								<tr>
									<td>個体値</td>
									{STAT_LABELS.map((_, i) => <td>{pokemon!.ivs[i] ?? 31}</td>)}
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<section class="panel">
					<div class="panel-content">
						<h2>実数値</h2>
						<p>
							<button id="calc-stats-button" class="btn-primary" type="button">実数値を計算する</button>
						</p>
						<p id="engine-status" class="status-text" data-state="idle">未計算(ボタンを押すまでPyodideはロードされません)</p>
						<table id="stats-table" hidden>
							<thead>
								<tr>
									{STAT_LABELS.map(({ label }) => <th>{label}</th>)}
								</tr>
							</thead>
							<tbody>
								<tr id="stats-row">
									{STAT_LABELS.map(() => <td>-</td>)}
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				{/* サーバ側で取得した個体データをブラウザ専用<script>へ橋渡しするためのJSON。
					Astroのdefine:varsはスクリプトを非処理(inline)化しVite経由の静的importが
					使えなくなるため、damage-calcページと同じ「static importするmoduleスクリプト」
					のパターンを保つ目的でこの方式を採る。 */}
				<script type="application/json" id="pokemon-data" set:html={safeJsonForScript(pokemon)} />

				<script>
					import { initEngine, calcStats, registerOfflineCache, type PokemonSpec } from "../../lib/pyodide-engine";

					interface PokemonData {
						species_name: string;
						nature: string | null;
						ability_name: string | null;
						item_name: string | null;
						tera_type: string | null;
						evs: number[];
						ivs: number[];
						move_names: string[];
					}

					function el<T extends HTMLElement>(id: string): T {
						const found = document.getElementById(id);
						if (!found) {
							throw new Error(`要素が見つかりません: #${id}`);
						}
						return found as T;
					}

					const STAT_KEYS = ["hp", "atk", "def", "spa", "spd", "spe"] as const;

					const pokemonDataEl = el<HTMLScriptElement>("pokemon-data");
					const pokemon = JSON.parse(pokemonDataEl.textContent ?? "null") as PokemonData | null;

					const statusEl = el<HTMLElement>("engine-status");
					const calcButton = el<HTMLButtonElement>("calc-stats-button");
					const statsTable = el<HTMLTableElement>("stats-table");
					const statsRow = el<HTMLTableRowElement>("stats-row");

					function renderProgress(progress: { status: string; message: string }) {
						statusEl.dataset.state = progress.status;
						const spinner = progress.status === "loading" ? '<span class="spinner"></span>' : "";
						statusEl.innerHTML = spinner + progress.message;
					}

					calcButton.addEventListener("click", async () => {
						if (!pokemon) return;
						calcButton.disabled = true;
						try {
							await initEngine(renderProgress);
							const spec: PokemonSpec = {
								name: pokemon.species_name,
								nature: pokemon.nature ?? undefined,
								abilityName: pokemon.ability_name ?? undefined,
								itemName: pokemon.item_name ?? undefined,
								teraType: pokemon.tera_type ?? undefined,
								moveNames: pokemon.move_names,
								evs: pokemon.evs,
								ivs: pokemon.ivs,
							};
							const { stats } = await calcStats(spec);
							statsRow.innerHTML = "";
							for (const key of STAT_KEYS) {
								const td = document.createElement("td");
								td.textContent = String(stats[key]);
								statsRow.appendChild(td);
							}
							statsTable.hidden = false;
						} catch (err) {
							console.error(err);
							statusEl.dataset.state = "error";
							statusEl.textContent = "エラー: " + (err instanceof Error ? err.message : String(err));
						} finally {
							calcButton.disabled = false;
						}
					});

					renderProgress({ status: "idle", message: "未計算(ボタンを押すまでPyodideはロードされません)" });
					// Pyodide自体のロードは開始しない(SW登録のみ)。damage-calc ページと同じ方針。
					registerOfflineCache();
				</script>
			</>
		)}
		</div>
</AppLayout>
