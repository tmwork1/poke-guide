---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import GameScreenOcr from '../../components/box-id/GameScreenOcr.astro';
import '../../styles/game-screen-scan-page.css';
---
<AppLayout title="ゲーム画面から読み取る" current="box">
	<div class="page game-screen-scan-page">
		<AppHeader>
			<h1 class="app-header-title">ゲーム画面から読み取る</h1>
		</AppHeader>
		<main class="game-screen-scan-page__content">
			<p class="game-screen-scan-page__description">
				ポケモンチャンピオンズのボックス画面で、ポケモンを選んだときに右側に出る「つよさ」欄（名前・ステータス・わざ・特性）を撮影してください。
			</p>
			<img class="game-screen-scan-page__guide" src="/images/game-screen-ocr-guide.webp" width="480" height="713" alt="ボックス画面の右側にある、ステータス・わざ・特性が並んだ欄" />
			<div class="game-screen-scan-page__actions">
				<input id="game-screen-ocr-camera-file" class="game-screen-ocr-file" type="file" accept="image/*" capture="environment" />
				<input id="game-screen-ocr-library-file" class="game-screen-ocr-file" type="file" accept="image/*" />
				<button id="game-screen-ocr-camera-button" class="btn-primary" type="button">カメラで撮影</button>
				<button id="game-screen-ocr-library-button" class="btn-control" type="button">カメラロールから選ぶ</button>
			</div>
		</main>
	</div>
	<GameScreenOcr />
	<script>
		import '../../lib/box-id/game-screen-ocr';

		const cameraButton = document.getElementById('game-screen-ocr-camera-button');
		const libraryButton = document.getElementById('game-screen-ocr-library-button');
		const cameraInput = document.getElementById('game-screen-ocr-camera-file');
		const libraryInput = document.getElementById('game-screen-ocr-library-file');
		cameraButton?.addEventListener('click', () => (cameraInput as HTMLInputElement | null)?.click());
		libraryButton?.addEventListener('click', () => (libraryInput as HTMLInputElement | null)?.click());
	</script>
</AppLayout>
