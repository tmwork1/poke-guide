	<script>
		// UI刷新: カードに公式絵を表示するためのブラウザ専用ヘルパー。box/[id].astro の
		// applySprite と同じ「初期display:none→onloadで表示」方式を採るため、この<script>内にも
		// 同等のロジックを直接持たせる(box/[id].astroは編集禁止のため、ヘルパー自体を
		// 共有インポートすることはしない)。
		// ラウンド4: タイプ/テラスバッジ・アイテム画像は表示自体を撤回したため、
		// loadTypesMap/loadItemSpriteMap等のインポートとヘルパーは削除した
		// (タイプ・持ち物・技・テラスタイプは検索対象としては引き続き有効で、
		// カードのtitle属性=ホバーツールチップから参照できるようにしてある)。
		// ラウンド5: 持ち物(画像バッジ)を復元するため loadItemSpriteMap/itemImageUrl を再度
		// インポートする(box/[id].astroが使っているものと同一のヘルパー、src/lib/sprite-urls.ts)。
		// ラウンド21 21-B3: 技名→タイプの解決に loadMoveTypeMap を追加 import する(既存関数、
		// box/[id].astroが技入力欄の枠色付けに使っているものと同一)。
		import {
			loadImageIdMap,
			officialArtworkUrl,
			loadBaseStatsMap,
			loadMoveTypeMap,
		} from "../../lib/pokemon-master-data";
		// ラウンド21 21-B2でテラスタイプ表示を宝石型アイコン(teraTypeIconUrl)から通常タイプの
		// 丸アイコン(typeIconUrl)へ差し替えたが、ラウンド28 28-G1(ユーザー指示)で
		// generate_type_icons.pyが作り直され宝石型の縁を綺麗に繋ぎ合わせたテラス専用アイコンが
			// 再生成されたため、21-B2(および23-G2)を撤回してteraTypeIconUrlへ戻す。typeIconUrlは
			// このファイル内で他に使っていないためimportから外す(sprite-urls.tsの関数自体は
			// 共通ファイルのため消さない)。
		import { loadItemSpriteMap, itemImageUrl, teraTypeIconUrl } from "../../lib/sprite-urls";
		// ラウンド21 21-B3: 技チップの背景色付け用。値そのものは type-colors.ts(エージェントPが
		// box/[id].astro からの切り出しとして新規作成)からimportし、コピー定義は作らない。
		import { TYPE_COLORS, DEFAULT_TYPE_COLOR } from "../../lib/type-colors";
		// ラウンド18: 実数値計算の共通化。box/[id].astro・share/[slug].astro・pokemon/[name].astro
		// と4箇所にコピーされていた chmpToLegacyEffort/calcHpStat/calcOtherStat/
		// NATURE_STAT_MODIFIERS を src/lib/stats.ts に統合した(このファイルが原本だった)。
		import {
			NATURE_STAT_MODIFIERS,
			calcHpStat,
			calcOtherStat,
		} from "../../lib/stats";

		interface OwnedPokemon {
			id: string;
			nickname: string | null;
			species_name: string;
			level: number | null;
			nature: string | null;
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			evs: number[];
			ivs: number[];
			move_names: string[];
			memo: string | null;
			tags: string[];
			is_pinned: boolean;
			updated_at: string;
			last_used_at: string | null;
		}

		// 実数値計算共通の列順(evs/ivs配列の並びと一致)。
		// [HP, 攻撃, 防御, 特攻, 特防, 素早さ] (box/[id].astro の STAT_KEYS と同じ順序)。
		const STAT_KEYS = ["hp", "atk", "def", "spa", "spd", "spe"] as const;
		const STAT_LABELS = ["H", "A", "B", "C", "D", "S"] as const;

		// ラウンド18: NATURE_STAT_MODIFIERS・chmpToLegacyEffort・calcHpStat・calcOtherStatは
		// src/lib/stats.ts に統合した(このファイルが原本だったコピーは削除。上のimport参照)。
		// vendor/jpoke/src/jpoke/model/stats.py の calc_hp/calc_stat/chmp_to_legacy_effort と
		// 完全に同じ式であることの出典は src/lib/stats.ts 冒頭のコメント参照。

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const listRoot = document.getElementById("owned-pokemon-list");
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const countBadge = el<HTMLElement>("pokemon-count-badge");
			const sortSelect = el<HTMLSelectElement>("sort-select");
			const searchInput = el<HTMLInputElement>("search-input");
			// ラウンド27 27-B3(ユーザー指示)によりタグ絞り込みUI(tagFilterToolbar/
			// tagFilterList、複数タグ選択)を廃止し、「お気に入りのみ表示」の単一トグルに
			// 置き換えた。
			const favoriteFilterToggle = el<HTMLButtonElement>("favorite-filter-toggle");
			const addButton = el<HTMLButtonElement>("add-pokemon-button");
			// textContentではなくinnerHTMLで保存する。addButtonは「＋」の大きいアイコンと
			// ラベルの2要素構成(見た目の要件2)なので、ローディング表示から復元する際に
			// プレーンテキストへ潰さないため。
			const ADD_BUTTON_DEFAULT_HTML = addButton.innerHTML;

			let allPokemon: OwnedPokemon[] = [];
			// ラウンド27 27-B3: 旧activeTags(複数タグの絞り込み状態)を単一boolean(お気に入りの
			// みを表示するか)に置き換える。
			let favoriteOnly = false;

			// UI刷新: 種族名→imageId(画像用PokeAPI ID)、種族名→種族値のマップ。
			// いずれも非同期fetchだが、ここでは待たずにPromiseだけ確保しておく。
			// 一覧の初回描画(loadList→renderList)はこのPromiseの解決を待たずに進める
			// (「一覧が表示されるまでの体感を遅くしない」ことを優先するため)。マップが解決した時点で
			// 各カードの画像・実数値側から個別にthenするので、一覧より数百ms遅れて追いつく形になる。
			const imageIdMapPromise = loadImageIdMap();
			const baseStatsMapPromise = loadBaseStatsMap();
			// ラウンド5: 持ち物バッジ用。アイテム和名→sprite相対パスのマップ(box/[id].astroと同じ)。
			const itemSpriteMapPromise = loadItemSpriteMap();
			// ラウンド21 21-B3: 技チップの背景色付け用。技名→タイプのマップ(box/[id].astroが
			// 技入力欄の枠色付けに使っているものと同一関数)。
			const moveTypeMapPromise = loadMoveTypeMap();

			// nickname・species_nameのどちらも空(自動登録直後の空個体)の場合、カード見出しが
			// 空文字にならないよう "(未設定)" にフォールバックする。並べ替え・検索・削除確認
			// ダイアログの見出し、カードの表示名(ラウンド4)に共通で使う。
			function displayName(p: OwnedPokemon): string {
				if (p.nickname && p.nickname.trim() !== "") return p.nickname;
				if (p.species_name && p.species_name.trim() !== "") return p.species_name;
				return "(未設定)";
			}

			// ラウンド32 32-B4(ユーザー指示第15弾): 「カードのホバー表示にはステータスやメモなど、
			// カード上に表示されていない情報だけ表示する」。旧title(とくせい/持ち物/わざ)は
			// 32-B2・32-B3でその3つがカード上に常時可視になったため重複と判断し、実数値
			// (H/A/B/C/D/S)とメモに入れ替える(round-32.mdより)。実数値はapplyActualStats()が
			// 非同期(種族値マップ解決待ち)でstatValueEls/data-modを埋めるため、そちらが解決した
			// 後に呼び出す(下のrenderCard内、applyActualStats(...).then(...)参照)。
			// 種族値が解決できずstatValueElsが"-"のままの個体は実数値行を省略する(嘘の値は出さない)。
			// メモ・実数値のどちらも無ければtitle属性自体を出さない(ユーザー指示どおり)。
			// 34-B3(ユーザー指示第16弾、round-34.md): 「ホバー時のステータス表記から"実数値:"を
			// 削除し、性格補正はA200+, C135-のように数値の後に+/-をつける」。
			// mark を▲/▼から+/-へ変更(ラベル→値→記号の順は維持、結果 `A200+` `C135-` になる)。
			function buildStatSummary(statValueEls: HTMLElement[]): string | null {
				if (statValueEls.some((valueEl) => valueEl.textContent === "-")) return null;
				return STAT_LABELS.map((label, i) => {
					const valueEl = statValueEls[i];
					const mark = valueEl.dataset.mod === "up" ? "+" : valueEl.dataset.mod === "down" ? "-" : "";
					return `${label}${valueEl.textContent}${mark}`;
				}).join(" ");
			}
			function applyCardTooltip(card: HTMLAnchorElement, statValueEls: HTMLElement[], memo: string | null): void {
				const lines: string[] = [];
				const statSummary = buildStatSummary(statValueEls);
				if (statSummary) lines.push(statSummary);
				const memoText = memo?.trim() ?? "";
				if (memoText) lines.push(`メモ: ${memoText}`);
				if (lines.length > 0) card.title = lines.join("\n");
			}

			// UI刷新: カード内の公式絵。取得できない場合は頭文字の丸バッジにフォールバックする。
			// 初期display:noneのままloading="lazy"を付けると、画面外扱いでfetch自体が行われず
			// onloadが永久に発火しない(過去に踏んだ不具合、box/[id].astroのapplySprite参照)。
			async function applyCardSprite(imgEl: HTMLImageElement, fallbackEl: HTMLElement, name: string): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = officialArtworkUrl(imageId);
			}

			// ラウンド5: 公式絵に重ねる持ち物バッジ。sprite相対パスが解決できない/画像読み込みに
			// 失敗した場合はバッジごと隠す(box/[id].astroのapplyItemImageと同様、テキストの
			// フォールバックは持たせない。アイテム名はカードのtitle属性から参照できる)。
			async function applyItemBadge(imgEl: HTMLImageElement, badgeEl: HTMLElement, itemName: string): Promise<void> {
				const name = itemName.trim();
				if (!name) {
					badgeEl.hidden = true;
					return;
				}
				const spritePath = (await itemSpriteMapPromise).get(name);
				if (!spritePath) {
					badgeEl.hidden = true;
					return;
				}
				imgEl.onerror = () => {
					badgeEl.hidden = true;
				};
				imgEl.onload = () => {
					badgeEl.hidden = false;
				};
				imgEl.src = itemImageUrl(spritePath);
			}

			// ラウンド20 B1: 持ち物バッジの右に並べるテラスタイプ画像。teraTypeIconUrlは
			// 静的マップからの同期解決(sprite-urls.ts)なのでPromiseを待つ必要は無い。
			// テラス未設定の個体ではバッジごと隠す(applyItemBadgeと同じ設計)。
			// ラウンド21 21-B2で宝石型のteraTypeIconUrl(ジグザグ縁)から通常タイプの丸アイコン
			// typeIconUrlへ差し替えたが、ラウンド28 28-G1(ユーザー指示)でgenerate_type_icons.pyが
			// 作り直され、宝石型の縁を綺麗に繋ぎ合わせたテラス専用アイコンが再生成されたため、
			// 21-B2(および23-G2)を撤回してteraTypeIconUrlへ戻す。専用アイコンは宝石型(ジグザグの
			// 尖った縁)を持つ正方形画像のため、border-radius: 50%で丸くトリミングしてはいけない
			// (縁が削れてしまう)。丸トリミングのCSS(.card-tera-badge img)側も外す(下のCSS参照)。
			function applyTeraBadge(imgEl: HTMLImageElement, badgeEl: HTMLElement, teraType: string): void {
				const type = teraType.trim();
				if (!type) {
					badgeEl.hidden = true;
					return;
				}
				const url = teraTypeIconUrl(type);
				if (!url) {
					badgeEl.hidden = true;
					return;
				}
				imgEl.onerror = () => {
					badgeEl.hidden = true;
				};
				imgEl.onload = () => {
					badgeEl.hidden = false;
				};
				imgEl.src = url;
			}

			// ラウンド21 21-B3: 技チップの背景にタイプカラーを敷く。技名→タイプの解決は非同期
			// (loadMoveTypeMap)だが、対象のspan要素は呼び出し前に既に静的な順序でDOMへ
			// 配置済みなので、色を後から埋めても挿入順には影響しない
			// (pitfalls.md「非同期の描画関数をvoidで投げっぱなしにしない」の事故は複数要素間の
			// 挿入順が競合する場合の話で、この関数は既存の要素に背景色を1回書き込むだけなので
			// 該当しない)。技名からタイプが引けない(未入力・データに無い技)場合は背景を付けない。
			// コントラストは実測済み(color-mix 10%、--color-text-mutedとの比が最悪でも
			// ライト4.88:1・ダーク4.66:1でWCAG AA 4.5:1を19タイプ全てで満たす。詳細は報告参照)。
			async function applyMoveChipTypeColors(
				entries: { el: HTMLElement; moveName: string }[],
			): Promise<void> {
				if (entries.length === 0) return;
				const typeMap = await moveTypeMapPromise;
				for (const { el, moveName } of entries) {
					const type = typeMap.get(moveName);
					if (!type) continue;
					const color = TYPE_COLORS[type] ?? DEFAULT_TYPE_COLOR;
					el.style.background = `color-mix(in srgb, ${color} 11%, transparent)`;
				}
			}

			// UI刷新(要件4): 実数値グリッドを埋める。種族値が解決できない場合は "-" のまま残す。
			async function applyActualStats(valueEls: HTMLElement[], p: OwnedPokemon): Promise<void> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				STAT_KEYS.forEach((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const target = valueEls[i];
					target.textContent = String(value);
					if (key !== "hp" && mod.up === key) target.dataset.mod = "up";
					else if (key !== "hp" && mod.down === key) target.dataset.mod = "down";
					else delete target.dataset.mod;
				});
			}

			// ラウンド4: カードの表示からタイプ・特性・持ち物・テラスタイプ・技を外したが、
			// 検索対象はそれらすべてを引き続き含める(「表示されない項目も検索できる」ことを
			// 明示的に要求されているため、この関数はラウンド2時点から変更しない)。
			function matchesSearch(p: OwnedPokemon, term: string): boolean {
				if (!term) return true;
				const haystack = [
					p.nickname ?? "",
					p.species_name,
					p.ability_name ?? "",
					p.item_name ?? "",
					p.tera_type ?? "",
					...p.move_names,
				]
					.join(" ")
					.toLowerCase();
				// AND部分一致(空白区切りの複数語すべてを含む場合のみ一致、育成データ管理計画.md §6.1)
				return term
					.toLowerCase()
					.split(/\s+/)
					.filter((t) => t.length > 0)
					.every((token) => haystack.includes(token));
			}

			// ラウンド27 27-B3(ユーザー指示): 「しぼりこみ条件はお気に入りだけにする」。
			// お気に入り=is_pinnedと同義(pinButtonの★/☆と同じデータ)。
			function matchesFavorite(p: OwnedPokemon): boolean {
				return !favoriteOnly || p.is_pinned;
			}

			function sortPokemon(list: OwnedPokemon[]): OwnedPokemon[] {
				const sort = sortSelect.value;
				const sorted = [...list].sort((a, b) => {
					if (sort === "last_used_at") {
						const av = a.last_used_at ? new Date(a.last_used_at).getTime() : -Infinity;
						const bv = b.last_used_at ? new Date(b.last_used_at).getTime() : -Infinity;
						return bv - av;
					}
					if (sort === "nickname") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
				});
				// ピン留めは常に上部固定(育成データ管理計画.md §6.1)。
				// 40-B1(ユーザー指示第22弾、round-40.md): 「更新順」(sort==="updated_at")選択時は
				// このピン優先の再ソートを外す。お気に入りトグルAPI(togglePin)はPUTが全項目上書き
				// 契約のため、サーバ側(updateOwnedPokemon)がupdated_atを必ず現在時刻へ更新する
				// (実測確認済み)。従来はこの無条件ピン優先ソートと相まって、「更新順」表示中に
				// お気に入りを押すと、トグルした個体だけでなく他個体の見た目上の並び位置まで
				// ずれて見えた。ピン優先を外すことで「更新順」表示は純粋にupdated_at降順のみになり、
				// トグルした個体自身が新しいupdated_atで最上部付近へ動くこと(要件で明示的に許容)
				// 以外、他個体同士の相対順は変わらない(比較関数がa/bの属性だけに依存し第三者の
				// トグルに影響されないため、数学的にも保証される)。「最終使用順」「ニックネーム順」
				// では従来どおりピン優先を維持する。
				if (sort !== "updated_at") {
					sorted.sort((a, b) => Number(b.is_pinned) - Number(a.is_pinned));
				}
				return sorted;
			}

			// UI刷新: カード全体を<a>にして丸ごとクリック可能にする(要件3、遷移先は/box/{id})。
			// ピン留め/削除のアイコンボタンは<a>の中の<button>として置くが、クリック時は必ず
			// preventDefault/stopPropagationしてカード本体の遷移と競合しないようにする。
			// ラウンド4: カードは「公式絵→名前→実数値6値」だけの正方形にする。撤回した
			// タイプ・性格・特性・持ち物・テラスタイプ・技はtitle属性(ホバーツールチップ)に回す。
			function renderCard(p: OwnedPokemon): HTMLAnchorElement {
				const card = document.createElement("a");
				card.className = "card card-pokemon" + (p.is_pinned ? " is-pinned" : "");
				card.href = `/box/${encodeURIComponent(p.id)}`;
				const name = displayName(p);
				card.setAttribute("aria-label", `${name} を編集`);
				// title(ホバーツールチップ)は下のapplyActualStats().then(...)で実数値が
				// 解決してから設定する(32-B4)。

				// --- ピン留め(お気に入り、カード左上の三角形トリム領域)/削除(カード右上)。
				//     39-B2/39-B3(ユーザー指示第21弾、round-39.md): 対角配置にするため、
				//     旧来の単一.card-actions(右上に2つ縦積み)から分離する。ピン留めボタンは
				//     .card-actionsの外に出し、card直下へ直接appendして左上に固定する
				//     (.card-pokemonがposition:relativeなので基準になる)。クリックでお気に入りを
				//     トグルする機能・data-pinned属性・イベントリスナーは変更しない
				//     (見た目=CSSのclip-pathで三角形にするだけ、round-39.md 39-B2の指示どおり)。 ---
				const pinButton = document.createElement("button");
				pinButton.type = "button";
				pinButton.className = "icon-button pin-toggle";
				pinButton.dataset.pinned = String(p.is_pinned);
				pinButton.textContent = p.is_pinned ? "★" : "☆";
				const pinLabel = p.is_pinned ? "ピン留めを解除する" : "ピン留めする";
				pinButton.title = pinLabel;
				pinButton.setAttribute("aria-label", pinLabel);
				pinButton.addEventListener("click", (event) => {
					// カード(<a>)のクリックによる/box/{id}への遷移を止める。
					event.preventDefault();
					event.stopPropagation();
					void togglePin(p);
				});
				card.appendChild(pinButton);

				// 削除ボタン: 39-B3で右上へ移動(旧来から位置は変えず、お気に入りが左上へ
				// 抜けたことで対角配置になる)。.card-actionsはこの1個だけを持つ箱として維持する。
				const actions = document.createElement("div");
				actions.className = "card-actions";

				const deleteButton = document.createElement("button");
				deleteButton.type = "button";
				deleteButton.className = "icon-button delete-button";
				deleteButton.textContent = "🗑";
				deleteButton.title = "削除";
				deleteButton.setAttribute("aria-label", "削除");
				deleteButton.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();
					void deletePokemon(p);
				});
				actions.appendChild(deleteButton);

				card.appendChild(actions);

				// --- 優先順位1位: 公式絵 ---
				const art = document.createElement("div");
				art.className = "card-art";

				const spriteImg = document.createElement("img");
				spriteImg.className = "card-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				art.appendChild(spriteImg);

				const spriteFallback = document.createElement("span");
				spriteFallback.className = "card-sprite-fallback";
				art.appendChild(spriteFallback);

				void applyCardSprite(spriteImg, spriteFallback, p.species_name ?? "");

				// --- 優先順位4位: アイテム画像+テラスタイプ(公式絵の右側に縦に並べるバッジ列)。
				//     ラウンド32 32-B2(ユーザー指示第15弾): 「アイテムアイコンをポケモンアイコンの
				//     右側(テラスタル画像の上)に配置」。従来は.card-item-badgeが.card-item-row
				//     (持ち物のテキスト行)側にあったが、.card-art側のこの列へ移し、
				//     テラスバッジ(.card-tera-badge)と縦に並べる(アイテムが上、テラスが下)。
				//     どちらも既定でhidden=trueにしてから非同期でsrc/hiddenを埋める
				//     (挿入順を実行順に依存させないための対策。pitfalls.md参照。
				//     ラッパー.card-badge-row自体は背景/枠を持たないので、隠れていても
				//     空の白丸は残らない)。 ---
				const badgeRow = document.createElement("span");
				badgeRow.className = "card-badge-row";

				const itemBadge = document.createElement("span");
				itemBadge.className = "card-item-badge";
				itemBadge.hidden = true;
				const itemImg = document.createElement("img");
				itemImg.alt = "";
				itemBadge.appendChild(itemImg);
				badgeRow.appendChild(itemBadge);
				void applyItemBadge(itemImg, itemBadge, p.item_name ?? "");

				const teraBadge = document.createElement("span");
				teraBadge.className = "card-tera-badge";
				teraBadge.hidden = true;
				const teraImg = document.createElement("img");
				teraImg.alt = "";
				teraBadge.appendChild(teraImg);
				badgeRow.appendChild(teraBadge);
				applyTeraBadge(teraImg, teraBadge, p.tera_type ?? "");

				art.appendChild(badgeRow);

				card.appendChild(art);

				// --- 優先順位2位・3位: 名前+実数値6値。
				//     C-5を継続: <a>のaria-labelと重複するのでbody全体はaria-hiddenにする
				//     (フォーカス可能な★/🗑はこのdivの外=兄弟要素なので隠しても到達性に影響しない)。 ---
				const body = document.createElement("div");
				body.className = "card-body";
				body.setAttribute("aria-hidden", "true");

				const nameEl = document.createElement("p");
				nameEl.className = "card-name";
				nameEl.textContent = name;
				body.appendChild(nameEl);

				// --- 優先順位4位: 特性+持ち物(テキスト2列、ラウンド27 27-B1で新設した行を
				//     ラウンド32 32-B3(ユーザー指示第15弾)で作り直したもの)。
				//     「特性をアイテムの左側に表示」の指示どおり、.card-item-rowを
				//     [特性名]-[持ち物名]の2列左右振り分けにする(アイコンは32-B2で
				//     .card-art側へ移ったため、この行はテキスト2つだけになる)。
				//     特性・持ち物のどちらか一方だけの個体でも列が崩れないよう、
				//     もう片方は空文字列のまま(何も表示しない)にする。 ---
				const itemRow = document.createElement("div");
				itemRow.className = "card-item-row";

				const abilityNameEl = document.createElement("span");
				abilityNameEl.className = "card-ability-name";
				abilityNameEl.textContent = p.ability_name?.trim() ?? "";
				itemRow.appendChild(abilityNameEl);

				const itemNameEl = document.createElement("span");
				itemNameEl.className = "card-item-name";
				itemNameEl.textContent = p.item_name?.trim() ?? "";
				itemRow.appendChild(itemNameEl);

				body.appendChild(itemRow);

				// --- 優先順位5位: 技(最大4つ、ラウンド5で復元)。
				//     2×2グリッドにして高さを抑える。未設定スロットは要素自体を作らない
				//     (「-」を4つ並べるとデータ破損に見えるという指摘への対応を継続)。
				//     ラウンド8 A-8: movesGrid自体(子要素の無い箱)は技0件でも必ずappendする。
				//     CSS側でmin-heightを持たせてあるので、技0/2/4件のどのカードでもcard-bodyの
				//     高さが一致し、名前行・実数値行のy座標が揃う(cloneNode(true)で36体に複製した
				//     状態で実測: 差0px)。
				//     ラウンド20 B2: 「名前→技→実数値」の順に入れ替えた(ユーザー指示)。
				//     区切り線は下の実数値グリッド側に移設したので、このブロック自体は
				//     技0件でも罫線を出さず、ただの空白として中段に収まる
				//     (メガフシギバナ(42ccb527-...)で実機確認: 空白は出るが浮いた罫線には見えない)。 ---
				const moves = p.move_names.filter((moveName) => moveName && moveName.trim() !== "");
				const movesGrid = document.createElement("div");
				movesGrid.className = "card-moves-grid";
				// ラウンド21 21-B3: 技チップにタイプ背景色を敷く。チップ自体は他の要素と同様に
				// ここで同期的に静的な順序でappendし、色付けだけを後から非同期で行う
				// (applyMoveChipTypeColorsのコメント参照)。
				const moveChipEntries: { el: HTMLElement; moveName: string }[] = [];
				for (const moveName of moves) {
					const moveEl = document.createElement("span");
					moveEl.className = "card-move-chip";
					moveEl.textContent = moveName;
					movesGrid.appendChild(moveEl);
					moveChipEntries.push({ el: moveEl, moveName });
				}
				void applyMoveChipTypeColors(moveChipEntries);
				body.appendChild(movesGrid);

				// 実数値6値: 列見出し(H/A/B/C/D/S)行→実数値行の2段×6列グリッド。
				// 性格による上昇/下降は実数値に▲▼を添えて示す(色だけに頼らない)。
				const statGrid = document.createElement("div");
				statGrid.className = "card-stat-grid";

				STAT_LABELS.forEach((label) => {
					const colLabel = document.createElement("span");
					colLabel.className = "card-stat-col-label";
					colLabel.textContent = label;
					statGrid.appendChild(colLabel);
				});

				const statValueEls: HTMLElement[] = [];
				for (let i = 0; i < STAT_KEYS.length; i++) {
					const valueEl = document.createElement("span");
					valueEl.className = "card-stat-real-value tnum";
					valueEl.textContent = "-";
					statGrid.appendChild(valueEl);
					statValueEls.push(valueEl);
				}

				body.appendChild(statGrid);
				void applyActualStats(statValueEls, p).then(() => applyCardTooltip(card, statValueEls, p.memo));

				card.appendChild(body);

				return card;
			}

			function renderList(): void {
				const filtered = allPokemon.filter((p) => matchesFavorite(p) && matchesSearch(p, searchInput.value.trim()));
				const sorted = sortPokemon(filtered);
				listRoot.innerHTML = "";
				// UI刷新(要件10)→ラウンド2(B-9): 「本当に0件」と「絞り込みで0件」を区別する。
				// 以前は絞り込み0件のメッセージをグリッド内(display:contents経由)に差し込んでいて
				// 縮んだ追加タイルの右横に宙に浮いて見えたため、グリッドの外の#no-match-messageへ
				// 切り出し、#empty-messageと同じ.empty-stateの見た目に揃える。
				const isTrulyEmpty = allPokemon.length === 0;
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				updateCountBadge(sorted.length);
				if (isTrulyEmpty) return;
				for (const p of sorted) {
					listRoot.appendChild(renderCard(p));
				}
			}

			async function togglePin(p: OwnedPokemon): Promise<void> {
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							nickname: p.nickname,
							species_name: p.species_name,
							level: p.level,
							nature: p.nature,
							ability_name: p.ability_name,
							item_name: p.item_name,
							tera_type: p.tera_type,
							// PUTは全項目上書きの設計(§6.2)のため、evs/ivs/memoを送り忘れると
							// デフォルト値([0,0,0,0,0,0] / [31,...,31] / null)で消えてしまう。
							// ピン留めのトグルだけのつもりでも、一覧が保持している最新値をそのまま送り返す。
							evs: p.evs,
							ivs: p.ivs,
							move_names: p.move_names,
							memo: p.memo,
							tags: p.tags,
							is_pinned: !p.is_pinned,
						}),
					});
					if (!res.ok) throw new Error(`ピン留めの更新に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemon };
					const idx = allPokemon.findIndex((x) => x.id === p.id);
					if (idx !== -1) allPokemon[idx] = body.data;
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("ピン留めの更新に失敗しました。時間をおいて再度お試しください。");
				}
			}

			async function deletePokemon(p: OwnedPokemon): Promise<void> {
				if (!window.confirm(`「${displayName(p)}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allPokemon = allPokemon.filter((x) => x.id !== p.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("削除に失敗しました。時間をおいて再度お試しください。");
				}
			}

			// B-9: 絞り込み/検索の結果件数を総数に追随させる(例: 検索中は「2 / 4体」)。
			// renderList()が呼ばれるたびに毎回渡されるので、この関数自体は単に整形するだけでよい。
			function updateCountBadge(visibleCount: number): void {
				const total = allPokemon.length;
				countBadge.textContent = visibleCount === total ? `${total}体` : `${visibleCount} / ${total}体`;
				countBadge.hidden = false;
			}

			// 「＋ 個体を追加」: クリックした瞬間に空個体(全項目未設定、ivsは
			// チャンピオンズルールにより31固定、evsは0)を自動登録し、そのまま編集画面(/box/[id])へ
			// 遷移する(/box/new の新規作成フォームは廃止)。連打による二重登録を防ぐため、
			// リクエスト中はボタンをdisabledにしてラベルを変更し、失敗時のみ復元する
			// (成功時はページ遷移するため復元不要)。
			async function createEmptyPokemon(): Promise<void> {
				addButton.disabled = true;
				addButton.textContent = "登録中...";
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							nickname: "",
							species_name: "",
							level: null,
							nature: "",
							ability_name: "",
							item_name: "",
							tera_type: "",
							evs: [0, 0, 0, 0, 0, 0],
							ivs: [31, 31, 31, 31, 31, 31],
							move_names: [],
							memo: "",
							tags: [],
							is_pinned: false,
						}),
					});
					const body = (await res.json().catch(() => ({}))) as { data?: { id: string }; error?: string };
					if (!res.ok || !body.data) {
						throw new Error(body.error ?? `登録に失敗しました (status=${res.status})`);
					}
					window.location.href = `/box/${encodeURIComponent(body.data.id)}`;
				} catch (err) {
					console.error(err);
					errorMessage.hidden = false;
					errorMessage.textContent = "個体の登録に失敗しました。時間をおいて再度お試しください。";
					addButton.disabled = false;
					addButton.innerHTML = ADD_BUTTON_DEFAULT_HTML;
				}
			}

			async function loadList(): Promise<void> {
				loadingMessage.hidden = false;
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemon[] };
					allPokemon = body.data;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "一覧の取得に失敗しました。時間をおいて再度お試しください。";
				}
			}

			sortSelect.addEventListener("change", renderList);
			searchInput.addEventListener("input", renderList);
			favoriteFilterToggle.addEventListener("click", () => {
				favoriteOnly = !favoriteOnly;
				favoriteFilterToggle.dataset.active = String(favoriteOnly);
				favoriteFilterToggle.setAttribute("aria-pressed", String(favoriteOnly));
				renderList();
			});
			addButton.addEventListener("click", () => void createEmptyPokemon());

			void loadList();
		}
	</script>
</AppLayout>
