---
// 個体一覧ページ(ボックス)。
// docs/ui_proposal/Box.png のワイヤーフレーム(上部に検索/絞り込み/並べ替えの横一列ツールバー、
// その下にカードグリッド。グリッド先頭セルは「追加」タイル)に準拠する。
// ログイン時は GET /api/owned-pokemon から取得した一覧をクライアント側で描画する
// (並び替え・タグフィルタ・文字列検索はいずれも初回取得後にクライアント側で完結させ、
// 操作のたびに追加のAPI呼び出しを発生させない設計。育成データ管理計画.md §6.1が文字列検索の
// クライアント側フィルタを明示的に許容しているため、他の絞り込みも同じ方針に揃えている)。
// 未ログイン時は強制リダイレクトしない。
//
// カードはおよそ210px四方の正方形(ゲーム本編のボックス画面と同じ「スプライトのグリッド」に
// 寄せ、一覧性を優先する)。表示は「公式絵→名前→実数値6値(性格による↑↓付き)→持ち物→技」の
// 優先順。持ち物は公式絵の右下に重ねる小さな丸バッジ(画像のみ。アイテム名まで文字表示すると
// 「こだわりハチマキ」等の長い値が正方形に収まらないため、名前はカードtitleツールチップに
// 回す)。技は実数値グリッドの下に2×2グリッドで表示し、未設定スロットは何も出さない
// (「-」を4つ並べると壊れて見えるため、空文字列はfilterで除外する)。
// タイプバッジ・テラスバッジ・性格表示・特性の常時表示・努力値ミニバーはカードに出さないが、
// 検索対象からは外さない(matchesSearchはタイプ・特性・持ち物・テラスタイプ・技を含む)。
// アイテム画像は公式絵への重ね配置ではなく.card-item-row(名前行と技グリッドの間)に分離し、
// 画像の右にアイテム名を表示する。テラスバッジは.card-badge-rowに残り、アイコンと被らない
// 程度に右へ寄せる。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import SecondHeader from '../../components/SecondHeader.astro';
import '../../styles/box-page.css';
import '../../styles/app-header.css';
import '../../styles/second-header.css';

const user = Astro.locals.user;
---
<AppLayout title="ボックス" description="所持しているポケモンの一覧・検索・並べ替え" current="box">

	<div class="page box-shell floating-list-page">
		{
			user ? (
				<Fragment>
					<AppHeader>
						<h1 class="app-header-title">ボックス</h1>
					</AppHeader>
					{/* app-headerの直下に置く検索・並べ替え帯(SecondHeader、他画面でも再利用する
					    独立コンポーネント)。検索・並べ替え以外の表示(件数バッジ)はここには置かず、
					    #box-filter-rowへ分離する。 */}
					<SecondHeader ariaLabel="検索・並べ替え" class="box-second-header">
						<div class="second-header-search toolbar-item toolbar-search">
							{/* 可視の「検索」ラベルは置かない。このプロジェクトで確立済みの
							    「ラベル要素を廃止しplaceholder+aria-labelに統一」パターンに合わせ、
							    アクセシビリティ上のラベルはaria-labelで維持する。 */}
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="search-input"
									type="search"
									class="field-control"
									placeholder="ポケモン・もちもの・わざ"
									aria-label="検索"
									autocomplete="off"
								/>
							</div>
						</div>

						<div class="second-header-sort toolbar-item toolbar-sort">
							<div class="sort-select-wrap box-sort-select-wrap" id="sort-select-wrap" data-order="desc">
								<button type="button" class="sort-dir-toggle" id="sort-dir-toggle" data-order="desc" aria-label="並べ替えの向き: 降順">⇅</button>
								<select id="sort-select" class="field-control" aria-label="並べ替え">
									<option value="updated_at">更新順</option>
									<option value="dex_no">図鑑番号順</option>
									<option value="type">タイプ順</option>
									<option value="species_name">名前順</option>
								</select>
							</div>
						</div>
					</SecondHeader>

					<div class="box-content">
						{/* 検索・並べ替え以外の絞り込み(件数バッジ)。
						    second-header(検索・並べ替えのみ)とは切り離し、一覧グリッドと一緒に
						    スクロールする行として持つ。 */}
						<div class="box-filter-row" id="box-filter-row">
							{/* 件数バッジ(#pokemon-count-badge)。id/classは変更しない
							    (<script>がgetElementByIdで参照する)。 */}
							<div class="toolbar-item toolbar-count">
								<span class="badge tnum" id="pokemon-count-badge" hidden>0</span>
							</div>
						</div>

						<p id="loading-message" class="loading-center">読み込み中…</p>
						<p id="error-message" hidden></p>

						<div class="box-grid">
							<button type="button" class="add-card-tile floating-list-add-button" id="add-pokemon-button" aria-label="ポケモンを登録">
								<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 5v14" />
									<path d="M5 12h14" />
								</svg>
								<span class="add-card-tile-label">ポケモンを登録</span>
								<span class="add-card-tile-hint" hidden></span>
							</button>
							<div id="owned-pokemon-list"></div>
						</div>

						<div id="empty-message" class="empty-state empty-state-plain" hidden>
							<button type="button" class="add-card-tile empty-state-add-button" id="empty-add-pokemon-button">
								<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 5v14" />
									<path d="M5 12h14" />
								</svg>
								<span class="add-card-tile-label">ポケモンを登録</span>
							</button>
						</div>

						{/* 検索/絞り込みの結果が0件のときの案内。登録自体はあるので空状態
						    (#empty-message)とはメッセージを変え、こちらはカード見た目(アイコン付き)を維持する。 */}
						<div id="no-match-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🔍</p>
							<p class="empty-state-title">条件に一致する個体がありません</p>
							<p class="empty-state-hint">条件を変更してください。</p>
						</div>
					</div>
				</Fragment>
			) : (
				<section class="panel">
					<div class="panel-content">
						<p>個体を管理するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			)
		}
	</div>

	<script>
		import {
			ownedPokemonDisplayName as displayName,
			renderBoxPokemonCard,
		} from "../../lib/box-pokemon-card";
		import { kanaIncludes } from "../../lib/kana";
		import { resolveDexNo, resolveSpeciesTypes } from "../../lib/species-dex";
		import { initializeCardDeleteMode } from "../../lib/card-delete-mode";
		import { reloadOnBfcacheRestore } from "../../lib/shared/reload-on-bfcache-restore";
		import { initializeSortDirectionToggle } from "../../lib/shared/sort-direction-toggle";

		const boxContent = document.querySelector<HTMLElement>(".box-content");
		const boxSecondHeader = document.querySelector<HTMLElement>(".box-second-header");
		const bottomNav = document.querySelector<HTMLElement>(".app-bottom-nav");

		/* CSSトークンの想定高さではなく、実際に描画された固定UIの座標を使う。
		   検索帯が内容で伸縮しても、一覧の上端/下端に左右余白と同じガード帯を残す。 */
		function syncBoxScrollViewport(): void {
			if (!boxContent || !boxSecondHeader) return;
			boxContent.style.setProperty(
				"--box-page-scroll-top",
				`calc(${boxSecondHeader.getBoundingClientRect().bottom}px + var(--box-page-card-scroll-inset))`,
			);
			if (bottomNav) {
				boxContent.style.setProperty(
					"--box-page-scroll-bottom",
					`calc(${window.innerHeight - bottomNav.getBoundingClientRect().top}px + var(--box-page-card-scroll-inset))`,
				);
			}
		}

		syncBoxScrollViewport();
		window.addEventListener("resize", syncBoxScrollViewport);

		interface OwnedPokemon {
			id: string;
			species_name: string;
			level: number | null;
			nature: string | null;
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			evs: number[];
			ivs: number[];
			move_names: string[];
			memo: string | null;
			tags: string[];
			updated_at: string;
			last_used_at: string | null;
		}

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const listRoot = document.getElementById("owned-pokemon-list");
		if (listRoot instanceof HTMLElement) {
			initializeCardDeleteMode(listRoot, ".box-card", ".delete-button");
		}
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const countBadge = el<HTMLElement>("pokemon-count-badge");
			const sortSelect = el<HTMLSelectElement>("sort-select");
			const sortSelectWrap = el<HTMLElement>("sort-select-wrap");
			const sortDirToggle = el<HTMLButtonElement>("sort-dir-toggle");
			const searchInput = el<HTMLInputElement>("search-input");
			const addButton = el<HTMLButtonElement>("add-pokemon-button");
			const emptyAddButton = el<HTMLButtonElement>("empty-add-pokemon-button");

			let allPokemon: OwnedPokemon[] = [];

			// カードの表示にはタイプ・特性・持ち物・テラスタイプ・技を出さないが、検索対象は
			// それらすべてを引き続き含める(表示されない項目も検索できるようにする)。
			function matchesSearch(p: OwnedPokemon, term: string): boolean {
				if (!term) return true;
				const haystack = [
					p.species_name,
					p.ability_name ?? "",
					p.item_name ?? "",
					p.tera_type ?? "",
					...p.move_names,
				].join(" ");
				// AND部分一致(空白区切りの複数語すべてを含む場合のみ一致、育成データ管理計画.md §6.1)
				return term
					.split(/\s+/)
					.filter((t) => t.length > 0)
					// AND条件は維持し、各語の比較だけかな表記に依存しないようにする。
					.every((token) => kanaIncludes(haystack, token));
			}

			const sortDirectionToggle = initializeSortDirectionToggle({
				select: sortSelect,
				selectWrap: sortSelectWrap,
				directionToggle: sortDirToggle,
				defaultOrders: {
					updated_at: "desc",
					dex_no: "asc",
					type: "asc",
					species_name: "asc",
				},
				onChange: () => renderList(),
			});

			function sortPokemon(list: OwnedPokemon[]): OwnedPokemon[] {
				const sort = sortSelect.value;
				const compareAscending = (a: OwnedPokemon, b: OwnedPokemon): number => {
					if (sort === "species_name") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "dex_no") {
						const ad = resolveDexNo(a.species_name);
						const bd = resolveDexNo(b.species_name);
						if (ad === null && bd !== null) return 1;
						if (ad !== null && bd === null) return -1;
						if (ad !== bd) return (ad ?? 0) - (bd ?? 0);
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "type") {
						const aTypes = resolveSpeciesTypes(a.species_name).join("/");
						const bTypes = resolveSpeciesTypes(b.species_name).join("/");
						if (!aTypes && bTypes) return 1;
						if (aTypes && !bTypes) return -1;
						const typeResult = aTypes.localeCompare(bTypes, "ja");
						return typeResult || displayName(a).localeCompare(displayName(b), "ja");
					}
					return new Date(a.updated_at).getTime() - new Date(b.updated_at).getTime();
				};
				return [...list].sort((a, b) => {
					if (sort === "dex_no") {
						const ad = resolveDexNo(a.species_name);
						const bd = resolveDexNo(b.species_name);
						if (ad === null && bd !== null) return 1;
						if (ad !== null && bd === null) return -1;
					}
					const result = compareAscending(a, b);
					return sortDirectionToggle.getSortOrder() === "desc" ? -result : result;
				});
			}

			// UI刷新: カード全体を<a>にして丸ごとクリック可能にする(要件3、遷移先は/box/{id})。
			// 削除のアイコンボタンは<a>の中の<button>として置くが、クリック時は必ず
			// preventDefault/stopPropagationしてカード本体の遷移と競合しないようにする。
			// カード本体は「公式絵→名前→実数値6値→持ち物→技」で、タイプ・性格・特性は
			// title属性(ホバーツールチップ)で参照する。
			function renderCard(p: OwnedPokemon): HTMLAnchorElement {
				const card = document.createElement("a");
				card.href = `/box/${encodeURIComponent(p.id)}`;
				const name = displayName(p);
				return renderBoxPokemonCard({
					root: card,
					pokemon: p,
					displayName: name,
					ariaLabel: `${name}を編集`,
					onDelete: () => deletePokemon(p),
				});
			}

			function renderList(): void {
				const filtered = allPokemon.filter((p) => matchesSearch(p, searchInput.value.trim()));
				const sorted = sortPokemon(filtered);
				listRoot.innerHTML = "";
				// 「本当に0件」と「絞り込みで0件」を区別する。#no-match-messageはグリッドの外に
				// 置く(グリッド内だと縮んだ追加タイルの右横に宙に浮いて見えるため)。
				// #empty-messageと同じ.empty-stateの見た目に揃える。
				const isTrulyEmpty = allPokemon.length === 0;
				boxContent?.classList.toggle("is-truly-empty", isTrulyEmpty);
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				updateCountBadge(sorted.length);
				if (isTrulyEmpty) return;
				for (const p of sorted) {
					listRoot.appendChild(renderCard(p));
				}
			}

			async function deletePokemon(p: OwnedPokemon): Promise<void> {
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allPokemon = allPokemon.filter((x) => x.id !== p.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("個体を削除できませんでした。時間をおいて再度お試しください。");
				}
			}

			// 絞り込み/検索の状態にかかわらず、件数バッジには現在の表示件数だけを示す。
			// renderList()が呼ばれるたびに毎回渡されるので、その値をそのまま文字列化する。
			function updateCountBadge(visibleCount: number): void {
				countBadge.textContent = String(visibleCount);
				countBadge.hidden = false;
			}

			async function loadList(): Promise<void> {
				loadingMessage.hidden = false;
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemon[] };
					allPokemon = body.data;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "個体一覧を読み込めませんでした。時間をおいて再度お試しください。";
				}
			}

			searchInput.addEventListener("input", renderList);
			// 新規個体は種族を確定してから編集画面側で登録する。
			function goToNewPokemon(): void {
				window.location.href = "/box/new";
			}
			addButton.addEventListener("click", goToNewPokemon);
			emptyAddButton.addEventListener("click", goToNewPokemon);

			void loadList();
			reloadOnBfcacheRestore(() => void loadList());
		}
	</script>
</AppLayout>
