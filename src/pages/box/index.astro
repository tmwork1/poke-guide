---
// 個体一覧ページ(ボックス)。サイトのホームでもある。
// docs/ui_proposal/Box.png のワイヤーフレーム(上部に検索/絞り込み/並べ替えの横一列ツールバー、
// その下にカードグリッド。グリッド先頭セルは「追加」タイル)に準拠する。
// ログイン時は GET /api/owned-pokemon から取得した一覧をクライアント側で描画する
// (並び替え・タグフィルタ・文字列検索はいずれも初回取得後にクライアント側で完結させ、
// 操作のたびに追加のAPI呼び出しを発生させない設計。育成データ管理計画.md §6.1が文字列検索の
// クライアント側フィルタを明示的に許容しているため、他の絞り込みも同じ方針に揃えている)。
// 未ログイン時は強制リダイレクトしない。
//
// カードはおよそ210px四方の正方形(ゲーム本編のボックス画面と同じ「スプライトのグリッド」に
// 寄せ、一覧性を優先する)。表示は「公式絵→名前→実数値6値(性格による↑↓付き)→持ち物→技」の
// 優先順。持ち物は公式絵の右下に重ねる小さな丸バッジ(画像のみ。アイテム名まで文字表示すると
// 「こだわりハチマキ」等の長い値が正方形に収まらないため、名前はカードtitleツールチップに
// 回す)。技は実数値グリッドの下に2×2グリッドで表示し、未設定スロットは何も出さない
// (「-」を4つ並べると壊れて見えるため、空文字列はfilterで除外する)。
// タイプバッジ・テラスバッジ・性格表示・特性の常時表示・努力値ミニバーはカードに出さないが、
// 検索対象からは外さない(matchesSearchはタイプ・特性・持ち物・テラスタイプ・技を含む)。
// アイテム画像は公式絵への重ね配置ではなく.card-item-row(名前行と技グリッドの間)に分離し、
// 画像の右にアイテム名を表示する。テラスバッジは.card-badge-rowに残り、アイコンと被らない
// 程度に右へ寄せる。
// 絞り込みUIは「お気に入りのみ表示」の単一トグル(favoriteFilterToggle/matchesFavorite)のみ
// (タグ自体のデータ・保存経路には触れない)。ピン留め(お気に入り)はカード全体のハイライトは
// せず、★/☆マーク表示だけで示す。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/box-page.css';
// レギュレーションの選択肢は jpoke 由来の一覧(src/lib/regulations.ts)。画面側で
// レギュレーション名をハードコードしない。定義順のREGULATIONSではなく、新しい順の
// REGULATIONS_NEWEST_FIRSTを使う。
import { REGULATIONS_NEWEST_FIRST } from '../../lib/regulations';

const user = Astro.locals.user;
---
<AppLayout title="ボックス" description="所持しているポケモンの一覧・検索・並べ替え" current="box" hideTopbar={true}>

	<div class="page box-shell floating-list-page">
		{
			user ? (
				<Fragment>
					<h1 class="box-page-title">ボックス</h1>
					<div class="panel panel-top second-bar second-bar--toolbar floating-list-toolbar" id="box-toolbar">
						{/* 件数バッジ(#pokemon-count-badge)。id/classは変更しない
						    (<script>がgetElementByIdで参照する)。 */}
						<div class="toolbar-item toolbar-count">
							<span class="badge tnum" id="pokemon-count-badge" hidden>0</span>
						</div>
						<div class="toolbar-item toolbar-search">
							{/* 可視の「検索」ラベルは置かない。このプロジェクトで確立済みの
							    「ラベル要素を廃止しplaceholder+aria-labelに統一」パターンに合わせ、
							    アクセシビリティ上のラベルはaria-labelで維持する。 */}
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="search-input"
									type="search"
									class="field-control"
									placeholder=" "
									aria-label="検索"
									autocomplete="off"
								/>
							</div>
						</div>

						<div class="toolbar-item toolbar-favorite">
							{/* 絞り込みUIは「お気に入りのみ表示」の単一トグルのみ(複数タグ選択のUIは
							    持たない)。データ側のtagsフィールド・保存経路には触れない。 */}
							<button
								type="button"
								id="favorite-filter-toggle"
								class="favorite-filter-toggle"
								data-active="false"
								aria-pressed="false"
							>
								<span class="favorite-filter-star" aria-hidden="true">★</span> お気に入り
							</button>
						</div>

						{/* お気に入りトグルと並べ替えの間に置く(左から 検索 → お気に入り →
						    レギュレーション → 並べ替え)。既存の絞り込み(検索・お気に入り)と同じく
						    サーバーには問い合わせず、取得済みの一覧をクライアント側で絞る。
						    可視ラベルをselectと関連付け、選択肢は具体的なレギュレーションと
						    「すべて」に絞る。 */}
						<div class="toolbar-item toolbar-regulation">
							<label class="field-label" for="regulation-filter">レギュレーション</label>
							<select id="regulation-filter" class="field-control">
								<option value="">すべて</option>
								{REGULATIONS_NEWEST_FIRST.map((r) => <option value={r}>{r}</option>)}
							</select>
						</div>

						<div class="toolbar-item toolbar-sort">
							<div class="sort-select-wrap" id="sort-select-wrap" data-order="desc">
								<svg class="sort-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 20V4" />
									<path d="M6 10l6-6 6 6" />
								</svg>
								<select id="sort-select" class="field-control" aria-label="並べ替え">
									<option value="updated_at">最終更新</option>
									<option value="last_used_at">よく使う</option>
									<option value="dex_no">図鑑番号</option>
									<option value="nickname">ニックネーム</option>
								</select>
							</div>
							<button type="button" class="sort-dir-toggle" id="sort-dir-toggle" data-order="desc" aria-label="並べ替えの向き: 降順">
								<svg class="sort-dir-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 20V4" /><path d="M6 10l6-6 6 6" />
								</svg>
								<span class="sort-dir-toggle-label">Z→A</span>
							</button>
						</div>

					</div>

					<div class="box-content">
						<p id="loading-message">読み込み中…</p>
						<p id="error-message" hidden></p>

						<div class="box-grid">
							<button type="button" class="add-card-tile floating-list-add-button" id="add-pokemon-button" aria-label="個体を追加">
								<span class="add-card-tile-icon" aria-hidden="true">＋</span>
								<span class="add-card-tile-label">個体を追加</span>
								<span class="add-card-tile-hint" hidden></span>
							</button>
							<div id="owned-pokemon-list"></div>
						</div>

						<div id="empty-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">📦</p>
							<p class="empty-state-title">個体が登録されていません</p>
							<p class="empty-state-hint" hidden></p>
						</div>

						{/* 検索/絞り込みの結果が0件のときの案内。登録自体はあるので空状態
						    (#empty-message)とはメッセージを変え、見た目だけ揃える。 */}
						<div id="no-match-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🔍</p>
							<p class="empty-state-title">条件に一致する個体がありません</p>
							<p class="empty-state-hint">条件を変更してください。</p>
						</div>
					</div>
				</Fragment>
			) : (
				<section class="panel">
					<div class="panel-content">
						<p>個体を管理するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			)
		}
	</div>

	<script>
		import {
			ownedPokemonDisplayName as displayName,
			renderBoxPokemonCard,
		} from "../../lib/box-pokemon-card";
		import { kanaIncludes } from "../../lib/kana";
		import { resolveDexNo } from "../../lib/species-dex";
		import { initializeCardDeleteMode } from "../../lib/card-delete-mode";

		interface OwnedPokemon {
			id: string;
			nickname: string | null;
			species_name: string;
			level: number | null;
			nature: string | null;
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			// レギュレーション(migrations/013_regulation.sql)。未指定は null。
			regulation: string | null;
			evs: number[];
			ivs: number[];
			move_names: string[];
			memo: string | null;
			tags: string[];
			is_pinned: boolean;
			updated_at: string;
			last_used_at: string | null;
		}

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const listRoot = document.getElementById("owned-pokemon-list");
		if (listRoot instanceof HTMLElement) {
			initializeCardDeleteMode(listRoot, ".box-card", ".delete-button");
		}
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const countBadge = el<HTMLElement>("pokemon-count-badge");
			const sortSelect = el<HTMLSelectElement>("sort-select");
			const sortSelectWrap = el<HTMLElement>("sort-select-wrap");
			const sortDirToggle = el<HTMLButtonElement>("sort-dir-toggle");
			const sortDirToggleLabel = sortDirToggle.querySelector<HTMLElement>(".sort-dir-toggle-label");
			if (!sortDirToggleLabel) throw new Error("要素が見つかりません: .sort-dir-toggle-label");
			const searchInput = el<HTMLInputElement>("search-input");
			const favoriteFilterToggle = el<HTMLButtonElement>("favorite-filter-toggle");
			const regulationFilter = el<HTMLSelectElement>("regulation-filter");
			const addButton = el<HTMLButtonElement>("add-pokemon-button");
			// textContentではなくinnerHTMLで保存する。addButtonは「＋」の大きいアイコンと
			// ラベルの2要素構成(見た目の要件2)なので、ローディング表示から復元する際に
			// プレーンテキストへ潰さないため。
			const ADD_BUTTON_DEFAULT_HTML = addButton.innerHTML;

			let allPokemon: OwnedPokemon[] = [];
			let sortOrder: "asc" | "desc" = "desc";
			let favoriteOnly = false;

			// カードの表示にはタイプ・特性・持ち物・テラスタイプ・技を出さないが、検索対象は
			// それらすべてを引き続き含める(表示されない項目も検索できるようにする)。
			function matchesSearch(p: OwnedPokemon, term: string): boolean {
				if (!term) return true;
				const haystack = [
					p.nickname ?? "",
					p.species_name,
					p.ability_name ?? "",
					p.item_name ?? "",
					p.tera_type ?? "",
					...p.move_names,
				].join(" ");
				// AND部分一致(空白区切りの複数語すべてを含む場合のみ一致、育成データ管理計画.md §6.1)
				return term
					.split(/\s+/)
					.filter((t) => t.length > 0)
					// AND条件は維持し、各語の比較だけかな表記に依存しないようにする。
					.every((token) => kanaIncludes(haystack, token));
			}

			// お気に入り=is_pinnedと同義(pinButtonの★/☆と同じデータ)。
			function matchesFavorite(p: OwnedPokemon): boolean {
				return !favoriteOnly || p.is_pinned;
			}

			// ""=すべて / 選択肢にある値=そのレギュレーションの個体だけ。
			// 廃止済みの値や未知の値は、URLクエリ等から渡されても「すべて」として扱う。
			function matchesRegulation(p: OwnedPokemon): boolean {
				const selected = regulationFilter.value;
				const isKnownSelection = Array.from(regulationFilter.options).some((option) => option.value === selected);
				if (selected === "" || !isKnownSelection) return true;
				return p.regulation === selected;
			}

			function sortPokemon(list: OwnedPokemon[]): OwnedPokemon[] {
				const sort = sortSelect.value;
				const compareAscending = (a: OwnedPokemon, b: OwnedPokemon): number => {
					if (sort === "last_used_at") {
						return new Date(a.last_used_at ?? 0).getTime() - new Date(b.last_used_at ?? 0).getTime();
					}
					if (sort === "nickname") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "dex_no") {
						const ad = resolveDexNo(a.species_name);
						const bd = resolveDexNo(b.species_name);
						if (ad === null && bd !== null) return 1;
						if (ad !== null && bd === null) return -1;
						if (ad !== bd) return (ad ?? 0) - (bd ?? 0);
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					return new Date(a.updated_at).getTime() - new Date(b.updated_at).getTime();
				};
				// お気に入りはカードのマークだけで示し、選択した並べ替え軸には介入させない。
				return [...list].sort((a, b) => {
					if (sort === "last_used_at") {
						if (a.last_used_at === null && b.last_used_at !== null) return 1;
						if (a.last_used_at !== null && b.last_used_at === null) return -1;
					}
					if (sort === "dex_no") {
						const ad = resolveDexNo(a.species_name);
						const bd = resolveDexNo(b.species_name);
						if (ad === null && bd !== null) return 1;
						if (ad !== null && bd === null) return -1;
					}
					const result = compareAscending(a, b);
					return sortOrder === "desc" ? -result : result;
				});
			}

			// UI刷新: カード全体を<a>にして丸ごとクリック可能にする(要件3、遷移先は/box/{id})。
			// ピン留め/削除のアイコンボタンは<a>の中の<button>として置くが、クリック時は必ず
			// preventDefault/stopPropagationしてカード本体の遷移と競合しないようにする。
			// カード本体は「公式絵→名前→実数値6値→持ち物→技」で、タイプ・性格・特性は
			// title属性(ホバーツールチップ)で参照する。
			function renderCard(p: OwnedPokemon): HTMLAnchorElement {
				const card = document.createElement("a");
				card.href = `/box/${encodeURIComponent(p.id)}`;
				const name = displayName(p);
				return renderBoxPokemonCard({
					root: card,
					pokemon: p,
					displayName: name,
					ariaLabel: `${name}を編集`,
					pin: {
						isPinned: p.is_pinned,
						onToggle: () => togglePin(p),
					},
					onDelete: () => deletePokemon(p),
				});
			}

			function renderList(): void {
				const filtered = allPokemon.filter(
					(p) => matchesFavorite(p) && matchesRegulation(p) && matchesSearch(p, searchInput.value.trim()),
				);
				const sorted = sortPokemon(filtered);
				listRoot.innerHTML = "";
				// 「本当に0件」と「絞り込みで0件」を区別する。#no-match-messageはグリッドの外に
				// 置く(グリッド内だと縮んだ追加タイルの右横に宙に浮いて見えるため)。
				// #empty-messageと同じ.empty-stateの見た目に揃える。
				const isTrulyEmpty = allPokemon.length === 0;
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				updateCountBadge(sorted.length);
				if (isTrulyEmpty) return;
				for (const p of sorted) {
					listRoot.appendChild(renderCard(p));
				}
			}

			async function togglePin(p: OwnedPokemon): Promise<void> {
				try {
					// is_pinnedだけを更新しupdated_atに触れない専用のPATCH経路
					// (updatePinStatus、src/lib/owned-pokemon.ts)を呼ぶ。PUT(全項目上書き)経由だと
					// サーバ側が無条件でupdated_atを現在時刻へ進めてしまい、「更新順」表示中に
					// お気に入りをトグルした個体が自分自身の表示順位置まで動いてしまうため、
					// この専用経路でどの個体の位置も動かさないようにする。
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "PATCH",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ is_pinned: !p.is_pinned }),
					});
					if (!res.ok) throw new Error(`ピン留めの更新に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemon };
					const idx = allPokemon.findIndex((x) => x.id === p.id);
					if (idx !== -1) allPokemon[idx] = body.data;
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("ピン留めを更新できませんでした。時間をおいて再度お試しください。");
				}
			}

			async function deletePokemon(p: OwnedPokemon): Promise<void> {
				if (!window.confirm(`「${displayName(p)}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allPokemon = allPokemon.filter((x) => x.id !== p.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("個体を削除できませんでした。時間をおいて再度お試しください。");
				}
			}

			// 絞り込み/検索の状態にかかわらず、件数バッジには現在の表示件数だけを示す。
			// renderList()が呼ばれるたびに毎回渡されるので、その値をそのまま文字列化する。
			function updateCountBadge(visibleCount: number): void {
				countBadge.textContent = String(visibleCount);
				countBadge.hidden = false;
			}

			// 「＋ 個体を追加」: クリックした瞬間に空個体(全項目未設定、ivsは
			// チャンピオンズルールにより31固定、evsは0)を自動登録し、そのまま編集画面(/box/[id])へ
			// 遷移する(/box/new の新規作成フォームは廃止)。連打による二重登録を防ぐため、
			// リクエスト中はボタンをdisabledにしてラベルを変更し、失敗時のみ復元する
			// (成功時はページ遷移するため復元不要)。
			async function createEmptyPokemon(): Promise<void> {
				addButton.disabled = true;
				addButton.textContent = "登録中…";
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							nickname: "",
							species_name: "",
							level: null,
							nature: "",
							ability_name: "",
							item_name: "",
							tera_type: "",
							regulation: "",
							evs: [0, 0, 0, 0, 0, 0],
							ivs: [31, 31, 31, 31, 31, 31],
							move_names: [],
							memo: "",
							tags: [],
							is_pinned: false,
						}),
					});
					const body = (await res.json().catch(() => ({}))) as { data?: { id: string }; error?: string };
					if (!res.ok || !body.data) {
						throw new Error(body.error ?? `登録に失敗しました (status=${res.status})`);
					}
					window.location.href = `/box/${encodeURIComponent(body.data.id)}`;
				} catch (err) {
					console.error(err);
					errorMessage.hidden = false;
					errorMessage.textContent = "個体を登録できませんでした。時間をおいて再度お試しください。";
					addButton.disabled = false;
					addButton.innerHTML = ADD_BUTTON_DEFAULT_HTML;
				}
			}

			async function loadList(): Promise<void> {
				loadingMessage.hidden = false;
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemon[] };
					allPokemon = body.data;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "個体一覧を読み込めませんでした。時間をおいて再度お試しください。";
				}
			}

			sortSelect.addEventListener("change", () => {
				const defaultOrders: Record<string, "asc" | "desc"> = {
					updated_at: "desc",
					last_used_at: "desc",
					dex_no: "asc",
					nickname: "asc",
				};
				sortOrder = defaultOrders[sortSelect.value] ?? "asc";
				updateSortOrderUi();
				renderList();
			});
			function updateSortOrderUi(): void {
				sortSelectWrap.dataset.order = sortOrder;
				sortDirToggle.dataset.order = sortOrder;
				const isAscending = sortOrder === "asc";
				sortDirToggle.setAttribute("aria-label", `並べ替えの向き: ${isAscending ? "昇順" : "降順"}`);
				sortDirToggleLabel.textContent = isAscending ? "A→Z" : "Z→A";
			}
			sortDirToggle.addEventListener("click", () => {
				sortOrder = sortOrder === "asc" ? "desc" : "asc";
				updateSortOrderUi();
				renderList();
			});
			searchInput.addEventListener("input", renderList);
			regulationFilter.addEventListener("change", renderList);
			favoriteFilterToggle.addEventListener("click", () => {
				favoriteOnly = !favoriteOnly;
				favoriteFilterToggle.dataset.active = String(favoriteOnly);
				favoriteFilterToggle.setAttribute("aria-pressed", String(favoriteOnly));
				renderList();
			});
			addButton.addEventListener("click", () => void createEmptyPokemon());

			void loadList();
		}
	</script>
</AppLayout>
