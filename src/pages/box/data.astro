---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobileTrainingBar from '../../components/box-id/MobileTrainingBar.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import seasonManifest from '../../../data/opgg-champions-usage/seasons.json';
import '../../styles/data-page.css';
// 上位構築タブのカードは /team 一覧・/team/[id] の類似構築タブと共用の renderTopBuildCard() を
// そのまま使うため、そのスタイル定義元(box-card.cssを@importしている)も読み込む。
import '../../styles/team-card.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : null;
let rankedSeason: string | null = null;
if (pokemon) {
  try {
    rankedSeason = resolveDefaultSeason(await listRankedSeasons(await getSupabasePublicClient()));
  } catch (error) {
    console.error('[box/data] 上位構築のシーズン取得に失敗しました:', error);
  }
}
const dataFiles = import.meta.glob('../../../data/opgg-champions-usage/seasons/*/*.json', {
  eager: true,
  import: 'default',
});
const manifestSeasons = [...(seasonManifest.seasons ?? [])].sort((a, b) => {
  const currentSeasonId = seasonManifest.currentSeasonId;
  const aIsCurrent = a.isCurrent || a.id === currentSeasonId;
  const bIsCurrent = b.isCurrent || b.id === currentSeasonId;
  if (aIsCurrent && !bIsCurrent) return -1;
  if (bIsCurrent && !aIsCurrent) return 1;
  return String(b.fetchedAt ?? '').localeCompare(String(a.fetchedAt ?? ''));
});
const hasSingleBattleData = (value: any) => {
  const single = value?.formats?.single;
  return Boolean(
    single &&
      ['abilities', 'natures', 'items', 'moves', 'evs', 'teammates'].some(
        (key) => Array.isArray(single[key]) && single[key].length,
      ),
  );
};
const seasons = pokemon
  ? manifestSeasons.filter((entry) =>
      Object.entries(dataFiles).some(
        ([path, value]: any) =>
          path.includes(`/${entry.directory}/`) &&
          value?.name === pokemon.species_name &&
          hasSingleBattleData(value),
      ),
    )
  : [];
const requestedSeason = Astro.url.searchParams.get('season');
const seasonIds = seasons.map((entry) => entry.id);
const season = seasonIds.includes(requestedSeason ?? '') ? requestedSeason! : seasons[0]?.id ?? null;

// Keep SSR output, the selected option and the shared URL in agreement.  A
// manifest season without this Pokemon's battle payload must not stay in the URL.
if (pokemon && requestedSeason && season && requestedSeason !== season) {
  return Astro.redirect(`/box/data?pokemon=${encodeURIComponent(selectedId!)}&season=${encodeURIComponent(season)}`);
}

const seasonDirectory = seasons.find((entry) => entry.id === season)?.directory;
const opgg = pokemon && seasonDirectory
  ? (Object.entries(dataFiles).find(
      ([path, value]: any) =>
        path.includes(`/${seasonDirectory}/`) && value?.name === pokemon.species_name,
    )?.[1] as any)
  : null;
const single = opgg?.formats?.single;
const hasData = hasSingleBattleData(opgg);
const ranked = (
  rows: Array<{ rank: number; name: string; usageRate: number | null }> | undefined,
  teammate = false,
) =>
  rows?.slice(0, 4).map((row) =>
    `${row.rank}. ${row.name} — ${teammate || row.usageRate === null ? '使用率非公開' : `${row.usageRate}%`}`,
  ).join('\n') || 'データなし';
const evRanked = (
  rows: Array<{ rank: number; usageRate: number; values: Record<string, number> }> | undefined,
) =>
  rows?.slice(0, 4).map((row) =>
    `${row.rank}. H${row.values.hp}/A${row.values.attack}/B${row.values.defense}/C${row.values.specialAttack}/D${row.values.specialDefense}/S${row.values.speed} — ${row.usageRate}%`,
  ).join('\n') || 'データなし';
---

<AppLayout title="データ" description="OP.GG使用率データ" current="box" hideTopbar={true}>
  <div class="page box-data-page">
    {pokemon ? (
      <MobileTrainingBar pokemon={pokemon} activeTab="data" />
    ) : (
      <section class="pokemon-data-preview" aria-labelledby="data-preview-title">
        <p class="data-kicker">育成データレビュー</p>
        <h1 id="data-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「データ」から、選択中のポケモンの使用率を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {pokemon && (
      <main
        class="box-data-main"
        data-ranked-season={rankedSeason ?? ''}
        data-pokemon-build={JSON.stringify({
          species_name: pokemon.species_name,
          ability_name: pokemon.ability_name,
          item_name: pokemon.item_name,
          move_names: pokemon.move_names,
        })}
      >
        <div class="data-view-controls" role="tablist" aria-label="データ表示">
          <button id="battle-data-tab" type="button" role="tab" aria-selected="true">
            バトルデータ
          </button>
          <button id="ranked-data-tab" type="button" role="tab" aria-selected="false">
            上位構築
          </button>
          {seasons.length > 0 && (
            <button
              class="data-season-unavailable"
              type="button"
              disabled
              title="シーズンを読み込み中"
            >
              シーズン
            </button>
          )}
        </div>

        <section id="battle-data-panel" class="data-panel" role="tabpanel" aria-labelledby="battle-data-tab">
          {hasData ? (
            <>
              <h2 id="trend-title">トレンド</h2>
              <div class="trend-detail-card">
                <div class="trend-detail-cell"><span>特性</span><strong>{ranked(single?.abilities)}</strong></div>
                <div class="trend-detail-cell"><span>性格</span><strong>{ranked(single?.natures)}</strong></div>
                <div class="trend-detail-cell"><span>アイテム</span><strong>{ranked(single?.items)}</strong></div>
                <div class="trend-detail-cell"><span>わざ</span><strong>{ranked(single?.moves)}</strong></div>
                <div class="trend-detail-cell"><span>努力値</span><strong>{evRanked(single?.evs)}</strong></div>
                <div class="trend-detail-cell"><span>同時採用ポケモン</span><strong>{ranked(single?.teammates, true)}</strong></div>
              </div>
            </>
          ) : (
            <section class="data-empty" aria-live="polite">
              <h2>バトルデータなし</h2>
              <p>このポケモンのシングルバトルデータはまだありません。</p>
            </section>
          )}
        </section>

        <section id="ranked-data-panel" class="data-panel" role="tabpanel" aria-labelledby="ranked-data-tab" hidden>
          <h2>上位構築</h2>
          {rankedSeason ? (
            <p id="ranked-data-status" class="box-ranked-status status-text" data-state="loading">上位構築を計算中…</p>
          ) : (
            <p id="ranked-data-status" class="box-ranked-status status-text">上位構築データはまだありません。</p>
          )}
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script define:vars={{ seasons, season, selectedId }}>
  const unavailable = document.querySelector('.data-season-unavailable');
  if (unavailable && seasons.length) {
    const select = document.createElement('select');
    select.className = 'data-season-select';
    for (const entry of seasons) {
      select.add(new Option(entry.label ?? entry.id, entry.id, entry.id === season, entry.id === season));
    }
    select.addEventListener('change', () => {
      const params = new URLSearchParams();
      if (selectedId) params.set('pokemon', selectedId);
      params.set('season', select.value);
      window.location.search = params.toString();
    });
    unavailable.replaceWith(select);
  }
</script>

<script>
  const battleTab = document.querySelector<HTMLButtonElement>('#battle-data-tab');
  const rankedTab = document.querySelector<HTMLButtonElement>('#ranked-data-tab');
  const battlePanel = document.querySelector<HTMLElement>('#battle-data-panel');
  const rankedPanel = document.querySelector<HTMLElement>('#ranked-data-panel');
  battleTab?.addEventListener('click', () => {
    battleTab.setAttribute('aria-selected', 'true');
    rankedTab?.setAttribute('aria-selected', 'false');
    if (battlePanel) battlePanel.hidden = false;
    if (rankedPanel) rankedPanel.hidden = true;
  });
  rankedTab?.addEventListener('click', () => {
    rankedTab.setAttribute('aria-selected', 'true');
    battleTab?.setAttribute('aria-selected', 'false');
    if (rankedPanel) rankedPanel.hidden = false;
    if (battlePanel) battlePanel.hidden = true;
  });
</script>

<script>
  import { calculateBuildSimilarity } from '../../lib/build-similarity';
  import { renderTopBuildCard } from '../../lib/ranked-teams/card';
  import type { RankedTeam } from '../../lib/ranked-teams';

  const main = document.querySelector<HTMLElement>('.box-data-main');
  const panel = document.querySelector<HTMLElement>('#ranked-data-panel');
  const rankedSeason = main?.dataset.rankedSeason || null;
  const pokemonBuildJson = main?.dataset.pokemonBuild;

  function setRankedStatus(message: string, state?: 'loading' | 'error'): void {
    if (!panel) return;
    panel.innerHTML = '<h2>上位構築</h2>';
    const status = document.createElement('p');
    status.className = 'box-ranked-status status-text';
    if (state) status.dataset.state = state;
    status.textContent = message;
    panel.appendChild(status);
  }

  async function loadRankedBuilds(): Promise<void> {
    if (!panel || !rankedSeason || !pokemonBuildJson) return;

    const pokemonBuild = JSON.parse(pokemonBuildJson) as {
      species_name: string;
      ability_name: string | null;
      item_name: string | null;
      move_names: string[];
    };

    try {
      const response = await fetch(`/api/ranked-teams?season=${encodeURIComponent(rankedSeason)}`, {
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error(`上位構築の取得に失敗しました (status=${response.status})`);
      const body = (await response.json()) as { teams: RankedTeam[] };
      const teams = body.teams ?? [];
      const scored = teams
        .map((team) => {
          const matched = team.members.find((member) => member.speciesName === pokemonBuild.species_name);
          return matched ? { team, similarity: calculateBuildSimilarity(pokemonBuild, matched) } : null;
        })
        .filter((entry): entry is { team: RankedTeam; similarity: number } => entry !== null)
        .sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);

      if (scored.length === 0) {
        setRankedStatus('この個体を採用した上位構築がありません。');
        return;
      }

      const list = document.createElement('div');
      list.className = 'team-grid';
      for (const entry of scored) list.appendChild(renderTopBuildCard(entry.team));
      panel.innerHTML = '<h2>上位構築</h2>';
      panel.appendChild(list);
    } catch (error) {
      console.error(error);
      setRankedStatus('上位構築を読み込めませんでした。', 'error');
    }
  }

  void loadRankedBuilds();
</script>
