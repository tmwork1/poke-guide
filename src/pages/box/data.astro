---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobileTrainingBar from '../../components/box-id/MobileTrainingBar.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import {
  listRankedSeasons,
  listRankedTeamsBySeason,
  type RankedTeam,
} from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import { calculateBuildSimilarity } from '../../lib/build-similarity';
import '../../styles/data-page.css';
import '../../styles/box-card.css';
import '../../styles/ranked-team-card.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : null;

let similarTeams: Array<RankedTeam & { similarity: number }> = [];
let similarBuildsError = '';
if (pokemon) {
  try {
    const supabasePublic = await getSupabasePublicClient();
    const seasons = await listRankedSeasons(supabasePublic);
    const season = resolveDefaultSeason(seasons);
    if (season) {
      const teams = await listRankedTeamsBySeason(season, supabasePublic);
      similarTeams = teams
        .flatMap((team) => {
          const member = team.members.find((m) => m.speciesName === pokemon.species_name);
          if (!member) return [];
          return [{ ...team, similarity: calculateBuildSimilarity(pokemon, member) }];
        })
        .sort((a, b) => b.similarity - a.similarity || a.rank - b.rank);
    }
  } catch (error) {
    console.error('[box/data] 類似構築の取得に失敗しました:', error);
    similarBuildsError = '類似構築を読み込めませんでした。';
  }
}
---

<AppLayout title="類似構築" description="育成内容が近いランク入り構築" current="box" hideTopbar={true}>
  <div class="page box-data-page">
    {pokemon ? (
      <MobileTrainingBar pokemon={pokemon} activeTab="data" />
    ) : (
      <section class="pokemon-data-preview" aria-labelledby="data-preview-title">
        <p class="data-kicker">類似構築</p>
        <h1 id="data-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「類似構築」から、選択中のポケモンに近い上位構築を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {pokemon && (
      <main class="box-data-main">
        <section id="similar-builds-panel" class="data-panel" aria-label="類似構築">
          <h2>類似構築</h2>
          {similarBuildsError ? (
            <p class="data-pending" role="alert">{similarBuildsError}</p>
          ) : similarTeams.length === 0 ? (
            <p class="data-pending">類似する上位構築がありません。</p>
          ) : (
            <div id="similar-builds-cards" class="ranked-team-cards" data-teams={JSON.stringify(similarTeams)}></div>
          )}
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script>
  import { renderTopBuildCard } from '../../lib/ranked-teams/card';

  const root = document.querySelector<HTMLElement>('#similar-builds-cards');
  if (root) {
    const teams = JSON.parse(root.dataset.teams ?? '[]');
    for (const team of teams) {
      root.appendChild(renderTopBuildCard(team));
    }
  }
</script>
