---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobileTrainingBar from '../../components/box-id/MobileTrainingBar.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { getSupabaseAdminClient } from '../../lib/supabase';
import seasonManifest from '../../../data/opgg-champions-usage/seasons.json';
import '../../styles/data-page.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : null;
const dataFiles = import.meta.glob('../../../data/opgg-champions-usage/seasons/*/*.json', {
  eager: true,
  import: 'default',
});
const manifestSeasons = [...(seasonManifest.seasons ?? [])].sort((a, b) => {
  const currentSeasonId = seasonManifest.currentSeasonId;
  const aIsCurrent = a.isCurrent || a.id === currentSeasonId;
  const bIsCurrent = b.isCurrent || b.id === currentSeasonId;
  if (aIsCurrent && !bIsCurrent) return -1;
  if (bIsCurrent && !aIsCurrent) return 1;
  return String(b.fetchedAt ?? '').localeCompare(String(a.fetchedAt ?? ''));
});
const hasSingleBattleData = (value: any) => {
  const single = value?.formats?.single;
  return Boolean(
    single &&
      ['abilities', 'natures', 'items', 'moves', 'evs', 'teammates'].some(
        (key) => Array.isArray(single[key]) && single[key].length,
      ),
  );
};
const seasons = pokemon
  ? manifestSeasons.filter((entry) =>
      Object.entries(dataFiles).some(
        ([path, value]: any) =>
          path.includes(`/${entry.directory}/`) &&
          value?.name === pokemon.species_name &&
          hasSingleBattleData(value),
      ),
    )
  : [];
const requestedSeason = Astro.url.searchParams.get('season');
const seasonIds = seasons.map((entry) => entry.id);
const season = seasonIds.includes(requestedSeason ?? '') ? requestedSeason! : seasons[0]?.id ?? null;

// Keep SSR output, the selected option and the shared URL in agreement.  A
// manifest season without this Pokemon's battle payload must not stay in the URL.
if (pokemon && requestedSeason && season && requestedSeason !== season) {
  return Astro.redirect(`/box/data?pokemon=${encodeURIComponent(selectedId!)}&season=${encodeURIComponent(season)}`);
}

const seasonDirectory = seasons.find((entry) => entry.id === season)?.directory;
const opgg = pokemon && seasonDirectory
  ? (Object.entries(dataFiles).find(
      ([path, value]: any) =>
        path.includes(`/${seasonDirectory}/`) && value?.name === pokemon.species_name,
    )?.[1] as any)
  : null;
const single = opgg?.formats?.single;
const hasData = hasSingleBattleData(opgg);
const ranked = (
  rows: Array<{ rank: number; name: string; usageRate: number | null }> | undefined,
  teammate = false,
) =>
  rows?.slice(0, 4).map((row) =>
    `${row.rank}. ${row.name} — ${teammate || row.usageRate === null ? '使用率非公開' : `${row.usageRate}%`}`,
  ).join('\n') || 'データなし';
const evRanked = (
  rows: Array<{ rank: number; usageRate: number; values: Record<string, number> }> | undefined,
) =>
  rows?.slice(0, 4).map((row) =>
    `${row.rank}. H${row.values.hp}/A${row.values.attack}/B${row.values.defense}/C${row.values.specialAttack}/D${row.values.specialDefense}/S${row.values.speed} — ${row.usageRate}%`,
  ).join('\n') || 'データなし';
---

<AppLayout title="バトルデータ" description="OP.GG使用率データ" current="box" hideTopbar={true}>
  <div class="page box-data-page">
    {pokemon ? (
      <MobileTrainingBar pokemon={pokemon} activeTab="battle-data" />
    ) : (
      <section class="pokemon-data-preview" aria-labelledby="data-preview-title">
        <p class="data-kicker">育成データレビュー</p>
        <h1 id="data-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「バトルデータ」から、選択中のポケモンの使用率を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {pokemon && (
      <main class="box-data-main">
        {seasons.length > 0 && (
          <div class="data-view-controls">
            <button
              class="data-season-unavailable"
              type="button"
              disabled
              title="シーズンを読み込み中"
            >
              シーズン
            </button>
          </div>
        )}

        <section class="data-panel">
          {hasData ? (
            <>
              <h2 id="trend-title">トレンド</h2>
              <div class="trend-detail-card">
                <div class="trend-detail-cell"><span>特性</span><strong>{ranked(single?.abilities)}</strong></div>
                <div class="trend-detail-cell"><span>性格</span><strong>{ranked(single?.natures)}</strong></div>
                <div class="trend-detail-cell"><span>アイテム</span><strong>{ranked(single?.items)}</strong></div>
                <div class="trend-detail-cell"><span>わざ</span><strong>{ranked(single?.moves)}</strong></div>
                <div class="trend-detail-cell"><span>努力値</span><strong>{evRanked(single?.evs)}</strong></div>
                <div class="trend-detail-cell"><span>同時採用ポケモン</span><strong>{ranked(single?.teammates, true)}</strong></div>
              </div>
            </>
          ) : (
            <section class="data-empty" aria-live="polite">
              <h2>バトルデータなし</h2>
              <p>このポケモンのシングルバトルデータはまだありません。</p>
            </section>
          )}
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script define:vars={{ seasons, season, selectedId }}>
  const unavailable = document.querySelector('.data-season-unavailable');
  if (unavailable && seasons.length) {
    const select = document.createElement('select');
    select.className = 'data-season-select';
    for (const entry of seasons) {
      select.add(new Option(entry.label ?? entry.id, entry.id, entry.id === season, entry.id === season));
    }
    select.addEventListener('change', () => {
      const params = new URLSearchParams();
      if (selectedId) params.set('pokemon', selectedId);
      params.set('season', select.value);
      window.location.search = params.toString();
    });
    unavailable.replaceWith(select);
  }
</script>
