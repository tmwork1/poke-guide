		// UI刷新(Pokemon.png): アイテム画像・タイプ画像・テラスタイプ画像。別担当が並行実装中の
		// モジュール(合意済みシグネチャ)。存在しない/取得失敗時は必ずフォールバックする
		// (applyTypeBadge/applyTeraImage/applyItemImage参照)。
		// ラウンド23ユーザー指示(23-G2)によりteraTypeIconUrlの使用箇所(applyTeraImage内の1箇所)を
		// typeIconUrlに切り替えたため、このファイルではteraTypeIconUrlをもうimportしない
		// (プロジェクト全体でこの関数の呼び出し元がゼロになった。src/lib/sprite-urls.tsの関数自体・
		// public/type-icons/tera/の19画像・tests/sprite-urls.test.tsの該当テストを削除するかは
		// 別ラウンドの判断とする。このページはsprite-urls.ts/tests/の編集許可を持たないため)。
		import { loadItemSpriteMap, itemImageUrl, typeIconUrl } from "../../lib/sprite-urls";
		// ラウンド21ユーザー指示(21-L8): タイプ色の定義はエージェントPがsrc/lib/type-colors.tsへ
		// 切り出し済み(値は不変)。このページのローカル定義は削除し、こちらからimportする。
		import { TYPE_COLORS, DEFAULT_TYPE_COLOR } from "../../lib/type-colors";
