							<span class="stat-table-header-ev-remaining">
								<span id="ev-remaining" class="ev-remaining tnum"></span>
							</span>
							<span class="stat-table-header-real">実数値</span>
						</div>
						{STAT_LABELS.map(({ key, label: statLabel, short: statShort }, i) => (
							<div class="stat-row">
								{/* ラウンド5ユーザー指示: ステータスラベルのクリックによる上昇/下降切り替えを
								    作り直す。以前は1個のボタンを「無補正→上昇→下降→無補正」と巡回させて
								    いたが、(a)押せる見た目が無い(b)ある能力を↑にすると別の能力の↓が
								    黙って消える(c)2回目のクリックで全補正が消える、という実質操作不能な
								    挙動だった(いじっぱり保存済みのメガリザードンXが検証中に「まじめ」に
								    書き換わった事故はこれが原因)。
								    → ▲(上昇)/▼(下降)を独立した当たり判定のボタンに分離する。
								    ▲は他の能力の▲だけを解除し(▼は一切変更しない)、▼も同様(<script>の
								    leftNatureUp/leftNatureDown、nature-up-{key}/nature-down-{key}の
								    クリックハンドラ参照)。押下中の状態は塗り色(--stat-up/--stat-down)+
								    aria-pressedで明示する。HPは性格補正の対象外なのでボタン自体を置かず、
								    位置だけ揃えるプレースホルダーを入れる。 */}
								{key === "hp" ? (
									<span class="stat-row-label" aria-label={statLabel} title={`${statLabel}(性格の影響を受けません)`}>
										<span class="stat-nature-btn stat-nature-placeholder" aria-hidden="true"></span>
										{statShort}
										<span class="stat-nature-btn stat-nature-placeholder" aria-hidden="true"></span>
									</span>
								) : (
									<span class="stat-row-label" aria-label={statLabel} title={statLabel}>
										<button
											type="button"
											id={`nature-up-${key}`}
											class="stat-nature-btn stat-nature-up"
											aria-pressed="false"
											aria-label={`${statLabel}を性格補正で上昇させる`}
											title={`${statLabel}を上昇に設定`}
										>▲</button>
