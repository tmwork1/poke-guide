		import { type StatKey, STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";
		// ラウンド23(22-B-1): TERA_TYPES(19タイプの選択肢一覧)がフロントマター/左パネルの
		// <script>ブロック/#opponent-notes-sectionブロックの3箇所に重複定義されていたのを
