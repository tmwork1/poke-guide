	<script>
		import {
			el,
			loadAutocomplete,
			readEv,
			readMoveNames,
		} from "../../lib/owned-pokemon-form";
		// ダメージ計算カード(UI刷新)の計算導線。pyodide-engine.ts はブラウザ専用モジュールのため
		// 必ずこの<script>(ブラウザ専用バンドル)内でのみimportする(SSR/フロントマターからは禁止)。
		import {
			initEngine,
			calcStats,
			calcLethalSequence,
			isEngineReady,
			registerOfflineCache,
			type EngineProgress,
			type PokemonSpec,
			type CalcDamagesOptions,
			type SequenceAttack,
			type LethalResult,
		} from "../../lib/pyodide-engine";
		import type { OpponentNoteRecord } from "../../lib/opponent-notes";
		import type {
			OpponentBuildInput,
			OpponentFieldInput,
			OpponentAttackInput,
			OpponentClientResultInput,
		} from "../../lib/opponent-notes-validation";
		// UI刷新: ポケモン名の横にスプライト画像・タイプ色・種族値を表示するためのブラウザ専用ヘルパー。
		import {
			loadImageIdMap,
			loadTypesMap,
			loadBaseStatsMap,
			loadMultiHitMoveMap,
			loadMoveTypeMap,
			loadLearnsetMap,
			loadAbilitiesMap,
			spriteUrl,
			officialArtworkUrl,
