---
// Phase C-3: 個体の編集フォーム (育成データ管理計画.md §6.2, §8 Phase C-3)。
// デバウンス付き即時自動保存 + 楽観的UI更新: 入力のたびに数百ms待ってから
// PUT /api/owned-pokemon/:id を呼ぶ。保存中も入力をブロックしない。失敗時のみエラー表示する。
//
// 初期表示データの取得は API 経由の fetch ではなく、Astro のフロントマター(SSR)で
// src/lib/owned-pokemon.ts の getOwnedPokemon() を直接呼び出す(box/index.astro の一覧取得のような
// クライアント側fetchより初期表示が速く、かつ「生のSupabaseクエリはowned-pokemon.tsに集約する」
// という設計原則にも合致する)。
//
// 未ログイン時、および他人の個体/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(Phase A-3の方針を踏襲)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { getOwnedPokemon, type OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { TERA_TYPES } from '../../lib/tera-types';

const user = Astro.locals.user;
const id = Astro.params.id;

let pokemon: OwnedPokemonRecord | null = null;
let loadError = false;

if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getOwnedPokemon(user.id, id, supabase);
	if (result.ok) {
		pokemon = result.data;
	} else {
		loadError = true;
	}
	if (!pokemon && !loadError) {
		Astro.response.status = 404;
	}
}

// UI刷新(第4弾): 性格の選択UI(<select>)は要件により廃止した。性格はステータス補正にしか
// 影響しないため、能力値ラベルのクリックで上昇/下降(HP以外)を選び、性格名は<script>側で
// 逆算するだけにする(保存データには従来どおり性格名を入れる)。そのため NATURES(性格名の
// 選択肢一覧)はもうフロントマターで使わない。対応表(NATURE_STAT_MODIFIERS)は<script>側に
// 定義しており、vendor/jpoke/src/jpoke/data/nature.py の NATURE_MODIFIER と一致させている。

// TERA_TYPES(19タイプの選択肢一覧)は src/lib/tera-types.ts へ切り出し済み(2026-07-28
// ラウンド23 22-B-1)。以前はここに直接定義していたが、左パネル用<script>と
// #opponent-notes-section用<script>にも同じ配列が複製されていた(3箇所重複)。値・順序は不変。

// UI刷新(ダメージ計算カード化): 天候/地形/相手側の壁/状態異常の選択肢は、行(対戦相手)ごとに
// JSで動的生成するカードの中で使うため、Astroフロントマター側では定義せず、ブラウザ専用<script>内に
// 同じ選択肢を直接持たせている(下記<script>のDAMAGE_WEATHERS等を参照。フロントマターの値は
// ブラウザ側の<script>から参照できないため。src/pages/damage-calc/index.astro のWEATHERS/TERRAINS/
// SIDE_FIELDSと同じ選択肢で同期させること)。

// ラウンド12指摘(A-3): 能力値ラベルは全角表記(「素早さ」等)だとラベル列(最大幅)が
// スライダー列(最狭・操作対象)を圧迫していたため、表示上はH/A/B/C/D/Sの1文字表記に
// 統一する(相手ビルド箱・/box一覧のSTAT_LABELS = ["H","A","B","C","D","S"]と表記を揃える。
// 統一感の要件でもある)。full(素早さ等の正式名称)はaria-label/titleに必ず残し、
// アクセシビリティ上「短縮表記だけになる」ことを避ける。
const STAT_LABELS: Array<{ key: string; label: string; short: string }> = [
	{ key: "hp", label: "HP", short: "H" },
	{ key: "atk", label: "攻撃", short: "A" },
	{ key: "def", label: "防御", short: "B" },
	{ key: "spa", label: "特攻", short: "C" },
	{ key: "spd", label: "特防", short: "D" },
	{ key: "spe", label: "素早さ", short: "S" },
];

const MOVE_SLOTS = [1, 2, 3, 4];

function statAt(values: number[] | undefined, index: number, fallback: number): number {
	return values && typeof values[index] === "number" ? values[index] : fallback;
}

// 共通トップバー移行(2026-07-26): このpageTitleはAppLayoutのtitleプロパティに渡され、
// (a) <title>タグ(ブラウザタブ)と (b) トップバー左のテキスト表示、両方に使われる。
// 以前は<title>タグ用に「◯◯を編集」、可視のh1見出しには接尾辞なしの「◯◯」という
// 別々の文字列を使っていたが、ページ読み込み直後に<script>のupdateHeaderIdentity()が
// .app-topbar-titleを接尾辞なしの文字列で上書きするため、両方を同じ値にしないと
// 表示直後に見出しが「◯◯を編集」→「◯◯」へ一瞬で変わって見えてしまう(実機で確認)。
// 接尾辞なしの名前で統一する(ブラウザタブは「◯◯ | Poke-Commons」になる)。
// UI品質改善(2026-07-26 第4弾 11-1): 以前はニックネーム優先(nickname || species_name)
// だったが、要件によりヘッダー表示からニックネームを外し種族名固定にする。ニックネーム
// 入力欄自体(左パネルの#nickname)は残す(保存対象としても変更なし)。updateHeaderIdentity側
// (<script>)も同じ理由でニックネームを見ないよう合わせて変更している(そうしないと
// ページ読み込み直後にJSがニックネーム入りの文字列で上書きしてしまうため)。
const pageTitle = pokemon ? pokemon.species_name : "個体編集";
// ラウンド23ユーザー指示(23-H1): 「種族名を削除」。<title>タグ(ブラウザタブ・履歴での
// 個体識別に必要)には残しつつ、トップバーの可視の見出しからだけ種族名を消す。AppLayoutの
// titleプロパティは<title>と.app-topbar-titleの両方を兼ねており、AppLayout自体は編集禁止
// (全ページに影響するため)。AppLayoutが既に持っているbodyClass propを使い、
// body要素にこのページだけのクラスを付け、その配下の.app-topbar-titleを
// このページのCSSだけで非表示にする(AppLayout.astroのマークアップ・propは一切変更しない)。
// pokemonがnull(個体が見つからない)のときはpageTitleが種族名ではなく固定文言「個体編集」
// (エラー状態の案内)なので、そちらは隠さない(bodyClassをpokemon存在時だけ付与する)。
const bodyClass = pokemon ? "box-edit-page" : undefined;
---
<AppLayout title={pageTitle} current="box" backHref="/box" bodyClass={bodyClass}>
	{/* 共通トップバー移行(2026-07-26): 独自の.page-header(戻る/保存状態/ポケモン名/削除ボタン)を
	    撤去し、AppLayoutのbackHref/title/topbar-status/topbar-actionsへ移した(box/index.astroの
	    先行移行と同じ方針)。保存状態(#autosave-status等)と削除ボタン(#delete-button)は
	    <script>のel()がid参照する(見つからないとel()がthrowし、フォーム全体のJSが
	    初期化できなくなる)ため、id/classは変えずスロットへそのまま移す。
	    ポケモン名の見出しはtitleプロパティ(pageTitle、上のフロントマターで算出済み。
	    pokemonがnullなら固定文言「個体編集」)に委譲したため、旧#header-title/#header-subtitle
	    のマークアップは廃止した。以後のニックネーム/種族名入力への追随(旧updateHeaderIdentity)は
	    idを持たないAppLayout側の.app-topbar-titleをquerySelectorで直接更新する(<script>参照)。
	    ラウンド23(23-H1): .app-topbar-title自体はAppLayout側の要素なのでこのページのscoped
	    <style>では選択できない(scoped styleはdata-astro-cid-*がこのファイル由来の要素にしか
	    効かない)。bodyClass="box-edit-page"を付け、下の<style is:global>側で
	    `body.box-edit-page .app-topbar-title`として非表示にする。 */}
	{pokemon && (
		<Fragment slot="topbar-status">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span><button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>
			{/* ラウンド17指摘(B-1): ダメージ計算カードは行ごとに独立して自動保存されるため、
			    画面外にスクロールしたカードの保存失敗はカード自身のfooter(保存失敗時のみ表示)を
			    見ないと気づけない。常時可視なスティッキー上部バー(AppLayoutのtopbar、
			    このスロットの中)に失敗件数だけを出す(<script>のupdateOpponentNotesFailureAlert
			    参照)。通常時はhiddenで何も見えない(A-2と同じく「通常時は非表示」を崩さない)。 */}
			<span id="opponent-notes-save-alert" class="opponent-notes-save-alert" hidden></span>
		</Fragment>
	)}
	{pokemon && (
		<Fragment slot="topbar-actions">
			{/* ラウンド21ユーザー指示(21-H1): 「個体削除はゴミ箱+赤背景の定番デザインにする」。
			    ラウンド3 B-9(既定はmuted、hover時だけdangerに転じ誤操作を抑止する設計)を撤回する。
			    アイコンはインラインSVGのゴミ箱(絵文字🗑はOS/フォントで見た目が変わるため
			    定番デザインに向かない、という判断で新規に書き起こした)。誤操作の抑止は
			    常時赤にする代わりに既存のwindow.confirm()(<script>のdeleteButtonクリック
			    ハンドラ、変更していない)に委ねる。 */}
			<button id="delete-button" class="btn-danger" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
				削除
			</button>
		</Fragment>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button { display: none; margin-left: 0.4em; }
		#retry-button.visible { display: inline-flex; }
		/* 共通トップバー移行(2026-07-26・実測バグ修正): #autosave-statusは<p>要素で、
		   global.cssに全要素共通のmarginリセットが無いため既定のUAスタイル(1em 0)が
		   そのまま残っていた。旧レイアウトでは.page-header自体の高さが可変で、周囲の
		   flex計算(.edit-shellのheight:100vh−実測ヘッダ高さ)に自動的に吸収されていたため
		   問題にならなかったが、AppLayoutのトップバーは高さがCSS変数--topbar-height
		   (固定値、デスクトップ65px)前提で.edit-shell/.damage-detail-panelの高さ計算に
		   使われるため、<p>の既定marginぶん(実測で往復約16px)だけトップバーの実高さが
		   --topbar-heightからずれ、ページ全体に余計な縦スクロールが出ていた(実測で発覚)。
		   marginを0にしてトップバーの実測高さを--topbar-heightに一致させる。 */
		#autosave-status { margin: 0; }
		/* UI品質改善(2026-07-26 第4弾 11-1): ヘッダーから「保存済み」等の保存状態テキスト表示を
		   削除する要件。#autosave-status/#autosave-status-textはid/DOMごと残す
		   (<script>のel("autosave-status")/el("autosave-status-text")が参照しており、
		   要素そのものを削除するとel()がthrowしてフォーム全体のJS初期化が止まるため)。
		   最小対応としてテキスト(span)だけをCSSで常時非表示にし、コンテナ(#autosave-status)
		   自体は残す。コンテナごと非表示にすると子要素の#retry-buttonも道連れで
		   描画されなくなり、保存失敗時の唯一のリカバリ手段(クリックでの再試行)に気づく
		   手段が完全に無くなってしまうため、#retry-button自身の表示/非表示は既存どおり
		   .visibleクラス(保存失敗時にJSが付与)に委ねる=失敗時だけ「再試行」ボタンが
		   単独で現れる形にした(通常時は何も見えない)。
		   ラウンド17指摘(A-2): 上記の「常時非表示」は保存失敗時も理由(「保存に失敗しました。」)を
		   一切見せていなかった。#retry-buttonが唐突に現れるだけで、なぜ現れたのかが画面から
		   分からない(このページは保存ボタンが無く自動保存に全面依存し、過去に個体データが
		   書き換わる事故も起きている場所のため、失敗理由を隠したままにする割に合わない)。
		   保存失敗時(data-state="error")だけテキストを見せ、通常時(saved/saving/idle)は
		   上記のとおり非表示のまま据え置く(ラウンド11の要件「ヘッダーから保存済み表示を削除」は
		   壊さない)。 */
		#autosave-status-text { display: none; }
		#autosave-status[data-state="error"] #autosave-status-text {
			display: inline;
			color: var(--color-danger);
		}
		/* 共通トップバー移行(2026-07-26・実測バグ修正): #delete-buttonはbutton基底ルール
		   (global.css)のfont:inheritにより、周囲(.app-topbar-actions)が独自のfont-sizeを
		   持たないぶん既定の1rem(16px)まで祖先から継承してしまい、右側のログアウトボタン
		   (AppLayout側の.app-topbar-accountがfont-size:var(--font-size-sm)を明示している)より
		   縦に大きくなっていた(実測45px、ログアウト側は39px)。この差がトップバーの実高さを
		   --topbar-heightよりさらに約6px押し上げていた。ログアウトボタンと同じ
		   var(--font-size-sm)を明示し、他のトップバー内ボタンと縦サイズを揃える
		   (paddingはem単位なのでfont-sizeに追随して自動的に縮む)。 */
		#delete-button { font-size: var(--font-size-sm); }
		/* ラウンド8指摘(A-5(2)): 幅390pxで折り返し先が無くwhite-space:normalのまま1文字ずつ
		   縦に折り返り(実測46×169px)、w900でも3行に折れていた。1行に固定する
		   (トップバー側の折り返し対策はglobal.css/AppLayout.astro担当の別エージェントの範囲)。 */
		#delete-button { white-space: nowrap; }
		/* ラウンド23実バグ修正: 上記の21-H1コントラスト是正ブロック(ページscoped)を撤去した。
		   ラウンド22の22-A-1でglobal.cssの.btn-danger自体を--color-danger-strongに直したため、
		   このページscopedブロックは基底(global.css)と完全に同じ値になり不要だった。
		   問題は「不要」だけでなく実害があった: このブロックの#delete-button{background:...}が
		   常にbackgroundを上書きし続けるため、hover時にglobal.cssの
		   .btn-danger:hover{background:var(--color-surface)}(白地反転)が詳細度で負けて
		   適用されなかった。一方この#delete-button:hoverブロックのcolorだけは
		   --color-danger-strongに変わるため、hover時に文字色=背景色(どちらも
		   --color-danger-strong)になり「この個体を削除」の文字が完全に見えなくなっていた
		   (実測: コントラスト比 1.00:1、ライト/ダーク両方で再現)。ブロックを削除すれば
		   global.cssの基底hoverルール(background:surface + color:danger-strong)がそのまま効き、
		   自動的に直る(削除後の実測: hover文字コントラスト5.96:1、AA適合)。 */

		/* ラウンド17指摘(B-1): ダメージ計算カード(#opponent-notes-section)は行(相手)ごとに
		   独立して自動保存されるため、カード自身のfooter(失敗時のみ表示)は画面外へ
		   スクロールすると見えなくなる。AppLayoutのトップバーはposition:stickyで常時可視なので
		   ここに失敗件数だけを出す(<script>のupdateOpponentNotesFailureAlert参照)。
		   .app-topbar-status(親のspan)がwhite-space:nowrapの1行構成のため、<p>ではなく
		   同じ<span>系で追加し、ブロック化してトップバーの実高さ(--topbar-height)を
		   広げないようにする(#autosave-statusの<p>まわりの実測バグ修正コメント参照)。 */
		.opponent-notes-save-alert {
			display: inline;
			margin-left: 0.6em;
			color: var(--color-danger);
			font-weight: 700;
		}
		.opponent-notes-save-alert[hidden] { display: none; }

		/* 共通トップバー移行(2026-07-26): 独自の.page-header/.edit-page-header-*(戻る/
		   保存状態/ポケモン名見出し/削除ボタン)はAppLayoutのbackHref/title/topbar-status/
		   topbar-actionsスロットへ移設したため、このページのスコープドCSSからは全廃した
		   (#retry-button/.status-textは真のグローバルスタイルなのでこのページに残す必要がなく、
		   global.css/このファイル下部の定義でそのまま効く。.save-row-deleteはラウンド21 21-H1で
		   撤去済み)。 */

		/* ダメージ計算カード化(UI刷新): 右カラム(#opponent-notes-section)の内容は
		   「対戦相手メモ」から「ダメージ計算」カードに全面刷新した。行・列・詳細設定ダイアログは
		   すべて<script>がdocument.createElement()で動的生成するため、この節にスタイルは置かず、
		   下の<style is:global>側に #opponent-notes-section 限定のセレクタとしてまとめて定義する
		   (scoped <style> は data-astro-cid-* が付かない動的生成要素には効かないため。要件参照)。 */

		/* UI刷新: 左右2カラムレイアウト(docs/plan/ui_plan.md)。
		   編集フォーム(左・固定幅)とダメージ計算カード(右・可変幅)を左右に並べる。
		   閾値はもともと900pxだったが1200pxに引き上げた: 左の編集フォームは能力値行
		   (種族値+スライダー+入力欄+実数値)の都合で最小幅が実測736px前後あり、
		   grid-template-columnsの minmax(320px, 480px) は「コンテンツの最小幅が上限を
		   超える場合はそちらが勝つ」ため、1024px幅では左トラックが736pxまで膨らんで
		   右カラムが226pxに潰れ、ダメージ計算カードがページごと横スクロールしていた
		   (実測で発覚)。2カラムにするだけの幅が無い環境では縦積みにする方が破綻しない。
		   モバイル/中間幅では通常のブロック要素として上から下へ縦積みになる
		   (グリッド自体を適用しないため、追加のメディアクエリなしで縦積みに戻る)。 */
		.edit-layout-left, .edit-layout-right { min-width: 0; }
		/* UI品質改善(帯構成への刷新): .page-wide の max-width 上書きは「浮いた囲み箱を中央寄せ
		   する」設計の名残で、帯(.panel系)が画面端まで伸びる設計とは相容れないため撤廃した。
		   左右カラムは.panel-left/.panel-right(画面端固定の帯)になった一方、中央カラムの
		   ダメージ計算カード(.card-damage)自体は「浮いた箱」のまま変えない。ただし.pageの
		   左右paddingが消えたことで、カードが左右の帯に直接貼り付いてしまうため、
		   .edit-layout-right自身に左右paddingを持たせてカードと帯の間に余白を作る
		   (.panel の左右padding(var(--space-5))と揃え、帯どうしの余白感を統一する)。 */
		.edit-layout-right {
			padding: var(--space-6) var(--space-5);
		}
		@media (min-width: 1200px) {
			.edit-layout {
				display: grid;
				grid-template-columns: minmax(320px, 480px) 1fr;
				gap: 1.4rem;
				/* UI品質改善(帯構成への刷新): align-items:startだと各カラムが自分のコンテンツ分の
				   高さしか持たず、左の帯(.panel-left)が画面下端の手前で途切れて背景色が
				   見えてしまっていた(実測で発覚)。stretchに変え、行の高さ(3カラムのうち
				   最も長いものに揃う)まで各カラムを引き伸ばす。実際に左パネルをその高さまで
				   伸ばす連鎖(height:100%)は下の別の@media (min-width: 1200px)ブロック
				   (.edit-layout-left以下)を参照。 */
				align-items: stretch;
			}
		}
		/* ラウンド5ユーザー指示(要件9): ⚙クリックで<dialog>を開く方式をやめ、カードを選択すると
		   右サイドバーに詳細設定を表示する方式にする。「カードの面積による制限を気にしなくて
		   よくなるので、レイアウトの自由度が生まれる」というのがユーザーの弁。
		   1920px幅を基準に3カラム(左=編集フォーム/中央=ダメージ計算カード/右=詳細設定)を
		   組めるだけの余地がある閾値として1600pxを採用した(実測: 編集フォーム最小幅約480px+
		   ダメージ計算カード1枚実測約620px+サイドバー320px+gap×2+サイドナビ256px+
		   ページ余白 ≒ 1600px弱)。1600px未満(2カラム/縦積みいずれの場合も)ではサイドバーを
		   画面右端からのオーバーレイ(スライドイン)にする。
		   ラウンド6ユーザー指示(要件1・2): ⚙ボタン自体を廃止した。カード内の入力欄クリックで
		   意図せず選択が走らないルールは維持しつつ、選択トリガーを「相手ビルドの箱のクリック→
		   カード全体の設定」「技列の箱のクリック→その技だけの設定」の2種類に分けていたが、
		   ラウンド7ユーザー指示(方針転換)で「カード全体の設定」という概念自体を廃止した。
		   相手ビルドの箱のクリックは無反応(サイドバーを開閉しない)になり、選択トリガーは
		   「技列の箱のクリック(フォーム要素の外側)→その技だけの設定」の1種類だけになった
		   (<script>のselectColumn/renderRow末尾のroot.addEventListener参照)。 */
		.edit-layout-detail { display: contents; }
		/* UI品質改善(帯構成への刷新): 右端に接する罫線(border-left)は.panel-right修飾子
		   (global.css)と役割が完全に一致するため、マークアップ側に panel-right クラスを
		   追加してそちらに委ねる(下のmarkup、#damage-detail-panel参照)。position:fixed/
		   width/transformによるスライドイン・box-shadowは.panel基底が持たない固有の
		   振る舞いのため、無理に.panel基底へ寄せずこのスコープドスタイルに残す。 */
		.damage-detail-panel {
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			width: min(400px, 92vw);
			z-index: 60;
			display: flex;
			flex-direction: column;
			background: var(--color-surface);
			box-shadow: var(--shadow-lg);
			transform: translateX(100%);
			transition: transform 0.2s ease;
		}
		.damage-detail-panel.is-open { transform: translateX(0); }
		.damage-detail-backdrop {
			position: fixed;
			inset: 0;
			z-index: 55;
			background: rgba(0, 0, 0, 0.35);
		}
		.damage-detail-backdrop[hidden] { display: none; }
		.damage-detail-panel-header {
			display: flex;
			align-items: center;
			/* ラウンド23ユーザー指示(23-R1): 「詳細設定」の見出し(.damage-detail-panel-title)を
			   削除したため、閉じるボタン1つだけが残る。space-betweenのままだと単独の子要素は
			   flex-start(左)に寄ってしまい、閉じるボタンとして不自然な位置になるため
			   flex-endに変え右寄せにする。 */
			justify-content: flex-end;
			gap: 0.5rem;
			/* ラウンド12指摘(A-5): 3カラム1行目の縦位置が左y=97/中央y=89/右y=79とバラバラ
			   だった。右側(このパネル見出し)はpadding-topが0.9remで最も浅く、中央カラム
			   (ダメージ計算カード、y=89)に合わせて1.5remへ広げる。1600px未満のオーバーレイ表示
			   (このパネルがposition:fixedになる@media側)でも同じ値がそのまま効く
			   (別のpadding上書きが無いことを確認済み)。 */
			padding: 1.5rem 1rem 0.7rem;
			border-bottom: 1px solid var(--color-border);
			flex-shrink: 0;
		}
		.damage-detail-panel-close { font-size: 1.1rem; padding: 0.2em 0.55em; }
		/* UI改善ラウンド29(29-R1)「右パネルの余剰空白」: 密な状態(カード4枚)でも中身が
		   .damage-detail-sides下端で終わり、パネル下端まで331pxが完全な空白になっていた。
		   逆に空状態は950px近い空白になる。#damage-detail-panel-body自体をflex column化し、
		   中身(JS生成の.damage-detail-panel-body-inner、is:global側で定義)にmargin-block:auto
		   を持たせることで、中身がこの箱より短い間は上下中央に寄り、長くなればautoが0に収束して
		   従来どおり上端起点のoverflow-y:autoスクロールに戻る(⚠️
		   justify-content:centerをこちら側に付ける方法は不採用: 中身がこの箱より長くなったとき
		   上端がoverflowで見切れる既知の不具合があるため、round-29.mdが明示的に避けるよう指示している)。
		   #damage-detail-panel-body自体は静的マークアップ(下記<div id="damage-detail-panel-body">)
		   なのでscoped<style>がそのまま効くが、中のinnerラッパーはJSのdocument.createElement()で
		   生成するため、そちらのスタイルはis:global側に置く(pitfalls.mdの既知の罠)。 */
		.damage-detail-panel-body {
			flex: 1 1 auto;
			display: flex;
			flex-direction: column;
			overflow-y: auto;
			padding: 0.9rem 1rem 1.4rem;
		}
		/* UI改善ラウンド29(29-R1)により.damage-detail-panel-emptyはis:global側
		   (#damage-detail-panel-body .damage-detail-panel-empty)へ移した。理由: このpは
		   静的マークアップ(JS初期化前のフォールバック)とJS生成(renderDetailPanelEmpty)の
		   両方から使われるが、後者はscoped<style>が効かない(pitfalls.md)。同じ1つの定義で
		   両方に効かせるため、静的/動的どちらの経路でも確実に効くis:global側に統一する。 */
		@media (min-width: 1600px) {
			.edit-layout {
				grid-template-columns: minmax(320px, 440px) minmax(520px, 1fr) minmax(300px, 360px);
			}
			.edit-layout-detail { display: block; min-width: 0; height: 100%; }
			/* UI品質改善(帯構成への刷新): このブロックは元々「浮いた角丸カード」を作っていた
			   (top:1remで上下に隙間を空け、border-radius+全周borderで枠を作る)。設計図
			   (docs/ui_proposal/個体編集_全体レイアウト.png)では右の詳細設定は画面右端に
			   密着し、上下いっぱいに伸びる帯なので、top/bottomの隙間・角丸・全周borderを外す。
			   border-leftは.panel-right修飾子(global.css。マークアップ側は既に
			   class="damage-detail-panel panel-right"を持つ)と役割が完全に一致するため、
			   宣言ごと削除して委譲する(このブロックにはborder-leftとborder全周が重複宣言
			   されており、後者が前者を無効化していた既知の死んだ宣言だった。整理を兼ねて
			   両方外す)。
			   top:1rem/max-height: calc(100vh - 2rem) はtop:0にして画面上端に密着させる…はずだったが、
			   共通トップバー新設(2026-07-26)により画面上端はサイドバー右隣から伸びる
			   position:sticky; top:0 のトップバー(--topbar-height、デスクトップ65px)が
			   占めるようになった。位置基準の document scroll はトップバーと共有しているため、
			   このパネルのtopを0のままにするとトップバーの裏に隠れて上端が食い込む
			   (実機で発覚)。トップバーの直下に張り付くよう top: var(--topbar-height) にする。
			   高さは height:100% (行の実高さ、.edit-layout-leftと同じ連鎖) を基本にしつつ、
			   max-height:calc(100vh - var(--topbar-height)) で上限を「ビューポートからトップバー
			   ぶんを引いた残り1画面」に固定する。これにより:
			   (a) 通常時(行がちょうど1画面に収まる)はheight:100%がそのまま効き、左の帯と
			   ぴったり同じ高さで画面いっぱいに伸びる(height:100vh一本だと、行の高さが
			   「ページ見出しの実高さ+100vh」まで押し上げられ、ページ全体に見出し分の
			   余計な縦スクロールが生まれてしまうことを実測で確認したため採用しなかった)。
			   (b) ダメージ計算カード側(中央カラム)が増えて行がビューポートより長くなった
			   場合はmax-heightが効いて「トップバーを除いた1画面ぶん」で頭打ちになり、
			   position:stickyでの追随+内部スクロール(.damage-detail-panel-bodyの
			   overflow-y:auto)が従来どおり働く。 */
			.damage-detail-panel {
				position: sticky;
				top: var(--topbar-height);
				right: auto;
				bottom: auto;
				width: 100%;
				height: 100%;
				max-height: calc(100vh - var(--topbar-height));
				box-shadow: none;
				transform: none;
			}
			/* 1600px以上では常時表示のパネルなので閉じるボタン・背景オーバーレイは不要。 */
			.damage-detail-panel-close { display: none; }
			.damage-detail-backdrop { display: none !important; }
			/* 🔴 UI改善ラウンド28ユーザー指示(28-R1)「天候の上の空白領域を削除」:
			   .damage-detail-panel-headerは閉じるボタン(#damage-detail-panel-close)だけを
			   持つ帯だが、この幅(常時表示パネル)ではそのボタン自体が上のルールで
			   display:noneになり実質空の36px帯として残っていた。ヘッダーごと消す
			   (中の#damage-detail-panel-closeのDOM・IDは削除しない。1600px未満の
			   オーバーレイ表示では、このmediaブロックの外なので従来どおりヘッダーごと
			   表示され閉じるボタンが機能する)。 */
			.damage-detail-panel-header { display: none; }
		}

		/* UI刷新: 実数値の常時表示。性格補正は文字色で表現する
		   (旧battle-assistant-svの表現を踏襲。上昇=赤系、下降=青系、補正なしは既定色のまま)。
		   ラウンド3 A-7: #1d6fd1のハードコード(このページに3箇所)はダークで下降色3.30:1と
		   WCAG AA未達だった一方、--color-danger直参照の上昇色もライトで2.81:1が未達という
		   「両モードで片方ずつ落ちる鏡像」だったため、ページscopedの--stat-up/--stat-downに
		   切り出し、モードごとに独立した値を持たせる(/box/index.astroのA-4と同値に統一)。
		   is:global側(#opponent-notes-sectionの.damage-stat-value)からもこのカスタム
		   プロパティを参照するが、Astroのスコープ属性はセレクタにのみ影響し、カスタム
		   プロパティの値はDOM継承で下層のグローバル要素にも届くため問題なく効く。
		   UI品質改善(帯構成への刷新): 変数保持用のセレクタだった.page-wideは、帯構成では
		   max-width上書きの意味を失って撤廃したため、変数だけを残すこの用途には
		   .edit-shell という専用クラスに切り出す(マークアップ側のdiv.pageにも
		   class="edit-shell"を追加済み。グローバル側の.page.page-wideは他ページ
		   (box/index.astro等)がまだ参照しているため空ルールのまま残る)。 */
		.edit-shell {
			--stat-up: #c9432c;
			--stat-down: #1d6fd1;
		}
		@media (prefers-color-scheme: dark) {
			.edit-shell {
				--stat-up: var(--color-danger);
				--stat-down: #6fb6f7;
			}
		}
		/* ラウンド21ユーザー指示(21-G1)の残作業: ここにあった --select-arrow(light/dark)は
		   src/styles/global.cssの:root/ダークメディアクエリへ昇格済み(エージェントP実装)。
		   下の #edit-form select / #opponent-notes-section select(is:global側)の重複定義も
		   同じくglobal.cssの共通selectルールに統合済みのため削除した。global.cssはAstroの
		   スコープ機構を経由しない素のスタイルシートなので、#edit-form内の静的<select>にも
		   #opponent-notes-section内でJSが動的生成する<select>にも同じ1つの定義で届く。
		   3ページ(/box, /pokemon/[name], /box/[id])のselectが同じ見た目のままであることを
		   実測して確認済み(このラウンドの報告参照)。 */
		/* ラウンド3 B-11の積み残し: 未入力欄が「壊れたフォーム」に見えるという指摘への対応。
		   placeholderが表示されている(=空欄)間は破線+透明背景にして「空きスロット」を
		   能動的に表現する(入力中/フォーカス中は通常の実線に戻す。:not(:focus)で除外)。
		   input:placeholder-shownはtextarea/inputにのみ有効(select非対応)。
		   ⚠️ ラウンド24ユーザー指示(24-L3)によりこの判断の一部を撤回する: 「『テラスなし』の
		   既定オプション自体が空欄相当の意味を持つため対象外でよい」としていたが、ユーザーから
		   「テラスなし選択中も他の値と同じ文字色・同じ見た目で表示され、目立たない扱いになっていない」
		   と明示的に指摘された。ラウンド25(25-L2)で#tera(<select>)自体は非表示になったため、
		   同じ視覚言語(破線+透明背景+muted文字色)は新設の.tera-dropdown-button.is-tera-unselected
		   (下の#edit-form .tera-dropdown-button定義参照)へ引き継いだ。 */
		#edit-form input:placeholder-shown:not(:focus) {
			border-style: dashed;
			background: transparent;
		}
		.stat-value { display: inline-block; margin-top: 0.15em; font-size: 1.15em; font-weight: 700; color: var(--color-text); }
		.stat-value[data-mod="up"] { color: var(--stat-up); }
		.stat-value[data-mod="down"] { color: var(--stat-down); }

		/* UI刷新: 能力値を「種族値・努力スライドバー・実数値」の1行に統合(Pokemon.png参照)。
		   ラウンド3 B-10: ヘッダ行の「努力値(0〜32)」がスライダーの上にしかかかっておらず、
		   数値入力の上には何も無いように見えていた。原因はスライダー+数値入力が
		   .stat-input-controls という1つのflexコンテナ(=1グリッドセル)にまとまっていたこと。
		   スライダー/数値入力を独立した5列目・4列目に分け、ヘッダ側の「努力値」だけ
		   grid-column:span 2 でその2列を跨がせることで、実際に数値入力の真上にも
		   見出しの範囲が届くようにする。 */
		.stat-table { display: flex; flex-direction: column; gap: 0.2rem; }
		/* UI品質改善(ラウンド8 A-4): このヘッダはfont-size:0.78remの上でem指定の
		   grid-template-columnsを使っていたが、.stat-row側はfont-size指定なし(=1rem)で
		   同じem指定だったため、emの基準が食い違い実寸が別物になっていた(1列目で23.8pxずれ)。
		   両方をremに統一する(行側の実寸は変わらない、ヘッダ側だけが正しい位置に揃う)。
		   ラウンド12指摘(A-3): 操作対象のスライダー(3列目)が実測89.6px(1段階2.8px)しかない
		   一方、ラベル列(1列目)が108.8pxで最大になっていた。ラベルをH/A/B/C/D/S表記に
		   統一したことで1列目の必要幅が縮むため、6.8rem→4.2rem・2列目3.2rem→2.6rem・
		   4列目3.4rem→3.2rem・5列目3.6rem→3.4remに詰め、浮いた分をすべて3列目
		   (スライダー)へ回す(89.6px→約147px)。
		   ラウンド8 A-4の事故(このヘッダだけfont-sizeが違いem解釈がずれた)を再発させない
		   ため、.stat-table-headerと.stat-rowのgrid-template-columnsは必ず同じ値にすること
		   (どちらか一方だけ変更しないこと)。 */
		.stat-table-header {
			display: grid;
			grid-template-columns: 5rem 2.6rem minmax(0, 1fr) 3.2rem 3.4rem;
			gap: 0.6rem;
			font-size: 0.78rem;
			font-weight: 600;
			color: var(--color-text-muted);
			padding: 0 0.1rem 0.35rem;
			margin-bottom: 0.15rem;
			border-bottom: 1px solid var(--color-border);
		}
		/* ラウンド8指摘(A-4): 残りポイント(#ev-remaining)を「実数値」側から移し、
		   左「努力値(0〜32)」・右「残りN」に分ける(残ポイントが努力値入力欄の真上に来て
		   意味も合う。<script>のupdateEvRemaining参照)。 */
		/* ラウンド23ユーザー指示(23-L5)「ステータス関連のラベルと数値をすべて中央揃え」に対し、
		   ここだけは意図的に対象外にした。「努力値」(列見出し)と「残りN」(努力値合計の
		   ライブ残量表示、<script>のupdateEvRemaining参照)は役割が異なる2つのテキストで、
		   space-betweenは「左=見出し/右=残量インジケータ」という意味を担っている。中央揃えに
		   すると2つのテキストが隣接して団子になり、「見出しなのか値なのか」が読み取りにくくなる
		   ことを実物で確認した(判断根拠は報告参照)。他の見出し・行(種族値/努力値数値/実数値)は
		   すべて中央揃えに統一した。
		   ⚠️ ラウンド24ユーザー指示(24-L4)「"努力値"の文字はスライドバーの中央に配置」により、
		   上記23-L5の判断のうち「1つのflexコンテナ(span 2)のままにする」という実装方法だけを
		   撤回する(「努力値」と「残りN」を意味的に区別する判断自体は撤回しない)。理由: この
		   1コンテナ+space-between構成では「努力値」が必ずスライダー列(3列目)の左端に寄り、
		   中央に来ない。マークアップを.stat-table-header-ev-label(3列目単独)/
		   .stat-table-header-ev-remaining(4列目単独)の2つのgridアイテムに分離し、
		   「努力値」は他の見出しと同じ中央揃えルールに合流させ、「残りN」だけ右寄せを維持することで
		   見た目上の位置(残りNの右端=努力値数値列の右端)は変えずに「努力値」だけ中央へ動かす。 */
		.stat-table-header-ev-remaining {
			text-align: right;
		}
		/* ラウンド24ユーザー指示(24-L4)対応: 「残りN」(.stat-table-header-ev-remaining)だけを
		   中央揃え化の対象から除外する。「努力値」(.stat-table-header-ev-label)は他の見出しと
		   同じ挙動でよいため、あえて:not()の対象に加えない(=下のルールで自動的に中央揃えになる)。 */
		.stat-table-header > span:not(.stat-table-header-ev-remaining) { text-align: center; }
		/* ラウンド8指摘(A-4): 残りポイントを.stat-table-header-ev側へ移したため、この見出しは
		   「実数値」の1行だけになった(以前のflex-direction:columnの2行構成を廃止、
		   ヘッダ高さが2行→1行になる)。 */
		.ev-remaining {
			/* ラウンド20ユーザー指示(20-G3)文字の下限12px対応: 0.72rem(11.5px)→
			   --font-size-xs(0.75rem=12px)に上げる。 */
			font-size: var(--font-size-xs);
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.ev-remaining[data-state="zero"] { color: var(--color-success); }
		.ev-remaining[data-state="over"] { color: var(--color-danger); }
		.ev-remaining:empty { display: none; }
		.stat-row {
			display: grid;
			/* ラウンド12指摘(A-3): .stat-table-header と必ず同じ値にすること(上のヘッダ側の
			   コメント参照。ラウンド8 A-4のem解釈ずれ事故の再発防止)。 */
			grid-template-columns: 5rem 2.6rem minmax(0, 1fr) 3.2rem 3.4rem;
			align-items: center;
			gap: 0.6rem;
		}
		/* display:contents でこのラッパー自身をレイアウトツリーから消し、中のスライダー/数値入力を
		   .stat-row の直接の子(=グリッドアイテム)にする。こうしないと両方が3列目(1fr)に
		   まとまってしまい、5列グリッドに分割した意味が無くなる。 */
		.stat-row .stat-input-controls { display: contents; }
		/* 努力値の数値入力も左パネル用の詰めた寸法に揃える(6行あるので効き方が大きい)。 */
		/* ラウンド23ユーザー指示(23-L5): 努力値の数値入力も中央揃えにする。 */
		.stat-row input[type="number"] { font-size: 0.94rem; padding: 0.3em 0.5em; width: 100%; text-align: center; }
		.stat-row input[type="range"] { width: 100%; }
		/* ラウンド23ユーザー指示(23-L5): ラベル列も中央揃えにする(justify-content:center追加)。
		   このspanは▲ボタン+短縮ラベル+▼ボタンの3要素をflexで横並びにしており、列幅5remに
		   対して内容幅が余るぶん左に寄っていた。 */
		.stat-row-label { font-weight: 700; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 0.3em; }
		/* ラウンド21ユーザー指示(21-L7)「A,B,...のラベル色も赤・青に変わるようにする」。
		   相手ビルドカード側(20-D3)の--stat-up/--stat-down(このページの.edit-shellで定義、
		   DOM継承でis:global側からも参照できる。ライト4.86-4.94:1・ダーク7.2-7.6:1)を
		   そのまま再利用して揃える(新色は作らない)。色だけで意味を伝えない(WCAG 1.4.1)ため、
		   ▲▼ボタン自体の形状が方向を示す既存の手掛かりと併用する。 */
		.stat-row-label-short[data-mod="up"] { color: var(--stat-up); }
		.stat-row-label-short[data-mod="down"] { color: var(--stat-down); }
		/* ラウンド5ユーザー指示: ステータスラベルのクリックによる上昇/下降切り替えを作り直す。
		   以前は1個のボタンで「無補正→上昇→下降→無補正」を巡回させていたが、
		   (a)押せる見た目が無い(b)ある能力を↑にすると別の能力の↓が黙って消える
		   (c)2回目のクリックで全補正が消える、という実質操作不能な挙動だった。
		   ▲(上昇)/▼(下降)を完全に独立したボタンにする: ▲クリックは他の能力の▲だけを
		   解除し(▼には一切触れない)、▼クリックも同様。これにより「上昇を選んだら
		   下降が消えた」「もう一回押したら両方消えた」という事故が起きなくなる。
		   常時見えるアウトライン(点線)で押せることを示し、選択中は色を塗って
		   aria-pressed="true"にする(現在の選択状態が一目・スクリーンリーダー双方で分かる)。 */
		/* UI品質改善(ラウンド8 A-7): width/height/font-sizeが全てemだったため、
		   font-size自身(0.68em=10.88px)を基準にwidth/heightが決まる入れ子になり、
		   実寸14.1×13.1pxしか出ていなかった(WCAG 2.5.8の24×24を大きく割る)。
		   px指定にしてemの入れ子事故を断つ。行高は入力欄29pxがbindingなので
		   高さコストは0。背景を明示し、行hover時にも枠線でprimaryを示す
		   (状態表示=▲/▼独立・aria-pressed・押下時の塗りは一切変えない)。 */
		/* ラウンド20ユーザー指示(20-L4)「ステータス補正の上下ボタンは三角形をボタン本体として
		   小型化する」により、四角ボタン(22×20px、背景+枠線付き)を撤去し、CSSの
		   border-styleトリックで作る三角形そのものをボタン本体にした。
		   ⚠️ ラウンド21ユーザー指示(21-L7)で20-L4を是正する: 三角形の実寸10×6px・クリック
		   領域14×12pxは小さすぎて押しづらく、色の判別も困難だった。クリック領域を
		   一般的なタッチターゲットの下限である24×24pxまで戻し、三角形の実寸も14×9pxに
		   拡大する(20-G3の12px下限はこのボタンには適用しない。文字を表示しないため=図形)。
		   文字("▲"/"▼")はマークアップ・aria-label/titleとも変更していない
		   (アクセシブルネームはaria-labelが優先されるため実害なし)が、視覚的にはfont-size:0で
		   隠す。#nature-up-{key}/#nature-down-{key}のID・aria-pressed/aria-label/titleは
		   <script>側が参照しているため一切変更しない。 */
		.stat-nature-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 24px;
			height: 24px;
			padding: 0;
			font-size: 0;
			line-height: 0;
			background: transparent;
			border: none;
			cursor: pointer;
			flex-shrink: 0;
		}
		.stat-nature-btn::before {
			content: "";
			display: block;
			width: 0;
			height: 0;
			border-left: 7px solid transparent;
			border-right: 7px solid transparent;
		}
		.stat-nature-up::before { border-bottom: 9px solid var(--color-text-muted); }
		.stat-nature-down::before { border-top: 9px solid var(--color-text-muted); }
		.stat-nature-btn:hover::before { border-bottom-color: var(--color-primary); border-top-color: var(--color-primary); }
		.stat-row:hover .stat-nature-btn::before { border-bottom-color: var(--color-primary); border-top-color: var(--color-primary); }
		.stat-nature-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
		/* 塗り色(--stat-up/--stat-down、新色は作らない)で押下状態を示す。aria-pressedも
		   セットで書き戻しており(<script>のrefreshNatureButtons参照)、色だけに頼らず
		   スクリーンリーダーにも状態が伝わる(WCAG 1.4.1、pitfalls.md参照)。
		   🔴 UI改善ラウンド31ユーザー指示(31-L8)「性格補正の三角形のハイライトが見づらいので、
		   塗りつぶしだけでなく、縁取りしてさらに強調表示する」により、選択中(aria-pressed=true)
		   の三角形にだけ縁取りを追加する。三角形はborderトリックで作った図形(矩形ではない)なので
		   通常のoutline/borderでは縁取りできない。drop-shadowを上下左右1pxずつ4方向に重ねて
		   図形の輪郭に沿った縁取りを作る(既知の技法)。色は新色を作らず既存トークン
		   --color-text(ライト/ダーク両方で背景・塗り色との対比が付く中立色)を使う。 */
		.stat-nature-up[aria-pressed="true"]::before {
			border-bottom-color: var(--stat-up);
			filter:
				drop-shadow(1px 0 0 var(--color-text))
				drop-shadow(-1px 0 0 var(--color-text))
				drop-shadow(0 1px 0 var(--color-text))
				drop-shadow(0 -1px 0 var(--color-text));
		}
		.stat-nature-down[aria-pressed="true"]::before {
			border-top-color: var(--stat-down);
			filter:
				drop-shadow(1px 0 0 var(--color-text))
				drop-shadow(-1px 0 0 var(--color-text))
				drop-shadow(0 1px 0 var(--color-text))
				drop-shadow(0 -1px 0 var(--color-text));
		}
		/* HPは性格補正の対象外(クリック不可)。位置を揃えるためのプレースホルダーで、
		   ::beforeを持たない(=何も描画されない)ため「押せない」ことを見た目でも伝える。 */
		.stat-nature-placeholder { cursor: default; }
		/* ラウンド23ユーザー指示(23-L5)「ステータス関連のラベルと数値をすべて中央揃え」。
		   種族値・実数値とも中央揃えにする(実数値は以前 text-align: right だった)。
		   ⚠️ どちらも.tnum(tabular-nums)を維持しており、桁が変わっても列内でガタつかない
		   (中央揃えは桁ズレが目立ちやすいため、tabular-numsの維持が特に重要)。 */
		.stat-row-base { color: var(--color-text-muted); text-align: center; }
		.stat-row-real { text-align: center; font-size: 1.05em; }
		/* ラウンド17指摘(B-5): ヌケニン限定の注記。既定は非表示(hidden属性)、通常種族では
		   何も増えない(<script>のapplyBaseStats参照)。 */
		.hp-fixed-note {
			margin: 0.3rem 0 0;
			/* ラウンド20ユーザー指示(20-G3)文字の下限12px対応: 0.72rem(11.5px)→
			   --font-size-xs(0.75rem=12px)に上げる。 */
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
		}
		@media (max-width: 460px) {
			.stat-table-header { display: none; }
			/* ラウンド12指摘(A-3)追随: 1列目はもともと「とくこう」等の全角ラベル+▲▼ボタンの
			   幅として5.4emを確保していたが、ラベルがH/A/B/C/D/Sの1文字になったぶん
			   3.6emまで詰めても収まっていた(▲▼ボタン18px×2+1文字+gapの実測から算出)。
			   ⚠️ ラウンド21ユーザー指示(21-L7)で▲▼ボタンを24×24pxへ拡大したため、
			   3.6em(57.6px)では収まらなくなる(24px×2+gap+1文字 ≒ 68px)。4.6emに広げ、
			   浮いた分はスライダー(3列目、1fr)から差し引く。 */
			.stat-row { grid-template-columns: 4.6em 2.2em 1fr; row-gap: 0.2rem; }
			/* 460px以下では努力値のスライダー+数値入力を再びひとまとめの1セルに戻す
			   (デスクトップの5列グリッドは幅が無いと成立しないため)。 */
			.stat-row .stat-input-controls { display: flex; }
			.stat-row .stat-input-controls input[type="range"] { flex: 1 1 auto; width: auto; min-width: 0; }
			.stat-row .stat-input-controls input[type="number"] { flex: 0 0 3.4em; width: 3.4em; }
			/* ラウンド23ユーザー指示(23-L5)の中央揃え化は、この460px以下の1行レイアウト
			   (実数値がラベル列の下にpadding-leftで字下げして続く行内表示、デスクトップの
			   5列グリッドとは別構造)には適用しない。ここで中央揃えにすると値がラベルの
			   真下から離れて意味的なつながりが読み取りにくくなるため、意図的に除外した
			   (判断根拠は報告参照)。 */
			.stat-row-real { grid-column: 1 / -1; text-align: left; padding-left: 4.6em; font-weight: 700; }
			.stat-row-label { gap: 0.2em; }
		}

		/* ラウンド3 B-7: 「努力値合計」は要件により削除した。チャンピオンズルールは合計上限が
		   無く、この数値は何の判断にも使えない(「510の残り」を連想させる誤った示唆になる)ため、
		   表示自体を撤去した(.ev-total-line/#ev-totalのマークアップとJSも削除)。 */

		/* UI刷新: 種族アイコン(公式絵)ボックス(Pokemon.png参照)。右上に「タイプ画像」バッジを重ねる。
		   ラウンド4ユーザー指示「ポケモンのアイコンが小さい」: 88px/72pxから拡大する。
		   ラウンド12指摘(A-2): .top-block-fieldsの幅をflex-basis指定から比率指定に変えた
		   ことで浮いた約64px(下記.top-block-fields参照)をここへ回し、128px→160pxに拡大する
		   (縦の高さコストは無い=行の高さは元々.top-block-fields側の3行入力で決まっていたため)。
		   スプライト側は元の余白比率(128px箱に112pxスプライト=片側8px)を保ったまま
		   160px箱に144pxスプライトへ揃える。 */
		.species-icon-box {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 160px;
			height: 160px;
			border-radius: var(--radius-md);
			/* UI改善ラウンド31ユーザー指示(31-L1)「ポケモン画像の背景色を除去」により、
			   角丸の薄い箱の背景(--color-surface-alt)を撤去する。画像自体は144×144のまま。 */
			background: transparent;
			flex-shrink: 0;
		}
		.species-sprite-img { width: 144px; height: 144px; object-fit: contain; }
		.species-sprite-fallback-lg { width: 144px; height: 144px; font-size: 3.2rem; }

		/* UI刷新: Pokemon.png レイアウト。上部ブロック(種族/ニックネーム/特性 + アイコン)。
		   ラウンド4ユーザー指示により性格は表示しなくなった(能力値ラベルのクリックへ移行)。
		   UI改善ラウンド26ユーザー指示(26-L2)「アイコン領域を全幅に拡大。入力欄は下に移動」に
		   より、.top-block-icon(アイコン領域)と.top-block-fields(入力欄一式)の横並び2カラムを
		   撤回し、アイコン領域を上段・入力欄を下段に積む縦2段構成にする(ラウンド12指摘(A-2)で
		   確立した「折半比率」の考え方はこの変更で不要になった)。 */
		/* 🔴 UI改善ラウンド31ユーザー指示(31-L6)「種族〜テラスタルの入力ボックスのY間隔を詰める」
		   により、0.3rem(4.8px)→0.75rem(12px、下のgap値と揃える)へ変更する。この margin-bottom は
		   .top-block(種族/ニックネーム/特性/性格)と直後の.field-grid.field-grid-single(持ち物/
		   テラスタル)の間の縦間隔そのものになる(31-L4の対応で.top-block-fields内の各.fieldの
		   margin-topを0にしたため、この行間はここの一箇所だけで決まる)。 */
		.top-block { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; }
		/* ラウンド26ユーザー指示(26-L2)により全幅の下段になったため、空いた横幅を活かして
		   種族/ニックネーム/特性/性格を2列×2行のグリッドに詰める(以前は.top-block-icon
		   固定幅と折半する片側カラムの縦1列だった)。狭幅(520px以下)は既存の.field-gridと
		   同じ閾値で1列に戻す(下の@media (max-width: 520px)参照)。
		   🔴 UI改善ラウンド31ユーザー指示(31-L6)「種族〜テラスタルの入力ボックスのY間隔を詰める」
		   により、row-gapを0.3rem(4.8px)→0.75rem(12px)に変更する。列内の2行(種族/ニックネーム行→
		   特性/性格行)の間隔はこのgapだけで決まる(下の.field:first-child撤回参照。修正前は
		   これに各.fieldの margin-top(--space-2)が積み重なって20.8pxになっていた)。 */
		.top-block-fields {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem 0.6rem;
			width: 100%;
		}

		/* 🔴 UI改善ラウンド31ユーザー指示(31-L4)「種族名とニックネームの入力欄のY位置をそろえる」
		   により、旧来の`.field:first-child { margin-top: 0; }`(種族欄=1列目1行目だけを対象にした
		   個別打ち消し)を撤回する。この方式では2列目1行目(ニックネーム)には効かず、
		   ニックネーム欄だけがglobal.cssの基底.fieldマージン(margin: var(--space-2) 0)ぶん
		   下にずれていた(実測4.0pxのズレの原因)。.top-block-fields内の全.fieldのmargin自体を
		   0にし、縦の間隔は上のgrid gapだけで作る(2列とも同じ行に属する.fieldは同じ上端に揃う)。
		   ラウンド12指摘(A-5)が解決しようとした「1行目の縦位置バラバラ」問題も、原因が
		   margin:0の徹底に置き換わっただけで引き続き解消されたままになる。 */
		#edit-form .top-block-fields .field { margin: 0; }

		/* ラウンド5ユーザー指示: 第4弾でラベル(.field-label)を復活させたが「ラベルをやめ
		   placeholderにする」という撤回指示により、ここでは .field は単なる幅100%の
		   コンテナとして使う(ラベルが無いのでflexの単一子として自然に振る舞う)。 */
		#edit-form .top-block-fields .field > input.field-control,
		#edit-form .top-block-fields .field > select.field-control {
			min-width: 0;
			width: 100%;
			margin: 0;
			font-size: 0.94rem;
			padding: 0.42em 0.6em;
			/* ラウンド4の積み残し: 特性欄が長い値(「ウーラオス(いちげき)」相当の長さ)で
			   見切れる。省略記号で「切れている」ことを視覚的に示す(全文はtitle属性で確認)。
			   text-overflowの効果にはoverflow:hiddenが必須(一部ブラウザでinput要素は
			   既定でoverflow:hiddenだが、明示しないとellipsisが効かないケースがある)。 */
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* アイテム/テラスタイプ、技1〜4はカードの横幅に対して2列グリッドのまま維持する。
		   ラウンド5ユーザー指示によりラベル(A-8で統一した横並びラベル)は撤去し、
		   placeholder + aria-labelに戻したため、--field-label-widthはもう使わない。 */
		#edit-form .field-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.4rem 0.6rem;
			margin-bottom: 0.5rem;
		}
		#edit-form .field-grid > .field { margin: 0; }
		/* UI改善ラウンド26(26-L2): テラスタイプ欄をアイコン領域内へ移設した結果、この行(旧・
		   持ち物+テラスタイプの2列グリッド)には持ち物入力欄1つしか残らない。2列グリッドの
		   ままだと2列目が空いて間延びするため、この行だけ単独行(1列)に切り替えていた。
		   🔴 UI改善ラウンド28ユーザー指示(28-L4)「テラスタル選択ボックスはアイテム入力欄の
		   右側に配置」により、テラスタル選択ボックスをこの行の2列目へ戻したため、この
		   1列オーバーライドを撤回する(削除)。.field-grid-single(クラス名はそのまま維持)は
		   上の#edit-form .field-gridの基本定義(2列グリッド)がそのまま効く。 */
		/* UI改善ラウンド26(26-L3)「アイテム段と技段の間にも横棒を配置」。他の区切り線
		   (.damage-row-footer等)と同じトークン(1px solid var(--color-border))で揃えていた。
		   🔴 UI改善ラウンド31ユーザー指示(31-L7)「アイテムと技の入力欄の間の横棒を削除し、
		   代わりに間隔を広げる。技とステータスの間の間隔も同じだけ確保する」により、
		   (a) border-top/padding-topを撤去(横棒を消す。区切りは間隔の広さそのものに委ねる)。
		   ⚠️ 実測で判明した誤り: 当初「直前の.field-grid-singleのmargin-bottomと兄弟マージン
		   相殺(collapse)が起きる」という前提でmargin-top/bottomをそれぞれ1remにしたが、
		   実際は#edit-formがdisplay:flex(flex-direction:column、縦の並び)であり、
		   flexアイテム同士の縦マージンは相殺しない(CSS仕様上の既知の挙動)。実測すると
		   gap(b)=8px(field-grid-singleのmargin-bottom)+16px(move-fields-gridのmargin-top)=24px、
		   gap(c)=16px(move-fields-gridのmargin-bottom)+0px(.stat-tableのmargin-top、未指定)=16pxと
		   不揃いになっていた(24px≠16px)。
		   (b)(c)を同値にするため、直前の.field-grid-single側のmargin-bottomを0にし(下記
		   #edit-form .field-grid.field-grid-single参照)、gap(b)(c)とも「このmove-fields-gridの
		   margin-top/margin-bottomだけ」で決まるようにする。1remずつ(16px)で統一し、
		   修正前(b)9.6px/(c)8.0pxからどちらも拡大する。 */
		#edit-form .field-grid.move-fields-grid {
			margin-top: 1rem;
			margin-bottom: 1rem;
		}
		/* 🔴 UI改善ラウンド31ユーザー指示(31-L7)対応の一部: 持ち物/テラス行(.field-grid-single)
		   自身のmargin-bottom(基底#edit-form .field-gridの0.5rem)を0にし、直後の
		   .field-grid.move-fields-gridとの間隔を後者のmargin-topだけで一元管理する
		   (#edit-formがflexコンテナのためマージン相殺が起きない、上のコメント参照)。 */
		#edit-form .field-grid.field-grid-single {
			margin-bottom: 0;
		}
		/* ラウンド21ユーザー指示(21-L6)で導入した.field-span-all(テラスタイプ欄が19タイプの
		   アイコンを並べるため2列目の狭い幅に収まらず、grid-column: 1 / -1で自分の行を占有する
		   ためのクラス)は、ラウンド23(23-L3)でテラスタイプを<select>に戻したことで不要になった
		   (再び持ち物と同じ2列グリッドに収まる幅のため)。マークアップからクラスを外し、この
		   定義も削除した。 */
		/* 2列に詰めたぶん1つあたりの幅が狭いので、この左パネル内だけ文字と余白を少し詰めて
		   「ブーストエナジー」「こだいかっせい」クラスの長さが枠内に収まるようにする。 */
		#edit-form .field-grid .field-with-image > input,
		#edit-form .field-grid .field-with-image > select {
			min-width: 0;
			width: 100%;
			margin: 0;
			font-size: 0.94rem;
			padding: 0.42em 0.6em;
			/* ラウンド4の積み残し: 持ち物欄が長い値(「こだわりハチマキ」等)で見切れる。 */
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* ドロップダウン統一(ラウンド4): 上のpadding(shorthand)がpadding-rightも
		   0.6emに戻してしまうため、矢印ぶんの余白をselectだけ広げ直す(このルールが
		   後ろにあるので勝つ)。 */
		#edit-form .field-grid .field-with-image > select {
			padding-right: 1.8em;
		}
		/* 入力欄の右に画像(持ち物・テラス)や補助リンク(技の詳細)を並べる行。
		   画像は幅が確定しているので flex:0、入力欄側だけを伸縮させる。 */
		#edit-form .field-with-image { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
		#edit-form .field-with-image > input,
		#edit-form .field-with-image > select { flex: 1 1 0; }
		#edit-form .field-with-image > img,
		#edit-form .field-with-image > span,
		#edit-form .field-with-image > a { flex: 0 0 auto; }
		/* ラウンド12指摘(A-1): .field-with-image自体には親(.field)いっぱいに広がる指定が無く、
		   中身(inputの内容幅)に収縮フィットしていたため、持ち物(実測189px)/テラス(113px)/技
		   (164px)の右端が列幅195pxに対してバラバラだった。.field-gridの直下(.field経由)にある
		   ものだけ、列幅いっぱいに伸びるようflex/width/min-widthを明示する(左パネルの外で
		   .field-with-imageが別の使われ方をしていないか確認した上でセレクタをこの階層に絞る)。 */
		#edit-form .field-grid > .field > .field-with-image { flex: 1 1 auto; width: 100%; min-width: 0; }

		/* UI改善ラウンド23(23-G3): メガシンカ種族選択時に持ち物をメガストーンへ自動設定した
		   ことを示す一時的なハイライト(JSがis-autofilledクラスを付け、約1.4秒後に自動で外す。
		   flashAutofillHint参照)。box-shadowのみで高さを取らないため、下端が画面ギリギリの
		   左パネルのレイアウトを崩さない。input:focus(global.css)と同系統の色だが、リング幅を
		   広げて別要素と誤認しないようにする。 */
		#edit-form #item.is-autofilled {
			border-color: var(--color-primary);
			box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 30%, transparent);
		}

		/* ラウンド25ユーザー指示(25-L2)「テラスタイプ選択を、選択ボックスの位置にPokeAPIの
		   テラスタイプ画像(アイコン+英語タイプ表記)がそのまま出るUIにする」。
		   ラウンド23の23-L3(<select>+左に小さい丸アイコン、.tera-select-wrap/
		   .tera-type-icon)を撤回し、ボタン+リストボックスのカスタムドロップダウンに
		   置き換える(21-L6で一度似た構成を作ったが23-L3で削除済みのため作り直し)。
		   #tera(<select>)は保存経路・値の実体として隠したまま残る(HTML側でhidden属性、
		   <script>のbuildTeraDropdown参照)。
		   🔴 UI改善ラウンド28ユーザー指示(28-L4)「テラスタル選択ボックスはアイテム入力欄の
		   右側に配置」により、この一式を帯(.top-block-icon)の中から.field-grid-single
		   (持ち物入力欄の右列)へ移設した(ウィジェットのロジック=開閉・選択・保存は
		   一切変えていない、<script>のbuildTeraDropdown参照)。移設先は.field-grid内の
		   .field-with-imageなので、ここでの明示的なflex指定は不要になった(旧#edit-form
		   .field-with-image > .tera-dropdown-wrapは削除。#edit-form .field-grid > .field >
		   .field-with-image { flex: 1 1 auto; width: 100%; }が既に効く)。 */
		#edit-form .tera-dropdown-wrap { position: relative; width: 100%; }
		/* 🔴 UI改善ラウンド31ユーザー指示(31-L5)「テラスタル入力欄も左揃え」により
		   justify-content: flex-start を明示する(global.cssの共通`button`ルールが
		   justify-content: center を持ち、このボタンは何も上書きしていなかったため中央寄せに
		   なっていた。既存のtext-align:leftはflexレイアウトの子要素配置には効かない)。
		   🔴 UI改善ラウンド31ユーザー指示(31-L4)「持ち物入力欄とテラスタル選択欄のY位置・高さを
		   揃える」により、min-height/line-heightを明示する(<button>はglobal.cssの
		   `input[type="text"], select { min-height: 2.35rem; line-height: var(--line-height-snug); }`
		   の対象に含まれず、UAデフォルトのline-heightのまま高さがinput/selectと1.1pxずれていた)。 */
		#edit-form .tera-dropdown-button {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 0.35rem;
			width: 100%;
			min-height: 2.35rem;
			padding: 0.42em 0.6em;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			cursor: pointer;
			font-size: 0.94rem;
			line-height: var(--line-height-snug);
			color: var(--color-text);
			text-align: left;
		}
		#edit-form .tera-dropdown-button:hover { border-color: var(--color-primary); }
		#edit-form .tera-dropdown-button:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		/* UI改善ラウンド28ユーザー指示(28-G1)「テラスタイプ画像には専用アイコンを使う」により、
		   PokeAPIの横長リボン画像(実寸200×48前後、英語表記込み)からteraTypeIconUrlの正方形
		   専用アイコンへ切り替えた(<script>のupdateTeraDropdownButton参照)。専用アイコンは
		   幅を持て余すため固定サイズにし(通常タイプアイコンと同じ--icon-size-sm、20px)、
		   隣にテラスタイプ名のテキスト(#tera-dropdown-placeholder、下記)を並べる。宝石型
		   アイコンはジグザグの尖った縁を持つため、border-radius: 50%による丸トリミングは
		   掛けない(掛けると縁が削れる)。 */
		#edit-form .tera-dropdown-image { width: var(--icon-size-sm); height: var(--icon-size-sm); object-fit: contain; flex-shrink: 0; }
		/* ラウンド24ユーザー指示(24-L3)「テラスなしを目立たなくする」と同じ視覚言語
		   (#edit-form input:placeholder-shownと同じ破線枠+透明背景)を、テラスなし選択中の
		   ボタンにも適用する(<script>のupdateTeraDropdownButton参照)。
		   UI改善ラウンド28ユーザー指示(28-L4)により、#tera-dropdown-placeholder(既存ID、
		   改名しない)は「未選択時の代替テキスト」から「選択中も常時表示するラベル
		   テキスト」へ役割を広げた(アイコン+テキストを常に並べる)。選択中は
		   .is-tera-value-textを付け、mutedを打ち消して通常の文字色にする。 */
		#edit-form .tera-dropdown-button.is-tera-unselected {
			border-style: dashed;
			background: transparent;
		}
		#edit-form .tera-dropdown-placeholder {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			color: var(--color-text-muted);
		}
		#edit-form .tera-dropdown-placeholder.is-tera-value-text { color: var(--color-text); }
		#edit-form .tera-dropdown-placeholder[hidden] { display: none; }
		/* リストボックス: ボタン直下に開く。19タイプ+テラスなしの20項目を縦スクロールで収める。 */
		#edit-form .tera-dropdown-list {
			position: absolute;
			top: calc(100% + 0.25rem);
			left: 0;
			right: 0;
			z-index: 5;
			margin: 0;
			padding: 0.3rem;
			list-style: none;
			max-height: 16rem;
			overflow-y: auto;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-md);
		}
		#edit-form .tera-dropdown-list[hidden] { display: none; }
		/* ⚠️ .tera-dropdown-option/.tera-dropdown-option-image/.tera-dropdown-option-text は
		   <script>のbuildTeraDropdownがdocument.createElement()で動的生成する要素(<li>/<img>/
		   <span>)なので、このscoped <style>は一切効かない(pitfalls.md「Astroのscoped styleは
		   JSで生成した要素に効かない」参照。data-astro-cid-*が付かないため)。実際のスタイルは
		   下の<style is:global>側(#species-type-badge .type-badge-fallbackの直後)に定義する。 */

		/* ラウンド23ユーザー指示(23-L4)「技の選択ボックスの枠色をタイプごとに変えない」により、
		   技名確定時にborder-colorをタイプ色にしていたupdateMoveTypeColor()を関数ごと削除した
		   (UI品質改善11-3で追加・21-L8でbackground-colorのみ先に撤去していたもの)。技の入力欄は
		   他の入力欄と同じ既定の枠色になる(タイプは左のアイコンで伝わる)。この
		   transition: border-color自体は他の状態変化(focus等)にも汎用的に効くため残す。 */
		#edit-form .move-input-group > input {
			transition: border-color 0.15s ease;
		}
		/* ラウンド21ユーザー指示(21-L8): タイプアイコンを技名の左に置く。<input>の中には
		   画像を入れられないため、入力欄の左に絶対配置し、input側のpadding-leftで
		   文字と重ならないようにする(検索欄の虫眼鏡アイコンと同じ定石)。 */
		#edit-form .move-input-group { position: relative; }
		#edit-form .move-type-icon {
			position: absolute;
			left: 0.55em;
			top: 50%;
			transform: translateY(-50%);
			width: var(--icon-size-sm);
			height: var(--icon-size-sm);
			display: flex;
			pointer-events: none;
		}
		/* [hidden]は詳細度で負けるため、displayを指定するこのクラスには[hidden]用の
		   display:noneを必ず併記する(pitfalls.md参照)。技が未入力/タイプ不明のときは
		   このspan自体がhiddenのまま(<script>のupdateMoveTypeIcon参照)。 */
		#edit-form .move-type-icon[hidden] { display: none; }
		#edit-form .move-type-icon img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; }
		/* ⚠️ 詳細度に注意: #edit-form .field-grid .field-with-image > input(628行付近)が
			padding: 0.42em 0.6em というshorthandを持ち、classが1つ多い(.field-grid
			.field-with-imageの2つ+要素結合子)ぶんこちらより詳細度が高いため、後方に書いても
			padding-leftの値は上書きされない実測結果が出た(技名の先頭文字とアイコンが重なる
			事故)。セレクタに.field-grid/.field-with-imageを含めて詳細度を同等以上にする。 */
		#edit-form .field-grid .field-with-image.move-input-group > input {
			padding-left: calc(var(--icon-size-sm) + 0.9em);
		}
		/* ラウンド21(21-L4)の「読み取り専用のラベル+値のテキスト表示」(<p class="nature-readout">)は
		   ラウンド23(23-L2)ユーザー指示により<input readonly class="field-control">へ置き換えた
		   (特性の直下、他の入力欄と見た目を揃える)。.nature-readout系のCSSはもう使われないため
		   削除した。readonly状態のヒントは#nature-readout-value[readonly]で個別に与える(下記)。 */
		#nature-readout-value[readonly] {
			cursor: default;
			background: var(--color-surface-alt);
		}

		/* ラウンド4ユーザー指示: 「技1〜4」個別ラベルの代わりに置く1個のグループ見出しだったが、
		   ラウンド20ユーザー指示(20-L1)でplaceholder方式に統一したため.field-group-label自体を
		   撤去した(マークアップ側のspanも削除済み)。 */

		/* ラウンド4ユーザー指示で追加した「技の詳細はリンクではなくホバー表示にする」
		   ツールチップ(.move-detail-trigger/.move-detail-tooltip)は、ラウンド20ユーザー指示
		   (20-L2)「わざのヘルプ表示を削除」により撤去した(マークアップ・<script>の
		   setupMoveDetailTooltips相当のロジックも削除済み)。 */

		/* UI品質改善: メモ欄は「空いた縦スペースを吸収して伸びる」せいで実測200px近くまで
		   膨らみ、情報密度に対して過大だった。メモ自体は控えめな固定高さ(最大10em)に
		   留めていたが、ラウンド20ユーザー指示(20-L5)「メモ欄の高さ増加」によりmin/max両方を
		   引き上げる(4.4em→8em / 10em→16em)。左パネルは縦フレックスで余白をメモ欄が
		   吸収する設計のため、拡張後も左パネル下端が画面外に出ないことを実測済み
		   (1440×1080・1920×1080、実装時の検証記録参照)。 */
		#edit-form .memo-input { width: 100%; min-width: 0; min-height: 8em; max-height: 16em; margin: 0 0 0.5rem; resize: vertical; }
		@media (max-width: 520px) {
			#edit-form .field-grid { grid-template-columns: 1fr; }
			/* UI改善ラウンド26(26-L2): 種族/ニックネーム/特性/性格の2列グリッドも、狭幅では
			   .field-gridと同じ閾値で1列に戻す(2列だと1列あたりの幅が窮屈になるため)。 */
			.top-block-fields { grid-template-columns: 1fr; }
		}

		/* デスクトップでは左パネルのカードを縦フレックスにして画面の高さいっぱいまで伸ばし、
		   ダメージ計算カード側(右カラム)とおおむね高さを揃える。
		   モバイルでは右カラムが下に続くため高さを固定しない。
		   閾値は .edit-layout の2カラム化と必ず揃えること(縦積みのときに左パネルだけ
		   100vh近くまで伸びると、その下のダメージ計算カードが画面外に押し出される)。
		   UI品質改善(帯構成への刷新・実測バグ修正): 従来は「ページ見出し+上下余白の実測値
		   200px」を仮定した min-height: calc(100vh - 200px) で左の帯を伸ばしていたが、
		   実際のヘッダ高さは200pxちょうどではなく、画面下端の手前(実測9割程度)で帯が
		   途切れ背景色が見える不具合になっていた。ヘッダの実測ピクセル値を仮定しない構成に
		   作り直す: .edit-shell自体を縦フレックスにして.edit-layoutに「残り全部」の高さを
		   flex:1 1 autoで渡す。
		   .edit-layoutは既に2/3カラムグリッドでalign-items:stretch(上のブロック参照)なので、
		   あとは height:100% を .edit-layout-left → form → .panel の順に連鎖させれば、
		   実際の行の高さ(中央カラムの内容がより長ければそちらに揃って伸びる)まで
		   自動的に届く(display:flexだけでは子要素の高さは追随しないため、各段でheight/flexを
		   明示する必要がある)。
		   共通トップバー新設(2026-07-26): 以前はページ固有の.page-header(戻る/保存状態/
		   ポケモン名/削除ボタン)がedit-shell内の最初の子としてflex-shrink:0で高さを消費し、
		   「edit-shell(100vh) - page-headerの実高さ」が自動的にedit-layoutへ回っていた。
		   .page-headerをAppLayoutの共通トップバー(sticky、edit-shellの外側にある兄弟要素)へ
		   丸ごと移設したことで、edit-shellの子はedit-layout(またはフォールバックの
		   section.panel)だけになった。トップバーぶんの高さはもうedit-shell内部で消費
		   されないため、min-heightを100vhのままにするとトップバー実高さぶん画面全体が
		   余計に長くなり無駄な縦スクロールが出る(実測で確認)。トップバーの実測高さと一致する
		   --topbar-height(global.cssの:root、デスクトップ65px)を差し引く。 */
		@media (min-width: 1200px) {
			.edit-shell {
				display: flex;
				flex-direction: column;
				min-height: calc(100vh - var(--topbar-height));
			}
			.edit-layout {
				flex: 1 1 auto;
				min-height: 0;
			}
			.edit-layout-left {
				height: 100%;
			}
			.edit-layout-left > form {
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			/* UI品質改善(デザイン原則整合): 個体編集フォームを包むこの1枚は「1画面に1つの骨格領域」
			   なのでカード(可算コレクション要素)ではなくパネル(.panel)。クラス変更に合わせて
			   セレクタもこちらに合わせる。 */
			.edit-layout-left > form > .panel {
				flex: 1 1 auto;
				display: flex;
				flex-direction: column;
				width: 100%;
				min-height: 0;
			}
		}
		/* UI改善ラウンド26ユーザー指示(26-L2)「アイコン領域を全幅に拡大。タイプ画像、
		   アイテム画像+アイテム名、テラスタイプ画像を余裕をもって配置する」により、
		   .top-block-icon(アイコン領域)を種族アイコン+バッジ群の縦フレックス(旧構成)から
		   全幅の横フレックスに作り直した。
		   UI改善ラウンド28ユーザー指示(28-L1)「ポケモン画像が帯の左半分に配置されているが、
		   帯の全幅を使って中央配置する」により、ラウンド27(27-H1)の「中央寄せゾーン+右コーナー列」の
		   2分割flexを撤回し、#species-icon-boxを帯の全幅に対して中央寄せしていた。
		   🔴 UI改善ラウンド31ユーザー指示(31-L2)「アイテム画像+文字のサイズを大きくする。
		   ポケモン画像を少し左に移動してよい」により、28-L1の「帯の全幅に対する厳密な中央寄せ」を
		   この要件の範囲で撤回する(round-31.md「この指示で撤回される過去の判断」表に明記)。
		   コーナー列(アイテム画像+名前)を拡大すると必要幅が増え、絶対配置オーバーレイのままだと
		   #species-icon-boxとの重なりを避けられないため、コーナー列を通常フロー(flex: 0 0 auto の
		   固定幅カラム)に戻す。#species-icon-box側はflexの子要素のまま`margin-inline: auto`を
		   付与し、コーナー列を差し引いた残り幅の中で中央寄せされるようにする(=中央寄せの意図は
