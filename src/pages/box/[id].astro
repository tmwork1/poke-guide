		#opponent-notes-section .damage-row-columns {
			display: flex;
			flex-direction: column;
			/* 24-D1: 技列同士の間隔を0.3rem→0.22remに詰める(カード全体の縦サイズ縮小)。 */
			gap: 0.22rem;
