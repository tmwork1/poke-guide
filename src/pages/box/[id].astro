---
// Phase C-3: 個体の編集フォーム (育成データ管理計画.md §6.2, §8 Phase C-3)。
// デバウンス付き即時自動保存 + 楽観的UI更新: 入力のたびに数百ms待ってから、既存個体は
// PUT /api/owned-pokemon/:id、新規個体は種族確定後に POST /api/owned-pokemon を呼ぶ。
// 保存中も入力をブロックしない。失敗時のみエラー表示する。
//
// 初期表示データの取得は API 経由の fetch ではなく、Astro のフロントマター(SSR)で
// src/lib/owned-pokemon.ts の getOwnedPokemon() を直接呼び出す(box/index.astro の一覧取得のような
// クライアント側fetchより初期表示が速く、かつ「生のSupabaseクエリはowned-pokemon.tsに集約する」
// という設計原則にも合致する)。
//
// 未ログイン時、および他人の個体/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(Phase A-3の方針を踏襲)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import PokemonSettingsModalHost from '../../components/box-id/PokemonSettingsModalHost.astro';
import DamageCalcSection from '../../components/box-id/DamageCalcSection.astro';
import DamageDetailPanel from '../../components/box-id/DamageDetailPanel.astro';
import StatAdjustSheet from '../../components/box-id/StatAdjustSheet.astro';
import BulkAdjustDialog from '../../components/box-id/BulkAdjustDialog.astro';
import SpeedAdjustDialog from '../../components/box-id/SpeedAdjustDialog.astro';
import MobilePokemonPreview from '../../components/box-id/MobilePokemonPreview.astro';
import { createMobilePreviewPlaceholder } from '../../lib/box-id/mobile-preview-placeholder';
import '../../styles/box-edit-page.css';
import '../../styles/box-damage-page.css';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { getOwnedPokemon, type OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { getOpggUsageList, getOpggUsageManifest, sortOpggSeasons } from '../../lib/opgg-usage';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
const id = Astro.params.id;
const isNewMode = id === "new";
const isGuestNewMode = isNewMode && !user;

let pokemon: OwnedPokemonRecord | null = null;
let loadError = false;

// 種族選択モーダルの並び順に使うOP.GGランキング。個体の取得結果に依存しないので、
// ログイン中の個体取得とは並列に待つ(ゲスト・新規でも同じ並び順にするため常に取得する)。
// 失敗しても編集画面は従来どおり表示できるよう、空配列へフォールバックする。
const opggRankedSpeciesNamesPromise = (async () => {
	try {
		const manifest = await getOpggUsageManifest(env.OPGG_USAGE);
		const currentSeason = sortOpggSeasons(manifest)[0];
		const seasonList = currentSeason
			? await getOpggUsageList(env.OPGG_USAGE, currentSeason)
			: null;
		return seasonList?.pokemon.map((entry) => entry.name) ?? [];
	} catch (err) {
		// eslint-disable-next-line no-console
		console.error('[box/[id]] failed to load OP.GG species ranking', err);
		return [];
	}
})();

if (!user && !isNewMode) {
	pokemon = createMobilePreviewPlaceholder(id ?? '');
} else if (user && isNewMode) {
	pokemon = { ...createMobilePreviewPlaceholder(''), user_id: user.id };
} else if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getOwnedPokemon(user.id, id, supabase);
	if (result.ok) {
		pokemon = result.data;
	} else {
		loadError = true;
	}
	if (!pokemon && !loadError) {
		Astro.response.status = 404;
	}
}

const opggRankedSpeciesNames = await opggRankedSpeciesNamesPromise;

// UI刷新(第4弾): 性格の選択UI(<select>)は要件により廃止した。性格はステータス補正にしか
// 影響しないため、能力値ラベルのクリックで上昇/下降(HP以外)を選び、性格名は<script>側で
// 逆算するだけにする(保存データには従来どおり性格名を入れる)。そのため NATURES(性格名の
// 選択肢一覧)はもうフロントマターで使わない。対応表(NATURE_STAT_MODIFIERS)は<script>側に
// 定義しており、vendor/jpoke/src/jpoke/data/nature.py の NATURE_MODIFIER と一致させている。

// TERA_TYPES(19タイプの選択肢一覧)は src/lib/tera-types.ts へ切り出し済み(育成パネル用<script>と
// #opponent-notes-section用<script>にも同じ配列が複製されていたため、3箇所重複を解消した)。
// 値・順序は不変。

// UI刷新(ダメージ計算カード化): 天候/地形/相手側の壁/状態異常の選択肢は、行(対戦相手)ごとに
// JSで動的生成するカードの中で使うため、Astroフロントマター側では定義せず、ブラウザ専用<script>内に
// 同じ選択肢を直接持たせている(下記<script>のDAMAGE_WEATHERS等を参照。フロントマターの値は
// ブラウザ側の<script>から参照できないため。src/pages/damage-calc/index.astro のWEATHERS/TERRAINS/
// SIDE_FIELDSと同じ選択肢で同期させること)。

// STAT_LABELS/MOVE_SLOTS/statAt は育成パネル専用のためPokemonEditPanel.astroへ移設した
// (構造分割ラウンド、フェーズ1)。

// pageTitleは<title>タグ(ブラウザタブ)に使われる。
// ヘッダー表示は種族名固定。
const pageTitle = pokemon && pokemon.species_name ? pokemon.species_name : "ポケモン編集";
const bodyClass = pokemon ? "box-edit-page" : undefined;
// クエリ指定時も最初のHTMLからヘッダーと本文の表示状態をそろえる。
// クライアント初期化まで待つと、特に復帰表示時に「育成」が一瞬選択されたままになる。
const initialMobileTab = !isNewMode && Astro.url.searchParams.get('tab') === 'damage' ? 'damage' : 'training';

// 匿名集計サジェスト機能・第4段階(UI: 収集拒否トグル)。owned_pokemon.collection_opt_out_until
// (null=収集対象、未来日時=拒否期間中)から、SSR時点での「拒否中かどうか」と「残り日数」を
// 算出する。過去日時(期限切れ)はnullと同じ扱い(=収集対象。拒否中の表示は出さない)にする。
// このロジックは<script>側(src/lib/box-id/pokemon-edit-panel.ts)のPATCH成功時レスポンス反映でも
// 同じ計算式(ミリ秒差をceilして日数化)を使うので、変更する場合は両方揃えること。
---
<AppLayout title={pageTitle} current="box" bodyClass={bodyClass}>
	<div class="page edit-shell" id="edit-shell" data-mobile-tab={initialMobileTab}>
	{
		isGuestNewMode ? (
			<section class="panel">
				<div class="panel-content">
					<p>ログインすると、新しいポケモンを作成できます。</p>
					<a href="/api/auth/login">Googleでログイン</a>
				</div>
			</section>
		) : loadError ? (
			<section class="panel">
				<div class="panel-content">
					<p>ポケモン情報を読み込めませんでした。時間をおいて再度お試しください。</p>
				</div>
			</section>
		) : !pokemon ? (
			<section class="panel">
				<div class="panel-content">
					<p>指定されたポケモンが見つかりませんでした(削除された、または他のアカウントのポケモンである可能性があります)。</p>
				</div>
			</section>
		) : (
			<>
			<MobilePokemonPreview pokemon={pokemon} activeTab={initialMobileTab} />
			<div class="edit-layout">
			<div class="edit-layout-training">
			{/* 育成パネル(ポケモン編集パネル、.panel-edit)のテンプレート・scoped style・スクリプトは
			    構造分割ラウンド(フェーズ1)により src/components/box-id/PokemonEditPanel.astro +
			    src/lib/box-id/pokemon-edit-panel.ts へ切り出した(見た目・ロジックは一切変更していない)。
			    SSRで取得済みのpokemon(この分岐では非null)だけをpropsで渡す。 */}
			{/* 育成・閲覧タブで共有するポケモン設定モーダルホスト。ここでは編集フォームも表示する。 */}
			<PokemonSettingsModalHost pokemon={pokemon} showForm={true} opggRankedSpeciesNames={opggRankedSpeciesNames} />
			{/* 保存状態とダメージ計算の保存失敗件数は、最終表示位置にSSRする。新規作成直後は
			    localStorageのゲスト個体を復元して保存済みへ変わる場合があるため、復元前だけ
			    「入力すると保存されます」の領域を出すと高さが揺れる。通常時と同じsavedで
			    始め、保存失敗時には理由と再試行ボタンを必ず表示する設計は維持する。 */}
			<div class="mobile-edit-actions" id="mobile-edit-actions">
				<p id="autosave-status" class="status-text" data-state="saved">
					<span id="autosave-status-text">保存済み</span><button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
				</p>
				{/* ダメージ計算カードは行ごとに独立して自動保存されるため、画面外にスクロールした
				    カードの保存失敗はカード自身のfooter(保存失敗時のみ表示)を見ないと気づけない。
				    育成タブでも失敗件数を表示できるよう、この常設の操作列に置く。 */}
				<span id="opponent-notes-save-alert" class="opponent-notes-save-alert" hidden></span>
			</div>
			</div>

			<div class="edit-layout-damage">

			{/* ダメージ計算カード(#opponent-notes-section)のテンプレート・is:globalスタイル・
			    スクリプトは構造分割ラウンド(フェーズ2)により src/components/box-id/DamageCalcSection.astro +
			    src/lib/box-id/damage-calc.ts へ切り出した(見た目・ロジックは一切変更していない)。 */}
			{isNewMode ? (
				<section class="panel">
					<div class="panel-content">
						{isNewMode ? (
							<p>種族を入力して保存すると、ダメージ計算などの機能が使えるようになります。</p>
						) : (
							<>
								<p>ログインすると、ダメージ計算などの機能が使えるようになります。</p>
								<a href="/api/auth/login">Googleでログイン</a>
							</>
						)}
					</div>
				</section>
			) : (
				<>
					<DamageCalcSection pokemonId={pokemon.id} />
					<StatAdjustSheet />
				</>
			)}
			</div>

			{/* ダメージ詳細パネル(詳細設定サイドバー、#damage-detail-panel + #damage-detail-backdrop)の
			    テンプレート・scoped styleは構造分割ラウンド(フェーズ2)により
			    src/components/box-id/DamageDetailPanel.astro へ切り出した(見た目・ロジックは一切
			    変更していない。.edit-layout-detail/#damage-detail-backdropの2要素をまとめて
			    このコンポーネント自身が描画する)。 */}
			{!isNewMode && <DamageDetailPanel />}
			</div>

			{/* 「耐久調整」機能のポップアップ本体。トップバーの#bulk-adjust-button
			    (上のFragment slot="topbar-actions"参照)から開く。マークアップ・スタイルは
			    BulkAdjustDialog.astro、ロジックはsrc/lib/box-id/bulk-adjust.tsに実装済み
			    (このページ側はimportと配置のみ)。 */}
			{!isNewMode && user && <BulkAdjustDialog />}
			{!isNewMode && <SpeedAdjustDialog pokemonId={pokemon.id} />}
			</>
		)
	}
	</div>

	<script>

		/* ダメージタブのカード領域は、実際のタブバーと下部ナビの座標から決める。
		   固定値の高さがずれても、両端に左右余白と同じガード帯を残す。 */
	</script>

	{/* 提案図(docs/ui_proposal/mobile/ の ui_mobile_box_個体編集_*.png)はどれも画面上端が
	    セカンドバー(MobilePokemonPreviewの.second-bar)で、共通ヘッダー(アプリロゴ)も独立した
	    「← 戻る」も描かれていない。戻るボタンはページナビゲーション側のアイコンボタンとして表示する。
	    ⚠️ ページナビゲーションに載っていた操作系(保存状態・耐久調整・すべて折りたたむ・非公開・削除)は
	    このCSSで一緒に消える。消えたままだとモバイルから削除も非公開切り替えもできなくなるため、
	    src/lib/box-id/mobile-edit-tabs.ts がDOMごとタブ本文側へ移設している(戻り先も保持済み)。 */}

</AppLayout>
