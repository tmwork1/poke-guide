			background-repeat: no-repeat;
			background-position: right 0.5em center;
			background-size: 9px 6px;
			padding-right: 1.5em;
		}
		#opponent-notes-section select:hover,
		#opponent-notes-section select:focus,
		#opponent-notes-section select:focus-visible {
			background-image: var(--select-arrow);
		}

		/* UI品質改善(デザイン原則整合): ダメージ計算1件=対戦相手1体は「追加/削除できる
		   コレクション要素」なのでカード(.card)として扱う。旧来はここに「battle-assistant
		   同様、カードを囲むパネルを持たないため枠も背景も付けない」と書いていたが、これは
		   骨格領域としてパネルで包まない旨の説明であり今も有効(この.damage-rows-list自体は
		   パネルにしない)。変わったのは個々のカード側で、基底.card(global.css)の枠線+
		   box-shadowを持つようになったため、カード同士の区切りは各カードの枠線・影と、この
		   gap の両方で表現する(影が付いた分、詰めて並べても1枚ずつが浮いて見え、区切りが
		   以前より明瞭になる)。
		   UI品質改善(2026-07-26 第4弾): 1920pxで右カラムにデッドスペースが残る問題は
		   align-items:flex-start(カードを内容幅までしか広げない)で解消を試みたが、
		   .damage-row-columns-wrapのflex-grow:1(flex-basis:0)と組み合わせると、コンテナの
		   利用可能幅が不定になり.damage-row-body全体のレイアウトが崩れる回帰が実機で発生したため
		   撤回した(flex-basis:0はflex-wrap誤爆防止の安全策として変更不可、と第3弾の知見にある)。
		   デッドスペース自体は.damage-row-build/.damage-columnの拡幅(320→340px/190→205px)で
		   ある程度緩和するに留める。 */
		/* ラウンド3 C-3: カード枠・内箱枠・フッター罫線が同じ濃さで多層に並び切れ目が読みにくかった
		   (A-4でフッター罫線自体は定常時に消えるので改善するが、gapも広げる)。
		   A-2で1枚303pxを達成し、3枚でも1080pxに収まる(実測1064〜1072px)ため8→12pxに広げる。 */
		/* ラウンド10: 「カードを2×2に並べる」案を実装したが、ユーザー判断により中止して
		   1列の縦積みに戻した。撤去したのは #opponent-notes-section / .card-damage の
		   container化と、@container dmgsection (min-width: 740px) による2列グリッド、
		   および2列時に相手ビルド箱を行いっぱいへ広げる @container dmgcard の指定。
		   実測での比較(1920px・カード4枚): 1列=1210px / 2×2=1144px。総高さは2×2が66px短いが、
		   カード1枚が276〜289px → 407〜559pxに伸び、1画面に入る枚数が3枚→2枚半に減る。
		   左右の行で高さが揃わない段差(実測152px)も出る。**再提案しないこと。** */
		#opponent-notes-section .damage-rows-list {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}
		/* エンジン初期化状況の1行。パネルの見出しを廃したので、この行だけが浮いて見えないよう
		   控えめな文字サイズにし、準備完了後は表示自体を隠す(JS側でhidden属性を付ける)。 */
		#opponent-notes-section .damage-calc-engine-status {
			margin: 0 0 0.4rem;
			font-size: 0.8rem;
		}
		#opponent-notes-section .damage-calc-engine-status[hidden] {
			display: none;
		}
		/* ラウンド17指摘(A-5): 確N/乱N/未撃破の凡例。カードごとに繰り返さず1行だけ常時表示する
		   (WCAG 1.4.1対応で色だけに頼らない。severity-barの赤/黄/緑と重複してよい説明のため
		   崩れても実害は小さい)。 */
		#opponent-notes-section .damage-verdict-legend {
			margin: 0 0 0.5rem;
			font-size: 0.72rem;
			color: var(--color-text-muted);
		}
		/* ラウンド3 B-11の積み残し: 相手ビルドの箱・技名入力も左パネルと同じく、
		   placeholder表示中(空欄)は破線+透明背景にする(#edit-form側と同じ考え方)。 */
		#opponent-notes-section input:placeholder-shown:not(:focus) {
			border-style: dashed;
			background: transparent;
		}

		/* コンパクト化(battle_assistant.jpg / DamageCard.jpg準拠): このセクションの余白・
		   フォントサイズはここから下、意図的に通常より詰めている。
		   なお当初あった「1行160px以下」の目安は、DamageCard.pngで相手ビルドの箱に
		   攻守切り替え・実数値・加算後の結果が縦に積まれる構成が指定されたため撤回した
		   (図の構成では1行あたり240px前後になる)。「複数のカードを縦に並列表示できる」
		   という要件自体は、行を縦積みにするこのレイアウトで引き続き満たしている。 */
		#opponent-notes-section .card-damage {
			padding: 0.3rem 0.6rem;
			margin: 0;
			max-width: 100%;
			/* ラウンド5ユーザー指示(要件9): 選択状態が分かる枠線+境界を用意する
			   (.is-selectedは<script>のselectRow参照。カード自体はJS生成なのでこのルールは
			   is:globalブロックに置く必要がある)。border/box-shadowの変化に備えてtransitionを
			   軽く付ける。 */
			transition: border-color 0.15s, box-shadow 0.15s;
		}
		/* UI品質改善(デザイン原則整合): 選択中の border-color: primary は基底 .card.is-selected
		   (global.css)に委譲する(このカードは class="card card-damage" を持つため、基底の
		   ルールがそのまま効く)。このページはカードが縦に長く連なるため、選択中の1枚をより
		   見つけやすくする加算表現としてリング状のbox-shadowだけをここに残す。
		   ラウンド7ユーザー指示(方針転換): カード全体設定の概念自体を廃止し、選択は「どの技列か」
		   の1階層だけになった(相手ビルドの箱はクリックしても無反応)。この粗いカード単位の
		   リングは「このカードのどれかの技列が選択中(=サイドバーの内容はこのカードのもの)」の
		   意味のまま残す(縦に長く連なるカード一覧の中で、いま操作中の1枚を見つけやすくする
		   ため)。技列側の詳細は.damage-column.is-selectedに委ねる(.damage-row-build側の
		   is-selectedマーカーは廃止した)。
		   ラウンド12指摘(B-4): 右サイドバーは未選択でも初期状態で「技1の設定」を表示する
		   仕様(意図的、変更対象外)のため、ページを開いた直後から1枚目のカード+技列1に
		   is-selectedが付く。このカード側の強調が下の.damage-column.is-selected(強いprimary
		   実線)と同じ強さの全周primary実線だと、「何も操作していないのに選択済みに見える」
		   二重強調になっていた。カード側はborder-colorを基底.card.is-selectedのprimaryから
		   通常のborder-colorへ戻し、左端3pxのinsetバーだけの弱いマークにする
		   (「このカードのどれかの技列が選択中」という意味は保ったまま、強調の主役は技列側
		   1つだけにする)。 */
		#opponent-notes-section .card-damage.is-selected {
			border-color: var(--color-border);
			box-shadow: inset 3px 0 0 var(--color-primary);
		}

		/* ラウンド4で「相手ビルドの箱と技列の箱をalign-items:stretchで同じ高さに揃える」設計を
		   破棄し、技列側をalign-self:flex-startで「行の高さに合わせて伸びる」対象から外したが、
		   ラウンド5ユーザー指示で「まだ空きが目立つ」と再指摘され、一度は相手ビルドの箱を上段
		   (カード全幅)・技列を下段(横スクロール可)の2段組に作り直した。
		   ラウンド6ユーザー指示(更新された設計図): 技列を横並びから縦積みに変更したところ、
		   「技列3つぶんの縦積み高さ」が「相手ビルドの箱の高さ」と自然に近い値になったため、
		   ラウンド5で問題視されていた「高さの違うものを横に並べる」ことによる大きな余白が
		   生じにくくなった。設計図(ダメージ計算カード.png)どおり左=相手ビルドの箱・右=技列の
		   縦積みという横並び2カラム構成に戻す(.damage-row-bodyをflex-direction:rowに戻す)。
		   両側の高さは意図的に強制一致(stretch)させない: 技数が少ない行まで無理に伸ばすと
		   ラウンド5で指摘された空白が再発するため、align-items:flex-startで両箱とも内容の
		   高さのぶんだけを占め、技列3つのときに実測値がおおむね揃うよう内側の余白側で調整する
		   (下の.damage-row-build/.damage-columnの実測コメント参照)。
		   クラス名(.damage-row-build/.damage-row-columns-wrap/.damage-row-columns等)は
		   このラウンドでも改名・削除していない(JS/E2E依存を壊さないため)。 */
		/* UI品質改善(ラウンド8 A-3): 技列が1〜2つのカードは、右カラム(techniquesRow)の
		   自然な高さが左の相手ビルド箱より短く、下端に「意味のない空白」が残っていた
		   (align-items:flex-startだと右カラムは内容ぶんの高さしか占めない)。
		   align-items:stretchに変え、右カラムの高さを箱の高さに揃えたうえで
		   .damage-add-column-slotのmargin-top:autoで「+技を追加」を下端へ押し出す
		   (=空白を「末尾の穴」から「意図的な余白+アンカーされたボタン」に変える)。
		   技列3つ(=右カラムの内容が箱より高い)側は右カラムが基準になり、箱側が
		   その高さまでstretchされるだけで、内容が窮屈になることはない。 */
		/* ラウンド10で発見した既存バグの修正: .damage-row-build は全幅で300px固定なので、
		   狭いビューポートでも横並びが維持され、技列が潰れていた(実測: 幅390pxで
		   .damage-row-body 329px のうち箱が300pxを取り、技列は残り19px)。
		   19pxの技列に連続技のヒット回数行(数値入力51px + 「回」22px)が入ると
		   right=427px まで飛び出し、幅390pxで37pxの横スクロールが発生していた
		   (ラウンド8の検証に連続技のカードを含めていなかったため見逃していた)。
		   → flex-wrapを許可し、技列に最小幅を与えて「箱+技列が入らない幅では
		   技列を次の行へ折り返す」ようにする。
		   実測での安全性: 1920px(body 758) / 1600px(459) では 300+9.6+150=460 が
		   body幅以下なので折り返さず、既存のデスクトップ2カラムは一切変わらない。 */
		#opponent-notes-section .damage-row-body {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: stretch;
			gap: 0.6rem;
			padding-bottom: 0.3rem;
		}

		/* 左: 相手ビルドの箱(DamageCard.pngの左側のボックス)。ラウンド6ユーザー指示で
		   左右2カラム構成に戻したため、右の技列(縦積み)と横並びになる固定幅を持つ。
		   攻守切り替えボタン・相手種族名+アイコン・特性・アイテム・テラスタイプ・
		   努力値・実数値を内包し、一番下に区切り線と「加算後のダメ・致死率」を置く。
		   技列(.damage-column)と同じ枠線・背景を与えて「並んだ箱」に見せる。
		   幅300pxは技列(下の.damage-columnはこの右側の残り幅いっぱいに伸びる)との
		   横幅バランスと、努力値グリッド7列(3.4em+6列)が窮屈にならない実測値。 */
		#opponent-notes-section .damage-row-build {
			flex: 0 0 300px;
			width: 300px;
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			padding: 0.35rem 0.6rem;
			/* UI品質改善(デザイン原則整合): 外側の.card-damage自体が基底.cardの
			   background: var(--color-surface-alt) を持つようになったため、そのまま
			   surface-altを重ねると内箱の境界が濁る。内側の箱は一段明るいvar(--color-surface)
			   にして、外枠(濃い)/内箱(明るい)のコントラストを付ける(技列の.damage-columnも同様)。 */
			background: var(--color-surface);
		}
		/* ラウンド7ユーザー指示(方針転換): 相手ビルドの箱のクリックは無反応にする(サイドバーを
		   開くのは技列の箱だけ)確定仕様になったため、この箱自体のis-selectedマーカー・
		   選択時transitionは廃止した(以前は.damage-column.is-selectedと対になっていた)。
		   ラウンド8指摘(B-4): 「クリック非反応であることが画面から分からない」の積み残しに
		   対応し、cursor:defaultを明示する(.damage-columnのcursor:pointerと対比させる)。 */
		#opponent-notes-section .damage-row-build { cursor: default; }
		/* UI品質改善(ラウンド8 A-1): 相手名input(29px)の右に公式絵72pxが乗っていたため、
		   名前行だけで72pxを占有し43pxが空気になっていた(特性/持ち物/テラスの3入力はその
		   下から始まる縦積み一本道だったため)。スプライトを名前行の外へ出し、「名前input+
		   3入力の縦スタック」(.damage-row-build-fields)と横に並べる(.damage-row-build-main)。
		   左スタックの実高さ(名前29px+特性/持ち物/テラス3行)ぶんまでスプライトを拡幅できる
		   ため、72→96pxに拡大できる(<script>のrenderRow、buildMain/buildFields参照。
		   .pokemon-name-row/.damage-row-build-grid自体は改名していない、親が変わっただけ)。 */
		#opponent-notes-section .damage-row-build-main {
			display: flex;
			align-items: flex-start;
			gap: 0.4rem;
		}
		#opponent-notes-section .damage-row-build-fields {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			min-width: 0;
			flex: 1 1 auto;
		}
		#opponent-notes-section .damage-row-build select,
		#opponent-notes-section .damage-row-build input[type="text"] {
			width: 100%;
			min-width: 0;
			/* ラウンド3 A-1: global.cssの input/select { min-height: 2.35rem }(=37.6px)が
			   ここで一度も打ち消されておらず、内容高さ24.6px(font-size 0.82rem/padding 0.28em)が
			   37.6pxに引き伸ばされて1行あたり13pxが空気になっていた(414px膨張の主因)。
			   タップ対象28pxの要件はアイコンボタン側(.damage-row-icon-button等)の話であり、
			   このページのテキスト入力には適用されないため、min-height自体を打ち消す。
			   フォントサイズは第4弾の底上げを維持し、変更しない。 */
			min-height: 0;
		}
		/* 名前行(アイコン+相手名input+アイコンボタン2つ)は上のwidth:100%を打ち消し、
		   flexで残り幅いっぱいまで伸ばす(打ち消さないと相手名inputが行全体の幅を
		   取ろうとして、隣のアイコンボタンが28px未満に潰れてしまう)。
		   font-size/paddingも他の入力欄同様に詰める(既定のinput[type=text]は
		   line-height:1.6を継承するため、詰めないとこの1個の入力欄だけ突出して高くなる)。 */
		#opponent-notes-section .pokemon-name-row input[type="text"] {
			width: auto;
			flex: 1 1 0;
			min-width: 0;
			font-size: 0.92rem;
			font-weight: 700;
			padding: 0.32em 0.45em;
			line-height: 1.2;
		}

		/* 相手ビルドの箱の1行目: 攻守切り替えボタンと、行単位の操作(🗑削除。⚙詳細ボタンは
		   ラウンド6で廃止し、箱自体のクリックに置き換えた)。
		   DamageCard.pngで最上段に置かれている「攻守切り替えボタン」の行にあたる。 */
		#opponent-notes-section .damage-row-actions {
			display: flex;
			align-items: center;
			gap: 0.3rem;
		}
		/* 攻守切り替えボタン: 「この個体が攻撃」⇄「この個体が受け」を切り替える。
		   どちら向きで計算しているかが一目で分かる必要があるため、アイコンだけにはせず
		   短い文言を入れて残り幅いっぱいに伸ばす。
		   ラウンド3 B-1: 中央寄せのghostボタンは見出しのように読め、結果を最も左右する操作
		   なのにボタンに見えていなかった。既定から枠線+面を持たせ、テキストを左寄せにして
		   右端に⇄アイコン(.damage-row-swap-arrow)を置く。「受け」(既定でない状態)のときだけ
		   枠線をprimaryにして非既定であることを示す(<script>のrefreshDirectionUi参照)。 */
		#opponent-notes-section .damage-row-swap-button {
			flex: 1 1 0;
			min-width: 0;
			font-size: 0.8rem;
			padding: 0.25em 0.5em;
			line-height: 1.2;
			justify-content: space-between;
			border-color: var(--color-border);
			background: var(--color-surface);
		}
		#opponent-notes-section .damage-row-swap-button .damage-row-swap-label {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			min-width: 0;
		}
		#opponent-notes-section .damage-row-swap-button .damage-row-swap-arrow {
			flex-shrink: 0;
			margin-left: 0.3em;
		}
		#opponent-notes-section .damage-row-swap-button[data-direction="defense"] {
			border-color: var(--color-primary);
			color: var(--color-primary);
		}

		/* 相手ビルドの入力欄(特性・アイテム・テラスタイプ)は、DamageCard.png準拠で
		   1項目1行の縦積みを既定にする。ラベルは置かずplaceholder/aria-labelのみ(既存方針を維持)。 */
		#opponent-notes-section .damage-row-build-grid {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			/* ラウンド3 A-2(e): 0.2rem→0.15remに詰める。 */
			gap: 0.15rem;
		}
		/* ラウンド5で「箱が全幅のときは3列に並べる」@containerクエリを追加していたが、
		   ラウンド6で箱を固定300px幅の左カラムに戻したため480px以上になることがなく
		   常に不発になる。実体のないルールを残すと紛らわしいため削除し、1列縦積み
		   (上の基本定義)のみにする。 */
		/* ラウンド5ユーザー指示: 「特性などの入力ボックスが無駄に大きい。さらに詰める」。
		   font-size/paddingを一段階詰める(0.82rem/0.28em 0.4em → 0.76rem/0.2em 0.35em)。 */
		#opponent-notes-section .damage-row-build-grid select,
		#opponent-notes-section .damage-row-build-grid input[type="text"] {
			font-size: 0.76rem;
			padding: 0.2em 0.35em;
			line-height: 1.15;
			/* ラウンド3 A-1: 相手ビルド箱の性格/特性/持ち物/テラスの4行がglobal.cssの
			   min-height:2.35remで各行13px膨らんでいた(4行で52px)。打ち消す。 */
			min-height: 0;
			/* ラウンド4の積み残し: 特性・持ち物欄が長い値で見切れる(全文はtitle属性で確認)。 */
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* ドロップダウン統一(ラウンド4): 上のpadding(shorthand)がpadding-rightも
		   戻してしまうため、矢印ぶんの余白をselectだけ個別に広げ直す
		   (このルールの方が後ろにあるので勝つ)。 */
		#opponent-notes-section .damage-row-build-grid select {
			padding-right: 1.3em;
		}

		/* 種族アイコン(公式絵)+ 右上テラスタイプバッジ + 右下持ち物バッジ。
		   #edit-form側の.species-icon-box/.type-badge等はAstroのscoped<style>で定義されており
		   動的生成要素には適用されないため、同等の見た目をここに再定義する。
		   ラウンド4で32px/28pxから56px/48pxに拡大、ラウンド5ユーザー指示で「まだ小さい」との
		   再指摘があり72px/64pxへ拡大、ラウンド8指摘(A-1)で名前行から出したぶんの余白を使い
		   96px/88pxへさらに拡大する(<script>のrenderRowでwidth/height属性・
		   spriteFallback.style.cssTextも同じ値に追随させている)。 */
		#opponent-notes-section .damage-sprite-box {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 96px;
			height: 96px;
			border-radius: var(--radius-md);
			background: var(--color-surface-alt);
			flex-shrink: 0;
		}
		#opponent-notes-section .damage-sprite-box img.sprite-icon {
			width: 88px;
			height: 88px;
		}
		#opponent-notes-section .damage-sprite-box .sprite-fallback {
			font-size: 1.8rem;
		}
		#opponent-notes-section .damage-type-badge {
			position: absolute;
			top: -6px;
			right: -6px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		/* ラウンド5ユーザー指示: 事前生成済みの正方形タイプアイコン(typeIconUrl/teraTypeIconUrl)に
		   切り替えたため、CSS側での切り出し(object-fit:cover等)は不要(上の.type-badge-imgと同じ理屈)。 */
		#opponent-notes-section .damage-type-badge-img {
			height: 18px;
			width: 18px;
			border-radius: 50%;
			filter: drop-shadow(0 0 1px var(--color-surface));
		}
		#opponent-notes-section .damage-type-badge-fallback {
			display: none;
			width: 18px;
			height: 18px;
			border-radius: 50%;
			border: 1px solid var(--color-border);
		}
		/* #species-type-badge自体は静的マークアップだが、中の<img>/<span>はapplyTypeBadge()が
		   document.createElement()で動的追加するため、上のscoped <style>の.type-badge-imgは
		   付与されない(data-astro-cid-*が無い要素にはscoped <style>が効かない。
		   #opponent-notes-section .damage-type-badge-imgと同じ理屈)。同じ値をここに複製する。
		   ラウンド5ユーザー指示: 正方形の事前生成アイコンに切り替えたため object-fit:cover 等の
		   切り出しは不要(border-radius:50%だけで円形に見える)。 */
		#species-type-badge .type-badge-img {
			height: 14px;
			width: 14px;
			border-radius: 50%;
			filter: drop-shadow(0 0 1px var(--color-surface));
		}
		#species-type-badge .type-badge-fallback {
			display: none;
			width: 14px;
			height: 14px;
			border-radius: 50%;
			border: 1px solid var(--color-border);
		}
		/* 持ち物画像: 名前行の横幅を圧迫しないよう、種族アイコンに小さなバッジとして重ねる
		   (要件: テラスバッジ=右上と衝突しない対角に配置)。
		   ラウンド8指摘(A-1由来): 以前はbottom:-6px/left:-6pxで名前inputとの継ぎ目に浮いて
		   見えていた。/box(.card-item-badge)と同じ右下22px円形+1px枠+box-shadowに揃える。 */
		#opponent-notes-section .damage-item-badge {
			position: absolute;
			bottom: -4px;
			right: -4px;
			width: 22px;
			height: 22px;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: 50%;
			box-shadow: var(--shadow-sm);
			overflow: hidden;
			padding: 2px;
		}
		/* ラウンド8の回帰修正: display:flexを持つクラスはUAの[hidden]{display:none}に
		   詳細度で勝ってしまう(pitfalls.md「[hidden]は詳細度で負ける」)。バッジ自体が
		   白丸+枠+影を持つようになったため、持ち物なしの相手で空の白丸が出続けていた。
		   /boxの.card-item-badgeと同じ対策を併記する。 */
		#opponent-notes-section .damage-item-badge[hidden] {
			display: none;
		}
		#opponent-notes-section .damage-item-image {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		/* 努力値/実数値グリッド(DamageCard.pngの「努力値 ＨＡＢＣＤＳ」「実数値 ＨＡＢＣＤＳ」の2行)。
		   1列目に行ラベル(努力値/実数値)を置き、その右にH/A/B/C/D/Sの6列を並べる3段構成
		   (1段目はH/A/B/C/D/Sの見出し)。DOMも行優先(見出し7セル→努力値7セル→実数値7セル)で
		   生成すること。列ごとに縦積みしていた旧構造では行ラベルを付けられなかったため入れ替えた。
		   UI品質改善(2026-07-26 第4弾): 文字が実測~10pxと小さすぎたため、行ラベル/列見出し/
		   数値のフォントサイズを底上げした(桁揃えのため.tnumも<script>側の生成コードに追加)。 */
		#opponent-notes-section .damage-ev-grid {
			display: grid;
			grid-template-columns: 3.4em repeat(6, minmax(0, 1fr));
			gap: 0.15rem 0.15rem;
			align-items: center;
			margin-top: 0.15rem;
		}
		#opponent-notes-section .damage-ev-row-label {
			font-size: 0.66rem;
			font-weight: 700;
			line-height: 1.2;
			color: var(--color-text-muted);
			white-space: nowrap;
		}
		#opponent-notes-section .damage-ev-col-label {
			font-size: 0.68rem;
			font-weight: 700;
			line-height: 1.2;
			text-align: center;
			color: var(--color-text-muted);
		}
		/* ラウンド5ユーザー指示: H/A/B/C/D/S見出し(HP以外)の▲/▼ボタンで相手の性格の上昇/下降を
		   独立に切り替える(旧・単一ボタンの巡回方式は左パネルと同じ理由で作り直した。
		   toggleNatureUp/toggleNatureDown参照)。列の幅が狭いため縦積み(▲/文字/▼)にする。 */
		#opponent-notes-section .damage-ev-col-header {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.1rem;
		}
		/* ラウンド12指摘(A-4): width/heightがem指定(1.15em/0.95em)で、基準になるfont-sizeも
		   このルール自身の0.62rem(=9.92px)だったため、実寸11.4×9.4pxしか出ていなかった
		   (ラウンド8 A-7で左パネルの.stat-nature-btnに対して潰したのと同型のemの入れ子事故の
		   取りこぼし)。px指定に変えて18×14pxにする(左パネルの同機能ボタン22×20pxには及ばないが、
		   このカードは3枚並べたときに1080pxへ収める制約があるため、そちらを優先する)。 */
		#opponent-notes-section .damage-ev-nature-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 18px;
			height: 14px;
			padding: 0;
			font-size: 0.62rem;
			line-height: 1;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: 2px;
			color: var(--color-text-muted);
			cursor: pointer;
		}
		#opponent-notes-section .damage-ev-nature-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
		#opponent-notes-section .damage-ev-nature-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
		#opponent-notes-section .damage-ev-nature-up[aria-pressed="true"] {
			background: var(--stat-up);
			border-color: var(--stat-up);
			color: var(--color-primary-contrast);
		}
		#opponent-notes-section .damage-ev-nature-down[aria-pressed="true"] {
			background: var(--stat-down);
			border-color: var(--stat-down);
			color: var(--color-primary-contrast);
		}
		#opponent-notes-section .damage-ev-col-label[data-mod="up"] { color: var(--stat-up); }
		#opponent-notes-section .damage-ev-col-label[data-mod="down"] { color: var(--stat-down); }
		/* グリッドのセル幅に完全に従わせる(width:100%とmin-width:0の両方が必要。
		   min-width:0を省くと、global.cssのinput既定幅がグリッドの最小コンテンツ幅として
		   効いてしまい、6列が箱の横幅を超えてはみ出す)。 */
		#opponent-notes-section .damage-ev-grid input[type="number"] {
			width: 100%;
			min-width: 0;
			padding: 0.08em 0.1em;
			font-size: 0.78rem;
			line-height: 1.2;
			text-align: center;
			/* ラウンド3 A-1: 努力値グリッドの数値入力もglobal.cssのmin-height:2.35remを
			   打ち消す(努力値/実数値グリッドの無駄18.6pxのうち大半を占める)。 */
			min-height: 0;
		}
		#opponent-notes-section .damage-stat-value {
			display: block;
			font-size: 0.76rem;
			line-height: 1.2;
			font-weight: 700;
			text-align: center;
			color: var(--color-text);
		}
		#opponent-notes-section .damage-stat-value[data-mod="up"] { color: var(--stat-up); }
		#opponent-notes-section .damage-stat-value[data-mod="down"] { color: var(--stat-down); }
		/* 条件チップ(A-6): 既定以外の詳細設定(天候・急所・壁など)が設定されているのに
		   カード上に何の表示も無いと「素のカードと数値だけ違う」ように見えてバグに見える。
		   ラウンド6ユーザー指示(要件8): 以前は相手ビルドの箱(努力値グリッド直下)に1個だけ
		   置いていたが、設計図で「技ごとにONにした条件をまとめて表示する」よう変わったため、
		   このクラス(スタイルはそのまま流用)を技列(.damage-column)側へ移し、技列1枚につき
		   1インスタンス生成する(renderColumns参照)。カード全体の設定(天候・フィールド・壁)は
		   全技列で同じ値なので重複表示になるが、これはユーザーの明示的な選択(要件8)。 */
		#opponent-notes-section .damage-row-condition-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem;
			margin-top: 0.1rem;
		}
		#opponent-notes-section .damage-row-condition-chips[hidden] { display: none; }
		#opponent-notes-section .damage-condition-chip {
			font-size: 0.66rem;
			padding: 0.1em 0.5em;
		}

		/* 相手ビルドの箱の最下段: 区切り線 + 「加算後のダメ・致死率」(全ての技列を順に当てた合計)。
		   margin-top:auto で箱の一番下に押し下げるため、途中に空きスペースがあっても
		   技列側の結果表示と下端が揃う(DamageCard.pngの点線+結果の並びに対応)。
		   結果表示はこの画面で最も重要な情報のため、フォントサイズ・太さを他より一段階上げる。 */
		#opponent-notes-section .damage-row-total {
			margin-top: auto;
			padding-top: 0.35rem;
			border-top: 1px dashed var(--color-border);
		}
		/* ラウンド3 A-2(c): チップ本文が「累計351〜414…」のようにラベルの内容を完全に
		   繰り返して書いているため冗長(高さの無駄15.1px)。要素は残し(JSは参照していないが
		   念のためDOM削除はしない)、視覚的にのみ隠す。 */
		#opponent-notes-section .damage-row-total-label {
			display: none;
			font-size: 0.66rem;
			font-weight: 700;
			line-height: 1.2;
			color: var(--color-text-muted);
			margin-bottom: 0.15rem;
		}
		/* ラウンド4の積み残し(ラウンド3 C-4「結果チップの主役化」): 判定(確N/乱N/未撃破等)を
		   大きく太字で左に、ダメージ量の詳細を小さく右に配置する(<script>のsetResultVerdict
		   参照)。3枚並べたときに結論だけを縦に読めるようにする。 */
		#opponent-notes-section .damage-row-total-result {
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: baseline;
			column-gap: 0.5em;
			margin: 0;
			font-size: 0.85rem;
			line-height: 1.3;
			padding: 0.3rem 0.45rem;
		}
		#opponent-notes-section .damage-row-total-result .damage-result-verdict {
			font-size: 1.05em;
			font-weight: 800;
		}
		#opponent-notes-section .damage-row-total-result .damage-result-detail {
			font-size: 0.82em;
			font-weight: 500;
			opacity: 0.85;
			text-align: right;
		}

		/* 「この相手を削除」はアイコンボタン化(要件)。名前行に同居させて専用の行を
		   持たせないことで、その1行分の高さをまるごと節約する(「⚙詳細」も同じ理由で
		   アイコンボタン化していたが、ラウンド6で廃止した)。
		   タップ対象は最低28px角を確保(要件)。
		   ラウンド12指摘(B-2): アイコンボタンが/box(24px円形)とこのページ(30px角形)で
		   2規格に分かれていた。統一先の28px・円形・shadow-smに合わせる(/box側は別エージェント
		   の担当範囲なのでこのページ側だけ変更する)。中身はtextContent="🗑"のみ(画像を隠す
		   ラッパー構造は無い)ため、border-radiusだけ足しても「隠しきれていない画像」が
		   露出する心配はない。 */
		#opponent-notes-section .damage-row-icon-button {
			flex-shrink: 0;
			width: 28px;
			height: 28px;
			padding: 0;
			font-size: 0.95rem;
			line-height: 1;
			border-radius: 50%;
			box-shadow: var(--shadow-sm);
		}

		/* 右: 技列(縦積み=加算ダメージ計算)。
		   ラウンド5では技列を横並び(横スクロール)にしていたが、ラウンド6ユーザー指示
		   (更新された設計図)で縦積みに作り直した。旧ラウンドの「横スクロールのために
		   コンテナの自動最小幅を潰す」min-width:0や、「列が少ないときに＋を最終列の
		   隣へ寄せる」max-width:max-content、はみ出し対策のoverflow-x:autoは、
		   縦積みでは主軸が「幅」から「高さ」に変わるため不要(付けたままだと横幅が
		   本来より狭く固定されたり、意味のないスクロール領域ができたりして有害)。
		   .damage-row-columns-wrap/.damage-add-column-slot自体のクラス名・要素は
		   このラウンドでも改名・削除していない(JS/E2E依存を壊さないため)。 */
		#opponent-notes-section .damage-row-techniques-row {
			flex: 1 1 0;
			/* ラウンド10: min-width:0 のままだと .damage-row-body の flex-wrap が
			   絶対に発動せず(flex-basis:0の項目は0まで潰れるため)、狭い幅で技列が
			   19pxに潰れる既存バグが直らない。折り返しのトリガーとして下限を与える。
			   flex-basis:0 は第3弾の「flex-wrap誤爆防止の安全策として変更不可」に従いそのまま。

			   140pxという値は「壊れている幅だけを折り返し、既存のデスクトップ挙動は
			   1pxも変えない」ように実測から逆算したもの。折り返しの閾値は
			   箱300 + gap9.6 + この値 なので:
			     140 → 449.6。390px(body 329)は折り返す / 1600px(459)・1280px(460)は
			     折り返さず従来どおり(技列149px・151px)。
			   150pxにすると1600pxと1280pxまで折り返してしまい、3カラム常設境界での
			   カード高さが変わる(=デスクトップの密度を無断で変える)ので採らない。
			   ※1600px/1280pxで技列が149〜151pxしかないのは別の既存課題として
			   計画書に記録済み(この修正の対象外)。 */
			min-width: 140px;
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
		}
		#opponent-notes-section .damage-row-columns-wrap {
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			min-width: 0;
		}
		/* 技列同士(.damage-column)は幅を揃える(align-items:stretchが既定=cross-axisの
		   幅いっぱいに広がる)。高さは各列の内容に応じて個別に決まる。 */
		#opponent-notes-section .damage-row-columns {
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			min-width: 0;
		}
		/* 「加算条件追加ボタン」(要件: 技列の下に置く)。技列の縦積みの最後に続くので、
		   技列と同じ横幅いっぱいに広がるブロックにする(横スクロール時代の
		   flex:0 0 auto/align-self:flex-startは幅を揃える横並びが前提だったため撤去)。 */
		#opponent-notes-section .damage-add-column-slot {
			display: flex;
			margin-top: auto;
		}
		/* UI品質改善(ラウンド8 A-2): 技列が上限(3つ)に達すると、破線ボタンが
		   disabled+opacity:0.4になり「技列は最大3つまでです」がコントラスト1.68:1で
		   ほぼ読めないまま48px居座っていた。上限時はスロットごとCSSで隠す(DOMは残す。
		   <script>のrenderColumns、addColumnSlot.dataset.max参照)。 */
		#opponent-notes-section .damage-add-column-slot[data-max="true"] {
			display: none;
		}
		/* 技名(「あんこくきょうだ」等の7〜8文字)が読み切れる幅を確保する。
		   ラウンド6ユーザー指示: 技列を縦積みにしたため、固定205px幅ではなく右カラム
		   (.damage-row-techniques-row)の残り幅いっぱいに広げる(横スクロールが無くなった分、
		   205px固定より遥かに広い実測290px前後を使えるようになり、可読性が上がる)。 */
		#opponent-notes-section .damage-column {
			width: 100%;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			/* UI品質改善(要件5・実測調整): 技列3枚(3枚ぶんの枠線・padding・gapが積み重なる)が
			   相手ビルドの箱1枚と高さを揃えられるよう、padding/gapを控えめに詰める
			   (実測: 詰める前は技列3枚+追加ボタンで箱よりおよそ85px高くなっていた)。 */
			padding: 0.3rem 0.5rem;
			/* 既定は縦積み(順序ラベルが自分の行を持つ)。技列が十分に広いときだけ
			   下の@containerでラベルを技名行と同じ行に載せる(ラウンド10ユーザー指示)。 */
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			/* UI品質改善(デザイン原則整合): .damage-row-buildと同じ理由でsurface-altから
			   surfaceに変更(外側の.card-damageがsurface-altになったため)。 */
			background: var(--color-surface);
			/* ラウンド6ユーザー指示(要件2): 技列をクリックするとこの技だけの設定に切り替わる。
			   選択中はカード全体の枠(.card-damage.is-selected)とは別に、この箱自体にも
			   primary枠を付けて「行全体ではなくこの技列が選択されている」ことを示す
			   (<script>のselectColumn/applySelectionMarks参照)。 */
			transition: border-color 0.15s, box-shadow 0.15s;
			/* ラウンド8指摘(B-4): クリックすると設定が開くことが画面から分からなかった
			   (ラウンド7積み残し)。cursor:pointerを明示する(.damage-row-buildの
			   cursor:defaultと対比させる)。 */
			cursor: pointer;
		}
		#opponent-notes-section .damage-column:hover {
			border-color: var(--color-primary);
		}
		#opponent-notes-section .damage-column.is-selected {
			border-color: var(--color-primary);
			box-shadow: 0 0 0 1px var(--color-primary);
		}
		/* is-selectedはbox-shadowも持つため、hoverだけの状態と区別が付く
		   (選択中の技列に重ねてhoverしても見た目が変わらない=誤って「選択が外れた」ように
		   見えることはない)。 */
		#opponent-notes-section .damage-column input[type="text"],
		#opponent-notes-section .damage-column input[type="number"] {
			width: 100%;
			min-width: 0;
			font-size: 0.88rem;
			padding: 0.28em 0.35em;
			line-height: 1.2;
			/* ラウンド3 A-1: 技列側の技名/ヒット数入力も同様にmin-heightを打ち消す。 */
			min-height: 0;
		}
		/* ラウンド3 B-3: 技列を横に連結する=加算という関係が伝わりにくかったため、
		   各列に「1発目」「2発目」…の順序キャプションを添える(<script>のrenderColumns参照)。 */
		#opponent-notes-section .damage-column-order-label {
			font-size: 0.68rem;
			font-weight: 600;
			color: var(--color-text-muted);
			line-height: 1.1;
			/* 「1発目」が折り返すと同行化の意味が無くなる(下の@container参照)。 */
			white-space: nowrap;
		}
		/* ラウンド3 B-4: 累計で既に撃破済みになった以降の列を視覚的に控えめにし、
		   「何発目で撃破済みか」を添える(数値自体は第3弾の「列は独立判定」の方針どおり変えない。
		   <script>のrenderColumnDisplays/computeConfirmedKillAttackCount参照)。 */
		#opponent-notes-section .damage-column.is-overkill {
			opacity: 0.55;
		}
		#opponent-notes-section .damage-column-overkill-note {
			margin: 0;
			font-size: 0.66rem;
			color: var(--color-text-muted);
		}
		#opponent-notes-section .damage-column-overkill-note[hidden] {
			display: none;
		}
		/* 技名inputと結果表示の間の領域(DamageCard.pngで空白になっている部分)。
		   図の注記どおり「計算の細かい条件」をこの列単位で置く場所(削除ボタンはラウンド3 B-2で
		   技名行へ移した)。ラウンド12指摘(B-3)で連続回数(.damage-column-hitcount-row)も
		   技名行(moveRow)側へ同居させたため、現時点でここに入るのは撃破済み注記のみ。
		   将来ここに条件が増えても結果表示は margin-top:auto で箱の下端に留まるので、
		   レイアウトを作り直す必要はない。 */
		#opponent-notes-section .damage-column-conditions {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
		/* 技名input + 削除ボタン(×)(⚙はラウンド6で廃止。技列自体のクリックが
		   この技の設定を開くトリガーになった)。
		   ラウンド3 B-2: 以前は×だけが技名直下の中空に取り残され、その下に200px以上の空白が
		   できていた(削除ボタンだけ.damage-column-conditions側にあったため)。
		   [技名][×]の1行にまとめる(<script>のrenderColumns参照。要素自体は改名していない)。 */
		/* ラウンド12指摘(B-3): ヒット回数(.damage-column-hitcount-row)をこの行の3人目の
		   子要素として同居させた(<script>のrenderColumns参照、moveRow.appendChild(hitRow))。
		   技名(1〜2文字目)+削除ボタン(×)+ヒット回数(2桁+「回ヒット」)が並ぶと、1600px/1280px
		   境界(.damage-columnが149〜151pxまで潰れる、ラウンド10で実測済みの既知の制約)では
		   1行に収まらない。flex-wrapで潰れたときだけヒット回数側を次の行へ折り返す
		   (技名inputの下のmin-widthで「無限に0まで縮む」のを止め、ここで折り返しを発生させる)。 */
		#opponent-notes-section .damage-column-move-row {
			display: flex;
			align-items: center;
			gap: 0.25rem;
			flex-wrap: wrap;
		}

		/* ラウンド10ユーザー指示「N発目と技を同行にすれば入る?」への対応。
		   順序ラベル(実測12px)が専用の1行を持っていたのを技名行と同じ行に載せる。
		   実測(1920px): 技列1つ 102px → 88px(-14px)、技列3つのカードが333px → 289px、
		   カード4枚のリストが1253px → 1210px。**結果チップには一切触らないので
		   ラウンド5の「結果チップの主役化」は無傷。**

		   ビューポート幅ではなく技列自身の幅で切り替える理由(実測):
		   .damage-row-build が全幅で300px固定なため、.damage-column の幅は
		   ビューポート幅に対して単調でない(1920px→448px / 1600px→149px /
		   1440px→311px / 1280px→151px / 390px→19px)。1600pxが最も狭くなるのは
		   3カラム(サイドバー常設)に切り替わる境界だから。メディアクエリで分岐すると
		   必ずどこかの幅で破綻するので、コンテナクエリで技列の実幅を見る。
		   240pxは「ラベル26px + gap + 技名inputに『ヘビーボンバー』(実測約85px)が
		   収まる」下限の実測値。

		   pitfalls.md「@containerは詳細度を上げない」に従い、
		   .damage-column / .damage-column-order-label / .damage-column-move-row の
		   基本定義より**後ろ**に置くこと(順序を入れ替えると何も起きなくなる)。 */
		#opponent-notes-section .damage-row-techniques-row {
			container-type: inline-size;
			/* ラウンド10: 参照先を名前で固定する(無名だと最近傍のコンテナに解決されるため、
			   将来このページにコンテナを増やしたときに黙って壊れる)。 */
			container-name: dmgtech;
		}
		@container dmgtech (min-width: 240px) {
			#opponent-notes-section .damage-column {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				column-gap: 0.4rem;
				row-gap: 0.15rem;
				align-items: center;
			}
			#opponent-notes-section .damage-column-order-label {
				grid-row: 1;
				grid-column: 1;
			}
			#opponent-notes-section .damage-column-move-row {
				grid-row: 1;
				grid-column: 2;
			}
			/* 順序ラベルと技名行以外(条件チップ・連続回数・撃破済み注記・結果チップ)は
			   全幅で下に積む。DOMの生成順は<script>のrenderColumns側に依存している。 */
			#opponent-notes-section .damage-column > :not(.damage-column-order-label):not(.damage-column-move-row) {
				grid-column: 1 / -1;
			}
		}
		#opponent-notes-section .damage-column-move-row input[type="text"] {
			flex: 1 1 0;
			/* ラウンド12指摘(B-3): min-width:0のままだとこのinputが際限なく0まで縮んで
			   ヒット回数側が絶対に折り返されない(flex-basis:0の項目は行の折り返し判定に
			   0として寄与するため)。技名が最低限読める幅(実測「みだれひっかき」相当)を
			   下限にして、それでも収まらない分はヒット回数側をflex-wrapで次行へ落とす。 */
			min-width: 3.4em;
		}
		#opponent-notes-section .damage-column-move-row .damage-column-remove-button {
			align-self: center;
			flex: 0 0 auto;
		}
		/* ラウンド12指摘(B-3): moveRowの子として同居するようになったヒット回数行。
		   内容(数値入力+単位ラベル)ぶんの幅で確保し、収まらないときは行ごと折り返す
		   (flex-shrinkを0にして中途半端に潰れないようにする)。 */
		#opponent-notes-section .damage-column-move-row .damage-column-hitcount-row {
			flex: 0 0 auto;
		}
		/* ラウンド6ユーザー指示(要件1): 歯車(⚙)ボタンを廃止した。技列の設定はこの技列
		   自体をクリックして開く(要件2)ため、.damage-column-detail-buttonという専用の
		   トリガー要素・data-modified装飾は不要になった(既定以外の設定が入っていることは
		   要件4の条件チップ表示で分かるため、別途「変更済み」の印は不要と判断)。 */
		#opponent-notes-section .damage-column-hitcount-row {
			display: flex;
			align-items: center;
			gap: 0.3rem;
		}
		/* 連続技でないときはヒット数入力を出さない(要件)。display:flexを指定している要素は
		   ブラウザ既定の [hidden] { display: none } に勝ってしまうため、明示的に打ち消す。 */
		#opponent-notes-section .damage-column-hitcount-row[hidden] {
			display: none;
		}
		#opponent-notes-section .damage-column-hitcount-row input[type="number"] {
			width: 3.6em;
			flex: 0 0 auto;
		}
		#opponent-notes-section .damage-column-hitcount-unit {
			font-size: 0.76rem;
			color: var(--color-text-muted);
		}
		/* 技列の最下段: 区切り線 + 「技ごとのダメ・致死率」。相手ビルドの箱の
		   .damage-row-total と同じ作り(margin-top:auto + 上罫線)にして下端を揃える。
		   結果表示は最重要情報のため.damage-row-total-resultと同じサイズまで底上げする。 */
		#opponent-notes-section .damage-column-footer {
			margin-top: auto;
			/* UI品質改善(要件5・実測調整): 技列3枚を積んだときの合計高さを箱に近づけるため詰めた。 */
			padding-top: 0.28rem;
			border-top: 1px dashed var(--color-border);
		}
		/* ラウンド4の積み残し(ラウンド3 C-4): 判定を大きく太字・詳細を小さく添える。
		   ラウンド11ユーザー指示(要件11-5)により、縦2段(column)を撤回して行
		   (.damage-row-total-result)と同じ横並び1段(row)に変更し、縦サイズを圧縮する
		   (太字強調という主役化の趣旨自体は維持。<script>のsetResultVerdict参照。
		   DOM構造は.damage-row-total-resultと共通)。長い数値
		   (例:「254〜299 (165〜195%)」)がrow化ではみ出さないよう、detail側にmin-width:0+
		   overflow-wrap:anywhereを付け、極端に幅が無いときだけflex-wrapで2段に逃がす
		   (通常幅では1段のまま。実測結果はui_plan.md参照)。 */
		#opponent-notes-section .damage-column-result {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: baseline;
			column-gap: 0.5em;
			row-gap: 0;
			margin: 0;
			font-size: 0.82rem;
			line-height: 1.3;
			padding: 0.22rem 0.4rem;
		}
		#opponent-notes-section .damage-column-result .damage-result-verdict {
			font-size: 1.05em;
			font-weight: 800;
			flex: 0 0 auto;
		}
		#opponent-notes-section .damage-column-result .damage-result-detail {
			font-size: 0.8em;
			font-weight: 500;
			opacity: 0.85;
			min-width: 0;
			overflow-wrap: anywhere;
		}
		#opponent-notes-section .damage-column-remove-button {
			align-self: flex-end;
			font-size: 0.78rem;
			padding: 0.18em 0.45em;
		}
		/* ラウンド6ユーザー指示(要件5): 技列が縦積みになったので、この「加算条件追加ボタン」も
		   技列と同じ横幅いっぱいに広がる横長バーにする(以前は横スクロール領域の隣に立てる
		   縦長の細い帯で、min-height:5.5emの明示指定が必要だったが、縦積みでは技列の下に
		   続くだけなので不要=撤去)。3つに達すると無効化するだけでなく、ラベル文言自体を
		   理由の説明に差し替える(<script>のrenderColumns参照。無効化理由をホバー頼みの
		   titleだけにしない)。 */
		#opponent-notes-section .damage-add-column-button {
			width: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.35em;
			/* UI品質改善(ラウンド8 A-3): 技列3枚と高さを揃えるため48px→約34pxに圧縮する。
			   フォントを下げるのはこのボタン1個だけ(数値・技名・入力欄には触れない)。 */
			padding: 0.28em 0.6em;
			font-size: 0.78rem;
			font-weight: 600;
			border: 1px dashed var(--color-border);
			background: var(--color-surface-alt);
			color: var(--color-text-muted);
			border-radius: var(--radius-md);
			transition: background 0.15s, color 0.15s, border-color 0.15s;
		}
		#opponent-notes-section .damage-add-column-button:hover:not(:disabled) {
			border-color: var(--color-primary);
			border-style: solid;
			color: var(--color-primary);
			background: var(--color-primary-soft);
		}
		#opponent-notes-section .damage-add-column-button:disabled {
			opacity: 0.4;
		}

		/* メモ欄を廃止して保存状態だけになったので、右寄せの細い1行にする。 */
		#opponent-notes-section .damage-row-footer {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 0.4rem;
			margin-top: 0.2rem;
			padding-top: 0.2rem;
			border-top: 1px solid var(--color-border);
			flex-wrap: wrap;
		}
		/* ラウンド3 A-4: display:flexを指定している要素はブラウザ既定の[hidden]{display:none}に
		   詳細度で勝ってしまうため(.damage-column-hitcount-row[hidden]と同じ理由、実測で発覚)、
		   明示的に打ち消す。これを付け忘れるとfooter.hidden=trueにしても実際には隠れず、
		   保存済みカードでも22px前後が消えないままになる。 */
		#opponent-notes-section .damage-row-footer[hidden] {
			display: none;
		}
		/* .damage-row-save-status は<p>要素(ブラウザ既定でmargin:1em 0が付く)。
		   このmarginを消し忘れると、footerがdisplay:flex; align-items:centerであっても
		   marginぶんだけ行の高さが押し上げられてしまう(実測で発覚)。 */
		#opponent-notes-section .damage-row-save-status {
			flex: 0 0 auto;
			font-size: 0.78rem;
			margin: 0;
			line-height: 1.2;
		}
		#opponent-notes-section .damage-row-retry-button {
			display: none;
			font-size: 0.76rem;
			padding: 0.2em 0.5em;
		}
		#opponent-notes-section .damage-row-retry-button.visible {
			display: inline-flex;
		}

		/* ラウンド5ユーザー指示(要件9): ⚙クリックで開いていた<dialog>を廃止し、右サイドバー
		   (#damage-detail-panel、静的マークアップ)の中身をJSが差し替える方式にした。
		   #damage-detail-panel-bodyの中身自体はJSがdocument.createElement()で生成するため、
		   このセクションのスタイルはis:globalブロックに置く(動的生成要素にscoped<style>は
		   効かないため。#opponent-notes-section配下の他の要素と同じ理屈)。 */
		#damage-detail-panel-body .damage-detail-row-heading {
			margin: 0 0 0.2rem;
			font-size: 0.95rem;
			font-weight: 700;
		}
		/* ラウンド3 A-6由来: この行のすべての技列に共通で適用される旨を見出し直下に添える。
		   ラウンド11ユーザー指示(省スペース化)で下マージンを詰めた(0.9rem→0.6rem)。
		   ラウンド12指摘(B-1): 「この技列だけに適用されます。」が見出し「技N(技名)の設定」の
		   言い換えでしかなく重複していた。文言変更とセットで対応: 見出し側を
		   「技N(技名)だけの設定」に畳んで「他の技列には効かない」という非自明な情報を
		   見出し1つで担保し、この説明文はDOM(<script>のrenderColumnLevelDetailPanel)は
		   残したままCSSで非表示にする(このプロジェクトの「消す指示でもDOMは残す」方針)。 */
		#damage-detail-panel-body .damage-detail-subtitle {
			display: none;
			margin: 0.1rem 0 0.6rem;
			font-size: 0.8rem;
			color: var(--color-text-muted);
		}
		/* ラウンド11ユーザー指示(省スペース化、opus助言の要点): 縦圧縮の主因だった
		   margin: 1rem 0 0.4rem を詰める(1rem→0.6rem)。攻撃側/防御側の見出しは
		   .damage-detail-side-heading-row 側で margin:0 に上書きされるため(下記)、
		   ここで効くのは「場の設定」見出し単体のみ。 */
		#damage-detail-panel-body .damage-detail-section-heading {
			font-size: 0.85rem;
			font-weight: 700;
			color: var(--color-text-muted);
			margin: 0.6rem 0 0.3rem;
		}
		#damage-detail-panel-body .damage-detail-section-heading:first-of-type {
			margin-top: 0;
		}
		/* ラウンド11ユーザー指示(要件11-7・省スペース化): 「見出し+能力ランク」を1行に収める
		   (buildSideSection参照)。内側の見出しpは行自体がmargin/gapを持つのでmargin:0にする。 */
		#damage-detail-panel-body .damage-detail-side-heading-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.6rem;
			margin: 0.6rem 0 0.35rem;
		}
		#damage-detail-panel-body .damage-detail-side-heading-row:first-of-type {
			margin-top: 0;
		}
		#damage-detail-panel-body .damage-detail-side-heading-row .damage-detail-section-heading {
			margin: 0;
		}
		/* ラウンド5ユーザー指示(要件10): 天候・フィールドはセレクトをやめてアイコン選択式にする。
		   選択中は塗りつぶし+primary枠で明示する(1つだけ選べるトグルグループ、常に「なし」も
		   選択肢の1つとして並べる)。 */
		/* UI品質改善(ラウンド8 B-2): flex-wrapだと4.4em(≈47.9px)固定幅の8個(天候)が
		   利用幅約320pxに収まらず6+2の不格好な2行に割れ、「すなあらし」等5字ラベルが
		   さらに折り返して2行になっていた。4列グリッドに変え、幅を枠(minmax(0,1fr))任せに
		   することで天候8個が4×2、フィールド5個が4+1で並ぶ(width:4.4emは削除)。
		   margin-bottomは省スペース化のため0.9rem→0.5remに詰めた。
		   ラウンド11では状態異常もこの4列既定を使っていたが、「11-8の修正」ユーザー指示で
		   状態異常はnative <select>(.damage-detail-ailment-select、下記)に戻したため、
		   このicon-group基底クラスは現在は天候/フィールド(常にis-row5併用)専用になっている。 */
		#damage-detail-panel-body .damage-detail-icon-group {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0.35rem;
			margin-bottom: 0.5rem;
		}
		/* ラウンド11ユーザー指示(要件11-9): 強天候3種を削除した結果、天候(なし+4)・
		   フィールド(なし+4)がどちらも5択になったため、「場の設定」内では5列グリッドにして
		   1行に収める(renderColumnLevelDetailPanel参照)。 */
		#damage-detail-panel-body .damage-detail-icon-group.is-row5 {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			margin-bottom: 0;
		}
		#damage-detail-panel-body .damage-detail-icon-btn {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.2rem;
			padding: 0.35em 0.15em;
			font-size: 0.66rem;
			color: var(--color-text-muted);
			background: var(--color-surface-alt);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			cursor: pointer;
		}
		#damage-detail-panel-body .damage-detail-icon-btn:hover {
			border-color: var(--color-primary);
			color: var(--color-primary);
		}
		#damage-detail-panel-body .damage-detail-icon-btn:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		#damage-detail-panel-body .damage-detail-icon-btn[aria-pressed="true"] {
			border-color: var(--color-primary);
			background: var(--color-primary-soft);
			color: var(--color-primary);
