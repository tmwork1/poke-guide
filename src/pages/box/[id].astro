---
// Phase C-3: 個体の編集フォーム (育成データ管理計画.md §6.2, §8 Phase C-3)。
// デバウンス付き即時自動保存 + 楽観的UI更新: 入力のたびに数百ms待ってから
// PUT /api/owned-pokemon/:id を呼ぶ。保存中も入力をブロックしない。失敗時のみエラー表示する。
//
// 初期表示データの取得は API 経由の fetch ではなく、Astro のフロントマター(SSR)で
// src/lib/owned-pokemon.ts の getOwnedPokemon() を直接呼び出す(box/index.astro の一覧取得のような
// クライアント側fetchより初期表示が速く、かつ「生のSupabaseクエリはowned-pokemon.tsに集約する」
// という設計原則にも合致する)。
//
// 未ログイン時、および他人の個体/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(Phase A-3の方針を踏襲)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import LeftPanel from '../../components/box-id/LeftPanel.astro';
import DamageCalcSection from '../../components/box-id/DamageCalcSection.astro';
import RightPanel from '../../components/box-id/RightPanel.astro';
import BulkAdjustDialog from '../../components/box-id/BulkAdjustDialog.astro';
import SpeedAdjustDialog from '../../components/box-id/SpeedAdjustDialog.astro';
import MobileTrainingBar from '../../components/box-id/MobileTrainingBar.astro';
import '../../styles/box-edit-page.css';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { getOwnedPokemon, type OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { isValidUuid } from '../api/_shared';

const user = Astro.locals.user;
const id = Astro.params.id;

let pokemon: OwnedPokemonRecord | null = null;
let loadError = false;

if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getOwnedPokemon(user.id, id, supabase);
	if (result.ok) {
		pokemon = result.data;
	} else {
		loadError = true;
	}
	if (!pokemon && !loadError) {
		Astro.response.status = 404;
	}
}

// 防御時の技候補を相手の技の使用率順に表示するため、suggestionsテーブル
// (kind='popular_move')の全種族分を1クエリでまとめて取得し、DamageCalcSection.astroへ
// 埋め込みJSONとして渡す(speed-chart/index.astroの採用率データ取得と同じ考え方を踏襲するが、
// 既存の関数・型は再利用せずbox-id向けに新規記述する)。
// subject_keyは「種族名」(全レギュレーション横断、regulationKey="all")または
// 「種族名|レギュレーション」(区切り文字"|")の形。クエリが失敗しても500にせず空オブジェクトに
// フォールバックする(speed-chart/index.astroのtry/catchパターンを参考)。pokemonが取得できた
// 場合(=このページを実際に表示する場合)に限り実行する。
type MoveAdoptionBySpecies = Record<string, Record<string, Record<string, number>>>;
let moveAdoptionBySpecies: MoveAdoptionBySpecies = {};
if (pokemon) {
	try {
		const adoptionClient = await getSupabaseAdminClient();
		const { data, error } = await adoptionClient
			.from('suggestions')
			.select('subject_key, payload')
			.eq('kind', 'popular_move');
		if (error) {
			// eslint-disable-next-line no-console
			console.error('[box/[id]] failed to load move adoption data', error);
		} else if (data) {
			for (const row of data as Array<{
				subject_key: string;
				payload: { options?: Array<{ value: string; ratio: number }> } | null;
			}>) {
				if (!row.payload || !Array.isArray(row.payload.options)) continue;
				const sep = row.subject_key.indexOf('|');
				const species = sep === -1 ? row.subject_key : row.subject_key.slice(0, sep);
				const regulationKey = sep === -1 ? 'all' : row.subject_key.slice(sep + 1);
				const bySpecies = (moveAdoptionBySpecies[species] ??= {});
				bySpecies[regulationKey] = Object.fromEntries(row.payload.options.map((o) => [o.value, o.ratio]));
			}
		}
	} catch (err) {
		// eslint-disable-next-line no-console
		console.error('[box/[id]] failed to load move adoption data', err);
	}
}

interface CombinedSpeciesUsageRow {
	regulation: string;
	species_key: string;
	pokemon: number;
}

const speciesUsageByRegulation: Record<string, Record<string, number>> = {};
if (pokemon) {
	try {
		const usageClient = await getSupabasePublicClient();
		const PAGE_SIZE = 1000;
		const usageRows: CombinedSpeciesUsageRow[] = [];
		const first = await usageClient
			.rpc('combined_species_usage', {}, { count: 'exact' })
			.range(0, PAGE_SIZE - 1);
		if (first.error) throw first.error;
		usageRows.push(...((first.data ?? []) as CombinedSpeciesUsageRow[]));
		const total = first.count ?? usageRows.length;

		if (total > PAGE_SIZE) {
			const pageStarts: number[] = [];
			for (let from = PAGE_SIZE; from < total; from += PAGE_SIZE) pageStarts.push(from);
			const pages = await Promise.all(
				pageStarts.map((from) =>
					usageClient.rpc('combined_species_usage', {}).range(from, from + PAGE_SIZE - 1),
				),
			);
			for (const page of pages) {
				if (page.error) throw page.error;
				usageRows.push(...((page.data ?? []) as CombinedSpeciesUsageRow[]));
			}
		}

		for (const row of usageRows) {
			const bucket = (speciesUsageByRegulation[row.regulation] ??= {});
			bucket[row.species_key] = row.pokemon;
		}
	} catch (err) {
		// eslint-disable-next-line no-console
		console.error('[box/[id]] failed to load species usage data', err);
	}
}

// UI刷新(第4弾): 性格の選択UI(<select>)は要件により廃止した。性格はステータス補正にしか
// 影響しないため、能力値ラベルのクリックで上昇/下降(HP以外)を選び、性格名は<script>側で
// 逆算するだけにする(保存データには従来どおり性格名を入れる)。そのため NATURES(性格名の
// 選択肢一覧)はもうフロントマターで使わない。対応表(NATURE_STAT_MODIFIERS)は<script>側に
// 定義しており、vendor/jpoke/src/jpoke/data/nature.py の NATURE_MODIFIER と一致させている。

// TERA_TYPES(19タイプの選択肢一覧)は src/lib/tera-types.ts へ切り出し済み(左パネル用<script>と
// #opponent-notes-section用<script>にも同じ配列が複製されていたため、3箇所重複を解消した)。
// 値・順序は不変。

// UI刷新(ダメージ計算カード化): 天候/地形/相手側の壁/状態異常の選択肢は、行(対戦相手)ごとに
// JSで動的生成するカードの中で使うため、Astroフロントマター側では定義せず、ブラウザ専用<script>内に
// 同じ選択肢を直接持たせている(下記<script>のDAMAGE_WEATHERS等を参照。フロントマターの値は
// ブラウザ側の<script>から参照できないため。src/pages/damage-calc/index.astro のWEATHERS/TERRAINS/
// SIDE_FIELDSと同じ選択肢で同期させること)。

// STAT_LABELS/MOVE_SLOTS/statAt は左パネル専用のためLeftPanel.astroへ移設した
// (構造分割ラウンド、フェーズ1)。

// pageTitleはAppLayoutのtitleプロパティに渡され、(a) <title>タグ(ブラウザタブ)と
// (b) トップバー左のテキスト表示、両方に使われる。ページ読み込み直後に<script>の
// updateHeaderIdentity()が.app-topbar-titleを接尾辞なしの文字列で上書きするため、
// <title>用の文字列とpageTitleを別の値にすると、表示直後に見出しが一瞬で
// 別の文字列に変わって見えてしまう(実機で確認)。接尾辞なしの名前で統一する
// (ブラウザタブは「◯◯ | Poke-Commons」になる)。
// ヘッダー表示は種族名固定でニックネームを見ない(nickname || species_nameにはしない)。
// ニックネーム入力欄自体(左パネルの#nickname)は残す(保存対象としても変更なし)。
// updateHeaderIdentity側(<script>)も同じ理由でニックネームを見ないよう揃えている
// (そうしないとページ読み込み直後にJSがニックネーム入りの文字列で上書きしてしまうため)。
const pageTitle = pokemon ? pokemon.species_name : "個体編集";
// <title>タグ(ブラウザタブ・履歴での個体識別に必要)には種族名を残しつつ、トップバーの
// 可視の見出しからは種族名を消す。AppLayoutのtitleプロパティは<title>と.app-topbar-title
// の両方を兼ねており、AppLayout自体は編集禁止(全ページに影響するため)。AppLayoutが
// 既に持っているbodyClass propを使い、body要素にこのページだけのクラスを付け、その配下の
// .app-topbar-titleをこのページのCSSだけで非表示にする(AppLayout.astroのマークアップ・
// propは一切変更しない)。
// pokemonがnull(個体が見つからない)のときはpageTitleが種族名ではなく固定文言「個体編集」
// (エラー状態の案内)なので、そちらは隠さない(bodyClassをpokemon存在時だけ付与する)。
const bodyClass = pokemon ? "box-edit-page" : undefined;
const fromTeam = Astro.url.searchParams.get('fromTeam');
const backHref = isValidUuid(fromTeam) ? `/team/${encodeURIComponent(fromTeam)}` : '/box';

// 匿名集計サジェスト機能・第4段階(UI: 収集拒否トグル)。owned_pokemon.collection_opt_out_until
// (null=収集対象、未来日時=拒否期間中)から、SSR時点での「拒否中かどうか」と「残り日数」を
// 算出する。過去日時(期限切れ)はnullと同じ扱い(=収集対象。拒否中の表示は出さない)にする。
// このロジックは<script>側(src/lib/box-id/left-panel.ts)のPATCH成功時レスポンス反映でも
// 同じ計算式(ミリ秒差をceilして日数化)を使うので、変更する場合は両方揃えること。
function formatOptOutRemaining(until: string | null | undefined): string {
	if (!until) return "";
	const untilMs = new Date(until).getTime();
	const diffMs = untilMs - Date.now();
	if (diffMs <= 0) return "";
	const days = Math.ceil(diffMs / (24 * 60 * 60 * 1000));
	return `あと${days}日`;
}
const optOutRemainingText = pokemon ? formatOptOutRemaining(pokemon.collection_opt_out_until) : "";
const isOptedOut = optOutRemainingText !== "";
---
<AppLayout title={pageTitle} current="box" backHref={backHref} bodyClass={bodyClass}>
	{/* .page-header(戻る/保存状態/ポケモン名/削除ボタン)相当のUIはAppLayoutのbackHref/title/
	    topbar-status/topbar-actionsへ委譲する。保存状態(#autosave-status等)と削除ボタン
	    (#delete-button)は<script>のel()がid参照する(見つからないとel()がthrowし、フォーム
	    全体のJSが初期化できなくなる)ため、id/classは変えずスロットへそのまま置く。
	    ポケモン名の見出しはtitleプロパティ(pageTitle、上のフロントマターで算出済み。pokemonが
	    nullなら固定文言「個体編集」)に委譲する。ニックネーム/種族名入力への追随
	    (updateHeaderIdentity)は、idを持たないAppLayout側の.app-topbar-titleをquerySelectorで
	    直接更新する(<script>参照)。
	    .app-topbar-title自体はAppLayout側の要素なのでこのページのscoped<style>では選択できない
	    (scoped styleはdata-astro-cid-*がこのファイル由来の要素にしか効かない)。bodyClass=
	    "box-edit-page"を付け、下の<style is:global>側で`body.box-edit-page .app-topbar-title`
	    として非表示にする。 */}
	{pokemon && (
		<Fragment slot="topbar-status">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span><button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>
			{/* ダメージ計算カードは行ごとに独立して自動保存されるため、画面外にスクロールした
			    カードの保存失敗はカード自身のfooter(保存失敗時のみ表示)を見ないと気づけない。
			    常時可視なスティッキー上部バー(AppLayoutのtopbar、このスロットの中)に失敗件数だけを
			    出す(<script>のupdateOpponentNotesFailureAlert参照)。通常時はhiddenで何も見えない。 */}
			<span id="opponent-notes-save-alert" class="opponent-notes-save-alert" hidden></span>
		</Fragment>
	)}
	{pokemon && (
		<Fragment slot="topbar-actions">
			{/* damage-collapse-toggle-button(単一トグルボタン、交互切り替えのロジックはsrc/lib/box-id/
			    damage-calc.ts側にある。elはgetElementById経由のためDOM上の位置に依存しない)を
			    このFragmentに置く。見た目の位置(X座標)はCSS側(src/components/box-id/
			    DamageCalcSection.astro の damage-collapse-toggle-button ルール、is:globalのため
			    置き場所を問わず効く)でposition:fixedにより固定している。 */}
			{/* アイコンはインラインSVGのゴミ箱(絵文字🗑はOS/フォントで見た目が変わるため
			    定番デザインに向かない)。誤操作の抑止は色を抑える代わりに既存のwindow.confirm()
			    (<script>のdeleteButtonクリックハンドラ)に委ねる。 */}
			{/* 左端にchevron(既存の個別カード折りたたみボタンと同じ»グリフ)を置き、状態
			    (折りたたみ中/展開中)に応じて回転させる(CSSはDamageCalcSection.astro の
			    #damage-collapse-toggle-button .damage-collapse-toggle-chevron参照)。
			    labelはdamage-calc.tsのupdateCollapseToggleButtonLabel()がテキストを差し替える
			    対象なのでspanで囲む(ボタン全体のtextContentを差し替えるとchevronごと消えてしまうため)。
			    aria-expanded初期値はJS初期化直後にupdateCollapseToggleButtonLabel()が必ず
			    上書きするため、静的マークアップ上の値はプレースホルダーでよい。 */}
			<button id="damage-collapse-toggle-button" class="btn-ghost" type="button" disabled aria-expanded="false">
				<span class="damage-collapse-toggle-chevron" aria-hidden="true">»</span><span class="damage-collapse-toggle-label">すべて折りたたむ</span>
			</button>
			{/* 匿名集計サジェスト機能・第4段階(UI: 収集拒否トグル)。この個体を性格/アイテム/
			    テラス/技の匿名集計対象から除外するトグル。マークアップは
			    src/components/box-id/LeftPanel.astro の is:global <style> に既にある
			    .toggle-switch一式(.toggle-switch-input/.toggle-switch-track/.toggle-switch-thumb、
			    実際の使用例は src/lib/box-id/left-panel.ts の setupMovePickerWindow が動的生成する
			    マークアップ)をそのまま流用する(is:globalのためコンポーネント境界をまたいで効く。
			    CSSの重複定義はしない)。
			    checked=true は「非公開」(=収集拒否、isOptedOut)を表す。DBの意味
			    (owned_pokemon.collection_opt_out_until: NULLまたは過去=収集対象、未来=拒否期間中)
			    とcheckedの向きが一致しないため、送信側(left-panel.ts)はcheckedの値をそのまま
			    collection_opt_outとして送る(否定しない)。
			    ホバーテキストはOFF/ONで変える(下の<script>参照、初期値はSSRで出し分け済み)。
			    状態テキスト(#collection-opt-out-status)は「残り日数」表示ではなくPATCH失敗時の
			    エラーメッセージ専用(left-panel.ts側で実装済み)。 */}
			<label
				id="collection-opt-out-label"
				class="collection-opt-out-toggle"
				for="collection-opt-out-toggle"
				title="30日間有効"
			>
				<span class="toggle-switch">
					<input id="collection-opt-out-toggle" type="checkbox" class="toggle-switch-input" checked={isOptedOut} aria-label="非公開" />
					<span class="toggle-switch-track" aria-hidden="true">
						<span class="toggle-switch-thumb"></span>
					</span>
				</span>
				<span class="collection-opt-out-toggle-label">非公開</span>
				<span id="collection-opt-out-status" class="collection-opt-out-status" hidden></span>
			</label>
			<button id="delete-button" class="btn-danger" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				削除
			</button>
		</Fragment>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button { display: none; margin-left: 0.4em; }
		#retry-button.visible { display: inline-flex; }
		/* #autosave-statusは<p>要素で、global.cssに全要素共通のmarginリセットが無いため
		   既定のUAスタイル(1em 0)が残る。AppLayoutのトップバーは高さがCSS変数--topbar-height
		   (固定値、デスクトップ65px)前提で.edit-shell/.damage-detail-panelの高さ計算に
		   使われるため、<p>の既定marginぶん(実測で往復約16px)だけトップバーの実高さが
		   --topbar-heightからずれ、ページ全体に余計な縦スクロールが出る(実測で発覚)。
		   marginを0にしてトップバーの実測高さを--topbar-heightに一致させる。 */
		#autosave-status { margin: 0; }
		/* ヘッダーには通常「保存済み」等の保存状態テキストを表示しない。#autosave-status/
		   #autosave-status-textはid/DOMごと残す(<script>のel("autosave-status")/
		   el("autosave-status-text")が参照しており、要素そのものを削除するとel()がthrowして
		   フォーム全体のJS初期化が止まるため)。テキスト(span)だけをCSSで常時非表示にし、
		   コンテナ(#autosave-status)自体は残す。コンテナごと非表示にすると子要素の
		   #retry-buttonも道連れで描画されなくなり、保存失敗時の唯一のリカバリ手段
		   (クリックでの再試行)に気づく手段が完全に無くなってしまうため、#retry-button自身の
		   表示/非表示は既存どおり.visibleクラス(保存失敗時にJSが付与)に委ねる=失敗時だけ
		   「再試行」ボタンが単独で現れる形にした(通常時は何も見えない)。
		   ただし保存失敗時(data-state="error")だけはテキストも見せる: 「常時非表示」のままだと
		   #retry-buttonが唐突に現れるだけで理由(「保存に失敗しました。」)が画面から分からない
		   (このページは保存ボタンが無く自動保存に全面依存し、過去に個体データが書き換わる
		   事故も起きている場所のため、失敗理由を隠したままにする割に合わない)。 */
		#autosave-status-text { display: none; }
		#autosave-status[data-state="error"] #autosave-status-text {
			display: inline;
			color: var(--color-danger);
		}
		/* 共通トップバーの戻るリンク(.app-topbar-back)と文字組みを揃える。
		   font-familyとletter-spacingは、戻るリンクと同様にbodyからの継承値を使う。 */
		#delete-button { font-size: var(--font-size-sm1); }
		/* 幅390pxで折り返し先が無くwhite-space:normalのまま1文字ずつ縦に折り返り
		   (実測46×169px)、w900でも3行に折れていた。1行に固定する。 */
		#delete-button { white-space: nowrap; }
		/* 基底(global.css の button.btn-danger)の太字を、戻るリンクと同じ500に上書きする。 */
		#delete-button { font-weight: 500; }
		/* 基底(global.css の button.btn-danger)は 平常時=塗り
		   (background:var(--color-danger-strong), color:var(--color-primary-contrast))、
		   hover時=白地反転(background:var(--color-surface), color:var(--color-danger-strong))。
		   このページの#delete-buttonだけ逆にする(#delete-buttonはIDセレクタでbutton.btn-danger
		   (要素+クラス)より詳細度が高いため、global.css自体は変更せずに上書きできる。
		   他画面(/team/[id]等)が使う.btn-danger の既定配色はそのまま維持する)。
		   border(2px solid var(--color-danger-strong))は基底のまま変えない。
		   ⚠️ backgroundとcolorは平常時・hover時の両方で必ずセットで書く(片方だけ上書きすると
		   文字色=背景色になって見えなくなる事故があるため)。 */
		#delete-button {
			background: var(--color-surface);
			color: var(--color-danger-strong);
		}
		#delete-button:hover:not(:disabled) {
			background: var(--color-danger-strong);
			color: var(--color-primary-contrast);
		}
		/* 匿名集計サジェスト機能・第4段階(UI: 収集拒否トグル)。.toggle-switch本体のCSSは
		   src/components/box-id/LeftPanel.astro の is:global <style> 側に既にあるためここでは
		   重複定義しない。ここはラベル・状態テキストのレイアウトだけを追加する。
		   戻るリンク(.app-topbar-back)と同じfont-size/font-weightを明示する。
		   font-familyとletter-spacingは、戻るリンクと同様にbodyからの継承値を使う。
		   トーンは#damage-collapse-toggle-button(.btn-ghost)に揃え、既定でmuted、常時色付きの
		   目立つ表示にはしない。 */
		.collection-opt-out-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			font-size: var(--font-size-sm1);
			font-weight: 500;
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
		}
		/* font-familyとletter-spacingは明示せず、戻るボタンと同様にbodyから継承する。 */
		button#damage-collapse-toggle-button {
			font-size: var(--font-size-sm1);
			font-weight: 500;
		}
		button#damage-collapse-toggle-button:hover:not(:disabled) {
			background: transparent;
			color: var(--color-primary);
		}
		.collection-opt-out-toggle:hover:not(:has(.toggle-switch-input:disabled)) {
			color: var(--color-primary);
		}
		.collection-opt-out-status {
			color: var(--color-text-muted);
		}
		.collection-opt-out-status[hidden] { display: none; }
		/* .app-topbar-actions(AppLayout.astro側)のgapはvar(--space-2)=8pxでトップバー全
		   ボタン共通のため、AppLayoutは編集せず(全画面に影響する)、このページscopedで
		   #delete-buttonにだけ追加のmargin-leftを足す。トグル右端から削除ボタン左端まで
		   28px(8+var(--space-5)=20px)になる(新規の値は作らず、既存スペーシングトークンの
		   範囲内で選定)。 */
		#delete-button { margin-left: var(--space-5); }
		/* PATCH失敗時のみ(<script>側がdata-state="error"を付与)最小限のエラー色を出す。
		   #autosave-status[data-state="error"] #autosave-status-text と同じ温度感(赤字テキストの
		   み、追加のUI装飾なし)。 */
		.collection-opt-out-status[data-state="error"] {
			color: var(--color-danger);
		}
		/* ダメージ計算カード(#opponent-notes-section)は行(相手)ごとに独立して自動保存
		   されるため、カード自身のfooter(失敗時のみ表示)は画面外へスクロールすると
		   見えなくなる。AppLayoutのトップバーはposition:stickyで常時可視なのでここに
		   失敗件数だけを出す(<script>のupdateOpponentNotesFailureAlert参照)。
		   .app-topbar-status(親のspan)がwhite-space:nowrapの1行構成のため、<p>ではなく
		   同じ<span>系で追加し、ブロック化してトップバーの実高さ(--topbar-height)を
		   広げないようにする(#autosave-statusの<p>まわりのコメント参照)。 */
		.opponent-notes-save-alert {
			display: inline;
			margin-left: 0.6em;
			color: var(--color-danger);
			font-weight: 700;
		}
		.opponent-notes-save-alert[hidden] { display: none; }

		/* ダメージ計算カード化(UI刷新): 右カラム(#opponent-notes-section)の内容は
		   「対戦相手メモ」から「ダメージ計算」カードに全面刷新した。行・列・詳細設定ダイアログは
		   すべて<script>がdocument.createElement()で動的生成するため、この節にスタイルは置かず、
		   下の<style is:global>側に #opponent-notes-section 限定のセレクタとしてまとめて定義する
		   (scoped <style> は data-astro-cid-* が付かない動的生成要素には効かないため。要件参照)。 */

		/* UI刷新: 左右2カラムレイアウト(docs/plan/ui_plan.md)。
		   編集フォーム(左・固定幅)とダメージ計算カード(右・可変幅)を左右に並べる。
		   1200px未満では2カラムにしない: 左の編集フォームは能力値行(種族値+スライダー+
		   入力欄+実数値)の都合で最小幅が実測736px前後あり、grid-template-columnsの
		   minmax(320px, 480px) は「コンテンツの最小幅が上限を超える場合はそちらが勝つ」ため、
		   1024px幅では左トラックが736pxまで膨らんで右カラムが226pxに潰れ、ダメージ計算カードが
		   ページごと横スクロールしていた(実測で発覚)。2カラムにするだけの幅が無い環境では
		   縦積みにする方が破綻しない。
		   モバイル/中間幅では通常のブロック要素として上から下へ縦積みになる
		   (グリッド自体を適用しないため、追加のメディアクエリなしで縦積みに戻る)。 */
		.edit-layout-left, .edit-layout-right { min-width: 0; }
		/* UI品質改善(帯構成への刷新): .page-wide の max-width 上書きは「浮いた囲み箱を中央寄せ
		   する」設計の名残で、帯(.panel系)が画面端まで伸びる設計とは相容れないため撤廃した。
		   左右カラムは.panel-left/.panel-right(画面端固定の帯)になった一方、中央カラムの
		   ダメージ計算カード(.card-damage)自体は「浮いた箱」のまま変えない。ただし.pageの
		   左右paddingが消えたことで、カードが左右の帯に直接貼り付いてしまうため、
		   .edit-layout-right自身に左右paddingを持たせてカードと帯の間に余白を作る
		   (.panel の左右padding(var(--space-5))と揃え、帯どうしの余白感を統一する)。 */
		.edit-layout-right {
			padding: var(--space-6) var(--space-5);
		}
		@media (max-width: 899px) {
			/* モバイルのセカンドバー状態に合わせ、育成フォームとダメージ計算を同じ場所で切り替える。 */
			.edit-shell:not([data-mobile-tab="damage"]) .edit-layout-right { display: none; }
			.edit-shell[data-mobile-tab="damage"] .edit-layout-left { display: none; }
			/* 帯の左右paddingはモバイルでは詰め、カードを画面幅いっぱいに使う。 */
			.edit-shell[data-mobile-tab="damage"] .edit-layout-right {
				padding: var(--space-3) var(--space-3) 0;
			}
			/* 共通トップバーから降りてきた 保存状態 / 非公開 / 削除 の受け皿(上のマークアップと
			   src/lib/box-id/mobile-edit-tabs.ts 参照)。育成タブ本文の末尾に、メモの下の
			   独立した一列として置く。 */
			.mobile-edit-actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: flex-end;
				gap: var(--space-3);
				padding: var(--space-4) var(--space-5) var(--space-5);
			}
		}
		/* 900px以上ではトップバーが本来の置き場所なので、この受け皿は空のまま畳んでおく
		   (空でもgap/paddingぶんの余白が出てしまうため display:none にする)。 */
		@media (min-width: 900px) {
			.mobile-edit-actions { display: none; }
		}
		@media (min-width: 1200px) {
			.edit-layout {
				display: grid;
				grid-template-columns: minmax(320px, 480px) 1fr;
				gap: 1.4rem;
				/* UI品質改善(帯構成への刷新): align-items:startだと各カラムが自分のコンテンツ分の
				   高さしか持たず、左の帯(.panel-left)が画面下端の手前で途切れて背景色が
				   見えてしまっていた(実測で発覚)。stretchに変え、行の高さ(3カラムのうち
				   最も長いものに揃う)まで各カラムを引き伸ばす。実際に左パネルをその高さまで
				   伸ばす連鎖(height:100%)は下の別の@media (min-width: 1200px)ブロック
				   (.edit-layout-left以下)を参照。 */
				align-items: stretch;
			}
		}
		/* UI品質改善(帯構成への刷新): .edit-layout-detail(3カラム目)・.damage-detail-panel*の
		   scoped styleは構造分割ラウンド(フェーズ2)で src/components/box-id/RightPanel.astro へ
		   移設した(見た目は一切変更していない。Astroのscoped styleはコンポーネントをまたいで
		   効かないため、要素とCSSを同じファイルに揃える必要があった)。このページ側には
		   グリッド自体(.edit-layout)の3カラム化だけを残す。 */
		@media (min-width: 1600px) {
			.edit-layout {
				grid-template-columns: minmax(320px, 440px) minmax(520px, 1fr) minmax(300px, 360px);
			}
		}

		/* UI刷新: 実数値の常時表示。性格補正は文字色で表現する(上昇=赤系、下降=青系、
		   補正なしは既定色のまま)。#1d6fd1のハードコードはダークで下降色3.30:1、
		   --color-danger直参照の上昇色もライトで2.81:1と、両モードで片方ずつWCAG AA未達に
		   なるため、global.cssの--color-stat-up/--color-stat-downに集約し、モードごとに
		   値を持たせる(/box/index.astroと同値に統一)。
		   is:global側(#opponent-notes-sectionの.damage-stat-value)からもこのカスタム
		   プロパティを参照するが、Astroのスコープ属性はセレクタにのみ影響し、カスタム
		   プロパティの値はDOM継承で下層のグローバル要素にも届くため問題なく効く。
		   マークアップのclass="edit-shell"は他の用途もあるため維持する。 */
		/* select要素の矢印アイコン(--select-arrow)やスタイルはsrc/styles/global.cssの共通
		   selectルールに統合済みで、このページには重複定義しない。global.cssはAstroのスコープ
		   機構を経由しない素のスタイルシートなので、#edit-form内の静的<select>にも
		   #opponent-notes-section内でJSが動的生成する<select>にも同じ1つの定義で届く。 */
		/* 未入力欄は「壊れたフォーム」に見えないよう、placeholderが表示されている(=空欄)間は
		   破線+透明背景にして「空きスロット」を能動的に表現する(入力中/フォーカス中は通常の
		   実線に戻す。:not(:focus)で除外)。input:placeholder-shownはtextarea/inputにのみ
		   有効(select非対応)。
		   #tera(<select>)自体は非表示になっており、同じ視覚言語(破線+透明背景+muted文字色)は
		   .tera-dropdown-button.is-tera-unselected(下の#edit-form .tera-dropdown-button定義参照)
		   が引き継ぐ。 */
		/* 左サイド(.panel-left/#edit-form)専用のscoped style一式(.stat-*・.top-block-*・
		   .species-icon-box・.type-badge-*・.item-image-badge・.tera-dropdown-*・
		   .move-type-icon・.memo-input 等)は構造分割ラウンド(フェーズ1)により
		   src/components/box-id/LeftPanel.astro へ移設した(見た目は一切変更していない)。 */

		/* .stat-table 以下、@media (min-width: 1200px) 直前までの左サイド専用scoped styleは構造分割ラウンド
		   (フェーズ1)で src/components/box-id/LeftPanel.astro へ移設した(見た目は一切変更していない)。 */
		@media (min-width: 1200px) {
			.edit-shell {
				display: flex;
				flex-direction: column;
				min-height: calc(100vh - var(--topbar-height));
			}
			.edit-layout {
				flex: 1 1 auto;
				min-height: 0;
			}
			.edit-layout-left {
				height: 100%;
			}
		}
		/* .top-block-icon 以下、.tuning-button までの左サイド専用scoped styleは構造分割ラウンド
		   (フェーズ1)で src/components/box-id/LeftPanel.astro へ移設した(見た目は一切変更していない)。 */
	</style>
	<div class="page edit-shell" id="edit-shell" data-mobile-tab="training">
	{
		!user ? (
			<section class="panel">
				<div class="panel-content">
					<p>個体を編集するにはログインが必要です。</p>
					<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
				</div>
			</section>
		) : loadError ? (
			<section class="panel">
				<div class="panel-content">
					<p>個体情報を読み込めませんでした。時間をおいて再度お試しください。</p>
				</div>
			</section>
		) : !pokemon ? (
			<section class="panel">
				<div class="panel-content">
					<p>指定された個体が見つかりませんでした(削除された、または他のアカウントの個体である可能性があります)。</p>
				</div>
			</section>
		) : (
			<>
			<MobileTrainingBar pokemon={pokemon} backHref={backHref} />
			<div class="edit-layout">
			<div class="edit-layout-left">
			{/* 左サイド(ポケモン編集パネル、.panel-left)のテンプレート・scoped style・スクリプトは
			    構造分割ラウンド(フェーズ1)により src/components/box-id/LeftPanel.astro +
			    src/lib/box-id/left-panel.ts へ切り出した(見た目・ロジックは一切変更していない)。
			    SSRで取得済みのpokemon(この分岐では非null)だけをpropsで渡す。 */}
			<LeftPanel pokemon={pokemon} />
			{/* 900px未満では共通トップバー(.app-topbar)を隠すため、そこに載っていた保存状態・
			    非公開トグル・削除ボタンの移設先を育成タブ本文の最下部に用意する。実際に要素を
			    差し込むのは src/lib/box-id/mobile-edit-tabs.ts(DOMごと移動させるのでイベントは
			    張り直さない)。900px以上ではこの箱は空のまま display:none にする。 */}
			<div class="mobile-edit-actions" id="mobile-edit-actions"></div>
			</div>

			<div class="edit-layout-right">

			{/* ダメージ計算カード(#opponent-notes-section)のテンプレート・is:globalスタイル・
			    スクリプトは構造分割ラウンド(フェーズ2)により src/components/box-id/DamageCalcSection.astro +
			    src/lib/box-id/damage-calc.ts へ切り出した(見た目・ロジックは一切変更していない)。 */}
			<DamageCalcSection pokemonId={pokemon.id} moveAdoptionBySpecies={moveAdoptionBySpecies} />
			</div>

			{/* 右サイド(詳細設定サイドバー、#damage-detail-panel + #damage-detail-backdrop)の
			    テンプレート・scoped styleは構造分割ラウンド(フェーズ2)により
			    src/components/box-id/RightPanel.astro へ切り出した(見た目・ロジックは一切
			    変更していない。.edit-layout-detail/#damage-detail-backdropの2要素をまとめて
			    このコンポーネント自身が描画する)。 */}
			<RightPanel />
			</div>

			{/* 「耐久調整」機能のポップアップ本体。トップバーの#bulk-adjust-button
			    (上のFragment slot="topbar-actions"参照)から開く。マークアップ・スタイルは
			    BulkAdjustDialog.astro、ロジックはsrc/lib/box-id/bulk-adjust.tsに実装済み
			    (このページ側はimportと配置のみ)。 */}
			<BulkAdjustDialog />
			<SpeedAdjustDialog pokemonId={pokemon.id} />
			</>
		)
	}
	</div>

	<datalist id="pokemon-list"></datalist>
	<datalist id="move-list"></datalist>
	<datalist id="ability-list"></datalist>
	<datalist id="item-list"></datalist>
	<script type="application/json" id="box-species-usage-data" set:html={JSON.stringify(speciesUsageByRegulation)} />

	{/* 提案図(docs/ui_proposal/mobile/ の ui_mobile_box_個体編集_*.png)はどれも画面上端が
	    セカンドバーで、共通ヘッダー(アプリロゴ)も「← 戻る」も描かれていない。.app-topbar は
	    AppLayout.astro 側の要素で、AppLayout自体は編集禁止(全ページに影響する)のため、
	    既存の bodyClass="box-edit-page" を使ってこのページだけを対象に is:global で隠す。
	    AppLayoutのhideTopbar propは幅に関係なく描画自体をやめてしまうため、デスクトップの
	    トップバーを残したいこのページでは使えない。
	    ⚠️ トップバーに載っていた操作系(保存状態・耐久調整・すべて折りたたむ・非公開・削除)は
	    このCSSで一緒に消える。消えたままだとモバイルから削除も非公開切り替えもできなくなるため、
	    src/lib/box-id/mobile-edit-tabs.ts がDOMごとタブ本文側へ移設している(戻り先も保持済み)。 */}
	<style is:global>
		body.box-edit-page .app-topbar { display: none; }
			/* --topbar-height はトップバーの実測高さ(global.cssの:root)で、ポケモンプレビュー
			   (.pokemon-preview の position:sticky; top)や .edit-shell の高さ計算が
			   これを見る。トップバーを消した以上0にしないと、本文が画面上端から一段浮いてしまう。
			   --second-bar-height は画面上端にstickyで貼り付くセカンドバー
			   (.second-bar、MobileTrainingBar.astro参照)の実測高さ。
			   ポケモンプレビューをその直下にstickyで貼り付けるためのtopオフセットに使う。
			   値はdevサーバー+Playwrightの
			   getBoundingClientRectで実測した53px(バー内のアイコン/ラベルの固定サイズで
			   決まるため、画面幅やテキスト長では変わらない)。バーの構成を変えたら実測し直す。
			   コンポーネントのscoped styleではなくここ(body)に置くことで、MobileTrainingBar.astro
			   内の要素へカスタムプロパティのDOM継承で届く。 */
		body.box-edit-page { --topbar-height: 0px; }
		/* The editor intentionally keeps the compact tabbed layout at every width. */
		.edit-shell:not([data-mobile-tab="damage"]) .edit-layout-right,
		.edit-shell[data-mobile-tab="damage"] .edit-layout-left { display: none; }
		.edit-shell[data-mobile-tab="damage"] .edit-layout-right { padding: var(--space-3) var(--space-3) 0; }
		.mobile-edit-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-end;
			gap: var(--space-3);
			padding: var(--space-4) var(--space-5) var(--space-5);
		}
	</style>

</AppLayout>
