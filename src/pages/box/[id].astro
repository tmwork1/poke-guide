			background: var(--color-surface-alt);
			flex-shrink: 0;
		}
		#opponent-notes-section .damage-sprite-box img.sprite-icon {
			width: 88px;
			height: 88px;
		}
		#opponent-notes-section .damage-sprite-box .sprite-fallback {
			font-size: 1.8rem;
		}
		#opponent-notes-section .damage-type-badge {
			position: absolute;
			top: -6px;
			right: -6px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		/* ラウンド5ユーザー指示: 事前生成済みの正方形タイプアイコン(typeIconUrl。ラウンド23の23-G2で
		   テラス専用のteraTypeIconUrlは廃止し、通常タイプと同じtypeIconUrlに統一した)に
		   切り替えたため、CSS側での切り出し(object-fit:cover等)は不要(上の.type-badge-imgと同じ理屈)。
		   ラウンド20ユーザー指示(20-G1): 18px→var(--icon-size-sm)(20px、global.css定義済み)に
		   拡大する。密なグリッド内の小アイコン規格(20-G1のトークン表「ダメージ計算カードの
		   相手ビルド箱」)に合わせる。持ち物画像(.damage-item-badge、下記)は既に22pxで
		   20px以上を満たしているため今回は変更しない。 */
		#opponent-notes-section .damage-type-badge-img {
			height: var(--icon-size-sm);
			width: var(--icon-size-sm);
			border-radius: 50%;
			filter: drop-shadow(0 0 1px var(--color-surface));
		}
		#opponent-notes-section .damage-type-badge-fallback {
			display: none;
			width: var(--icon-size-sm);
			height: var(--icon-size-sm);
			border-radius: 50%;
			border: 1px solid var(--color-border);
		}
		/* #species-type-badge自体は静的マークアップだが、中の<img>/<span>はapplyTypeBadge()が
		   document.createElement()で動的追加するため、上のscoped <style>の.type-badge-imgは
		   付与されない(data-astro-cid-*が無い要素にはscoped <style>が効かない。
		   #opponent-notes-section .damage-type-badge-imgと同じ理屈)。同じ値をここに複製する。
		   ラウンド5ユーザー指示: 正方形の事前生成アイコンに切り替えたため object-fit:cover 等の
		   切り出しは不要(border-radius:50%だけで円形に見える)。 */
		/* ラウンド20ユーザー指示(20-G1): 14px→--icon-size-sm(20px、global.css定義済み)に
		   拡大する。is:globalブロック内(:root継承)なのでカスタムプロパティは通常どおり参照できる。 */
		#species-type-badge .type-badge-img {
			height: var(--icon-size-sm);
			width: var(--icon-size-sm);
			border-radius: 50%;
			filter: drop-shadow(0 0 1px var(--color-surface));
		}
		#species-type-badge .type-badge-fallback {
			display: none;
			width: var(--icon-size-sm);
			height: var(--icon-size-sm);
			border-radius: 50%;
			border: 1px solid var(--color-border);
		}
		/* 持ち物画像: 名前行の横幅を圧迫しないよう、種族アイコンに小さなバッジとして重ねる
		   (要件: テラスバッジ=右上と衝突しない対角に配置)。
		   ラウンド8指摘(A-1由来): 以前はbottom:-6px/left:-6pxで名前inputとの継ぎ目に浮いて
		   見えていた。
		   ラウンド23ユーザー指示(23-G1「アイテム画像の丸枠を廃止し直接表示する」+23-D1
		   「アイテム画像を2/3に縮小」): 55px→37pxに縮小し、白丸+枠+影(border-radius/
		   background/border/box-shadow/padding)を撤去して画像を直接表示する(左パネルの
		   .item-image-badgeと同じ変更内容・同じ最終サイズ)。overflow:hiddenも円形クリップ用
		   だったため不要になり撤去した。position:absoluteでのbottom/rightオフセット(-4px)と
		   種族アイコンへの重ね配置は維持する。 */
		#opponent-notes-section .damage-item-badge {
			position: absolute;
			bottom: -4px;
			right: -4px;
			width: 37px;
			height: 37px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		/* ラウンド8の回帰修正: display:flexを持つクラスはUAの[hidden]{display:none}に
		   詳細度で勝ってしまう(pitfalls.md「[hidden]は詳細度で負ける」)。枠を撤去した後も
		   バッジ自体([hidden]対象)と中の<img>([hidden]とは別に、applyItemImage()側で
		   display:noneにする)の二重の隠蔽ロジックは変わらず必要(持ち物なしの相手で
		   alt文字や壊れ画像アイコンが出ないようにするため)。23-G1適用後も実機で
		   持ち物なしの相手に空バッジが出ないことを確認済み。 */
		#opponent-notes-section .damage-item-badge[hidden] {
			display: none;
		}
		/* ラウンド23ユーザー指示(23-D1): 55px→37pxに縮小(左パネルの.item-image-badgeと同じ
		   最終サイズ)。.damage-item-badge はposition:absoluteで.damage-sprite-box
		   (width/height固定96px)基準に重なるだけで通常のフローに参加しないため、
		   縮小してもカード自体の高さには影響しない。
		   pixelatedの扱い: 23-G1の指示文は「/boxと左パネルはpixelatedを撤去した」という
		   前提だったが、実装時に確認したところ左パネルの.item-image(37px)は実際には
		   pixelatedを維持したまま「37pxなら実解像度32×32に近くボケが判別できない」という
		   判断で据え置かれていた(このファイル958行目のコメント参照)。このバッジも同じ
		   37px・同じPokeAPIドット絵ソースのため、左パネルと揃える形でpixelatedを維持する
		   (ライト・ダーク双方でdeviceScaleFactor:3の拡大クロップを確認し、有無での見え方の
		   差が実測で判別できないことを確認済み。判断根拠は報告参照)。 */
		#opponent-notes-section .damage-item-image {
			width: 100%;
			height: 100%;
			object-fit: contain;
			image-rendering: pixelated;
		}

		/* 努力値/実数値グリッド(DamageCard.pngの「努力値 ＨＡＢＣＤＳ」「実数値 ＨＡＢＣＤＳ」の2行)。
		   1列目に行ラベル(努力値/実数値)を置き、その右にH/A/B/C/D/Sの6列を並べる3段構成
		   (1段目はH/A/B/C/D/Sの見出し)。DOMも行優先(見出し7セル→努力値7セル→実数値7セル)で
		   生成すること。列ごとに縦積みしていた旧構造では行ラベルを付けられなかったため入れ替えた。
		   UI品質改善(2026-07-26 第4弾): 文字が実測~10pxと小さすぎたため、行ラベル/列見出し/
		   数値のフォントサイズを底上げした(桁揃えのため.tnumも<script>側の生成コードに追加)。 */
		#opponent-notes-section .damage-ev-grid {
			display: grid;
			grid-template-columns: 3.4em repeat(6, minmax(0, 1fr));
			gap: 0.15rem 0.15rem;
			align-items: center;
			margin-top: 0.15rem;
		}
		#opponent-notes-section .damage-ev-row-label {
			/* 20-G3: 0.66rem(10.6px)→0.76rem(12.16px、12px下限を満たす)。 */
			font-size: 0.76rem;
			font-weight: 700;
			line-height: 1.2;
			color: var(--color-text-muted);
			white-space: nowrap;
		}
		#opponent-notes-section .damage-ev-col-label {
			/* 20-G3: 0.68rem(10.9px)→0.76rem(12.16px、12px下限を満たす)。 */
			font-size: 0.76rem;
			font-weight: 700;
			line-height: 1.2;
			text-align: center;
			color: var(--color-text-muted);
		}
		/* ラウンド20ユーザー指示(20-D3、ラウンド5の「▲/▼を独立ボタン化する」という判断を撤回):
		   H/A/B/C/D/S見出し(HP以外)自体をクリックすると無補正→上昇→下降→無補正と3循環する
		   1個のボタンに作り直した(旧・上下2ボタン+縦3段の.damage-ev-col-header/
		   .damage-ev-nature-btn/.damage-ev-nature-up/.damage-ev-nature-downは廃止)。
		   ボタンは.damage-ev-col-labelの見た目(サイズ・太字・中央寄せ)をそのまま引き継ぐ……
		   はずだったが、ラウンド21ユーザー指示(21-D5)で実測したところ意図どおりに引き継げて
		   いなかった。
		   実測(getComputedStyle、H=<span class="damage-ev-col-label">・A=このボタン):
		     修正前 H: font-size 12.16px / font-weight 700 / line-height 14.592px
		            A: font-size 16px    / font-weight 400 / line-height 25.6px
		   原因: 下の`font: inherit`がfont-size/font-weight/line-heightをすべて含む
		   ショートハンドで、このセレクタ(#opponent-notes-section .damage-ev-nature-cycle、
		   特異度=ID1+class1)が.damage-ev-col-label(同じくID1+class1、上記グリッド見出しの
		   共通ルール)と同じ特異度でこちらのほうが後方に書かれているため、ソース順で
		   font-weight:700/font-size:0.76remを丸ごと上書きしてしまっていた(ボタンのUAスタイル
		   由来のfont-synthesis/font-smoothingの違いという当初の推定は誤りで、実測では両者とも
		   同一だった。真因はこの1行の特異度衝突)。
		   修正: `font: inherit`(全サブプロパティを継承値で上書き)ではなく`font-family: inherit`
		   だけにする。これで.damage-ev-col-labelのfont-size/font-weight/line-heightが
		   このボタンにも正しく適用される(HPだけ<button disabled>にする代替案は、実測で差の
		   真因が特定できたため不要と判断した)。 */
		/* ラウンド23ユーザー指示(23-D4)「性格補正の三角形とステータス文字の間を少しあける」。
		   0.05em(文字とほぼ密着)→0.2emに広げる。「少しだけ」という指示のため広げすぎない
		   (実測はH=12.16px基準で0.05em≈0.6px→0.2em≈2.4px。A/B/C/D/Sは0.76em基準の
		   font-sizeなので実際はもう少し大きい)。🔴 上のコメントに記録済みの罠のとおり、
		   `font: inherit`のようなショートハンドで書き直さないこと(font-size/font-weight/
		   line-heightを丸ごと上書きしてしまう)。ここではgapの数値だけを変更する。 */
		#opponent-notes-section .damage-ev-nature-cycle {
			display: inline-flex;
			align-items: baseline;
			justify-content: center;
			gap: 0.2em;
			width: 100%;
			background: none;
			border: none;
			padding: 0.05rem 0;
			font-family: inherit;
			cursor: pointer;
		}
		#opponent-notes-section .damage-ev-nature-cycle:hover { color: var(--color-primary); }
		#opponent-notes-section .damage-ev-nature-cycle:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		/* 色だけで状態を伝えない(WCAG 1.4.1)。上昇/下降は文字色(--stat-up/--stat-down、
		   新色は作らない)に加えて、文字の直後に小さく▲/▼を添える(装飾専用。実際の
		   状態説明はボタンのaria-label/titleが担う。<script>のdescribeNatureCycleState参照)。
		   無補正のときは空文字列にする(何も足さない)。 */
		#opponent-notes-section .damage-ev-nature-indicator {
			/* 20-G3: 親(.damage-ev-col-label)の0.76rem(12.16px)をそのまま継承する
			   (emで縮めると12px下限を割るため、縮小しない)。 */
			line-height: 1;
		}
		#opponent-notes-section .damage-ev-col-label[data-mod="up"] { color: var(--stat-up); }
		#opponent-notes-section .damage-ev-col-label[data-mod="down"] { color: var(--stat-down); }
		/* グリッドのセル幅に完全に従わせる(width:100%とmin-width:0の両方が必要。
		   min-width:0を省くと、global.cssのinput既定幅がグリッドの最小コンテンツ幅として
