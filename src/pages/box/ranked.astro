---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobileTrainingBar from '../../components/box-id/MobileTrainingBar.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import '../../styles/data-page.css';
// 上位チームのカードは /team 一覧・/team/[id] の類似構築タブと共用の renderTopBuildCard() を
// そのまま使うため、そのスタイル定義元(box-card.cssを@importしている)も読み込む。
import '../../styles/team-card.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : null;
let rankedSeason: string | null = null;
if (pokemon) {
  try {
    rankedSeason = resolveDefaultSeason(await listRankedSeasons(await getSupabasePublicClient()));
  } catch (error) {
    console.error('[box/ranked] 上位チームのシーズン取得に失敗しました:', error);
  }
}
---

<AppLayout title="上位チーム" description="この個体を採用した上位構築" current="box" bodyClass="data-page">
  <div class="page box-data-page box-ranked-page">
    {pokemon ? (
      <MobileTrainingBar pokemon={pokemon} activeTab="ranked-teams" />
    ) : (
      <section class="pokemon-data-preview" aria-labelledby="ranked-preview-title">
        <p class="data-kicker">育成データレビュー</p>
        <h1 id="ranked-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「上位チーム」から、選択中のポケモンを採用した上位構築を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {pokemon && (
      <main
        class="box-data-main"
        data-ranked-season={rankedSeason ?? ''}
        data-pokemon-build={JSON.stringify({
          species_name: pokemon.species_name,
          ability_name: pokemon.ability_name,
          item_name: pokemon.item_name,
          move_names: pokemon.move_names,
        })}
      >
        <section id="ranked-data-panel" class="data-panel">
          {rankedSeason ? (
            <p id="ranked-data-status" class="box-ranked-status status-text" data-state="loading">上位チームを計算中…</p>
          ) : (
            <p id="ranked-data-status" class="box-ranked-status status-text">上位チームのデータはまだありません。</p>
          )}
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script>
  import { calculateBuildSimilarity } from '../../lib/build-similarity';
  import { renderTopBuildCard } from '../../lib/ranked-teams/card';
  import type { RankedTeam } from '../../lib/ranked-teams';
  import { reloadOnBfcacheRestore } from '../../lib/shared/reload-on-bfcache-restore';

  const main = document.querySelector<HTMLElement>('.box-data-main');
  const panel = document.querySelector<HTMLElement>('#ranked-data-panel');
  const rankedSeason = main?.dataset.rankedSeason || null;
  const pokemonBuildJson = main?.dataset.pokemonBuild;

  function setRankedStatus(message: string, state?: 'loading' | 'error'): void {
    if (!panel) return;
    panel.innerHTML = '';
    const status = document.createElement('p');
    status.className = 'box-ranked-status status-text';
    if (state) status.dataset.state = state;
    status.textContent = message;
    panel.appendChild(status);
  }

  async function loadRankedBuilds(): Promise<void> {
    if (!panel || !rankedSeason || !pokemonBuildJson) return;

    const pokemonBuild = JSON.parse(pokemonBuildJson) as {
      species_name: string;
      ability_name: string | null;
      item_name: string | null;
      move_names: string[];
    };

    try {
      const response = await fetch(`/api/ranked-teams?season=${encodeURIComponent(rankedSeason)}`, {
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error(`上位チームの取得に失敗しました (status=${response.status})`);
      const body = (await response.json()) as { teams: RankedTeam[] };
      const teams = body.teams ?? [];
      const scored = teams
        .map((team) => {
          const matched = team.members.find((member) => member.speciesName === pokemonBuild.species_name);
          return matched ? { team, matched, similarity: calculateBuildSimilarity(pokemonBuild, matched) } : null;
        })
        .filter((entry): entry is { team: RankedTeam; matched: RankedTeam['members'][number]; similarity: number } => entry !== null)
        .sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);

      if (scored.length === 0) {
        setRankedStatus('上位チームが見つかりません。');
        return;
      }

      // 型(特性・アイテム・技)も一致する構築を優先する。型一致がゼロなら、
      // 単純に同じ種族で見つかった構築(scored全体)をそのまま使う。
      const typeMatched = scored.filter((entry) => entry.similarity > 0);
      const results = typeMatched.length > 0 ? typeMatched : scored;

      const list = document.createElement('div');
      list.className = 'team-grid';
      for (const entry of results) {
        list.appendChild(renderTopBuildCard(
          entry.team,
          entry.similarity > 0 ? { highlightSlot: entry.matched.slot } : undefined,
        ));
      }
      panel.innerHTML = '';
      panel.appendChild(list);
    } catch (error) {
      console.error(error);
      setRankedStatus('上位チームを読み込めませんでした。', 'error');
    }
  }

  void loadRankedBuilds();
  reloadOnBfcacheRestore(() => void loadRankedBuilds());
</script>

<script>
  const rankedPage = document.querySelector<HTMLElement>('.box-ranked-page');
  const trainingBar = document.querySelector<HTMLElement>('#mobile-training-ui');
  const bottomNav = document.querySelector<HTMLElement>('.app-bottom-nav');

  function syncRankedViewport(): void {
    if (!rankedPage || !trainingBar) return;

    rankedPage.style.setProperty('--box-data-scroll-top', `${trainingBar.getBoundingClientRect().bottom}px`);
    if (bottomNav) {
      rankedPage.style.setProperty('--box-data-scroll-bottom', `${window.innerHeight - bottomNav.getBoundingClientRect().top}px`);
    }
  }

  syncRankedViewport();
  window.addEventListener('resize', syncRankedViewport);
  new ResizeObserver(syncRankedViewport).observe(trainingBar);
  if (bottomNav) new ResizeObserver(syncRankedViewport).observe(bottomNav);
</script>
