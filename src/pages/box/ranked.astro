---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobilePokemonPreview from '../../components/box-id/MobilePokemonPreview.astro';
import PokemonSettingsModalHost from '../../components/box-id/PokemonSettingsModalHost.astro';
import RankedTeamsSearchHeader from '../../components/ranked-teams/RankedTeamsSearchHeader.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { createMobilePreviewPlaceholder } from '../../lib/box-id/mobile-preview-placeholder';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import '../../styles/box-insight-page.css';
// 上位チームのカードは /team 一覧・/team/[id] の類似構築タブと共用の renderTopBuildCard() を
// そのまま使うため、そのスタイル定義元(owned-pokemon-card.cssを@importしている)も読み込む。
import '../../styles/team-card.css';
import '../../styles/team-mate-card.css';
import '../../styles/second-header.css';
import '../../styles/ranked-teams-search-header.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : (selectedId ? createMobilePreviewPlaceholder(selectedId) : null);
const canRenderSelectedPokemon = result?.ok || (!user && selectedId !== null);
let rankedSeason: string | null = null;
let rankedSeasons: Awaited<ReturnType<typeof listRankedSeasons>> = [];
if (pokemon) {
  try {
    rankedSeasons = await listRankedSeasons(await getSupabasePublicClient());
    rankedSeason = resolveDefaultSeason(rankedSeasons);
  } catch (error) {
    console.error('[box/ranked] 上位チームのシーズン取得に失敗しました:', error);
  }
}
---

<AppLayout title="上位チーム" description="このポケモンを採用した上位構築" current="box" bodyClass="data-page">
  <div class="page box-data-page box-ranked-page">
    <MobilePokemonPreview pokemon={canRenderSelectedPokemon ? pokemon : null} activeTab="ranked-teams" />
    {canRenderSelectedPokemon && pokemon && (
      <RankedTeamsSearchHeader
        idPrefix="box-ranked"
        seasons={rankedSeasons}
        defaultSeason={rankedSeason}
        class="box-ranked-second-header"
      />
    )}
    {canRenderSelectedPokemon && pokemon ? <PokemonSettingsModalHost pokemon={pokemon} /> : (
      <section class="pokemon-data-preview" aria-labelledby="ranked-preview-title">
        <p class="data-kicker">育成データレビュー</p>
        <h1 id="ranked-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「上位チーム」から、選択中のポケモンを採用した上位構築を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {canRenderSelectedPokemon && pokemon && (
      <main
        class="box-data-main"
        data-ranked-season={rankedSeason ?? ''}
        data-guest-pokemon-id={!user ? selectedId ?? '' : undefined}
        data-pokemon-build={JSON.stringify({
          species_name: pokemon.species_name,
          ability_name: pokemon.ability_name,
          item_name: pokemon.item_name,
          move_names: pokemon.move_names,
        })}
      >
        <section id="ranked-data-panel" class="data-panel">
          {rankedSeason ? (
            <>
              <p id="ranked-data-status" class="box-ranked-status status-text" data-state="loading">上位チームを計算中…</p>
              <div class="team-grid box-ranked-loading-grid" aria-hidden="true">
                <article class="card-team card-team--top-build">
                  <div class="card-team-header card-team-header--inline"></div>
                  <div class="box-grid">
                    {Array.from({ length: 6 }, () => <div class="card box-card"></div>)}
                  </div>
                </article>
              </div>
            </>
          ) : (
            <p id="ranked-data-status" class="box-ranked-status status-text">上位チームのデータはまだありません。</p>
          )}
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script>
  import { calculateBuildSimilarity } from '../../lib/build-similarity';
  import type { RankedTeam } from '../../lib/ranked-teams';
  import { matchesTopBuildSearch, RANKED_TEAMS_PAGE_SIZE } from '../../lib/ranked-teams-validation';
  import { createRankedTeamCardRenderer, setupRankedTeamsSearchHeader } from '../../lib/ranked-teams/search-header';
  import { reloadOnBfcacheRestore } from '../../lib/shared/reload-on-bfcache-restore';
  import { hydrateGuestPagePokemon } from '../../lib/data/guest-page-hydration';

  const main = document.querySelector<HTMLElement>('.box-data-main');
  const panel = document.querySelector<HTMLElement>('#ranked-data-panel');
  let selectedRankedSeason = main?.dataset.rankedSeason || null;
  let pokemonBuildJson = main?.dataset.pokemonBuild;
  let rankedOffset = 0;
  let hasMoreRankedTeams = false;
  let rankedLoadingGeneration: number | null = null;
  let rankedLoadGeneration = 0;
  let header: ReturnType<typeof setupRankedTeamsSearchHeader>;
  let cardRenderer: ReturnType<typeof createRankedTeamCardRenderer>;
  type ScoredRankedTeam = {
    team: RankedTeam;
    matched: RankedTeam['members'][number];
    similarity: number;
  };
  let scoredRankedTeams: ScoredRankedTeam[] = [];

  function setRankedStatus(message: string, state?: 'loading' | 'error'): void {
    if (!panel) return;
    panel.innerHTML = '';
    const status = document.createElement('p');
    status.className = 'box-ranked-status status-text';
    if (state) status.dataset.state = state;
    status.textContent = message;
    panel.appendChild(status);
  }

  function renderRankedBuilds(): void {
    if (!panel) return;
    const filtered = scoredRankedTeams.filter((entry) => matchesTopBuildSearch(entry.team.members, header.getSearchValue()));
    if (filtered.length === 0) {
      if (hasMoreRankedTeams) {
        setRankedStatus('上位チームを計算中…', 'loading');
      } else if (header.getSearchValue().trim()) {
        setRankedStatus('条件に一致するチームがありません。');
      } else {
        setRankedStatus('上位チームが見つかりません。');
      }
      return;
    }

    panel.replaceChildren();
    const rankedList = document.createElement('div');
    rankedList.className = 'box-ranked-results';
    const typeMatchedList = document.createElement('div');
    typeMatchedList.className = 'team-grid';
    const speciesMatchedList = document.createElement('div');
    speciesMatchedList.className = 'team-grid';
    rankedList.append(typeMatchedList, speciesMatchedList);
    panel.append(rankedList);

    for (const entry of filtered) {
      const destination = entry.similarity > 0 ? typeMatchedList : speciesMatchedList;
      destination.appendChild(cardRenderer.renderCard(
        entry.team,
        entry.similarity > 0 ? { highlightSlot: entry.matched.slot } : undefined,
      ));
    }
  }

  async function loadRankedBuilds(reset = false): Promise<void> {
    if (!panel || !selectedRankedSeason || !pokemonBuildJson) return;

    if (reset) {
      rankedLoadGeneration += 1;
      rankedOffset = 0;
      hasMoreRankedTeams = false;
      scoredRankedTeams = [];
      cardRenderer.resetTapExpandedTeams();
    }
    const generation = rankedLoadGeneration;
    if (rankedLoadingGeneration === generation) return;
    rankedLoadingGeneration = generation;
    let loadedNextBatch = false;
    const requestedSeason = selectedRankedSeason;

    const pokemonBuild = JSON.parse(pokemonBuildJson) as {
      species_name: string;
      ability_name: string | null;
      item_name: string | null;
      move_names: string[];
    };

    try {
      const requestedOffset = rankedOffset;
      const params = new URLSearchParams({
        season: requestedSeason,
        limit: String(RANKED_TEAMS_PAGE_SIZE),
        offset: String(requestedOffset),
      });
      const response = await fetch(`/api/ranked-teams?${params}`, {
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error(`上位チームの取得に失敗しました (status=${response.status})`);
      const body = (await response.json()) as { teams: RankedTeam[]; hasMore: boolean };
      if (generation !== rankedLoadGeneration || requestedSeason !== selectedRankedSeason) return;
      const teams = body.teams ?? [];
      rankedOffset += teams.length;
      hasMoreRankedTeams = body.hasMore;
      loadedNextBatch = teams.length > 0;
      const scored = teams
        .map((team) => {
          // 上位チームはメガ後の種族を speciesKey に、表示上のベース種族を speciesName に
          // 保存する。speciesName だけで比較すると、メガウツボットのようなメガ形態が
          // ベース種族名（ウツボット）と不一致になり候補から漏れるため、種族キーを優先する。
          // speciesKey が無い古いレコードだけは、従来どおり表示名で照合する。
          const matched = team.members.find(
            (member) =>
              member.speciesKey === pokemonBuild.species_name ||
              (member.speciesKey === null && member.speciesName === pokemonBuild.species_name),
          );
          return matched ? { team, matched, similarity: calculateBuildSimilarity(pokemonBuild, matched) } : null;
        })
        .filter((entry): entry is { team: RankedTeam; matched: RankedTeam['members'][number]; similarity: number } => entry !== null)
        .sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);

      // 型(特性・アイテム・技)が一致する構築を先に並べ、その下へ種族だけが
      // 一致する構築も常に追加する。取得済み全件を保持し、検索・密度変更では再取得しない。
      scoredRankedTeams = [...scoredRankedTeams, ...scored]
        .sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);
      renderRankedBuilds();
    } catch (error) {
      if (generation !== rankedLoadGeneration) return;
      console.error(error);
      setRankedStatus('上位チームを読み込めませんでした。', 'error');
    } finally {
      if (rankedLoadingGeneration === generation) rankedLoadingGeneration = null;
      if (generation === rankedLoadGeneration && hasMoreRankedTeams && loadedNextBatch) {
        // 24件ごとに描画機会を作ってから、残りをユーザー操作なしで取得する。
        window.requestAnimationFrame(() => void loadRankedBuilds());
      }
    }
  }

  function hydrateGuestRankedPokemon(): void {
    const pokemon = hydrateGuestPagePokemon(main?.dataset.guestPokemonId ?? '');
    if (!pokemon) return;
    pokemonBuildJson = JSON.stringify({
      species_name: pokemon.species_name,
      ability_name: pokemon.ability_name,
      item_name: pokemon.item_name,
      move_names: pokemon.move_names,
    });
  }

  if (main) {
    header = setupRankedTeamsSearchHeader({
      idPrefix: 'box-ranked',
      onSearchChange: renderRankedBuilds,
      onDensityChange: () => {
        cardRenderer.resetTapExpandedTeams();
        renderRankedBuilds();
      },
      onSeasonChange: (season) => {
        selectedRankedSeason = season;
        setRankedStatus('上位チームを計算中…', 'loading');
        void loadRankedBuilds(true);
      },
    });
    cardRenderer = createRankedTeamCardRenderer({
      getDisplayMode: header.getDisplayMode,
      onCardExpand: renderRankedBuilds,
    });

    hydrateGuestRankedPokemon();
    if (selectedRankedSeason) void loadRankedBuilds(true);
    reloadOnBfcacheRestore(() => {
      selectedRankedSeason = header.getSeason();
      void loadRankedBuilds(true);
    });
  }
</script>
