---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import MobilePokemonPreview from '../../components/box-id/MobilePokemonPreview.astro';
import PokemonSettingsModalHost from '../../components/box-id/PokemonSettingsModalHost.astro';
import { getOwnedPokemon } from '../../lib/owned-pokemon';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { MATCHUP_TOP_N } from '../../lib/team-matchup';
import '../../styles/box-insight-page.css';
import '../../styles/matchup-panel.css';
import '../../styles/box-matchup-page.css';

const user = Astro.locals.user;
const selectedId = Astro.url.searchParams.get('pokemon');
const result = user && selectedId
  ? await getOwnedPokemon(user.id, selectedId, await getSupabaseAdminClient())
  : null;
const pokemon = result?.ok ? result.data : null;
---

<AppLayout title="相性" description="使用率上位との攻守の相性" current="box" bodyClass="data-page">
  <div class="page box-data-page box-matchup-page">
    <MobilePokemonPreview pokemon={pokemon} activeTab="matchup" />
    {pokemon ? <PokemonSettingsModalHost pokemon={pokemon} /> : (
      <section class="pokemon-data-preview" aria-labelledby="matchup-preview-title">
        <p class="data-kicker">相性チェック</p>
        <h1 id="matchup-preview-title">ポケモンを選択してください</h1>
        <p>ボックス詳細画面の「相性」から、選択中のポケモンと使用率上位ポケモンの攻守の相性を確認できます。</p>
        <a class="btn-ghost" href="/box">ボックスを開く</a>
      </section>
    )}

    {pokemon && (
      <main
        id="box-matchup-main"
        class="box-data-main"
        data-pokemon={JSON.stringify({
          id: pokemon.id,
          species_name: pokemon.species_name,
          level: pokemon.level,
          nature: pokemon.nature,
          ability_name: pokemon.ability_name,
          item_name: pokemon.item_name,
          tera_type: pokemon.tera_type,
          move_names: pokemon.move_names,
          evs: pokemon.evs,
          ivs: pokemon.ivs,
        })}
      >
        <section class="box-matchup-panel" aria-label="相性チェック">
          <div class="box-matchup-page__results">
            <p id="box-matchup-status" class="team-matchup-status" hidden></p>
            <div class="matchup-direction-headings" aria-label="相性の方向">
              <span data-matchup-active-direction="attack">攻</span>
              <span data-matchup-active-direction="defense">守</span>
            </div>
            <div class="matchup-results-grid">
              <ul id="box-matchup-list-attack" class="team-matchup-list" data-matchup-active-direction="attack" aria-label="攻撃相性" aria-busy="true">
                {Array.from({ length: MATCHUP_TOP_N }, () => <li class="team-matchup-card" data-state="pending" aria-hidden="true"></li>)}
              </ul>
              <ul id="box-matchup-list-defense" class="team-matchup-list" data-matchup-active-direction="defense" aria-label="防御相性" aria-busy="true">
                {Array.from({ length: MATCHUP_TOP_N }, () => <li class="team-matchup-card" data-state="pending" aria-hidden="true"></li>)}
              </ul>
            </div>
            <button id="box-matchup-more" type="button" class="btn-ghost matchup-more-button" hidden>さらに表示</button>
          </div>
        </section>
      </main>
    )}
  </div>
</AppLayout>

<script>
  import { createMatchupPanel, type MatchupPanelMember } from '../../lib/matchup-panel';

  const main = document.querySelector<HTMLElement>('#box-matchup-main');
  const attackListElement = document.querySelector<HTMLElement>('#box-matchup-list-attack');
  const defenseListElement = document.querySelector<HTMLElement>('#box-matchup-list-defense');
  const statusElement = document.querySelector<HTMLElement>('#box-matchup-status');
  const moreButtonElement = document.querySelector<HTMLButtonElement>('#box-matchup-more');
  const pokemonJson = main?.dataset.pokemon;

  if (attackListElement && defenseListElement && statusElement && pokemonJson) {
    const pokemon = JSON.parse(pokemonJson) as MatchupPanelMember;
    const matchupPanel = createMatchupPanel({
      attackListElement,
      defenseListElement,
      statusElement,
		moreButtonElement: moreButtonElement ?? undefined,
      getMembers: () => [pokemon],
    });
    const loadingTimeout = window.setTimeout(() => {
      if (!attackListElement.hasAttribute('aria-busy') && !defenseListElement.hasAttribute('aria-busy')) return;
      attackListElement.replaceChildren();
      defenseListElement.replaceChildren();
      attackListElement.removeAttribute('aria-busy');
      defenseListElement.removeAttribute('aria-busy');
      statusElement.textContent = '相性チェック用のデータを読み込めませんでした。';
      statusElement.hidden = false;
    }, 8_000);
    void matchupPanel.run()
      .catch((error) => {
        console.error(error);
        attackListElement.replaceChildren();
        defenseListElement.replaceChildren();
        attackListElement.removeAttribute('aria-busy');
        defenseListElement.removeAttribute('aria-busy');
        statusElement.textContent = '相性を計算できませんでした。ページを再読み込みしてください。';
        statusElement.hidden = false;
      })
      .finally(() => window.clearTimeout(loadingTimeout));
  }
</script>
