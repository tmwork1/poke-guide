---
export const prerender = false;

import AppLayout from '../layouts/AppLayout.astro';
import '../styles/home-page.css';

const user = Astro.locals.user;
const userName = user?.displayName ?? user?.email;
---

<AppLayout title="ポケガイド" description="ポケモン育成を管理するためのホーム画面" current="home" hideTopbar={true}>
	<div class="page home-page">
		<div class="home-topbar">
			<button class="app-topbar-back" type="button" aria-label="戻る" onclick="history.back()">
				<svg class="app-topbar-back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M15 6l-6 6 6 6" />
				</svg>
			</button>
		</div>
		<header class="home-brand">
			<img class="home-brand-logo" src="/logo.png" alt="" width="48" height="48" />
			<h1>ポケガイド</h1>
		</header>

		<section class="home-account" aria-label="アカウント">
			{
				user ? (
					<Fragment>
						<p class="home-account-name">{userName}</p>
						<form method="post" action="/api/auth/logout">
							<button type="submit">ログアウト</button>
						</form>
					</Fragment>
				) : (
					<Fragment>
						<p>ログインが必要です</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</Fragment>
				)
			}
		</section>

		<nav class="home-card-grid" aria-label="機能一覧">
			<a class="card home-card" href="/box">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.5 12 3 3 7.5v9L12 21l9-4.5v-9Z"/><path d="M3.5 7.3 12 12l8.5-4.7"/><path d="M12 12v9"/></svg>
				<span class="home-card-label">ボックス</span>
			</a>
			<a class="card home-card" href="/team">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="5" width="5" height="5" rx="1"/><rect x="9.5" y="5" width="5" height="5" rx="1"/><rect x="16" y="5" width="5" height="5" rx="1"/><rect x="3" y="14" width="5" height="5" rx="1"/><rect x="9.5" y="14" width="5" height="5" rx="1"/><rect x="16" y="14" width="5" height="5" rx="1"/></svg>
				<span class="home-card-label">チーム</span>
			</a>
			<a class="card home-card" href="/box">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2m4 0h2M8 15h2m4 0h2M8 18h2m4 0h2"/></svg>
				<span class="home-card-label">ダメージ<wbr />計算</span>
			</a>
			<a class="card home-card" href="/data">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
				<span class="home-card-label">バトル<wbr />データ</span>
			</a>
			<a class="card home-card" href="/ranked-teams">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0V4Z"/><path d="M8 6H5v1a4 4 0 0 0 4 4M16 6h3v1a4 4 0 0 1-4 4M12 13v4M8 21h8M9 17h6"/></svg>
				<span class="home-card-label">上位チーム</span>
			</a>
			<a class="card home-card" href="/speed-chart">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
				<span class="home-card-label">すばやさ</span>
			</a>
		</nav>

		<p class="home-contact"><a href="https://x.com/ml7ddw0" target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>お問い合わせ</a></p>
	</div>
</AppLayout>
