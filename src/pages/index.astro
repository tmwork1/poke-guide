---
export const prerender = false;


import AppLayout from '../layouts/AppLayout.astro';
import '../styles/home-page.css';
import '../styles/app-header.css';
import AppHeader from '../components/AppHeader.astro';

const user = Astro.locals.user;
const userEmail = user?.email ?? '';
---

<AppLayout title="ポケガイド" description="ポケモン育成を管理するためのホーム画面" current="home" bodyClass="home-page">
	<div class="page home-page">
		<AppHeader>
			<h1 class="app-header-title">ホーム</h1>
			<div class="home-header-account">
				{
					user ? (
						<details class="home-header-account-menu">
							<summary class="home-header-account-icon home-header-account-icon--authenticated" aria-label={`ログイン中: ${userEmail}`}>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="8" r="4" />
									<path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" />
								</svg>
							</summary>
							<div class="home-header-account-panel">
								<p class="home-account-name">{userEmail}</p>
								<form method="post" action="/api/auth/logout">
									<button type="submit">ログアウト</button>
								</form>
							</div>
						</details>
					) : (
						<a class="home-header-account-icon" href="/api/auth/login" aria-label="Googleでログイン">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
								<path d="M10 17l5-5-5-5" />
								<path d="M15 12H3" />
							</svg>
						</a>
					)
				}
			</div>
		</AppHeader>
		<header class="home-brand">
			<h1>ポケガイド</h1>
		</header>

		<nav class="home-card-grid" aria-label="機能一覧">
			<a class="card home-card" href="/box">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.5 12 3 3 7.5v9L12 21l9-4.5v-9Z"/><path d="M3.5 7.3 12 12l8.5-4.7"/><path d="M12 12v9"/></svg>
				<span class="home-card-label">ボックス</span>
			</a>
			<a class="card home-card" href="/team">
				<svg class="home-card-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><rect x="3.4" y="8.1" width="6.4" height="6.4" rx="1.28"/><rect x="12.8" y="8.1" width="6.4" height="6.4" rx="1.28"/><rect x="22.2" y="8.1" width="6.4" height="6.4" rx="1.28"/><rect x="3.4" y="17.5" width="6.4" height="6.4" rx="1.28"/><rect x="12.8" y="17.5" width="6.4" height="6.4" rx="1.28"/><rect x="22.2" y="17.5" width="6.4" height="6.4" rx="1.28"/></svg>
				<span class="home-card-label">チーム</span>
			</a>
			<span class="card home-card home-card--disabled" aria-disabled="true">
				<svg class="home-card-icon home-card-icon--reduced" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2m4 0h2M8 15h2m4 0h2M8 18h2m4 0h2"/></svg>
				<span class="home-card-label">ダメージ<wbr />計算</span>
			</span>
			<a class="card home-card" href="/data">
				<svg class="home-card-icon home-card-icon--reduced" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
				<span class="home-card-label">バトル<wbr />データ</span>
			</a>
			<a class="card home-card" href="/data?tab=top-builds">
				<svg class="home-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0V4Z"/><path d="M8 6H5v1a4 4 0 0 0 4 4M16 6h3v1a4 4 0 0 1-4 4M12 13v4M8 21h8M9 17h6"/></svg>
				<span class="home-card-label">上位チーム</span>
			</a>
			<a class="card home-card" href="/speed-chart">
				<svg class="home-card-icon home-card-icon--reduced" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
				<span class="home-card-label">すばやさ</span>
			</a>
		</nav>

		<p class="home-contact"><a href="https://x.com/ml7ddw0" target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>お問い合わせ</a></p>
	</div>
</AppLayout>
