---
// Phase 4-2: 検索UI(ポケモン・技・特性・持ち物の横断検索)。
// このページに「最近注目されているもの」表示枠は無い。API本体
// (src/pages/api/suggestions.ts, GET ?kind=trending_search)は他ページからの参照が
// 無いことを確認した上でサーバー側はそのまま残しており、クライアント側のfetch処理だけを
// 持たない。
//
// 設計方針は damage-calc/index.astro を踏襲する:
//   - このページ自体は SSR のプレースホルダー(静的なフォームの描画のみ)。
//   - 検索はすべて下部の <script>(ブラウザ専用)に閉じ込める。
//   - 素のDOM操作(el<T>() ヘルパー)、フレームワーク非導入。
//
// POST /api/search の契約(Phase 4-1で実装済み):
//   Body: { query: string, category?: "pokemon" | "move" | "ability" | "item" }
//   Response: { data: { query, category, hitCount, results: { pokemon, move, ability, item } } }
// 特性・持ち物は詳細ページを作らない(jpokeに説明文データが無いため)ので、
// 検索結果では名前のみ表示しリンクは張らない。
import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/search-page.css';
---
<AppLayout title="検索" bodyClass="search-page">
	<div class="page">
		<section class="panel">
			<div class="panel-content">
				<h2>検索</h2>
				<div class="row">
					<label for="query" hidden>キーワード</label>
					<input id="query" type="text" autocomplete="off" aria-label="キーワード" placeholder="ポケモン名・技名・特性名・持ち物名の一部" />
				</div>
				<div class="row">
					<span>カテゴリ</span>
					<label class="radio-label"><input type="radio" name="category" value="" checked /> すべて</label>
					<label class="radio-label"><input type="radio" name="category" value="pokemon" /> ポケモン</label>
					<label class="radio-label"><input type="radio" name="category" value="move" /> 技</label>
					<label class="radio-label"><input type="radio" name="category" value="ability" /> 特性</label>
					<label class="radio-label"><input type="radio" name="category" value="item" /> 持ち物</label>
				</div>
				<p id="search-status" class="status-text" data-state="idle"></p>
			</div>
		</section>

		<section class="panel" id="results-section" hidden>
			<div class="panel-content">
				<h2>検索結果</h2>
				<div class="result-block" id="result-pokemon-block" hidden>
					<h3>ポケモン</h3>
					<ul id="result-pokemon"></ul>
				</div>
				<div class="result-block" id="result-move-block" hidden>
					<h3>技</h3>
					<ul id="result-move"></ul>
				</div>
				<div class="result-block" id="result-ability-block" hidden>
					<h3>特性</h3>
					<ul id="result-ability"></ul>
				</div>
				<div class="result-block" id="result-item-block" hidden>
					<h3>持ち物</h3>
					<ul id="result-item"></ul>
				</div>
			</div>
		</section>


		<script>

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) {
					throw new Error(`要素が見つかりません: #${id}`);
				}
				return found as T;
			}

			const queryInput = el<HTMLInputElement>("query");
			const statusEl = el<HTMLElement>("search-status");
			const resultsSection = el<HTMLElement>("results-section");

			type SearchCategory = "pokemon" | "move" | "ability" | "item";

			// いずれのカテゴリも詳細ページを持たないため、検索結果では名前のみを表示しリンクは張らない。
			const CATEGORY_CONFIG: Array<{ key: SearchCategory }> = [
				{ key: "pokemon" },
				{ key: "move" },
				{ key: "ability" },
				{ key: "item" },
			];

			const VALID_CATEGORIES = CATEGORY_CONFIG.map((c) => c.key);
			// URLクエリ・sessionStorage経由で受け取る category は不正値の可能性があるため検証する。
			function isValidCategory(value: string): value is SearchCategory {
				return (VALID_CATEGORIES as string[]).includes(value);
			}

			interface SearchResultItem {
				name: string;
			}

			interface SearchResponseData {
				query: string;
				category: SearchCategory | null;
				hitCount: number;
				results: Record<SearchCategory, SearchResultItem[]>;
			}

			function getSelectedCategory(): string {
				const checked = document.querySelector<HTMLInputElement>('input[name="category"]:checked');
				return checked?.value ?? "";
			}

			function setCategoryRadio(category: string): void {
				const target =
					document.querySelector<HTMLInputElement>(`input[name="category"][value="${category}"]`) ??
					document.querySelector<HTMLInputElement>('input[name="category"][value=""]');
				if (target) {
					target.checked = true;
				}
			}

			// 検索状態をURLクエリに反映する。history.pushState は使わない
			// (300msデバウンスの入力ごとに履歴が積もり、戻るボタンが壊れるため)。
			function updateUrlState(query: string, category: string): void {
				const params = new URLSearchParams();
				if (query) params.set("q", query);
				if (category) params.set("category", category);
				const search = params.toString();
				const newUrl = `${location.pathname}${search ? `?${search}` : ""}`;
				history.replaceState(null, "", newUrl);
			}

			// 下部ナビ等でクエリ無しの /search に戻ってきた場合の保険として、
			// sessionStorage にも直近の検索状態を残す(復元優先度: URLクエリ > sessionStorage > 空)。
			const STORAGE_KEY = "poke-commons:search-state";

			interface StoredSearchState {
				query: string;
				category: string;
			}

			function saveSearchState(query: string, category: string): void {
				try {
					sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ query, category }));
				} catch {
					// sessionStorage が使えない環境(プライベートモード等)では諦める。
				}
			}

			function loadSearchState(): StoredSearchState | null {
				try {
					const raw = sessionStorage.getItem(STORAGE_KEY);
					if (!raw) return null;
					const parsed = JSON.parse(raw) as Partial<StoredSearchState>;
					if (typeof parsed.query !== "string") return null;
					return {
						query: parsed.query,
						category: typeof parsed.category === "string" ? parsed.category : "",
					};
				} catch {
					return null;
				}
			}

			function renderResults(data: SearchResponseData | null): void {
				if (!data) {
					resultsSection.hidden = true;
					return;
				}
				let anyVisible = false;
				for (const { key } of CATEGORY_CONFIG) {
					const block = el<HTMLElement>(`result-${key}-block`);
					const list = el<HTMLUListElement>(`result-${key}`);
					const items = data.results[key] ?? [];
					list.innerHTML = "";
					if (items.length === 0) {
						block.hidden = true;
						continue;
					}
					anyVisible = true;
					block.hidden = false;
					for (const item of items) {
						const li = document.createElement("li");
						li.textContent = item.name;
						list.appendChild(li);
					}
				}
				resultsSection.hidden = !anyVisible;
			}

			// 連打・デバウンス後の応答が前後することがあるため、最新のリクエストのみ描画を反映する。
			let searchToken = 0;

			async function runSearch(): Promise<void> {
				const query = queryInput.value.trim();
				if (!query) {
					statusEl.textContent = "";
					renderResults(null);
					updateUrlState("", "");
					saveSearchState("", "");
					return;
				}
				const category = getSelectedCategory();
				const token = ++searchToken;
				statusEl.textContent = "検索中…";
				try {
					const res = await fetch("/api/search", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(category ? { query, category } : { query }),
					});
					if (token !== searchToken) return;
					if (!res.ok) {
						console.error(`検索できませんでした (status=${res.status})`);
						statusEl.textContent = "検索できませんでした。";
						renderResults(null);
						return;
					}
					const body = (await res.json()) as { data: SearchResponseData };
					statusEl.textContent = body.data.hitCount === 0 ? "条件に一致する結果がありません" : `${body.data.hitCount}件`;
					renderResults(body.data);
					// searchToken のチェック(token !== searchToken の早期returnの内側)を通過した、
					// すなわち最新の応答であることを確認した後に replaceState を呼ぶ。
					// 古い(デバウンス中に上書きされた)応答でURLを書き戻さないため。
					updateUrlState(query, category);
					saveSearchState(query, category);
				} catch (err) {
					if (token !== searchToken) return;
					console.error(err);
					statusEl.textContent = "検索できませんでした。";
					renderResults(null);
				}
			}

			let debounceTimer: number | undefined;
			function scheduleSearch(): void {
				if (debounceTimer !== undefined) {
					window.clearTimeout(debounceTimer);
				}
				debounceTimer = window.setTimeout(() => {
					void runSearch();
				}, 300);
			}

			queryInput.addEventListener("input", scheduleSearch);
			document.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((radio) => {
				radio.addEventListener("change", scheduleSearch);
			});

			// --- A-6: 検索状態をURLに読み書きする ---
			// URLクエリ優先 → sessionStorage → 空、の順で復元する。
			function restoreSearchState(): void {
				const params = new URLSearchParams(location.search);
				let query = "";
				let category = "";
				if (params.has("q")) {
					query = params.get("q") ?? "";
					const rawCategory = params.get("category") ?? "";
					category = isValidCategory(rawCategory) ? rawCategory : "";
				} else {
					const stored = loadSearchState();
					if (stored) {
						query = stored.query;
						category = isValidCategory(stored.category) ? stored.category : "";
					}
				}
				if (!query) return;
				queryInput.value = query;
				setCategoryRadio(category);
				void runSearch();
			}

			restoreSearchState();
		</script>
	</div>
</AppLayout>
