---
// Phase 4-2: 検索UI(ポケモン・技・特性・持ち物の横断検索)。
// Phase 4-3: 「最近注目されているもの」表示枠(GET /api/suggestions?kind=trending_search)。
//
// 設計方針は damage-calc/index.astro を踏襲する:
//   - このページ自体は SSR のプレースホルダー(静的なフォームの描画のみ)。
//   - 検索・サジェスト取得はすべて下部の <script>(ブラウザ専用)に閉じ込める。
//   - 素のDOM操作(el<T>() ヘルパー)、フレームワーク非導入。
//
// POST /api/search の契約(Phase 4-1で実装済み):
//   Body: { query: string, category?: "pokemon" | "move" | "ability" | "item" }
//   Response: { data: { query, category, hitCount, results: { pokemon, move, ability, item } } }
// 特性・持ち物は詳細ページを作らない(jpokeに説明文データが無いため)ので、
// 検索結果では名前のみ表示しリンクは張らない。
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="検索">
	<div class="page">
		<section class="panel">
			<div class="panel-content">
				<h2>キーワード検索</h2>
				<div class="row">
					<label for="query">キーワード</label>
					<input id="query" type="text" autocomplete="off" placeholder="ポケモン名・技名・特性名・持ち物名の一部" />
				</div>
				<div class="row">
					<span>カテゴリ</span>
					<label class="radio-label"><input type="radio" name="category" value="" checked /> すべて</label>
					<label class="radio-label"><input type="radio" name="category" value="pokemon" /> ポケモン</label>
					<label class="radio-label"><input type="radio" name="category" value="move" /> 技</label>
					<label class="radio-label"><input type="radio" name="category" value="ability" /> 特性</label>
					<label class="radio-label"><input type="radio" name="category" value="item" /> 持ち物</label>
				</div>
				<p id="search-status" class="status-text" data-state="idle">キーワードを入力してください</p>
			</div>
		</section>

		<section class="panel" id="results-section" hidden>
			<div class="panel-content">
				<h2>検索結果</h2>
				<div class="result-block" id="result-pokemon-block" hidden>
					<h3>ポケモン</h3>
					<ul id="result-pokemon"></ul>
				</div>
				<div class="result-block" id="result-move-block" hidden>
					<h3>技</h3>
					<ul id="result-move"></ul>
				</div>
				<div class="result-block" id="result-ability-block" hidden>
					<h3>特性</h3>
					<ul id="result-ability"></ul>
				</div>
				<div class="result-block" id="result-item-block" hidden>
					<h3>持ち物</h3>
					<ul id="result-item"></ul>
				</div>
			</div>
		</section>

		<section class="panel">
			<div class="panel-content">
				<h2>最近注目されているもの</h2>
				<p class="card-hint">みんなの検索から傾向が見えてくると、ここに表示されます。</p>
				<div id="trending-search">読み込み中...</div>
			</div>
		</section>

		<style>
			h3 { font-size: 1rem; margin-bottom: 0.3rem; }
			/* global.css の `label { min-width: 6.5em }` 撤廃(UI品質改善タスクA)に伴い、
			   キーワード欄のラベル幅をこのページ側で維持する(.radio-labelは対象外)。 */
			.row > label:not(.radio-label) {
				min-width: 6.5em;
				font-size: var(--font-size-sm);
				font-weight: 600;
				color: var(--color-text-muted);
			}
			.radio-label { min-width: auto; font-weight: normal; margin-right: 1rem; }
			.result-block { margin: 0.8rem 0; }
			.result-block ul { padding-left: 1.2em; }
			/* B-6: キーワード入力欄が .panel-content(1080px)の中で207pxのまま伸びず、
			   placeholderが「特性」で切れていた。.row (global.css) はflex-wrapのみで
			   flex-directionをcolumnに切り替えないため、#queryの伸長がそのまま横幅に
			   反映される。 */
			#query { flex: 1 1 320px; max-width: 36rem; }
			/* pitfalls.md: `flex: 1 1 320px` は縦積み(flex-direction: column)に切り替わる
			   ブレークポイントでflex-basisが主軸=高さの基準として解釈され、入力欄が320px
			   まで伸びる事故が/boxのツールバーで実際に起きた。.rowはこのページでは常に
			   flex-direction: row(columnへの切り替えを持たない)ため実害は無いはずだが、
			   将来の回帰に備えて同じガードをここにも置く。 */
			@media (max-width: 640px) {
				#query { flex-basis: auto; }
			}
		</style>
		<style is:global>
			/* 以下の2ルールは document.createElement() で生成する要素(検索結果の<a>と
			   サジェスト空状態の<p>)に適用する。Astroの scoped style は data-astro-cid-*
			   属性が付いた要素にしか効かず、JSで生成した要素には付与されないため、
			   上の scoped <style> に書いても効かない(scopedのまま詳細度を上げても直らない)。
			   このページ内で一意な id (#results-section / #trending-search) を前置し、
			   他ページへスコープが漏れないようにする。 */
			#results-section .result-block a { text-decoration: none; }
			#results-section .result-block a:hover { text-decoration: underline; }
			#trending-search .suggestion-empty { color: var(--color-text-muted); font-style: italic; }
		</style>

		<script>
			import { toPokemonPathSegment } from "../../lib/pokemon-slug";

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) {
					throw new Error(`要素が見つかりません: #${id}`);
				}
				return found as T;
			}

			const queryInput = el<HTMLInputElement>("query");
			const statusEl = el<HTMLElement>("search-status");
			const resultsSection = el<HTMLElement>("results-section");
			const trendingEl = el<HTMLElement>("trending-search");

			type SearchCategory = "pokemon" | "move" | "ability" | "item";

			// linkBase が null のカテゴリ(特性・持ち物)は詳細ページを作らないため、
			// 検索結果では名前のみを表示しリンクを張らない。
			const CATEGORY_CONFIG: Array<{ key: SearchCategory; linkBase: string | null }> = [
				{ key: "pokemon", linkBase: "/pokemon/" },
				{ key: "move", linkBase: "/moves/" },
				{ key: "ability", linkBase: null },
				{ key: "item", linkBase: null },
			];

			const VALID_CATEGORIES = CATEGORY_CONFIG.map((c) => c.key);
			// URLクエリ・sessionStorage経由で受け取る category は不正値の可能性があるため検証する。
			function isValidCategory(value: string): value is SearchCategory {
				return (VALID_CATEGORIES as string[]).includes(value);
			}

			interface SearchResultItem {
				name: string;
			}

			interface SearchResponseData {
				query: string;
				category: SearchCategory | null;
				hitCount: number;
				results: Record<SearchCategory, SearchResultItem[]>;
			}

			function getSelectedCategory(): string {
				const checked = document.querySelector<HTMLInputElement>('input[name="category"]:checked');
				return checked?.value ?? "";
			}

			function setCategoryRadio(category: string): void {
				const target =
					document.querySelector<HTMLInputElement>(`input[name="category"][value="${category}"]`) ??
					document.querySelector<HTMLInputElement>('input[name="category"][value=""]');
				if (target) {
					target.checked = true;
				}
			}

			// 検索状態をURLクエリに反映する。history.pushState は使わない
			// (300msデバウンスの入力ごとに履歴が積もり、戻るボタンが壊れるため)。
			function updateUrlState(query: string, category: string): void {
				const params = new URLSearchParams();
				if (query) params.set("q", query);
				if (category) params.set("category", category);
				const search = params.toString();
				const newUrl = `${location.pathname}${search ? `?${search}` : ""}`;
				history.replaceState(null, "", newUrl);
			}

			// /pokemon /moves は静的プリレンダリングのため backHref (常に "/search") に
			// 検索語を焼き込めない。ブラウザバックでURLそのものが失われるケースの保険として、
			// sessionStorage にも直近の検索状態を残す(復元優先度: URLクエリ > sessionStorage > 空)。
			const STORAGE_KEY = "poke-commons:search-state";

			interface StoredSearchState {
				query: string;
				category: string;
			}

			function saveSearchState(query: string, category: string): void {
				try {
					sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ query, category }));
				} catch {
					// sessionStorage が使えない環境(プライベートモード等)では諦める。
				}
			}

			function loadSearchState(): StoredSearchState | null {
				try {
					const raw = sessionStorage.getItem(STORAGE_KEY);
					if (!raw) return null;
					const parsed = JSON.parse(raw) as Partial<StoredSearchState>;
					if (typeof parsed.query !== "string") return null;
					return {
						query: parsed.query,
						category: typeof parsed.category === "string" ? parsed.category : "",
					};
				} catch {
					return null;
				}
			}

			function renderResults(data: SearchResponseData | null): void {
				if (!data) {
					resultsSection.hidden = true;
					return;
				}
				let anyVisible = false;
				for (const { key, linkBase } of CATEGORY_CONFIG) {
					const block = el<HTMLElement>(`result-${key}-block`);
					const list = el<HTMLUListElement>(`result-${key}`);
					const items = data.results[key] ?? [];
					list.innerHTML = "";
					if (items.length === 0) {
						block.hidden = true;
						continue;
					}
					anyVisible = true;
					block.hidden = false;
					for (const item of items) {
						const li = document.createElement("li");
						if (linkBase) {
							const a = document.createElement("a");
							// ポケモン名の一部("ジガルデ(50%)"等)はURLパスセグメントとして
							// そのまま使えないため、詳細ページ側と同じ変換をここでも通す
							// (src/lib/pokemon-slug.ts 参照)。技名には該当する例外は無い。
							const pathSegment = key === "pokemon" ? toPokemonPathSegment(item.name) : item.name;
							a.href = linkBase + encodeURIComponent(pathSegment);
							a.textContent = item.name;
							li.appendChild(a);
						} else {
							li.textContent = item.name;
						}
						list.appendChild(li);
					}
				}
				resultsSection.hidden = !anyVisible;
			}

			// 連打・デバウンス後の応答が前後することがあるため、最新のリクエストのみ描画を反映する。
			let searchToken = 0;

			async function runSearch(): Promise<void> {
				const query = queryInput.value.trim();
				if (!query) {
					statusEl.textContent = "キーワードを入力してください";
					renderResults(null);
					updateUrlState("", "");
					saveSearchState("", "");
					return;
				}
				const category = getSelectedCategory();
				const token = ++searchToken;
				statusEl.textContent = "検索中...";
				try {
					const res = await fetch("/api/search", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(category ? { query, category } : { query }),
					});
					if (token !== searchToken) return;
					if (!res.ok) {
						statusEl.textContent = `検索に失敗しました (status=${res.status})`;
						renderResults(null);
						return;
					}
					const body = (await res.json()) as { data: SearchResponseData };
					statusEl.textContent = body.data.hitCount === 0 ? "該当なし" : `${body.data.hitCount}件ヒットしました`;
					renderResults(body.data);
					// searchToken のチェック(token !== searchToken の早期returnの内側)を通過した、
					// すなわち最新の応答であることを確認した後に replaceState を呼ぶ。
					// 古い(デバウンス中に上書きされた)応答でURLを書き戻さないため。
					updateUrlState(query, category);
					saveSearchState(query, category);
				} catch (err) {
					if (token !== searchToken) return;
					console.error(err);
					statusEl.textContent = "検索に失敗しました";
					renderResults(null);
				}
			}

			let debounceTimer: number | undefined;
			function scheduleSearch(): void {
				if (debounceTimer !== undefined) {
					window.clearTimeout(debounceTimer);
				}
				debounceTimer = window.setTimeout(() => {
					void runSearch();
				}, 300);
			}

			queryInput.addEventListener("input", scheduleSearch);
			document.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((radio) => {
				radio.addEventListener("change", scheduleSearch);
			});

			// --- Phase 4-3: 「最近注目されているもの」表示枠 ---
			// suggestions テーブルは Phase 5 まで空のため、空状態表示になる
			// (damage-calc/index.astro のサジェスト空枠と同じパターン)。
			interface SuggestionItem {
				kind: string;
				subject_key: string;
				payload: unknown;
				computed_at: string;
			}

			async function loadTrendingSearches(): Promise<void> {
				try {
					const res = await fetch("/api/suggestions?kind=trending_search&limit=10", {
						credentials: "same-origin",
					});
					if (!res.ok) {
						console.warn(`サジェスト取得に失敗しました (status=${res.status})`);
						trendingEl.textContent = "読み込みに失敗しました";
						return;
					}
					const body = (await res.json()) as { data?: SuggestionItem[] };
					const items = body.data ?? [];
					trendingEl.innerHTML = "";
					if (items.length === 0) {
						const p = document.createElement("p");
						p.className = "suggestion-empty";
						p.textContent = "まだデータがありません(集合知はこれから育っていきます)";
						trendingEl.appendChild(p);
						return;
					}
					const ul = document.createElement("ul");
					for (const item of items) {
						const li = document.createElement("li");
						li.textContent = JSON.stringify(item.payload);
						ul.appendChild(li);
					}
					trendingEl.appendChild(ul);
				} catch (err) {
					console.warn("サジェスト取得に失敗しました", err);
					trendingEl.textContent = "読み込みに失敗しました";
				}
			}

			void loadTrendingSearches();

			// --- A-6: 検索状態をURLに読み書きする ---
			// /search は /pokemon /moves の唯一の入口であり、両詳細ページの backHref="/search" が
			// 指す唯一の戻り先。URLクエリ優先 → sessionStorage → 空、の順で復元することで、
			// 「検索 → 詳細を開く → 戻る」で検索語と結果が失われないようにする。
			function restoreSearchState(): void {
				const params = new URLSearchParams(location.search);
				let query = "";
				let category = "";
				if (params.has("q")) {
					query = params.get("q") ?? "";
					const rawCategory = params.get("category") ?? "";
					category = isValidCategory(rawCategory) ? rawCategory : "";
				} else {
					const stored = loadSearchState();
					if (stored) {
						query = stored.query;
						category = isValidCategory(stored.category) ? stored.category : "";
					}
				}
				if (!query) return;
				queryInput.value = query;
				setCategoryRadio(category);
				void runSearch();
			}

			restoreSearchState();
		</script>
	</div>
</AppLayout>
