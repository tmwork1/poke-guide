---
// Phase 4-2: ポケモン詳細ページ。
// public/master-data/detail/pokemon.json はビルド時に確定する静的データ(DB非依存)なので
// getStaticPaths() でビルド時に全ページを事前生成する(damage-calc/builds のような
// DB依存の動的ルートとは異なり prerender=false は付けない。このプロジェクトの既定出力モードは
// static なので、何も指定しなければ自動的に事前生成される)。
// 該当ポケモンが存在しない name は getStaticPaths() の対象外になるため自然に404になる。
//
// UI改善ラウンド13(round-09.md A-3/A-4/A-5): /box が確立した「公式絵+タイプアイコン」
// 「H/A/B/C/D/Sの6列グリッド+.tnum」の語彙をこのページに移植する。
// - identity block(タイプ/覚えられる特性/進化前を1枚に統合、公式絵+タイプアイコンを追加)
// - 種族値を素のtableから7列グリッド(4.5rem repeat(6, minmax(0,1fr)))に置き換え
// - 覚えられる技を6列グリッド化し、タイプ一致(STAB)技を先頭に固める
// 画像URLはどちらも純粋関数(officialArtworkUrl/typeIconUrl)なのでフロントマターで解決し、
// 静的HTMLに焼く(クライアントJSは不要)。
import pokemonDetailRaw from '../../../public/master-data/detail/pokemon.json';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import movesDetailRaw from '../../../public/master-data/detail/moves.json';
import { toPokemonPathSegment } from '../../lib/pokemon-slug';
import { officialArtworkUrl } from '../../lib/pokemon-master-data';
import { typeIconUrl } from '../../lib/sprite-urls';
// C-3: タイプ絞り込みの選択肢の並び順に使う(18タイプの正準順序)。このファイルは読むだけで
// 編集しない(src/lib/type-chart.ts はround-13でsrc/pages/moves/[name].astroが新設した
// 読み取り専用の18×18タイプ相性表)。
import { TYPE_CHART } from '../../lib/type-chart';
import AppLayout from '../../layouts/AppLayout.astro';

interface PokemonDetail {
	name: string;
	types: string[];
	// [HP, 攻撃, 防御, 特攻, 特防, 素早さ]
	baseStats: number[];
	abilities: string[];
	learnset: string[];
	preEvolution: string | null;
}

// scripts/build-master-data が生成する pokemon.json は図鑑インデックスをキーにしたオブジェクト
// (name はキーではなく値の中のフィールド)なので、静的パス生成には Object.values() を使う。
// (Cloudflareアダプタのprerender用ワーカーが getStaticPaths を単独抽出する際、
// モジュールスコープの中間変数を経由すると参照が失われるため、関数内で直接組み立てる)
// params.name は toPokemonPathSegment() を通した「URLパスセグメント用」の値
// (ジガルデ(50%)等の"%"を含む2件のみ、生の"%"がCloudflareアダプタのprerender時に
// 不正なパーセントエンコーディング扱いされビルドが失敗するための回避)。
// ページ内の表示名は props.pokemon.name(元データそのまま)を使うので影響しない。
export function getStaticPaths() {
	const pokemonDetail = pokemonDetailRaw as Record<string, PokemonDetail>;
	return Object.values(pokemonDetail).map((pokemon) => ({
		params: { name: toPokemonPathSegment(pokemon.name) },
		props: { pokemon },
	}));
}

interface Props {
	pokemon: PokemonDetail;
}

const { pokemon } = Astro.props as Props;

const STAT_COLUMN_LABELS: string[] = ['H', 'A', 'B', 'C', 'D', 'S'];

// autocomplete/pokemon.json: dexNo(図鑑番号)+imageId(公式絵のPokeAPI ID、メガシンカ等の
// 特殊フォルムはベース種族と異なるIDを持つ)を name で引く。
interface PokemonMasterEntry {
	name: string;
	dexNo: number;
	imageId: number;
	forme: string | null;
	types: string[];
}
const pokemonMasterMap = new Map(
	(pokemonMasterRaw as PokemonMasterEntry[]).map((p) => [p.name, p]),
);
const masterEntry = pokemonMasterMap.get(pokemon.name) ?? null;
// 図鑑番号は3桁ゼロ埋め("No.006")。masterEntry が見つからない場合は行ごと出さない。
const dexNoLabel = masterEntry ? String(masterEntry.dexNo).padStart(3, '0') : null;
const artworkUrl = masterEntry ? officialArtworkUrl(masterEntry.imageId) : null;

// detail/moves.json: 技名から type/category/power を引き、learnset を「タイプ一致技が先頭」に
// 並べ替える。新規データ生成は不要(既存の全件保持データをjoinするだけ)。
type MoveCategory = 'physical' | 'special' | 'status';
interface MoveDetail {
	name: string;
	type: string | null;
	category: MoveCategory;
	power: number | null;
	accuracy: number | null;
	pp: number;
	priority: number;
	critRatio: number;
	target: string;
}
const movesDetailMap = new Map((movesDetailRaw as MoveDetail[]).map((m) => [m.name, m]));

interface LearnsetMoveInfo {
	name: string;
	type: string | null;
	category: MoveCategory;
	power: number | null;
	isStab: boolean;
}
const learnsetMoves: LearnsetMoveInfo[] = pokemon.learnset.map((name) => {
	const detail = movesDetailMap.get(name);
	const type = detail?.type ?? null;
	return {
		name,
		type,
		// C-3の絞り込みに使う分類。detail/moves.json全716件はlearnsetの全参照(全1290種・
		// 73362件)を100%カバーしている(欠落0件、node で実測確認済み)ため、
		// フォールバックの'status'は実際には発生しない防御的な既定値。
		category: detail?.category ?? 'status',
		power: detail?.power ?? null,
		isStab: type !== null && pokemon.types.includes(type),
	};
});
// タイプ一致(STAB)技を先頭に固める。Array.prototype.sort はES2019以降で安定ソートが仕様上
// 保証されているため、isStabのみをキーにした比較で同グループ内の相対順序(learnsetの元順序)が保たれる。
const sortedLearnsetMoves = [...learnsetMoves].sort((a, b) => Number(b.isStab) - Number(a.isStab));

// C-3: タイプ・分類フィルタの選択肢。このポケモンのlearnsetに実在するタイプだけを候補にする
// (18タイプ全部を出すと大半が「該当技0件」になり選択肢として無意味なため)。並び順は
// src/lib/type-chart.tsのキー順(18タイプの正準順序)に合わせ、出現順のようなランダムさを避ける。
// このポケモンのlearnsetにタイプ無し技(わるあがき等)は1件も含まれない
// (全1290種のlearnset実データで確認済み。type: nullの技はそもそもlearnsetに現れない)ため、
// 「タイプなし」の選択肢は用意しない。
const TYPE_ORDER = Object.keys(TYPE_CHART);
const learnsetTypeOptions = [...new Set(learnsetMoves.map((m) => m.type).filter((t): t is string => t !== null))].sort(
	(a, b) => TYPE_ORDER.indexOf(a) - TYPE_ORDER.indexOf(b),
);

// B-9: 「進化後」の逆引きマップ。pokemon.jsonの各エントリはpreEvolution(自分の進化元)しか
// 持たないため、「自分の進化先」(イーブイのように複数のことがある)を得るには全1290件を
// ビルド時に1回走査して逆引きするだけでよい(round-09.md B-9の指示どおり、追加データ生成は
// 不要)。preEvolutionを持つエントリが1件も無いキーはMapに現れないため、
// evolutionForwardMap.get(pokemon.name) が undefined になるケース(進化後が無い)を
// 空配列にフォールバックして扱う。
const evolutionForwardMap = new Map<string, string[]>();
for (const p of Object.values(pokemonDetailRaw as Record<string, PokemonDetail>)) {
	if (p.preEvolution) {
		const siblings = evolutionForwardMap.get(p.preEvolution);
		if (siblings) {
			siblings.push(p.name);
		} else {
			evolutionForwardMap.set(p.preEvolution, [p.name]);
		}
	}
}
const postEvolutions = evolutionForwardMap.get(pokemon.name) ?? [];

// B-1: 種族値グリッドに実数(無振)・実数(全振)の2行を追加する。
// 計算式の出典: src/pages/box/index.astro の chmpToLegacyEffort/calcHpStat/calcOtherStat
// (2026-07-27時点でL744-755付近。box/index.astroは今ラウンド編集禁止のためコピーで進める。
// /share/[slug].astroに続き3箇所目のコピーになる件はround-09.md A-2/round-13.mdで
// 「次ラウンドでsrc/lib/stats.tsへ統合する」と積み残し済み)。
// vendor/jpoke/src/jpoke/model/stats.py の calc_hp/calc_stat/chmp_to_legacy_effort と
// 完全に同じ式であることは .claude/skills/jpoke/references/ruleset.md
// 「1. チャンピオンズルール」「2. 実数値の計算式」に出典つきで要約済み。
// 0〜32スケール→素の努力値の変換式は 8n-4(n=0のときだけ0)であって単純な×8ではない点に注意。
//
// 【性格補正の扱い(このページ独自の判断)】このページは「種族(ポケモン単体)」の基礎データを
// 示す画面であり、box/[id].astroや/shareのような「特定の性格を持つ個体」を扱わない。
// 26通りの性格それぞれの▲▼を7列グリッドに全部並べるのは現実的でないため、
// 性格補正なし(nc=1.0固定)の値のみを出す。ただし「これが何の値か」が画面から読み取れないと
// 誤読される(例: 「実数値」とだけ書くと個体値・努力値・性格まで含めた最終値だと誤解されうる)
// ため、行ラベルに「(無振/全振)」を付けたうえで、直後にヒント文で
// 「性格補正なし・個体値31・Lv50」であることを明示する。
const LEVEL = 50;
const IV = 31;
function chmpToLegacyEffort(evChamp: number): number {
	return evChamp === 0 ? 0 : 8 * evChamp - 4;
}
function calcHpStat(base: number, evChamp: number): number {
	if (base === 1) return 1; // ヌケニン特例(vendor/jpoke/src/jpoke/model/stats.pyと同じ)
	const effort = chmpToLegacyEffort(evChamp);
	return Math.floor(((base * 2 + IV + Math.floor(effort / 4)) * LEVEL) / 100) + LEVEL + 10;
}
function calcOtherStat(base: number, evChamp: number): number {
	const effort = chmpToLegacyEffort(evChamp);
	// nc(性格補正)は上記コメントのとおり常に1.0(補正なし)。
	return Math.floor((Math.floor(((base * 2 + IV + Math.floor(effort / 4)) * LEVEL) / 100) + 5) * 1.0);
}
function realStatRow(evChamp: number): number[] {
	return pokemon.baseStats.map((base, i) => (i === 0 ? calcHpStat(base, evChamp) : calcOtherStat(base, evChamp)));
}
const realStatsNoEv = realStatRow(0);
const realStatsMaxEv = realStatRow(32);
---
<AppLayout title={pokemon.name} backHref="/search" backLabel="検索に戻る">
	<style>
		/* --- identity block(A-3): タイプ/覚えられる特性/進化前を1枚に統合し、
		   右に公式絵+タイプアイコンを添える(docs/ui_proposal/個体編集.png の
		   「縦積み + 右に公式絵 + タイプ画像」を踏襲)。 */
		.identity-block {
			display: flex;
			flex-wrap: wrap;
			align-items: flex-start;
			gap: var(--space-6);
		}
		.identity-info {
			flex: 1 1 320px;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
		}
		.identity-dexno {
			margin: 0;
			font-size: var(--font-size-sm);
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.identity-field-label {
			margin: 0 0 var(--space-2);
			font-size: var(--font-size-sm);
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.identity-type-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.identity-type-chip {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			padding: 0.2em 0.7em 0.2em 0.3em;
			border-radius: 999px;
			background: var(--color-surface-alt);
			font-weight: 600;
		}
		.identity-type-chip img {
			display: block;
			border-radius: 50%;
		}
		.identity-plain-list {
			margin: 0;
			padding-left: 1.2em;
		}
		.identity-pre-evolution {
			margin: 0;
		}
		.identity-artwork {
			flex: 0 0 auto;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 160px;
			height: 160px;
			margin-left: auto;
		}
		.identity-artwork img {
			display: block;
			max-width: 100%;
			max-height: 100%;
		}
		@media (max-width: 640px) {
			.identity-artwork {
				margin-left: 0;
			}
		}

		/* --- 種族値(A-5): 素のtableを捨て、行ラベル1列+H/A/B/C/D/Sの7列グリッドに統一。
		   /box の実数値グリッドと同じ「行優先」DOM。このページ専用のscopedクラス名で新設し、
		   /box のクラス名は流用しない。 */
		.stat-grid {
			display: flex;
			flex-direction: column;
		}
		.stat-grid-row {
			display: grid;
			grid-template-columns: 4.5rem repeat(6, minmax(0, 1fr));
			align-items: center;
			padding: var(--space-2) 0;
		}
		.stat-grid-row + .stat-grid-row {
			border-top: 1px solid var(--color-border);
		}
		.stat-grid-label {
			font-weight: 700;
			font-size: 0.85em;
			color: var(--color-text-muted);
		}
		.stat-grid-col-label {
			text-align: center;
			font-size: 0.8em;
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.stat-grid-value {
			text-align: center;
			font-size: 1.05em;
			font-weight: 700;
		}
		/* B-1: 実数(無振)/実数(全振)行の直後の注記。汎用クラス.card-hintは
		   「見出し直下に置く」前提でmargin-topが負値なので、見出しではなくグリッドの直後に
		   置くこのページのケースでは(/shareが同じ罠を踏んだ前例どおり)グローバル側は変えず
		   ページscopedのクラスとして別途用意する(.card-hintを流用して打ち消すのではなく、
		   最初から見出し依存の前提を持たない専用クラスにした)。 */
		.stat-grid-hint {
			margin: var(--space-3) 0 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}

		/* --- 覚えられる技(A-4→ラウンド13後の是正): 6列(1セル173px)では技名が省略され、
		   「ほのおのうず/ほのおのキバ/ほのおのちかい」のような別の技が区別できなくなっていた。
		   public/master-data/detail/moves.json 全716件の技名は最長でも8文字(全角カナ)で、
		   実測(.move-cell-name のフォントでの自然幅)では8文字名の最大が128px。
		   さらに「8文字名+タイプ一致★+3桁威力(例: アストラルビット★120)」という実在する
		   最悪ケースを実際にDOMへ組んで測ると a要素の必要幅は約207px(206.8px)。
		   minmax(168px,...)ではこれより38px以上も狭く、省略が起きて当然だった。
		   → 1080px幅・gap 8pxでの auto-fill の列数はブレークポイントがあり、
		   minmax(209px,1fr)までは5列(1セル209.6px、最悪ケースとの余裕は2.8pxしかない)、
		   minmax(210px,1fr)から4列(1セル264px)に切り替わる。2.8pxはOS/ブラウザの
		   フォントレンダリング差(サブピクセル丸め等)で再び省略が起きかねない薄い余裕なので、
		   あえて4列側(minmax(210px,1fr))を選び、最悪ケースに対して57pxの余裕を確保した。
		   列数を5にすること自体が目的ではなく「技名が省略されないこと」が目的
		   (実測は .tmp-pkfix-* スクリプトで検証、結果は報告に記載)。
		   タイプ一致技は背景色+★マーク(role="img" aria-label)で視覚的な印を付ける
		   (色だけに頼らない、WCAG 1.4.1対応。この表現は変更しない)。 */
		/* --- C-3: タイプ・分類フィルタ。round-13で4列化した技一覧がミュウ(301件)で
		   3648pxまで伸びた問題を、畳まずに解くための絞り込みUI。 */
		.moves-filter {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-2) var(--space-5);
			margin-bottom: var(--space-4);
		}
		.moves-filter-field {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}
		.moves-filter-label {
			font-size: var(--font-size-sm);
			font-weight: 700;
			color: var(--color-text-muted);
		}
		/* B-5: 「分類」フィルタをセレクト(実測94px、開かないと選択肢が見えない)からラジオへ変更。
		   /search の「カテゴリ」5択(.radio-label、実測418px)と全く同じ語彙を使う。
		   .radio-label は global.css ではなく src/pages/search/index.astro のscoped styleにしか
		   無い(このページとは別ファイルなので継承されない)ため、ここに同じ内容を複製する。
		   「タイプ」は13〜18択で概算1150〜1600px超のため意図的にセレクトのまま維持する
		   (round-15.md B-5: ラジオ化するとここだけ折り返し、状態異常7択アイコントグル化が
		   同ラウンド内で撤回された前例と同型になるため)。 */
		.moves-filter-field-radio {
			flex-wrap: wrap;
		}
		.moves-filter-field-radio .radio-label {
			display: inline-flex;
			align-items: center;
			min-width: auto;
			margin-right: 1rem;
			font-weight: normal;
			font-size: var(--font-size-md);
			color: var(--color-text);
		}
		.moves-filter-field-radio .radio-label:last-child {
			margin-right: 0;
		}
		.moves-filter-count {
			margin: 0 0 0 auto;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}
		/* B-1: ★(タイプ一致)の可視凡例。role="img" aria-labelはスクリーンリーダー限定で、
		   目視ユーザーは★の意味を推測するしかなかった。フィルタ行の直後に1行で説明する。
		   .card-hintは「見出し直下に置く」前提でmargin-topが負値なので、見出しではなく
		   .moves-filterの直後に置くここでは(.stat-grid-hintと同じ理由で)使わずページscopedの
		   専用クラスにする。 */
		.moves-legend-hint {
			margin: 0 0 var(--space-4);
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}
		.moves-legend-hint .move-cell-stab {
			margin-right: 0.2em;
		}
		/* 絞り込み結果0件の表示。document.createElement()で作らず最初から静的HTMLに置いておき、
		   JSはhidden属性を切り替えるだけにする(scoped styleが効かない罠の回避、上記script参照)。
		   ダッシュの羅列ではなく文章で「0件である」ことを明示し、データ破損に見えないようにする。 */
		.moves-empty-state {
			margin: 0;
			padding: var(--space-5);
			text-align: center;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
			background: var(--color-surface-alt);
			border-radius: var(--radius-sm);
		}
		.moves-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
			gap: 0.4rem var(--space-2);
			list-style: none;
			margin: 0;
			padding: 0;
		}
		/* 1セル=1行(タイプアイコン+技名+[一致バッジ]+威力)。当初は名前行/威力行の2段組みだったが、
		   実測したところ ul の高さが 921px(旧2カラム版)→890px(2段組み6カラム版)とほぼ縮まなかった
		   (行数は36→12に減ったが1行の高さが約3倍になり相殺されたため)。1段組みに変更して
		   1行の高さを詰め、行数を減らした効果がそのまま高さ削減に反映されるようにした。 */
		.move-cell a {
			display: flex;
			align-items: center;
			gap: 0.35em;
			height: 100%;
			padding: 0.28em 0.55em;
			border-radius: var(--radius-sm);
			background: var(--color-surface-alt);
			color: var(--color-text);
			text-decoration: none;
		}
		.move-cell.is-stab a {
			background: var(--color-primary-soft);
		}
		.move-cell a:hover,
		.move-cell a:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: -2px;
		}
		.move-cell-icon {
			flex: 0 0 auto;
			display: block;
		}
		.move-cell-name {
			flex: 1 1 auto;
			min-width: 0;
			font-weight: 600;
			font-size: 0.92em;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* タイプ一致(STAB)の視覚的な印。背景色の違いだけに頼らない(WCAG 1.4.1)ための★マーク。
		   スクリーンリーダー向けには aria-label で「タイプ一致」を読み上げさせ、
		   グリフ自体は aria-hidden にする(◎「一致」の2文字テキストバッジだと技名の表示幅を
		   圧迫し省略記号が多発したため、1グリフの★に差し替えて幅を確保した)。 */
		.move-cell-stab {
			flex: 0 0 auto;
			font-size: 0.95em;
			line-height: 1;
			color: var(--color-primary);
		}
		.move-cell-power {
			flex: 0 0 auto;
			min-width: 1.6em;
			font-weight: 700;
			font-size: 0.85em;
			color: var(--color-text-muted);
			text-align: right;
		}
		/* 変化技は「威力」という概念自体を持たないデータ(未設定ではない)。
		   数値スロットに "-" を並べると空欄スロットに見え「データ破損」に読める
		   (docs/plan/ui_rounds/round-02.md B-1の教訓)。数値ではないので tabular-nums
		   (.tnum)も外し、通常の文字幅で「変化」という区分名そのものを表示することで
		   「威力の代わりに区分を示している」ことを明示する(物理/特殊とは違い技グリッド上に
		   区分表示が無いので、変化技だけはここで区分名を出す)。 */
		.move-cell-power-status {
			font-weight: 600;
			font-size: 0.78em;
		}
	</style>
	<div class="page">
		<section class="panel">
			<div class="panel-content">
				<h2>基本情報</h2>
				<div class="identity-block">
					<div class="identity-info">
						{dexNoLabel && <p class="identity-dexno tnum">No.{dexNoLabel}</p>}
						<div>
							<h3 class="identity-field-label">タイプ</h3>
							<ul class="identity-type-list">
								{pokemon.types.map((t) => {
									const iconUrl = typeIconUrl(t);
									return (
										<li class="identity-type-chip">
											{iconUrl && <img src={iconUrl} width="28" height="28" alt="" />}
											<span>{t}</span>
										</li>
									);
								})}
							</ul>
						</div>
						<div>
							<h3 class="identity-field-label">覚えられる特性</h3>
							{pokemon.abilities.length > 0 ? (
								<ul class="identity-plain-list">
									{pokemon.abilities.map((a) => <li>{a}</li>)}
								</ul>
							) : (
								<p class="card-hint">データなし</p>
							)}
						</div>
						<div>
							<h3 class="identity-field-label">進化前</h3>
							{pokemon.preEvolution ? (
								<p class="identity-pre-evolution">
									<a href={`/pokemon/${encodeURIComponent(toPokemonPathSegment(pokemon.preEvolution))}`}>{pokemon.preEvolution}</a>
								</p>
							) : (
								<p class="card-hint">なし</p>
							)}
						</div>
						<div>
							{/* B-9: 進化後(逆引きマップの結果)。イーブイのように複数いるケースは
							    リンクの箇条書きにする(進化前と同じ<ul class="identity-plain-list">の型を再利用)。
							    0件のときは「-」やダッシュの羅列ではなく「進化前」と同じ"なし"の1行にし、
							    データ破損に見えないようにする(空のパネルも作らない)。 */}
							<h3 class="identity-field-label">進化後</h3>
							{postEvolutions.length > 0 ? (
								<ul class="identity-plain-list">
									{postEvolutions.map((name) => (
										<li>
											<a href={`/pokemon/${encodeURIComponent(toPokemonPathSegment(name))}`}>{name}</a>
										</li>
									))}
								</ul>
							) : (
								<p class="card-hint">なし</p>
							)}
						</div>
					</div>
					{artworkUrl && (
						<div class="identity-artwork">
							<img src={artworkUrl} width="160" height="160" alt={`${pokemon.name}の公式絵`} loading="lazy" />
						</div>
					)}
				</div>
			</div>
		</section>

		<section class="panel">
			<div class="panel-content">
				<h2>種族値</h2>
				<div class="stat-grid">
					<div class="stat-grid-row">
						<span class="stat-grid-label" aria-hidden="true"></span>
						{STAT_COLUMN_LABELS.map((label) => <span class="stat-grid-col-label">{label}</span>)}
					</div>
					<div class="stat-grid-row">
						<span class="stat-grid-label">種族値</span>
						{pokemon.baseStats.map((v) => <span class="stat-grid-value tnum">{v}</span>)}
					</div>
					<div class="stat-grid-row">
						<span class="stat-grid-label">実数(無振)</span>
						{realStatsNoEv.map((v) => <span class="stat-grid-value tnum">{v}</span>)}
					</div>
					<div class="stat-grid-row">
						<span class="stat-grid-label">実数(全振)</span>
						{realStatsMaxEv.map((v) => <span class="stat-grid-value tnum">{v}</span>)}
					</div>
				</div>
				<p class="stat-grid-hint">実数値は性格補正なし(&times;1.0)・個体値31・Lv50固定(チャンピオンズルール)で計算。無振=努力値0、全振=努力値32。実際に性格を選ぶと&plusmn;10%前後で変動する。</p>
			</div>
		</section>

		<section class="panel">
			<div class="panel-content">
				<h2>覚えられる技({pokemon.learnset.length}種)</h2>
				{/* B-8: /moves側は0件時に「現在のデータでは」と限定しているのに、このページの
				    見出しには限定表現が無かった。learnsetの実体はポケモンチャンピオンズの
				    フォーマット固有データ(vendor/jpoke/src/jpoke/data/ps-champ-ja/learnsets.json)で
				    あって全世代の技マシン・遺伝技を網羅したものではない
				    (.claude/skills/jpoke/references/integration.md「learnsetは『チャンピオンズで
				    覚えられる技』であって全世代の技ではない」節)。見出し直下なので.card-hintの
				    負のmargin-top(見出し直下に置く前提)がそのまま成立する。 */}
				<p class="card-hint">現在のデータ(ポケモンチャンピオンズ)で覚えられる技のみを表示しています。全世代の技マシン・遺伝技を網羅した一覧ではありません。</p>
				{sortedLearnsetMoves.length > 0 ? (
					<>
						{/* C-3: タイプ・分類フィルタ。round-13で技一覧を4列化した結果ミュウ(301件)で
						    ページが3648pxまで伸びたため、round-13.mdの判断(「畳むのではなくC-3で解く」)
						    どおりに絞り込みを追加する(「畳む」実装は禁止・再提起もしないため不採用)。
						    データはdetail/moves.jsonから既にjoin済みなので追加データ生成は不要。
						    選択肢はこのポケモンのlearnsetに実在するタイプ・分類のみ。
						    B-5: 「分類」はround-15.mdの実測(/search 5択418px、4択概算306px)に基づき
						    セレクトからラジオへ変更。「タイプ」は13〜18択で折り返す(概算1150〜1600px超)
						    ため意図的にセレクトのまま維持する。 */}
						<div class="moves-filter">
							<div class="moves-filter-field">
								<label for="moves-filter-type" class="moves-filter-label">タイプ</label>
								<select id="moves-filter-type">
									<option value="">すべて</option>
									{learnsetTypeOptions.map((t) => <option value={t}>{t}</option>)}
								</select>
							</div>
							<div class="moves-filter-field moves-filter-field-radio" role="radiogroup" aria-labelledby="moves-filter-category-label">
								<span id="moves-filter-category-label" class="moves-filter-label">分類</span>
								<label class="radio-label"><input type="radio" name="moves-filter-category" value="" checked /> すべて</label>
								<label class="radio-label"><input type="radio" name="moves-filter-category" value="physical" /> 物理</label>
								<label class="radio-label"><input type="radio" name="moves-filter-category" value="special" /> 特殊</label>
								<label class="radio-label"><input type="radio" name="moves-filter-category" value="status" /> 変化</label>
							</div>
							<p id="moves-filter-count" class="moves-filter-count tnum" aria-live="polite"></p>
						</div>
						{/* B-1: ★(タイプ一致)の可視凡例。role="img" aria-label="タイプ一致"はスクリーン
						    リーダー限定で、目視ユーザーは★の意味を推測するしかなかった。STAB技が先頭に
						    固められる設計のため初画面はほぼ全セルに★が付き「おすすめ」等と誤読されうる。 */}
						<p class="moves-legend-hint"><span class="move-cell-stab" aria-hidden="true">★</span> = タイプ一致(自分と同じタイプの技。ダメージ計算で威力1.5倍になる)</p>
						<ul class="moves-grid" id="moves-grid">
							{sortedLearnsetMoves.map((m) => {
								const iconUrl = m.type ? typeIconUrl(m.type) : null;
								// A-5: 技セルのリンクに ?from=pokemon:<このポケモン名> を付ける(値はencodeURIComponent)。
								// 共通契約(round-15.md A-5): /moves側が着地時にlocation.searchのfromを読み、
								// "pokemon:<名前>" なら戻るリンクを "← <名前>に戻る" に書き換える。/moves側の実装は
								// 別エージェント担当(src/pages/moves/[name].astroは編集禁止)。
								const moveHref = `/moves/${encodeURIComponent(m.name)}?from=${encodeURIComponent(`pokemon:${pokemon.name}`)}`;
								return (
									<li class={`move-cell${m.isStab ? ' is-stab' : ''}`} data-move-type={m.type ?? ''} data-move-category={m.category}>
										<a href={moveHref}>
											{iconUrl && <img class="move-cell-icon" src={iconUrl} width="16" height="16" alt={m.type ?? ''} />}
											<span class="move-cell-name" title={m.name}>{m.name}</span>
											{m.isStab && (
												<span class="move-cell-stab" role="img" aria-label="タイプ一致">★</span>
											)}
											{m.power != null ? (
												<span class="move-cell-power tnum">{m.power}</span>
											) : (
												<span class="move-cell-power move-cell-power-status">変化</span>
											)}
										</a>
									</li>
								);
							})}
						</ul>
						{/* フィルタの結果0件になったときの表示。document.createElement()で新規に要素を
						    作るのではなく、この静的HTMLに最初から存在する要素をhidden属性で出し入れするだけ
						    にすることで、「JS生成要素にAstro scoped styleが効かない」罠(このプロジェクトで
						    何度も踏まれている)を最初から回避する。 */}
						<p id="moves-empty-state" class="moves-empty-state" hidden>絞り込み条件に一致する技がありません。</p>
					</>
				) : (
					<p>データなし</p>
				)}
			</div>
		</section>
	</div>
	<script>
		// C-3: タイプ・分類フィルタの動作。全ての.move-cellは上のフロントマターで静的HTMLとして
		// 既に出力済みなので、このスクリプトはdata-move-type/data-move-categoryを見て
		// hidden属性を付け外しするだけで、新規に要素を作らない(scoped styleが効かない罠を踏まない)。
		// フィルタ用のselect自体が存在しないページ(learnset 0件の理論上のケース)でも
		// getElementByIdはnullを返すだけなので、以下は安全に何もしない。
		const typeSelect = document.getElementById('moves-filter-type') as HTMLSelectElement | null;
		// B-5: 「分類」はセレクトからラジオ(name="moves-filter-category")へ変更。選択中の値はチェック済みのinputから読む。
		const categoryRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="moves-filter-category"]'));
		const countEl = document.getElementById('moves-filter-count');
		const emptyStateEl = document.getElementById('moves-empty-state') as HTMLElement | null;
		const cells = Array.from(document.querySelectorAll<HTMLLIElement>('.move-cell'));
		const total = cells.length;

		function applyFilter() {
			const type = typeSelect?.value ?? '';
			const category = categoryRadios.find((radio) => radio.checked)?.value ?? '';
			let visibleCount = 0;
			for (const cell of cells) {
				const visible =
					(type === '' || cell.dataset.moveType === type) &&
					(category === '' || cell.dataset.moveCategory === category);
				cell.hidden = !visible;
				if (visible) visibleCount++;
			}
			if (countEl) countEl.textContent = `${visibleCount} / ${total} 件を表示`;
			if (emptyStateEl) emptyStateEl.hidden = visibleCount !== 0;
		}

		typeSelect?.addEventListener('change', applyFilter);
		for (const radio of categoryRadios) {
			radio.addEventListener('change', applyFilter);
		}
		applyFilter();
	</script>
	<script define:vars={{ validMoveNames: Array.from(movesDetailMap.keys()) }}>
		// A-5: /moves側の「この技を覚えるポケモン」リンクが付ける ?from=move:<技名> を読み、
		// 戻るリンク(AppLayoutが描画する.app-topbar-back、既定は"/search")をその技のページへ
		// 書き換える。共通契約(round-15.md A-5、round-13.md A-6と同じ「URLクエリをページ内
		// スクリプトが読んで静的HTMLを書き換える」パターン): fromが無い/不正値/未知の接頭辞
		// ("move:"以外)なら既定の"/search"のまま何もしない。存在しない技名
		// (?from=move:存在しない技)も、getStaticPathsが生成した全技名の一覧
		// (validMoveNames、define:varsでフロントマターのmovesDetailMapから注入)に無ければ
		// 既定のままにする(壊れたリンクへの書き換えを防ぐ)。
		// 注: define:varsを使うscriptはAstroにより暗黙にis:inline扱いになりTypeScript構文
		// (型アサーション・ジェネリクス)を処理できないため、素のJavaScriptのみで書く
		// (src/pages/box/[id].astroの既存コメントに同じ注意が記録済み)。
		const params = new URLSearchParams(location.search);
		const from = params.get('from');
		const MOVE_PREFIX = 'move:';
		if (from && from.startsWith(MOVE_PREFIX)) {
			const moveName = from.slice(MOVE_PREFIX.length);
			if (moveName && validMoveNames.includes(moveName)) {
				const backLink = document.querySelector('.app-topbar-back');
				if (backLink) {
					backLink.setAttribute('href', `/moves/${encodeURIComponent(moveName)}`);
					backLink.textContent = `← ${moveName}に戻る`;
				}
			}
		}
	</script>
</AppLayout>
