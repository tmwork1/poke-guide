---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import AppHeader from "../../components/AppHeader.astro";
import SecondaryBar from "../../components/damage-calc/SecondaryBar.astro";
import MatchupCardList from "../../components/damage-calc/MatchupCardList.astro";
import ItemSelectDialog from "../../components/damage-calc/ItemSelectDialog.astro";
import ControlPanel from "../../components/damage-calc/ControlPanel.astro";
import { toJsonScriptContent } from "../../lib/json-script";
import { getOpggUsageList, getOpggUsageManifest, sortOpggSeasons } from "../../lib/opgg-usage";
import { env } from "cloudflare:workers";
import "../../styles/app-header.css";
import "../../styles/second-header.css";
import "../../styles/damage-calc-page.css";

const user = Astro.locals.user;

let opggRankedSpeciesNames: string[] = [];
try {
  const manifest = await getOpggUsageManifest(env.OPGG_USAGE);
  const currentSeason = sortOpggSeasons(manifest)[0];
  const seasonList = currentSeason ? await getOpggUsageList(env.OPGG_USAGE, currentSeason) : null;
  opggRankedSpeciesNames = seasonList?.pokemon.map((entry) => entry.name) ?? [];
} catch (error) {
  console.error("[damage-calc] failed to load OP.GG species ranking", error);
}
---

<AppLayout title="ダメージ" current="damage-calc" bodyClass="damage-calc-page">
  <AppHeader showGuestLogin={true} ariaLabel="ダメージ計算の操作">
    <h1 class="app-header-title">ダメージ計算</h1>
  </AppHeader>
  {/* SecondaryBar/ControlPanelは.damage-calc-shell(スクロール領域)の外側の兄弟要素にする。
      shellの内側に置くと(sticky/fixedであっても)スクロールコンテナの子孫になり、
      grid内でのsticky計算が絡んで見た目上スクロール領域に含まれているように見える
      不具合が起きたため、box一覧ページ(AppHeader/SecondHeader→.box-content)と同じ
      構成に揃える。 */}
  <SecondaryBar />
  <main class="damage-calc-shell">
    {!user && <p class="damage-calc-login-guide">チームを使うには <a href="/team">ログインしてチームを登録</a>してください。</p>}
    <MatchupCardList />
  </main>
  <ControlPanel />
  <ItemSelectDialog />
  <script type="application/json" id="damage-calc-opgg-ranked-species" set:html={toJsonScriptContent(opggRankedSpeciesNames)}></script>
  <script>
    import { initSecondaryBar } from "../../lib/damage-calc-page/secondary-bar";
    import { initControlPanel } from "../../lib/damage-calc-page/control-panel";
    import { initItemSelectDialog } from "../../lib/damage-calc-page/item-select-dialog";
    initSecondaryBar();
    initControlPanel();
    initItemSelectDialog();
  </script>
</AppLayout>
