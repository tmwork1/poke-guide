---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import { getSupabasePublicClient } from '../../lib/supabase';

let seasons: Awaited<ReturnType<typeof listRankedSeasons>> = [];
let initialError = '';
try {
  seasons = await listRankedSeasons(await getSupabasePublicClient());
} catch (error) {
  console.error('[ranked-teams] season loading failed:', error);
  initialError = 'シーズン一覧を読み込めませんでした。時間をおいて再度お試しください。';
}
const defaultSeason = resolveDefaultSeason(seasons);
---

<AppLayout title="上位構築" description="ランクバトル上位入賞者の構築一覧" current="ranked-teams" hideTopbar={true}>
  <div class="page ranked-teams-shell">
    <div class="panel panel-top panel-toolbar" id="ranked-teams-toolbar">
      <button type="button" class="toolbar-menu-button btn-ghost" id="app-sidebar-toggle" aria-controls="app-sidebar" aria-expanded="false" aria-label="メニューを開く">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>

      <div class="toolbar-item toolbar-count">
        <span class="badge tnum" id="ranked-team-count" hidden>0件</span>
      </div>

      <div class="toolbar-item toolbar-search">
        <div class="search-input-wrap">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <!-- 複数の区切り文字を受け付けるため、入力方法を限定せず用途だけを簡潔に示す。 -->
          <input id="ranked-team-search" type="search" class="field-control" placeholder="ポケモン名(複数可)" aria-label="ポケモン名で検索" autocomplete="off" />
        </div>
      </div>

      <div class="toolbar-item toolbar-build-search">
        <div class="search-input-wrap">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input id="ranked-team-build-search" type="search" class="field-control" placeholder="特性・アイテム・技" aria-label="特性・アイテムまたは技で検索" autocomplete="off" />
        </div>
      </div>

      <div class="toolbar-item toolbar-season">
        <label for="ranked-team-season">シーズン</label>
        <select id="ranked-team-season" class="field-control" disabled={seasons.length === 0}>
          {seasons.map((entry) => <option value={entry.season} selected={entry.season === defaultSeason}>{entry.season}</option>)}
        </select>
      </div>
    </div>

    <main class="ranked-team-list" data-default-season={defaultSeason ?? ''} data-initial-error={initialError}>
      <p id="ranked-team-loading" class="ranked-team-status">読み込み中…</p>
      <p id="ranked-team-error" class="ranked-team-status" role="alert" hidden></p>
      <div id="ranked-team-cards"></div>
      <div id="ranked-team-empty" class="empty-state" hidden>
        <p class="empty-state-icon" aria-hidden="true">🔍</p>
        <p class="empty-state-title">条件に一致する構築がありません</p>
        <p class="empty-state-hint">検索条件を変更してください。</p>
      </div>
      <div class="ranked-team-load-more-wrap">
        <button type="button" id="ranked-team-load-more" class="btn-ghost" hidden>もっと見る</button>
      </div>
    </main>
  </div>

  <style>
    .toolbar-count { flex-shrink: 0; }
    #ranked-team-count[hidden] { display: none; }
    /* 2つの検索欄ではポケモン名側を広くし、複数指定でも入力内容を確認しやすくする。 */
    .toolbar-search { flex: 0 1 17rem; }
    .toolbar-build-search { flex: 0 1 13rem; }
    .toolbar-search input, .toolbar-build-search input { width: 100%; min-width: 12em; }
    .toolbar-season { flex: 0 0 auto; }
    .toolbar-season label { font-size: var(--font-size-sm); color: var(--color-text-muted); white-space: nowrap; }
    .ranked-teams-shell { max-width: none; }
    @media (max-width: 640px) {
      .toolbar-search, .toolbar-build-search { flex-basis: auto; }
      .toolbar-search input, .toolbar-build-search input, .toolbar-season select { width: 100%; min-width: 0; }
    }
  </style>

  <style is:global>
    .ranked-team-list { padding: var(--space-6) var(--space-5); }
    .ranked-team-list .ranked-team-status { color: var(--color-text-muted); }
    /* 文字色には --color-danger ではなく --color-danger-strong を使う。global.css の
       コメントどおり、ライトモードで --color-danger をそのまま文字色にするとコントラストが
       足りない(/team の #error-message も --color-danger-strong を使っている)。 */
    .ranked-team-list #ranked-team-error { color: var(--color-danger-strong); }
    .ranked-team-list #ranked-team-cards { display: flex; flex-direction: column; gap: var(--space-4); }
    .ranked-team-list .card-ranked-team { overflow: hidden; padding: 0; background: var(--color-surface-alt); }
    .ranked-team-list .card-ranked-team:hover { transform: none; box-shadow: var(--shadow-sm); border-color: var(--color-border); background: var(--color-surface-alt); }
    .ranked-team-list .ranked-team-header { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-3) var(--space-4); }
    .ranked-team-list .ranked-team-trainer { font-weight: 700; }
    .ranked-team-list .ranked-team-article-group { display: flex; align-items: center; gap: var(--space-2); min-width: 0; flex: 1 1 18rem; }
    .ranked-team-list .ranked-team-article-link { display: inline-flex; align-items: center; gap: var(--space-1); min-width: 0; }
    .ranked-team-list .ranked-team-article-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ranked-team-list .ranked-team-article-icon { flex: none; width: var(--font-size-sm); height: var(--font-size-sm); }
    .ranked-team-list .ranked-team-host { flex-shrink: 0; max-width: 14rem; overflow: hidden; text-overflow: ellipsis; }
    .ranked-team-list .ranked-team-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.34fr); }
    /* 広幅では6体を1行に収め、同一行の最大内容高へ伸ばして欠損のある枠とも高さを揃える。 */
    .ranked-team-list .ranked-team-members { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-2); padding: var(--space-3) var(--space-4) var(--space-4); align-items: stretch; }
    .ranked-team-list .ranked-team-thumb { position: relative; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: var(--space-1); padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
    /* 情報行を持たない空き枠は、番号だけを従来どおり中央に置く。 */
    .ranked-team-list .ranked-team-thumb.is-empty { justify-content: center; border-style: dashed; color: var(--color-text-muted); }
    .ranked-team-list .ranked-team-image-wrap { position: relative; display: inline-flex; align-items: center; justify-content: center; max-width: 100%; }
    .ranked-team-list .ranked-team-pokemon-image { width: 72px; height: 72px; max-width: 100%; object-fit: contain; }
    .ranked-team-list .ranked-team-image-fallback { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-weight: 700; }
    .ranked-team-list .ranked-team-species-name { max-width: 100%; padding: 0 var(--space-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-size-xs); }
    .ranked-team-list .ranked-team-item-badge { position: absolute; right: 0; bottom: var(--space-1); display: inline-flex; align-items: center; justify-content: center; width: var(--icon-size-md); height: var(--icon-size-md); }
    .ranked-team-list .ranked-team-item-badge img { width: 100%; height: 100%; object-fit: contain; }
    .ranked-team-list .ranked-team-ability { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-text-muted); font-size: var(--font-size-xs); }
    .ranked-team-list .ranked-team-moves { width: max-content; max-width: 100%; min-width: 0; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-1); }
    .ranked-team-list .ranked-team-move { min-width: 0; display: flex; align-items: center; gap: var(--space-1); }
    /* 技名と同じ12px基準に揃え、アイコンだけが行内で目立たない大きさにする。 */
    .ranked-team-list .ranked-team-move-type { flex: 0 0 auto; width: var(--font-size-xs); height: var(--font-size-xs); object-fit: contain; }
    .ranked-team-list .ranked-team-move-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-text); font-size: var(--font-size-xs); }
    .ranked-team-list .ranked-team-details { margin: 0; padding: var(--space-4); border-left: 1px solid var(--color-border); display: flex; flex-direction: column; justify-content: center; gap: var(--space-3); }
    .ranked-team-list .ranked-team-detail-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
    .ranked-team-list .ranked-team-detail-row dt { font-weight: 700; }
    .ranked-team-list .ranked-team-detail-row dd { margin: 0; }
    .ranked-team-list .ranked-team-load-more-wrap { display: flex; justify-content: center; padding: var(--space-6) 0; }
    .ranked-team-list .ranked-team-load-more-wrap[hidden],
    .ranked-team-list #ranked-team-load-more[hidden],
    .ranked-team-list #ranked-team-empty[hidden],
    .ranked-team-list .ranked-team-status[hidden] { display: none; }
    @media (max-width: 1280px) {
      .ranked-team-list .ranked-team-body { grid-template-columns: minmax(0, 1fr); }
      .ranked-team-list .ranked-team-details { border-left: 0; border-top: 1px solid var(--color-border); }
    }
    /* 6列では技名の表示幅を確保しにくい帯だけ3列に落とし、横スクロールを防ぐ。 */
    @media (max-width: 900px) {
      .ranked-team-list .ranked-team-members { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 700px) {
      .ranked-team-list { padding: var(--space-4) var(--space-3); }
      .ranked-team-list .ranked-team-members { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .ranked-team-list .ranked-team-host { display: none; }
    }
  </style>

  <script>
    import type { RankedTeam } from '../../lib/ranked-teams';
    import { matchesBuildSearch, matchesSpeciesSearch, RANKED_TEAMS_PAGE_SIZE } from '../../lib/ranked-teams-validation';
    import { loadImageIdMap, loadMoveTypeMap } from '../../lib/pokemon-master-data';
    import { loadItemSpriteMap } from '../../lib/sprite-urls';
    import { renderRankedTeamCard } from '../../lib/ranked-teams/card';

    interface RankedTeamsResponse { season: string; teams: RankedTeam[]; }

    const root = document.querySelector<HTMLElement>('.ranked-team-list');
    if (root) {
      const cards = document.querySelector<HTMLElement>('#ranked-team-cards')!;
      const loading = document.querySelector<HTMLElement>('#ranked-team-loading')!;
      const error = document.querySelector<HTMLElement>('#ranked-team-error')!;
      const empty = document.querySelector<HTMLElement>('#ranked-team-empty')!;
      const count = document.querySelector<HTMLElement>('#ranked-team-count')!;
      const loadMore = document.querySelector<HTMLButtonElement>('#ranked-team-load-more')!;
      const search = document.querySelector<HTMLInputElement>('#ranked-team-search')!;
      const buildSearch = document.querySelector<HTMLInputElement>('#ranked-team-build-search')!;
      const seasonSelect = document.querySelector<HTMLSelectElement>('#ranked-team-season')!;
      const cache = new Map<string, RankedTeam[]>();
      const [imageIdMap, itemSpriteMap, moveTypeMap] = await Promise.all([loadImageIdMap(), loadItemSpriteMap(), loadMoveTypeMap()]);
      let visibleCount = RANKED_TEAMS_PAGE_SIZE;
      let currentTeams: RankedTeam[] = [];
      let debounceTimer: ReturnType<typeof setTimeout> | undefined;

      function filteredTeams(): RankedTeam[] {
        return currentTeams.filter((team) =>
          matchesSpeciesSearch(team.members, search.value)
          && matchesBuildSearch(team.members, buildSearch.value),
        );
      }

      function render(): void {
        const filtered = filteredTeams();
        const visible = filtered.slice(0, visibleCount);
        cards.replaceChildren(...visible.map((team) => renderRankedTeamCard(team, imageIdMap, itemSpriteMap, moveTypeMap)));
        count.textContent = `${filtered.length}件`;
        count.hidden = false;
        empty.hidden = filtered.length !== 0;
        loadMore.hidden = visible.length >= filtered.length;
      }

      async function selectSeason(season: string): Promise<void> {
        loading.hidden = false;
        error.hidden = true;
        cards.replaceChildren();
        empty.hidden = true;
        loadMore.hidden = true;
        visibleCount = RANKED_TEAMS_PAGE_SIZE;
        try {
          if (!cache.has(season)) {
            const response = await fetch(`/api/ranked-teams?season=${encodeURIComponent(season)}`);
            if (!response.ok) throw new Error('上位構築を取得できませんでした');
            const payload = await response.json() as RankedTeamsResponse;
            cache.set(season, payload.teams);
          }
          currentTeams = cache.get(season) ?? [];
          render();
        } catch (cause) {
          currentTeams = [];
          error.textContent = cause instanceof Error ? cause.message : '上位構築を取得できませんでした';
          error.hidden = false;
          count.hidden = true;
        } finally {
          loading.hidden = true;
        }
      }

      search.addEventListener('input', () => {
        if (debounceTimer !== undefined) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          visibleCount = RANKED_TEAMS_PAGE_SIZE;
          render();
        }, 150);
      });
      // 2つの検索欄で同じ待ち時間とページ先頭へのリセット挙動を共有する。
      buildSearch.addEventListener('input', () => {
        if (debounceTimer !== undefined) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          visibleCount = RANKED_TEAMS_PAGE_SIZE;
          render();
        }, 150);
      });
      seasonSelect.addEventListener('change', () => void selectSeason(seasonSelect.value));
      loadMore.addEventListener('click', () => {
        visibleCount += RANKED_TEAMS_PAGE_SIZE;
        render();
      });

      const initialError = root.dataset.initialError ?? '';
      const defaultSeason = root.dataset.defaultSeason ?? '';
      if (initialError || !defaultSeason) {
        loading.hidden = true;
        error.textContent = initialError || '表示できるシーズンがありません';
        error.hidden = false;
      } else {
        void selectSeason(defaultSeason);
      }
    }
  </script>
</AppLayout>
