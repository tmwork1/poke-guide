---
// チーム一覧ページ(new-page計画 docs/plan/pages/team.md「確定した設計 > 画面 > /team(一覧)」)。
// 手本は src/pages/box/index.astro(一覧ページの原本): ツールバーの構造・.box-grid の
// 「display:contents + 追加タイルを外側の兄弟に置く」レンダリング戦略・空状態2種の作り・
// 公式絵の取得(loadImageIdMap/officialArtworkUrl)+失敗時フォールバックの考え方をそのまま流用する。
//
// box/index.astro との違い:
// - データ取得元は GET /api/teams(チーム一覧。メンバー込み、0〜6要素)。
// - 検索は初回取得後にクライアント側で行い、追加のAPI呼び出しを発生させない。
// - 一覧カードは体数バッジ(N/6)+メンバーの公式絵ミニサムネイル列を持つ(これが
//   無いと「複数の構成案を並べて見比べる」というページの存在理由が果たせない)。
export const prerender = false;


import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/team-page.css';
import '../../styles/team-mate-card.css';
import '../../styles/app-header.css';
import '../../styles/second-header.css';
import AppHeader from '../../components/AppHeader.astro';
import SecondHeader from '../../components/SecondHeader.astro';

const user = Astro.locals.user;
---
<AppLayout title="チーム" description="登録したチーム編成の一覧・検索" current="team" bodyClass="team-page">
	{/*
	  チームカード(.card-team)は下部の<script>がdocument.createElement()で生成するため、
	  Astroのscoped style(data-astro-cid-*属性が付いた静的マークアップにしか当たらない)では
	  スタイルが当たらない(pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」)。
	  よってカード本体のスタイルはCSSファイル src/styles/team-card.css が持つ
	  (上のフロントマターで読み込む team-page.css が @import している)。
	  /team/[id] の「類似構築」タブに並ぶ上位構築カードも同じファイルを読み込み、
	  同一の見た目・カード間隔を共有する。
	*/}

	<div class="page team-shell floating-list-page">
		{
			user ? (
				<Fragment>
					<AppHeader>
						<h1 class="app-header-title">チーム</h1>
					</AppHeader>

					<SecondHeader ariaLabel="検索" class="team-second-header">
						<div class="second-header-search toolbar-item toolbar-search">
							{/* 可視の「検索」<label>は置かず、box/index.astroと同じくaria-labelで維持する。 */}
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="search-input"
									type="search"
									class="field-control"
									placeholder="ポケモン・もちもの・わざ"
									aria-label="検索"
									autocomplete="off"
								/>
							</div>
						</div>
						<div class="second-header-density toolbar-item toolbar-density">
							<button
								type="button"
								id="team-display-density-toggle"
								class="density-toggle btn-control"
								data-mode="expanded"
								aria-label="圧縮表示に切り替える"
							>
								<svg class="density-toggle-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="2" y="4" width="5" height="5" rx="1" />
									<rect x="10" y="4" width="5" height="5" rx="1" />
									<rect x="18" y="4" width="5" height="5" rx="1" />
									<rect x="2" y="12" width="5" height="5" rx="1" />
									<rect x="10" y="12" width="5" height="5" rx="1" />
									<rect x="18" y="12" width="5" height="5" rx="1" />
								</svg>
							</button>
						</div>

					</SecondHeader>

					<div class="team-content box-content">
						<p id="loading-message" class="loading-center">読み込み中…</p>
						<p id="error-message" hidden></p>

						<div class="team-grid">
							<div id="team-list"></div>
						</div>
						<div class="top-builds-load-more-wrap">
							<button type="button" id="team-load-more" class="btn-ghost" hidden>もっと見る</button>
						</div>

						<div id="empty-message" class="empty-state empty-state-plain" hidden>
							<button type="button" class="add-card-tile team-empty-add-button" id="add-empty-team-button">
								<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 5v14" />
									<path d="M5 12h14" />
								</svg>
								<span class="add-card-tile-label">チームを登録</span>
							</button>
						</div>

						<div id="no-match-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🔍</p>
							<p class="empty-state-title">条件に一致するチームがありません</p>
							<p class="empty-state-hint">条件を変更してください。</p>
						</div>
					</div>
					<button type="button" class="add-card-tile floating-list-add-button" id="add-team-button" aria-label="チームを登録">
						<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14" />
							<path d="M5 12h14" />
						</svg>
						<span class="add-card-tile-label">チームを登録</span>
					</button>
				</Fragment>
			) : (
				<section class="panel">
					<div class="panel-content">
						<p>チームを管理するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			)
		}
	</div>

	<script>
		// チームカードは外枠から6枠まで共用し、1枠の実体はその中から /box のカード描画へ委譲する。
		import { kanaIncludes } from "../../lib/kana";
		import { loadImageIdMap, officialArtworkUrl, championSpriteUrl } from "../../lib/pokemon-master-data";
		import { itemIconUrl } from "../../lib/sprite-urls";
		import { renderTeamCard } from "../../lib/team-card";
		import { renderTeamMateSlots } from "../../lib/team-mate-card";
		import { initializeCardDeleteMode } from "../../lib/card-delete-mode";
		import { reloadOnBfcacheRestore } from "../../lib/shared/reload-on-bfcache-restore";

		// GET /api/teams が返す1メンバーの owned_pokemon。表示に必要な列だけを持つ
		// (src/lib/team.ts の TeamMember/OwnedPokemonRecord のサブセット)。
		interface TeamMemberPokemon {
			id: string;
			species_name: string;
			level: number | null;
			nature: string | null;
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			evs: number[];
			ivs: number[];
			move_names: string[];
			memo: string | null;
		}
		interface TeamMemberEntry {
			slot: number;
			owned_pokemon: TeamMemberPokemon;
		}
		interface Team {
			id: string;
			memo: string | null;
			// レギュレーション(migrations/013_regulation.sql)。未指定は null。
			regulation: string | null;
			is_pinned: boolean;
			created_at: string;
			updated_at: string;
			members: TeamMemberEntry[];
		}

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const imageIdMapPromise = loadImageIdMap();

		async function applySprite(
			imgEl: HTMLImageElement,
			fallbackEl: HTMLElement,
			name: string,
		): Promise<void> {
			const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
			if (imageId == null) {
				imgEl.style.display = "none";
				fallbackEl.style.display = "flex";
				fallbackEl.textContent = name ? name.charAt(0) : "?";
				return;
			}
			let triedArtworkFallback = false;
			imgEl.onerror = () => {
				if (!triedArtworkFallback) {
					triedArtworkFallback = true;
					imgEl.src = officialArtworkUrl(imageId);
					return;
				}
				imgEl.style.display = "none";
				fallbackEl.style.display = "flex";
				fallbackEl.textContent = name.charAt(0);
			};
			imgEl.onload = () => {
				imgEl.style.display = "";
				fallbackEl.style.display = "none";
			};
			imgEl.src = championSpriteUrl(imageId);
		}

		function applyItemIcon(
			imgEl: HTMLImageElement,
			itemName: string,
			visibilityEl?: HTMLElement,
		): void {
			if (!itemName) {
				imgEl.style.display = "none";
				if (visibilityEl) visibilityEl.hidden = true;
				return;
			}
			imgEl.onerror = () => {
				imgEl.style.display = "none";
				if (visibilityEl) visibilityEl.hidden = true;
			};
			imgEl.onload = () => {
				imgEl.style.display = "";
				if (visibilityEl) visibilityEl.hidden = false;
			};
			imgEl.src = itemIconUrl(itemName);
		}

		const listRoot = document.getElementById("team-list");
		if (listRoot instanceof HTMLElement) {
			initializeCardDeleteMode(listRoot, ".card-team", ".card-team-delete");
		}
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const searchInput = el<HTMLInputElement>("search-input");
			const addButton = el<HTMLButtonElement>("add-team-button");
			const emptyAddButton = el<HTMLButtonElement>("add-empty-team-button");
			const densityToggle = el<HTMLButtonElement>("team-display-density-toggle");
			const loadMoreButton = el<HTMLButtonElement>("team-load-more");

			let allTeams: Team[] = [];
			const TEAM_PAGE_SIZE = 24;
			let hasMoreTeams = false;
			let isLoadingMore = false;
			type TeamDisplayMode = "expanded" | "compressed";
			let displayMode: TeamDisplayMode = "expanded";

			const DENSITY_ICON_EXPANDED = `<svg class="density-toggle-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="5" height="5" rx="1"/><rect x="10" y="4" width="5" height="5" rx="1"/><rect x="18" y="4" width="5" height="5" rx="1"/><rect x="2" y="12" width="5" height="5" rx="1"/><rect x="10" y="12" width="5" height="5" rx="1"/><rect x="18" y="12" width="5" height="5" rx="1"/></svg>`;
			const DENSITY_ICON_COMPRESSED = `<svg class="density-toggle-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="10" width="5" height="5" rx="1"/><rect x="10" y="10" width="5" height="5" rx="1"/><rect x="18" y="10" width="5" height="5" rx="1"/></svg>`;

			function updateDensityToggleUi(): void {
				densityToggle.dataset.mode = displayMode;
				densityToggle.innerHTML = displayMode === "expanded" ? DENSITY_ICON_EXPANDED : DENSITY_ICON_COMPRESSED;
				densityToggle.setAttribute(
					"aria-label",
					displayMode === "expanded" ? "圧縮表示に切り替える" : "展開表示に切り替える",
				);
			}

			// メンバーの種族名・アイテム・わざを対象にするAND部分一致検索。
			function matchesSearch(t: Team, term: string): boolean {
				if (!term) return true;
				const haystack = [
					...t.members.map((m) => m.owned_pokemon.species_name ?? ""),
					...t.members.map((m) => m.owned_pokemon.item_name ?? ""),
					...t.members.flatMap((m) => m.owned_pokemon.move_names ?? []),
				].join(" ");
				return term
					.split(/\s+/)
					.filter((tok) => tok.length > 0)
					// 複数語ANDの仕様はそのまま、各語だけかな表記を揃えて比較する。
					.every((tok) => kanaIncludes(haystack, tok));
			}

			// 共用レンダラへ一覧固有の操作とメタ情報を渡す。hrefを渡したカードは従来どおり
			// 丸ごとクリック可能な<a>になり、内部ボタンの遷移抑止もレンダラが担う。
			function renderCard(t: Team): HTMLElement {
				const memoText = (t.memo ?? "").trim();
				const membersBySlot = new Map(t.members.map((m) => [m.slot, m]));
				return renderTeamCard({
					href: `/team/${encodeURIComponent(t.id)}`,
					ariaLabel: "チームを編集",
					name: "",
					onDelete: () => deleteTeamCard(t),
					// メモが空でも<p>を生成し、体数バッジ・削除ボタンとともに既存DOMを維持する。
					memo: memoText
						? { text: "📝", title: memoText, ariaLabel: `メモ: ${memoText}` }
						: {},
					badges: [{ className: "badge tnum card-team-count-badge", text: `${t.members.length}/6` }],
					membersBySlot,
					toCardContent: (member) => {
						const pokemonName = member.owned_pokemon.species_name?.trim()
							|| "ポケモン";
						return {
							pokemon: member.owned_pokemon,
							displayName: pokemonName,
							ariaLabel: `${pokemonName}を編集`,
							onDelete: () => deletePokemon(member.owned_pokemon),
						};
					},
					renderMembers: displayMode === "compressed"
						? (container) => {
								container.className = "team-mate-grid";
								const mateMembersBySlot = new Map(t.members.map((m) => [m.slot, m.owned_pokemon]));
								renderTeamMateSlots({
									root: container,
									membersBySlot: mateMembersBySlot,
									displayName: (p) => p.species_name || "ポケモン",
									applySprite,
									applyItemIcon,
								});
							}
						: undefined,
				});
			}

			function renderList(): void {
				const filtered = allTeams.filter(
					(t) => matchesSearch(t, searchInput.value.trim()),
				);
				const sorted = [...filtered].sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
				listRoot.innerHTML = "";
				// 「本当に0件」(空状態)と「絞り込みで0件」(検索結果なし)を区別する
				// (box/index.astroの#empty-message/#no-match-messageと同じ切り分け)。
				const isTrulyEmpty = allTeams.length === 0;
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				loadMoreButton.hidden = !hasMoreTeams || isTrulyEmpty;
				if (isTrulyEmpty) return;
				for (const t of sorted) {
					listRoot.appendChild(renderCard(t));
				}
			}

			async function deletePokemon(p: TeamMemberPokemon): Promise<void> {
				const name = p.species_name || "未設定";
				if (!window.confirm(`「${name}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, { method: "DELETE", credentials: "same-origin" });
					if (!res.ok) throw new Error(`削除失敗: ${res.status}`);
					for (const team of allTeams) team.members = team.members.filter((member) => member.owned_pokemon.id !== p.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("ポケモンを削除できませんでした。時間をおいて再度お試しください。");
				}
			}

			async function deleteTeamCard(t: Team): Promise<void> {
				// /boxのカード削除モードと同じくconfirm()は挟まない(長押しでモードに入り、
				// 表示された削除ボタンを明示的に押す2段階の操作自体が確認の役割を兼ねる)。
				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(t.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allTeams = allTeams.filter((x) => x.id !== t.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("削除に失敗しました。時間をおいて再度お試しください。");
				}
			}

			// 「＋ チームを追加」: この時点ではDBに作成せず、まず新規編集画面へ遷移する。
			function goToNewTeam(): void {
				window.location.href = "/team/new?tab=formation";
			}

			async function loadList(reset = true): Promise<void> {
				if (isLoadingMore) return;
				isLoadingMore = true;
				if (reset) loadingMessage.hidden = false;
				loadMoreButton.disabled = true;
				errorMessage.hidden = true;
				try {
					const offset = reset ? 0 : allTeams.length;
					const res = await fetch(`/api/teams?offset=${offset}&limit=${TEAM_PAGE_SIZE}`, { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { teams: Team[]; hasMore: boolean };
					allTeams = reset ? body.teams : [...allTeams, ...body.teams];
					hasMoreTeams = body.hasMore;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "チームを読み込めませんでした。時間をおいて再度お試しください。";
				} finally {
					isLoadingMore = false;
					loadMoreButton.disabled = false;
				}
			}

			searchInput.addEventListener("input", renderList);
			addButton.addEventListener("click", goToNewTeam);
			emptyAddButton.addEventListener("click", goToNewTeam);
			densityToggle.addEventListener("click", () => {
				displayMode = displayMode === "expanded" ? "compressed" : "expanded";
				updateDensityToggleUi();
				renderList();
			});
			loadMoreButton.addEventListener("click", () => void loadList(false));

			updateDensityToggleUi();
			void loadList();
			reloadOnBfcacheRestore(() => void loadList());
		}
	</script>
</AppLayout>
