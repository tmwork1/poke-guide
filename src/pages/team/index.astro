---
// チーム一覧ページ(new-page計画 docs/plan/pages/team.md「確定した設計 > 画面 > /team(一覧)」)。
// 手本は src/pages/box/index.astro(一覧ページの原本): ツールバーの構造・.box-grid の
// 「display:contents + 追加タイルを外側の兄弟に置く」レンダリング戦略・空状態2種の作り・
// 公式絵の取得(loadImageIdMap/officialArtworkUrl)+失敗時フォールバックの考え方をそのまま流用する。
//
// box/index.astro との違い:
// - データ取得元は GET /api/teams(チーム一覧。メンバー込み、0〜6要素)。
// - 検索・並べ替えは box と同じくクライアント側で完結させる(初回取得後、追加のAPI呼び出しを
//   発生させない設計を踏襲。GET /api/teams が受け付ける ?sort=/?search= はサーバー側の便宜のため
//   用意されているが、このページは box と同じ「1回取得してクライアントでフィルタ」方式に揃える)。
// - 絞り込みは「お気に入りのみ表示」の単一トグルのみ持つ(docs/plan/pages/team.md 参照。
//   チームは他に絞り込める軸が無いため)。box/index.astroと同じトグルを踏襲する。
// - 一覧カードは体数バッジ(N/6)+メンバーの公式絵ミニサムネイル列を持つ(これが
//   無いと「複数の構成案を並べて見比べる」というページの存在理由が果たせない)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/team-page.css';
// 候補は jpoke 由来の一覧(src/lib/regulations.ts)。画面側でレギュレーション名を
// ハードコードしない(ボックス画面 box/index.astro と同じ方針)。
import { REGULATIONS } from '../../lib/regulations';

const user = Astro.locals.user;
---
<AppLayout title="チーム" description="登録したチーム編成の一覧・検索・並べ替え" current="team" hideTopbar={true}>
	{/*
	  hideTopbar={true}によりAppLayoutの<header class="app-topbar">を描画しないため、
	  件数バッジはこのページ自身のツールバー(.second-bar--toolbar、
	  #team-toolbar)内へ直接配置する(下記マークアップ、id="team-count-badge"・
	  class="badge tnum"は変更しない、<script>がgetElementByIdで参照するため)。
	*/}

	{/*
	  チームカード(.card-team)は下部の<script>がdocument.createElement()で生成するため、
	  Astroのscoped style(data-astro-cid-*属性が付いた静的マークアップにしか当たらない)では
	  スタイルが当たらない(pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」)。
	  よってカード本体のスタイルはCSSファイル src/styles/team-card.css が持つ
	  (上のフロントマターで読み込む team-page.css が @import している)。
	  /team/[id] の「類似構築」タブに並ぶ上位構築カードも同じファイルを読み込み、
	  同一の見た目・カード間隔を共有する。
	*/}

	<div class="page team-shell floating-list-page">
		{
			user ? (
				<Fragment>
					<div class="panel panel-top second-bar second-bar--toolbar floating-list-toolbar" id="team-toolbar">
						<button type="button" class="app-topbar-back" aria-label="戻る" onclick="history.back()">
							<svg class="app-topbar-back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M9 14 4 9l5-5" />
								<path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11" />
							</svg>
						</button>
						<div class="toolbar-item toolbar-count">
							<span class="badge tnum" id="team-count-badge" hidden>0</span>
						</div>

						<div class="toolbar-item toolbar-search">
							{/* 可視の「検索」<label>は置かず、box/index.astroと同じくaria-labelで維持する。 */}
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="search-input"
									type="search"
									class="field-control"
									placeholder="チーム名"
									aria-label="検索"
									autocomplete="off"
								/>
							</div>
						</div>

						{/* box/index.astroの.toolbar-favorite/#favorite-filter-toggleと
						    同じマークアップ・クラス名(下のCSS参照、値も同一)を踏襲する。 */}
						<div class="toolbar-item toolbar-favorite">
							<button
								type="button"
								id="favorite-filter-toggle"
								class="favorite-filter-toggle"
								data-active="false"
								aria-pressed="false"
							>
								<span class="favorite-filter-star" aria-hidden="true">★</span> お気に入り
							</button>
						</div>

						{/* 選択肢は既知のレギュレーションと「すべて」を使う
						    (2画面で絞り込みの語彙を揃える)。取得済みの一覧をクライアント側で絞る点も同じ。 */}
						<div class="toolbar-item toolbar-regulation">
							<label class="field-label" for="regulation-filter">レギュレーション</label>
							<select id="regulation-filter" class="field-control">
								<option value="">すべて</option>
								{REGULATIONS.map((r) => <option value={r}>{r}</option>)}
							</select>
						</div>

						<div class="toolbar-item toolbar-sort">
							{/* 可視の「並べ替え」<label>は置かず、box/index.astroの.sort-select-wrap/.sort-icon
							    と同じSVGアイコン重畳パターンに揃える。 */}
							<div class="sort-select-wrap">
								<svg class="sort-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 4v16" />
									<path d="M4 7l3-3 3 3" />
									<path d="M17 20V4" />
									<path d="M14 17l3 3 3-3" />
								</svg>
								<select id="sort-select" class="field-control" aria-label="並べ替え">
									{/* 「〜順」は付けない: /box の並べ替え(最終更新/最終使用/ニックネーム)に表記を揃える。 */}
									<option value="updated_at">最終更新</option>
									<option value="name">チーム名</option>
								</select>
							</div>
						</div>
					</div>

					<div class="team-content box-content">
						<p id="loading-message">読み込み中…</p>
						<p id="error-message" hidden></p>

						<div class="team-grid">
							<button type="button" class="add-card-tile floating-list-add-button" id="add-team-button" aria-label="チームを追加">
								<span class="add-card-tile-icon" aria-hidden="true">＋</span>
								<span class="add-card-tile-label">チームを追加</span>
							</button>
							<div id="team-list"></div>
						</div>

						<div id="empty-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🧩</p>
							<p class="empty-state-title">チームが登録されていません</p>
						</div>

						<div id="no-match-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🔍</p>
							<p class="empty-state-title">条件に一致するチームがありません</p>
							<p class="empty-state-hint">条件を変更してください。</p>
						</div>
					</div>
				</Fragment>
			) : (
				<section class="panel">
					<div class="panel-content">
						<p>チームを管理するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			)
		}
	</div>

	<script>
		// チームカードは外枠から6枠まで共用し、1枠の実体はその中から /box のカード描画へ委譲する。
		import { kanaIncludes } from "../../lib/kana";
		import { renderTeamCard } from "../../lib/team-card";

		// GET /api/teams が返す1メンバーの owned_pokemon。表示に必要な列だけを持つ
		// (src/lib/team.ts の TeamMember/OwnedPokemonRecord のサブセット)。
		interface TeamMemberPokemon {
			id: string;
			nickname: string | null;
			species_name: string;
			level: number | null;
			nature: string | null;
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			evs: number[];
			ivs: number[];
			move_names: string[];
			memo: string | null;
			is_pinned: boolean;
		}
		interface TeamMemberEntry {
			slot: number;
			owned_pokemon: TeamMemberPokemon;
		}
		interface Team {
			id: string;
			name: string | null;
			memo: string | null;
			// レギュレーション(migrations/013_regulation.sql)。未指定は null。
			regulation: string | null;
			is_pinned: boolean;
			created_at: string;
			updated_at: string;
			members: TeamMemberEntry[];
		}

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const listRoot = document.getElementById("team-list");
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const countBadge = el<HTMLElement>("team-count-badge");
			const sortSelect = el<HTMLSelectElement>("sort-select");
			const searchInput = el<HTMLInputElement>("search-input");
			const favoriteFilterToggle = el<HTMLButtonElement>("favorite-filter-toggle");
			const regulationFilter = el<HTMLSelectElement>("regulation-filter");
			const addButton = el<HTMLButtonElement>("add-team-button");
			const ADD_BUTTON_DEFAULT_HTML = addButton.innerHTML;

			let allTeams: Team[] = [];
			let favoriteOnly = false;

			// name(空/未設定)なら「無題のチーム」にフォールバック(docs/plan/pages/team.md確定仕様)。
			function displayName(t: Team): string {
				if (t.name && t.name.trim() !== "") return t.name;
				return "無題のチーム";
			}

			// チーム名の部分一致(box/index.astroのmatchesSearchと同じAND部分一致方式)。
			function matchesSearch(t: Team, term: string): boolean {
				if (!term) return true;
				const haystack = t.name ?? "";
				return term
					.split(/\s+/)
					.filter((tok) => tok.length > 0)
					// 複数語ANDの仕様はそのまま、各語だけかな表記を揃えて比較する。
					.every((tok) => kanaIncludes(haystack, tok));
			}

			function matchesFavorite(t: Team): boolean {
				return !favoriteOnly || t.is_pinned;
			}

			// ""や廃止済み・未知の値は「すべて」と同じ扱いにする。クライアント側では
			// フロントマターの定数を参照できないため、実際のselect選択肢を既知値の基準にする。
			function matchesRegulation(t: Team): boolean {
				const selected = regulationFilter.value;
				const isKnownSelection = Array.from(regulationFilter.options).some((option) => option.value === selected);
				if (selected === "" || !isKnownSelection) return true;
				return t.regulation === selected;
			}

			// 設計レビューR-14: 名前順ソートでは無題チーム(name=null/空)を末尾にする。
			function sortTeams(list: Team[]): Team[] {
				const sort = sortSelect.value;
				const sorted = [...list];
				if (sort === "name") {
					sorted.sort((a, b) => {
						const aTitled = !!(a.name && a.name.trim() !== "");
						const bTitled = !!(b.name && b.name.trim() !== "");
						if (aTitled !== bTitled) return aTitled ? -1 : 1;
						if (!aTitled && !bTitled) return 0;
						return (a.name as string).localeCompare(b.name as string, "ja");
					});
				} else {
					sorted.sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
				}
				if (sort !== "updated_at") {
					sorted.sort((a, b) => Number(b.is_pinned) - Number(a.is_pinned));
				}
				return sorted;
			}

			// 共用レンダラへ一覧固有の操作とメタ情報を渡す。hrefを渡したカードは従来どおり
			// 丸ごとクリック可能な<a>になり、内部ボタンの遷移抑止もレンダラが担う。
			function renderCard(t: Team): HTMLElement {
				const name = displayName(t);
				const pinLabel = t.is_pinned ? "お気に入りを解除する" : "お気に入りにする";
				const memoText = (t.memo ?? "").trim();
				const regulation = t.regulation?.trim() ?? "";
				const membersBySlot = new Map(t.members.map((m) => [m.slot, m]));
				return renderTeamCard({
					href: `/team/${encodeURIComponent(t.id)}`,
					ariaLabel: `${name} を編集`,
					name,
					cornerAction: {
						type: "pin",
						isPinned: t.is_pinned,
						label: pinLabel,
						onToggle: () => toggleTeamPin(t),
					},
					onDelete: () => deleteTeamCard(t),
					// メモが空でも<p>を生成し、体数バッジ・削除ボタンとともに既存DOMを維持する。
					memo: memoText
						? { text: "📝", title: memoText, ariaLabel: `メモ: ${memoText}` }
						: {},
					badges: [
						...(regulation
							? [{ className: "badge card-team-regulation-badge", text: regulation }]
							: []),
						{ className: "badge tnum card-team-count-badge", text: `${t.members.length}/6` },
					],
					membersBySlot,
					toCardContent: (member) => {
						const pokemonName = member.owned_pokemon.nickname?.trim()
							|| member.owned_pokemon.species_name?.trim()
							|| "ポケモン";
						return {
							pokemon: member.owned_pokemon,
							displayName: pokemonName,
							ariaLabel: `${pokemonName}を編集`,
							pin: {
								isPinned: member.owned_pokemon.is_pinned,
								onToggle: () => togglePokemonPin(member.owned_pokemon),
							},
							onDelete: () => deletePokemon(member.owned_pokemon),
						};
					},
				});
			}

			function renderList(): void {
				const filtered = allTeams.filter(
					(t) => matchesSearch(t, searchInput.value.trim()) && matchesFavorite(t) && matchesRegulation(t),
				);
				const sorted = sortTeams(filtered);
				listRoot.innerHTML = "";
				// 「本当に0件」(空状態)と「絞り込みで0件」(検索結果なし)を区別する
				// (box/index.astroの#empty-message/#no-match-messageと同じ切り分け)。
				const isTrulyEmpty = allTeams.length === 0;
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				updateCountBadge(sorted.length);
				if (isTrulyEmpty) return;
				for (const t of sorted) {
					listRoot.appendChild(renderCard(t));
				}
			}

			function updateCountBadge(visibleCount: number): void {
				// 単位「チーム」は付けない: /box の件数バッジ(#pokemon-count-badge)が素の数値で、
				// 絞り込み中も現在の表示件数だけを示すため、/box と表記を揃える。
				countBadge.textContent = String(visibleCount);
				countBadge.hidden = false;
			}

			async function togglePokemonPin(p: TeamMemberPokemon): Promise<void> {
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, {
						method: "PATCH", credentials: "same-origin", headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ is_pinned: !p.is_pinned }),
					});
					if (!res.ok) throw new Error(`ピン留め更新失敗: ${res.status}`);
					const body = (await res.json()) as { data: TeamMemberPokemon };
					for (const team of allTeams) {
						for (const member of team.members) if (member.owned_pokemon.id === p.id) member.owned_pokemon = body.data;
					}
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("ピン留めを更新できませんでした。時間をおいて再度お試しください。");
				}
			}

			async function deletePokemon(p: TeamMemberPokemon): Promise<void> {
				const name = p.nickname?.trim() || p.species_name || "未設定";
				if (!window.confirm(`「${name}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/owned-pokemon/${encodeURIComponent(p.id)}`, { method: "DELETE", credentials: "same-origin" });
					if (!res.ok) throw new Error(`削除失敗: ${res.status}`);
					for (const team of allTeams) team.members = team.members.filter((member) => member.owned_pokemon.id !== p.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("ポケモンを削除できませんでした。時間をおいて再度お試しください。");
				}
			}

			async function toggleTeamPin(t: Team): Promise<void> {
				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(t.id)}`, {
						method: "PATCH",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ is_pinned: !t.is_pinned }),
					});
					if (!res.ok) throw new Error(`お気に入りの更新に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { team: Team };
					const idx = allTeams.findIndex((x) => x.id === t.id);
					if (idx !== -1) allTeams[idx] = body.team;
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("お気に入りの更新に失敗しました。時間をおいて再度お試しください。");
				}
			}

			async function deleteTeamCard(t: Team): Promise<void> {
				if (!window.confirm(`「${displayName(t)}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(t.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allTeams = allTeams.filter((x) => x.id !== t.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("削除に失敗しました。時間をおいて再度お試しください。");
				}
			}

			// 「＋ チームを追加」: クリックした瞬間に空チーム(name/memoともnull、members空)を
			// 自動登録し、そのまま編集画面(/team/[id])へ遷移する。連打による二重登録を防ぐため、
			// リクエスト中はボタンをdisabledにしてラベルを変更し、失敗時のみ復元する
			// (成功時はページ遷移するため復元不要。box/index.astroのcreateEmptyPokemonと同じ方針)。
			async function createEmptyTeam(): Promise<void> {
				addButton.disabled = true;
				addButton.textContent = "作成中…";
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/teams", {
						method: "POST",
						credentials: "same-origin",
					});
					const body = (await res.json().catch(() => ({}))) as { team?: { id: string }; error?: string };
					if (!res.ok || !body.team) {
						throw new Error(body.error ?? `作成に失敗しました (status=${res.status})`);
					}
					window.location.href = `/team/${encodeURIComponent(body.team.id)}`;
				} catch (err) {
					console.error(err);
					errorMessage.hidden = false;
					errorMessage.textContent = "チームの作成に失敗しました。時間をおいて再度お試しください。";
					addButton.disabled = false;
					addButton.innerHTML = ADD_BUTTON_DEFAULT_HTML;
				}
			}

			async function loadList(): Promise<void> {
				loadingMessage.hidden = false;
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/teams", { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { teams: Team[] };
					allTeams = body.teams;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "チームを読み込めませんでした。時間をおいて再度お試しください。";
				}
			}

			sortSelect.addEventListener("change", renderList);
			searchInput.addEventListener("input", renderList);
			regulationFilter.addEventListener("change", renderList);
			favoriteFilterToggle.addEventListener("click", () => {
				favoriteOnly = !favoriteOnly;
				favoriteFilterToggle.dataset.active = String(favoriteOnly);
				favoriteFilterToggle.setAttribute("aria-pressed", String(favoriteOnly));
				renderList();
			});
			addButton.addEventListener("click", () => void createEmptyTeam());

			void loadList();
		}
	</script>
</AppLayout>
