---
// チーム一覧ページ(new-page計画 docs/plan/pages/team.md「確定した設計 > 画面 > /team(一覧)」)。
// 手本は src/pages/box/index.astro(一覧ページの原本): ツールバーの構造・.box-grid の
// 「display:contents + 追加タイルを外側の兄弟に置く」レンダリング戦略・空状態2種の作り・
// 公式絵の取得(loadImageIdMap/officialArtworkUrl)+失敗時フォールバックの考え方をそのまま流用する。
//
// box/index.astro との違い:
// - データ取得元は GET /api/teams(チーム一覧。メンバー込み、0〜6要素)。
// - 検索・並べ替えは box と同じくクライアント側で完結させる(初回取得後、追加のAPI呼び出しを
//   発生させない設計を踏襲。GET /api/teams が受け付ける ?sort=/?search= はサーバー側の便宜のため
//   用意されているが、このページは box と同じ「1回取得してクライアントでフィルタ」方式に揃える)。
// - 「絞り込み」は当初ツールバーに置かない設計だった(docs/plan/pages/team.md 参照。チームに
//   絞る軸が無いため)が、UI改修依頼(2026-08-01)「ボックス画面と同様にお気に入り機能(フィルタも)
//   を追加する」により、box/index.astroと同じ「お気に入りのみ表示」の単一トグルのみ追加した。
// - 一覧カードは体数バッジ(N/6)+メンバーの公式絵ミニサムネイル列を持つ(設計レビューR-12: これが
//   無いと「複数の構成案を並べて見比べる」というページの存在理由が果たせない)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
// 🔴 UI改修依頼(チームトップ画面、2026-08-01)「レギュレーションによるフィルタを追加」。
// 候補は jpoke 由来の一覧(src/lib/regulations.ts)。画面側でレギュレーション名を
// ハードコードしない(ボックス画面 box/index.astro と同じ方針)。
import { REGULATIONS } from '../../lib/regulations';

const user = Astro.locals.user;
---
<AppLayout title="チーム" description="登録したチーム編成の一覧・検索・並べ替え" current="team">
	<Fragment slot="topbar-status">
		<span class="badge tnum" id="team-count-badge" hidden>0チーム</span>
	</Fragment>
	<style>
		/* --- ツールバー(検索+並べ替え。box/index.astroの.panel-toolbarをそのまま流用。
		   「絞り込み」はこのページには置かない(docs/plan/pages/team.md参照)。 --- */
		.panel-toolbar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-3) var(--space-6);
			padding: var(--space-3) var(--space-5);
		}
		.toolbar-item {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}
		.toolbar-search {
			flex: 0 1 26rem;
		}
		.search-input-wrap {
			position: relative;
			display: flex;
			align-items: center;
			flex: 1;
		}
		.search-input-wrap .search-icon {
			position: absolute;
			left: 0.7em;
			color: var(--color-text-muted);
			pointer-events: none;
		}
		.toolbar-search input {
			width: 100%;
			min-width: 12em;
			padding-left: 2.1em;
		}

		/* UI改修依頼(チームトップ画面)「お気に入り機能(フィルタも)を追加する」。
		   box/index.astroの.favorite-filter-toggleと同じ値をこのページのスコープへ複製する
		   (新しい値は作っていない。Astroのscoped styleはページをまたいで共有されないため)。 */
		.favorite-filter-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.35em;
		}
		.favorite-filter-toggle[data-active="true"] {
			background: var(--color-primary);
			border-color: var(--color-primary);
			color: var(--color-primary-contrast);
		}
		.favorite-filter-toggle[data-active="true"]:hover:not(:disabled) {
			background: var(--color-surface);
			color: var(--color-primary);
		}

		@media (max-width: 640px) {
			.panel-toolbar { flex-direction: column; align-items: stretch; }
			.toolbar-item { width: 100%; margin-left: 0; }
			.toolbar-search { flex-basis: auto; }
			.toolbar-search input,
			.toolbar-regulation select,
			.toolbar-sort select { width: 100%; min-width: 0; }
		}

		/* --- カードグリッド(box/index.astroの.box-gridと同じ戦略)。
		   #team-list は display:contents にして、JSがinnerHTMLを差し替えても
		   その子要素(チームカード)がそのままこの.team-gridの直接の子として並ぶようにする。
		   追加タイル(button.add-card-tile)は#team-listの外側の兄弟要素なので、
		   一覧の再描画では一切触れられず、常に先頭に残り続ける(box/index.astroと同じ理由)。
		   カードグリッド自体は.panel-contentを使わず画面幅いっぱいに流す(00-foundation.md
		   「操作系は全幅」)。 --- */
		.team-content {
			padding: 0 var(--space-5);
		}
		.team-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			gap: var(--space-4);
			align-items: stretch;
			margin-top: var(--space-6);
		}
		#team-list {
			display: contents;
		}
		/* チームカードは常に6枠ぶんのサムネイルを描画するため、カード自体は正方形にしない
		   (box/index.astroのcard-pokemonと違い、内容量が個体ごとにばらつかないため高さは
		   自然と揃う)。追加タイルは基底.add-card-tile(global.css)のまま使い、CSS Gridの
		   既定align-items:stretchで同じ行のチームカードと同じ高さに伸びるのに任せる。 */
		.team-grid .add-card-tile {
			flex-direction: column;
			gap: var(--space-1);
			font-size: var(--font-size-sm);
			width: 100%;
			padding: var(--space-2);
			border-width: 1px;
			transition: border-color 0.15s, color 0.15s, background 0.15s;
		}
		.team-grid .add-card-tile:hover {
			background: var(--color-primary-soft);
		}
		.team-grid .add-card-tile .add-card-tile-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			border-radius: 50%;
			border: 1px solid var(--color-border);
			font-size: 1.4rem;
			font-weight: 300;
			line-height: 1;
			color: inherit;
			transition: border-color 0.15s;
		}
		.team-grid .add-card-tile:hover .add-card-tile-icon {
			border-color: var(--color-primary);
		}
		.team-grid .add-card-tile-label {
			font-size: 0.9em;
		}
		@media (prefers-reduced-motion: reduce) {
			.team-grid .add-card-tile,
			.team-grid .add-card-tile .add-card-tile-icon {
				transition: none;
			}
		}

		/* --- 状態メッセージ(読み込み中・エラー・空状態2種。box/index.astroと同じ作り) --- */
		#loading-message,
		#error-message {
			color: var(--color-text-muted);
			margin-top: var(--space-6);
		}
		#error-message { color: var(--color-danger-strong); }

		.empty-state {
			margin-top: var(--space-6);
			padding: var(--space-7) var(--space-5);
			border: 1px dashed var(--color-border);
			border-radius: var(--radius-lg);
			text-align: center;
			color: var(--color-text-muted);
		}
		.empty-state-icon {
			font-size: 2.4rem;
			margin: 0 0 var(--space-2);
		}
		.empty-state-title {
			margin: 0 0 var(--space-1);
			font-size: var(--font-size-lg);
			font-weight: 700;
			color: var(--color-text);
		}
		.empty-state-hint {
			margin: 0;
			font-size: var(--font-size-sm);
		}
		#no-match-message.empty-state {
			margin-top: var(--space-4);
		}

		/* .badge(global.css)は display:inline-flex を持つため、UAの[hidden]{display:none}に
		   author style(same-specificity/origin勝ち)として勝ってしまう(pitfalls.md「[hidden]は
		   詳細度で負ける」)。件数バッジをhidden属性で隠すこのページでは明示的に打ち消す。 */
		#team-count-badge[hidden] {
			display: none;
		}
	</style>

	{/*
	  チームカード(.card.card-team)は下部の<script>がdocument.createElement()で生成するため、
	  Astroのscoped style(data-astro-cid-*属性が付いた静的マークアップにしか当たらない)では
	  スタイルが適用されない(pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」)。
	  よってこれはis:globalで定義する。グローバルに漏れないよう.team-grid配下に限定したセレクタにする。
	*/}
	<style is:global>
		/* --- チームカード本体。基底の.card(global.css)にbackground/border/box-shadow/hoverの
		   持ち上がりを委譲し、ここでは.team-grid内固有のレイアウト(縦積み・ヘッダ行・サムネ行)
		   だけを定義する(box/index.astroの.card-pokemonと同じ委譲方針)。 --- */
		.team-grid .card-team {
			position: relative;
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
			text-decoration: none;
			color: inherit;
			/* UI改修依頼(チームトップ画面、2026-08-01)「ボックス画面と同じお気に入りデザインを
			   使う」対応。box/index.astroの.pin-toggle(カード左上角の直角三角形トリム)は
			   .card-pokemon側のoverflow:hiddenに支えられている(clip-pathで作った三角形が
			   カードの角丸からはみ出す部分を切り落とす)。このカードにも同じoverflow:hiddenを
			   足し、下の.card-team-pinで同じ意匠を再現できるようにする(box/index.astroは
			   別エージェントが編集中の担当外ファイルのため、値をこちらへ複製する。
			   .favorite-filter-toggleと同じ複製方針)。 */
			overflow: hidden;
		}
		.team-grid .card-team:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}

		/* --- ヘッダ行: チーム名(空/未設定なら「無題のチーム」)のみ(round-30 A-9(c)で
		   体数バッジをここから外しサムネ行直上へ移した)。削除ボタンをカード右上に絶対配置で
		   重ねるため、ヘッダにその分の余白を確保する。
		   実装者の判断: 削除ボタンは right: var(--space-2)(8px) + width 28px なので、
		   カード右端からボタン左端までの距離は 36px。カード自体の padding-right(.card の
		   --space-3 = 12px)を差し引いた不足分 24px(=1.5rem)が、ヘッダに追加で必要な
		   padding-rightの最小値。round-30以前は体数バッジぶんも見込んで2rem(32px)を
		   確保していたが、バッジを外した今は1.5remまで詰められる。
		   UI改修依頼(チームトップ画面、2026-08-01)「お気に入りボタンとチーム名が被らないように
		   する」対応: お気に入りボタンをbox/index.astroと同じ左上角の36×36px三角形トリムに
		   変更した(下の.card-team-pin参照)ため、右側と同じ考え方で左側にも余白を追加する。
		   三角形はcard左上の(0,0)起点でy=0付近ではほぼ全幅(36px)を占めるため、ヘッダ行
		   (チーム名、カード最上部)がその真下に来ると被る。右側と同じ計算(36px - カードの
		   padding-left 12px = 24px = 1.5rem)がちょうど接する境界値(実測でgap=0px、隙間ゼロで
		   重なりはしないが余裕が無い)だったため、1.75rem(28px)にして4pxの余白を確保する
		   (Playwrightのgetboundingclientrectで実測、隙間4pxを確認。報告参照)。 */
		.team-grid .card-team .card-team-header {
			display: flex;
			align-items: center;
			padding-left: 1.75rem;
			padding-right: 1.5rem;
		}
		.team-grid .card-team .card-team-name {
			margin: 0;
			font-size: var(--font-size-lg);
			font-weight: 700;
			line-height: 1.3;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* --- メタ行(round-30 A-9(b)/(c)): メモ(1行省略)+ 体数バッジN/6。サムネ行の直上に置く。
		   メモは空/未設定のチームでも同じ高さの<p>を必ず描画し(JS側)、min-heightで行の高さを
		   固定することで、メモの有無でカード全体の高さが変わらないようにする(round-30 A-9(b))。 --- */
		.team-grid .card-team .card-team-meta-row {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}
		/* UI改修依頼(チームトップ画面、2026-08-01)「チームメモをカードに常時表示せず、ホバー時に
		   表示するようにする」。以前はメモ本文を1行省略で常時表示していたが、box/index.astroや
		   このファイル自身が随所で使っている「title属性によるネイティブホバーツールチップ」の
		   確立済み規格(nameEl.title/img.titleと同じ手法)に揃え、メモがあるときだけ小さな
		   アイコン(📝)を表示してtitleに全文を持たせる方式に変える(JS側、下のrenderCard参照)。
		   min-heightはメモ有無に関わらずメタ行の高さを揃えるため(round-30 A-9(b))そのまま維持する。 */
		.team-grid .card-team .card-team-memo {
			flex: 1 1 auto;
			min-width: 0;
			margin: 0;
			min-height: calc(var(--font-size-sm) * 1.4);
			font-size: var(--font-size-sm);
			line-height: 1.4;
			color: var(--color-text-muted);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* UI改修依頼(チームトップ画面、2026-08-01)「『n/6』のような登録数表示を削除する」。
		   要素を消す指示でもDOMは残してCSSで見せない方針(.claude/skills/ui/references/pitfalls.md
		   「壊してはいけないもの」節、box/index.astroの.card-stat-gridと同じ扱い)に従い、
		   JS側の生成(renderCard)自体は変更せずdisplay:noneでのみ隠す。 */
		.team-grid .card-team .card-team-count-badge {
			flex-shrink: 0;
			display: none;
		}
		/* UI改修依頼(チームトップ画面、2026-08-01)「カードごとにレギュレーションをタグ表示する」。
		   新しい色トークンは作らず、このファイルで既に確立済みの.badge(global.css、
		   card-team-count-badgeと同じ土台)をそのまま流用する。regulationがnullのチームは
		   要素自体を生成しない(JS側renderCard参照。team/[id].astroのテラスタイプ未設定と同じ
		   判断: 合法な「未設定」状態のため行/要素を出さない)。 */
		.team-grid .card-team .card-team-regulation-badge {
			flex-shrink: 0;
			white-space: nowrap;
		}

		/* --- 削除ボタン: box/index.astroの.icon-button.delete-buttonと同じ規格
		   (28px丸ボタン・--color-danger-strong・hover時のみ可視)。カード遷移(<a>)と衝突しない
		   よう、クリック時はpreventDefault+stopPropagationする(JS側)。 --- */
		.team-grid .card-team .card-team-delete {
			position: absolute;
			top: var(--space-2);
			right: var(--space-2);
			z-index: 2;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-danger-strong);
			font-weight: 400;
			font-size: 0.85rem;
			line-height: 1;
			box-shadow: var(--shadow-sm);
		}
		.team-grid .card-team .card-team-delete:hover {
			background: var(--color-danger-soft);
			border-color: var(--color-danger-strong);
		}
		.team-grid .card-team .card-team-delete:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
		@media (hover: hover) and (pointer: fine) {
			.team-grid .card-team .card-team-delete {
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.15s, background 0.15s, border-color 0.15s;
			}
			.team-grid .card-team:hover .card-team-delete,
			.team-grid .card-team:focus-within .card-team-delete {
				opacity: 1;
				pointer-events: auto;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.team-grid .card-team .card-team-delete { transition: none; }
		}

		/* --- お気に入り(ピン留め)ボタン。
		   UI改修依頼(チームトップ画面、2026-08-01)「ボックス画面(/box)と同じお気に入り
		   デザインを使う」により、box/index.astroの.pin-toggle(2026-08-01時点の実装)と
		   同じ値へ作り替える: 28px丸ボタンをやめ、カード左上角に密着する36×36pxの
		   直角三角形トリム(clip-path)にする。三角形の意匠自体を常時見せる方針のため、
		   お気に入り状態(★)・非お気に入り状態(☆)のどちらも常時可視のまま
		   (.card-team-deleteのようなhover限定表示にはしない、box/index.astroと同じ判断)。
		   box/index.astroは別エージェントが編集中の担当外ファイルのため直接参照はせず、
		   値をこのページのscoped styleへ複製する(.favorite-filter-toggleと同じ複製方針)。
		   アイコン文字(★/☆)は三角形の重心付近(左上から辺の1/3)に来るようpaddingで寄せる。
		   ピン留め中の配色は従来どおり--color-risky/--color-primary-contrastを使う
		   (新しい値は作っていない)。 --- */
		.team-grid .card-team .card-team-pin {
			position: absolute;
			top: 0;
			left: 0;
			z-index: 2;
			display: inline-flex;
			align-items: flex-start;
			justify-content: flex-start;
			width: 36px;
			height: 36px;
			padding: 5px 0 0 5px;
			border: none;
			border-radius: 0;
			box-shadow: none;
			clip-path: polygon(0 0, 100% 0, 0 100%);
			background: var(--color-surface-alt);
			color: var(--color-text-muted);
			font-weight: 400;
			font-size: 1.05rem;
			line-height: 1;
		}
		.team-grid .card-team .card-team-pin:hover {
			background: var(--color-surface);
			color: var(--color-text);
		}
		.team-grid .card-team .card-team-pin[data-pinned="true"] {
			background: var(--color-risky);
			color: var(--color-primary-contrast);
		}
		.team-grid .card-team .card-team-pin[data-pinned="true"]:hover {
			background: var(--color-risky);
			color: var(--color-primary-contrast);
		}

		/* --- メンバーの公式絵ミニサムネイル列(設計レビューR-12): 6枠ぶんを常に描画し、
		   空き枠は点線の空プレースホルダーとして見せる(「並べて見比べる」目的の要)。 ---
		   UI改修依頼(チームトップ画面)「配置を1x6→2x3に、アイコンを2倍に」対応:
		   1行6列から3列2行へ変更する。カード幅は変えないため、1マスの幅(aspect-ratio:1/1の
		   サムネイル自体のサイズ)は6列時のちょうど2倍になる(「アイコンを2倍に」を数値指定
		   ではなくこの列数変更だけで自然に満たす)。 */
		.team-grid .card-team .card-team-thumb-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.3rem;
		}
		.team-grid .card-team .card-team-thumb {
			position: relative;
			aspect-ratio: 1 / 1;
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			overflow: hidden;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		/* UI改修依頼(チームトップ画面、2026-08-01)「未設定のポケモンの枠を、設定済みの枠と
		   同じ見た目にする」。round-30 A-4で導入した空き枠専用の破線罫線(is-empty、旧
		   `border: 2px dashed var(--color-text-muted); background: transparent;`)は撤回し、
		   .card-team-thumbの基底スタイル(実線罫線var(--color-border)+背景var(--color-surface))を
		   設定済み/未設定の両方でそのまま使う(このルール自体を削除)。.is-emptyクラスの付与
		   (下のscript参照)自体は変更しない(枠内の中央番号表示の分岐に使う)。
		   代わりに、未設定枠だけ中央にその枠が何番目(N)かを薄い色の数字で表示する
		   (.card-team-thumb-slot-number、下記。設定済み枠は公式絵で埋まるため数字は出さない)。 */
		.team-grid .card-team .card-team-thumb-slot-number {
			font-size: 1.5rem;
			font-weight: 700;
			line-height: 1;
			color: var(--color-text-muted);
			opacity: 0.5;
			user-select: none;
		}
		.team-grid .card-team .card-team-thumb-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-grid .card-team .card-team-thumb-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			color: var(--color-primary);
			font-weight: 700;
			font-size: 0.75rem;
			background: var(--color-primary-soft);
		}
		/* UI改修依頼(チームトップ画面)「アイテムアイコンも表示」。box/index.astroの
		   .card-item-badge(スプライト右下重畳)と同じ考え方をミニサムネイル用に縮小して適用する。
		   .card-team-thumbは既にposition:relativeを持つため、その右下隅に重ねる。
		   UI改修依頼(チームトップ画面、2026-08-01)「アイテムアイコンの丸枠を削除する」:
		   border-radius: 50%(丸枠)を撤去する。背景・枠線・影は、公式絵に重なっても
		   アイコンが視認できるようにするための土台として残す(丸みだけを除去)。 */
		.team-grid .card-team .card-team-thumb-item-badge {
			position: absolute;
			right: 2px;
			bottom: 2px;
			/* UI改修依頼(チームトップ画面、2026-08-01)「アイテム画像を20%大きくする」。
			   実測(Playwright、getBoundingClientRect): 変更前は var(--icon-size-sm) の
			   実値どおり20×20px。20px×1.2=24pxへ拡大する。共有トークン(--icon-size-sm、
			   global.css)自体は他画面にも影響するため変更せず、このセレクタだけ固定px値へ
			   切り替える(トークン経由をやめる)。 */
			width: 24px;
			height: 24px;
			/* UI改修依頼(チームトップ画面、2026-08-01)「アイテム画像は枠をつけず透過で貼り付ける」:
			   background(var(--color-surface))とborderを撤去する。画像自体がtransparent PNG
			   前提のため土台の四角い箱を無くし、公式絵の上に直接重なるようにする。box-shadowは
			   その土台に対する影のため、背景・枠と合わせて外す(残すと角だけの影が浮いて見える)。 */
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}
		/* button:disabledと同じ罠(pitfalls.md): [hidden]のdisplay:noneをこのルールのflexが
		   詳細度で上書きしてしまうため、明示的に上書きする(box/index.astroの
		   .card-item-badge[hidden]と同じ対策)。 */
		.team-grid .card-team .card-team-thumb-item-badge[hidden] {
			display: none;
		}
		.team-grid .card-team .card-team-thumb-item-badge img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
	</style>

	<div class="page team-shell">
		{
			user ? (
				<Fragment>
					<div class="panel panel-top panel-toolbar" id="team-toolbar">
						<div class="toolbar-item toolbar-search">
							<label class="field-label" for="search-input">検索</label>
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="search-input"
									type="search"
									class="field-control"
									placeholder="チーム名"
									autocomplete="off"
								/>
							</div>
						</div>

						{/* UI改修依頼(チームトップ画面)「ボックス画面と同様にお気に入り機能(フィルタも)を
						    追加する」。box/index.astroの.toolbar-favorite/#favorite-filter-toggleと
						    同じマークアップ・クラス名(下のCSS参照、値も同一)を踏襲する。 */}
						<div class="toolbar-item toolbar-favorite">
							<button
								type="button"
								id="favorite-filter-toggle"
								class="favorite-filter-toggle"
								data-active="false"
								aria-pressed="false"
							>
								<span aria-hidden="true">★</span> お気に入り
							</button>
						</div>

						{/* 🔴 UI改修依頼(チームトップ画面、2026-08-01)「レギュレーションによるフィルタを
						    追加」。box/index.astroの#regulation-filterと同じ値・同じ番兵(__none__)を使う
						    (2画面で絞り込みの語彙を揃える)。取得済みの一覧をクライアント側で絞る点も同じ。 */}
						<div class="toolbar-item toolbar-regulation">
							<label class="field-label" for="regulation-filter">レギュレーション</label>
							<select id="regulation-filter" class="field-control">
								<option value="">すべて</option>
								{REGULATIONS.map((r) => <option value={r}>{r}</option>)}
								<option value="__none__">未設定</option>
							</select>
						</div>

						<div class="toolbar-item toolbar-sort">
							<label class="field-label" for="sort-select">並べ替え</label>
							<select id="sort-select" class="field-control">
								<option value="updated_at">最終更新順</option>
								<option value="name">名前順</option>
							</select>
						</div>
					</div>

					<div class="team-content">
						<p id="loading-message">読み込み中...</p>
						<p id="error-message" hidden></p>

						<div class="team-grid">
							<button type="button" class="add-card-tile" id="add-team-button">
								<span class="add-card-tile-icon" aria-hidden="true">＋</span>
								<span class="add-card-tile-label">チームを追加</span>
							</button>
							<div id="team-list"></div>
						</div>

						<div id="empty-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🧩</p>
							<p class="empty-state-title">チームがまだ登録されていません</p>
							<p class="empty-state-hint">「＋ チームを追加」から最初の構成案を作りましょう。</p>
						</div>

						<div id="no-match-message" class="empty-state" hidden>
							<p class="empty-state-icon" aria-hidden="true">🔍</p>
							<p class="empty-state-title">条件に一致するチームがいません</p>
							<p class="empty-state-hint">検索語や「お気に入りのみ表示」の条件を変更してください。</p>
						</div>
					</div>
				</Fragment>
			) : (
				<section class="panel">
					<div class="panel-content">
						<p>チーム編成機能を利用するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			)
		}
	</div>

	<script>
		// UI: チームカードに公式絵ミニサムネイルを表示するためのブラウザ専用ヘルパー。
		// box/index.astroのapplyCardSpriteと同じ「初期display:none→onloadで表示、
		// 解決不能/読み込み失敗時は頭文字バッジへフォールバック」方式を採る。
		import { loadImageIdMap, officialArtworkUrl } from "../../lib/pokemon-master-data";
		import { loadItemSpriteMap, itemIconUrl } from "../../lib/sprite-urls";

		// GET /api/teams が返す1メンバーの owned_pokemon。表示に必要な列だけを持つ
		// (src/lib/team.ts の TeamMember/OwnedPokemonRecord のサブセット)。
		// UI改修依頼(チームトップ画面)「アイテムアイコンも表示」対応でitem_nameを追加。
		// APIのSELECT自体(TEAM_SELECT_WITH_MEMBERS、src/lib/team.ts)は元々item_nameを
		// 含んでいたため、サーバー側の変更は不要。
		interface TeamMemberPokemon {
			id: string;
			nickname: string | null;
			species_name: string;
			item_name: string | null;
		}
		interface TeamMemberEntry {
			slot: number;
			owned_pokemon: TeamMemberPokemon;
		}
		interface Team {
			id: string;
			name: string | null;
			memo: string | null;
			// レギュレーション(migrations/013_regulation.sql)。未指定は null。
			regulation: string | null;
			is_pinned: boolean;
			created_at: string;
			updated_at: string;
			members: TeamMemberEntry[];
		}

		function el<T extends HTMLElement>(id: string): T {
			const found = document.getElementById(id);
			if (!found) throw new Error(`要素が見つかりません: #${id}`);
			return found as T;
		}

		const listRoot = document.getElementById("team-list");
		if (listRoot) {
			const loadingMessage = el<HTMLElement>("loading-message");
			const errorMessage = el<HTMLElement>("error-message");
			const emptyMessage = el<HTMLElement>("empty-message");
			const noMatchMessage = el<HTMLElement>("no-match-message");
			const countBadge = el<HTMLElement>("team-count-badge");
			const sortSelect = el<HTMLSelectElement>("sort-select");
			const searchInput = el<HTMLInputElement>("search-input");
			const favoriteFilterToggle = el<HTMLButtonElement>("favorite-filter-toggle");
			// 🔴 UI改修依頼(チームトップ画面、2026-08-01)「レギュレーションによるフィルタを追加」。
			const regulationFilter = el<HTMLSelectElement>("regulation-filter");
			const addButton = el<HTMLButtonElement>("add-team-button");
			const ADD_BUTTON_DEFAULT_HTML = addButton.innerHTML;

			let allTeams: Team[] = [];
			// UI改修依頼(チームトップ画面)「お気に入り機能(フィルタ)を追加する」。
			// box/index.astroのfavoriteOnlyと同じ単一boolean(絞り込み軸は「お気に入りのみ」だけ)。
			let favoriteOnly = false;

			// 種族名→imageId(画像用PokeAPI ID)のマップ。一覧の初回描画(loadList→renderList)は
			// この解決を待たずに進め、解決済みになった時点で各サムネイルから個別にthenする
			// (box/index.astroと同じ「体感速度を優先」の方針)。
			const imageIdMapPromise = loadImageIdMap();

			// name(空/未設定)なら「無題のチーム」にフォールバック(docs/plan/pages/team.md確定仕様)。
			function displayName(t: Team): string {
				if (t.name && t.name.trim() !== "") return t.name;
				return "無題のチーム";
			}

			// round-30 B-3: ミニサムネのtitle用。ニックネーム→種族名→「未設定」
			// (docs/plan/pages/team.md R-15と同じフォールバック順)。
			function memberDisplayName(p: TeamMemberPokemon): string {
				if (p.nickname && p.nickname.trim() !== "") return p.nickname;
				if (p.species_name && p.species_name.trim() !== "") return p.species_name;
				return "未設定";
			}

			async function applyThumbSprite(imgEl: HTMLImageElement, fallbackEl: HTMLElement, name: string): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = officialArtworkUrl(imageId);
			}

			// UI改修依頼(チームトップ画面)「アイテムアイコンも表示」。box/index.astroの
			// .card-item-badge(applyItemImage相当)と同じ「解決不能/読み込み失敗時はバッジごと
			// 隠す」方式。アイテムの画像用マップは初回参照時に1回だけ取得しキャッシュする。
			const itemSpriteMapPromise = loadItemSpriteMap();
			async function applyThumbItemSprite(badgeEl: HTMLElement, imgEl: HTMLImageElement, name: string): Promise<void> {
				const spritePath = name ? (await itemSpriteMapPromise).get(name) : undefined;
				const url = spritePath ? itemIconUrl(spritePath) : null;
				if (!url) {
					badgeEl.hidden = true;
					return;
				}
				imgEl.onerror = () => {
					badgeEl.hidden = true;
				};
				imgEl.onload = () => {
					badgeEl.hidden = false;
				};
				imgEl.src = url;
			}

			// チーム名の部分一致(box/index.astroのmatchesSearchと同じAND部分一致方式)。
			function matchesSearch(t: Team, term: string): boolean {
				if (!term) return true;
				const haystack = (t.name ?? "").toLowerCase();
				return term
					.toLowerCase()
					.split(/\s+/)
					.filter((tok) => tok.length > 0)
					.every((tok) => haystack.includes(tok));
			}

			// UI改修依頼(チームトップ画面)「お気に入り機能を追加する」。box/index.astroの
			// matchesFavoriteと同じ(絞り込み軸は「お気に入りのみ」の1つだけ)。
			function matchesFavorite(t: Team): boolean {
				return !favoriteOnly || t.is_pinned;
			}

			// 🔴 UI改修依頼(チームトップ画面、2026-08-01)「レギュレーションによるフィルタを追加」。
			// ""=すべて / "__none__"=未設定のチームだけ / それ以外=そのレギュレーションのチームだけ
			// (box/index.astro の matchesRegulation と同じ規則)。
			function matchesRegulation(t: Team): boolean {
				const selected = regulationFilter.value;
				if (selected === "") return true;
				if (selected === "__none__") return !t.regulation;
				return t.regulation === selected;
			}

			// 設計レビューR-14: 名前順ソートでは無題チーム(name=null/空)を末尾にする。
			function sortTeams(list: Team[]): Team[] {
				const sort = sortSelect.value;
				const sorted = [...list];
				if (sort === "name") {
					sorted.sort((a, b) => {
						const aTitled = !!(a.name && a.name.trim() !== "");
						const bTitled = !!(b.name && b.name.trim() !== "");
						if (aTitled !== bTitled) return aTitled ? -1 : 1;
						if (!aTitled && !bTitled) return 0;
						return (a.name as string).localeCompare(b.name as string, "ja");
					});
				} else {
					sorted.sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
				}
				// UI改修依頼(チームトップ画面)「お気に入り機能を追加する」。box/index.astroの
				// 40-B1/41-B2と同じ理由(round-40.md/round-41.md): 「最終更新順」表示中はピン優先の
				// 再ソートを外す。お気に入りトグル(toggleTeamPin)はupdated_atに触れない専用PATCH
				// 経路(updateTeamPinStatus)を使うため、この分岐が無くても更新順の相対位置は動かない
				// が、box/index.astroとの一貫性のため同じ挙動(更新順表示ではピンを一切優先しない)にする。
				if (sort !== "updated_at") {
					sorted.sort((a, b) => Number(b.is_pinned) - Number(a.is_pinned));
				}
				return sorted;
			}

			// チームカードを丸ごとクリック可能な<a>にする(box/index.astroの.card-pokemonと同じ方針)。
			// 削除ボタンはカード内の<button>だが、クリック時は必ずpreventDefault/stopPropagationして
			// カード本体の遷移(/team/<id>)と競合しないようにする。
			function renderCard(t: Team): HTMLAnchorElement {
				const card = document.createElement("a");
				card.className = "card card-team";
				card.href = `/team/${encodeURIComponent(t.id)}`;
				const name = displayName(t);
				card.setAttribute("aria-label", `${name} を編集`);

				// UI改修依頼(チームトップ画面)「お気に入り機能を追加する」。box/index.astroの
				// pinButton(左上・常時可視)と同じ発想。削除ボタン(右上)と対角配置にする。
				const pinButton = document.createElement("button");
				pinButton.type = "button";
				pinButton.className = "card-team-pin";
				pinButton.dataset.pinned = String(t.is_pinned);
				pinButton.textContent = t.is_pinned ? "★" : "☆";
				const pinLabel = t.is_pinned ? "お気に入りを解除する" : "お気に入りにする";
				pinButton.title = pinLabel;
				pinButton.setAttribute("aria-label", pinLabel);
				pinButton.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();
					void toggleTeamPin(t);
				});
				card.appendChild(pinButton);

				const deleteButton = document.createElement("button");
				deleteButton.type = "button";
				deleteButton.className = "card-team-delete";
				deleteButton.textContent = "🗑";
				deleteButton.title = "削除";
				deleteButton.setAttribute("aria-label", "削除");
				deleteButton.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();
					void deleteTeamCard(t);
				});
				card.appendChild(deleteButton);

				// --- ヘッダ行: チーム名 + 体数バッジN/6 ---
				const header = document.createElement("div");
				header.className = "card-team-header";

				const nameEl = document.createElement("p");
				nameEl.className = "card-team-name";
				nameEl.textContent = name;
				// round-30 A-9(a): 省略された全文をホバーで読めるようにする。
				nameEl.title = name;
				header.appendChild(nameEl);

				card.appendChild(header);

				// --- メタ行(round-30 A-9(b)/(c)): メモ + 体数バッジ ---
				// UI改修依頼(チームトップ画面、2026-08-01)「チームメモをカードに常時表示せず、
				// ホバー時に表示するようにする」。本文を直接テキスト表示していたのをやめ、
				// メモがあるときだけ小さなアイコン(📝)を出し、全文はtitle属性(ネイティブの
				// ホバーツールチップ、box/index.astroのname.title等と同じ確立済み規格)に持たせる。
				// メモが無いときはアイコンも出さない(空でも高さは.card-team-memoのmin-heightで保つ、
				// round-30 A-9(b)の意図を維持)。
				const metaRow = document.createElement("div");
				metaRow.className = "card-team-meta-row";

				const memoEl = document.createElement("p");
				memoEl.className = "card-team-memo";
				const memoText = (t.memo ?? "").trim();
				if (memoText) {
					memoEl.textContent = "📝";
					memoEl.title = memoText;
					memoEl.setAttribute("aria-label", `メモ: ${memoText}`);
				}
				metaRow.appendChild(memoEl);

				// UI改修依頼(チームトップ画面、2026-08-01)「カードごとにレギュレーションをタグ表示する」。
				// nullは合法な未設定状態のため、要素自体を生成しない(itemName/teraTypeと同じ判断)。
				const regulation = t.regulation?.trim() ?? "";
				if (regulation) {
					const regulationBadge = document.createElement("span");
					regulationBadge.className = "badge card-team-regulation-badge";
					regulationBadge.textContent = regulation;
					metaRow.appendChild(regulationBadge);
				}

				const memberCountBadge = document.createElement("span");
				memberCountBadge.className = "badge tnum card-team-count-badge";
				memberCountBadge.textContent = `${t.members.length}/6`;
				metaRow.appendChild(memberCountBadge);

				card.appendChild(metaRow);

				// --- メンバーの公式絵ミニサムネイル列(6枠常時描画。空き枠はプレースホルダー) ---
				const thumbGrid = document.createElement("div");
				thumbGrid.className = "card-team-thumb-grid";
				thumbGrid.setAttribute("aria-hidden", "true");

				const membersBySlot = new Map(t.members.map((m) => [m.slot, m]));
				for (let slot = 1; slot <= 6; slot++) {
					const member = membersBySlot.get(slot);
					const thumb = document.createElement("div");
					thumb.className = "card-team-thumb" + (member ? "" : " is-empty");
					if (member) {
						const img = document.createElement("img");
						img.className = "card-team-thumb-img";
						img.alt = "";
						// round-30 B-3: 似た配色の種族を見分けられるようホバーで表示名を出す(レイアウト不変)。
						img.title = memberDisplayName(member.owned_pokemon);
						img.style.display = "none";
						thumb.appendChild(img);

						const fallback = document.createElement("span");
						fallback.className = "card-team-thumb-fallback";
						thumb.appendChild(fallback);

						void applyThumbSprite(img, fallback, member.owned_pokemon.species_name ?? "");

						// UI改修依頼(チームトップ画面)「アイテムアイコンも表示」。
						const itemBadge = document.createElement("span");
						itemBadge.className = "card-team-thumb-item-badge";
						itemBadge.hidden = true;
						const itemImg = document.createElement("img");
						itemImg.alt = "";
						const itemName = member.owned_pokemon.item_name ?? "";
						itemImg.title = itemName;
						itemBadge.appendChild(itemImg);
						thumb.appendChild(itemBadge);
						void applyThumbItemSprite(itemBadge, itemImg, itemName);
					} else {
						// UI改修依頼(チームトップ画面、2026-08-01)「未設定枠には中央に薄い色で
						// その枠がチーム内で何番目か(N)の数字を表示する」。
						const slotNumber = document.createElement("span");
						slotNumber.className = "card-team-thumb-slot-number";
						slotNumber.textContent = String(slot);
						thumb.appendChild(slotNumber);
					}
					thumbGrid.appendChild(thumb);
				}

				card.appendChild(thumbGrid);

				return card;
			}

			function renderList(): void {
				const filtered = allTeams.filter(
					(t) => matchesSearch(t, searchInput.value.trim()) && matchesFavorite(t) && matchesRegulation(t),
				);
				const sorted = sortTeams(filtered);
				listRoot.innerHTML = "";
				// 「本当に0件」(空状態)と「絞り込みで0件」(検索結果なし)を区別する
				// (box/index.astroの#empty-message/#no-match-messageと同じ切り分け)。
				const isTrulyEmpty = allTeams.length === 0;
				emptyMessage.hidden = !isTrulyEmpty;
				noMatchMessage.hidden = isTrulyEmpty || sorted.length > 0;
				updateCountBadge(sorted.length);
				if (isTrulyEmpty) return;
				for (const t of sorted) {
					listRoot.appendChild(renderCard(t));
				}
			}

			function updateCountBadge(visibleCount: number): void {
				const total = allTeams.length;
				countBadge.textContent = visibleCount === total ? `${total}チーム` : `${visibleCount} / ${total}チーム`;
				countBadge.hidden = false;
			}

			// UI改修依頼(チームトップ画面)「お気に入り機能を追加する」。box/index.astroのtogglePinと
			// 同じ設計: is_pinnedだけを更新する専用PATCH経路(updateTeamPinStatus、src/lib/team.ts)を
			// 使い、updated_atには触れない。
			async function toggleTeamPin(t: Team): Promise<void> {
				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(t.id)}`, {
						method: "PATCH",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ is_pinned: !t.is_pinned }),
					});
					if (!res.ok) throw new Error(`お気に入りの更新に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { team: Team };
					const idx = allTeams.findIndex((x) => x.id === t.id);
					if (idx !== -1) allTeams[idx] = body.team;
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("お気に入りの更新に失敗しました。時間をおいて再度お試しください。");
				}
			}

			async function deleteTeamCard(t: Team): Promise<void> {
				if (!window.confirm(`「${displayName(t)}」を削除します。よろしいですか?`)) return;
				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(t.id)}`, {
						method: "DELETE",
						credentials: "same-origin",
					});
					if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
					allTeams = allTeams.filter((x) => x.id !== t.id);
					renderList();
				} catch (err) {
					console.error(err);
					window.alert("削除に失敗しました。時間をおいて再度お試しください。");
				}
			}

			// 「＋ チームを追加」: クリックした瞬間に空チーム(name/memoともnull、members空)を
			// 自動登録し、そのまま編集画面(/team/[id])へ遷移する。連打による二重登録を防ぐため、
			// リクエスト中はボタンをdisabledにしてラベルを変更し、失敗時のみ復元する
			// (成功時はページ遷移するため復元不要。box/index.astroのcreateEmptyPokemonと同じ方針)。
			async function createEmptyTeam(): Promise<void> {
				addButton.disabled = true;
				addButton.textContent = "作成中...";
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/teams", {
						method: "POST",
						credentials: "same-origin",
					});
					const body = (await res.json().catch(() => ({}))) as { team?: { id: string }; error?: string };
					if (!res.ok || !body.team) {
						throw new Error(body.error ?? `作成に失敗しました (status=${res.status})`);
					}
					window.location.href = `/team/${encodeURIComponent(body.team.id)}`;
				} catch (err) {
					console.error(err);
					errorMessage.hidden = false;
					errorMessage.textContent = "チームの作成に失敗しました。時間をおいて再度お試しください。";
					addButton.disabled = false;
					addButton.innerHTML = ADD_BUTTON_DEFAULT_HTML;
				}
			}

			async function loadList(): Promise<void> {
				loadingMessage.hidden = false;
				errorMessage.hidden = true;
				try {
					const res = await fetch("/api/teams", { credentials: "same-origin" });
					if (!res.ok) throw new Error(`一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { teams: Team[] };
					allTeams = body.teams;
					loadingMessage.hidden = true;
					renderList();
				} catch (err) {
					console.error(err);
					loadingMessage.hidden = true;
					errorMessage.hidden = false;
					errorMessage.textContent = "一覧の取得に失敗しました。時間をおいて再度お試しください。";
				}
			}

			sortSelect.addEventListener("change", renderList);
			searchInput.addEventListener("input", renderList);
			regulationFilter.addEventListener("change", renderList);
			favoriteFilterToggle.addEventListener("click", () => {
				favoriteOnly = !favoriteOnly;
				favoriteFilterToggle.dataset.active = String(favoriteOnly);
				favoriteFilterToggle.setAttribute("aria-pressed", String(favoriteOnly));
				renderList();
			});
			addButton.addEventListener("click", () => void createEmptyTeam());

			void loadList();
		}
	</script>
</AppLayout>
