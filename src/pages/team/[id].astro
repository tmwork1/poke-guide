---
// チーム編集ページ(docs/plan/pages/team.md「確定した設計 > 画面 > /team/[id](編集)」)。
// 初期表示データは box/[id].astro と同じ方針で、API経由のfetchではなくAstroのフロントマター
// (SSR)で src/lib/team.ts の getTeam() を直接呼び出す(初期表示が速く、「生のSupabaseクエリは
// lib層に集約する」という設計原則にも合致する)。
//
// 未ログイン時、および他人のチーム/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(box/[id].astroと同じ既存方針)。
export const prerender = false;


import AppLayout from '../../layouts/AppLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { getTeam, type Team } from '../../lib/team';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import '../../styles/team-pokemon-card.css';
import '../../styles/team-mate-card.css';
import '../../styles/team-pokemon-tab.css';
import '../../styles/box-card.css';
import '../../styles/floating-list-controls.css';
import '../../styles/team-data-tab.css';
import '../../styles/team-card.css';
import '../../styles/app-header.css';
import '../../styles/matchup-panel.css';
import '../../styles/item-select-dialog.css';
import '../../styles/team-item-redistribute-dialog.css';
import '../../styles/guest-login-dialog.css';

const user = Astro.locals.user;
const id = Astro.params.id;
const isNewMode = id === 'new';
const isGuestNewMode = isNewMode && !user;

let team: Team | null = null;
let loadError = false;

if (!user && !isNewMode) {
	const now = new Date().toISOString();
	team = {
		id: isNewMode ? '' : (id ?? ''),
		user_id: '',
		memo: null,
		is_pinned: false,
		created_at: now,
		updated_at: now,
		members: [],
	};
} else if (isNewMode) {
		const now = new Date().toISOString();
		team = {
			id: '',
			user_id: user.id,
			memo: null,
			is_pinned: false,
			created_at: now,
			updated_at: now,
			members: [],
		};
	} else if (id) {
		const supabase = await getSupabaseAdminClient();
		const result = await getTeam(user.id, id, supabase);
		if (result.ok) {
			team = result.data;
		} else {
			loadError = true;
		}
		if (!team && !loadError) {
			Astro.response.status = 404;
		}
	}

const pageTitle = 'チーム編集';
const bodyClass = team ? 'team-edit-page' : undefined;
const requestedMobileTab = Astro.url.searchParams.get('tab');
const initialMobileTab = requestedMobileTab === 'formation' || requestedMobileTab === 'matchup' || requestedMobileTab === 'data'
	? requestedMobileTab
	: 'pokemon';

// 初期メンバー(0〜6要素、SSR取得済み)をクライアント<script>へそのまま引き渡す。
// Astroの属性値は自動でHTMLエスケープされるので、メモ等に " や < が
// 含まれていても壊れない(pokemon.tsの data-tags={JSON.stringify(...)} と同じ手法)。
const initialTeamJson = team
	? JSON.stringify({
			id: team.id,
			memo: team.memo,
			members: team.members,
		})
	: '';

let rankedSeason: string | null = null;
if (!isGuestNewMode) {
	try {
		rankedSeason = resolveDefaultSeason(await listRankedSeasons(await getSupabasePublicClient()));
	} catch (error) {
		console.error('[team/[id]] 類似構築のシーズン取得に失敗しました:', error);
	}
}
---
<AppLayout title={pageTitle} current="team" bodyClass={bodyClass}>
	{team && (
		<AppHeader ariaLabel="チーム編集メニュー">
			<div class="app-header__list">
				<button type="button" class="app-header__item" data-mobile-tab="pokemon" data-active={initialMobileTab === 'pokemon' ? 'true' : undefined} aria-current={initialMobileTab === 'pokemon' ? 'page' : undefined}><span>ポケモン</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="formation" data-active={initialMobileTab === 'formation' ? 'true' : undefined} aria-current={initialMobileTab === 'formation' ? 'page' : undefined}><span>編成</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="data" data-active={initialMobileTab === 'data' ? 'true' : undefined} aria-current={initialMobileTab === 'data' ? 'page' : undefined}><span>類似チーム</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="matchup" data-active={initialMobileTab === 'matchup' ? 'true' : undefined} aria-current={initialMobileTab === 'matchup' ? 'page' : undefined}><span>相性</span></button>
			</div>
		</AppHeader>
	)}
	{/* #autosave-status/#autosave-status-textのid・DOM自体は<script>のel()参照
	    (見つからないとthrowしてJS初期化が止まる)のため残し、テキストだけを下の<style>で
	    常時非表示にする(保存失敗時=data-state="error"のときだけ見せる)。 */}
	{team && (
		<div class="team-mobile-actions" id="team-mobile-actions">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span>
				<button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>

		</div>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button {
			display: none;
			margin-left: 0.4em;
		}
		#retry-button.visible {
			display: inline-flex;
		}
		#autosave-status {
			margin: 0;
		}
		/* #autosave-status-text自体はDOM/idごと残し(<script>のel("autosave-status-text")が
		   throwするのを避けるため)、テキストだけを常時非表示にする。保存失敗
		   (data-state="error")のときだけ、唯一のリカバリ手段である#retry-buttonに気づけるよう
		   理由テキストを見せる(box/[id].astroと同じ判断)。 */
		#autosave-status-text {
			display: none;
		}
		#autosave-status[data-state="error"] #autosave-status-text {
			display: inline;
			color: var(--color-danger);
		}
		/* global.cssのbutton.btn-dangerが持つ太字指定を上書きし、
		   戻るボタン(.app-header-back)と同じ文字サイズ・太さへ揃える。 */
		#copy-button,
		#delete-team-button { width: 100%; font-size: var(--font-size-sm1); white-space: nowrap; font-weight: var(--font-weight-medium); }
		.training-delete-actions {
			display: grid;
			gap: var(--space-3);
			margin-top: var(--space-8);
		}
		.training-delete-actions #copy-button,
		.training-delete-actions #delete-team-button { margin-top: 0; }
		/* box/[id].astro の #delete-button と同じ配色に揃える。基底(global.css の
		   button.btn-danger)は平常時=塗り(background:var(--color-danger-strong),
		   color:var(--color-primary-contrast))、hover時=白地反転
		   (background:var(--color-surface), color:var(--color-danger-strong))。
		   #delete-team-buttonはIDセレクタで button.btn-danger より詳細度が高いため、
		   global.css自体は変更せずに上書きできる(他画面の.btn-danger既定配色は維持される)。
		   border(2px solid var(--color-danger-strong))は基底のまま変えない。
		   background/colorは平常時・hover時の両方で必ずセットで書く(片方だけ上書きすると
		   文字色=背景色になって見えなくなるため)。 */
		#delete-team-button {
			background: var(--color-surface);
			color: var(--color-danger-strong);
		}
		#delete-team-button:disabled { opacity: 0.4; cursor: not-allowed; }
		#delete-team-button:hover:not(:disabled) {
			background: var(--color-danger-strong);
			color: var(--color-primary-contrast);
		}


	</style>

	<div class="page">
		{
			isGuestNewMode ? (
				<section class="panel">
					<div class="panel-content">
						<p>ログインすると、新しいチームを作成できます。</p>
						<a href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			) : loadError ? (
				<section class="panel">
					<div class="panel-content">
						<p>チーム情報を読み込めませんでした。時間をおいて再度お試しください。</p>
					</div>
				</section>
			) : !team ? (
				<section class="panel">
					<div class="panel-content">
						<p>指定されたチームが見つかりませんでした(削除された、または他のアカウントのチームである可能性があります)。</p>
					</div>
				</section>
			) : (
				<div class="team-edit-shell" id="team-edit-layout" data-team-id={team.id} data-initial-team={initialTeamJson} data-mobile-tab={initialMobileTab} data-ranked-season={rankedSeason ?? ''}>
					<section id="team-overview-tab" class="panel">
						<div class="panel-content">
							<div id="team-overview-grid" class="team-overview-thumb-grid" aria-label="チームメンバーのプレビュー"></div>
							<button type="button" id="team-item-redistribute-button" class="btn-control team-item-redistribute-button" aria-haspopup="dialog">
								<span class="team-item-redistribute-button-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg></span>
								<span>もちもの入替</span>
							</button>

							<textarea
								id="team-memo"
								class="field-control team-memo-input"
								placeholder="メモ"
								aria-label="メモ"
								autocomplete="off"
								rows="3">{team.memo ?? ''}</textarea>
							{!isNewMode && (
								<div class="team-mobile-actions__controls training-delete-actions">
									<button id="copy-button" class="btn-control" type="button" disabled={!user} title={!user ? "ログインするとコピーできます" : undefined}>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="1"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
										コピー
									</button>
									<button id="delete-team-button" class="btn-danger" type="button" disabled={!user} title={!user ? "ログインすると削除できます" : undefined}>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
										削除
									</button>
								</div>
							)}
						</div>
					</section>
					<div id="team-item-redistribute-backdrop" class="item-select-backdrop" hidden></div>
					<section id="team-item-redistribute-dialog" class="item-select-dialog team-item-redistribute-dialog" role="dialog" aria-modal="true" aria-labelledby="team-item-redistribute-title" tabindex="-1" hidden>
						<div class="item-select-header">
							<div class="team-item-redistribute-title-group">
								<h2 id="team-item-redistribute-title" class="item-select-title">もちもの入替</h2>
								<button type="button" id="team-item-redistribute-help-button" class="team-item-redistribute-help-button" aria-expanded="false" aria-controls="team-item-redistribute-help-popover" aria-label="使い方を表示">?</button>
								<p id="team-item-redistribute-help-popover" class="team-item-redistribute-help-popover" role="note" hidden>チーム画面のもちもの表示を変更できます。<br />ポケモンに登録したもちものは変わりません。</p>
							</div>
							<button type="button" id="team-item-redistribute-close" class="btn-ghost item-select-close" aria-label="閉じる">×</button>
						</div>
						<div class="team-item-redistribute-members-wrap">
							<div id="team-item-redistribute-members" class="team-item-redistribute-members team-mate-grid" aria-label="チームのポケモン"></div>
							<div id="team-item-redistribute-item-row" class="team-item-redistribute-item-row team-mate-grid" aria-label="表示中のもちもの"></div>
						</div>
						<div class="item-select-search-row">
							<div class="search-input-wrap item-select-search-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input type="text" id="team-item-redistribute-search" class="item-select-search-input field-control" placeholder="もちもの" aria-label="もちものを検索" autocomplete="off" />
							</div>
						</div>
						<div class="item-select-grid-wrap">
							<div id="team-item-redistribute-items" class="item-select-grid" role="listbox" aria-label="もちものを選択"></div>
							<p id="team-item-redistribute-empty" class="item-select-empty" hidden>該当するもちものがありません</p>
						</div>
					</section>
				<section id="team-formation-mobile" class="floating-list-page" aria-label="チーム編成">
					<div class="team-formation-mobile__sticky-header">
						<div class="team-formation-mobile__mates" aria-label="チームメイト">
							<div id="team-formation-mobile-slots" class="team-formation-mobile__slot-grid team-mate-grid"></div>
						</div>
						<div class="panel panel-top app-header app-header--toolbar" id="team-formation-mobile-toolbar">
							<div class="toolbar-item toolbar-search">
								<div class="search-input-wrap">
									<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="11" cy="11" r="7" />
										<line x1="21" y1="21" x2="16.65" y2="16.65" />
									</svg>
									<input id="team-formation-mobile-search" class="field-control" type="search" placeholder="ポケモン・特性・もちもの・わざ" aria-label="検索" autocomplete="off" />
								</div>
							</div>
							<div class="second-header-sort toolbar-item toolbar-sort">
								{/* box/index.astroの並べ替え(ボタン配置と仕組み)に共通化: 昇降切り替えは
								    選択ボックス左端に重ねる⇅ボタン1つに集約し、右端の別ボタンは廃止する。 */}
								<div class="sort-select-wrap box-sort-select-wrap" id="team-formation-mobile-sort-select-wrap" data-order="desc">
									<button type="button" class="sort-dir-toggle" id="team-formation-mobile-sort-dir-toggle" data-order="desc" aria-label="並べ替えの向き: 降順">⇅</button>
									<select id="team-formation-mobile-sort-select" class="field-control" aria-label="並べ替え">
									<option value="updated_at">更新順</option>
									<option value="dex_no">図鑑番号順</option>
									<option value="type">タイプ順</option>
									<option value="species_name">名前順</option>
									</select>
								</div>
							</div>
						</div>
					</div>
					<div class="team-formation-mobile__box">
						<p id="team-formation-mobile-status" class="status-text" hidden></p>
						<div id="team-formation-mobile-box-grid" class="box-grid">
							<button id="team-formation-mobile-add" class="add-card-tile floating-list-add-button" type="button" aria-label="個体を追加">
								<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 5v14" />
									<path d="M5 12h14" />
								</svg>
								<span class="add-card-tile-label">個体を追加</span>
							</button>
						</div>
					</div>
				</section>
				<section id="team-matchup-mobile" class="floating-list-page" aria-label="チーム相性">
					<div class="team-formation-mobile__mates" aria-label="チームメイト">
						<div id="team-matchup-mobile-slots" class="team-formation-mobile__slot-grid team-mate-grid"></div>
					</div>
					<div class="team-matchup-mobile__results">
						<p id="team-matchup-mobile-status" class="team-matchup-status" hidden></p>
						<ul id="team-matchup-mobile-list" class="team-matchup-list"></ul>
					</div>
				</section>
				<section id="team-data-mobile" class="floating-list-page" aria-label="類似チーム">
					<div class="team-formation-mobile__mates" aria-label="チームメイト">
						<div id="team-data-mobile-slots" class="team-formation-mobile__slot-grid team-mate-grid"></div>
					</div>
					<div id="team-formation-mobile-suggest" class="team-formation-mobile__suggest" aria-label="おすすめポケモン">
						<span class="team-formation-mobile__suggest-label">おすすめ</span>
						<div id="team-formation-mobile-suggest-icons" class="team-formation-mobile__suggest-icons"></div>
					</div>
					<div id="team-data-mobile-similar" class="team-data-similar-panel" aria-label="類似チーム"></div>
				</section>
				</div>
			)
		}
	</div>

	<dialog id="guest-login-dialog" class="guest-login-dialog" aria-labelledby="guest-login-title">
		<div class="guest-login-dialog__content">
			<h2 id="guest-login-title">新しいポケモンを作成</h2>
			<p>ログインすると、新しいポケモンを作成できます。</p>
			<div class="guest-login-dialog__actions">
				<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
				<button type="button" id="guest-login-close">閉じる</button>
			</div>
		</div>
	</dialog>

	<script>
		// チーム編集: ポケモン選択バー(左)と6枠(中央)を描画し、自動保存する。
		// 自動保存のデバウンス方式は box/[id].astro と同じ(700ms・保存ボタンは作らない・
		// topbar-statusスロットで状態表示)。初期表示データ(SSR取得済みのチーム)は
		// #team-edit-layout の data-initial-team から読む(fetch往復を待たずに6枠を描ける)。
		import { loadImageIdMap, officialArtworkUrl, championSpriteUrl, loadBaseStatsMap, loadMoveDetailMap, loadMegaStoneMap } from "../../lib/pokemon-master-data";
		import { itemIconUrl } from "../../lib/sprite-urls";
		import { DEFAULT_TYPE_COLOR, TYPE_COLORS } from "../../lib/type-colors";
		import { resolveDexNo, resolveSpeciesTypes } from "../../lib/species-dex";
		import { selectionBlockReason, type SelectionCandidate, type TeamRequestBody } from "../../lib/team-validation";
		import { createOwnedPokemon, listOwnedPokemonPage } from "../../lib/data/pokemon-repo";
		import { createTeam, deleteTeam, getTeamForGuest, updateTeam } from "../../lib/data/team-repo";
		import { isGuestMode } from "../../lib/data/guest-mode";
		import { STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";
		import {
			ownedPokemonDisplayName as displayName,
			renderBoxPokemonCard,
		} from "../../lib/box-pokemon-card";
		import { renderTeamMateSlots } from "../../lib/team-mate-card";
		import { renderTopBuildCard } from "../../lib/ranked-teams/card";
		import { calculateBuildSimilarity, calculateTeamSimilarity } from "../../lib/build-similarity";
		import { autosizeTextarea } from "../../lib/shared/autosize-textarea";
		import type { RankedTeam } from "../../lib/ranked-teams";
		import { kanaIncludes } from "../../lib/kana";
		import { initializeSortDirectionToggle } from "../../lib/shared/sort-direction-toggle";
		import { createMatchupPanel } from "../../lib/matchup-panel";
		import { setupAppHeaderSwipe } from "../../lib/app-header-swipe";
		import { createItemSelectGrid, sortItemsByUsage, isMegaStoneItemName } from "../../lib/box-id/item-select-dialog";

		interface OwnedPokemonRecord {
			id: string;
			species_name: string;
			// A-8: SSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方が既にability_nameを含んでいる。新規フェッチ・新規計算は不要で、この型に
			// 足すだけで枠カード・選択バーの両方から読める。
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			move_names: string[];
			// box/index.astroと同じ実数値計算(src/lib/stats.ts)に使う。level/nature/evs/ivsもSSR・
			// GET /api/owned-pokemonの両方に既に含まれているため、フロント側の型に足すだけでよい。
			level: number | null;
			nature: string | null;
			evs: number[];
			ivs: number[];
			// 「登録順」ソートに使う。SSR(lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon
			// (OWNED_POKEMON_COLUMNS)の両方に既にcreated_atを含んでいるため、この型に足すだけで
			// 読める(新規フェッチ不要)。
			created_at: string;
			// 一覧APIに既存の日時を、左パネルの利用目的別ソートに使う。
			updated_at: string;
			last_used_at: string | null;
			is_pinned: boolean;
			memo: string | null;
			tags: string[];
		}

		interface TeamMemberData {
			slot: number;
			item_override: string | null;
			owned_pokemon: OwnedPokemonRecord;
		}

		interface InitialTeam {
			id: string;
			memo: string | null;
			members: TeamMemberData[];
		}

		const layoutRoot = document.getElementById("team-edit-layout");
		if (layoutRoot) {
			let selectedOverviewSlot: number | null = null;
			let selectedFormationSlot: number | null = null;
			let selectedCandidatePokemon: OwnedPokemonRecord | null = null;
			let mobileTabsInitialized = false;
			const mobileTabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".app-header [data-mobile-tab]"));
			type MobileTab = "pokemon" | "formation" | "matchup" | "data";
			const setMobileTab = (tab: MobileTab) => {
				const tabChanged = layoutRoot.dataset.mobileTab !== tab;
				if (tabChanged) {
					selectedOverviewSlot = null;
					selectedFormationSlot = null;
					selectedCandidatePokemon = null;
				}
				layoutRoot.dataset.mobileTab = tab;
				for (const button of mobileTabButtons) {
					const active = button.dataset.mobileTab === tab;
					button.dataset.active = active ? "true" : "false";
					if (active) button.setAttribute("aria-current", "page");
					else button.removeAttribute("aria-current");
				}
				if (tab === "matchup" && tabChanged) {
					// 初期URLの適用は相性DOM参照の初期化より前に行われるため、計算開始だけを
					// 現在の同期スクリプトの完了後へ送る。クリック時も同じ経路で即座に開始する。
					queueMicrotask(() => {
						if (layoutRoot.dataset.mobileTab === "matchup") void runMatchup();
					});
				}
				if (tabChanged && mobileTabsInitialized) {
					renderOverviewGrid();
					renderFormationMobile();
				}
			};
			const requestedMobileTab = new URLSearchParams(window.location.search).get("tab");
			setMobileTab(
				requestedMobileTab === "formation" || requestedMobileTab === "matchup" || requestedMobileTab === "data"
					? requestedMobileTab
					: "pokemon",
			);
			for (const button of mobileTabButtons) {
				button.addEventListener("click", () => {
					const tab = button.dataset.mobileTab;
					setMobileTab(tab === "formation" || tab === "matchup" || tab === "data" ? tab : "pokemon");
				});
			}
			setupAppHeaderSwipe(document.querySelector<HTMLElement>(".app-header"), layoutRoot);
			let teamId = layoutRoot.dataset.teamId as string;
			let initialTeam: InitialTeam = JSON.parse(layoutRoot.dataset.initialTeam || "{}");
			if (isGuestMode() && teamId) {
				const guestTeam = getTeamForGuest(teamId);
				if (!guestTeam) {
					window.location.href = "/team";
					throw new Error("Guest team not found");
				}
				initialTeam = guestTeam;
			}

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) throw new Error(`要素が見つかりません: #${id}`);
				return found as T;
			}

			const guestLoginDialog = el<HTMLDialogElement>("guest-login-dialog");
			const guestLoginClose = el<HTMLButtonElement>("guest-login-close");
			guestLoginClose.addEventListener("click", () => guestLoginDialog.close());
			function showGuestLoginDialog(): void {
				guestLoginDialog.showModal();
			}

			const memoInput = el<HTMLTextAreaElement>("team-memo");
			const overviewGrid = el<HTMLElement>("team-overview-grid");
			const itemRedistributeButton = el<HTMLButtonElement>("team-item-redistribute-button");
			autosizeTextarea(memoInput);
			const itemRedistributeBackdrop = el<HTMLElement>("team-item-redistribute-backdrop");
			const itemRedistributeDialog = el<HTMLElement>("team-item-redistribute-dialog");
			const itemRedistributeClose = el<HTMLButtonElement>("team-item-redistribute-close");
			const itemRedistributeHelpButton = el<HTMLButtonElement>("team-item-redistribute-help-button");
			const itemRedistributeHelpPopover = el<HTMLElement>("team-item-redistribute-help-popover");
			const itemRedistributeMembers = el<HTMLElement>("team-item-redistribute-members");
			const itemRedistributeItemRow = el<HTMLElement>("team-item-redistribute-item-row");
			const itemRedistributeSearch = el<HTMLInputElement>("team-item-redistribute-search");
			const itemRedistributeItems = el<HTMLElement>("team-item-redistribute-items");
			const itemRedistributeEmpty = el<HTMLElement>("team-item-redistribute-empty");
			const formationMobileSlotsRoot = el<HTMLElement>("team-formation-mobile-slots");
			const formationMobileSuggestIcons = el<HTMLElement>("team-formation-mobile-suggest-icons");
			const teamDataMobileSlotsRoot = el<HTMLElement>("team-data-mobile-slots");
			const teamDataMobileSimilarRoot = el<HTMLElement>("team-data-mobile-similar");
			const formationMobileSearchInput = el<HTMLInputElement>("team-formation-mobile-search");
			const formationMobileSortSelect = el<HTMLSelectElement>("team-formation-mobile-sort-select");
			const formationMobileSortSelectWrap = el<HTMLElement>("team-formation-mobile-sort-select-wrap");
			const formationMobileSortDirToggle = el<HTMLButtonElement>("team-formation-mobile-sort-dir-toggle");
			const formationMobileAddButton = el<HTMLButtonElement>("team-formation-mobile-add");
			const formationMobileStatus = el<HTMLElement>("team-formation-mobile-status");
			const formationMobileBoxGrid = el<HTMLElement>("team-formation-mobile-box-grid");

			const statusEl = el<HTMLElement>("autosave-status");
			const statusTextEl = el<HTMLElement>("autosave-status-text");
			const retryButton = el<HTMLButtonElement>("retry-button");
			const copyTeamButton = document.getElementById("copy-button") as HTMLButtonElement | null;
			const deleteTeamButton = document.getElementById("delete-team-button") as HTMLButtonElement | null;

			const imageIdMapPromise = loadImageIdMap();
			const baseStatsMapPromise = loadBaseStatsMap();

			const STAT_LABELS: Record<(typeof STAT_KEYS)[number], string> = {
				hp: "H", atk: "A", def: "B", spa: "C", spd: "D", spe: "S",
			};

			// box/index.astroのapplyActualStatsと同じ式・同じフォールバック(level??50, iv??31, ev??0)。
			async function computeStats(p: OwnedPokemonRecord): Promise<{ key: string; label: string; value: number; ev: number; mod: "up" | "down" | null }[] | null> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return null;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				return STAT_KEYS.map((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const statMod = key === "hp" ? null : mod.up === key ? "up" : mod.down === key ? "down" : null;
					return { key, label: STAT_LABELS[key], value, ev, mod: statMod };
				});
			}

			// 6枠の現在状態(slot 1..6 -> 個体。無ければ空き)。
			const membersBySlot = new Map<number, OwnedPokemonRecord>();
			const itemOverridesBySlot = new Map<number, string | null>();
			for (const m of initialTeam.members ?? []) {
				membersBySlot.set(m.slot, m.owned_pokemon);
				itemOverridesBySlot.set(m.slot, m.item_override ?? null);
			}

			function effectiveItemName(slot: number, p: OwnedPokemonRecord): string {
				const override = itemOverridesBySlot.get(slot);
				return (override ?? p.item_name ?? "").trim();
			}

			function effectiveMembersBySlot(): Map<number, OwnedPokemonRecord> {
				return new Map(Array.from(membersBySlot, ([slot, p]) => [
					slot,
					{ ...p, item_name: effectiveItemName(slot, p) || null },
				]));
			}

			let selectedRedistributionSlot: number | null = null;
			let selectedRedistributionItem: string | null = null;
			let redistributionSearchQuery = "";

			// メガシンカ後の種族(例: メガドラミドロ)は、対応するメガストーンを
			// 手放すとメガシンカ表示自体が成立しなくなるため、再分配の対象から外す
			// (タップでの選択・長押しでの解除いずれも受け付けない)。
			let redistributionLockedSlots = new Set<number>();

			async function loadRedistributionLocks(): Promise<void> {
				const megaStones = await loadMegaStoneMap();
				const locked = new Set<number>();
				for (const [slot, p] of membersBySlot) {
					if (megaStones.has(p.species_name)) locked.add(slot);
				}
				redistributionLockedSlots = locked;
			}

			function isRedistributionSlotLocked(slot: number): boolean {
				return redistributionLockedSlots.has(slot);
			}

			function renderRedistributionItems(): void {
				redistributionItemGrid.render(redistributionSearchQuery);
			}

			// ポケモン行の直下に、各枠が今表示しているもちものをカードで並べる専用行(R-新規)。
			// アイコンをポケモンアイコンへ重ねる旧方式(.team-mate-card__item)は編成タブ等の
			// 共有カード用に残し、この行はこのモーダル専用に別描画する。タップは対応する枠の
			// 選択/入替(onRedistributionMemberTap)へそのままつなぐ。空き枠(個体が無い)は
			// 6列の位置ぞろえのためだけに空のプレースホルダーを置く。
			function renderRedistributionItemRow(effective: Map<number, OwnedPokemonRecord>): void {
				itemRedistributeItemRow.replaceChildren();
				for (let slot = 1; slot <= 6; slot += 1) {
					const member = effective.get(slot);
					if (!member) {
						const placeholder = document.createElement("div");
						placeholder.className = "team-item-redistribute-item-card team-item-redistribute-item-card--empty";
						itemRedistributeItemRow.appendChild(placeholder);
						continue;
					}
					const itemName = (member.item_name ?? "").trim();
					const locked = isRedistributionSlotLocked(slot);
					const card = document.createElement("button");
					card.type = "button";
					card.className = "team-item-redistribute-item-card";
					card.dataset.slot = String(slot);
					card.setAttribute(
						"aria-label",
						itemName ? `${itemName}、${slot}番目の枠のもちもの` : `もちものなし、${slot}番目の枠`,
					);
					if (selectedRedistributionSlot === slot) card.classList.add("is-selected");
					if (locked) {
						card.classList.add("is-locked");
						card.disabled = true;
						card.setAttribute("aria-disabled", "true");
					} else {
						card.addEventListener("click", () => onRedistributionMemberTap(slot));
					}
					const iconWrap = document.createElement("span");
					iconWrap.className = "team-item-redistribute-item-card__icon-wrap";
					if (itemName) {
						const img = document.createElement("img");
						img.className = "team-item-redistribute-item-card__icon";
						img.alt = "";
						img.draggable = false;
						img.style.display = "none";
						iconWrap.appendChild(img);
						void applyItemIcon(img, itemName, iconWrap);
					} else {
						// もちものが無い枠は、box/[id]のもちもの選択モーダルと同じ「なし」アイコン
						// (丸に斜線)を出す(item-select-dialog.tsのitem-select-cell-none-iconと同じSVG)。
						iconWrap.classList.add("is-none");
						const noneIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
						noneIcon.setAttribute("viewBox", "0 0 24 24");
						noneIcon.setAttribute("aria-hidden", "true");
						noneIcon.innerHTML = '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
						iconWrap.appendChild(noneIcon);
					}
					// UI改修: アイテムスロットはアイコンのみ表示する(名前テキストはaria-labelに残す)。
					card.append(iconWrap);
					itemRedistributeItemRow.appendChild(card);
				}
			}

			function renderRedistributionMembers(): void {
				const effective = effectiveMembersBySlot();
				renderTeamMateSlots({
					root: itemRedistributeMembers,
					membersBySlot: effective,
					displayName,
					selectedSlot: null,
					onSlotTap: onRedistributionMemberTap,
					onSlotLongPress: clearRedistributedItem,
					applySprite,
					applyItemIcon,
					showItem: false,
				});
				renderRedistributionItemRow(effective);
				// 表示中のもちもの("なし"を除く)が2枠以上で重複している。
				const itemCounts = new Map<string, number>();
				for (const p of effective.values()) {
					const itemName = (p.item_name ?? "").trim();
					if (!itemName) continue;
					itemCounts.set(itemName, (itemCounts.get(itemName) ?? 0) + 1);
				}
				// renderTeamMateSlots自体は編成タブ等と共有のため「変更不可」概念を持たない。
				// ここ(再分配モーダル固有)でだけDOMに後付けでロック表示を足す
				// (renderTeamMateSlotsは毎回root.innerHTMLを作り直すため、常に未装飾のカードから始まる)。
				for (const cardEl of Array.from(itemRedistributeMembers.children) as HTMLElement[]) {
					const slot = Number(cardEl.dataset.slot);
					if (!isRedistributionSlotLocked(slot)) continue;
					cardEl.classList.add("is-locked");
					cardEl.setAttribute("aria-disabled", "true");
					const lock = document.createElement("span");
					lock.className = "team-item-redistribute-lock-badge";
					lock.setAttribute("aria-hidden", "true");
					lock.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>';
					cardEl.appendChild(lock);
				}
				// UI改修: 重複ハイライトはポケモンカードではなくアイテムカードに付ける(枠=outlineは
				// 付けず、背景のみで示す)。
				for (const cardEl of Array.from(itemRedistributeItemRow.children) as HTMLElement[]) {
					const slot = Number(cardEl.dataset.slot);
					const itemName = (effective.get(slot)?.item_name ?? "").trim();
					if (itemName && (itemCounts.get(itemName) ?? 0) >= 2) cardEl.classList.add("is-duplicate-item");
				}
			}

			function refreshEffectiveItemViews(): void {
				renderOverviewGrid();
				renderFormationMobile();
				renderRedistributionMembers();
				renderRedistributionItems();
				scheduleSave();
			}

			function clearRedistributedItem(slot: number): void {
				if (isRedistributionSlotLocked(slot)) return;
				itemOverridesBySlot.set(slot, "");
				selectedRedistributionSlot = null;
				selectedRedistributionItem = null;
				refreshEffectiveItemViews();
			}

			function setRedistributedItem(slot: number, itemName: string): void {
				const p = membersBySlot.get(slot);
				if (!p) return;
				const normalized = itemName.trim();
				itemOverridesBySlot.set(slot, normalized && normalized === (p.item_name ?? "").trim() ? null : normalized);
				if (normalized) {
					for (const [otherSlot, other] of membersBySlot) {
						if (otherSlot !== slot && effectiveItemName(otherSlot, other) === normalized) itemOverridesBySlot.set(otherSlot, "");
					}
				}
				refreshEffectiveItemViews();
			}

			function swapRedistributedItems(firstSlot: number, secondSlot: number): void {
				const first = membersBySlot.get(firstSlot);
				const second = membersBySlot.get(secondSlot);
				if (!first || !second) return;
				const firstItem = effectiveItemName(firstSlot, first);
				const secondItem = effectiveItemName(secondSlot, second);
				itemOverridesBySlot.set(firstSlot, secondItem && secondItem === (first.item_name ?? "").trim() ? null : secondItem);
				itemOverridesBySlot.set(secondSlot, firstItem && firstItem === (second.item_name ?? "").trim() ? null : firstItem);
				if (firstItem) for (const [slot, p] of membersBySlot) if (slot !== secondSlot && effectiveItemName(slot, p) === firstItem) itemOverridesBySlot.set(slot, "");
				if (secondItem) for (const [slot, p] of membersBySlot) if (slot !== firstSlot && effectiveItemName(slot, p) === secondItem) itemOverridesBySlot.set(slot, "");
				refreshEffectiveItemViews();
			}

			function onRedistributionMemberTap(slot: number): void {
				if (isRedistributionSlotLocked(slot)) return;
				if (selectedRedistributionItem !== null) {
					setRedistributedItem(slot, selectedRedistributionItem);
					selectedRedistributionItem = null;
					renderRedistributionMembers();
					renderRedistributionItems();
					return;
				}
				if (selectedRedistributionSlot === slot) selectedRedistributionSlot = null;
				else if (selectedRedistributionSlot !== null) {
					swapRedistributedItems(selectedRedistributionSlot, slot);
					selectedRedistributionSlot = null;
				} else selectedRedistributionSlot = slot;
				renderRedistributionMembers();
				renderRedistributionItems();
			}

			// もちもの再分配ダイアログの一覧だけ、[チームの合計採用率順]→[きのみ以外・五十音順]→[きのみ・五十音順]で
			// 並べる(通常のもちもの選択ダイアログはgetSharedItemNames()由来の五十音順のまま=対象外)。
			const speciesItemUsageCache = new Map<string, Map<string, number>>();

			async function fetchSpeciesItemUsage(speciesName: string): Promise<Map<string, number>> {
				const cached = speciesItemUsageCache.get(speciesName);
				if (cached) return cached;
				const usage = new Map<string, number>();
				try {
					const res = await fetch(`/api/opgg-usage?species=${encodeURIComponent(speciesName)}&category=items`);
					if (res.ok) {
						const json = await res.json() as { options: { name: string; usageRate: number | null }[] };
						for (const row of json.options) {
							if (row.usageRate != null) usage.set(row.name, row.usageRate);
						}
					}
				} catch {
					// 並び順の付加機能のため、取得失敗時は寄与0として扱う。
				}
				speciesItemUsageCache.set(speciesName, usage);
				return usage;
			}

			let teamItemUsageTotals: Map<string, number> = new Map();

			async function loadTeamItemUsageTotals(): Promise<void> {
				const speciesNames = Array.from(new Set(
					Array.from(membersBySlot.values())
						.map((p) => p.species_name)
						.filter((name): name is string => !!name),
				));
				const usages = await Promise.all(speciesNames.map(fetchSpeciesItemUsage));
				const totals = new Map<string, number>();
				for (const usage of usages) {
					for (const [itemName, rate] of usage) totals.set(itemName, (totals.get(itemName) ?? 0) + rate);
				}
				teamItemUsageTotals = totals;
			}

			function sortRedistributionItems(values: string[]): string[] {
				return sortItemsByUsage(values, (value) => teamItemUsageTotals.get(value));
			}

			// UI改修: 表示中(effective)のもちものは、既にどこかの枠が使用中のため候補には出さない。
			function isRedistributionItemInUse(itemName: string): boolean {
				for (const p of effectiveMembersBySlot().values()) {
					if ((p.item_name ?? "").trim() === itemName) return true;
				}
				return false;
			}

			const redistributionItemGrid = createItemSelectGrid({
				gridEl: itemRedistributeItems,
				emptyEl: itemRedistributeEmpty,
				getActiveValue: () => selectedRedistributionSlot === null ? selectedRedistributionItem : null,
				sortRest: sortRedistributionItems,
				// メガストーンは対応するメガシンカ枠に必ず登録されており、表示設定側では
				// 変更を許さない(redistributionLockedSlots参照)ため、そもそも候補にも出さない。
				// 使用中のもちものも同様に、候補として選び直す意味が無いため出さない。
				excludeValue: (itemName) => isMegaStoneItemName(itemName) || isRedistributionItemInUse(itemName),
				onSelect: (itemName) => {
					if (selectedRedistributionSlot !== null) {
						const slot = selectedRedistributionSlot;
						selectedRedistributionSlot = null;
						setRedistributedItem(slot, itemName);
						return;
					}
					selectedRedistributionItem = selectedRedistributionItem === itemName ? null : itemName;
					renderRedistributionItems();
				},
			});

			// ボックスの全個体(選択バーの中身)。GET /api/owned-pokemon から取得する。
			let allPokemon: OwnedPokemonRecord[] = [];

			function candidateOf(p: OwnedPokemonRecord): SelectionCandidate {
				return {
					ownedPokemonId: p.id,
				};
			}

			function currentCandidates(): SelectionCandidate[] {
				return Array.from(membersBySlot.values()).map(candidateOf);
			}

			// 既に埋まっている枠へドロップして入れ替える(=その枠自身の在籍は重複扱いしない)場合に
			// 使う。
			function currentCandidatesExcludingSlot(slot: number): SelectionCandidate[] {
				return Array.from(membersBySlot.entries())
					.filter(([s]) => s !== slot)
					.map(([, p]) => candidateOf(p));
			}

			function firstEmptySlot(): number | null {
				for (let slot = 1; slot <= 6; slot += 1) {
					if (!membersBySlot.has(slot)) return slot;
				}
				return null;
			}

			// 公式絵。取得できない場合は頭文字の丸バッジにフォールバックする
			// (box/index.astroのapplyCardSpriteと同じ方式。loading="lazy"は付けない
			// ---display:noneの<img>は遅延読み込みの対象外としてonloadが発火しない)。
			async function applySprite(
				imgEl: HTMLImageElement,
				fallbackEl: HTMLElement,
				name: string,
			): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				let triedArtworkFallback = false;
				imgEl.onerror = () => {
					if (!triedArtworkFallback) {
						triedArtworkFallback = true;
						imgEl.src = officialArtworkUrl(imageId);
						return;
					}
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = championSpriteUrl(imageId);
			}

			// 持ち物アイコン(アイコン+名前、R-8)。アイコンが解決できない/読み込み失敗のときも
			// 名前のテキストは残す(box/index.astroの持ち物行と同じ考え方)。
			function applyItemIcon(
				imgEl: HTMLImageElement,
				itemName: string,
				visibilityEl?: HTMLElement,
			): void {
				if (!itemName) {
					imgEl.style.display = "none";
					if (visibilityEl) visibilityEl.hidden = true;
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					if (visibilityEl) visibilityEl.hidden = true;
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					if (visibilityEl) visibilityEl.hidden = false;
				};
				imgEl.src = itemIconUrl(itemName);
			}

			async function applyOverviewMoveTypeColors(
				entries: { colorEl: HTMLElement; moveName: string }[],
			): Promise<void> {
				if (entries.length === 0) return;
				const detailMap = await loadMoveDetailMap();
				for (const { colorEl, moveName } of entries) {
					const type = detailMap.get(moveName)?.type;
					if (!type) continue;
					colorEl.style.backgroundColor = TYPE_COLORS[type] ?? DEFAULT_TYPE_COLOR;
					colorEl.hidden = false;
				}
			}

			// =================================================================================
			// チームポケモンのサジェスト
			// 「現在のチームメンバーを参照して、残りの枠に入れるとよいポケモンを提案する」。
			// 集計は GET /api/team-suggestions(スコアリングは src/lib/team-suggest.ts、
			// 共起の集計は migrations/016 のSQL関数)。ここは表示と操作だけを担う。
			// =================================================================================

			interface TeamSuggestion {
				speciesName: string;
				dexNo: number | null;
				abilityName: string | null;
				itemName: string | null;
				role: "physical_attacker" | "special_attacker" | "bulky" | null;
				archetypeShare: number | null;
				archetypeTeams: number | null;
				usageTeams: number;
				totalTeams: number;
				itemConflict: boolean;
				reason: {
					seedSpeciesName: string;
					coTeams: number;
					seedTeams: number;
					ratio: number;
					lift: number;
				} | null;
			}

			// 「今どの編成に対する結果か」。メンバーを続けて操作したときに、古いリクエストの
			// 応答が後から届いて上書きするのを防ぐ。
			let suggestRequestId = 0;
			// 直近で問い合わせた編成。同じ編成での再描画では fetch を撃たない
			// (枠の入れ替えなど、メンバー集合が変わらない操作でも scheduleSuggestions は呼ばれるため)。
			let lastSuggestKey: string | null = null;
			let suggestTimer: number | undefined;

			// メガシンカ種族の判定用マスターデータ(「メガシンカを含める」トグル用)。
			// mega-stones.json は「種族名→メガストーン名」の対応表(src/lib/speed-chart/
			// chart-table.ts の loadMasterData と同じ要領でfetchする)。文字列の「メガ」接頭辞判定は
			// 誤判定・取り漏れの余地があるため使わず、このマスターデータのspeciesに載っているかどうか
			// だけで判定する。
			interface MegaStoneMasterEntry {
				species: string;
				item: string;
			}
			let megaSpeciesSetPromise: Promise<Set<string>> | null = null;
			function loadMegaSpeciesSet(): Promise<Set<string>> {
				if (!megaSpeciesSetPromise) {
					megaSpeciesSetPromise = fetch("/master-data/autocomplete/mega-stones.json")
						.then((res) => res.json() as Promise<MegaStoneMasterEntry[]>)
						.then((list) => new Set(list.map((entry) => entry.species)))
						.catch((err) => {
							console.warn("メガシンカ種族一覧の読み込みに失敗しました", err);
							megaSpeciesSetPromise = null;
							return new Set<string>();
						});
				}
				return megaSpeciesSetPromise;
			}

			// 提案された型に一致する手持ち個体を探す。種族が一致し、かつチームに入れられる
			// (selectionBlockReason が null)個体だけが対象。特性・持ち物まで一致するものを
			// 優先し、無ければ種族だけ一致する個体を返す ── 「型は違うが同じポケモンなら持っている」
			// 場合に、作り直しではなく手持ちを入れる導線を出せるようにするため。
			function findOwnedMatch(suggestion: TeamSuggestion): OwnedPokemonRecord | null {
				const candidates = currentCandidates();
				const usable = allPokemon.filter(
					(p) => p.species_name === suggestion.speciesName && selectionBlockReason(candidateOf(p), candidates) === null,
				);
				if (usable.length === 0) return null;
				const exact = usable.find(
					(p) =>
						(p.ability_name ?? "") === (suggestion.abilityName ?? "") &&
						(p.item_name ?? "") === (suggestion.itemName ?? ""),
				);
				return exact ?? usable[0];
			}

			// 表示条件トグル(「メガシンカを含める」トグル)。OFF時はメガシンカ種族を除外し、
			// ON時もメガシンカ形態は最大2件にする。APIを叩き直さず、直近の応答に対して
			// クライアント側でフィルタする。
			async function filterSuggestions(suggestions: TeamSuggestion[]): Promise<TeamSuggestion[]> {
				const megaSpecies = await loadMegaSpeciesSet();
				let megaCount = 0;
				return suggestions.filter((suggestion) => {
					if (!megaSpecies.has(suggestion.speciesName)) return true;
					if (megaCount >= 2) return false;
					megaCount += 1;
					return true;
				});
			}

			// 「この型で個体を作る」: box/index.astro の createEmptyPokemon と同じ POST 経路で、
			// 空の個体ではなく提案された型(種族・特性・持ち物)を埋めた個体を作り、そのまま
			// 編集画面へ送る。努力値・技・性格は提案の識別キーに含まれない(型は
			// 種族・特性・持ち物・role の4つで決まる、migrations/015)ため空のままにする。
			async function createPokemonFromSuggestion(suggestion: TeamSuggestion, button: HTMLButtonElement): Promise<void> {
				if (isGuestMode()) {
					showGuestLoginDialog();
					return;
				}
				button.disabled = true;
				// 登録失敗時に鉛筆アイコンを含む元の表示を復元する。
				const originalContent = Array.from(button.childNodes, (node) => node.cloneNode(true));
				button.textContent = "登録中…";
				try {
					const { id } = await createOwnedPokemon({
						species_name: suggestion.speciesName,
						level: null,
						nature: null,
						ability_name: suggestion.abilityName,
						item_name: suggestion.itemName,
						tera_type: null,
						evs: [0, 0, 0, 0, 0, 0],
						ivs: [31, 31, 31, 31, 31, 31],
						move_names: [],
						memo: null,
						tags: [],
					});
					window.location.href = `/box/${encodeURIComponent(id)}`;
				} catch (err) {
					console.error(err);
					button.disabled = false;
					button.replaceChildren(...originalContent);
					window.alert("個体の登録に失敗しました。時間をおいて再度お試しください。");
				}
			}

			function buildSuggestIcon(suggestion: TeamSuggestion): HTMLElement {
				const owned = findOwnedMatch(suggestion);
				const button = document.createElement("button");
				button.type = "button";
				button.className = "team-formation-suggest-icon";
				button.title = suggestion.speciesName;
				button.setAttribute("aria-label", `${suggestion.speciesName}を育成`);
				const img = document.createElement("img");
				img.alt = "";
				const fallback = document.createElement("span");
				button.appendChild(img);
				void applySprite(img, fallback, suggestion.speciesName);
				if (owned) {
					const label = owned.species_name;
					button.title = `手持ちの${label}を入れる`;
					button.setAttribute("aria-label", `${label}をチームに追加`);
					button.disabled = firstEmptySlot() == null;
					button.addEventListener("click", () => {
						assignToSlot(owned);
					});
				} else {
					button.addEventListener("click", () => {
						void createPokemonFromSuggestion(suggestion, button);
					});
				}
				return button;
			}

			// 直近の応答。個体一覧(allPokemon)が後から届いたときに「手持ちにあるか」の
			// 判定をやり直して再描画するために保持する(APIは叩き直さない)。
			let lastSuggestResponse: { suggestions: TeamSuggestion[]; basis: string } | null = null;
			let suggestionSpeciesRanks = new Map<string, number>();
			// 「今どの描画が最新か」。トグル操作(filterSuggestionsのawait)の途中で別の描画要求が
			// 割り込んだとき、古い方がDOMを上書きしないようにする(previewRequestIdと同じ方式)。
			let suggestRenderId = 0;

			async function renderSuggestions(suggestions: TeamSuggestion[], basis: string): Promise<void> {
				const renderId = (suggestRenderId += 1);
				lastSuggestResponse = { suggestions, basis };
				suggestionSpeciesRanks = new Map<string, number>();
				const shouldShowFormationSuggestions = membersBySlot.size >= 1 && membersBySlot.size <= 6;
				formationMobileSuggestIcons.replaceChildren();

				const filtered = await filterSuggestions(suggestions);
				if (renderId !== suggestRenderId) return; // 途中でトグル操作等により新しい描画要求が来た
				if (shouldShowFormationSuggestions) {
					filtered.forEach((suggestion, index) => {
						if (!suggestionSpeciesRanks.has(suggestion.speciesName)) {
							suggestionSpeciesRanks.set(suggestion.speciesName, index);
						}
					});
				}
				renderFormationMobile();

				if (shouldShowFormationSuggestions) {
					filtered.slice(0, 6).forEach((s) => formationMobileSuggestIcons.appendChild(buildSuggestIcon(s)));
				}
			}

			function currentMemberIds(): string[] {
				return Array.from(membersBySlot.values()).map((p) => p.id);
			}

			async function loadSuggestions(): Promise<void> {
				const memberIds = currentMemberIds();
				const key = memberIds.slice().sort().join(",");
				if (key === lastSuggestKey) return;
				lastSuggestKey = key;

				const requestId = (suggestRequestId += 1);
				try {
					const query = memberIds.length > 0 ? `?member_ids=${encodeURIComponent(memberIds.join(","))}` : "";
					const res = await fetch(`/api/team-suggestions${query}`, { credentials: "same-origin" });
					if (isGuestMode() && res.status === 401) {
						return;
					}
					if (!res.ok) throw new Error(`サジェストの取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: TeamSuggestion[]; meta?: { basis?: string } };
					if (requestId !== suggestRequestId) return; // 編成が変わった。この結果は捨てる
					void renderSuggestions(body.data ?? [], body.meta?.basis ?? "cooccurrence");
				} catch (err) {
					console.error(err);
					if (requestId !== suggestRequestId) return;
					// 次に編成が変わったときに再試行できるよう、失敗した編成は記憶しない。
					lastSuggestKey = null;
				}
			}

			// 編成の変更に追随する。自動保存(scheduleSave)と同じ700msのデバウンスにして、
			// 6枠を続けて操作したときに毎回APIを叩かないようにする。
			function scheduleSuggestions(): void {
				window.clearTimeout(suggestTimer);
				suggestTimer = window.setTimeout(() => {
					void loadSuggestions();
				}, 700);
			}

			// =================================================================================
			// 類似構築: 現在の編成(membersBySlot)と育成内容が近いランク入り構築を表示する。
			// 「データ」タブ→類似構築パネル(#team-data-mobile-similar)専用。対象は最新シーズンのみ。
			// ランキングデータは初回の1回だけ取得してキャッシュし、以後は編成が変わるたびに
			// クライアント側で並べ替えるだけにする(再フェッチしない)。
			// =================================================================================

			const rankedSeason = layoutRoot.dataset.rankedSeason || null;
			const SIMILAR_BUILDS_PAGE_SIZE = 24;
			let rankedTeams: RankedTeam[] = [];
			let rankedTeamsHasMore = false;
			let rankedTeamsRequest: Promise<void> | null = null;
			async function loadRankedTeams(reset = false): Promise<void> {
				if (!rankedSeason || rankedTeamsRequest) return rankedTeamsRequest ?? Promise.resolve();
				if (reset) {
					rankedTeams = [];
					rankedTeamsHasMore = false;
				}
				const offset = rankedTeams.length;
				rankedTeamsRequest = fetch(`/api/ranked-teams?season=${encodeURIComponent(rankedSeason)}&limit=${SIMILAR_BUILDS_PAGE_SIZE}&offset=${offset}`, { credentials: "same-origin" })
					.then(async (res) => {
						if (!res.ok) throw new Error(`類似構築の取得に失敗しました (status=${res.status})`);
						const body = (await res.json()) as { teams: RankedTeam[]; hasMore: boolean };
						rankedTeams = [...rankedTeams, ...(body.teams ?? [])];
						rankedTeamsHasMore = body.hasMore;
					})
					.finally(() => { rankedTeamsRequest = null; });
				return rankedTeamsRequest;
			}

			function setSimilarBuildsStatus(message: string, state?: "loading" | "error"): void {
				teamDataMobileSimilarRoot.innerHTML = "";
				const p = document.createElement("p");
				p.className = "team-data-similar-status status-text";
				if (state) p.dataset.state = state;
				p.textContent = message;
				teamDataMobileSimilarRoot.appendChild(p);
			}

			function renderSimilarBuilds(teams: RankedTeam[]): void {
				const team = Array.from(membersBySlot.values());
				const currentSpecies = new Set(team.map((member) => member.species_name));
				const hasBuildMatch = (ranked: RankedTeam): boolean => ranked.members.some((rankedMember) =>
					team.some((member) => !!rankedMember.speciesKey && rankedMember.speciesKey === member.species_name
						&& calculateBuildSimilarity(member, rankedMember) > 0),
				);
				const scored = teams
					.map((t) => ({ team: t, similarity: calculateTeamSimilarity(team, t.members) }))
					.filter((entry) => entry.similarity > 0)
					.sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);
				// 型一致を先に並べ、その後にも種族だけ一致する構築を省かずに続ける。
				const exactBuilds = scored.filter((entry) => hasBuildMatch(entry.team));
				const speciesOnlyBuilds = scored
					.filter((entry) => !hasBuildMatch(entry.team))
					.sort((a, b) => a.team.rank - b.team.rank);
				const results = [...exactBuilds, ...speciesOnlyBuilds];
				if (results.length === 0) {
					teamDataMobileSimilarRoot.innerHTML = "";
					const empty = document.createElement("p");
					empty.className = "team-data-similar-status status-text";
					empty.textContent = rankedTeamsHasMore ? "類似チームを続けて読み込んでいます…" : "チームが見つかりません。";
					teamDataMobileSimilarRoot.appendChild(empty);
					if (rankedTeamsHasMore) scheduleMoreSimilarBuilds();
					return;
				}
				const list = document.createElement("div");
				list.className = "team-grid";
				for (const entry of results) {
					const highlightSlots = entry.team.members
						.filter((member) => !!member.speciesKey && currentSpecies.has(member.speciesKey))
						.map((member) => member.slot);
					list.appendChild(renderTopBuildCard(entry.team, { highlightSlots }));
				}
				teamDataMobileSimilarRoot.innerHTML = "";
				teamDataMobileSimilarRoot.appendChild(list);
				if (rankedTeamsHasMore) scheduleMoreSimilarBuilds();
			}

			let similarBuildsRequestId = 0;
			let similarBuildsAutoLoadFrame: number | undefined;
			function scheduleMoreSimilarBuilds(): void {
				window.cancelAnimationFrame(similarBuildsAutoLoadFrame ?? 0);
				// 24件を描画したあとに次の24件を続けて取得する。
				similarBuildsAutoLoadFrame = window.requestAnimationFrame(() => void loadMoreSimilarBuilds());
			}
			async function loadSimilarBuilds(): Promise<void> {
				const requestId = (similarBuildsRequestId += 1);
				window.cancelAnimationFrame(similarBuildsAutoLoadFrame ?? 0);
				setSimilarBuildsStatus("類似構築を計算中…", "loading");
				try {
					await loadRankedTeams(true);
					if (requestId !== similarBuildsRequestId) return;
					renderSimilarBuilds(rankedTeams);
				} catch (err) {
					console.error(err);
					if (requestId !== similarBuildsRequestId) return;
					setSimilarBuildsStatus("類似構築を読み込めませんでした。", "error");
				}
			}

			async function loadMoreSimilarBuilds(): Promise<void> {
				try {
					await loadRankedTeams();
					renderSimilarBuilds(rankedTeams);
				} catch (err) {
					console.error(err);
					setSimilarBuildsStatus("類似構築を読み込めませんでした。", "error");
				}
			}

			let similarBuildsTimer: number | undefined;
			function scheduleSimilarBuilds(): void {
				window.clearTimeout(similarBuildsTimer);
				similarBuildsTimer = window.setTimeout(() => {
					void loadSimilarBuilds();
				}, 700);
			}

			// =================================================================================
			// 相性チェック
			// 「使用率上位32体のポケモンとの攻守の相性を可視化する」。
			//
			// 取得・計算の駆動・カード描画は src/lib/matchup-panel.ts に共通化し、このページは
			// チーム枠への不利メンバーハイライトだけをコールバックで渡す。
			//
			// 相手の条件: 性格補正なし・努力値H32振り・Lv50・IV31。特性と持ち物は
			// 付けない(jpoke は空文字を渡すと特性なし・持ち物なしの個体になる)。
			// これは「環境の平均的な個体」ではなく「同じ土俵で並べるための基準個体」であり、
			// 20体を互いに比較するための基準として一貫していることを優先している。
			//
			// 計算量: 相手20体 × チーム6体 = 120組。組ごとに jpoke の Battle を1つ作るが、
			// 致死率(calc_lethal、Battle全体のdeepcopyを伴う)は使わず calc_damages だけを
			// 呼ぶため、WASMヒープを圧迫しない(pyodide-engine.ts の calc_max_damage_matrix_json
			// のdocstring参照)。相手1体ぶんずつ Python を呼び、その間に進捗を描く。
			// =================================================================================

			const matchupMobileSlotsRoot = el<HTMLElement>("team-matchup-mobile-slots");
			const matchupMobileStatusEl = el<HTMLElement>("team-matchup-mobile-status");
			const matchupMobileListEl = el<HTMLElement>("team-matchup-mobile-list");
			function matchupTeamMembers(): OwnedPokemonRecord[] {
				const members: OwnedPokemonRecord[] = [];
				for (let slot = 1; slot <= 6; slot += 1) {
					const p = membersBySlot.get(slot);
					if (p && p.species_name && p.species_name.trim() !== "") members.push(p);
				}
				return members;
			}

			const matchupPanel = createMatchupPanel({
				listElement: matchupMobileListEl,
				statusElement: matchupMobileStatusEl,
				getMembers: matchupTeamMembers,
			});

			function runMatchup(): Promise<void> {
				return matchupPanel.run();
			}

			function scheduleMatchup(): void {
				if (layoutRoot.dataset.mobileTab !== "matchup") return;
				matchupPanel.schedule();
			}
			// クリック単体での追加はプレビュー表示に譲り、実際の追加操作はダブルクリック/
			// ドラッグ&ドロップに一本化する。targetSlotを指定した場合はその枠へ(既に埋まっていれば
			// 入れ替え)、省略時は空き枠のうち最小番号に入れる。選択ルール(selectionBlockReason)は
			// 入れ替え先の枠自身の在籍を重複扱いしないよう、対象枠を除いた候補リストで判定する。
			function assignToSlot(p: OwnedPokemonRecord, targetSlot?: number): void {
				const slot = targetSlot ?? firstEmptySlot();
				if (slot == null) return;
				const candidates = currentCandidatesExcludingSlot(slot);
				const reason = selectionBlockReason(candidateOf(p), candidates);
				if (reason) return;
				selectedOverviewSlot = null;
				selectedFormationSlot = null;
				selectedCandidatePokemon = null;
				membersBySlot.set(slot, p);
				itemOverridesBySlot.set(slot, null);
				renderOverviewGrid();
				renderFormationMobile();
				scheduleSave();
				// 編成が変わったのでサジェストを取り直す。
				scheduleSuggestions();
				scheduleSimilarBuilds();
				// 相性チェックを開いている場合は、その計算もやり直す。
				scheduleMatchup();
			}

			// assignToSlotは候補ポケモン用の
			// 重複チェック(selectionBlockReason)を含むため、既に編成済みの2枠を入れ替える
			// (在籍総数は変わらない)操作には不適切(移動先に既にいる個体を「重複」と誤検知しうる)。
			// membersBySlotの中身を直接swapするだけの専用関数にする。片方が空きでもよい(=移動)。
			function swapMembersBetweenSlots(fromSlot: number, toSlot: number): void {
				selectedOverviewSlot = null;
				selectedFormationSlot = null;
				selectedCandidatePokemon = null;
				const fromMember = membersBySlot.get(fromSlot);
				const toMember = membersBySlot.get(toSlot);
				const fromOverride = itemOverridesBySlot.get(fromSlot) ?? null;
				const toOverride = itemOverridesBySlot.get(toSlot) ?? null;
				if (toMember) membersBySlot.set(fromSlot, toMember);
				else membersBySlot.delete(fromSlot);
				if (fromMember) membersBySlot.set(toSlot, fromMember);
				else membersBySlot.delete(toSlot);
				if (toMember) itemOverridesBySlot.set(fromSlot, toOverride);
				else itemOverridesBySlot.delete(fromSlot);
				if (fromMember) itemOverridesBySlot.set(toSlot, fromOverride);
				else itemOverridesBySlot.delete(toSlot);
				renderOverviewGrid();
				renderFormationMobile();
				scheduleSave();
			}

			// カード自体のdblclickハンドラと削除ボタンで共有する
			// (挙動: membersBySlotから外す→再描画→自動保存)。
			function removeMemberFromSlot(slot: number): void {
				selectedOverviewSlot = null;
				selectedFormationSlot = null;
				selectedCandidatePokemon = null;
				membersBySlot.delete(slot);
				itemOverridesBySlot.delete(slot);
				renderOverviewGrid();
				renderFormationMobile();
				scheduleSave();
				// 編成が変わったのでサジェストを取り直す。
				scheduleSuggestions();
				scheduleSimilarBuilds();
				// 相性チェックを開いている場合は、その計算もやり直す。
				scheduleMatchup();
			}

			function renderOverviewGrid(): void {
				overviewGrid.innerHTML = "";
				for (let slot = 1; slot <= 6; slot += 1) {
					const p = membersBySlot.get(slot);
					if (!p) {
						const empty = document.createElement("button");
						empty.type = "button";
						empty.className = "card box-card card-team-empty-slot";
						empty.setAttribute("aria-label", `${slot}番目の空き枠を選択`);
						empty.setAttribute("aria-pressed", String(selectedOverviewSlot === slot));
						if (selectedOverviewSlot === slot) empty.classList.add("is-selected");
						empty.addEventListener("click", (event) => {
							event.stopPropagation();
							onOverviewSlotTap(slot);
						});
						const slotNumber = document.createElement("span");
						slotNumber.className = "team-slot-number";
						slotNumber.textContent = String(slot);
						empty.appendChild(slotNumber);
						overviewGrid.appendChild(empty);
						continue;
					}

					const card = document.createElement("button");
					card.type = "button";
					card.className = "card box-card card-pokemon pokemon-preview team-overview-preview-card";
					card.setAttribute("aria-label", `${p.species_name}、${slot}番目の枠を選択`);
					card.setAttribute("aria-pressed", String(selectedOverviewSlot === slot));
					if (selectedOverviewSlot === slot) card.classList.add("is-selected");
					attachLongPressNavigate(card, p.id);
					card.addEventListener("click", (event) => {
						event.stopPropagation();
						onOverviewSlotTap(slot);
					});
					const main = document.createElement("div");
					main.className = "pokemon-preview-main";
					const left = document.createElement("div");
					left.className = "pokemon-preview-left";
					const nameEl = document.createElement("div");
					nameEl.className = "pokemon-preview-name";
					nameEl.textContent = p.species_name;
					const details = document.createElement("div");
					details.className = "pokemon-preview-details";
					const ability = document.createElement("div");
					ability.textContent = p.ability_name?.trim() || "-";
					details.appendChild(ability);
					const moves = document.createElement("ol");
					moves.className = "pokemon-preview-moves";
					moves.setAttribute("aria-label", "技");
					const moveColorEntries: { colorEl: HTMLElement; moveName: string }[] = [];
					for (const moveName of p.move_names.slice(0, 4)) {
						const move = document.createElement("li");
						const typeColor = document.createElement("span");
						typeColor.className = "move-type-color";
						typeColor.hidden = true;
						const text = document.createElement("span");
						text.textContent = moveName?.trim() || "-";
						move.append(typeColor, text);
						moves.appendChild(move);
						if (moveName?.trim()) {
							moveColorEntries.push({ colorEl: typeColor, moveName });
						}
					}
					while (moves.children.length < 4) {
						const move = document.createElement("li");
						move.textContent = "-";
						moves.appendChild(move);
					}
					left.append(nameEl, details, moves);
					const identity = document.createElement("div");
					identity.className = "pokemon-preview-identity";
					const spriteWrap = document.createElement("div");
					spriteWrap.className = "pokemon-preview-sprite-wrap";
					const img = document.createElement("img");
					img.alt = "";
					const fallback = document.createElement("span");
					fallback.textContent = p.species_name.slice(0, 1);
					spriteWrap.append(img, fallback);
					void applySprite(img, fallback, p.species_name);
					identity.appendChild(spriteWrap);
					const itemName = effectiveItemName(slot, p);
					// 右パネルのteam-damage-stats/team-damage-stats-line(display:contentsで6列
					// グリッドの行を作る手法)と同じ考え方で、ラベル行・実数値行・努力値行の3段×6列に
					// する(努力値は実数値の下)。
					const stats = document.createElement("div");
					stats.className = "pokemon-preview-stats";
					stats.setAttribute("aria-label", "実数値");
					const statsLabelLine = document.createElement("div");
					statsLabelLine.className = "pokemon-preview-stats-line";
					const statsEvLine = document.createElement("div");
					statsEvLine.className = "pokemon-preview-stats-line";
					const statsValueLine = document.createElement("div");
					statsValueLine.className = "pokemon-preview-stats-line";
					stats.append(statsLabelLine, statsValueLine, statsEvLine);
					left.appendChild(stats);
					main.append(left, identity);
					card.appendChild(main);
					if (itemName) {
						const item = document.createElement("div");
						item.className = "pokemon-preview-item pokemon-preview-icon-text";
						item.hidden = true;
						item.title = itemName;
						item.setAttribute("aria-label", `もちもの: ${itemName}`);
						const itemImage = document.createElement("img");
						itemImage.alt = "";
						item.appendChild(itemImage);
						card.appendChild(item);
						void applyItemIcon(itemImage, itemName, item);
					}
					overviewGrid.appendChild(card);
					void applyOverviewMoveTypeColors(moveColorEntries);
					void computeStats(p).then((computed) => {
						if (!card.isConnected || !computed) return;
						for (const stat of computed) {
							const label = document.createElement("span");
							label.className = "pokemon-preview-stat-key";
							label.textContent = stat.label;
							const ev = document.createElement("span");
							ev.className = "pokemon-preview-stat-ev";
							ev.textContent = stat.ev > 0 ? `+${stat.ev}` : "-";
							const value = document.createElement("span");
							value.className = "pokemon-preview-stat-value";
							value.textContent = String(stat.value);
							if (stat.mod) value.dataset.mod = stat.mod;
							statsLabelLine.appendChild(label);
							statsEvLine.appendChild(ev);
							statsValueLine.appendChild(value);
						}
					});
				}
			}

			function onOverviewSlotTap(slot: number): void {
				if (selectedOverviewSlot !== null && selectedOverviewSlot !== slot) {
					const fromSlot = selectedOverviewSlot;
					selectedOverviewSlot = null;
					if (membersBySlot.has(fromSlot) || membersBySlot.has(slot)) {
						swapMembersBetweenSlots(fromSlot, slot);
					} else {
						renderOverviewGrid();
					}
					return;
				}
				selectedOverviewSlot = selectedOverviewSlot === slot ? null : slot;
				renderOverviewGrid();
			}

			// 自チーム内の操作(相互入れ替え・空き枠への移動・解除)は編成タブに限らず、
			// 相性・類似チームタブの自チーム表示でも同じに揃える(selectedFormationSlotは
			// タブ共通の状態として扱う)。
			function onFormationSlotTap(slot: number): void {
				if (selectedCandidatePokemon !== null) {
					const candidate = selectedCandidatePokemon;
					selectedCandidatePokemon = null;
					selectedFormationSlot = null;
					assignToSlot(candidate, slot);
					return;
				}
				if (selectedFormationSlot !== null && selectedFormationSlot !== slot && membersBySlot.has(selectedFormationSlot)) {
					const fromSlot = selectedFormationSlot;
					selectedFormationSlot = null;
					swapMembersBetweenSlots(fromSlot, slot);
					return;
				}
				selectedFormationSlot = selectedFormationSlot === slot ? null : slot;
				selectedCandidatePokemon = null;
				renderFormationMobile();
			}
			function onFormationSlotDoubleTap(slot: number): void {
				if (membersBySlot.has(slot)) removeMemberFromSlot(slot);
			}
			function onFormationSlotLongPress(slot: number): void {
				const member = membersBySlot.get(slot);
				if (member) navigateToPokemonEdit(member.id);
			}

			function renderFormationMobile(): void {
				const shouldShowFormationSuggestions = membersBySlot.size >= 1 && membersBySlot.size <= 6;
				if (!shouldShowFormationSuggestions) suggestionSpeciesRanks.clear();
				renderTeamMateSlots({
					root: formationMobileSlotsRoot,
					membersBySlot: effectiveMembersBySlot(),
					displayName,
					selectedSlot: selectedFormationSlot,
					onSlotTap: onFormationSlotTap,
					onSlotDoubleTap: onFormationSlotDoubleTap,
					onSlotLongPress: onFormationSlotLongPress,
					applySprite,
					applyItemIcon,
				});
				renderTeamMateSlots({
					root: matchupMobileSlotsRoot,
					membersBySlot: effectiveMembersBySlot(),
					displayName,
					selectedSlot: selectedFormationSlot,
					onSlotTap: onFormationSlotTap,
					onSlotDoubleTap: onFormationSlotDoubleTap,
					onSlotLongPress: onFormationSlotLongPress,
					applySprite,
					applyItemIcon,
				});
				renderTeamMateSlots({
					root: teamDataMobileSlotsRoot,
					membersBySlot: effectiveMembersBySlot(),
					displayName,
					selectedSlot: selectedFormationSlot,
					onSlotTap: onFormationSlotTap,
					onSlotDoubleTap: onFormationSlotDoubleTap,
					onSlotLongPress: onFormationSlotLongPress,
					applySprite,
					applyItemIcon,
				});

				formationMobileBoxGrid.replaceChildren();
				const term = formationMobileSearchInput.value.trim();
				const candidates = sortFormationMobilePokemon(allPokemon.filter((candidate) => !isCurrentMember(candidate.id) && matchesSearch(candidate, term)));
				candidates.sort((a, b) => Number(suggestionSpeciesRanks.has(b.species_name)) - Number(suggestionSpeciesRanks.has(a.species_name)));
				for (const p of candidates) {
					const card = document.createElement("button");
					card.type = "button";
					attachLongPressNavigate(card, p.id);
					card.addEventListener("click", (event) => {
						event.stopPropagation();
						if (selectedFormationSlot != null) {
							const targetSlot = selectedFormationSlot;
							selectedFormationSlot = null;
							selectedCandidatePokemon = null;
							renderFormationMobile();
							assignToSlot(p, targetSlot);
						} else if (selectedCandidatePokemon?.id === p.id) {
							selectedCandidatePokemon = null;
							renderFormationMobile();
						} else if (firstEmptySlot() != null) {
							// 空き枠がある間は、既存どおり1タップで次の空き枠へ即配置する
							// (選択待ちにすると、空きから組み立てる通常操作が2タップになってしまう)。
							assignToSlot(p);
						} else {
							// 空き枠が無い(6枠すべて埋まっている)ときだけ、候補を選択状態にして
							// 後続のチーム枠タップで入れ替え先を選べるようにする(要件: ボックス
							// カード→チームの順のタップでも入れ替えを行う)。
							selectedCandidatePokemon = p;
							selectedFormationSlot = null;
							renderFormationMobile();
						}
					});
					const name = displayName(p);
					renderBoxPokemonCard({
						root: card,
						pokemon: p,
						displayName: name,
						ariaLabel: `${name}を編成`,
					});
					if (selectedCandidatePokemon?.id === p.id) card.classList.add("is-selected");
					if (suggestionSpeciesRanks.has(p.species_name)) {
						const recommendationBadge = document.createElement("span");
						recommendationBadge.className = "card-recommendation-badge";
						recommendationBadge.textContent = "★";
						recommendationBadge.title = "おすすめ";
						recommendationBadge.setAttribute("aria-label", "おすすめ");
						card.querySelector(".card-name-row")?.prepend(recommendationBadge);
					}
					formationMobileBoxGrid.appendChild(card);
				}
				formationMobileBoxGrid.appendChild(formationMobileAddButton);
			}

			function navigateToPokemonEdit(pokemonId: string): void {
				window.location.href = `/box/${encodeURIComponent(pokemonId)}?fromTeam=${encodeURIComponent(teamId)}`;
			}

			function attachLongPressNavigate(element: HTMLElement, pokemonId: string): void {
				const LONG_PRESS_MS = 600;
				let pressTimer: ReturnType<typeof window.setTimeout> | undefined;
				let suppressNextClick = false;
				const clearPress = (): void => {
					if (pressTimer !== undefined) window.clearTimeout(pressTimer);
					pressTimer = undefined;
				};

				element.addEventListener("pointerdown", (event) => {
					suppressNextClick = false;
					if (event.button !== 0) return;
					pressTimer = window.setTimeout(() => {
						pressTimer = undefined;
						suppressNextClick = true;
						navigateToPokemonEdit(pokemonId);
					}, LONG_PRESS_MS);
				});
				element.addEventListener("pointerup", clearPress);
				element.addEventListener("pointercancel", clearPress);
				element.addEventListener("pointerleave", clearPress);
				element.addEventListener("contextmenu", (event) => {
					if (pressTimer !== undefined || suppressNextClick) event.preventDefault();
				});
				element.addEventListener("click", (event) => {
					if (!suppressNextClick) return;
					suppressNextClick = false;
					event.preventDefault();
					event.stopPropagation();
				}, true);
			}

			async function createFormationMobilePokemon(): Promise<void> {
				if (isGuestMode()) {
					showGuestLoginDialog();
					return;
				}
				formationMobileAddButton.disabled = true;
				formationMobileStatus.hidden = true;
				try {
					const { id } = await createOwnedPokemon({
						species_name: "",
						level: null,
						nature: null,
						ability_name: null,
						item_name: null,
						tera_type: null,
						evs: [0, 0, 0, 0, 0, 0],
						ivs: [31, 31, 31, 31, 31, 31],
						move_names: [],
						memo: null,
						tags: [],
					});
					const now = new Date().toISOString();
					const created: OwnedPokemonRecord = {
						id,
						species_name: "",
						ability_name: null,
						item_name: null,
						tera_type: null,
						move_names: [],
						level: null,
						nature: null,
						evs: [0, 0, 0, 0, 0, 0],
						ivs: [31, 31, 31, 31, 31, 31],
						created_at: now,
						updated_at: now,
						last_used_at: null,
						is_pinned: false,
						memo: null,
						tags: [],
					};
					allPokemon = [created, ...allPokemon];
					renderFormationMobile();
					// 空き枠があればそのまま編成に加える。入れた場合はナビゲーション前に確実に
					// 保存を確定させる(scheduleSaveのdebounceだけだと画面遷移で保存が飛ぶため)。
					if (membersBySlot.size < 6) {
						assignToSlot(created);
						if (await saveNow()) return;
					}
					navigateToPokemonEdit(created.id);
					return;
				} catch (err) {
					console.error(err);
					formationMobileStatus.textContent = "個体を追加できませんでした。時間をおいて再度お試しください。";
					formationMobileStatus.hidden = false;
				} finally {
					formationMobileAddButton.disabled = false;
				}
			}

			// モバイル自チーム表示(編成・相性・類似チームの各タブで共通): 自チームカード以外を
			// タップしたら選択状態を解除する(カード自身のタップはonFormationSlotTap側で
			// 選択/入れ替え/解除を処理済みのため対象外)。
			document.addEventListener("click", (event) => {
				if (selectedFormationSlot === null && selectedCandidatePokemon === null) return;
				const target = event.target as Node;
				if (formationMobileSlotsRoot.contains(target)) return;
				if (matchupMobileSlotsRoot.contains(target)) return;
				if (teamDataMobileSlotsRoot.contains(target)) return;
				if (formationMobileBoxGrid.contains(target)) return;
				selectedFormationSlot = null;
				selectedCandidatePokemon = null;
				renderFormationMobile();
			});

			document.addEventListener("click", (event) => {
				if (selectedOverviewSlot === null) return;
				if (overviewGrid.contains(event.target as Node)) return;
				selectedOverviewSlot = null;
				renderOverviewGrid();
			});

			// --- 選択バーの描画(R-7・R-10) ---
			function matchesSearch(p: OwnedPokemonRecord, term: string): boolean {
				if (!term) return true;
				// ボックス一覧と同じ対象を空白連結し、複数語ANDのかな部分一致で探す。
				const haystack = [p.species_name, p.ability_name ?? "", p.item_name ?? "", p.tera_type ?? "", ...p.move_names].join(" ");
				return term
					.split(/\s+/)
					.filter((t) => t.length > 0)
					// 既存の複数語ANDを保ち、各語のかな表記だけを正規化して比較する。
					.every((token) => kanaIncludes(haystack, token));
			}

			function isCurrentMember(id: string): boolean {
				for (const p of membersBySlot.values()) {
					if (p.id === id) return true;
				}
				return false;
			}

			const formationMobileSortDirectionToggle = initializeSortDirectionToggle({
				select: formationMobileSortSelect,
				selectWrap: formationMobileSortSelectWrap,
				directionToggle: formationMobileSortDirToggle,
				defaultOrders: {
					updated_at: "desc",
					dex_no: "asc",
					type: "asc",
					species_name: "asc",
				},
				onChange: () => renderFormationMobile(),
			});

			function sortFormationMobilePokemon(list: OwnedPokemonRecord[]): OwnedPokemonRecord[] {
				const sort = formationMobileSortSelect.value;
				const compareAscending = (a: OwnedPokemonRecord, b: OwnedPokemonRecord): number => {
					if (sort === "species_name") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "dex_no") {
						const aDex = resolveDexNo(a.species_name);
						const bDex = resolveDexNo(b.species_name);
						if (aDex === null && bDex !== null) return 1;
						if (aDex !== null && bDex === null) return -1;
						if (aDex !== bDex) return (aDex ?? 0) - (bDex ?? 0);
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "type") {
						const aTypes = resolveSpeciesTypes(a.species_name).join("/");
						const bTypes = resolveSpeciesTypes(b.species_name).join("/");
						if (!aTypes && bTypes) return 1;
						if (aTypes && !bTypes) return -1;
						const typeResult = aTypes.localeCompare(bTypes, "ja");
						return typeResult || displayName(a).localeCompare(displayName(b), "ja");
					}
					return new Date(a.updated_at).getTime() - new Date(b.updated_at).getTime();
				};
				return [...list].sort((a, b) => {
					const aSuggestionRank = suggestionSpeciesRanks.get(a.species_name);
					const bSuggestionRank = suggestionSpeciesRanks.get(b.species_name);
					const aIsTopSuggestion = aSuggestionRank !== undefined && aSuggestionRank < 3;
					const bIsTopSuggestion = bSuggestionRank !== undefined && bSuggestionRank < 3;
					if (aIsTopSuggestion !== bIsTopSuggestion) return aIsTopSuggestion ? -1 : 1;
					if (aIsTopSuggestion && bIsTopSuggestion) return aSuggestionRank! - bSuggestionRank!;
					if (sort === "dex_no") {
						const aDex = resolveDexNo(a.species_name);
						const bDex = resolveDexNo(b.species_name);
						if (aDex === null && bDex !== null) return 1;
						if (aDex !== null && bDex === null) return -1;
					}
					const result = compareAscending(a, b);
					return formationMobileSortDirectionToggle.getSortOrder() === "desc" ? -result : result;
				});
			}

			// --- 自動保存(box/[id].astroと同じデバウンス方式。保存ボタンは作らない) ---
			function buildPayload(): TeamRequestBody {
				const members = Array.from(membersBySlot.entries())
					.sort((a, b) => a[0] - b[0])
					.map(([slot, p]) => ({ slot, owned_pokemon_id: p.id, item_override: itemOverridesBySlot.get(slot) ?? null }));
				const memo = memoInput.value.trim();
				return {
					memo: memo === "" ? null : memo,
					members,
				};
			}

			const DEBOUNCE_MS = 700;
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;
			let saving = false;
			let pendingRetry = false;

			async function saveNow(): Promise<boolean> {
				if (saving) {
					pendingRetry = true;
					return false;
				}
				const payload = buildPayload();
				if (!teamId && payload.members.length === 0) {
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "メンバーを追加すると保存されます";
					retryButton.classList.remove("visible");
					return false;
				}
				saving = true;
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "保存中…";
				retryButton.classList.remove("visible");

				try {
					let saveTeamId = teamId;
					if (!saveTeamId) {
						saveTeamId = (await createTeam()).id;
					}
					await updateTeam(saveTeamId, payload);
					if (!teamId) {
						teamId = saveTeamId;
						const currentTab = layoutRoot.dataset.mobileTab || "formation";
						window.location.href = `/team/${encodeURIComponent(teamId)}?tab=${encodeURIComponent(currentTab)}`;
						return true;
					}
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "保存済み";
				} catch (err) {
					console.error(err);
					statusEl.dataset.state = "error";
					statusTextEl.textContent = "保存できませんでした。";
					retryButton.classList.add("visible");
				} finally {
					saving = false;
					if (pendingRetry) {
						pendingRetry = false;
						void saveNow();
					}
				}
				return false;
			}

			function scheduleSave(): void {
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "編集中…";
				retryButton.classList.remove("visible");
				if (debounceTimer) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					void saveNow();
				}, DEBOUNCE_MS);
			}

			retryButton.addEventListener("click", () => {
				void saveNow();
			});

			copyTeamButton?.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを複製します。よろしいですか?")) return;
					if (!copyTeamButton) return;
					copyTeamButton.disabled = true;
					try {
						const members = [] as TeamRequestBody["members"];
						for (const [slot, pokemon] of Array.from(membersBySlot.entries()).sort((a, b) => a[0] - b[0])) {
							const { id } = await createOwnedPokemon({
								species_name: pokemon.species_name,
								level: pokemon.level,
								nature: pokemon.nature,
								ability_name: pokemon.ability_name,
								item_name: pokemon.item_name,
								tera_type: pokemon.tera_type,
								evs: [...pokemon.evs],
								ivs: [...pokemon.ivs],
								move_names: [...pokemon.move_names],
								memo: pokemon.memo,
								tags: [...pokemon.tags],
							});
							members.push({ slot, owned_pokemon_id: id, item_override: itemOverridesBySlot.get(slot) ?? null });
						}
						const { id } = await createTeam();
						await updateTeam(id, {
							memo: memoInput.value.trim() || null,
							members,
						});
						window.location.href = `/team/${encodeURIComponent(id)}`;
					} catch (err) {
						console.error(err);
						window.alert("コピーできませんでした。時間をおいて再度お試しください。");
						copyTeamButton.disabled = false;
					}
				})();
			});

			deleteTeamButton?.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを削除します。よろしいですか?")) return;
					if (!deleteTeamButton) return;
					deleteTeamButton.disabled = true;
					try {
						await deleteTeam(teamId);
						window.location.href = "/team";
					} catch (err) {
						console.error(err);
						window.alert("削除に失敗しました。時間をおいて再度お試しください。");
						deleteTeamButton.disabled = false;
					}
				})();
			});

			memoInput.addEventListener("input", scheduleSave);
			function closeRedistributionHelp(): void {
				itemRedistributeHelpPopover.hidden = true;
				itemRedistributeHelpButton.setAttribute("aria-expanded", "false");
			}
			itemRedistributeHelpButton.addEventListener("click", (event) => {
				event.stopPropagation();
				const willOpen = itemRedistributeHelpPopover.hidden;
				itemRedistributeHelpPopover.hidden = !willOpen;
				itemRedistributeHelpButton.setAttribute("aria-expanded", String(willOpen));
			});
			document.addEventListener("click", (event) => {
				if (itemRedistributeHelpPopover.hidden) return;
				if (event.target instanceof Node && (itemRedistributeHelpPopover.contains(event.target) || itemRedistributeHelpButton.contains(event.target))) return;
				closeRedistributionHelp();
			});
			function closeRedistributionDialog(): void {
				itemRedistributeBackdrop.hidden = true;
				itemRedistributeDialog.hidden = true;
				closeRedistributionHelp();
				selectedRedistributionSlot = null;
				selectedRedistributionItem = null;
				itemRedistributeButton.focus();
			}
			itemRedistributeButton.addEventListener("click", () => {
				void redistributionItemGrid.ensureBuilt().then(() => {
					redistributionSearchQuery = "";
					itemRedistributeSearch.value = "";
					renderRedistributionMembers();
					renderRedistributionItems();
					itemRedistributeBackdrop.hidden = false;
					itemRedistributeDialog.hidden = false;
					itemRedistributeDialog.focus();
					// チームの合計採用率はネットワーク取得を伴うため、ダイアログ表示自体は
					// 待たせず、届き次第もちもの一覧の並び順だけ更新する。
					void loadTeamItemUsageTotals().then(() => renderRedistributionItems());
					// メガストーン対応表も同様に非同期取得し、届き次第ロック表示を反映する。
					void loadRedistributionLocks().then(() => renderRedistributionMembers());
				});
			});
			itemRedistributeClose.addEventListener("click", closeRedistributionDialog);
			itemRedistributeBackdrop.addEventListener("click", closeRedistributionDialog);
			itemRedistributeSearch.addEventListener("input", () => {
				redistributionSearchQuery = itemRedistributeSearch.value.trim();
				renderRedistributionItems();
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && !itemRedistributeDialog.hidden) closeRedistributionDialog();
			});
			formationMobileSearchInput.addEventListener("input", renderFormationMobile);
			formationMobileAddButton.addEventListener("click", () => void createFormationMobilePokemon());

			// --- 初期化 ---
			// SSR取得済みのメンバーは fetch を待たずに即描画する(6枠が空でも一瞬も待たせない)。
			mobileTabsInitialized = true;
			renderOverviewGrid();
			renderFormationMobile();
			void loadSuggestions();
			void loadSimilarBuilds();

			async function loadAllOwnedPokemon(): Promise<void> {
				let offset = 0;
				const pokemon: OwnedPokemonRecord[] = [];
				while (true) {
					const page = await listOwnedPokemonPage({ limit: 48, offset });
					pokemon.push(...page.data as OwnedPokemonRecord[]);
					offset += page.data.length;
					if (!page.hasMore || page.data.length === 0) break;
				}
				allPokemon = pokemon;
				for (const [slot, p] of membersBySlot.entries()) {
					const fresh = allPokemon.find((x) => x.id === p.id);
					if (fresh) membersBySlot.set(slot, fresh);
				}
				renderFormationMobile();
				// サジェストの操作ボタンは「手持ちに一致する個体があるか」で文言が変わる
				// (findOwnedMatch)。その判定材料である allPokemon が今届いたので、
				// 既に描画済みの結果があれば同じデータのまま描き直す(再fetchはしない)。
				if (lastSuggestResponse) {
					void renderSuggestions(lastSuggestResponse.suggestions, lastSuggestResponse.basis);
				}
			}

			void loadAllOwnedPokemon().catch((err) => {
				console.error(err);
			});
		}
	</script>
</AppLayout>
