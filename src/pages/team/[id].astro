			height: 2rem;
			border-radius: 50%;
			font-weight: 800;
			font-size: 1rem;
			color: var(--color-text-muted);
			background: var(--color-surface);
		}
		.team-slots .card-team-slot[data-filled="true"] .slot-number {
			border: 1px solid var(--color-border);
			/* UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応で縦積みに
			   組み替えたため、番号バッジはbox画面のバッジ重畳と同じくカード左上に重ねて置く
