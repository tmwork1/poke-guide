			function renderFormationMobile(): void {
				const shouldShowFormationSuggestions = membersBySlot.size >= 1 && membersBySlot.size <= 6;
				if (!shouldShowFormationSuggestions) suggestionSpeciesRanks.clear();
				renderTeamMateSlots({
					root: formationMobileSlotsRoot,
					membersBySlot,
					displayName,
					selectedSlot: selectedFormationSlot,
					onSlotTap: (slot) => {
						if (selectedFormationSlot !== null && selectedFormationSlot !== slot && membersBySlot.has(selectedFormationSlot) && membersBySlot.has(slot)) {
							swapMembersBetweenSlots(selectedFormationSlot, slot);
							selectedFormationSlot = null;
							return;
						}
						selectedFormationSlot = selectedFormationSlot === slot ? null : slot;
						renderFormationMobile();
					},
					onSlotDoubleTap: (slot) => {
						if (membersBySlot.has(slot)) removeMemberFromSlot(slot);
					},
					onSlotLongPress: (slot) => {
						if (membersBySlot.has(slot)) removeMemberFromSlot(slot);
					},
					applySprite,
					applyItemIcon,
				});
				renderTeamMateSlots({
					root: matchupMobileSlotsRoot,
					membersBySlot,
					displayName,
					applySprite,
					applyItemIcon,
				});
				renderTeamMateSlots({
					root: teamDataMobileSlotsRoot,
					membersBySlot,
					displayName,
					applySprite,
					applyItemIcon,
				});

				formationMobileBoxGrid.replaceChildren(formationMobileAddButton);
				const term = formationMobileSearchInput.value.trim();
				for (const p of sortFormationMobilePokemon(allPokemon.filter((candidate) => !isCurrentMember(candidate.id) && matchesSearch(candidate, term)))) {
					const card = document.createElement("button");
					card.type = "button";
					card.addEventListener("click", () => {
						if (selectedFormationSlot != null) {
							const targetSlot = selectedFormationSlot;
							selectedFormationSlot = null;
							renderFormationMobile();
							assignToSlot(p, targetSlot);
						} else {
							assignToSlot(p);
						}
					});
					const name = displayName(p);
					renderBoxPokemonCard({
						root: card,
						pokemon: p,
						displayName: name,
						ariaLabel: `${name}を編成`,
					});
					if (suggestionSpeciesRanks.has(p.species_name)) {
						const recommendationBadge = document.createElement("span");
						recommendationBadge.className = "card-recommendation-badge";
						recommendationBadge.textContent = "★";
						recommendationBadge.title = "おすすめ";
						recommendationBadge.setAttribute("aria-label", "おすすめ");
						card.querySelector(".card-name-row")?.prepend(recommendationBadge);
					}
					formationMobileBoxGrid.appendChild(card);
				}
			}

			async function createFormationMobilePokemon(): Promise<void> {
				formationMobileAddButton.disabled = true;
				formationMobileStatus.hidden = true;
				try {
					const res = await fetch("/api/owned-pokemon", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ nickname: "", species_name: "", level: null, nature: "", ability_name: "", item_name: "", tera_type: "", regulation: "", evs: [0, 0, 0, 0, 0, 0], ivs: [31, 31, 31, 31, 31, 31], move_names: [], memo: "", tags: [], is_pinned: false }),
					});
					const body = (await res.json().catch(() => ({}))) as { data?: OwnedPokemonRecord; error?: string };
					if (!res.ok || !body.data) throw new Error(body.error ?? `個体を追加できませんでした (status=${res.status})`);
					allPokemon = [body.data, ...allPokemon];
					renderSelectList();
					renderFormationMobile();
				} catch (err) {
					console.error(err);
					formationMobileStatus.textContent = "個体を追加できませんでした。時間をおいて再度お試しください。";
					formationMobileStatus.hidden = false;
				} finally {
					formationMobileAddButton.disabled = false;
				}
			}

			function renderSlots(): void {
				slotsRoot.innerHTML = "";
				for (let slot = 1; slot <= 6; slot += 1) {
					const card = document.createElement("article");
					card.className = "card card-team-slot";
					card.dataset.slot = String(slot);
					const p = membersBySlot.get(slot);
					if (p) {
						card.dataset.filled = "true";
						card.appendChild(buildFilledSlotContent(slot, p));
						card.addEventListener("click", () => {
							void renderPreviewPanel(p);
							for (const other of slotsRoot.querySelectorAll(".card-team-slot")) {
								other.classList.remove("is-selected");
							}
							card.classList.add("is-selected");
						});
						card.addEventListener("dblclick", () => {
							removeMemberFromSlot(slot);
						});
						card.draggable = true;
						card.addEventListener("dragstart", () => {
							draggedMemberSlot = slot;
							card.classList.add("is-dragging");
						});
						card.addEventListener("dragend", () => {
							draggedMemberSlot = null;
							card.classList.remove("is-dragging");
						});
					} else {
						card.dataset.filled = "false";
						card.appendChild(buildEmptySlotContent(slot));
					}

					card.addEventListener("dragover", (event) => {
						if (!draggedPokemonId && draggedMemberSlot == null) return;
						if (draggedMemberSlot === slot) return; // 自分自身へのドロップは無意味
						event.preventDefault();
						card.classList.add("is-drop-target");
					});
					card.addEventListener("dragleave", () => {
						card.classList.remove("is-drop-target");
					});
					card.addEventListener("drop", (event) => {
						event.preventDefault();
						card.classList.remove("is-drop-target");
						if (draggedMemberSlot != null) {
							const fromSlot = draggedMemberSlot;
							draggedMemberSlot = null;
							if (fromSlot !== slot) swapMembersBetweenSlots(fromSlot, slot);
							return;
						}
						const id = draggedPokemonId;
						draggedPokemonId = null;
						if (!id) return;
						const p = allPokemon.find((x) => x.id === id);
						if (!p) return;
						assignToSlot(p, slot);
					});
					slotsRoot.appendChild(card);
				}
				renderOverviewGrid();
			}

			document.addEventListener("click", (event) => {
				const target = event.target as Node;
				if (previewPanelEl.contains(target)) return;
				if (Array.from(slotsRoot.querySelectorAll(".card-team-slot")).some((card) => card.contains(target))) return;
				for (const card of slotsRoot.querySelectorAll(".card-team-slot")) {
					card.classList.remove("is-selected");
				}
				closePreviewPanel();
			});

			// --- 選択バーの描画(R-7・R-10) ---
			function matchesSearch(p: OwnedPokemonRecord, term: string): boolean {
				if (!term) return true;
				// ボックス一覧と同じ対象を空白連結し、複数語ANDのかな部分一致で探す。
				const haystack = [p.nickname ?? "", p.species_name, p.ability_name ?? "", p.item_name ?? "", p.tera_type ?? "", ...p.move_names].join(" ");
				return term
					.split(/\s+/)
					.filter((t) => t.length > 0)
					// 既存の複数語ANDを保ち、各語のかな表記だけを正規化して比較する。
					.every((token) => kanaIncludes(haystack, token));
			}

			// 空のアイテムは重複扱いせず、編成済みの種族または実値のあるアイテムだけを除外する。
			function matchesDedupe(p: OwnedPokemonRecord): boolean {
				if (!dedupeToggle.checked) return true;
				const itemName = p.item_name?.trim() ?? "";
				for (const member of membersBySlot.values()) {
					if (member.species_name === p.species_name) return false;
					if (itemName && member.item_name?.trim() === itemName) return false;
				}
				return true;
			}

			function matchesFavorite(p: OwnedPokemonRecord): boolean {
				return !favoriteFilterToggle.checked || p.is_pinned;
			}

			function isCurrentMember(id: string): boolean {
				for (const p of membersBySlot.values()) {
					if (p.id === id) return true;
				}
				return false;
			}

			const formationMobileSortDirectionToggle = initializeSortDirectionToggle({
				select: formationMobileSortSelect,
				selectWrap: formationMobileSortSelectWrap,
				directionToggle: formationMobileSortDirToggle,
				directionLabel: formationMobileSortDirToggleLabel,
				defaultOrders: {
					updated_at: "desc",
					dex_no: "asc",
					type: "asc",
					nickname: "asc",
				},
				onChange: () => renderFormationMobile(),
			});

			function sortFormationMobilePokemon(list: OwnedPokemonRecord[]): OwnedPokemonRecord[] {
				const sort = formationMobileSortSelect.value;
				const compareAscending = (a: OwnedPokemonRecord, b: OwnedPokemonRecord): number => {
					if (sort === "nickname") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "dex_no") {
						const aDex = resolveDexNo(a.species_name);
						const bDex = resolveDexNo(b.species_name);
						if (aDex === null && bDex !== null) return 1;
						if (aDex !== null && bDex === null) return -1;
						if (aDex !== bDex) return (aDex ?? 0) - (bDex ?? 0);
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "type") {
						const aTypes = resolveSpeciesTypes(a.species_name).join("/");
						const bTypes = resolveSpeciesTypes(b.species_name).join("/");
						if (!aTypes && bTypes) return 1;
						if (aTypes && !bTypes) return -1;
						const typeResult = aTypes.localeCompare(bTypes, "ja");
						return typeResult || displayName(a).localeCompare(displayName(b), "ja");
					}
					return new Date(a.updated_at).getTime() - new Date(b.updated_at).getTime();
				};
				return [...list].sort((a, b) => {
					const aSuggestionRank = suggestionSpeciesRanks.get(a.species_name);
					const bSuggestionRank = suggestionSpeciesRanks.get(b.species_name);
					const aIsTopSuggestion = aSuggestionRank !== undefined && aSuggestionRank < 3;
					const bIsTopSuggestion = bSuggestionRank !== undefined && bSuggestionRank < 3;
					if (aIsTopSuggestion !== bIsTopSuggestion) return aIsTopSuggestion ? -1 : 1;
					if (aIsTopSuggestion && bIsTopSuggestion) return aSuggestionRank! - bSuggestionRank!;
					if (sort === "dex_no") {
						const aDex = resolveDexNo(a.species_name);
						const bDex = resolveDexNo(b.species_name);
						if (aDex === null && bDex !== null) return 1;
						if (aDex !== null && bDex === null) return -1;
					}
					const result = compareAscending(a, b);
					return formationMobileSortDirectionToggle.getSortOrder() === "desc" ? -result : result;
				});
			}

			function sortPokemon(list: OwnedPokemonRecord[]): OwnedPokemonRecord[] {
				const sort = sortSelect.value;
				return [...list].sort((a, b) => {
					if (sort === "suggestion" && suggestionSpeciesRanks.size > 0) {
						const aRank = suggestionSpeciesRanks.get(a.species_name) ?? Number.POSITIVE_INFINITY;
						const bRank = suggestionSpeciesRanks.get(b.species_name) ?? Number.POSITIVE_INFINITY;
						if (aRank !== bRank) return aRank - bRank;
					}
					if (sort === "dex_no") {
						const aDex = resolveDexNo(a.species_name) ?? Number.POSITIVE_INFINITY;
						const bDex = resolveDexNo(b.species_name) ?? Number.POSITIVE_INFINITY;
						if (aDex !== bDex) return aDex - bDex;
					}
					const field = sort === "last_used_at" ? "last_used_at" : "updated_at";
					if (!a[field] && !b[field]) return 0;
					if (!a[field]) return 1;
					if (!b[field]) return -1;
					const aTime = new Date(a[field] as string).getTime();
					const bTime = new Date(b[field] as string).getTime();
					return bTime - aTime;
				});
			}

			function buildSelectRow(p: OwnedPokemonRecord): HTMLElement {
				const row = document.createElement("div");
				row.className = "pokemon-select-row";
				row.draggable = true;

				const mainButton = document.createElement("button");
				mainButton.type = "button";
				mainButton.className = "select-row-main";

				const artEl = document.createElement("span");
				artEl.className = "select-row-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "select-row-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "select-row-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				// 左候補だけは情報密度を優先し、URL生成をドット絵へ差し替える。
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const bodyEl = document.createElement("span");
				bodyEl.className = "select-row-body";
				const name = displayName(p);

				const nameRow = document.createElement("span");
				nameRow.className = "select-row-name-row";
				const nameEl = document.createElement("span");
				nameEl.className = "select-row-name";
				nameEl.textContent = name;
				nameRow.appendChild(nameEl);
				const artBadges = document.createElement("span");
				artBadges.className = "select-row-art-badges";
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					// ダメージ計算カードと同様、持ち物名は出さず画像右下へアイコンを重ねる。
					const itemBadge = document.createElement("span");
					itemBadge.className = "select-row-item-badge";
					itemBadge.title = `アイテム: ${itemName}`;
					const itemImg = document.createElement("img");
					itemImg.alt = "";
					void applyItemIcon(itemImg, itemName);
					itemBadge.appendChild(itemImg);
					artBadges.appendChild(itemBadge);
				}
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraBadge = document.createElement("span");
					teraBadge.className = "select-row-tera-badge";
					teraBadge.title = `テラスタイプ: ${teraType}`;
					teraBadge.setAttribute("aria-label", `テラスタイプ: ${teraType}`);
					const teraImg = document.createElement("img");
					teraImg.alt = "";
					applyTeraIcon(teraImg, teraType);
					teraBadge.appendChild(teraImg);
					artBadges.appendChild(teraBadge);
				}
				// アイコン列はアートの右へ独立配置し、画像との重なりを避ける。

				const movesRow = document.createElement("span");
				movesRow.className = "select-row-moves";
				const rowMoves = p.move_names.filter((m) => m && m.trim() !== "");
				if (rowMoves.length > 0) {
					const chipEntries: { iconEl: HTMLImageElement; visibilityEl: HTMLElement; moveName: string }[] = [];
					for (const move of rowMoves) {
						const chip = document.createElement("span");
						chip.className = "select-row-move-chip";
						const iconEl = document.createElement("img");
						iconEl.className = "select-row-move-chip-icon";
						iconEl.alt = "";
						iconEl.hidden = true;
						chip.appendChild(iconEl);
						const textEl = document.createElement("span");
						textEl.className = "select-row-move-chip-text";
						textEl.textContent = move;
						chip.appendChild(textEl);
						movesRow.appendChild(chip);
						chipEntries.push({ iconEl, visibilityEl: iconEl, moveName: move });
					}
					void applySelectMoveChipTypeIcons(chipEntries);
				} else {
					const chip = document.createElement("span");
					chip.className = "select-row-move-chip select-row-move-chip-unset";
					const textEl = document.createElement("span");
					textEl.className = "select-row-move-chip-text";
					textEl.textContent = "";
					textEl.setAttribute("aria-hidden", "true");
					chip.appendChild(textEl);
					movesRow.appendChild(chip);
				}
				bodyEl.prepend(nameRow, artBadges);
				bodyEl.appendChild(movesRow);

				const reason = selectionBlockReason(candidateOf(p), currentCandidates());
				if (reason) {
					mainButton.disabled = true;
					const reasonEl = document.createElement("span");
					reasonEl.className = "select-row-reason";
					// A-3(a): 「編成済み」(already-in-team、正常)と禁止3種を色で書き分けるため、
					// data-reasonをCSSセレクタのフックにする(is:globalスタイル側で参照)。
					reasonEl.dataset.reason = reason;
					reasonEl.textContent = BLOCK_REASON_LABELS[reason];
					bodyEl.appendChild(reasonEl);
					mainButton.setAttribute("aria-label", `${name}(${BLOCK_REASON_LABELS[reason]}、選択できません)の詳細を見る`);
				} else {
					mainButton.setAttribute("aria-label", `${name}の詳細を見る(ダブルクリックで空き枠に追加)`);
					mainButton.addEventListener("dblclick", () => {
						assignToSlot(p);
					});
				}
				mainButton.addEventListener("click", () => {
					void renderPreviewPanel(p);
				});

				// NNを必ず独立した2行目に置き、1行目の情報量に左右されず中央へ揃える。
				mainButton.append(artEl, bodyEl);
				row.appendChild(mainButton);

				const dragHandle = document.createElement("span");
				dragHandle.className = "select-row-drag-handle";
				dragHandle.setAttribute("aria-hidden", "true");
				row.appendChild(dragHandle);

				row.addEventListener("dragstart", () => {
					draggedPokemonId = p.id;
					row.classList.add("is-dragging");
				});
				row.addEventListener("dragend", () => {
					draggedPokemonId = null;
					row.classList.remove("is-dragging");
				});

				return row;
			}

			function renderSelectList(): void {
				if (allPokemon.length === 0) {
					selectListRoot.innerHTML = "";
					pokemonCountBadge.textContent = "0";
					pokemonCountBadge.hidden = false;
					selectEmptyState.hidden = false;
					selectNoMatchState.hidden = true;
					return;
				}
				selectEmptyState.hidden = true;

				const term = searchInput.value.trim();
				const filtered = sortPokemon(
					allPokemon.filter((p) => !isCurrentMember(p.id) && matchesFavorite(p) && matchesDedupe(p) && matchesSearch(p, term)),
				);
				pokemonCountBadge.textContent = String(filtered.length);
				pokemonCountBadge.hidden = false;
				selectListRoot.innerHTML = "";
				if (filtered.length === 0) {
					selectNoMatchState.hidden = false;
					return;
				}
				selectNoMatchState.hidden = true;
				for (const p of filtered) {
					selectListRoot.appendChild(buildSelectRow(p));
				}
			}

			// --- 自動保存(box/[id].astroと同じデバウンス方式。保存ボタンは作らない) ---
			function buildPayload(): {
				memo: string | null;
				members: { slot: number; owned_pokemon_id: string }[];
			} {
				const members = Array.from(membersBySlot.entries())
					.sort((a, b) => a[0] - b[0])
					.map(([slot, p]) => ({ slot, owned_pokemon_id: p.id }));
				const memo = memoInput.value.trim();
				return {
					memo: memo === "" ? null : memo,
					members,
				};
			}

			const DEBOUNCE_MS = 700;
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;
			let saving = false;
			let pendingRetry = false;

			async function saveNow(): Promise<void> {
				if (saving) {
					pendingRetry = true;
					return;
				}
				const payload = buildPayload();
				saving = true;
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "保存中…";
				retryButton.classList.remove("visible");

				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					if (!res.ok) {
						const body = (await res.json().catch(() => ({}))) as { error?: string };
						throw new Error(body.error ?? `保存に失敗しました (status=${res.status})`);
					}
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "保存済み";
				} catch (err) {
					console.error(err);
					statusEl.dataset.state = "error";
					statusTextEl.textContent = "保存できませんでした。";
					retryButton.classList.add("visible");
				} finally {
					saving = false;
					if (pendingRetry) {
						pendingRetry = false;
						void saveNow();
					}
				}
			}

			function scheduleSave(): void {
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "編集中…";
				retryButton.classList.remove("visible");
				if (debounceTimer) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					void saveNow();
				}, DEBOUNCE_MS);
			}

			retryButton.addEventListener("click", () => {
				void saveNow();
			});

			deleteTeamButton.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを削除します。よろしいですか?")) return;
					deleteTeamButton.disabled = true;
					try {
						const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
							method: "DELETE",
							credentials: "same-origin",
						});
						if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
						window.location.href = "/team";
					} catch (err) {
						console.error(err);
						window.alert("削除に失敗しました。時間をおいて再度お試しください。");
						deleteTeamButton.disabled = false;
					}
				})();
			});

			memoInput.addEventListener("input", scheduleSave);
			searchInput.addEventListener("input", renderSelectList);
			formationMobileSearchInput.addEventListener("input", renderFormationMobile);
			formationMobileAddButton.addEventListener("click", () => void createFormationMobilePokemon());
			sortSelect.addEventListener("change", renderSelectList);
			// 編成変更時は既存の追加・削除経路が再描画するため、トグル操作だけを追加する。
			dedupeToggle.addEventListener("change", renderSelectList);
			favoriteFilterToggle.addEventListener("change", renderSelectList);

			includeMegaToggle.addEventListener("change", () => {
				if (lastSuggestResponse) {
					void renderSuggestions(lastSuggestResponse.suggestions, lastSuggestResponse.basis);
				}
			});

			// --- 初期化 ---
			// SSR取得済みのメンバーは fetch を待たずに即描画する(6枠が空でも一瞬も待たせない)。
			renderSlots();
			renderFormationMobile();
			void loadSuggestions();
			void loadSimilarBuilds();

			fetch("/api/owned-pokemon", { credentials: "same-origin" })
				.then(async (res) => {
					if (!res.ok) throw new Error(`個体一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemonRecord[] };
					allPokemon = body.data;
					for (const [slot, p] of membersBySlot.entries()) {
						const fresh = allPokemon.find((x) => x.id === p.id);
						if (fresh) membersBySlot.set(slot, fresh);
					}
					selectLoadingMessage.hidden = true;
					renderSelectList();
					renderFormationMobile();
					// サジェストの操作ボタンは「手持ちに一致する個体があるか」で文言が変わる
					// (findOwnedMatch)。その判定材料である allPokemon が今届いたので、
					// 既に描画済みの結果があれば同じデータのまま描き直す(再fetchはしない)。
					if (lastSuggestResponse) {
						void renderSuggestions(lastSuggestResponse.suggestions, lastSuggestResponse.basis);
					}
				})
				.catch((err) => {
					console.error(err);
					selectLoadingMessage.hidden = true;
					selectErrorMessage.hidden = false;
				});
		}
	</script>
</AppLayout>
