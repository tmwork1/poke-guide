				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.title = "個体を編集";
				editLink.setAttribute("aria-label", `${name}を編集`);
				editLink.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>';
				// カード自体にclick(プレビュー)/dblclick(削除)/dragstart(並べ替え)を付けたため
				// (renderSlots参照)、このリンクへのクリックがバブリングして意図せずプレビュー
				// 描画を誘発しないよう止める(遷移自体には影響しない)。
				editLink.addEventListener("click", (event) => {
					event.stopPropagation();
				});
				nameRow.appendChild(editLink);

				// ×アイコンのアイコンボタン(box/index.astroの.icon-button規格=28px円形+枠線)。
				// 危険操作であることは常時--color-danger-strongの文字色で示す(B-2の判断を踏襲し
				// 確認ダイアログは追加しない。チームからの除外は個体そのものの削除ではなく、
				// いつでも選択バーから再度追加できる低リスクな操作のため)。
				const removeButton = document.createElement("button");
				removeButton.type = "button";
				removeButton.className = "btn-ghost slot-remove-btn";
				// 全画面共通方針で×のSVGを使う(box/index.astroの.icon-button.delete-buttonと
				// 同一のSVG文字列)。
				removeButton.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
				removeButton.title = "チームから外す";
				removeButton.setAttribute("aria-label", `${name}を${slot}番目の枠から外す`);
				removeButton.addEventListener("click", (event) => {
					event.stopPropagation();
					removeMemberFromSlot(slot);
				});

				wrap.append(watermarkEl, artEl, infoEl, removeButton);
				return wrap as unknown as HTMLElement;
			}

