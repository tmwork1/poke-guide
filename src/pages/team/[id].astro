	<script>
		// チーム編集: ポケモン選択バー(左)と6枠(中央)を描画し、自動保存する。
		// 自動保存のデバウンス方式は box/[id].astro と同じ(700ms・保存ボタンは作らない・
		// topbar-statusスロットで状態表示)。初期表示データ(SSR取得済みのチーム)は
		// #team-edit-layout の data-initial-team から読む(fetch往復を待たずに6枠を描ける)。
		import { loadImageIdMap, officialArtworkUrl, loadBaseStatsMap } from "../../lib/pokemon-master-data";
		import { loadItemSpriteMap, itemImageUrl, teraTypeIconUrl } from "../../lib/sprite-urls";
		import { resolveDexNo } from "../../lib/species-dex";
		import { selectionBlockReason, type SelectionCandidate, type SelectionBlockReason } from "../../lib/team-validation";
		import { STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";

		interface OwnedPokemonRecord {
			id: string;
			nickname: string | null;
			species_name: string;
			// A-8: SSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方が既にability_nameを含んでいる。新規フェッチ・新規計算は不要で、この型に
			// 足すだけで枠カード・選択バーの両方から読める。
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			move_names: string[];
			// UI改修依頼(チーム編集左パネル)「ステータスも表示」対応で追加。box/index.astroと同じ
			// 実数値計算(src/lib/stats.ts)に使う。level/nature/evs/ivsもSSR・GET /api/owned-pokemon
			// の両方に既に含まれているため、フロント側の型に足すだけでよい。
			level: number | null;
			nature: string | null;
			evs: number[];
			ivs: number[];
		}

		interface TeamMemberData {
			slot: number;
			owned_pokemon: OwnedPokemonRecord;
		}

		interface InitialTeam {
			id: string;
			name: string | null;
			memo: string | null;
			members: TeamMemberData[];
		}

		const layoutRoot = document.getElementById("team-edit-layout");
		if (layoutRoot) {
			const teamId = layoutRoot.dataset.teamId as string;
			const initialTeam: InitialTeam = JSON.parse(layoutRoot.dataset.initialTeam || "{}");

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) throw new Error(`要素が見つかりません: #${id}`);
				return found as T;
			}

			const nameInput = el<HTMLInputElement>("team-name");
			const memoInput = el<HTMLInputElement>("team-memo");
			const slotsRoot = el<HTMLElement>("team-slots");

			const searchInput = el<HTMLInputElement>("pokemon-search-input");
			const selectListRoot = el<HTMLElement>("pokemon-select-list");
			const selectLoadingMessage = el<HTMLElement>("select-loading-message");
			const selectErrorMessage = el<HTMLElement>("select-error-message");
			const selectEmptyState = el<HTMLElement>("select-empty-state");
			const selectNoMatchState = el<HTMLElement>("select-no-match-state");

			const statusEl = el<HTMLElement>("autosave-status");
			const statusTextEl = el<HTMLElement>("autosave-status-text");
			const retryButton = el<HTMLButtonElement>("retry-button");
			const deleteTeamButton = el<HTMLButtonElement>("delete-team-button");

			const previewEmptyEl = el<HTMLElement>("team-preview-empty");
			const previewContentEl = el<HTMLElement>("team-preview-content");

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定できるように
			// する」。dataTransferはドラッグ元(別ウィンドウ等)の互換性のため一応セットするが、
			// 同一ページ内のドラッグしか想定していないため、実際の受け渡しはこのモジュール内の
			// 変数(draggedPokemonId)で行う(dataTransfer.getData()はdragover中は読めない
			// ブラウザ実装が多く、dropまで値を保持する目的にも向かないため)。
			let draggedPokemonId: string | null = null;

			const imageIdMapPromise = loadImageIdMap();
			const itemSpriteMapPromise = loadItemSpriteMap();
			const baseStatsMapPromise = loadBaseStatsMap();

			const STAT_LABELS: Record<(typeof STAT_KEYS)[number], string> = {
				hp: "H", atk: "A", def: "B", spa: "C", spd: "D", spe: "S",
			};

			// UI改修依頼(チーム編集左パネル/右パネル)「ステータスも表示」。box/index.astroの
			// applyActualStatsと同じ式・同じフォールバック(level??50, iv??31, ev??0)。
			async function computeStats(p: OwnedPokemonRecord): Promise<{ key: string; label: string; value: number; mod: "up" | "down" | null }[] | null> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return null;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				return STAT_KEYS.map((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const statMod = key === "hp" ? null : mod.up === key ? "up" : mod.down === key ? "down" : null;
					return { key, label: STAT_LABELS[key], value, mod: statMod };
				});
			}

			// 6枠の現在状態(slot 1..6 -> 個体。無ければ空き)。
			const membersBySlot = new Map<number, OwnedPokemonRecord>();
			for (const m of initialTeam.members ?? []) {
				membersBySlot.set(m.slot, m.owned_pokemon);
			}

			// ボックスの全個体(選択バーの中身)。GET /api/owned-pokemon から取得する。
			let allPokemon: OwnedPokemonRecord[] = [];

			// nickname・species_nameのどちらも空の場合のフォールバック(/boxのdisplayNameと同じ語彙)。
			function displayName(p: OwnedPokemonRecord): string {
				if (p.nickname && p.nickname.trim() !== "") return p.nickname;
				if (p.species_name && p.species_name.trim() !== "") return p.species_name;
				return "(未設定)";
			}

			function candidateOf(p: OwnedPokemonRecord): SelectionCandidate {
				return {
					dexNo: resolveDexNo(p.species_name),
					itemName: p.item_name,
					ownedPokemonId: p.id,
				};
			}

			function currentCandidates(): SelectionCandidate[] {
				return Array.from(membersBySlot.values()).map(candidateOf);
			}

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップで設定」用。既に埋まっている
			// 枠へドロップして入れ替える(=その枠自身の在籍は重複扱いしない)場合に使う。
			function currentCandidatesExcludingSlot(slot: number): SelectionCandidate[] {
				return Array.from(membersBySlot.entries())
					.filter(([s]) => s !== slot)
					.map(([, p]) => candidateOf(p));
			}

			function firstEmptySlot(): number | null {
				for (let slot = 1; slot <= 6; slot += 1) {
					if (!membersBySlot.has(slot)) return slot;
				}
				return null;
			}

			const BLOCK_REASON_LABELS: Record<Exclude<SelectionBlockReason, null>, string> = {
				"already-in-team": "編成済み",
				"team-full": "6体編成済み",
				"duplicate-species": "種族が重複",
				"duplicate-item": "持ち物が重複",
			};

			// 公式絵。取得できない場合は頭文字の丸バッジにフォールバックする
			// (box/index.astroのapplyCardSpriteと同じ方式。loading="lazy"は付けない
			// ---display:noneの<img>は遅延読み込みの対象外としてonloadが発火しない)。
			async function applySprite(imgEl: HTMLImageElement, fallbackEl: HTMLElement, name: string): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = officialArtworkUrl(imageId);
			}

			// 持ち物アイコン(アイコン+名前、R-8)。アイコンが解決できない/読み込み失敗のときも
			// 名前のテキストは残す(box/index.astroの持ち物行と同じ考え方)。
			async function applyItemIcon(imgEl: HTMLImageElement, itemName: string): Promise<void> {
				const spritePath = (await itemSpriteMapPromise).get(itemName);
				if (!spritePath) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = itemImageUrl(spritePath);
			}

			// テラスタイプアイコン(アイコン+名前)。teraTypeIconUrlは同期解決(静的マップ)。
			function applyTeraIcon(imgEl: HTMLImageElement, teraName: string): void {
				const url = teraTypeIconUrl(teraName);
				if (!url) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = url;
			}

			// UI改修依頼(チーム編集左パネル)「1回クリックでポケモンの詳細を見れるように」。
			// 右パネル(1600px未満では非表示)にプレビューを描く。チーム編成そのものには影響しない
			// (membersBySlotを一切変更しない、見るだけの機能)。
			async function renderPreviewPanel(p: OwnedPokemonRecord): Promise<void> {
				previewEmptyEl.hidden = true;
				previewContentEl.hidden = false;
				previewContentEl.innerHTML = "";

				const artEl = document.createElement("div");
				artEl.className = "team-preview-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-preview-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-preview-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);
				previewContentEl.appendChild(artEl);

				const name = displayName(p);
				const nameEl = document.createElement("p");
				nameEl.className = "team-preview-name";
				nameEl.textContent = name;
				previewContentEl.appendChild(nameEl);
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("p");
					speciesEl.className = "team-preview-species";
					speciesEl.textContent = p.species_name;
					previewContentEl.appendChild(speciesEl);
				}

				const metaRow = document.createElement("div");
				metaRow.className = "team-preview-meta-row";
				const abilityEl = document.createElement("span");
				abilityEl.textContent = p.ability_name?.trim() || "特性未設定";
				metaRow.appendChild(abilityEl);
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraEl = document.createElement("span");
					const teraImg = document.createElement("img");
					teraImg.className = "team-preview-meta-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, teraType);
					const teraLabel = document.createElement("span");
					teraLabel.textContent = teraType;
					teraEl.append(teraImg, teraLabel);
					metaRow.appendChild(teraEl);
				}
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					const itemImg = document.createElement("img");
					itemImg.className = "team-preview-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				previewContentEl.appendChild(metaRow);

				const statGrid = document.createElement("div");
				statGrid.className = "team-preview-stat-grid";
				const stats = await computeStats(p);
				if (stats) {
					for (const s of stats) {
						const labelEl = document.createElement("span");
						labelEl.className = "team-preview-stat-label";
						labelEl.textContent = s.label + (s.mod === "up" ? "▲" : s.mod === "down" ? "▼" : "");
						if (s.mod) labelEl.dataset.mod = s.mod;
						const valueEl = document.createElement("span");
						valueEl.className = "team-preview-stat-value";
						valueEl.textContent = String(s.value);
						statGrid.append(labelEl, valueEl);
					}
					previewContentEl.appendChild(statGrid);
				}

				const moves = p.move_names.filter((m) => m && m.trim() !== "");
				if (moves.length > 0) {
					const movesEl = document.createElement("div");
					movesEl.className = "team-preview-moves";
					for (const move of moves) {
						const chip = document.createElement("span");
						chip.className = "team-preview-move-chip";
						chip.textContent = move;
						movesEl.appendChild(chip);
					}
					previewContentEl.appendChild(movesEl);
				}

				const editLink = document.createElement("a");
				editLink.className = "btn-ghost team-preview-edit-link";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.textContent = "個体を編集";
				previewContentEl.appendChild(editLink);
			}

			// UI改修依頼(チーム編集左パネル)「ダブルクリックとドラッグアンドドロップでチームに
			// 設定できるように」。クリック単体での追加(旧仕様)はプレビュー表示に譲り、実際の
			// 追加操作はダブルクリック/ドラッグ&ドロップに一本化する。targetSlotを指定した場合は
			// その枠へ(既に埋まっていれば入れ替え)、省略時は空き枠のうち最小番号に入れる
			// (旧仕様のfirstEmptySlotと同じ)。選択ルール(selectionBlockReason)は入れ替え先の枠
			// 自身の在籍を重複扱いしないよう、対象枠を除いた候補リストで判定する。
			function assignToSlot(p: OwnedPokemonRecord, targetSlot?: number): void {
				const slot = targetSlot ?? firstEmptySlot();
				if (slot == null) return;
				const candidates = currentCandidatesExcludingSlot(slot);
				const reason = selectionBlockReason(candidateOf(p), candidates);
				if (reason) return;
				membersBySlot.set(slot, p);
				renderSlots();
				renderSelectList();
				scheduleSave();
			}

			// --- 6枠の描画(基準3: 常に6枠) ---
			// A-1: 選択バーで個体をクリックすると常に「空き枠のうち最小番号」に入る
			// (選択ルールは受け入れ基準4で確定済み・変更不可)。4/6のように空き枠が複数
			// 同時にあるとき、以前は全ての空き枠が「＋ この枠に入れる」を表示し、
			// aria-labelも「{slot}番目の枠にポケモンを入れる」と個別の枠を特定していたが、
			// 実際にはどの空き枠を押しても最小番号にしか入らず、約束と実態が食い違っていた。
			// 表示側だけを実態に合わせる: isNextToFill(=firstEmptySlot()と一致)の1枠だけ
			// 実際に押せる<button>にし、それ以外は非アクションの<div>にする。
			function buildEmptySlotContent(slot: number, isNextToFill: boolean): HTMLElement {
				const number = document.createElement("span");
				number.className = "slot-empty-number";
				number.setAttribute("aria-hidden", "true");
				number.textContent = String(slot);

				if (isNextToFill) {
					const button = document.createElement("button");
					button.type = "button";
					button.className = "slot-empty-cta";
					button.setAttribute("aria-label", `${slot}番目の枠にポケモンを入れる`);
					const label = document.createElement("span");
					label.textContent = "＋ この枠に入れる";
					button.append(number, label);
					// 実際の追加操作は左の選択バーから行う(R-7)。このボタンは検索欄へ誘導するだけの
					// 補助動線(必須要件ではないが、6枠側からも選択バーに気付けるようにする)。
					button.addEventListener("click", () => {
						searchInput.focus();
						searchInput.scrollIntoView({ block: "nearest" });
					});
					return button;
				}

				const placeholder = document.createElement("div");
				placeholder.className = "slot-empty-cta";
				placeholder.setAttribute("aria-label", `${slot}番目の枠は空きです。選択すると若い番号から埋まります`);
				const label = document.createElement("span");
				label.textContent = "選択すると若い番号から埋まります";
				placeholder.append(number, label);
				return placeholder;
			}

			function buildFilledSlotContent(slot: number, p: OwnedPokemonRecord): HTMLElement {
				const wrap = document.createDocumentFragment();

				const numberEl = document.createElement("div");
				numberEl.className = "slot-number";
				numberEl.textContent = String(slot);

				const artEl = document.createElement("div");
				artEl.className = "slot-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "slot-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "slot-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const infoEl = document.createElement("div");
				infoEl.className = "slot-info";

				const nameRow = document.createElement("div");
				nameRow.className = "slot-name-row";
				const name = displayName(p);
				const nicknameEl = document.createElement("span");
				nicknameEl.className = "slot-nickname";
				nicknameEl.textContent = name;
				nameRow.appendChild(nicknameEl);
				// ニックネームと種族名が異なる場合のみ種族名を併記する(R-8)。
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("span");
					speciesEl.className = "slot-species";
					speciesEl.textContent = p.species_name;
					nameRow.appendChild(speciesEl);
				}
				infoEl.appendChild(nameRow);

				const metaRow = document.createElement("div");
				metaRow.className = "slot-meta-row";

				// A-8: 特性は既にSSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon
				// (OWNED_POKEMON_COLUMNS)の両方でability_nameとして届いている。
				// アイコンは付けない(特性の画像素材が他画面にも無いため)。
				const abilityName = p.ability_name?.trim() ?? "";
				const abilityItem = document.createElement("span");
				abilityItem.className = "slot-meta-item";
				const abilityLabel = document.createElement("span");
				// UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応:
				// box/index.astroの.card-ability-nameはラベル無しの特性名だけを出すため、
				// ここも「特性: 」の接頭辞を外し値だけにする(未設定の強調自体は残す)。
				if (abilityName) {
					abilityLabel.textContent = abilityName;
				} else {
					// A-6と同じ理由(「特性なし」もゲーム上存在しない状態)で未設定を明示する。
					abilityLabel.textContent = "特性未設定";
					abilityLabel.classList.add("slot-meta-unset");
				}
				abilityItem.appendChild(abilityLabel);
				metaRow.appendChild(abilityItem);

				// A-6: テラスタイプ未設定はjpoke側で第1タイプへ静かにフォールバックする
				// (vendor/jpoke/src/jpoke/model/pokemon.py:89)ため、行を消すと「まだ表示
				// されていないだけ」に見え、対戦に出せない未完成状態であることが伝わらない。
				// 常に行を出し、値が無ければdisplayNameと同じ「未設定」を明示する。
				// A-7: 「テラス」は口語短縮なので公式用語「テラスタイプ」に統一する。
				const teraType = p.tera_type?.trim() ?? "";
				const teraItem = document.createElement("span");
				teraItem.className = "slot-meta-item";
				const teraImg = document.createElement("img");
				teraImg.className = "slot-meta-icon";
				teraImg.alt = "";
				teraImg.style.display = "none";
				const teraLabel = document.createElement("span");
				if (teraType) {
					applyTeraIcon(teraImg, teraType);
					// UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応:
					// box/index.astroのアイコン+値のみの表記に揃え「テラスタイプ: 」の接頭辞を外す。
					teraLabel.textContent = teraType;
				} else {
					teraLabel.textContent = "テラスタイプ未設定";
					teraLabel.classList.add("slot-meta-unset");
				}
				teraItem.append(teraImg, teraLabel);
				metaRow.appendChild(teraItem);

				// 持ち物なし(null/空文字)は合法な対戦状態(G-3も対象外にしている)なので、
				// テラスタイプ・特性とは違い、これまでどおり行自体を出さない。
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					itemEl.className = "slot-meta-item";
					const itemImg = document.createElement("img");
					itemImg.className = "slot-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				// 特性・テラスタイプを常に出すようにしたため、metaRowは常に非空になる。
				infoEl.appendChild(metaRow);

				// A-6: 技0件も行ごと消さず「未設定」を明示する(技0件・テラス未設定の
				// ディンルーが「情報が少ないだけのカード」に見え、対戦に出せない未完成状態だと
				// 伝わらなかったため)。
				const moves = p.move_names.filter((m) => m && m.trim() !== "");
				const movesEl = document.createElement("div");
				movesEl.className = "slot-moves";
				if (moves.length > 0) {
					for (const move of moves) {
						const chip = document.createElement("span");
						chip.className = "slot-move-chip";
						chip.textContent = move;
						movesEl.appendChild(chip);
					}
				} else {
					const chip = document.createElement("span");
					chip.className = "slot-move-chip slot-move-chip-unset";
					chip.textContent = "未設定";
					movesEl.appendChild(chip);
				}
				infoEl.appendChild(movesEl);

				const actionsEl = document.createElement("div");
				actionsEl.className = "slot-actions";
				const editLink = document.createElement("a");
				editLink.className = "btn-ghost";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.textContent = "個体を編集";
				const removeButton = document.createElement("button");
				removeButton.type = "button";
				// B-2: 「個体を編集」(遷移・安全)と同一書式で隣接していたため、破壊操作である
				// ことが文字色だけでも分かるよう.slot-remove-btnを足す(CSSで--color-danger-strong
				// を適用。確認ダイアログは操作頻度から見て過剰と判断し追加しない)。
				removeButton.className = "btn-ghost slot-remove-btn";
				removeButton.textContent = "枠から外す";
				removeButton.setAttribute("aria-label", `${name}を${slot}番目の枠から外す`);
				removeButton.addEventListener("click", () => {
					membersBySlot.delete(slot);
					renderSlots();
					renderSelectList();
					scheduleSave();
				});
				actionsEl.append(editLink, removeButton);

				wrap.append(numberEl, artEl, infoEl, actionsEl);
				return wrap as unknown as HTMLElement;
			}

			function renderSlots(): void {
				slotsRoot.innerHTML = "";
				// A-1: 「押せる」空き枠は選択ルールが実際に埋める最小番号の1枠だけ。
				const nextEmptySlot = firstEmptySlot();
				for (let slot = 1; slot <= 6; slot += 1) {
					const card = document.createElement("article");
					card.className = "card card-team-slot";
					card.dataset.slot = String(slot);
					const p = membersBySlot.get(slot);
					if (p) {
						card.dataset.filled = "true";
						card.appendChild(buildFilledSlotContent(slot, p));
					} else {
						card.dataset.filled = "false";
						card.appendChild(buildEmptySlotContent(slot, slot === nextEmptySlot));
					}

					// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定」。
					// 空き枠・埋まっている枠のどちらにもドロップできる(埋まっている枠は入れ替え)。
					card.addEventListener("dragover", (event) => {
						if (!draggedPokemonId) return;
						event.preventDefault();
						card.classList.add("is-drop-target");
					});
					card.addEventListener("dragleave", () => {
						card.classList.remove("is-drop-target");
					});
					card.addEventListener("drop", (event) => {
						event.preventDefault();
						card.classList.remove("is-drop-target");
						const id = draggedPokemonId;
						draggedPokemonId = null;
						if (!id) return;
						const p = allPokemon.find((x) => x.id === id);
						if (!p) return;
						assignToSlot(p, slot);
					});
					slotsRoot.appendChild(card);
				}
			}

			// --- 選択バーの描画(R-7・R-10) ---
			function matchesSearch(p: OwnedPokemonRecord, term: string): boolean {
				if (!term) return true;
				const haystack = [p.nickname ?? "", p.species_name].join(" ").toLowerCase();
				return term
					.toLowerCase()
					.split(/\s+/)
					.filter((t) => t.length > 0)
					.every((token) => haystack.includes(token));
			}

			// UI改修依頼(チーム編集左パネル)により、行全体を1個の<button>にする旧構造から
			// 「プレビュー用のbutton」+「編集リンク(<a>)」を横に並べた<div>構造へ変更した
			// (<button>の中に<a>や別の<button>を入れることはHTML的に無効なため、編集リンクを
			// 追加するにはbuttonで丸ごと囲む方式をやめる必要があった)。
			// 操作の割り当て:
			//   - 1回クリック(mainButton) : 右パネルにプレビュー表示(チーム編成は変更しない)
			//   - ダブルクリック(mainButton): 空き枠のうち最小番号に追加(旧・単クリックの動作を踏襲)
			//   - ドラッグ&ドロップ(row全体): ドラッグ先の枠(空き/埋まり問わず)に設定
			//   - 「個体を編集」(editLink): /box/{id}へ遷移
			function buildSelectRow(p: OwnedPokemonRecord): HTMLElement {
				const row = document.createElement("div");
				row.className = "pokemon-select-row";
				row.draggable = true;

				const mainButton = document.createElement("button");
				mainButton.type = "button";
				mainButton.className = "select-row-main";

				const artEl = document.createElement("span");
				artEl.className = "select-row-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "select-row-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "select-row-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const bodyEl = document.createElement("span");
				bodyEl.className = "select-row-body";
				const name = displayName(p);
				const nameEl = document.createElement("span");
				nameEl.className = "select-row-name";
				nameEl.textContent = name;
				bodyEl.appendChild(nameEl);
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("span");
					speciesEl.className = "select-row-species";
					speciesEl.textContent = p.species_name;
					bodyEl.appendChild(speciesEl);
				}

				// UI改修依頼(チーム編集左パネル)「特性/アイテム/ステータスも表示」。
				const metaRow = document.createElement("span");
				metaRow.className = "select-row-meta-row";
				const abilityEl = document.createElement("span");
				abilityEl.className = "select-row-meta-item";
				abilityEl.textContent = p.ability_name?.trim() || "特性未設定";
				metaRow.appendChild(abilityEl);
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					itemEl.className = "select-row-meta-item";
					const itemImg = document.createElement("img");
					itemImg.className = "select-row-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				bodyEl.appendChild(metaRow);

				const statRow = document.createElement("span");
				statRow.className = "select-row-stat-row";
				void computeStats(p).then((stats) => {
					if (!stats) return;
					statRow.innerHTML = "";
					for (const s of stats) {
						const chip = document.createElement("span");
						chip.className = "select-row-stat-chip";
						if (s.mod) chip.dataset.mod = s.mod;
						chip.textContent = `${s.label}${s.value}`;
						statRow.appendChild(chip);
					}
				});
				bodyEl.appendChild(statRow);

				const reason = selectionBlockReason(candidateOf(p), currentCandidates());
				if (reason) {
					mainButton.disabled = true;
					const reasonEl = document.createElement("span");
					reasonEl.className = "select-row-reason";
					// A-3(a): 「編成済み」(already-in-team、正常)と禁止3種を色で書き分けるため、
					// data-reasonをCSSセレクタのフックにする(is:globalスタイル側で参照)。
					reasonEl.dataset.reason = reason;
					reasonEl.textContent = BLOCK_REASON_LABELS[reason];
					bodyEl.appendChild(reasonEl);
					mainButton.setAttribute("aria-label", `${name}(${BLOCK_REASON_LABELS[reason]}、選択できません)の詳細を見る`);
				} else {
					mainButton.setAttribute("aria-label", `${name}の詳細を見る(ダブルクリックで空き枠に追加)`);
					mainButton.addEventListener("dblclick", () => {
						assignToSlot(p);
					});
				}
				mainButton.addEventListener("click", () => {
					void renderPreviewPanel(p);
				});

				mainButton.append(artEl, bodyEl);
				row.appendChild(mainButton);

				const editLink = document.createElement("a");
				editLink.className = "btn-ghost select-row-edit-link";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.textContent = "編集";
				editLink.setAttribute("aria-label", `${name}を編集`);
				row.appendChild(editLink);

				row.addEventListener("dragstart", () => {
					draggedPokemonId = p.id;
					row.classList.add("is-dragging");
				});
				row.addEventListener("dragend", () => {
					draggedPokemonId = null;
					row.classList.remove("is-dragging");
				});

				return row;
			}

			function renderSelectList(): void {
				if (allPokemon.length === 0) {
					selectListRoot.innerHTML = "";
					selectEmptyState.hidden = false;
					selectNoMatchState.hidden = true;
					return;
				}
				selectEmptyState.hidden = true;

				const term = searchInput.value.trim();
				const filtered = allPokemon.filter((p) => matchesSearch(p, term));
				selectListRoot.innerHTML = "";
				if (filtered.length === 0) {
					selectNoMatchState.hidden = false;
					return;
				}
				selectNoMatchState.hidden = true;
				for (const p of filtered) {
					selectListRoot.appendChild(buildSelectRow(p));
				}
			}

			// --- 自動保存(box/[id].astroと同じデバウンス方式。保存ボタンは作らない) ---
			function buildPayload(): { name: string | null; memo: string | null; members: { slot: number; owned_pokemon_id: string }[] } {
				const members = Array.from(membersBySlot.entries())
					.sort((a, b) => a[0] - b[0])
					.map(([slot, p]) => ({ slot, owned_pokemon_id: p.id }));
				const name = nameInput.value.trim();
				const memo = memoInput.value.trim();
				return {
					name: name === "" ? null : name,
					memo: memo === "" ? null : memo,
					members,
				};
			}

			const DEBOUNCE_MS = 700;
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;
			let saving = false;
			let pendingRetry = false;

			async function saveNow(): Promise<void> {
				if (saving) {
					pendingRetry = true;
					return;
				}
				const payload = buildPayload();
				saving = true;
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "保存中...";
				retryButton.classList.remove("visible");

				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					if (!res.ok) {
						const body = (await res.json().catch(() => ({}))) as { error?: string };
						throw new Error(body.error ?? `保存に失敗しました (status=${res.status})`);
					}
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "保存済み";
				} catch (err) {
					console.error(err);
					statusEl.dataset.state = "error";
					statusTextEl.textContent = err instanceof Error ? err.message : "保存に失敗しました。";
					retryButton.classList.add("visible");
				} finally {
					saving = false;
					if (pendingRetry) {
						pendingRetry = false;
						void saveNow();
					}
				}
			}

			function scheduleSave(): void {
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "編集中...";
				retryButton.classList.remove("visible");
				if (debounceTimer) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					void saveNow();
				}, DEBOUNCE_MS);
			}

			retryButton.addEventListener("click", () => {
				void saveNow();
			});

			// UI改修依頼(チーム編集ヘッダー)「右端に削除ボタン追加」。box/[id].astroの
			// deleteButtonハンドラと同じ確認ダイアログ→DELETE→遷移のパターン。
			deleteTeamButton.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを削除します。よろしいですか?")) return;
					deleteTeamButton.disabled = true;
					try {
						const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
							method: "DELETE",
							credentials: "same-origin",
						});
						if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
						window.location.href = "/team";
					} catch (err) {
						console.error(err);
						window.alert("削除に失敗しました。時間をおいて再度お試しください。");
						deleteTeamButton.disabled = false;
					}
				})();
			});

			// A-2(実バグ): トップバーはSSR時点のpageTitleで固定され、#team-nameのinputイベントで
			// 追随する処理が存在しなかった(トップバーへの参照が本ファイルに0件だった)。
			// box/[id].astroのupdateHeaderIdentity()(:4239-4257)と同じ手法を移植する:
			// AppLayout.astroは編集禁止(全ページ共通)なので、トップバー側の要素はclass経由で
			// このページのscriptから直接更新する。
			const topbarTitleEl = document.querySelector<HTMLElement>(".app-topbar-title");
			function updateHeaderIdentity(): void {
				const name = nameInput.value.trim();
				if (topbarTitleEl) {
					topbarTitleEl.textContent = name || "無題のチーム";
				}
			}

			nameInput.addEventListener("input", () => {
				updateHeaderIdentity();
				scheduleSave();
			});
			memoInput.addEventListener("input", scheduleSave);
			searchInput.addEventListener("input", renderSelectList);

			// --- 初期化 ---
			// SSR取得済みのメンバーは fetch を待たずに即描画する(6枠が空でも一瞬も待たせない)。
			renderSlots();

			fetch("/api/owned-pokemon", { credentials: "same-origin" })
				.then(async (res) => {
					if (!res.ok) throw new Error(`個体一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemonRecord[] };
					allPokemon = body.data;
					selectLoadingMessage.hidden = true;
					renderSelectList();
				})
				.catch((err) => {
					console.error(err);
					selectLoadingMessage.hidden = true;
					selectErrorMessage.hidden = false;
				});
		}
	</script>
</AppLayout>
