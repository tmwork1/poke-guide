			justify-content: center;
			gap: var(--space-2);
			background: transparent;
			border: 0;
			/* global.cssの汎用button{ padding: 0.55em 1.1em }を打ち消す。<button>版だけ
			   このpaddingが残ると左インセットが付き、<div>版(空き枠の非アクション表示)と
			   番号のx座標がずれる(A-5の実測で発覚: button版のみx=665.7、div版はx=649)。 */
			padding: 0;
			color: var(--color-text-muted);
			font-weight: 600;
			font-size: var(--font-size-md);
			cursor: default;
