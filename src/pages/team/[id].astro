		/* --- チームポケモンのサジェスト(ユーザー要望、2026-08-02)。右パネルのニュートラル
		   状態に出す「おすすめのポケモンと型」ランキング。JS(renderSuggestions)が生成する
		   要素なので、このファイルの scoped <style> ではなくここ(is:global)に置く。
		   幅は右パネルの実効幅(実測 約300px)しかないため、ダメージカード(.team-damage-card)と
		   同じく1カラムの縦積みで組み、はみ出す文言は省略記号で畳む。 --- */
		.team-suggest {
			padding: var(--space-3);
		}
		.team-suggest-heading {
			font-size: var(--font-size-sm);
			font-weight: 600;
			margin: 0 0 var(--space-1);
		}
		.team-suggest-note {
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
			margin: 0 0 var(--space-3);
			line-height: 1.4;
		}
		.team-suggest-status {
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
			margin: 0;
		}
		.team-suggest-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}
		.team-suggest-card {
			display: grid;
			/* 順位 / 画像 / 本文 の3列。本文列は minmax(0, 1fr) にしないと
			   長い技名・持ち物名がグリッドを押し広げて横スクロールを起こす。 */
			grid-template-columns: auto 44px minmax(0, 1fr);
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
		}
		.team-suggest-rank {
			font-size: var(--font-size-xs);
			font-weight: 700;
			color: var(--color-text-muted);
			min-width: 1.2em;
			text-align: right;
		}
		.team-suggest-sprite {
			width: 44px;
			height: 44px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-suggest-sprite-img {
			max-width: 100%;
			max-height: 100%;
		}
		.team-suggest-sprite-fallback {
			display: none;
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--color-surface-alt);
			color: var(--color-text-muted);
			font-size: var(--font-size-xs);
			align-items: center;
			justify-content: center;
		}
		.team-suggest-body {
			min-width: 0;
		}
		.team-suggest-name {
			font-size: var(--font-size-sm);
			font-weight: 600;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* 右パネルの本文列は実測で約165pxしかなく、特性+持ち物+役割を1行に収めると
		   ほぼ必ず省略記号で切れる。省略すると「どの型か」という提案の中身そのものが
		   読めなくなるため、折り返して2行以上になることを許す(カードの高さは伸びる)。 */
		.team-suggest-build {
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.15em 0.25em;
			line-height: 1.35;
		}
		.team-suggest-item-icon {
			width: 14px;
			height: 14px;
			flex: none;
		}
		.team-suggest-role {
			flex: none;
			padding: 0 0.35em;
			border-radius: var(--radius-sm);
			background: var(--color-surface-alt);
		}
		/* 特性だけは型の識別子ではなく最頻値からの推定(migrations/018)。持ち物・役割と同じ
		   見た目だと確定情報に見えるため、点線の下線で「推定」であることを示す。 */
		.team-suggest-ability {
			text-decoration: underline dotted var(--color-border);
			text-underline-offset: 0.2em;
		}
		/* 根拠(「◯◯採用チームのN%が併用」)も同じ理由で折り返す。ここで切れると
		   割合の数字が消え、提案の説得力そのものが失われるため。 */
		.team-suggest-reason {
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
			line-height: 1.35;
			margin-top: 0.1em;
		}
		/* 持ち物がチーム内で重複する型(そのままでは編成できない)への注意書き。
		   候補自体は消さない ── 「持ち物を変えれば使える」という情報は残す価値があるため。 */
		.team-suggest-conflict {
			font-size: var(--font-size-xs);
			color: var(--color-risky-strong);
		}
		.team-suggest-action {
			grid-column: 1 / -1;
			justify-self: stretch;
			font-size: var(--font-size-xs);
			padding: var(--space-1) var(--space-2);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface-alt);
			color: var(--color-text);
			cursor: pointer;
		}
		.team-suggest-action:hover:not(:disabled) {
			border-color: var(--color-primary);
			color: var(--color-primary-strong);
		}
		.team-suggest-action:disabled {
			cursor: default;
			opacity: 0.6;
		}
	</style>

	<script>
		// チーム編集: ポケモン選択バー(左)と6枠(中央)を描画し、自動保存する。
		// 自動保存のデバウンス方式は box/[id].astro と同じ(700ms・保存ボタンは作らない・
		// topbar-statusスロットで状態表示)。初期表示データ(SSR取得済みのチーム)は
		// #team-edit-layout の data-initial-team から読む(fetch往復を待たずに6枠を描ける)。
		import { loadImageIdMap, officialArtworkUrl, loadBaseStatsMap, loadMoveDetailMap } from "../../lib/pokemon-master-data";
		// UI改修依頼(チーム編集左パネル、2026-08-02)「候補カードをボックス画面と共通化する」で
		// 技チップにタイプアイコンを追加するため、typeIconUrlを追加importする(box/index.astroの
		// applyMoveChipTypeIconsと同じ用途)。
		import { loadItemSpriteMap, itemIconUrl, teraTypeIconUrl, typeIconUrl } from "../../lib/sprite-urls";
		import { resolveDexNo } from "../../lib/species-dex";
		import { selectionBlockReason, type SelectionCandidate, type SelectionBlockReason } from "../../lib/team-validation";
		import { STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";
		// 🔴 UI改修依頼(チーム編集画面 右パネル、2026-08-01)「右パネルには登録されている
		// ダメージ計算の圧縮版を表示する」。表示ロジックは純粋関数として切り出してある
		// (renderPreviewPanel/buildDamageCard の実装コメント参照)。
		// 🔴 UI改修依頼(右パネル、2026-08-01)「11. テラスタルしていない条件の計算では
		// テラスタル画像を非表示にする」。summarizeOpponentNoteが返すteraType/abilityName等
		// (相手ビルド=OpponentNoteSummary)は「相手がテラスタルを持っているか」という静的な
		// ビルド属性で、「この計算条件で実際にテラスタルしたか」とは別物(damage-summary.tsの
		// NormalizedNoteAttackが持つattackerTerastallized/defenderTerastallizedが後者に当たる、
        // box/[id].astro側のsrc/lib/box-id/right-panel.tsが同じ区別を使っている)。
		// このファイルの担当範囲はteam/[id].astroのみでdamage-summary.ts自体は変更しない方針の
		// ため、既に純粋関数としてexportされているnormalizeNoteAttacks/validNoteAttacksを
		// このファイル側でも呼び、noteのfield生データから実際のterastallized有無を導出する
		// (buildDamageCard参照)。
		import {
			computeBuildStatCells,
			summarizeOpponentNote,
			normalizeNoteAttacks,
			validNoteAttacks,
			type MoveCategory,
			type OpponentNoteLike,
		} from "../../lib/damage-summary";

		interface OwnedPokemonRecord {
			id: string;
			nickname: string | null;
			species_name: string;
			// A-8: SSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方が既にability_nameを含んでいる。新規フェッチ・新規計算は不要で、この型に
			// 足すだけで枠カード・選択バーの両方から読める。
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01): 選択バーのレギュレーション絞り込みに使う。
			// SSR(lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方に regulation を追加済みなので、この型に足すだけで両経路から読める。
			regulation: string | null;
			move_names: string[];
			// UI改修依頼(チーム編集左パネル)「ステータスも表示」対応で追加。box/index.astroと同じ
			// 実数値計算(src/lib/stats.ts)に使う。level/nature/evs/ivsもSSR・GET /api/owned-pokemon
			// の両方に既に含まれているため、フロント側の型に足すだけでよい。
			level: number | null;
			nature: string | null;
			evs: number[];
			ivs: number[];
			// UI改修依頼(チーム編集左パネル)「ソート機能を追加する」の「登録順」用。SSR
			// (lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方に既にcreated_atを含んでいるため、この型に足すだけで読める(新規フェッチ不要)。
			created_at: string;
			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」用。GET
			// /api/owned-pokemonのレスポンスには含まれるが、SSR(lib/team.tsのTEAM_MEMBER_SELECT)
			// には含まれていない(このファイル単体の変更ではlib/team.tsを直せないため)。そのため
			// SSR直後のmembersBySlot初期値ではundefinedになりうる値としてoptionalにし、GET
			// /api/owned-pokemon完了後にallPokemonの同IDレコードで補う
			// (refreshCollectionOptOutToggle参照)。
			collection_opt_out_until?: string | null;
		}

		interface TeamMemberData {
			slot: number;
			owned_pokemon: OwnedPokemonRecord;
		}

		interface InitialTeam {
			id: string;
			name: string | null;
			memo: string | null;
			regulation: string | null;
			members: TeamMemberData[];
		}

		const layoutRoot = document.getElementById("team-edit-layout");
		if (layoutRoot) {
			const teamId = layoutRoot.dataset.teamId as string;
			const initialTeam: InitialTeam = JSON.parse(layoutRoot.dataset.initialTeam || "{}");

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) throw new Error(`要素が見つかりません: #${id}`);
				return found as T;
			}

			const nameInput = el<HTMLInputElement>("team-name");
			const memoInput = el<HTMLInputElement>("team-memo");
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)「個体編集と同様にレギュレーション指定機能」。
			const regulationSelect = el<HTMLSelectElement>("team-regulation");
			const regulationFilterWrap = el<HTMLElement>("regulation-filter-wrap");
			// UI改修依頼(チーム編集左パネル、2026-08-02)「トグルスイッチに変更する」に伴い
			// <button>から<input type="checkbox">へマークアップを変えたため、要素の型も
			// HTMLButtonElementからHTMLInputElementへ変える。
			const regulationFilterToggle = el<HTMLInputElement>("regulation-filter-toggle");
			const slotsRoot = el<HTMLElement>("team-slots");

			const searchInput = el<HTMLInputElement>("pokemon-search-input");
			const sortSelect = el<HTMLSelectElement>("pokemon-sort-select");
			const selectListRoot = el<HTMLElement>("pokemon-select-list");
			const selectLoadingMessage = el<HTMLElement>("select-loading-message");
			const selectErrorMessage = el<HTMLElement>("select-error-message");
			const selectEmptyState = el<HTMLElement>("select-empty-state");
			const selectNoMatchState = el<HTMLElement>("select-no-match-state");

			const statusEl = el<HTMLElement>("autosave-status");
			const statusTextEl = el<HTMLElement>("autosave-status-text");
			const retryButton = el<HTMLButtonElement>("retry-button");
			const deleteTeamButton = el<HTMLButtonElement>("delete-team-button");
			const collectionOptOutToggle = el<HTMLInputElement>("team-collection-opt-out-toggle");
			const collectionOptOutStatusEl = el<HTMLElement>("team-collection-opt-out-status");

			const previewEmptyEl = el<HTMLElement>("team-preview-empty");
			const previewContentEl = el<HTMLElement>("team-preview-content");
			// チームポケモンのサジェスト(ユーザー要望、2026-08-02)の描画先。
			const suggestEl = el<HTMLElement>("team-suggest");
			// UI改修依頼(チーム編集中央パネル、2026-08-02)カード外クリックでの選択解除判定に使う
			// (右パネル内のクリックは選択解除の対象外にする)。
			const previewPanelEl = el<HTMLElement>("team-preview-panel");

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定できるように
			// する」。dataTransferはドラッグ元(別ウィンドウ等)の互換性のため一応セットするが、
			// 同一ページ内のドラッグしか想定していないため、実際の受け渡しはこのモジュール内の
			// 変数(draggedPokemonId)で行う(dataTransfer.getData()はdragover中は読めない
			// ブラウザ実装が多く、dropまで値を保持する目的にも向かないため)。
			let draggedPokemonId: string | null = null;

			// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「10. チームメンバーどうしを
			// ドラッグアンドドロップで並べ替えできる機能を追加する」。候補ポケモンのドラッグ
			// (draggedPokemonId)とは別に、埋まっている枠自身をドラッグしたときの移動元slot番号を
			// 保持する専用変数(renderSlots参照)。
			let draggedMemberSlot: number | null = null;

			const imageIdMapPromise = loadImageIdMap();
			const itemSpriteMapPromise = loadItemSpriteMap();
			const baseStatsMapPromise = loadBaseStatsMap();

			const STAT_LABELS: Record<(typeof STAT_KEYS)[number], string> = {
				hp: "H", atk: "A", def: "B", spa: "C", spd: "D", spe: "S",
			};

			// UI改修依頼(チーム編集左パネル/右パネル)「ステータスも表示」。box/index.astroの
			// applyActualStatsと同じ式・同じフォールバック(level??50, iv??31, ev??0)。
			async function computeStats(p: OwnedPokemonRecord): Promise<{ key: string; label: string; value: number; mod: "up" | "down" | null }[] | null> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return null;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				return STAT_KEYS.map((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const statMod = key === "hp" ? null : mod.up === key ? "up" : mod.down === key ? "down" : null;
					return { key, label: STAT_LABELS[key], value, mod: statMod };
				});
			}

			// 6枠の現在状態(slot 1..6 -> 個体。無ければ空き)。
			const membersBySlot = new Map<number, OwnedPokemonRecord>();
			for (const m of initialTeam.members ?? []) {
				membersBySlot.set(m.slot, m.owned_pokemon);
			}

			// ボックスの全個体(選択バーの中身)。GET /api/owned-pokemon から取得する。
			let allPokemon: OwnedPokemonRecord[] = [];

			// nickname・species_nameのどちらも空の場合のフォールバック(/boxのdisplayNameと同じ語彙)。
			function displayName(p: OwnedPokemonRecord): string {
				if (p.nickname && p.nickname.trim() !== "") return p.nickname;
				if (p.species_name && p.species_name.trim() !== "") return p.species_name;
				return "(未設定)";
			}

			function candidateOf(p: OwnedPokemonRecord): SelectionCandidate {
				return {
					dexNo: resolveDexNo(p.species_name),
					itemName: p.item_name,
					ownedPokemonId: p.id,
				};
			}

			function currentCandidates(): SelectionCandidate[] {
				return Array.from(membersBySlot.values()).map(candidateOf);
			}

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップで設定」用。既に埋まっている
			// 枠へドロップして入れ替える(=その枠自身の在籍は重複扱いしない)場合に使う。
			function currentCandidatesExcludingSlot(slot: number): SelectionCandidate[] {
				return Array.from(membersBySlot.entries())
					.filter(([s]) => s !== slot)
					.map(([, p]) => candidateOf(p));
			}

			function firstEmptySlot(): number | null {
				for (let slot = 1; slot <= 6; slot += 1) {
					if (!membersBySlot.has(slot)) return slot;
				}
				return null;
			}

			const BLOCK_REASON_LABELS: Record<Exclude<SelectionBlockReason, null>, string> = {
				"already-in-team": "編成済み",
				"team-full": "6体編成済み",
				"duplicate-species": "種族が重複",
				"duplicate-item": "持ち物が重複",
			};

			// 公式絵。取得できない場合は頭文字の丸バッジにフォールバックする
			// (box/index.astroのapplyCardSpriteと同じ方式。loading="lazy"は付けない
			// ---display:noneの<img>は遅延読み込みの対象外としてonloadが発火しない)。
			async function applySprite(imgEl: HTMLImageElement, fallbackEl: HTMLElement, name: string): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = officialArtworkUrl(imageId);
			}

			// 持ち物アイコン(アイコン+名前、R-8)。アイコンが解決できない/読み込み失敗のときも
			// 名前のテキストは残す(box/index.astroの持ち物行と同じ考え方)。
			async function applyItemIcon(imgEl: HTMLImageElement, itemName: string): Promise<void> {
				const spritePath = (await itemSpriteMapPromise).get(itemName);
				if (!spritePath) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = itemIconUrl(spritePath);
			}

			// テラスタイプアイコン(アイコン+名前)。teraTypeIconUrlは同期解決(静的マップ)。
			function applyTeraIcon(imgEl: HTMLImageElement, teraName: string): void {
				const url = teraTypeIconUrl(teraName);
				if (!url) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = url;
			}

			// UI改修依頼(チーム編集左パネル、2026-08-02)「候補カードをボックス画面(/box)と
			// 共通化する」。技チップの前に置くタイプアイコン(box/index.astroの
			// applyMoveChipTypeIconsと同じ考え方)。技→タイプの解決はloadMoveDetailMapを使う
			// (このファイルは右パネルの技分類判定(moveCategoryOf)で既にloadMoveDetailMap()を
			// 呼んでおり、内部でキャッシュされる=fetchが増えるわけではない)。
			async function applySelectMoveChipTypeIcons(
				entries: { iconEl: HTMLImageElement; moveName: string }[],
			): Promise<void> {
				if (entries.length === 0) return;
				const detailMap = await loadMoveDetailMap();
				for (const { iconEl, moveName } of entries) {
					const type = detailMap.get(moveName)?.type;
					if (!type) continue;
					const url = typeIconUrl(type);
					if (!url) continue;
					iconEl.onerror = () => {
						iconEl.hidden = true;
					};
					iconEl.onload = () => {
						iconEl.hidden = false;
					};
					iconEl.src = url;
				}
			}

			// 🔴 UI改修依頼(チーム編集画面 右パネル、2026-08-01)「現在の表示は中央のカードと内容が
			// 被っている。右パネルには登録されているダメージ計算の圧縮版を表示する」。
			//
			// 変更前は選んだ個体そのもの(スプライト・特性・持ち物・テラス・実数値・技)を並べていたが、
			// これは中央の6枠カード(renderSlots)および左パネルの選択行(renderSelectList)と同じ
			// 情報だった。代わりに、その個体に登録済みの対戦相手メモ(opponent_notes)を
			// ワイヤーフレーム docs/ui_proposal/ダメージカード_圧縮.png の構成
			// (アイコン | 種族名 / 攻撃or防御 / 特性 / H-A-B-C-D-S ‖ 技名 / 詳細設定 / 累計計算結果)
			// で一覧する。個体編集画面(/box/[id])のダメージカードを折りたたんだ状態と同じ内容で、
			// 表示ロジックは src/lib/damage-summary.ts(純粋関数・ユニットテスト済み)に置いてある。
			//
			// ⚠️ この画面では Pyodide(計算エンジン)を読み込まない。保存済みの client_result
			// スナップショットをそのまま読むだけで、再計算はしない(個体編集画面がエンジン初期化前に
			// スナップショットを即座に表示するのと同じ経路)。右パネルを見るためだけに数MBの
			// wheel を落とさせないため。
			//
			// 右パネルは1600px未満では非表示。チーム編成そのものには影響しない(membersBySlotを
			// 一切変更しない、見るだけの機能)。
			const notesCache = new Map<string, OpponentNoteLike[] | "error">();

			async function fetchOpponentNotes(ownedPokemonId: string): Promise<OpponentNoteLike[] | "error"> {
				const cached = notesCache.get(ownedPokemonId);
				if (cached) return cached;
				try {
					const res = await fetch(`/api/opponent-notes?owned_pokemon_id=${encodeURIComponent(ownedPokemonId)}`, {
						headers: { Accept: "application/json" },
					});
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const json = (await res.json()) as { data?: OpponentNoteLike[] };
					const data = Array.isArray(json.data) ? json.data : [];
					notesCache.set(ownedPokemonId, data);
					return data;
				} catch {
					// 失敗はキャッシュしない(次に選び直したときに再試行できるようにする)。
					return "error";
				}
			}

			// 技の分類(物理/特殊/変化)。詳細設定チップの「攻撃+1」/「特攻+1」の出し分けと、
			// 変化技のみのメモの判定に使う。マスタデータの解決前(初回fetch中)はnullが返り、
			// その場合は damage-summary.ts 側が物理扱いの表記にフォールバックする。
			let moveDetailMapCache: Map<string, { category: MoveCategory }> | null = null;
			void loadMoveDetailMap().then((m) => {
				moveDetailMapCache = m;
			});
			function moveCategoryOf(name: string): MoveCategory | null {
				return moveDetailMapCache?.get(name.trim())?.category ?? null;
			}

			function buildDamageCard(note: OpponentNoteLike, baseStats: Map<string, number[]>): HTMLElement {
				const summary = summarizeOpponentNote(note, moveCategoryOf);
				// 🔴 UI改修依頼(右パネル、2026-08-01)「11. テラスタルしていない条件の計算では
				// テラスタル画像を非表示にする」。summary.teraTypeは相手ビルドが持つテラスタイプ
				// (静的な設定値)であり、この計算条件下で実際にテラスタルしたかどうかは別に
				// field.attacks[].attackerTerastallized/defenderTerastallizedを見る必要がある。
				// summary.direction(この個体=owned_pokemonから見た向き)が "attack" なら相手は
				// 防御側なのでdefenderTerastallizedを、"defense"なら相手は攻撃側なので
				// attackerTerastallizedを見る(box/[id].astro側のsrc/lib/box-id/right-panel.tsと
				// 同じ側の対応付け)。複数技(複数列)のうちどれか1つでもテラスタルしていれば
				// 「このカードの計算でテラスタルした」とみなす。
				const noteAttacks = validNoteAttacks(normalizeNoteAttacks(note.field as never, note.move_name));
				const opponentTerastallized = noteAttacks.some((a) =>
					summary.direction === "attack" ? a.defenderTerastallized : a.attackerTerastallized,
				);
				const card = document.createElement("li");
				card.className = "team-damage-card";

				// --- 上段: アイコン + 種族名 / 攻撃or防御 / 特性 / 実数値 ---
				const buildRow = document.createElement("div");
				buildRow.className = "team-damage-build";

				const spriteBox = document.createElement("div");
				spriteBox.className = "team-damage-sprite";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-damage-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-damage-sprite-fallback";
				spriteBox.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, summary.opponentName);
				buildRow.appendChild(spriteBox);

				const buildText = document.createElement("div");
				buildText.className = "team-damage-build-text";

				const metaRow = document.createElement("div");
				metaRow.className = "team-damage-meta-row";
				const directionEl = document.createElement("span");
				directionEl.className = "team-damage-direction";
				directionEl.textContent = summary.directionLabel;
				directionEl.dataset.role = summary.direction;
				const nameEl = document.createElement("span");
				nameEl.className = "team-damage-name";
				nameEl.textContent = summary.opponentName;
				nameEl.title = summary.opponentName;
				metaRow.append(directionEl, nameEl);

				const subRow = document.createElement("div");
				subRow.className = "team-damage-sub-row";
				const abilityEl = document.createElement("span");
				abilityEl.className = "team-damage-ability";
				abilityEl.textContent = summary.abilityName;
				abilityEl.title = summary.abilityName;
				subRow.appendChild(abilityEl);
				// UI改修依頼(右パネル、2026-08-02)「ポケモン画像そばの持ち物アイコンを廃止し、
				// 特性の右側に持ち物アイコン+名前を表示する」。applyItemIconは既存のものを再利用する。
				if (summary.itemName) {
					const itemInfo = document.createElement("span");
					itemInfo.className = "team-damage-item-info";
					const itemImg = document.createElement("img");
					itemImg.className = "team-damage-item-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, summary.itemName);
					const itemNameEl = document.createElement("span");
					itemNameEl.className = "team-damage-item-name";
					itemNameEl.textContent = summary.itemName;
					itemInfo.append(itemImg, itemNameEl);
					itemInfo.title = summary.itemName;
					subRow.appendChild(itemInfo);
				}
				// 共通指示(2026-08-01)「テラスタイプがない場合は"未設定"などと表示せず非表示にする」。
				// 🔴 UI改修依頼(右パネル、2026-08-01)「11. テラスタルしていない条件の計算では
				// テラスタル画像を非表示にする」。相手がテラスタイプを持っていても、この条件で
				// 実際にテラスタルしていなければ(opponentTerastallized === false)表示しない。
				if (summary.teraType && opponentTerastallized) {
					const teraInfo = document.createElement("span");
					teraInfo.className = "team-damage-tera-info";
					const teraImg = document.createElement("img");
					teraImg.className = "team-damage-tera-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, summary.teraType);
					const teraName = document.createElement("span");
					teraName.textContent = summary.teraType;
					teraInfo.append(teraImg, teraName);
					subRow.appendChild(teraInfo);
				}
				buildText.append(metaRow, subRow);

				const cells = computeBuildStatCells(
					note.opponent_build as never,
					baseStats.get((note.opponent_build as { name?: string } | null)?.name?.trim() ?? ""),
				);
				if (cells) {
					// ラベル行 + 実数値行の6列表(個体編集画面の折りたたみ表示と同じ形)。
					const statsEl = document.createElement("div");
					statsEl.className = "team-damage-stats";
					const labelLine = document.createElement("div");
					labelLine.className = "team-damage-stats-line";
					const valueLine = document.createElement("div");
					valueLine.className = "team-damage-stats-line";
					for (const cell of cells) {
						const labelEl = document.createElement("span");
						labelEl.className = "team-damage-stat-key";
						labelEl.textContent = cell.label;
						if (cell.mod) labelEl.dataset.mod = cell.mod;
						labelLine.appendChild(labelEl);
						const valueEl = document.createElement("span");
						valueEl.className = "team-damage-stat-value tnum";
						valueEl.textContent = String(cell.value);
						valueLine.appendChild(valueEl);
					}
					statsEl.append(labelLine, valueLine);
					buildText.appendChild(statsEl);
				}
				buildRow.appendChild(buildText);
				card.appendChild(buildRow);

				// --- 下段: 技名 / 詳細設定 / 累計計算結果 ---
				const moveLineEl = document.createElement("p");
				moveLineEl.className = "team-damage-move-line";
				moveLineEl.textContent = summary.moveLine;
				moveLineEl.title = summary.moveLine;
				card.appendChild(moveLineEl);

				if (summary.conditionLine) {
					const detailEl = document.createElement("p");
					detailEl.className = "team-damage-detail-line";
					detailEl.textContent = summary.conditionLine;
					detailEl.title = summary.conditionLine;
					card.appendChild(detailEl);
				}

				const resultEl = document.createElement("p");
				resultEl.className = "severity-bar team-damage-result";
				resultEl.dataset.severity = summary.verdict.severity;
				if (summary.verdict.label) {
					const verdictEl = document.createElement("span");
					verdictEl.className = "team-damage-result-verdict";
					verdictEl.textContent = summary.verdict.label;
					resultEl.appendChild(verdictEl);
				}
				if (summary.verdict.detail) {
					const detailEl = document.createElement("span");
					detailEl.className = "team-damage-result-detail";
					detailEl.textContent = summary.verdict.detail;
					resultEl.appendChild(detailEl);
				}
				if (summary.verdict.note) {
					// 一撃必殺技・はきだす・変化技のみ等の断り書き。数値だけを見て過信しないための注記。
					const noteEl = document.createElement("span");
					noteEl.className = "team-damage-result-note";
					noteEl.textContent = summary.verdict.note;
					resultEl.appendChild(noteEl);
				}
				card.appendChild(resultEl);

				if (summary.memo) {
					const memoEl = document.createElement("p");
					memoEl.className = "team-damage-memo";
					memoEl.textContent = summary.memo;
					memoEl.title = summary.memo;
					card.appendChild(memoEl);
				}
				return card;
			}

			// 「今どの個体を表示中か」。非同期のfetchが戻ってきたときに、その間にユーザーが
			// 別の個体を選んでいたら描画を捨てる(取り違え防止)。
			let previewRequestId = 0;

			async function renderPreviewPanel(p: OwnedPokemonRecord): Promise<void> {
				const requestId = (previewRequestId += 1);
				previewEmptyEl.hidden = true;
				previewContentEl.hidden = false;
				previewContentEl.innerHTML = "";
				// 個体を選んでいる間はニュートラル状態ではないのでサジェストを隠す
				// (closePreviewPanel が戻す)。中身は消さない ── 選択解除のたびに
				// 再fetchせず、そのまま出し直せるようにするため。
				suggestEl.hidden = true;

				const headingEl = document.createElement("p");
				headingEl.className = "team-damage-owner";
				headingEl.textContent = `${displayName(p)} のダメージ計算`;
				headingEl.title = headingEl.textContent;
				previewContentEl.appendChild(headingEl);

				const statusEl = document.createElement("p");
				statusEl.className = "team-damage-status";
				statusEl.textContent = "読み込み中…";
				previewContentEl.appendChild(statusEl);

				// UI改修依頼(右パネル、2026-08-02)「最下部の"個体を編集"ボタンを削除する」。
				// 旧・editLinkの参照先が無くなったため、listElはinsertBeforeではなくappendChildで足す。
				const [notes, baseStats] = await Promise.all([fetchOpponentNotes(p.id), baseStatsMapPromise]);
				if (requestId !== previewRequestId) return; // 別の個体が選び直された

				if (notes === "error") {
					statusEl.textContent = "ダメージ計算を読み込めませんでした。";
					return;
				}
				if (notes.length === 0) {
					statusEl.textContent = "ダメージ計算は登録されていません。";
					return;
				}
				statusEl.remove();
				const listEl = document.createElement("ul");
				listEl.className = "team-damage-list";
				for (const note of notes) listEl.appendChild(buildDamageCard(note, baseStats));
				previewContentEl.appendChild(listEl);
			}

			// UI改修依頼(チーム編集中央パネル、2026-08-02)「カード外をクリックしてもダメージ計算
			// 表示が残り続けるバグを直す」。原因調査: 「カード外クリックでハイライトを解除する」
			// document click リスナー(下部のdocument.addEventListener("click", ...)参照)は
			// .card-team-slot から is-selected クラスを外すだけで、右パネルの中身
			// (previewContentEl、renderPreviewPanelがinnerHTMLで書き込む)には一切触れていな
			// かった。そのためカードの選択ハイライトは消えても、直前に選んだ個体のダメージ計算が
			// 右パネルに描画されたまま残っていた。previewRequestIdを進めて
			// renderPreviewPanel側の非同期処理(await後のrequestId !== previewRequestIdチェック、
			// 上のrenderPreviewPanel参照)も無効化しつつ、previewContentElを空にして隠す
			// (previewEmptyElは元々常時hidden・無テキストの設計(上のマークアップのコメント参照)
			// のため、ここで表示に戻す必要はない)。
			function closePreviewPanel(): void {
				previewRequestId += 1;
				previewContentEl.hidden = true;
				previewContentEl.innerHTML = "";
				// ニュートラル状態に戻ったのでサジェストを出し直す(下の renderSuggestions 参照)。
				suggestEl.hidden = false;
			}

			// =================================================================================
			// チームポケモンのサジェスト(ユーザー要望、2026-08-02)
			// 「現在のチームメンバーを参照して、残りの枠に入れるとよいポケモンを提案する」。
			// 集計は GET /api/team-suggestions(スコアリングは src/lib/team-suggest.ts、
			// 共起の集計は migrations/016 のSQL関数)。ここは表示と操作だけを担う。
			// =================================================================================

			interface TeamSuggestion {
				speciesName: string;
				dexNo: number | null;
				abilityName: string | null;
				itemName: string | null;
				role: "physical_attacker" | "special_attacker" | "bulky" | null;
				archetypeShare: number | null;
				archetypeTeams: number | null;
				usageTeams: number;
				totalTeams: number;
				itemConflict: boolean;
				reason: {
					seedSpeciesName: string;
					coTeams: number;
					seedTeams: number;
					ratio: number;
					lift: number;
				} | null;
			}

			const ROLE_LABELS: Record<string, string> = {
				physical_attacker: "物理",
				special_attacker: "特殊",
				bulky: "耐久",
			};

			// 「今どの編成に対する結果か」。メンバーを続けて操作したときに、古いリクエストの
			// 応答が後から届いて上書きするのを防ぐ(renderPreviewPanel の previewRequestId と同じ方式)。
			let suggestRequestId = 0;
			// 直近で問い合わせた編成。同じ編成での再描画では fetch を撃たない
			// (枠の入れ替えなど、メンバー集合が変わらない操作でも scheduleSuggestions は呼ばれるため)。
			let lastSuggestKey: string | null = null;
			let suggestTimer: number | undefined;

			function setSuggestStatus(message: string): void {
				suggestEl.innerHTML = "";
				const p = document.createElement("p");
				p.className = "team-suggest-status";
				p.textContent = message;
				suggestEl.appendChild(p);
			}

			// 提案された型に一致する手持ち個体を探す。種族が一致し、かつチームに入れられる
			// (selectionBlockReason が null)個体だけが対象。特性・持ち物まで一致するものを
			// 優先し、無ければ種族だけ一致する個体を返す ── 「型は違うが同じポケモンなら持っている」
			// 場合に、作り直しではなく手持ちを入れる導線を出せるようにするため。
			function findOwnedMatch(suggestion: TeamSuggestion): OwnedPokemonRecord | null {
				const candidates = currentCandidates();
				const usable = allPokemon.filter(
					(p) => p.species_name === suggestion.speciesName && selectionBlockReason(candidateOf(p), candidates) === null,
				);
				if (usable.length === 0) return null;
				const exact = usable.find(
					(p) =>
						(p.ability_name ?? "") === (suggestion.abilityName ?? "") &&
						(p.item_name ?? "") === (suggestion.itemName ?? ""),
				);
				return exact ?? usable[0];
			}

			// 「この型で個体を作る」: box/index.astro の createEmptyPokemon と同じ POST 経路で、
			// 空の個体ではなく提案された型(種族・特性・持ち物)を埋めた個体を作り、そのまま
			// 編集画面へ送る。努力値・技・性格は提案の識別キーに含まれない(型は
			// 種族・特性・持ち物・role の4つで決まる、migrations/015)ため空のままにする。
			async function createPokemonFromSuggestion(suggestion: TeamSuggestion, button: HTMLButtonElement): Promise<void> {
				button.disabled = true;
				const originalLabel = button.textContent;
				button.textContent = "登録中...";
				try {
					const res = await fetch("/api/owned-pokemon", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							nickname: "",
							species_name: suggestion.speciesName,
							level: null,
							nature: "",
							ability_name: suggestion.abilityName ?? "",
							item_name: suggestion.itemName ?? "",
							tera_type: "",
							regulation: regulationSelect.value || "",
							evs: [0, 0, 0, 0, 0, 0],
							ivs: [31, 31, 31, 31, 31, 31],
							move_names: [],
							memo: "",
							tags: [],
							is_pinned: false,
						}),
					});
					const body = (await res.json().catch(() => ({}))) as { data?: { id: string }; error?: string };
					if (!res.ok || !body.data) throw new Error(body.error ?? `登録に失敗しました (status=${res.status})`);
					window.location.href = `/box/${encodeURIComponent(body.data.id)}`;
				} catch (err) {
					console.error(err);
					button.disabled = false;
					button.textContent = originalLabel;
					window.alert("個体の登録に失敗しました。時間をおいて再度お試しください。");
				}
			}

			function buildSuggestionCard(suggestion: TeamSuggestion, rank: number): HTMLElement {
				const card = document.createElement("li");
				card.className = "team-suggest-card";

				const rankEl = document.createElement("span");
				rankEl.className = "team-suggest-rank";
				rankEl.textContent = String(rank);
				card.appendChild(rankEl);

				const spriteEl = document.createElement("span");
				spriteEl.className = "team-suggest-sprite";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-suggest-sprite-img";
				spriteImg.alt = "";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-suggest-sprite-fallback";
				spriteEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, suggestion.speciesName);
				card.appendChild(spriteEl);

				const body = document.createElement("div");
				body.className = "team-suggest-body";

				const nameEl = document.createElement("div");
				nameEl.className = "team-suggest-name";
				nameEl.textContent = suggestion.speciesName;
				nameEl.title = suggestion.speciesName;
				body.appendChild(nameEl);

				// 型(持ち物・役割)と、その型で最も多い特性。持ち物が構築データに無い種族では
				// 型が判明しない(API が null を返す)ので、その場合は採用率だけを出す。
				const buildEl = document.createElement("div");
				buildEl.className = "team-suggest-build";
				if (suggestion.abilityName || suggestion.itemName) {
					if (suggestion.abilityName) {
						// 特性は型の識別子ではなく最頻値(migrations/018)。「この型なら普通はこの特性」
						// という推定なので、確定情報である持ち物・役割と区別できるよう印を付ける。
						const abilityEl = document.createElement("span");
						abilityEl.className = "team-suggest-ability";
						abilityEl.textContent = suggestion.abilityName;
						abilityEl.title = "この型で最も多い特性";
						buildEl.appendChild(abilityEl);
					}
					if (suggestion.itemName) {
						const itemIcon = document.createElement("img");
						itemIcon.className = "team-suggest-item-icon";
						itemIcon.alt = "";
						void applyItemIcon(itemIcon, suggestion.itemName);
						const itemEl = document.createElement("span");
						itemEl.textContent = suggestion.itemName;
						buildEl.append(itemIcon, itemEl);
					}
					if (suggestion.role) {
						const roleEl = document.createElement("span");
						roleEl.className = "team-suggest-role";
						roleEl.textContent = ROLE_LABELS[suggestion.role] ?? suggestion.role;
						buildEl.appendChild(roleEl);
					}
					buildEl.title = [
						suggestion.abilityName ? `${suggestion.abilityName}(この型で最も多い特性)` : null,
						suggestion.itemName,
						suggestion.role ? ROLE_LABELS[suggestion.role] : null,
					]
						.filter(Boolean)
						.join(" / ");
				} else {
					buildEl.textContent = "型のデータなし";
				}
				body.appendChild(buildEl);

				// 根拠。共起ベースなら「◯◯採用チームの N%」、チームが空なら採用率。
				const reasonEl = document.createElement("div");
				reasonEl.className = "team-suggest-reason";
				if (suggestion.reason) {
					const percent = Math.round(suggestion.reason.ratio * 100);
					reasonEl.textContent = `${suggestion.reason.seedSpeciesName}採用チームの${percent}%が併用`;
					reasonEl.title = `共起 ${suggestion.reason.coTeams}/${suggestion.reason.seedTeams}チーム・lift ${suggestion.reason.lift.toFixed(2)}`;
				} else {
					const percent = Math.round((suggestion.usageTeams / Math.max(suggestion.totalTeams, 1)) * 100);
					reasonEl.textContent = `上位チームの${percent}%が採用`;
					reasonEl.title = `${suggestion.usageTeams}/${suggestion.totalTeams}チーム`;
				}
				body.appendChild(reasonEl);

				if (suggestion.itemConflict && suggestion.itemName) {
					const conflictEl = document.createElement("div");
					conflictEl.className = "team-suggest-conflict";
					conflictEl.textContent = `${suggestion.itemName}が重複`;
					body.appendChild(conflictEl);
				}

				card.appendChild(body);

				// 操作: 手持ちにあれば枠へ入れる、無ければその型で新規登録する。
				const owned = findOwnedMatch(suggestion);
				const action = document.createElement("button");
				action.type = "button";
				action.className = "team-suggest-action";
				if (owned) {
					const label = owned.nickname?.trim() || owned.species_name;
					action.textContent = `手持ちの${label}を入れる`;
					action.title = action.textContent;
					action.disabled = firstEmptySlot() == null;
					action.addEventListener("click", () => {
						assignToSlot(owned);
					});
				} else {
					action.textContent = "この型で個体を作る";
					action.addEventListener("click", () => {
						void createPokemonFromSuggestion(suggestion, action);
					});
				}
				card.appendChild(action);

				return card;
			}

			// 直近の応答。個体一覧(allPokemon)が後から届いたときに「手持ちにあるか」の
			// 判定をやり直して再描画するために保持する(APIは叩き直さない)。
			let lastSuggestResponse: { suggestions: TeamSuggestion[]; basis: string } | null = null;

			function renderSuggestions(suggestions: TeamSuggestion[], basis: string): void {
				lastSuggestResponse = { suggestions, basis };
				suggestEl.innerHTML = "";

				const heading = document.createElement("p");
				heading.className = "team-suggest-heading";
				heading.textContent = "おすすめのポケモン";
				suggestEl.appendChild(heading);

				const note = document.createElement("p");
				note.className = "team-suggest-note";
				// basis はAPI(src/pages/api/team-suggestions.ts)が返す集計の根拠。
				// usage_fallback は「編成中のポケモンが上位入賞チームのデータに1体も
				// 登場せず、共起を計算できなかった」ケースで、共起順のつもりで読まれると
				// 誤解を招くため専用の文言にする。
				note.textContent =
					basis === "usage"
						? "上位入賞チームでの採用率順です。1体入れると、相性の良いポケモンに切り替わります。"
						: basis === "usage_fallback"
							? "編成中のポケモンは上位入賞チームのデータに無いため、環境全体の採用率順で表示しています。"
							: "上位入賞チームで、今の編成とよく一緒に使われている型の順です。";
				suggestEl.appendChild(note);

				if (suggestions.length === 0) {
					const empty = document.createElement("p");
					empty.className = "team-suggest-status";
					empty.textContent = "この編成に対する提案は見つかりませんでした。";
					suggestEl.appendChild(empty);
					return;
				}

				const list = document.createElement("ul");
				list.className = "team-suggest-list";
				suggestions.forEach((s, index) => list.appendChild(buildSuggestionCard(s, index + 1)));
				suggestEl.appendChild(list);
			}

			async function loadSuggestions(): Promise<void> {
				const memberIds = currentMemberIds();
				const key = memberIds.slice().sort().join(",");
				if (key === lastSuggestKey) return;
				lastSuggestKey = key;

				const requestId = (suggestRequestId += 1);
				setSuggestStatus("おすすめを計算中…");
				try {
					const query = memberIds.length > 0 ? `?member_ids=${encodeURIComponent(memberIds.join(","))}` : "";
					const res = await fetch(`/api/team-suggestions${query}`, { credentials: "same-origin" });
					if (!res.ok) throw new Error(`サジェストの取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: TeamSuggestion[]; meta?: { basis?: string } };
					if (requestId !== suggestRequestId) return; // 編成が変わった。この結果は捨てる
					renderSuggestions(body.data ?? [], body.meta?.basis ?? "cooccurrence");
				} catch (err) {
					console.error(err);
					if (requestId !== suggestRequestId) return;
					// 次に編成が変わったときに再試行できるよう、失敗した編成は記憶しない。
					lastSuggestKey = null;
					setSuggestStatus("おすすめを取得できませんでした。");
				}
			}

			// 編成の変更に追随する。自動保存(scheduleSave)と同じ700msのデバウンスにして、
			// 6枠を続けて操作したときに毎回APIを叩かないようにする。
			function scheduleSuggestions(): void {
				window.clearTimeout(suggestTimer);
				suggestTimer = window.setTimeout(() => {
					void loadSuggestions();
				}, 700);
			}

			// UI改修依頼(チーム編集左パネル)「ダブルクリックとドラッグアンドドロップでチームに
			// 設定できるように」。クリック単体での追加(旧仕様)はプレビュー表示に譲り、実際の
			// 追加操作はダブルクリック/ドラッグ&ドロップに一本化する。targetSlotを指定した場合は
			// その枠へ(既に埋まっていれば入れ替え)、省略時は空き枠のうち最小番号に入れる
			// (旧仕様のfirstEmptySlotと同じ)。選択ルール(selectionBlockReason)は入れ替え先の枠
			// 自身の在籍を重複扱いしないよう、対象枠を除いた候補リストで判定する。
			function assignToSlot(p: OwnedPokemonRecord, targetSlot?: number): void {
				const slot = targetSlot ?? firstEmptySlot();
				if (slot == null) return;
				const candidates = currentCandidatesExcludingSlot(slot);
				const reason = selectionBlockReason(candidateOf(p), candidates);
				if (reason) return;
				membersBySlot.set(slot, p);
				renderSlots();
				renderSelectList();
				scheduleSave();
				refreshCollectionOptOutToggle();
				// 編成が変わったのでサジェストを取り直す(2026-08-02)。
				scheduleSuggestions();
			}

			// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「10. チームメンバーどうしを
			// ドラッグアンドドロップで並べ替えできる機能を追加する」。assignToSlotは候補ポケモン用の
			// 重複チェック(selectionBlockReason)を含むため、既に編成済みの2枠を入れ替える
			// (在籍総数は変わらない)操作には不適切(移動先に既にいる個体を「重複」と誤検知しうる)。
			// membersBySlotの中身を直接swapするだけの専用関数にする。片方が空きでもよい(=移動)。
			function swapMembersBetweenSlots(fromSlot: number, toSlot: number): void {
				const fromMember = membersBySlot.get(fromSlot);
				const toMember = membersBySlot.get(toSlot);
				if (toMember) membersBySlot.set(fromSlot, toMember);
				else membersBySlot.delete(fromSlot);
				if (fromMember) membersBySlot.set(toSlot, fromMember);
				else membersBySlot.delete(toSlot);
				renderSlots();
				renderSelectList();
				scheduleSave();
			}

			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」。現在のチームメンバー
			// (owned_pokemon)のIDだけを返す(重複はteam-validationの選択ルールで既に防がれている
			// ため考慮不要)。
			function currentMemberIds(): string[] {
				return Array.from(membersBySlot.values()).map((p) => p.id);
			}

			// collection_opt_out_until(null/過去=提供中、未来=拒否中)から「提供中かどうか」を
			// 判定する。box/[id].astroのformatOptOutRemaining(フロントマター側)と同じ判定式。
			function isProviding(p: OwnedPokemonRecord): boolean {
				if (!p.collection_opt_out_until) return true;
				return new Date(p.collection_opt_out_until).getTime() <= Date.now();
			}

			// トグルの表示(checked/disabled)を現在のチームメンバーの実際の状態から再計算する。
			// メンバーが1人もいなければ対象が無いためdisabled。allPokemon(GET /api/owned-pokemon、
			// 下部の初期化処理で取得)が届く前はSSR由来のmembersBySlotの値(collection_opt_out_until
			// を持たない)しか無いため、その場合は「全員提供中」を既定値として扱う(DBの既定値
			// =NULL=提供中と一致するため、fetch完了までの一瞬だけ生じる楽観値。fetch完了後に
			// このcronがもう一度呼ばれ正確な値に補正される→fetchハンドラ参照)。
			// 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-01)「非公開」トグルへの改称に伴い、
			// checkedの向きを反転する: 「メンバー全員が提供中」のときだけfalse(=非公開ではない)、
			// 1人でも拒否中(非公開)ならtrueにする(旧: 全員提供中のときtrue)。DBを読む式
			// (isProviding)自体は変えていない、checkedへの反映だけを反転させている。
			function refreshCollectionOptOutToggle(): void {
				const ids = currentMemberIds();
				if (ids.length === 0) {
					collectionOptOutToggle.checked = false;
					collectionOptOutToggle.disabled = true;
					syncCollectionOptOutTitle();
					return;
				}
				collectionOptOutToggle.disabled = false;
				const allProviding = Array.from(membersBySlot.values()).every((p) => {
					const fresh = allPokemon.find((x) => x.id === p.id);
					return isProviding(fresh ?? p);
				});
				collectionOptOutToggle.checked = !allProviding;
				syncCollectionOptOutTitle();
			}

			// UI改修依頼(チーム編集ヘッダー、2026-08-02)個体編集画面(/box/[id])と共通化:
			// ホバーテキストはON/OFFで文言を変えず常に固定文字列「30日間有効」にする。
			// メンバー0人時(disabled)のtitleはSSR側の固定文言のまま変えない(<AppLayout>の
			// topbar-actionsスロット、上のフロントマター参照)。
			const collectionOptOutLabel = document.querySelector<HTMLLabelElement>(".collection-opt-out-toggle");
			function syncCollectionOptOutTitle(): void {
				if (!collectionOptOutLabel || collectionOptOutToggle.disabled) return;
				collectionOptOutLabel.title = "30日間有効";
			}

			// --- 6枠の描画(基準3: 常に6枠) ---
			// A-1: 選択バーで個体をクリックすると常に「空き枠のうち最小番号」に入る
			// (選択ルールは受け入れ基準4で確定済み・変更不可)。
			// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「3. ドラッグアンドドロップで
			// チームに追加する機能を追加し、"この枠にいれる"ボタンを廃止する」。旧来は
			// isNextToFill(=firstEmptySlot()と一致)の1枠だけを実際に押せる<button>にし、
			// 「＋ この枠に入れる」で検索欄へフォーカスする補助動線を提供していたが、この依頼に
			// よりボタン自体を廃止する。候補→枠のドラッグ&ドロップは既に実装済み(row.draggable /
			// dragstart・dragend、枠側のdragover/dragleave/drop、assignToSlot呼び出し。
			// renderSlots参照)で変更不要なため、全ての空き枠を同じ非アクションの<div>にし、
			// D&Dで追加できることが伝わる文言にする。
			function buildEmptySlotContent(slot: number): HTMLElement {
				const wrap = document.createDocumentFragment();

				// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「6. 番号(1~6)の丸枠を削除し、
				// 大きく太い斜め文字を左上にうすく表示する(ポケモン未設定のカードも共通)」。
				const watermark = document.createElement("span");
				watermark.className = "slot-watermark-number";
				watermark.setAttribute("aria-hidden", "true");
				watermark.textContent = String(slot);

				const placeholder = document.createElement("div");
				placeholder.className = "slot-empty-cta";
				placeholder.setAttribute("aria-label", `${slot}番目の枠は空きです。左の一覧からドラッグ&ドロップすると追加できます`);
				const label = document.createElement("span");
				label.textContent = "ドラッグして追加";
				placeholder.appendChild(label);

				wrap.append(watermark, placeholder);
				return wrap as unknown as HTMLElement;
			}

			// UI改修依頼(チーム編集中央パネル)「ダブルクリックまたは削除ボタンで、その個体を
			// チームから削除できるようにする」。旧・removeButtonのクリックハンドラをここへ切り出し、
			// カード自体のdblclickハンドラ(renderSlots参照)と共有する(挙動は変えていない:
			// membersBySlotから外す→再描画→自動保存)。
			function removeMemberFromSlot(slot: number): void {
				membersBySlot.delete(slot);
				renderSlots();
				renderSelectList();
				scheduleSave();
				refreshCollectionOptOutToggle();
				// 編成が変わったのでサジェストを取り直す(2026-08-02)。
				scheduleSuggestions();
			}

			function buildFilledSlotContent(slot: number, p: OwnedPokemonRecord): HTMLElement {
				const wrap = document.createDocumentFragment();

				// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「6. 番号(1~6)の丸枠を削除し、
				// 大きく太い斜め文字を左上にうすく表示する」。空き枠(buildEmptySlotContent)と
				// 同じクラス(.slot-watermark-number)を使い、同じ位置・同じスタイルにする
				// (状態の違いはCSS側のopacity濃淡だけで表現、data-filled属性で出し分ける)。
				const watermarkEl = document.createElement("span");
				watermarkEl.className = "slot-watermark-number";
				watermarkEl.setAttribute("aria-hidden", "true");
				watermarkEl.textContent = String(slot);

				const artEl = document.createElement("div");
				artEl.className = "slot-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "slot-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "slot-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const infoEl = document.createElement("div");
				infoEl.className = "slot-info";

				// UI改修依頼(チーム編集中央パネル、2026-08-02)「ニックネーム/種族名を中央表示に
				// し、その右隣にテラスタルアイコンと編集ボタンを置く。テラスタルはアイコンのみ」。
				// nameRowは横並びflex(CSS参照)で、NN→テラスアイコン→編集ボタンの順に並べ、
				// 全体をカード幅の中で中央寄せする(旧来の3列グリッド+nameCenterラッパーは廃止)。
				// 種族名(R-8のspeciesEl)は表示しなくなったため、この画面では生成しない。
				const nameRow = document.createElement("div");
				nameRow.className = "slot-name-row";
				const name = displayName(p);

				const nicknameEl = document.createElement("span");
				nicknameEl.className = "slot-nickname";
				nicknameEl.textContent = name;
				nameRow.appendChild(nicknameEl);

				// 🔴 UI改修依頼(共通、2026-08-01)「テラスタイプが未設定の場合、"未設定"などと
				// 表示せず要素ごと非表示にする」。値が無いときはteraItem自体を生成しない
				// (pitfalls.mdの「DOMは残す」方針は要素の削除を指示されたケースには当たらない)。
				// A-7: 「テラス」は口語短縮なので公式用語「テラスタイプ」に統一する(この方針自体は維持)。
				// UI改修依頼(チーム編集中央パネル、2026-08-02)「テラスタルはアイコンのみ表示し、
				// "ほのお"等のタイプ名テキストは表示しない」。テキストの<span>(旧teraLabel)は
				// 生成せず、アイコンだけのバッジにする。テラスタイプ名はtitle/aria-labelに
				// 残し、スクリーンリーダー・ホバー双方でアクセス可能にする。
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraItem = document.createElement("span");
					teraItem.className = "slot-meta-item";
					teraItem.title = `テラスタイプ: ${teraType}`;
					teraItem.setAttribute("aria-label", `テラスタイプ: ${teraType}`);
					const teraImg = document.createElement("img");
					teraImg.className = "slot-meta-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, teraType);
					teraItem.appendChild(teraImg);
					nameRow.appendChild(teraItem);
				}
				infoEl.appendChild(nameRow);

				// UI改修依頼(チーム編集中央パネル、2026-08-02)「ボックス画面と同様に、特性と
				// アイテムを同じ段に配置する」。box/index.astroの.card-item-row(grid 2列)/
				// .card-item-row-cell(flex中央寄せ)と同じ作りに揃える(CSS参照、metaRowは
				// 特性・アイテムの2項目のみになる。テラスタイプは上のnameRowへ移した)。
				const metaRow = document.createElement("div");
				metaRow.className = "slot-meta-row";

				// A-8: 特性は既にSSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon
				// (OWNED_POKEMON_COLUMNS)の両方でability_nameとして届いている。
				// アイコンは付けない(特性の画像素材が他画面にも無いため)。
				const abilityCell = document.createElement("div");
				abilityCell.className = "slot-meta-cell";
				const abilityName = p.ability_name?.trim() ?? "";
				const abilityLabel = document.createElement("span");
				// UI改修依頼(チーム編集中央パネル、2026-08-02)「カードサイズを正方形のまま
				// 小さくする」に伴う実測修正: 幅が230pxに縮んだ結果、特性/持ち物のラベルに
				// overflow制御が無かったため長い文字列が単語の途中で2行に折り返ってしまう
				// (実測: メガリザードンXの持ち物名が「リザードナイ」「トX」のように割れた)。
				// nicknameEl(.slot-nickname)と同じ1行ellipsis制御をslot-meta-textとして
				// 共通化し、ability/itemの両ラベルに適用する(下のitemLabel参照)。
				abilityLabel.className = "slot-meta-text";
				// UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応:
				// box/index.astroの.card-ability-nameはラベル無しの特性名だけを出すため、
				// ここも「特性: 」の接頭辞を外し値だけにする(未設定の強調自体は残す)。
				if (abilityName) {
					abilityLabel.textContent = abilityName;
				} else {
					// A-6と同じ理由(「特性なし」もゲーム上存在しない状態)で未設定を明示する。
					abilityLabel.textContent = "特性未設定";
					abilityLabel.classList.add("slot-meta-unset");
				}
				abilityCell.appendChild(abilityLabel);
				metaRow.appendChild(abilityCell);

				// 持ち物なし(null/空文字)は合法な対戦状態(G-3も対象外にしている)ため、
				// セル自体は常に出し、中身(アイコン+名前)だけ値がある場合に足す
				// (box/index.astroのcard-item-row-itemと同じく、セルの有無で2列グリッドが
				// 崩れないようにする)。
				const itemCell = document.createElement("div");
				itemCell.className = "slot-meta-cell";
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemImg = document.createElement("img");
					itemImg.className = "slot-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					// UI改修依頼(チーム編集中央パネル、2026-08-02): 上のabilityLabelと同じ理由で
					// slot-meta-textを適用し、長い持ち物名が単語の途中で折り返るのを防ぐ。
					itemLabel.className = "slot-meta-text";
					itemLabel.textContent = itemName;
					itemCell.append(itemImg, itemLabel);
				}
				metaRow.appendChild(itemCell);
				infoEl.appendChild(metaRow);

				// UI改修依頼(チーム編集中央パネル、2026-08-02)「実数値をラベル行+数値行の2段に
				// 分ける」。右パネルのbuildDamageCard内.team-damage-stats/
				// .team-damage-stats-lineと同じ考え方(ラベル行+実数値行の6列表)を適用する
				// (computeStatsは選択バー側で既に使っている実数値計算をそのまま再利用)。
				const statsEl = document.createElement("div");
				statsEl.className = "slot-stats";
				void computeStats(p).then((stats) => {
					if (!stats) return;
					statsEl.innerHTML = "";
					const labelLine = document.createElement("div");
					labelLine.className = "slot-stats-line";
					const valueLine = document.createElement("div");
					valueLine.className = "slot-stats-line";
					for (const s of stats) {
						const labelEl = document.createElement("span");
						labelEl.className = "slot-stat-key";
						labelEl.textContent = s.mod === "up" ? `${s.label}▲` : s.mod === "down" ? `${s.label}▼` : s.label;
						if (s.mod) labelEl.dataset.mod = s.mod;
						labelLine.appendChild(labelEl);
						const valueEl = document.createElement("span");
						valueEl.className = "slot-stat-value tnum";
						valueEl.textContent = String(s.value);
						valueLine.appendChild(valueEl);
					}
					statsEl.append(labelLine, valueLine);
				});
				infoEl.appendChild(statsEl);

				// A-6: 技0件も行ごと消さず「未設定」を明示する(技0件・テラス未設定の
				// ディンルーが「情報が少ないだけのカード」に見え、対戦に出せない未完成状態だと
				// 伝わらなかったため)。
				const moves = p.move_names.filter((m) => m && m.trim() !== "");
				const movesEl = document.createElement("div");
				movesEl.className = "slot-moves";
				if (moves.length > 0) {
					for (const move of moves) {
						const chip = document.createElement("span");
						chip.className = "slot-move-chip";
						chip.textContent = move;
						movesEl.appendChild(chip);
					}
				} else {
					const chip = document.createElement("span");
					chip.className = "slot-move-chip slot-move-chip-unset";
					chip.textContent = "未設定";
					movesEl.appendChild(chip);
				}
				infoEl.appendChild(movesEl);

				// UI改修依頼(チーム編集中央パネル、2026-08-02)「編集ボタンを名前段の右端に配置
				// する」→ 同日の追加依頼「テラスタルアイコンと編集ボタンを並べて配置する」により、
				// nameRow(横並びflex、CSS参照)の末尾にテラスアイコンと並べて置く。削除ボタンは
				// 変更なし(カード(wrap経由でcard-team-slot直下)の右上端へ絶対配置のまま、CSS側は
				// .team-slots .slot-remove-btn参照)。
				const editLink = document.createElement("a");
				editLink.className = "btn-ghost slot-edit-link";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.title = "個体を編集";
				editLink.setAttribute("aria-label", `${name}を編集`);
				editLink.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>';
				// カード自体にclick(プレビュー)/dblclick(削除)/dragstart(並べ替え)を付けたため
				// (renderSlots参照)、このリンクへのクリックがバブリングして意図せずプレビュー
				// 描画を誘発しないよう止める(遷移自体には影響しない)。
				editLink.addEventListener("click", (event) => {
					event.stopPropagation();
				});
				nameRow.appendChild(editLink);

				// UI改修依頼(チーム編集中央パネル)「ダブルクリックまたは削除ボタンで、その個体を
				// チームから削除できるようにする」。×アイコンのアイコンボタン
				// (box/index.astroの.icon-button規格=28px円形+枠線)。危険操作であることは常時
				// --color-danger-strongの文字色で示す(B-2の判断を踏襲し確認ダイアログは追加しない。
				// チームからの除外は個体そのものの削除ではなく、いつでも選択バーから再度追加できる
				// 低リスクな操作のため)。
				const removeButton = document.createElement("button");
				removeButton.type = "button";
				removeButton.className = "btn-ghost slot-remove-btn";
				// UI改修依頼(2026-08-02): 削除アイコンをゴミ箱の絵文字/SVGから×のSVGへ統一する
				// (全画面共通方針。box/index.astroの.icon-button.delete-buttonと同一のSVG文字列)。
				removeButton.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
				removeButton.title = "チームから外す";
				removeButton.setAttribute("aria-label", `${name}を${slot}番目の枠から外す`);
				removeButton.addEventListener("click", (event) => {
					event.stopPropagation();
					removeMemberFromSlot(slot);
				});

				wrap.append(watermarkEl, artEl, infoEl, removeButton);
				return wrap as unknown as HTMLElement;
			}

			function renderSlots(): void {
				slotsRoot.innerHTML = "";
				for (let slot = 1; slot <= 6; slot += 1) {
					const card = document.createElement("article");
					card.className = "card card-team-slot";
					card.dataset.slot = String(slot);
					const p = membersBySlot.get(slot);
					if (p) {
						card.dataset.filled = "true";
						card.appendChild(buildFilledSlotContent(slot, p));
						// UI改修依頼(チーム編集中央パネル)
						// 「7. ダブルクリックまたは削除ボタンで、その個体をチームから削除できる」
						// 「8. シングルクリックで、右パネルにその個体の詳細を表示する」。
						// 左パネルの選択行(mainButton)と全く同じ操作割り当て(1回クリック=プレビュー、
						// ダブルクリック=変更操作)をカード全体に適用する。削除ボタン自身のクリックは
						// stopPropagation済みなので、ここでの2重発火(プレビュー→即削除)は起きない。
						card.addEventListener("click", () => {
							void renderPreviewPanel(p);
							// UI改修依頼(チーム編集中央パネル、2026-08-02)「カードをクリックしたら
							// 選択中であることが分かるハイライトを表示し、カード外クリックで解除する」。
							// 他のカードから外し、このカードだけに付ける(document側の解除リスナーは
							// 下部の初期化ブロック参照)。
							for (const other of slotsRoot.querySelectorAll(".card-team-slot")) {
								other.classList.remove("is-selected");
							}
							card.classList.add("is-selected");
						});
						card.addEventListener("dblclick", () => {
							removeMemberFromSlot(slot);
						});
						// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「10. チームメンバーどうしを
						// ドラッグアンドドロップで並べ替えできる機能を追加する」。候補→枠のD&D
						// (draggedPokemonId)とは別の変数(draggedMemberSlot)にドラッグ元のslot番号を
						// 保持する。埋まっている枠だけdraggableにする(空き枠には動かす対象が無い)。
						card.draggable = true;
						card.addEventListener("dragstart", () => {
							draggedMemberSlot = slot;
							card.classList.add("is-dragging");
						});
						card.addEventListener("dragend", () => {
							draggedMemberSlot = null;
							card.classList.remove("is-dragging");
						});
					} else {
						card.dataset.filled = "false";
						card.appendChild(buildEmptySlotContent(slot));
					}

					// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定」。
					// 空き枠・埋まっている枠のどちらにもドロップできる(埋まっている枠は入れ替え)。
					// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「10. メンバーどうしの並べ替え」。
					// 候補ポケモン(draggedPokemonId)からのドロップと、メンバー間移動
					// (draggedMemberSlot)からのドロップを同じdragover/drop内で分岐させる。
					card.addEventListener("dragover", (event) => {
						if (!draggedPokemonId && draggedMemberSlot == null) return;
						if (draggedMemberSlot === slot) return; // 自分自身へのドロップは無意味
						event.preventDefault();
						card.classList.add("is-drop-target");
					});
					card.addEventListener("dragleave", () => {
						card.classList.remove("is-drop-target");
					});
					card.addEventListener("drop", (event) => {
						event.preventDefault();
						card.classList.remove("is-drop-target");
						if (draggedMemberSlot != null) {
							const fromSlot = draggedMemberSlot;
							draggedMemberSlot = null;
							if (fromSlot !== slot) swapMembersBetweenSlots(fromSlot, slot);
							return;
						}
						const id = draggedPokemonId;
						draggedPokemonId = null;
						if (!id) return;
						const p = allPokemon.find((x) => x.id === id);
						if (!p) return;
						assignToSlot(p, slot);
					});
					slotsRoot.appendChild(card);
				}
			}

			// UI改修依頼(チーム編集中央パネル、2026-08-02)「カード外クリックでハイライトを
			// 解除する」。src/lib/box-id/damage-calc.tsのダメージカード選択解除
			// (document全体のクリックを監視し、対象カード群にも右パネルにも含まれなければ
			// 解除する)と同じ考え方。右パネル(#team-preview-panel)はプレビュー内の操作を
			// 選択解除の対象外にするため、containsチェックの対象に含める。
			// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-02)「カード外をクリックしてもダメージ
			// 計算表示が残り続けるバグを直す」。従来はis-selectedクラスを外すだけで右パネルの
			// 中身(previewContentEl)には触れていなかった(上のclosePreviewPanelのコメント参照)。
			// 選択解除と同時にclosePreviewPanel()を呼び、右パネルを閉じる。
			document.addEventListener("click", (event) => {
				const target = event.target as Node;
				if (previewPanelEl.contains(target)) return;
				if (Array.from(slotsRoot.querySelectorAll(".card-team-slot")).some((card) => card.contains(target))) return;
				for (const card of slotsRoot.querySelectorAll(".card-team-slot")) {
					card.classList.remove("is-selected");
				}
				closePreviewPanel();
			});

			// --- 選択バーの描画(R-7・R-10) ---
			function matchesSearch(p: OwnedPokemonRecord, term: string): boolean {
				if (!term) return true;
				const haystack = [p.nickname ?? "", p.species_name].join(" ").toLowerCase();
				return term
					.toLowerCase()
					.split(/\s+/)
					.filter((t) => t.length > 0)
					.every((token) => haystack.includes(token));
			}

			// UI改修依頼(チーム編集左パネル)「チームに含まれる個体を(左パネルの一覧から)
			// 非表示にする」。以前は「編成済み」(already-in-team、選択ルールの3禁止理由とは別扱い)
			// としてグレーアウト表示していたが、この依頼により一覧そのものから除外する。
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)+ ユーザー確認「絞り込みトグルを付ける」。
			// チームにレギュレーションが指定されていて、かつトグルがONのときだけ、
			// 「そのレギュレーションで使える個体」(= 一致 or 個体側が未指定)に絞る。
			let regulationFilterOn = true;

			function currentTeamRegulation(): string | null {
				const value = regulationSelect.value.trim();
				return value === "" ? null : value;
			}

			function matchesTeamRegulation(p: OwnedPokemonRecord): boolean {
				const teamRegulation = currentTeamRegulation();
				if (teamRegulation === null || !regulationFilterOn) return true;
				return !p.regulation || p.regulation === teamRegulation;
			}

			// チーム側が未指定のときは絞る基準が無いのでトグル自体を出さない
			// (出しても押した瞬間に何も変わらず、機能していないように見えるため)。
			// ラベルには現在のレギュレーション名を入れて、何で絞っているかを一目で分かるようにする。
			function syncRegulationFilterToggle(): void {
				const teamRegulation = currentTeamRegulation();
				regulationFilterWrap.hidden = teamRegulation === null;
				const label = document.getElementById("regulation-filter-toggle-label");
				// UI改修依頼(チーム編集左パネル、2026-08-02)「"M-B"の後に半角スペースを入れる」。
				// レギュレーション名は動的なので、組み立てているここに半角スペースを足す
				// (`${teamRegulation}のみ` → `${teamRegulation} のみ`)。
				if (label) label.textContent = teamRegulation ? `${teamRegulation} のみ` : "レギュレーション一致のみ";
				// UI改修依頼(チーム編集左パネル、2026-08-02)「トグルスイッチに変更する」に伴い、
				// data-active/aria-pressed(旧<button>の押下状態表現)からcheckbox本来のchecked
				// プロパティへ置き換える(ネイティブに状態を持つため追加のaria属性は不要)。
				regulationFilterToggle.checked = regulationFilterOn;
			}

			// UI改修依頼(チーム編集中央パネル、2026-08-01)「"レギュレーション"ラベルを削除する。
			// 他のUIと同様にplaceholderの色を薄くする」。LeftPanel.astro(個体編集)の
			// syncRegulationPlaceholderと同じ考え方: <select>には:placeholder-shownが無いため、
			// 値が空のときだけdata-empty="true"を付け外しする(CSSは上のscoped<style>参照)。
			function syncRegulationPlaceholder(): void {
				if (currentTeamRegulation() === null) regulationSelect.dataset.empty = "true";
				else delete regulationSelect.dataset.empty;
			}

			function isCurrentMember(id: string): boolean {
				for (const p of membersBySlot.values()) {
					if (p.id === id) return true;
				}
				return false;
			}

			// UI改修依頼(チーム編集左パネル)「ソート機能を追加する」。box/index.astroのsortPokemon
			// と同じ考え方(選択中の並べ替え基準で毎回ソートし直す)。基準は3つ:
			//   - 登録順(既定): created_at昇順(古い=先に登録した個体を先頭に。box/index.astroの
			//     「最終更新順」は降順=新しい順だったが、「登録順」は文字通り登録した順序を素直に
			//     表す方が自然だと判断し昇順にした)
			//   - 名前順: displayName(ニックネーム優先、無ければ種族名)のja collate
			//   - 種族名順: species_nameのja collate
			function sortPokemon(list: OwnedPokemonRecord[]): OwnedPokemonRecord[] {
				const sort = sortSelect.value;
				return [...list].sort((a, b) => {
					if (sort === "name") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "species_name") {
						return a.species_name.localeCompare(b.species_name, "ja");
					}
					return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
				});
			}

			// UI改修依頼(チーム編集左パネル)「個体編集ボタンを削除する」により、旧・編集リンク
			// (<a>「編集」、/box/{id}への遷移)は撤去した。以前はrow全体を1個の<button>にできず、
			// 「プレビュー用のbutton」+「編集リンク」を横に並べた<div>構造にしていたが、編集リンクが
			// 無くなった今もこの<div>ラップ構造自体は変えていない(ドラッグ&ドロップのdraggable属性を
			// row側に持たせる都合上、rowとmainButtonを分けておく設計は引き続き必要なため)。
			// 操作の割り当て:
			//   - 1回クリック(mainButton) : 右パネルにプレビュー表示(チーム編成は変更しない)
			//   - ダブルクリック(mainButton): 空き枠のうち最小番号に追加(旧・単クリックの動作を踏襲)
			//   - ドラッグ&ドロップ(row全体): ドラッグ先の枠(空き/埋まり問わず)に設定
			function buildSelectRow(p: OwnedPokemonRecord): HTMLElement {
				const row = document.createElement("div");
				row.className = "pokemon-select-row";
				row.draggable = true;

				const mainButton = document.createElement("button");
				mainButton.type = "button";
				mainButton.className = "select-row-main";

				// UI改修依頼(チーム編集左パネル、2026-08-02)「候補カードをボックス画面(/box)の
				// カードと共通化する」。box/index.astroの.card-pokemon(スプライト→カード名
				// (中央揃え)→テラスタイプ→特性/持ち物→技2列)と同じ縦積み構成に組み替える。
				// box側のCSS(<style is:global>)は/boxでしか読み込まれないため、値はこのページの
				// is:globalスタイルへ複製する(box/index.astro・global.cssは編集しない)。
				// お気に入り(.pin-toggle)・削除ボタンはこのパネルの用途(チームに追加する候補を
				// 選ぶピッカー)には不要なため持ち込まない。ダブルクリック/D&Dでの追加・編集リンクの
				// 既存動作(下のmainButton/rowのイベントリスナー)は変更しない。
				const artEl = document.createElement("span");
				artEl.className = "select-row-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "select-row-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "select-row-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const bodyEl = document.createElement("span");
				bodyEl.className = "select-row-body";
				const name = displayName(p);

				// カード名(中央揃え)+テラスタイプ。box/index.astroの.card-name-rowと同じく
				// 同じ行にテラスバッジを並べる。未設定のときは要素自体を作らない(中央パネルの
				// buildFilledSlotContentと同じ判断: 値が存在しない状態なのでDOM自体を省く)。
				const nameRow = document.createElement("span");
				nameRow.className = "select-row-name-row";
				const nameEl = document.createElement("span");
				nameEl.className = "select-row-name";
				nameEl.textContent = name;
				nameRow.appendChild(nameEl);
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraBadge = document.createElement("span");
					teraBadge.className = "select-row-tera-badge";
					teraBadge.title = `テラスタイプ: ${teraType}`;
					teraBadge.setAttribute("aria-label", `テラスタイプ: ${teraType}`);
					const teraImg = document.createElement("img");
					teraImg.alt = "";
					applyTeraIcon(teraImg, teraType);
					teraBadge.appendChild(teraImg);
					nameRow.appendChild(teraBadge);
				}
				bodyEl.appendChild(nameRow);

				// 特性+持ち物(box/index.astroの.card-item-row/.card-item-row-cellと同じ2列)。
				const itemRow = document.createElement("span");
				itemRow.className = "select-row-item-row";
				const abilityCell = document.createElement("span");
				abilityCell.className = "select-row-item-row-cell";
				const abilityNameEl = document.createElement("span");
				abilityNameEl.className = "select-row-ability-name";
				abilityNameEl.textContent = p.ability_name?.trim() || "特性未設定";
				abilityCell.appendChild(abilityNameEl);
				itemRow.appendChild(abilityCell);

				const itemCell = document.createElement("span");
				itemCell.className = "select-row-item-row-cell";
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemBadge = document.createElement("span");
					itemBadge.className = "select-row-item-badge";
					const itemImg = document.createElement("img");
					itemImg.alt = "";
					void applyItemIcon(itemImg, itemName);
					itemBadge.appendChild(itemImg);
					itemCell.appendChild(itemBadge);
					const itemLabel = document.createElement("span");
					itemLabel.className = "select-row-item-name";
					itemLabel.textContent = itemName;
					itemCell.appendChild(itemLabel);
				}
				itemRow.appendChild(itemCell);
				bodyEl.appendChild(itemRow);

				// 技(最大4つ)。box/index.astroの.card-moves-grid/.card-move-chipと同じ2列
				// グリッド+タイプアイコン付きチップ(本日/box側で確立した最新仕様: 背景色なし・
				// 技名の前にタイプアイコン・セル内左揃え。上のapplySelectMoveChipTypeIcons参照)。
				// 技0件のときは.select-row-move-chip-unsetで「未設定」を明示する(旧来からの表示、
				// A-6と同じ理由でDOMごと消さない)。
				const movesRow = document.createElement("span");
				movesRow.className = "select-row-moves";
				const rowMoves = p.move_names.filter((m) => m && m.trim() !== "");
				if (rowMoves.length > 0) {
					const chipEntries: { iconEl: HTMLImageElement; moveName: string }[] = [];
					for (const move of rowMoves) {
						const chip = document.createElement("span");
						chip.className = "select-row-move-chip";
						const iconEl = document.createElement("img");
						iconEl.className = "select-row-move-chip-icon";
						iconEl.alt = "";
						iconEl.hidden = true;
						chip.appendChild(iconEl);
						const textEl = document.createElement("span");
						textEl.className = "select-row-move-chip-text";
						textEl.textContent = move;
						chip.appendChild(textEl);
						movesRow.appendChild(chip);
						chipEntries.push({ iconEl, moveName: move });
					}
					void applySelectMoveChipTypeIcons(chipEntries);
				} else {
					const chip = document.createElement("span");
					chip.className = "select-row-move-chip select-row-move-chip-unset";
					const textEl = document.createElement("span");
					textEl.className = "select-row-move-chip-text";
					textEl.textContent = "未設定";
					chip.appendChild(textEl);
					movesRow.appendChild(chip);
				}
				bodyEl.appendChild(movesRow);

				const reason = selectionBlockReason(candidateOf(p), currentCandidates());
				if (reason) {
					mainButton.disabled = true;
					const reasonEl = document.createElement("span");
					reasonEl.className = "select-row-reason";
					// A-3(a): 「編成済み」(already-in-team、正常)と禁止3種を色で書き分けるため、
					// data-reasonをCSSセレクタのフックにする(is:globalスタイル側で参照)。
					reasonEl.dataset.reason = reason;
					reasonEl.textContent = BLOCK_REASON_LABELS[reason];
					bodyEl.appendChild(reasonEl);
					mainButton.setAttribute("aria-label", `${name}(${BLOCK_REASON_LABELS[reason]}、選択できません)の詳細を見る`);
				} else {
					mainButton.setAttribute("aria-label", `${name}の詳細を見る(ダブルクリックで空き枠に追加)`);
					mainButton.addEventListener("dblclick", () => {
						assignToSlot(p);
					});
				}
				mainButton.addEventListener("click", () => {
					void renderPreviewPanel(p);
				});

				mainButton.append(artEl, bodyEl);
				row.appendChild(mainButton);

				// 🔴 UI改修依頼(チーム編集左パネル、2026-08-02)「行の右端にあるドラッグ用グリップを
				// 廃止する」。要素を「消す」指示はDOMを残しCSSで見せない方針にする(pitfalls.md)ため、
				// 要素自体・row.appendChildは残し、CSS側(.select-row-drag-handle、下のis:global
				// スタイル参照)でdisplay:noneにする。ドラッグ&ドロップ自体(row.draggable=true、
				// 下のdragstart/dragend)はこの要素と無関係(rowが直接draggable/イベントを持つ)
				// なので、見た目を消しても動作は維持される。
				const dragHandle = document.createElement("span");
				dragHandle.className = "select-row-drag-handle";
				dragHandle.setAttribute("aria-hidden", "true");
				row.appendChild(dragHandle);

				row.addEventListener("dragstart", () => {
					draggedPokemonId = p.id;
					row.classList.add("is-dragging");
				});
				row.addEventListener("dragend", () => {
					draggedPokemonId = null;
					row.classList.remove("is-dragging");
				});

				return row;
			}

			function renderSelectList(): void {
				if (allPokemon.length === 0) {
					selectListRoot.innerHTML = "";
					selectEmptyState.hidden = false;
					selectNoMatchState.hidden = true;
					return;
				}
				selectEmptyState.hidden = true;

				const term = searchInput.value.trim();
				// UI改修依頼(チーム編集左パネル)「チームに含まれる個体を一覧から非表示にする」
				// 「ソート機能を追加する」。isCurrentMemberで除外してからsortPokemonで並べ替える
				// (除外により、既存の選択ルール由来の"already-in-team"理由は表示上到達しなくなる。
				// selectionBlockReason自体・BLOCK_REASON_LABELSは他の禁止理由(6体編成済み/種族重複/
				// 持ち物重複)で引き続き使うため残す)。
				const filtered = sortPokemon(
					allPokemon.filter((p) => !isCurrentMember(p.id) && matchesTeamRegulation(p) && matchesSearch(p, term)),
				);
				selectListRoot.innerHTML = "";
				if (filtered.length === 0) {
					selectNoMatchState.hidden = false;
					return;
				}
				selectNoMatchState.hidden = true;
				for (const p of filtered) {
					selectListRoot.appendChild(buildSelectRow(p));
				}
			}

			// --- 自動保存(box/[id].astroと同じデバウンス方式。保存ボタンは作らない) ---
			function buildPayload(): {
				name: string | null;
				memo: string | null;
				regulation: string | null;
				members: { slot: number; owned_pokemon_id: string }[];
			} {
				const members = Array.from(membersBySlot.entries())
					.sort((a, b) => a[0] - b[0])
					.map(([slot, p]) => ({ slot, owned_pokemon_id: p.id }));
				const name = nameInput.value.trim();
				const memo = memoInput.value.trim();
				return {
					name: name === "" ? null : name,
					memo: memo === "" ? null : memo,
					// PUT /api/teams/:id は全項目上書きの契約(team-validation.tsの
					// REPLACE_REQUIRED_FIELDS)なので、未指定でもキー自体は必ず送る。
					regulation: currentTeamRegulation(),
					members,
				};
			}

			const DEBOUNCE_MS = 700;
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;
			let saving = false;
			let pendingRetry = false;

			async function saveNow(): Promise<void> {
				if (saving) {
					pendingRetry = true;
					return;
				}
				const payload = buildPayload();
				saving = true;
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "保存中...";
				retryButton.classList.remove("visible");

				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					if (!res.ok) {
						const body = (await res.json().catch(() => ({}))) as { error?: string };
						throw new Error(body.error ?? `保存に失敗しました (status=${res.status})`);
					}
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "保存済み";
				} catch (err) {
					console.error(err);
					statusEl.dataset.state = "error";
					statusTextEl.textContent = err instanceof Error ? err.message : "保存に失敗しました。";
					retryButton.classList.add("visible");
				} finally {
					saving = false;
					if (pendingRetry) {
						pendingRetry = false;
						void saveNow();
					}
				}
			}

			function scheduleSave(): void {
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "編集中...";
				retryButton.classList.remove("visible");
				if (debounceTimer) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					void saveNow();
				}, DEBOUNCE_MS);
			}

			retryButton.addEventListener("click", () => {
				void saveNow();
			});

			// UI改修依頼(チーム編集ヘッダー)「右端に削除ボタン追加」。box/[id].astroの
			// deleteButtonハンドラと同じ確認ダイアログ→DELETE→遷移のパターン。
			deleteTeamButton.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを削除します。よろしいですか?")) return;
					deleteTeamButton.disabled = true;
					try {
						const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
							method: "DELETE",
							credentials: "same-origin",
						});
						if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
						window.location.href = "/team";
					} catch (err) {
						console.error(err);
						window.alert("削除に失敗しました。時間をおいて再度お試しください。");
						deleteTeamButton.disabled = false;
					}
				})();
			});

			// A-2(実バグ): トップバーはSSR時点のpageTitleで固定され、#team-nameのinputイベントで
			// 追随する処理が存在しなかった(トップバーへの参照が本ファイルに0件だった)。
			// box/[id].astroのupdateHeaderIdentity()(:4239-4257)と同じ手法を移植する:
			// AppLayout.astroは編集禁止(全ページ共通)なので、トップバー側の要素はclass経由で
			// このページのscriptから直接更新する。
			const topbarTitleEl = document.querySelector<HTMLElement>(".app-topbar-title");
			function updateHeaderIdentity(): void {
				const name = nameInput.value.trim();
				if (topbarTitleEl) {
					topbarTitleEl.textContent = name || "無題のチーム";
				}
			}

			nameInput.addEventListener("input", () => {
				updateHeaderIdentity();
				scheduleSave();
			});
			memoInput.addEventListener("input", scheduleSave);
			searchInput.addEventListener("input", renderSelectList);
			sortSelect.addEventListener("change", renderSelectList);

			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)。レギュレーションを変えると
			// 「選択バーに出す個体」も変わるため、保存と同時に一覧を描き直す。
			regulationSelect.addEventListener("change", () => {
				syncRegulationFilterToggle();
				syncRegulationPlaceholder();
				renderSelectList();
				scheduleSave();
			});
			// UI改修依頼(チーム編集左パネル、2026-08-02)「トグルスイッチに変更する」に伴い、
			// <button>のclickから<input type="checkbox">のchangeへ差し替える(ヘッダーの
			// 「非公開」トグル=#team-collection-opt-out-toggleと同じイベント)。
			regulationFilterToggle.addEventListener("change", () => {
				regulationFilterOn = regulationFilterToggle.checked;
				syncRegulationFilterToggle();
				renderSelectList();
			});
			// 初期表示(SSRで選択済みのレギュレーション)にもトグルの状態を合わせる。
			syncRegulationFilterToggle();
			syncRegulationPlaceholder();

			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」。個体編集画面
			// (src/lib/box-id/left-panel.ts)と同じPATCH経路を、現在のチームメンバー全員に対して
			// 一括で呼ぶ(既存の1個体用APIをそのまま流用。新しいAPI・DB列は追加していない)。
			// 失敗時はcheckedを元に戻しエラーメッセージを表示する(個体編集画面と同じ温度感)。
			// 🔴 2026-08-01「非公開」トグルへの改称により、checkedの意味が反転している
			// (checked=true が「非公開」=collection_opt_out=true)。保存するペイロード自体
			// (collection_opt_out の真偽値)は変えていない ── nextProviding は反転後のcheckedから
			// 「提供中かどうか」を計算し直しているだけで、PATCHボディの式(!nextProviding)は
			// 変更前と同一。
			collectionOptOutToggle.addEventListener("change", () => {
				void (async () => {
					// checked_after(クリック直後の値)は「非公開かどうか」を表す。
					// nextProviding は「提供中かどうか」(旧来の意味のまま)に変換する。
					const nextProviding = !collectionOptOutToggle.checked;
					syncCollectionOptOutTitle();
					const ids = currentMemberIds();
					collectionOptOutToggle.disabled = true;
					try {
						const results = await Promise.all(
							ids.map((id) =>
								fetch(`/api/owned-pokemon/${encodeURIComponent(id)}`, {
									method: "PATCH",
									credentials: "same-origin",
									headers: { "Content-Type": "application/json" },
									body: JSON.stringify({ collection_opt_out: !nextProviding }),
								}),
							),
						);
						if (results.some((res) => !res.ok)) throw new Error("更新に失敗しました");
						collectionOptOutStatusEl.hidden = true;
						delete collectionOptOutStatusEl.dataset.state;
					} catch (err) {
						console.error(err);
						// クリック前の状態(checked)= nextProviding(「非公開」= !提供中 = nextProviding)。
						collectionOptOutToggle.checked = nextProviding;
						syncCollectionOptOutTitle();
						collectionOptOutStatusEl.textContent = "更新に失敗しました";
						collectionOptOutStatusEl.hidden = false;
						collectionOptOutStatusEl.dataset.state = "error";
					} finally {
						collectionOptOutToggle.disabled = currentMemberIds().length === 0;
						syncCollectionOptOutTitle();
					}
				})();
			});

			// --- 初期化 ---
			// SSR取得済みのメンバーは fetch を待たずに即描画する(6枠が空でも一瞬も待たせない)。
			renderSlots();
			refreshCollectionOptOutToggle();
			// サジェスト(2026-08-02)。SSR時点のメンバーだけで先に問い合わせられるので、
			// 個体一覧のfetch完了は待たない。ただし「手持ちにあるか」の判定(findOwnedMatch)は
			// allPokemon に依存するため、一覧が届いた時点でボタンの出し分けを描き直す
			// (下の fetch("/api/owned-pokemon") の then を参照)。
			void loadSuggestions();

			fetch("/api/owned-pokemon", { credentials: "same-origin" })
				.then(async (res) => {
					if (!res.ok) throw new Error(`個体一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemonRecord[] };
					allPokemon = body.data;
					// SSR由来のmembersBySlotの値はcollection_opt_out_until等、GET専用の列を
					// 持たないため、fetch完了後にallPokemonの同IDレコードへ差し替えて以後の計算
					// (匿名トグルの状態など)を正確にする(表示中の6枠の見た目は変わらない列のみ
					// なので再描画は不要)。
					for (const [slot, p] of membersBySlot.entries()) {
						const fresh = allPokemon.find((x) => x.id === p.id);
						if (fresh) membersBySlot.set(slot, fresh);
					}
					selectLoadingMessage.hidden = true;
					renderSelectList();
					refreshCollectionOptOutToggle();
					// サジェストの操作ボタンは「手持ちに一致する個体があるか」で文言が変わる
					// (findOwnedMatch)。その判定材料である allPokemon が今届いたので、
					// 既に描画済みの結果があれば同じデータのまま描き直す(再fetchはしない)。
					if (lastSuggestResponse) {
						renderSuggestions(lastSuggestResponse.suggestions, lastSuggestResponse.basis);
					}
				})
				.catch((err) => {
					console.error(err);
					selectLoadingMessage.hidden = true;
					selectErrorMessage.hidden = false;
				});
		}
	</script>
</AppLayout>
