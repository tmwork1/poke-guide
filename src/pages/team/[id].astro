			width: 100%;
		}
		.team-slots .slot-stats-line {
			display: contents;
		}
		/* UI改修依頼(チーム編集中央パネル、2026-08-02)実測修正: line-heightをvar(--line-height-tight)
		   (1.25、bodyの既定1.6から)に引き締め、1200〜1600px帯で技の2段目が見切れていた問題
		   (上の.card-team-slotコメント参照)の解消に充てる。 */
		.team-slots .slot-stat-key {
			font-size: 0.7rem;
			font-weight: 700;
			color: var(--color-text-muted);
			text-align: center;
			line-height: var(--line-height-tight);
