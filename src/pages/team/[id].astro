---
// チーム編集ページ(docs/plan/pages/team.md「確定した設計 > 画面 > /team/[id](編集)」)。
// 初期表示データは box/[id].astro と同じ方針で、API経由のfetchではなくAstroのフロントマター
// (SSR)で src/lib/team.ts の getTeam() を直接呼び出す(初期表示が速く、「生のSupabaseクエリは
// lib層に集約する」という設計原則にも合致する)。
//
// 未ログイン時、および他人のチーム/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(box/[id].astroと同じ既存方針)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { getTeam, type Team } from '../../lib/team';
// 🔴 UI改修依頼(チーム編集画面、2026-08-01)「個体編集と同様にレギュレーション指定機能を追加」。
// 候補は jpoke 由来の一覧(src/lib/regulations.ts)。画面側でレギュレーション名を
// ハードコードしない(box/[id].astro の左パネルと同じ方針)。
// 2026-08-01追記(同日ユーザー指示「選択肢を新しい順に並べる」、box/index.astro・LeftPanel.astro
// と同じ対応): REGULATIONS(定義順=古い順)ではなくCoordinatorがsrc/lib/regulations.tsに
// 追加したREGULATIONS_NEWEST_FIRST(新しい順の配列)を使う。regulations.ts自体はこのファイルの
// 担当外のため編集しない。
import { REGULATIONS_NEWEST_FIRST, REGULATION_PLACEHOLDER } from '../../lib/regulations';

const user = Astro.locals.user;
const id = Astro.params.id;

let team: Team | null = null;
let loadError = false;

if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getTeam(user.id, id, supabase);
	if (result.ok) {
		team = result.data;
	} else {
		loadError = true;
	}
	if (!team && !loadError) {
		Astro.response.status = 404;
	}
}

// 一覧(/team)の「無題のチーム」表記(R-14)とトップバー見出しを揃える。
function displayTeamName(t: Team): string {
	return t.name && t.name.trim() !== '' ? t.name : '無題のチーム';
}

const pageTitle = team ? displayTeamName(team) : 'チーム編集';

// UI改修依頼(チーム編集ヘッダー)「チーム名表示を削除する」。box/[id].astroの23-H1と同じ手法:
// AppLayoutは編集禁止なので、<title>タグ(ブラウザタブ)にはpageTitleを残しつつ、可視の見出し
// (.app-topbar-title)だけをbodyClass経由のグローバルCSS(下の<style is:global>の
// `body.team-edit-page .app-topbar-title`参照)で非表示にする。loadError/team未検出時は
// pageTitleが固定文言なので隠さない(teamが存在するときだけbodyClassを付与)。
const bodyClass = team ? 'team-edit-page' : undefined;

// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグルを追加する」。個体編集画面
// (box/[id].astro)のトグルはowned_pokemon.collection_opt_out_untilを個体単位で持つが、
// teamsテーブルにはチーム単位の対応する列が無い(migrations/007_teams.sqlに列なし)。
// このタスクは1ファイル(このファイル)のみの変更に限定されており、マイグレーション追加や
// lib/team.ts・APIルートの変更は範囲外のため、新しい列は作らない。代わりに「このチームに
// 入っている個体全員」に対して、既存のPATCH /api/owned-pokemon/:id { collection_opt_out }
// (個体編集画面と全く同じエンドポイント、box/[id].astro参照)を一括で呼ぶ「チーム一括トグル」
// として実装する(下の<script>参照)。SSR時点ではlib/team.tsのSELECTがcollection_opt_out_until
// を含まないため正確な初期状態が分からず、ここでは「未収集拒否(提供中)」を既定値としてSSR
// で仮置きし、クライアント側でGET /api/owned-pokemon(既存の左パネル用フェッチ)の結果から
// 実際の状態に補正する(<script>のrefreshCollectionOptOutToggle参照)。メンバーが0人のときは
// 対象が無いため無効化する。
//
// 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-01)「公開設定のトグルを個体編集画面と同じ方針に
// 変更する」。ラベルを「非公開」にし、既定OFF、ホバーテキストをOFF時「育成データを匿名で
// 提供する」/ON時「30日間有効」にする。これはUI表示(ラベル・title・checkedの向き)だけの反転
// であり、DBの意味(collection_opt_out_until)・保存されるペイロード(PATCH { collection_opt_out }）
// は一切変えない。旧: checked=true が「提供中」(collection_opt_out=false)を表した。
// 新: checked=true が「非公開」(collection_opt_out=true)を表す。checkedの真偽値を丸ごと反転
// させるだけで、保存結果自体は完全に同じになる(<script>のrefreshCollectionOptOutToggle/
// 変更ハンドラ参照)。
const teamMemberCount = team ? team.members.length : 0;

// 初期メンバー(0〜6要素、SSR取得済み)をクライアント<script>へそのまま引き渡す。
// Astroの属性値は自動でHTMLエスケープされるので、ニックネーム等に " や < が
// 含まれていても壊れない(pokemon.tsの data-tags={JSON.stringify(...)} と同じ手法)。
const initialTeamJson = team
	? JSON.stringify({
			id: team.id,
			name: team.name,
			memo: team.memo,
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)。<select id="team-regulation">の初期値は
			// SSRのselected属性で足りるが、InitialTeam型の他の項目と揃えて渡しておく
			// (クライアント側から「保存済みの値」を参照したくなったときにSSR側の変更を要らなくする)。
			regulation: team.regulation,
			members: team.members,
		})
	: '';
---
<AppLayout title={pageTitle} current="team" backHref="/team" bodyClass={bodyClass}>
	{/* UI改修依頼(チーム編集ヘッダー、2026-08-01)「保存済みを非表示にする」。box/[id].astroの
	    23-H1相当の対応と同じ考え方: #autosave-status/#autosave-status-textのid・DOM自体は
	    <script>のel()参照(見つからないとthrowしてJS初期化が止まる)のため残し、
	    テキストだけを下の<style>で常時非表示にする(保存失敗時=data-state="error"のときだけ
	    見せる。box/[id].astro側の実装が無い場合はteam側限定の判断として同じ方式を採用)。 */}
	{team && (
		<Fragment slot="topbar-status">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span>
				<button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>
		</Fragment>
	)}
	{/* UI改修依頼(チーム編集ヘッダー)「右端に削除ボタン追加」。box/[id].astroの
	    #delete-buttonと同じマークアップ・確認ダイアログ・アイコンにする。
	    UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグルを追加する」。box/[id].astroの
	    .collection-opt-out-toggle一式(label > .toggle-switch + ラベルテキスト + ステータス欄)を
	    そのまま踏襲する(上のフロントマターのコメント参照。マークアップ・aria-label・title文言は
	    個体編集画面と同じ語彙で揃え、対象が「この個体」ではなく「チームの個体全員」である点だけ
	    titleとaria-labelの文言に反映する)。
	    🔴 2026-08-01追記: 「非公開」トグルへ改称に伴い、初期checkedは付けない(既定OFF=非公開で
	    はない=提供中、フロントマターのコメント参照)。titleもOFF/ONで文言が変わる仕様のため、
	    ここに書くのはJS初期化前に一瞬だけ見える初期値(<script>のsyncCollectionOptOutTitleが
	    ページ読み込み直後に実際の状態へ即座に補正する)。メンバー0人のときはtitleに理由を明示した
	    上でdisabledにする(対象が無いため、この場合のtitleはJSでも変更しない)。 */}
	{team && (
		<Fragment slot="topbar-actions">
			{/* UI改修依頼(2026-08-05): 機能・id・イベント配線を維持したまま共通トップバーへ戻す。
			    画面上の水平位置はCSSで従来の中央パネル左端に合わせる。 */}
			<button id="matchup-check-button" class="btn-ghost" type="button" aria-pressed="false" title="使用率上位20体との相性を右パネルに表示する">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="1" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="23"/><line x1="1" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="23" y2="12"/></svg>
				相性チェック
			</button>
			<label
				class="collection-opt-out-toggle"
				for="team-collection-opt-out-toggle"
				title={teamMemberCount === 0
					? 'チームに個体を入れると、匿名集計への提供可否を切り替えられます'
					: '30日間有効'}
			>
				<span class="toggle-switch">
					<input
						id="team-collection-opt-out-toggle"
						type="checkbox"
						class="toggle-switch-input"
						disabled={teamMemberCount === 0}
						aria-label="非公開"
					/>
					<span class="toggle-switch-track" aria-hidden="true">
						<span class="toggle-switch-thumb"></span>
					</span>
				</span>
				<span class="collection-opt-out-toggle-label">非公開</span>
				<span id="team-collection-opt-out-status" class="collection-opt-out-status" hidden></span>
			</label>
			{/* 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-04)「相性チェックボタンは、左端がチーム名
			    ボックスと同じになるあたりに移動」。旧来はここ(topbar-actions、非公開トグル・削除
			    ボタンと横並び)にあったが、共通トップバーは画面全体で1行のバーであり、中央パネルの
			    チーム名ボックス(.team-meta-fields配下)とはレイアウト文脈が別で、x座標を揃える
			    余地が無かった。ボタン本体は中央パネル側(.team-matchup-check-row、下の
			    .panel-content内でチーム名ボックスと同じ左端に自然に揃う。詳細はそちらのコメント
			    参照)へ移動した。非公開トグル・削除ボタンはこのスロットの構造を変えずそのまま残す。 */}
			<button id="delete-team-button" class="btn-danger" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				削除
			</button>
		</Fragment>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button {
			display: none;
			margin-left: 0.4em;
		}
		#retry-button.visible {
			display: inline-flex;
		}
		#autosave-status {
			margin: 0;
		}
		/* UI改修依頼(チーム編集ヘッダー、2026-08-01)「保存済みを非表示にする」。box/[id].astro
		   ラウンド11(11-1)と同じ方針: #autosave-status-text自体はDOM/idごと残し(<script>の
		   el("autosave-status-text")がthrowするのを避けるため)、テキストだけを常時非表示にする。
		   保存失敗(data-state="error")のときだけ、唯一のリカバリ手段である#retry-buttonに
		   気づけるよう理由テキストを見せる(box/[id].astroと同じ判断)。 */
		#autosave-status-text {
			display: none;
		}
		#autosave-status[data-state="error"] #autosave-status-text {
			display: inline;
			color: var(--color-danger);
		}
		/* pitfalls.md「[hidden]は詳細度で負ける」: global.cssの.status-textが
		   display: inline-flexを持つため、UA既定の[hidden]{display:none}に勝ってしまい
		   hidden=trueにしても消えない。明示的に上書きする。 */
		#select-loading-message[hidden],
		#select-error-message[hidden] {
			display: none;
		}

		/* UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグルを追加する」。トグル本体の
		   見た目(.toggle-switch一式)は複数ページで使うためglobal.cssの共通定義を参照する。 */
		.collection-opt-out-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			/* 戻るボタン(.app-topbar-back)と同じ文字規格に揃える。 */
			font-size: var(--font-size-md);
			font-weight: 500;
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
		}
		.collection-opt-out-toggle:has(.toggle-switch-input:disabled) {
			cursor: not-allowed;
			opacity: 0.7;
		}
		/* UI改修依頼(2026-08-05)「相性チェック・非公開を戻るボタンと同じhover色にする」対応。
		   非公開はlabel内のinputがdisabledになる構造なので、:has()で無効時を除外する。 */
		#matchup-check-button:hover:not(:disabled),
		.collection-opt-out-toggle:hover:not(:has(.toggle-switch-input:disabled)) {
			color: var(--color-primary);
		}
		.collection-opt-out-status { color: var(--color-text-muted); }
		.collection-opt-out-status[hidden] { display: none; }
		.collection-opt-out-status[data-state="error"] { color: var(--color-danger); }
		/* 2026-08-05: global.cssのbutton.btn-dangerが持つ太字指定を上書きし、
		   戻るボタン(.app-topbar-back)と同じ文字サイズ・太さへ揃える。 */
		#delete-team-button { font-size: var(--font-size-md); white-space: nowrap; font-weight: 500; }
		/* 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-02)「非公開・削除ボタンの余白サイズを
		   個体編集画面と同じにする」。box/[id].astro が2026-08-01の依頼(「データ提供スイッチと
		   削除ボタンの間の余白を広げる」)で #delete-button に足した margin-left が、
		   こちらのページには入っていなかった。実測(1920px幅)で判明した唯一の差分:
		     個体編集: 非公開トグル 1715.2〜1799.5 / 削除 1823.5〜1904(間隔24px)
		     チーム編集: 非公開トグル 1731.2〜1815.5 / 削除 1823.5〜1904(間隔8px)
		   削除ボタン自体の座標・寸法・配色・角丸は元から完全一致していたが、この16pxの差の
		   ぶんだけ非公開トグルが右へ寄っていた。box/[id].astro と同じ対処
		   (.app-topbar-actions の gap は全画面共通のため AppLayout は編集せず、
		   このページscopedで削除ボタンにだけ margin-left を足す)をそのまま踏襲する。
		   🔴 UI改修依頼(チーム編集ヘッダー、2026-08-04)「非公開ボタンと削除ボタンの間隔を
		   広げる」。box/[id].astro 側(#delete-button)が同日の依頼で var(--space-4) から
		   var(--space-5) へ広げているのを確認済みのため、同じトークンにこちらも揃える。 */
		#delete-team-button { margin-left: var(--space-5); }
		/* 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-04)「削除ボタンの平常時/ホバーの配色を
		   入れ替える」。box/[id].astro の #delete-button(2026-08-04に同じ依頼で対応済み、
		   このファイル上部のコメント参照)と同じ入れ替えをこちらにも適用する。基底
		   (global.css の button.btn-danger)は 平常時=塗り(background:var(--color-danger-strong),
		   color:var(--color-primary-contrast))、hover時=白地反転
		   (background:var(--color-surface), color:var(--color-danger-strong))。
		   #delete-team-buttonはIDセレクタで button.btn-danger より詳細度が高いため、
		   global.css自体は変更せずに上書きできる(他画面の.btn-danger既定配色は維持される)。
		   border(2px solid var(--color-danger-strong))は基底のまま変えない。
		   background/colorは平常時・hover時の両方で必ずセットで書く(片方だけ上書きすると
		   文字色=背景色になって見えなくなる事故がbox/[id].astro側で実際に起きたため)。 */
		#delete-team-button {
			background: var(--color-surface);
			color: var(--color-danger-strong);
		}
		#delete-team-button:hover:not(:disabled) {
			background: var(--color-danger-strong);
			color: var(--color-primary-contrast);
		}

		/* --- 相性チェック(ユーザー要望、2026-08-02) --- */
		/* 見た目は他のトップバー操作と同じ .btn-ghost で、ONのときだけ塗りつぶす。配色は新設せず、
		   このページの攻守セグメント(下記 .team-matchup-direction-option[data-role="defense"])と
		   同じ --color-primary-strong + --color-primary-contrast の組み合わせを使う
		   (DamageCalcSection.astro のコメントにあるとおり、この組はライト4.62:1/
		   ダーク8.87:1でWCAG AAを満たすことが実測済み)。
		   2026-08-05: 共通トップバーへ移しても従来の水平位置を保つため、表示幅ではボタンを
		   トップバー基準で中央パネル左端へ絶対配置する。配色・フォントサイズは変更しない。 */
		#matchup-check-button { font-size: var(--font-size-sm); white-space: nowrap; display: none; }
		#matchup-check-button[aria-pressed="true"] {
			background: var(--color-primary-strong);
			border-color: var(--color-primary-strong);
			color: var(--color-primary-contrast);
		}
		/* 右パネルが出ない幅では行自体を隠す(閾値は .team-preview-panel と必ず揃えること)。 */
		@media (min-width: 1650px) {
			/* トップバーはサイドバー右端が原点。従来位置=左パネル304px+中央padding。 */
			#matchup-check-button {
				display: inline-flex;
				position: absolute;
				left: calc(304px + var(--space-5));
			}
		}

		.team-matchup {
			padding: var(--space-3);
		}
		.team-matchup-heading {
			font-size: var(--font-size-sm);
			font-weight: 600;
			margin: 0 0 var(--space-2);
		}
		/* 攻撃・防御の切り替え。個体編集画面のダメージ計算カードの攻守セグメント
		   (src/components/box-id/DamageCalcSection.astro の
		   .damage-row-direction-toggle / .damage-row-direction-option)と同じ意匠。
		   あちらは #opponent-notes-section 配下に限定したセレクタで、このページには
		   バンドルされない(Astroのscoped/is:globalスタイルは実際にそのコンポーネントを
		   描画したページにしか入らない)ため、上の .toggle-switch 一式と同じ理由で
		   同じ値をここへ複製する(新しい値は作っていない)。 */
		.team-matchup-direction-toggle {
			display: flex;
			width: 100%;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			overflow: hidden;
		}
		.team-matchup-direction-option {
			flex: 1 1 0;
			min-width: 0;
			border: none;
			background: var(--color-surface);
			color: var(--color-text-muted);
			font-size: 0.8rem;
			font-weight: 600;
			padding: 0.25em 0.4em;
			line-height: 1.2;
			cursor: pointer;
			transition: background 0.15s, color 0.15s;
		}
		.team-matchup-direction-option + .team-matchup-direction-option {
			border-left: 1px solid var(--color-border);
		}
		.team-matchup-direction-option:hover:not([aria-checked="true"]) {
			color: var(--color-primary);
			background: var(--color-primary-soft);
		}
		.team-matchup-direction-option:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: -2px;
		}
		.team-matchup-direction-option[data-role="attack"][aria-checked="true"] {
			background: var(--color-danger-strong);
			color: var(--color-primary-contrast);
		}
		.team-matchup-direction-option[data-role="defense"][aria-checked="true"] {
			background: var(--color-primary-strong);
			color: var(--color-primary-contrast);
		}
		.team-matchup-status {
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
			margin: var(--space-2) 0 0;
			line-height: 1.4;
		}
		.team-matchup-status[hidden] { display: none; }

		/* --- 全体レイアウト: 左=ポケモン選択バー(帯)/ 中央=チーム名・メモ・6枠(可読幅1080px) ---
		   docs/plan/00-foundation.md「レイアウト原則」どおり、選択バーは画面端から
		   画面端まで伸びる帯(.panel.panel-left)。中央は.panel-contentで1080pxに絞る(R-11)。
		   受け入れ検証で実測バグ修正(2026-07-29): 閾値をもともと900pxにしていたが、900px幅では
		   サイドバー(256px)+選択バー(約380px)を引くと中央カラムが約264pxしか残らず、
		   そこへ横長の6枠カードを入れていたため、ポケモン名・技名が1文字ずつ縦に折り返されて
		   読めなくなっていた(実測で発覚)。これはbox/[id].astroの.edit-layoutが900px→1200pxに
		   引き上げた過去の罠(docs/plan/00-foundation.md 245行目)と同一原因なので、
		   当時は同じ閾値(1200px)に揃えていた。
		   🔴 UI改修依頼(チーム編集画面、2026-08-02)「チームパネルの幅はポケモンカードが
		   ちょうど収まるサイズに狭める」「残りの領域をすべて右パネルにあてがう」。中央カラム
		   (チーム6枠)を`1fr`(可変)から754pxの固定幅に、右カラム(プレビュー)を固定
		   `minmax(280px, 340px)`から下限だけ残した可変幅`minmax(240px, 1fr)`に変更した
		   (値の根拠は下の各ルールのコメント参照)。中央カラムが固定幅になったことで、
		   2カラム化に必要な最小横幅が変わったため、閾値も再計算して引き上げた
		   (根拠は直後の@media 2件のコメント参照。npm run shotで実測して決定、報告参照)。 */
		.team-edit-layout {
			display: block;
		}
		@media (min-width: 1300px) {
			.team-edit-layout {
				display: grid;
				/* UI改修依頼(チーム編集左パネル、2026-08-01)「パネルの幅を20%狭くする」。
				   1920px幅で実測した変更前の.team-select-bar幅は380px(minmaxのmax=380pxで頭打ち)。
				   380px×0.8=304pxへ縮小し、下限(min)も同じ比率で300px→240pxへ縮める
				   (min/maxの比率を変えないため)。実測結果は報告参照。
				   🔴 UI改修依頼(チーム編集画面、2026-08-02)「チームパネルの幅はポケモンカードが
				   ちょうど収まるサイズに狭める」。中央カラムを754pxの固定幅にする。
				   754px = カード230px×3枚 + gap(var(--space-3)=12px)×2 + 左右padding
				   (var(--space-5)=20px)×2 = 690+24+40 = 754px(.team-edit-mainのpadding分。
				   実測(getBoundingClientRect)で3枚のカードが左右に余白なく収まることを確認した、
				   報告参照)。
				   閾値を1200px→1300pxへ引き上げた根拠: 中央カラムが固定幅754pxになったため、
				   2カラム化に必要な最小横幅はサイドバー(256px)+選択バー最小(240px)+
				   チーム(754px)=1250px。実測(npm run shot、複数幅で目視確認)で1250px前後は
				   余裕がほぼ無かったため、安全マージンを見て1300pxを採用した(報告参照)。 */
				grid-template-columns: minmax(240px, 304px) 754px;
				align-items: stretch;
			}
		}
		/* UI改修依頼(チーム編集左パネル)「右パネルを追加」対応。box/[id].astroの
		   .edit-layout(3カラム化、RightPanel.astro参照)と同じ考え方で3カラム目
		   (.team-preview-panel)を追加する。2カラム時(下の閾値未満)では右パネルは
		   非表示にする(下の.team-preview-panel参照)、幅が無いところに無理に3カラム目を
		   押し込むと中央カラムの6枠カードが再び潰れるため(上のコメントの実測バグと同じ罠)。
		   🔴 UI改修依頼(チーム編集画面、2026-08-02)「残りの領域をすべて右パネルにあてがう」。
		   右カラムを固定`minmax(280px, 340px)`から下限だけ残した`minmax(240px, 1fr)`へ変更
		   (下限240pxはbox/[id].astroの右パネル`minmax(300px, 360px)`と同様、潰れ防止の
		   下限を残すパターンを踏襲。上限を`1fr`にして残り幅を丸ごと割り当てる)。
		   閾値を1600px→1650pxへ引き上げた根拠: 3カラム時に必要な最小横幅は2カラム時の
		   1250px(256+240+754)に右パネルの下限240pxを足した1490px。実測(npm run shot、
		   報告参照)で1490px前後は右パネルが窮屈だったため、安全マージンを見て1650pxを
		   採用した。 */
		@media (min-width: 1650px) {
			.team-edit-layout {
				/* UI改修依頼(2026-08-05)「右パネルを20%縮小し、中央へ多めに配分」対応。
				   1920px表示時の右列を約606pxから約485pxへ縮め、左+31px・中央+90pxへ配分する。 */
				grid-template-columns: minmax(240px, 335px) 844px minmax(192px, 1fr);
			}
		}

		.team-select-bar {
			display: flex;
			flex-direction: column;
			min-width: 0;
			/* 共通.panelの上paddingを既存トークンで2段階詰め、検索欄を上へ寄せる。 */
			padding-top: var(--space-4);
		}
		/* box/[id].astroの.panel-leftと同じ考え方: トップバー直下から画面下端まで帯を伸ばす。
		   帯自体の高さはビューポート基準(calc(100vh - var(--topbar-height)))で決め、
		   個体数が少なくても背景色が画面下端まで届くようにする。2カラム化未満(縦積み)では
		   sticky/固定高さにせず、通常のブロックとして中央カラムの上に積む(box/[id].astroの
		   .edit-layout-leftが2カラム化のメディアクエリでだけheight:100%を付けているのと
		   同じ考え方。縦積み時に選択バーが画面いっぱいの高さを占有すると、6枠に到達するまで
		   1画面ぶん余計にスクロールする羽目になる)。閾値は.team-edit-layoutの2カラム化と
		   必ず揃えること(2026-08-02に1200px→1300pxへ変更、根拠は上の.team-edit-layout
		   コメント参照)。 */
		@media (min-width: 1300px) {
			.team-select-bar {
				position: sticky;
				top: var(--topbar-height);
				height: calc(100vh - var(--topbar-height));
			}
		}

		.team-select-search {
			flex: 0 0 auto;
			/* ソート行下のdividerを除き、一覧との間隔だけを残す。 */
			padding-bottom: 0;
			margin-bottom: var(--space-3);
		}
		.search-input-wrap {
			position: relative;
			display: flex;
			align-items: center;
		}
		.search-input-wrap .search-icon {
			position: absolute;
			left: 0.7em;
			color: var(--color-text-muted);
			pointer-events: none;
		}
		#pokemon-search-input {
			width: 100%;
			padding-left: 2.1em;
		}
		/* UI改修依頼(チーム編集左パネル)「ソート機能を追加する」。box/index.astroの
		   .sort-select-wrap/.sort-icon/.toolbar-sort selectと同じ値(アイコン左重畳+
		   select側padding-left)をこのページのスコープへ複製する(新しい値は作っていない)。 */
		/* 🔴 UI改修依頼(チーム編集左パネル、2026-08-01)「レギュレーションフィルタとソートを
		   横並びに配置する」。検索欄(#pokemon-search-input)は対象外で、この2つだけを
		   共通の行コンテナ(.team-select-filters-row、マークアップ側で新設)にまとめて
		   flexで横並びにする。レギュレーションフィルタが非表示(hidden、チームに
		   レギュレーション未指定のとき)のときはflex子がソート側1個だけになり、
		   自然に残り幅いっぱいへ広がる。 */
		.team-select-filters-row {
			display: flex;
			align-items: stretch;
			gap: var(--space-2);
			margin-top: var(--space-2);
		}
		.team-select-regulation-filter {
			flex: 1 1 0;
			min-width: 0;
			/* UI改修依頼(チーム編集左パネル、2026-08-02)「レギュレーションフィルタをトグル
			   スイッチに変更する」。旧来は塗りつぶしボタンが自身でwidth:100%; height:100%を
			   持ち隣のソートセレクトと縦の高さを揃えていたが、トグルスイッチ(ラベル+スイッチ、
			   コンテンツサイズ)はそれを持たないため、この行(align-items:stretchで高さが
			   ソートセレクト基準に伸びる)側でdisplay:flex; align-items:centerにして
			   トグルを縦中央に揃える。 */
			display: flex;
			align-items: center;
		}
		.team-select-regulation-filter[hidden] {
			display: none;
		}
		/* UI改修依頼(チーム編集左パネル、2026-08-02)「レギュレーションフィルタをトグル
		   スイッチに変更する」。ヘッダーの.collection-opt-out-toggle(「非公開」トグル、上の
		   フロントマター直後の<style>参照)と全く同じ視覚言語(inline-flex + gap + 本文小さめの
		   文字色)にする。トグル本体(.toggle-switch一式)は同じscoped<style>内で既に定義済みの
		   ものをそのまま使う(このページ内の別セクションなので複製不要)。 */
		.regulation-filter-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
			min-width: 0;
		}
		.regulation-filter-toggle span:last-child {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			min-width: 0;
		}

		/* UI改修依頼(右パネル サジェスト、2026-08-04)「メガシンカを含める」「育成済みのみ
		   表示」の2トグル。視覚言語は上の.regulation-filter-toggleと同一だが、そちらは
		   レギュレーション絞り込み専用の意味を持つクラス名のため、意味の異なるこちらの
		   トグルには専用クラス名を用意し、同じ値をそのまま複製する(新しい値は作っていない)。
		   #team-suggestはJS(renderSuggestions)がinnerHTMLで丸ごと書き換えるため、
		   トグル自体はその外(兄弟要素)の静的マークアップに置く。 */
		.team-suggest-toggles {
			display: flex;
			/* 同種の表示条件は1つの行として扱い、狭い場合だけ折り返す。 */
			flex-flow: row wrap;
			gap: var(--space-1);
			padding: var(--space-2) var(--space-3) 0;
		}
		.team-suggest-toggles[hidden] { display: none; }
		.team-suggest-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
			min-width: 0;
		}

		.team-select-sort {
			flex: 1 1 0;
			min-width: 0;
		}
		.team-select-sort .sort-select-wrap {
			position: relative;
			display: flex;
			align-items: center;
			height: 100%;
		}
		.team-select-sort .sort-select-wrap .sort-icon {
			position: absolute;
			left: 0.7em;
			color: var(--color-text-muted);
			pointer-events: none;
		}
		.team-select-sort select {
			width: 100%;
			padding-left: 2.1em;
		}

		.team-select-list-wrap {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			/* B-1は実装後にCoordinatorが差し戻した(round-30.md「Coordinatorの実測検証で
			   差し戻した変更」節)。29-R1と同型の margin-block: auto による上下中央寄せを
			   一度入れたが、実機では検索欄の直下に約310pxの空白が空き、リストが宙に浮いて
			   「検索欄と選択リストが別の帯」に見えた。同じラウンドでユーザーが右パネルに
			   対して「最上部」(31-R1)を明示し 29-R1 の中央寄せ自体を撤回しているため、
			   この帯にだけ同じパターンを新規導入するのは最新の方針と逆行する。
			   下端の空白(657px)は個体が増えれば自然に埋まる性質のものなので、
			   上端起点のまま据え置く。 */
			display: flex;
			flex-direction: column;
		}
		/* 1300px未満(選択バーが帯ではなく縦積みの通常ブロックになる、2026-08-02に1200px→
		   1300pxへ閾値変更、上の.team-edit-layoutコメント参照)では高さを固定せず、
		   代わりに際限なく伸びないよう上限を設ける(ボックスの個体数が多いユーザー向け)。 */
		@media (max-width: 1299px) {
			.team-select-list-wrap {
				max-height: 60vh;
			}
		}

		#pokemon-select-list {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		/* 選択バー内の空状態(0件/検索一致0件)。box/index.astroの.empty-stateと同じ語彙・見た目。 */
		.empty-state {
			margin-top: var(--space-4);
			padding: var(--space-5) var(--space-3);
			border: 1px dashed var(--color-border);
			border-radius: var(--radius-lg);
			text-align: center;
			color: var(--color-text-muted);
		}
		.empty-state-icon {
			font-size: 2rem;
			margin: 0 0 var(--space-2);
		}
		.empty-state-title {
			margin: 0 0 var(--space-1);
			font-size: var(--font-size-md);
			font-weight: 700;
			color: var(--color-text);
		}
		.empty-state-hint {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-sm);
		}

		/* --- 中央カラム: チーム名・メモ + 6枠(R-11: .panel-contentで1080pxに収める) ---
		   🔴 UI改修依頼(チーム編集画面、2026-08-02)「チームパネルの幅はポケモンカードが
		   ちょうど収まるサイズに狭める」。このカラム自体には幅を指定せず(.team-edit-layoutの
		   grid-template-columns側で754pxの固定トラックとして定義、上の.team-edit-layout
		   コメント参照)、グリッドトラック幅をそのまま受け取る。1300px未満(縦積み)では
		   幅指定が効かないブロック要素に戻り、100%幅で伸びる(固定幅は2カラム以上でのみ
		   意味を持つ)。 --- */
		.team-edit-main {
			min-width: 0;
			/* UI改修依頼(チーム編集中央パネル、2026-08-01)「左右のパネルとの間に余白を入れる」。
			   変更前は左パネル(.team-select-bar、右のborder-right)・右パネル(.team-preview-panel)
			   のどちらとも実測0pxで密着していた(.team-edit-mainにも.panel-contentにも横paddingが
			   無かったため)。.panelの既定横padding(var(--space-5)=20px)と同じ値をこの中央カラム自体に
			   も持たせ、左右どちらの隣接パネルとも視覚的な余白ができるようにする(.panel-contentの
			   max-width:1080pxはそのまま、余白ぶんだけ実効幅が狭まるがレイアウトは崩れない)。
			   🔴 2026-08-02: この左右padding(var(--space-5)=20px×2=40px)は、上の
			   .team-edit-layoutコメントに書いた754px固定幅の計算に含まれている
			   (754 = 230×3(カード) + 12×2(gap) + 20×2(このpadding))。 */
			padding: 0 var(--space-5);
		}
		/* UI改修依頼(チーム編集中央パネル、2026-08-02)「チーム名段の上に余白を追加する」。
		   .team-edit-mainは横paddingのみで縦paddingが無く、ヘッダー直下にチーム名欄が密着していた。
		   .panel-content(max-width:1080pxのみを持つ共有クラス、global.css)には触れず、
		   このページ限定でpadding-topを足す。 */
		.team-edit-main .panel-content {
			padding-top: var(--space-5);
		}
		/* 🔴 UI改修依頼(チーム編集画面、2026-08-01): チーム名の隣にレギュレーション選択を
		   並べる。チーム名は可変幅(1fr)、レギュレーションは中身(M-A等の短い値)に合った
		   固定幅で足りるため、2列グリッドにする。狭幅では縦積みに戻す(下の@media)。 */
		.team-meta-fields {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 12rem;
			gap: var(--space-3);
			align-items: end;
			margin-bottom: var(--space-6);
		}
		.team-meta-fields > .field { margin: 0; }
		.team-regulation-field select { width: 100%; }
		/* UI改修依頼(チーム編集中央パネル、2026-08-01)「"レギュレーション"ラベルを削除する。
		   他のUIと同様にplaceholderの色を薄くする」。LeftPanel.astroの
		   #edit-form #regulation[data-empty="true"]:not(:focus) と同じ値(破線・透明背景・
		   薄い文字色)を踏襲する(新しい値は作らない)。<select>には:placeholder-shownが無いため、
		   値が空のときだけJS/SSRが付けるdata-empty="true"を使う(<script>の
		   syncRegulationPlaceholder参照)。 */
		#team-regulation[data-empty="true"]:not(:focus) {
			border-style: dashed;
			background: transparent;
			color: var(--color-text-muted);
		}
		@media (max-width: 720px) {
			.team-meta-fields { grid-template-columns: 1fr; }
		}
		.team-name-input {
			width: 100%;
			/* global.cssの input[type="text"] { min-width: 12em } は、900px幅(2カラム化する
			   最小幅)で横スクロールを引き起こす下限になりうるため明示的に打ち消す
			   (width:100%で親に追従させる)。
			   🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「チーム名ボックスのサイズを
			   レギュレーションと揃えて小さくする」。旧来は--font-size-xl(24px)・font-weight:700
			   で目立たせていたが、隣の.team-regulation-field selectは既定の.field-controlサイズ
			   (font-sizeの上書きなし=inherit)のまま。この差でチーム名だけ縦に大きくずれて見えて
			   いたため、font-size/font-weightの上書きを撤去しレギュレーション欄と同じ既定サイズに
			   揃える。 */
			min-width: 0;
		}
		/* UI改修依頼(チーム編集中央パネル)「メモは下に移動」により6枠の下へ動いたため、
		   margin-topではなく6枠との間隔をteam-slots側のmargin-bottomで確保する
		   (このinput自体は他の場所にmarginを持たない)。 */
		.team-memo-input {
			width: 100%;
			min-width: 0;
		}

		/* UI改修依頼(チーム編集中央パネル)「2x3配置に変更」。1列縦積みから3列2行のグリッドへ。
		   UI改修依頼(チーム編集中央パネル、2026-08-02)「カードサイズを正方形のまま小さくする」。
		   3列(1fr)のグリッド自体は維持しつつ、各カード側で `width: min(100%, 230px)` に固定する
		   (下の.card-team-slot参照)。justify-items: center で各カードを列内で中央寄せにし、
