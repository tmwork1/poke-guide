---
// チーム編集ページ(docs/plan/pages/team.md「確定した設計 > 画面 > /team/[id](編集)」)。
// 初期表示データは box/[id].astro と同じ方針で、API経由のfetchではなくAstroのフロントマター
// (SSR)で src/lib/team.ts の getTeam() を直接呼び出す(初期表示が速く、「生のSupabaseクエリは
// lib層に集約する」という設計原則にも合致する)。
//
// 未ログイン時、および他人のチーム/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(box/[id].astroと同じ既存方針)。
export const prerender = false;


import AppLayout from '../../layouts/AppLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import { getSupabaseAdminClient, getSupabasePublicClient } from '../../lib/supabase';
import { getTeam, type Team } from '../../lib/team';
import { listRankedSeasons } from '../../lib/ranked-teams';
import { resolveDefaultSeason } from '../../lib/ranked-teams-validation';
import '../../styles/team-pokemon-card.css';
import '../../styles/team-mate-card.css';
import '../../styles/team-pokemon-tab.css';
import '../../styles/box-card.css';
import '../../styles/floating-list-controls.css';
import '../../styles/team-data-tab.css';
import '../../styles/team-card.css';
import '../../styles/app-header.css';
import '../../styles/matchup-panel.css';

const user = Astro.locals.user;
const id = Astro.params.id;

let team: Team | null = null;
let loadError = false;

if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getTeam(user.id, id, supabase);
	if (result.ok) {
		team = result.data;
	} else {
		loadError = true;
	}
	if (!team && !loadError) {
		Astro.response.status = 404;
	}
}

const pageTitle = 'チーム編集';
const bodyClass = team ? 'team-edit-page' : undefined;

// 初期メンバー(0〜6要素、SSR取得済み)をクライアント<script>へそのまま引き渡す。
// Astroの属性値は自動でHTMLエスケープされるので、ニックネーム等に " や < が
// 含まれていても壊れない(pokemon.tsの data-tags={JSON.stringify(...)} と同じ手法)。
const initialTeamJson = team
	? JSON.stringify({
			id: team.id,
			memo: team.memo,
			members: team.members,
		})
	: '';

let rankedSeason: string | null = null;
try {
	rankedSeason = resolveDefaultSeason(await listRankedSeasons(await getSupabasePublicClient()));
} catch (error) {
	console.error('[team/[id]] 類似構築のシーズン取得に失敗しました:', error);
}
---
<AppLayout title={pageTitle} current="team" bodyClass={bodyClass}>
	{team && (
		<AppHeader ariaLabel="チーム編集メニュー">
			<div class="app-header__list">
				<button type="button" class="app-header__item" data-mobile-tab="pokemon" data-active="true" aria-current="page"><span>ポケモン</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="formation"><span>編成</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="data"><span>類似チーム</span></button>
				<button type="button" class="app-header__item" data-mobile-tab="matchup"><span>相性</span></button>
			</div>
		</AppHeader>
	)}
	{/* #autosave-status/#autosave-status-textのid・DOM自体は<script>のel()参照
	    (見つからないとthrowしてJS初期化が止まる)のため残し、テキストだけを下の<style>で
	    常時非表示にする(保存失敗時=data-state="error"のときだけ見せる)。 */}
	{team && (
		<div class="team-mobile-actions" id="team-mobile-actions">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span>
				<button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>

		</div>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button {
			display: none;
			margin-left: 0.4em;
		}
		#retry-button.visible {
			display: inline-flex;
		}
		#autosave-status {
			margin: 0;
		}
		/* #autosave-status-text自体はDOM/idごと残し(<script>のel("autosave-status-text")が
		   throwするのを避けるため)、テキストだけを常時非表示にする。保存失敗
		   (data-state="error")のときだけ、唯一のリカバリ手段である#retry-buttonに気づけるよう
		   理由テキストを見せる(box/[id].astroと同じ判断)。 */
		#autosave-status-text {
			display: none;
		}
		#autosave-status[data-state="error"] #autosave-status-text {
			display: inline;
			color: var(--color-danger);
		}
		/* pitfalls.md「[hidden]は詳細度で負ける」: global.cssの.status-textが
		   display: inline-flexを持つため、UA既定の[hidden]{display:none}に勝ってしまい
		   hidden=trueにしても消えない。明示的に上書きする。 */
		#select-loading-message[hidden],
		#select-error-message[hidden] {
			display: none;
		}

		/* global.cssのbutton.btn-dangerが持つ太字指定を上書きし、
		   戻るボタン(.app-header-back)と同じ文字サイズ・太さへ揃える。 */
		#delete-team-button { width: 100%; font-size: var(--font-size-sm1); white-space: nowrap; font-weight: 500; }
		/* box/[id].astro の #delete-button と同じ配色に揃える。基底(global.css の
		   button.btn-danger)は平常時=塗り(background:var(--color-danger-strong),
		   color:var(--color-primary-contrast))、hover時=白地反転
		   (background:var(--color-surface), color:var(--color-danger-strong))。
		   #delete-team-buttonはIDセレクタで button.btn-danger より詳細度が高いため、
		   global.css自体は変更せずに上書きできる(他画面の.btn-danger既定配色は維持される)。
		   border(2px solid var(--color-danger-strong))は基底のまま変えない。
		   background/colorは平常時・hover時の両方で必ずセットで書く(片方だけ上書きすると
		   文字色=背景色になって見えなくなるため)。 */
		#delete-team-button {
			background: var(--color-surface);
			color: var(--color-danger-strong);
		}
		#delete-team-button:hover:not(:disabled) {
			background: var(--color-danger-strong);
			color: var(--color-primary-contrast);
		}


		/* --- 全体レイアウト: 左=ポケモン選択バー(帯)/ 中央=メモ・6枠(可読幅1080px) ---
		   docs/plan/00-foundation.md「レイアウト原則」どおり、選択バーは画面端から
		   画面端まで伸びる帯(.panel.panel-left)。中央は.panel-contentで1080pxに絞る(R-11)。
		   閾値を900px未満にしないこと: サイドバー(256px)+選択バー(約380px)を引くと中央カラムが
		   約264pxしか残らず、横長の6枠カードを入れるとポケモン名・技名が1文字ずつ縦に折り返されて
		   読めなくなる(box/[id].astroの.edit-layoutが900px→1200pxに引き上げた罠、
		   docs/plan/00-foundation.md 245行目と同一原因)。
		   中央カラム(チーム6枠)は`1fr`(可変)ではなく754pxの固定幅、右カラム(プレビュー)は固定
		   `minmax(280px, 340px)`ではなく下限だけ残した可変幅`minmax(240px, 1fr)`にする
		   (値の根拠は下の各ルールのコメント参照)。中央カラムが固定幅のため、2カラム化に
		   必要な最小横幅もそれに応じて決める(根拠は直後の@media 2件のコメント参照)。 */
		.team-edit-layout {
			display: block;
		}
				/* .team-select-barの幅304px(下限240px)は、380px(.team-select-bar幅の上限)を
				   0.8倍したもの。下限(min)も同じ比率で300px→240pxへ縮めている
				   (min/maxの比率を変えないため)。
				   中央カラムの754pxはポケモンカードがちょうど収まる幅:
				   754px = カード230px×3枚 + gap(var(--space-3)=12px)×2 + 左右padding
				   (var(--space-5)=20px)×2 = 690+24+40 = 754px(.team-edit-mainのpadding分)。
				   閾値1300pxの根拠: 中央カラムが固定幅754pxのため、2カラム化に必要な
				   最小横幅はサイドバー(256px)+選択バー最小(240px)+チーム(754px)=1250px。
				   1250px前後では余裕がほぼ無いため、安全マージンを見て1300pxにしている。 */
		/* box/[id].astroの.edit-layout(3カラム化、RightPanel.astro参照)と同じ考え方で
		   3カラム目(.team-preview-panel)を追加する。2カラム時(下の閾値未満)では右パネルは
		   非表示にする(下の.team-preview-panel参照)。幅が無いところに無理に3カラム目を
		   押し込むと中央カラムの6枠カードが再び潰れるため(上のコメントの実測バグと同じ罠)。
		   右カラムは固定`minmax(280px, 340px)`ではなく下限だけ残した`minmax(240px, 1fr)`
		   (下限240pxはbox/[id].astroの右パネル`minmax(300px, 360px)`と同様、潰れ防止の
		   下限を残すパターンを踏襲。上限を`1fr`にして残り幅を丸ごと割り当てる)。
		   閾値1650pxの根拠: 3カラム時に必要な最小横幅は2カラム時の1250px(256+240+754)に
		   右パネルの下限240pxを足した1490px。1490px前後では右パネルが窮屈になるため、
		   安全マージンを見て1650pxにしている。 */

		.team-select-bar {
			display: flex;
			flex-direction: column;
			min-width: 0;
			/* 共通.panelの上paddingを既存トークンで2段階詰め、検索欄を上へ寄せる。 */
			padding-top: var(--space-4);
		}
		/* box/[id].astroの.panel-leftと同じ考え方: トップバー直下から画面下端まで帯を伸ばす。
		   帯自体の高さはビューポート基準(calc(100vh - var(--topbar-height)))で決め、
		   個体数が少なくても背景色が画面下端まで届くようにする。2カラム化未満(縦積み)では
		   sticky/固定高さにせず、通常のブロックとして中央カラムの上に積む(box/[id].astroの
		   .edit-layout-leftが2カラム化のメディアクエリでだけheight:100%を付けているのと
		   同じ考え方。縦積み時に選択バーが画面いっぱいの高さを占有すると、6枠に到達するまで
		   1画面ぶん余計にスクロールする羽目になる)。閾値は.team-edit-layoutの2カラム化と
		   必ず揃えること(根拠は上の.team-edit-layoutコメント参照)。 */

		.team-select-search {
			flex: 0 0 auto;
			/* ソート行下のdividerを除き、一覧との間隔だけを残す。 */
			padding-bottom: 0;
			margin-bottom: var(--space-3);
		}
		.team-select-search .search-input-wrap {
			/* global.cssの一覧用flex伸長をこの縦積み検索欄へ持ち込まず、従来の初期値を維持する。 */
			flex: 1 1 auto;
			min-width: 0;
		}
		/* 検索を伸縮、並べ替えを内容幅にして同じ行へ収める。 */
		/* 実測ではplaceholder表示に159.6px必要だが検索欄は159.22pxだったため、gapを4pxに縮めて163.2pxを確保する。
		   両要素は.field-controlの枠線を持つため、狭い幅でも4pxの間隔で視覚的に分離できる。 */
		.team-select-search-row { display: flex; gap: var(--space-1); align-items: stretch; }
		#pokemon-search-input {
			width: 100%;
			/* 1920px DOM実測でplaceholderの安全余裕が5.2125pxしかなかったため、
			   2.1em(33.6px)から29pxへ詰める。アイコン右端は0.7em + 15px =
			   26.2pxで、入力文字の開始位置まで2.8pxを確保できる。 */
			padding-left: 29px;
		}
		/* box/index.astroの.sort-select-wrap/.sort-icon/.toolbar-sort selectと同じ値
		   (アイコン左重畳+select側padding-left)をこのページのスコープへ複製する
		   (新しい値は作っていない)。 */
		/* 検索欄(#pokemon-search-input)は対象外で、お気に入り・重複除外の各トグルと件数だけを
		   共通の行コンテナ(.team-select-filters-row、マークアップ側で新設)にまとめて
		   flexで横並びにする。 */
		.team-select-filters-row {
			display: flex;
			flex-wrap: nowrap;
			align-items: stretch;
			gap: var(--space-1);
			margin-top: var(--space-2);
		}
		.team-select-filters-row > .regulation-filter-toggle {
			/* 294pxの行に2トグルと件数を同居させるため、既存の最小文字トークンを使う。 */
			font-size: var(--font-size-sm3);
		}
		.team-select-count {
			margin-left: auto;
			align-self: center;
		}
		.team-select-count[hidden] { display: none; }
		/* 選択バー内の表示条件トグルを共通の視覚言語(inline-flex + gap +
		   本文小さめの文字色)にする。 */
		.regulation-filter-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			font-size: var(--font-size-sm2);
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
			min-width: 0;
		}
		.regulation-filter-toggle span:last-child {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			min-width: 0;
		}

		/* 「メガシンカを含める」「育成済みのみ表示」の2トグル。選択バーの表示条件トグルと
		   同じ値を使うが、意味の異なるこちらには専用クラス名を用意する。
		   #team-suggestはJS(renderSuggestions)がinnerHTMLで丸ごと書き換えるため、
		   トグル自体はその外(兄弟要素)の静的マークアップに置く。 */
		.team-suggest-toggles {
			display: flex;
			/* 同種の表示条件は1つの行として扱い、狭い場合だけ折り返す。 */
			flex-flow: row wrap;
			gap: var(--space-1);
			padding: var(--space-2) var(--space-3) 0;
		}
		.team-suggest-toggles[hidden] { display: none; }
		.team-suggest-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			font-size: var(--font-size-sm2);
			color: var(--color-text-muted);
			white-space: nowrap;
			cursor: pointer;
			min-width: 0;
		}

		.team-select-sort {
			flex: 0 0 auto;
		}
		.team-select-sort .sort-select-wrap {
			height: 100%;
			/* global.cssの一覧用flex伸長を持ち込まず、従来の初期値を維持する。 */
			flex: initial;
		}
		.team-select-sort select {
			/* 最長ラベル64pxを保ったまま検索欄へ幅を戻す。アイコン右端は26.2pxなので、
			   29pxの左paddingでも文字との間に2.8px残り、重ならない。 */
			width: auto;
			min-width: 0;
			padding-left: 29px;
		}

		.team-select-list-wrap {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			/* カード右端とスクロールバーが接触しないよう最小限の余白を確保する。 */
			padding-right: var(--space-2);
			/* margin-block: auto による上下中央寄せは、個体数が少ない間は検索欄の直下に
			   大きな空白が生まれ、リストが宙に浮いて見えるため使わない。上端起点で配置し、
			   下端の空白は個体数が増えれば自然に埋まる。 */
			display: flex;
			flex-direction: column;
		}
		/* 選択バーが帯ではなく縦積みの通常ブロックになる幅(1300px未満、上の.team-edit-layout
		   コメント参照)では高さを固定せず、代わりに際限なく伸びないよう上限を設ける
		   (ボックスの個体数が多いユーザー向け)。 */
		.team-select-list-wrap {
			max-height: 60vh;
		}

		#pokemon-select-list {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		/* 選択バー内の空状態(0件/検索一致0件)。box/index.astroの.empty-stateと同じ語彙・見た目。 */

		/* --- 中央カラム: メモ + 6枠(.panel-contentで1080pxに収める) ---
		   このカラム自体には幅を指定せず(.team-edit-layoutのgrid-template-columns側で
		   754pxの固定トラックとして定義、上の.team-edit-layoutコメント参照)、グリッドトラック幅を
		   そのまま受け取る。1300px未満(縦積み)では幅指定が効かないブロック要素に戻り、
		   100%幅で伸びる(固定幅は2カラム以上でのみ意味を持つ)。 --- */
		.team-edit-main {
			min-width: 0;
			/* 左パネル(.team-select-bar、右のborder-right)・右パネル(.team-preview-panel)との
			   間に視覚的な余白を作るため、.panelの既定横padding(var(--space-5)=20px)と同じ値を
			   この中央カラム自体にも持たせる(.panel-contentのmax-width:1080pxはそのまま、
			   余白ぶんだけ実効幅が狭まるがレイアウトは崩れない)。
			   この左右padding(var(--space-5)=20px×2=40px)は、上の.team-edit-layoutコメントに
			   書いた754px固定幅の計算に含まれている
			   (754 = 230×3(カード) + 12×2(gap) + 20×2(このpadding))。 */
			padding: 0 var(--space-5);
		}
		/* .team-edit-mainは横paddingのみで縦paddingが無く、ヘッダー直下に内容が密着する。
		   .panel-content(max-width:1080pxのみを持つ共有クラス、global.css)には触れず、
		   このページ限定でpadding-topを足す。 */
		.team-edit-main .panel-content {
			padding-top: var(--space-5);
		}

		/* 1列縦積みではなく3列2行のグリッド。各カード側で `width: min(100%, 230px)` に固定する
		   (下の.card-team-slot参照)。justify-items: center で各カードを列内で中央寄せにし、
		   縮めた余白を列内に均等配分する(片側だけに空白が寄るのを防ぐ)。
		   カード高さは`aspect-ratio: 1/1`で固定すると技リストが見切れるため使わない
		   (下の.card-team-slotコメント参照)。align-itemsを明示していないため、
		   CSS Gridの既定(stretch)により同じ行の3枚は自動的に同じ高さへ揃う
		   (1〜3枚目・4〜6枚目それぞれの行内で不揃いにならない)。 */
		.team-slots {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			justify-items: center;
			gap: var(--space-3);
			/* 空枠を含む全トラックを同じ高さにし、設定状態による位置・寸法差をなくす。 */
			grid-auto-rows: 1fr;
			margin-bottom: var(--space-4);
		}

		/* --- 右: プレビューパネル。box/[id].astroのRightPanel.astroと同じ考え方で、
		   3カラム化の閾値未満では表示しない(グリッド自体も2カラムのため。閾値は
		   上の.team-edit-layoutコメント参照、.team-edit-layoutの3カラム化のメディアクエリと
		   必ず揃えること)。幅自体は.team-edit-layoutのgrid-template-columns側
		   (`minmax(240px, 1fr)`)で決まるため、このルールでは幅を指定しない。 --- */
		.team-preview-panel {
			display: none;
		}
		.team-preview-empty {
			color: var(--color-text-muted);
			font-size: var(--font-size-sm2);
		}

		/* 「帯状の背景色付きセクション見出し」クラスは他画面に見当たらなかった
		   (global.cssの.panel-topは区切り線のみで背景色を持たない)ため、既存トークンだけを
		   使って新規に作る(新しい色は増やさない: 背景は--color-bg、区切り線は
		   --panel-topと同じ--color-border)。
		   .team-preview-panelは.panelの既定padding(var(--space-6) var(--space-5))を継承する
		   ため、この帯だけを画面(パネル)端まで伸ばす帯にするには同じ値の負マージンで打ち消し、
		   内側に同じ値のpaddingを付け直す(帯の外は.panelの背景、帯の内側の文字位置だけは
		   paddingが無い場合と揃う)。 */
		.team-panel-header-band {
			margin: calc(var(--space-6) * -1) calc(var(--space-5) * -1) var(--space-3) calc(var(--space-5) * -1);
			padding: var(--space-3) var(--space-5);
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-border);
		}
		.team-panel-header-band[hidden] { display: none; }
		/* 個体プレビューとサジェストの見出しを1つの帯に統一する。 */
		.team-panel-header-title {
			margin: 0;
			font-size: var(--font-size-sm2);
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

	</style>

	<div class="page">
		{
			!user ? (
				<section class="panel">
