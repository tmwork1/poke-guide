		}
	</div>

	{/* --- JS生成要素(選択バーの行・6枠カード)のスタイル。pitfalls.md「Astroのscoped styleは
	    JSで生成した要素に効かない」に従い is:global で定義する。.team-select-bar / .team-slots
	    配下に限定したセレクタにしてグローバルへ漏れないようにする。 --- */}
	<style is:global>
		/* ------------------------------------------------------------------ */
		/* 選択バーの1行(.pokemon-select-row)                                  */
		/* 行全体を1個の<button>にする構造ではなく、「プレビュー用button(.select-row-main)」+
		   「編集リンク(.select-row-edit-link)」を横に並べる<div>構造にする
		   (<button>の中に<a>を入れることはHTML的に無効なため)。 */
		/* ------------------------------------------------------------------ */
		.team-select-bar .pokemon-select-row {
			display: flex;
			align-items: stretch;
			gap: var(--space-2);
			width: 100%;
		}
		/* ドラッグ中の行自身を半透明にして「持ち上げている」感を出す(is-dragging、
		   <script>のdragstart/dragend参照)。 */
		.team-select-bar .pokemon-select-row.is-dragging {
			opacity: 0.5;
		}
		/* box/index.astroの.card-pokemon(スプライト→カード名(中央揃え)→テラスタイプ→
		   特性/持ち物→技2列)と同じ縦積みレイアウトにする。box側のCSSは/boxでしか読み込まれない
		   (<style is:global>がbox/index.astro内に閉じているため)ため、値をこのページへ複製する
		   (box/index.astro・global.cssは編集禁止)。お気に入り(.pin-toggle)・削除ボタンは
		   このパネルの用途(チームに追加する候補を選ぶピッカー)には不要なため持ち込まない。
		   左パネルの帯は最大304px(.team-edit-layoutのgrid-template-columns参照、実測でも
		   内側パディングを引くと264px程度)しかなく、box一覧のカード(約210〜240pxの正方形
		   グリッド)と違い縦一列に並ぶリストのため、aspect-ratio: 1/1は使わずカードの高さは
		   中身に応じた自然な高さのままにする。 */
		.team-select-bar .select-row-main {
			flex: 1 1 auto;
			min-width: 0;
			display: grid;
			grid-template-columns: calc(var(--space-7) + var(--space-6)) minmax(0, 1fr);
			align-items: center;
			column-gap: var(--space-1);
			row-gap: var(--space-1);
			padding: var(--space-1);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			text-align: left;
			cursor: pointer;
		}
		.team-select-bar .select-row-main:hover:not(:disabled) {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		.team-select-bar .select-row-main:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		/* 選択不可(基準6・7・21): グレーアウト + 理由を常時テキスト表示する(titleに頼らない)。
		   なお選択不可でもプレビュー(1回クリック)は引き続きできる(disabledはダブルクリックの
		   追加操作だけを止めるためのものではなく、ボタン全体を無効化する。プレビューはボタン
		   要素自体をclickするため、disabled中はプレビューも一緒に止まる。「選べない個体は
		   詳細も見られない」状態は既存のブロック理由表示(select-row-reason)と矛盾しないため
		   許容する)。 */
		.team-select-bar .select-row-main:disabled {
			cursor: not-allowed;
			opacity: 0.55;
		}
		/* スプライト(box/index.astroの.card-artと同じ「絵を主役にする」考え方)。box一覧の
		   min(56%, 113px)は正方形グリッドの1マス基準の式で、このカード(単列リスト、幅約264px)
		   にそのまま当てはめると1行が縦に伸びすぎるため、実測しながら88pxに固定した
		   (狭幅240px時でも名前・技名が1文字ずつ折り返らないことを確認、報告参照)。 */
		.team-select-bar .select-row-art {
			position: relative;
			flex: 0 0 auto;
			width: calc(var(--space-7) + var(--space-6));
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
		}
		.team-select-bar .select-row-sprite-img {
			width: 100%;
			height: calc(var(--space-7) + var(--space-6));
			object-fit: contain;
		}
		.team-select-bar .select-row-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: calc(var(--space-7) + var(--space-6));
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 1.2rem;
		}
		.team-select-bar .select-row-body {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-1);
			width: 100%;
			min-width: 0;
		}
		/* カード名+テラスタイプ(box/index.astroの.card-name-row)。名前は中央揃えの1行
		   ellipsisで、テラスバッジぶんの幅はflexで自動的に譲る。 */
		.team-select-bar .select-row-name-row {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			width: 100%;
			min-width: 0;
			grid-column: 1 / -1;
		}
		.team-select-bar .select-row-name {
			min-width: 0;
			/* 2行目のNNは中央配置を保ち、既存の小サイズトークンへ縮める。 */
			font-size: var(--font-size-sm2);
			font-weight: 700;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.team-select-bar .select-row-tera-badge {
			flex: none;
			width: 18px;
			height: 18px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-select-bar .select-row-tera-badge img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			filter: drop-shadow(0 0 1px var(--color-surface));
		}
		/* アイテムとテラスタルを本文内の同じ段に並べる。 */
		.team-select-bar .select-row-art-badges {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			width: 100%;
		}
		/* 特性+持ち物(box/index.astroの.card-item-row=grid 2列/.card-item-row-cell=flex
		   中央寄せと同じ作り。持ち物なしの個体でもセル自体は常に出し、中身(アイコン+名前)
		   だけ値がある場合に足す。値が無い方のセルが空でも2列グリッドは崩れない)。 */
		.team-select-bar .select-row-item-row {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: center;
			width: 100%;
			gap: var(--space-1);
		}
		.team-select-bar .select-row-item-row-cell {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			min-width: 0;
		}
		.team-select-bar .select-row-ability-name {
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
			font-weight: 600;
			color: var(--color-text-muted);
			max-width: 100%;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.team-select-bar .select-row-item-badge {
			flex: none;
			width: calc(var(--space-4) * 1.32);
			height: calc(var(--space-4) * 1.32);
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-select-bar .select-row-item-badge img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-select-bar .select-row-item-name {
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
			font-weight: 600;
			color: var(--color-text-muted);
			max-width: 100%;
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* 技(box/index.astroの.card-moves-grid/.card-move-chipと同じ2列グリッド。本日/box側で
		   確立した最新仕様: 技名の前にタイプアイコン、背景色は付けない、セル内では左揃え。 */
		.team-select-bar .select-row-moves {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
			gap: var(--space-1);
			width: 100%;
		}
		.team-select-bar .select-row-move-chip {
			display: flex;
			align-items: center;
			gap: var(--space-1);
			min-width: 0;
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
			font-weight: 600;
			color: var(--color-text-muted);
			text-align: left;
		}
		.team-select-bar .select-row-move-chip-icon {
			flex: none;
			width: 10px;
			height: 10px;
			object-fit: contain;
		}
		.team-select-bar .select-row-move-chip-text {
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* 技未設定時も高さを維持するため、最低高さを確保する。 */
		.team-select-bar .select-row-move-chip-unset {
			min-height: 1.2em;
		}
		/* A-3(a): 「編成済み」(already-in-team、正常)と禁止3種(6体編成済み/種族が重複/
		   持ち物が重複)が同じ危険色・同じ書式だったため、4/6のように複数体が既に編成済み
		   だと選択バー全体が赤く見え「エラーが起きている」と誤読された。data-reasonで
		   実質3値(選べる/もう入っている/禁止)を色で伝える。--color-danger-strongは
		   自動保存失敗の表示(#autosave-status)と共有するトークンなので、正常状態からは
		   外す。新色は作らない。 */
		.team-select-bar .select-row-reason {
			/* A-3(b): 0.74rem(11.84px)は12px下限を割っていたため、12pxのトークンに是正。 */
			font-size: var(--font-size-sm3);
			font-weight: 700;
			width: 100%;
		}
		.team-select-bar .select-row-reason[data-reason="already-in-team"] {
			color: var(--color-text-muted);
			font-weight: 600;
		}
		.team-select-bar .select-row-reason:not([data-reason="already-in-team"]) {
			color: var(--color-danger-strong);
		}
		/* 要素を「消す」指示はDOMを残しCSSで見せない方針にする(pitfalls.md)。要素自体
		   (buildSelectRowのdragHandle)・row.appendChildは残したまま、display: noneで見た目
		   だけ消す。ドラッグ&ドロップ自体(row.draggable=true、rowのdragstart/dragend)は
		   このグリップ要素と無関係(rowが直接draggable/イベントを持つ)なので、動作は維持される。 */
		.team-select-bar .select-row-drag-handle {
			display: none;
		}
		/* ------------------------------------------------------------------ */
		/* 6枠カード(.card-team-slot)。中身はfilled/emptyのいずれか(R-8)。       */
		/* ボックス画面の.card-pokemonと同じ縦積み(絵を中央上・情報を下)にする(3列グリッドの
		   1マスは幅が半分弱に狭まるため、横並びだと窮屈になる)。position:relativeは番号
		   ウォーターマーク(下記.slot-watermark-number)・編集/削除ボタンの絶対配置の基準になる。 --- */
		/* aspect-ratio: 1/1 で正方形を基本形にしつつ、height: auto + min-height: auto を
		   併用することで、技リストなど中身の必要高がカード幅を超える場合はそのぶんだけ
		   縦へ伸ばせるようにする(overflow: hiddenで固定高に切り詰めると技リストが物理的に
		   見切れるため使わない。.slot-artは自身の固定width/heightとobject-fit: containで
		   完結しており、親のoverflowには依存していない)。
		   幅230pxは、幅を縮めつつ中身(絵・名前・特性/持ち物・実数値6列・技2x2)が1文字ずつの
		   折り返しを起こさない範囲として調整した値なので、width側は維持する
		   (下のslot-art等のサイズ・line-height明示的な引き締めもそのまま踏襲する)。
		   高さはCSS Gridの既定の行内ストレッチ(.team-slots側にalign-itemsの上書きが無いため、
		   同じグリッド行の3枚は自動的に同じ高さになる)に委ね、1〜3枚目・4〜6枚目の不揃いを防ぐ。 */
		.team-slots .card-team-slot {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			/* 正方形で余る高さを上下へ均等に配り、下端だけに余白をためない。 */
			justify-content: center;
			text-align: center;
			gap: var(--space-1);
			/* 230pxの上限では技の最終行が正方形からはみ出すため、既存の列幅を使い切って
			   内部要素を縮めずに必要な縦幅を確保する。 */
			width: 100%;
			aspect-ratio: 1 / 1;
			height: auto;
			/* 中身の必要高を下限にして、狭い列だけ縦へ伸ばす。行高への追従も明示し、内容量が
			   少ない同じ行のカードだけ短くなるのを防ぐ。 */
			min-height: auto;
			padding: var(--space-2);
		}
		/* ドラッグ&ドロップの受け入れ先であることを示すハイライト(左パネルのpokemon-select-row
		   または埋まっている枠自身をドラッグ中にこのカードの上に重なると付く。
		   <script>のドラッグハンドラ参照)。 */
		.team-slots .card-team-slot.is-drop-target {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		/* 埋まっている枠(<script>のrenderSlotsがdata-filled="true"のときだけclick/dblclickを
		   付与)だけをクリック可能にする(空き枠は何も起きないためカーソルを変えない)。
		   埋まっている枠はdraggableにもなるため、ドラッグ中は左パネルの選択行
		   (.pokemon-select-row.is-dragging)と同じ「持ち上げている」見た目(半透明)にする。 */
		.team-slots .card-team-slot[data-filled="true"] {
			cursor: pointer;
		}
		.team-slots .card-team-slot[data-filled="true"]:hover {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 95%, var(--color-primary) 5%);
		}
		/* 上のhoverと同系統の強調(border-color: var(--color-primary))だが、常時ハイライトだと
		   分かるよう背景の混色比率をhoverより濃くする(<script>のcard.click/documentのclick
		   監視参照)。 */
		.team-slots .card-team-slot.is-selected {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		.team-slots .card-team-slot.is-dragging {
			opacity: 0.5;
		}
		/* 候補→枠のD&D自体は既に実装済み(<script>のdragover/dragleave/drop、assignToSlot参照)。
		   全ての空き枠は同じ非アクションの<div>(ドラッグ&ドロップでの追加だけを受け付ける)に
		   する(<script>のbuildEmptySlotContent参照)。 */
		.team-slots .slot-empty-cta {
			flex: 1 1 auto;
			width: 100%;
			display: flex;
			/* 上の.card-team-slotコメントの縦積みに揃え、空き枠プレースホルダーもカードの
			   中央にラベルを配置する。 */
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-2);
			background: transparent;
			border: 0;
			padding: 0;
			color: var(--color-text-muted);
			opacity: 0.55;
			/* font-weight:600(太字)は他画面の検索欄placeholder等より主張が強すぎるため、通常の
			   太さにする(色は既存のvar(--color-text-muted)のまま、両テーマ対応を崩さない)。 */
			font-weight: 400;
			font-size: var(--font-size-sm1);
			cursor: default;
			text-align: center;
			white-space: pre-line;
		}

		/* position:absoluteでカード左上に重ね、回転+低い不透明度でウォーターマーク化する
		   (pointer-events:noneでクリックの邪魔をしない)。他の要素(スプライト・編集/削除
		   ボタン等)より奥に見えるよう z-index:0 にし、実コンテンツ側(.slot-art/.slot-info/
		   .slot-empty-cta)にz-index:1を与えて手前に出す。状態の違い(埋まり/空き)は
		   opacityの濃淡だけで表現する(色だけに頼る訳ではなく、番号という文字情報自体は
		   両状態とも同じ意味=「何番目の枠か」を表すため、色分けではなく濃淡で十分)。 */
		.team-slots .slot-watermark-number {
			position: absolute;
			/* カードの内側余白と同じ基準線へそろえる。 */
			top: var(--space-2);
			left: var(--space-2);
			z-index: 0;
			font-size: 2.75rem;
			font-weight: 800;
			line-height: 1;
			color: var(--color-text-muted);
			opacity: 0.14;
			pointer-events: none;
			user-select: none;
		}
		.team-slots .card-team-slot[data-filled="false"] .slot-watermark-number {
			opacity: 0.22;
		}
		.team-slots .slot-art,
		.team-slots .slot-info,
		.team-slots .slot-empty-cta {
			position: relative;
			z-index: 1;
		}
		.team-slots .slot-art {
			flex: 0 0 auto;
			/* box/index.astroのカードは公式絵に幅の過半(min(56%, 113px))を割り当てて一覧性より
			   絵の存在感を優先している。このカード(1辺約290〜310px、box一覧の210〜240pxより
			   大きい)でも同じ考え方で、名前・メタ情報より絵が主役に見える比率にする。 */
			width: calc(var(--space-7) * 2 + var(--space-5));
			height: calc(var(--space-7) * 2 + var(--space-5));
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-slots .slot-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-slots .slot-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 1.4rem;
		}
		.team-slots .slot-info {
			flex: 1 1 auto;
			min-width: 0;
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-1);
		}
		/* NN・テラスアイコン・編集ボタンを1つの横並び(flex)にまとめ、その全体をカード幅の中で
		   中央寄せする(=NNの右隣にテラスアイコン、さらにその右に編集ボタンが並ぶ)。
		   テラスアイコンは後述のとおりテキストラベルを持たないアイコンのみのバッジにする。 */
		.team-slots .slot-name-row {
			display: flex;
			align-items: center;
			justify-content: center;
			flex-wrap: wrap;
			gap: var(--space-1);
			min-width: 0;
			width: 100%;
		}
		.team-slots .slot-nickname {
			min-width: 0;
			font-size: var(--font-size-base);
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		/* テキストラベルの<span>を生成しない(buildFilledSlotContent参照)ため、この要素は
		   特性セル内でアイコン1個だけを収める。テラスタイプ名はtitle/aria-labelに残し
		   アクセシビリティ上の情報量は落とさない。.slot-meta-item は特性セル内のテラス
		   アイコン専用で、背景や枠を付けず画像だけを見せる。 */
		.team-slots .slot-meta-item {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex: 0 0 auto;
		}
		/* 中間幅でも本文を画像の右に置き、各情報段の横幅を確保する。 */
		.team-select-bar .select-row-body { grid-column: auto; }
		.team-select-bar .select-row-name-row { grid-column: auto; justify-content: center; }
		.team-select-bar .select-row-art-badges {
			position: static;
			grid-column: auto;
			grid-row: auto;
			flex-direction: row;
			justify-content: center;
		}
		.team-slots .slot-meta-icon {
			width: calc(var(--space-4) * 1.1);
			height: calc(var(--space-4) * 1.1);
			object-fit: contain;
		}
		/* 特性とアイテムを別行にし、各行の内容は中央にそろえる。 */
		.team-slots .slot-meta-row {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 100%;
			gap: var(--space-1);
			font-size: var(--font-size-sm2);
			color: var(--color-text-muted);
			/* bodyの既定line-height:1.6を打ち消さずに継承すると、1行しか無いチップ状の表示には
			   不要な行間になる。var(--line-height-tight)(1.25)で引き締める(1200〜1600px帯で
			   技の2段目が見切れる問題の解消にも寄与する。上の.card-team-slotコメント参照)。 */
			line-height: var(--line-height-tight);
		}
		.team-slots .slot-meta-cell {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			min-width: 0;
			width: 100%;
		}
		/* 性格と努力値はカード幅を使う1行表示とし、ボックス一覧と情報順を揃える。 */
		.team-slots .slot-training {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			width: 100%;
			min-height: var(--space-4);
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
			color: var(--color-text-muted);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			text-align: center;
		}
		/* 特性/持ち物ラベルに1行ellipsis制御が無いと、幅が縮んだ場合に長い文字列が単語の途中で
		   2行に折り返る(buildFilledSlotContentのコメント参照)。.slot-nicknameと同じ制御を
		   ability/itemラベルにも適用する。 */
		.team-slots .slot-meta-text {
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			line-height: var(--line-height-tight);
		}
		/* A-6: 特性が未設定のとき(ゲーム上「値が無い」状態が存在しない項目)を明示するための強調。
		   新色は作らず既存の--color-danger-strongを流用する。持ち物(合法な空)には使わない。
		   テラスタイプは未設定時に行ごと非表示にするため、この強調の対象からは外れる
		   (buildFilledSlotContent参照。クラス自体は特性向けに引き続き使う)。 */
		.team-slots .slot-meta-unset {
			color: var(--color-danger-strong);
			font-weight: 700;
		}
		/* 右パネルのbuildDamageCard内.team-damage-stats/.team-damage-stats-line
		   (6列ラベル行+実数値行)と同じ考え方をこのカードにも適用する。 */
		.team-slots .slot-stats {
			display: grid;
			grid-template-columns: repeat(6, auto);
			justify-content: center;
			column-gap: var(--space-2);
			width: 100%;
		}
		.team-slots .slot-stats-line {
			display: contents;
		}
		/* line-heightをvar(--line-height-tight)(1.25、bodyの既定1.6から)に引き締め、
		   1200〜1600px帯で技の2段目が見切れる問題(上の.card-team-slotコメント参照)の
		   解消に充てる。 */
		.team-slots .slot-stat-key {
			font-size: var(--font-size-sm3);
			font-weight: 700;
			color: var(--color-text-muted);
			text-align: center;
			line-height: var(--line-height-tight);
		}
		.team-slots .slot-stat-key[data-mod="up"] { color: var(--color-danger-strong); }
		.team-slots .slot-stat-key[data-mod="down"] { color: var(--color-primary); }
		.team-slots .slot-stat-value {
			font-size: var(--font-size-sm3);
			font-weight: 700;
			text-align: center;
			line-height: var(--line-height-tight);
		}
		/* 技数によって並びが不揃いになるflex-wrapではなく、box/index.astroの.card-moves-gridと
		   同じ2列固定gridにする。 */
		.team-slots .slot-moves {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
			/* カード内の縮尺をそろえるため、縦横とも既存スペーシングトークンを使う。 */
			gap: calc(var(--space-1) * 0.6) var(--space-1);
			width: 100%;
		}
		.team-slots .slot-move-chip {
			display: flex;
			align-items: center;
			gap: var(--space-1);
			min-width: 0;
			font-size: var(--font-size-sm3);
			font-weight: 600;
			color: var(--color-text-muted);
			padding: calc(var(--space-1) * 0.32) 0;
			text-align: left;
			/* line-heightをvar(--line-height-tight)に引き締める(上のslot-stat-keyコメントと
			   同じ理由)。 */
			line-height: var(--line-height-tight);
		}
		.team-slots .slot-move-chip-icon {
			flex: none;
			width: var(--space-3);
			height: var(--space-3);
			object-fit: contain;
		}
		.team-slots .slot-move-chip-text {
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* A-6: 技0件の明示。同じく--color-danger-strongを流用する。 */
		.team-slots .slot-move-chip-unset {
			color: var(--color-danger-strong);
			border-color: var(--color-danger-strong);
			font-weight: 700;
		}
		/* 削除ボタンはカード(.card-team-slot、position:relative)自身の右上端に絶対配置する
		   (box/index.astroの.card-pokemon .card-actions=28px円形アイコンボタン規格を踏襲、
		   新しい値は作らない)。box/index.astroの.card-pokemon .delete-button
		   (src/pages/box/index.astro、読むだけで編集はしない)の配色・font-weightに合わせる:
		   background/borderは.icon-button共通のまま、font-weight: 400(box側は「global.cssの
		   .delete-buttonは太字パディングでアイコン専用ボタンには大きすぎる」という理由で明示的に
		   上書きしている)。ホバーはbackground: var(--color-danger-soft) +
		   border-color: var(--color-danger-strong)で危険操作であることを示す。
		   hover/focus-within限定表示とタッチ時の常時表示も同じ方針で適用する。 */
		.team-slots .slot-remove-btn {
			position: absolute;
			top: var(--space-2);
			right: var(--space-2);
			z-index: 2;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-danger-strong);
			font-weight: 400;
			box-shadow: var(--shadow-sm);
			opacity: 0;
			pointer-events: none;
		}
		/* マウスでは誤操作を避け、キーボード操作とタッチ操作では到達可能に保つ。 */
		.team-slots .card-team-slot:hover .slot-remove-btn,
		.team-slots .card-team-slot:focus-within .slot-remove-btn {
			opacity: 1;
			pointer-events: auto;
		}
		@media (hover: none) {
			.team-slots .slot-remove-btn { opacity: 1; pointer-events: auto; }
		}
		.team-slots .slot-remove-btn:hover {
			background: var(--color-danger-soft);
			color: var(--color-danger-strong);
			border-color: var(--color-danger-strong);
		}
		/* 3列グリッドの右端セル固定ではなく.slot-name-row(flex、上で中央寄せに変更済み)の
		   末尾アイテムとして並ぶ。サイズ・配色(28px円形+枠線)は変えない。 */
		.team-slots .slot-edit-link {
			flex: 0 0 auto;
			z-index: 2;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--color-border);
			background: var(--color-bg);
			color: var(--color-text-muted);
			box-shadow: var(--shadow-sm);
		}
		.team-slots .slot-edit-link:hover {
			background: var(--color-surface);
			color: var(--color-primary);
		}

		/* ------------------------------------------------------------------ */
		/* 右: ダメージ計算の圧縮表示パネル                                     */
		/* 右パネルには登録されているダメージ計算の圧縮版を表示する。ワイヤーフレーム            */
		/* docs/ui_proposal/ダメージカード_圧縮.png の構成を、右パネルの実効幅     */
		/* (minmax(280px,340px) − .panelの左右padding 20px×2 = 240〜300px)に      */
		/* 合わせて縦積みにしたもの。個体編集画面の折りたたみ表示                 */
		/* (DamageCalcSection.astroの.damage-row-collapsed-*)と同じ語彙・同じ    */
		/* 配色トークンを使い、新しい色・新しいフォントサイズは増やさない。       */
		/* DOMはJS(buildDamageCard)が生成するためこの<style is:global>に置く。   */
		/* ------------------------------------------------------------------ */
		/* 見出し・状態文・カード一覧の間の縦gapをvar(--space-3)(12px)からvar(--space-2)
		   (8px)へ詰める(以下、このパネル配下の縦方向の余白を同じ考え方でまとめて詰める)。 */
		.team-preview-panel .team-preview-content {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
			min-width: 0;
		}
		.team-preview-panel .team-damage-owner {
			margin: 0;
			font-size: var(--font-size-sm2);
			font-weight: 800;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.team-preview-panel .team-damage-status {
			margin: 0;
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
		}
		.team-preview-panel .team-damage-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
			min-width: 0;
		}
		/* 右パネルにカード2枚ぶんの幅を確保できるワイド画面だけ2列にする。
		   基本定義より後ろに置き、同詳細度のdisplay指定に上書きされないようにする。 */
		.team-preview-panel .team-damage-card {
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			/* 個体編集画面の計算結果カードと密度を揃え、一覧時の縦方向の占有を抑える。 */
			/* 横方向も既存トークンへ寄せ、カード高は増やさない。 */
			padding: var(--space-1) var(--space-2);
			min-width: 0;
			display: flex;
			flex-direction: column;
		}

		/* --- 上段: アイコン + 種族名/攻守/特性/実数値 --- */
		.team-preview-panel .team-damage-build {
			display: flex;
			align-items: flex-start;
			gap: var(--space-2);
			min-width: 0;
		}
		.team-preview-panel .team-damage-sprite {
			position: relative;
			flex: 0 0 auto;
			width: 68px;
			height: 68px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-preview-panel .team-damage-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-preview-panel .team-damage-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 1.2rem;
		}
		.team-preview-panel .team-damage-build-text {
			flex: 1 1 auto;
			min-width: 0;
			display: flex;
			flex-direction: column;
			/* 細かな生値を共通の最小余白へそろえる。 */
			gap: var(--space-1);
		}
		.team-preview-panel .team-damage-meta-row {
			display: flex;
			align-items: center;
			gap: var(--space-1);
			min-width: 0;
		}
		/* 攻撃=赤/防御=青。DamageCalcSection.astroの
		   .damage-row-collapsed-direction[data-role] と同じ配色トークン。 */
		.team-preview-panel .team-damage-direction {
			flex: 0 0 auto;
			display: inline-flex;
			font-size: var(--font-size-sm3);
			font-weight: 600;
			line-height: var(--line-height-tight);
			padding: 0.1em 0.55em;
			border-radius: var(--radius-sm);
			color: var(--color-primary-contrast);
		}
		.team-preview-panel .team-damage-direction[data-role="attack"] {
			background: var(--color-danger-strong);
		}
		.team-preview-panel .team-damage-direction[data-role="defense"] {
			background: var(--color-primary-strong);
		}
		.team-preview-panel .team-damage-name {
			flex: 1 1 auto;
			min-width: 0;
			font-size: var(--font-size-sm2);
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.team-preview-panel .team-damage-sub-row {
			display: flex;
			align-items: center;
			gap: var(--space-1);
			min-width: 0;
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
		}
		.team-preview-panel .team-damage-ability {
			flex: 1 1 auto;
			min-width: 0;
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.team-preview-panel .team-damage-item-info {
			position: absolute;
			bottom: -3px;
			right: -3px;
			width: 26px;
			height: 26px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
		.team-preview-panel .team-damage-item-icon {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-preview-panel .team-damage-item-name {
			display: none;
		}
		.team-preview-panel .team-damage-tera-info {
			flex: 0 0 auto;
			display: inline-flex;
			align-items: center;
			gap: var(--space-1);
		}
		.team-preview-panel .team-damage-tera-icon {
			width: 16px;
			height: 16px;
			object-fit: contain;
		}
		/* ラベル行(H A+ B C- D S)+実数値行の6列表。個体編集画面の折りたたみ表示
		   (.damage-row-collapsed-stats、47-A-1)と同じ2段6列の作り。 */
		.team-preview-panel .team-damage-stats {
			display: grid;
			/* 短い実数値を6等分せず、中央スロットと同じ間隔で左へ詰める。 */
			grid-template-columns: repeat(6, max-content);
			column-gap: var(--space-2);
			justify-content: start;
			margin-top: var(--space-1);
		}
		.team-preview-panel .team-damage-stats-line {
			display: contents;
		}
		.team-preview-panel .team-damage-stat-key {
			font-size: var(--font-size-sm3);
			font-weight: 700;
			color: var(--color-text-muted);
			text-align: center;
		}
		.team-preview-panel .team-damage-stat-key[data-mod="up"] { color: var(--color-danger-strong); }
		.team-preview-panel .team-damage-stat-key[data-mod="down"] { color: var(--color-primary); }
		.team-preview-panel .team-damage-stat-value {
			font-size: var(--font-size-sm3);
			font-weight: 700;
			text-align: center;
		}

		/* --- 下段: 技名 / 詳細設定 / 累計計算結果 --- */
		/* このブロック配下の上部marginをまとめて詰める(var(--space-2)=8px→var(--space-1)=4px、
		   可読性を保てる12pxのトークンへ統一する)。 */
		.team-preview-panel .team-damage-move-line {
			margin: var(--space-1) 0 0;
			font-size: var(--font-size-sm3);
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		/* 詳細設定は個体編集画面の折りたたみ表示(.damage-row-collapsed-detail-line)では
		   1行+ellipsisだが、こちらは幅300pxしかなく「攻撃側特攻…」のように語の途中で
		   切れて何の条件か読めなくなる(実測: メガカメックスの行が切れた)。この画面では
		   詳細設定を出す場所が他に無いため折り返して全部見せる。 */
		.team-preview-panel .team-damage-detail-line {
			margin: 0;
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-snug);
			color: var(--color-text-muted);
			overflow-wrap: anywhere;
		}
		/* .severity-bar(global.css)の既定marginは上下 var(--space-3) だが、
		   カード内では技名行との間隔を詰める。色・角丸・左罫線は共通定義のまま。
		   margin-top・上下paddingを詰め、チップ内部の上下寸法を個体編集の累計結果に揃え、
		   継承で広がっていた行高を固定する。 */
		.team-preview-panel .team-damage-result {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 var(--space-2);
			/* margin: auto 0 0 で本文後の余白を吸収し、要素を最終段(カード下端)へ寄せる。 */
			margin: auto 0 0;
			order: 1;
			/* 左だけ広めにする。確定数(確N)は font-weight 800 の漢字で、左の罫線
			   (border-left 4px)にほぼ接して見えるため(実測: 文字の開始位置が padding の
			   端ちょうど)。 */
			padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3);
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
		}
		.team-preview-panel .team-damage-result-verdict {
			font-size: var(--font-size-sm1);
			font-weight: 800;
		}
		.team-preview-panel .team-damage-result-detail {
			font-variant-numeric: tabular-nums;
		}
		.team-preview-panel .team-damage-result-note {
			flex: 1 0 100%;
			font-size: var(--font-size-sm3);
			font-weight: 500;
			white-space: normal;
		}
		.team-preview-panel .team-damage-memo {
			margin: 0;
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		/* --- チームポケモンのサジェスト。右パネルのニュートラル状態に出す「おすすめのポケモンと
		   型」ランキング。JS(renderSuggestions)が生成する要素なので、このファイルの
		   scoped <style> ではなくここ(is:global)に置く。幅は右パネルの実効幅(実測 約300px)
		   しかないため、ダメージカード(.team-damage-card)と同じく1カラムの縦積みで組み、
		   はみ出す文言は省略記号で畳む。 --- */
		.team-suggest {
			padding: var(--space-3);
		}
		.team-suggest-heading {
			font-size: var(--font-size-sm2);
			font-weight: 600;
			margin: 0 0 var(--space-1);
		}
		.team-suggest-status {
			font-size: var(--font-size-sm2);
			color: var(--color-text-muted);
			margin: 0;
		}
		.team-suggest-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}
		/* 順位 / 2行にまたがるスプライト / 本文 / 操作の4列。スプライトを本文外へ置くことで、
		   種族名とアイテムの左端をそろえ、カード高の増加も抑える。 */
		.team-suggest-card {
			display: grid;
			/* 順位 / スプライト / 本文 / ボタン。本文列は minmax(0, 1fr) にしないと
			   長い技名・持ち物名がグリッドを押し広げて横スクロールを起こす。 */
			grid-template-columns: auto auto minmax(0, 1fr) auto;
			align-items: center;
			/* 本文の1行幅を確保しつつ、順位・画像・操作の位置関係は維持する。 */
			gap: var(--space-1);
			padding: var(--space-2);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
		}
		.team-suggest-rank {
			/* 順位を一覧の視覚的な起点にするため、従来値の1.5倍にする。 */
			font-size: calc(var(--font-size-sm3) * 1.5);
			font-weight: 700;
			color: var(--color-text-muted);
			min-width: 1.2em;
			text-align: right;
		}
		/* 本文の2行にまたがる専用列。 */
		.team-suggest-sprite {
			/* ドット絵に合わせて幅を詰め、種族名とアイテム名の表示領域を確保する。 */
			width: 40px;
			height: 40px;
			flex: none;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-suggest-sprite-img {
			max-width: 100%;
			max-height: 100%;
		}
		.team-suggest-sprite-fallback {
			display: none;
			width: 35px;
			height: 35px;
			border-radius: 50%;
			background: var(--color-bg);
			color: var(--color-text-muted);
			font-size: var(--font-size-sm3);
			align-items: center;
			justify-content: center;
		}
		.team-suggest-body {
			min-width: 0;
		}
		.team-suggest-name-row {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			min-width: 0;
		}
		.team-suggest-name {
			font-size: var(--font-size-sm2);
			font-weight: 600;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			min-width: 0;
		}
		/* 右パネルの本文列は実測で約165pxしかなく、特性+持ち物+役割を1行に収めると
		   ほぼ必ず省略記号で切れる。省略すると「どの型か」という提案の中身そのものが
		   読めなくなるため、折り返して2行以上になることを許す(カードの高さは伸びる)。
		   アイテムを最優先で読めるよう先頭に置く。 */
		.team-suggest-build {
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
			display: flex;
			align-items: center;
			flex-wrap: nowrap;
			gap: var(--space-1);
			line-height: var(--line-height-snug);
			margin-top: 0.15em;
			min-width: 0;
			overflow: hidden;
		}
		.team-suggest-item-icon {
			width: 14px;
			height: 14px;
			flex: none;
		}
		.team-suggest-item-name {
			font-weight: 600;
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.team-damage-title-sprite {
			display: inline-flex;
			width: calc((20px + var(--space-1)) * 1.1);
			height: calc((20px + var(--space-1)) * 1.1);
			margin-right: var(--space-2);
			vertical-align: middle;
		}
		.team-damage-title-sprite img {
			object-fit: contain;
		}
		.team-suggest-role {
			flex: none;
			padding: 0 0.35em;
			border-radius: var(--radius-sm);
			background: var(--color-bg);
		}
		/* 特性だけは型の識別子ではなく最頻値からの推定(migrations/018)。持ち物・役割と同じ
		   見た目だと確定情報に見えるため、点線の下線で「推定」であることを示す。 */
		.team-suggest-ability {
			text-decoration: underline dotted var(--color-border);
			text-underline-offset: 0.2em;
		}
		/* 根拠(共起した種族名、または「上位チームのN%が採用」)。ここで切れると
		   提案の説得力そのものが失われるため折り返す。 */
		.team-suggest-reason {
			font-size: var(--font-size-sm3);
			color: var(--color-text-muted);
			line-height: var(--line-height-snug);
			margin-top: 0.1em;
		}
		.team-suggest-reason-name {
			/* 前後のテキストと同じ書式にそろえる。 */
			font-weight: inherit;
			color: inherit;
		}
		/* 持ち物がチーム内で重複する型(そのままでは編成できない)への注意書き。
		   候補自体は消さない ── 「持ち物を変えれば使える」という情報は残す価値があるため。 */
		.team-suggest-conflict {
			font-size: var(--font-size-sm3);
			color: var(--color-risky-strong);
		}
		/* 3列目のセルに収まる縦長のボタンにする。文字が縦書きにならないよう
		   white-space:normalで折り返し、幅を抑える。 */
		.team-suggest-action {
			align-self: stretch;
			justify-self: stretch;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-1);
			/* 鉛筆とラベルを横並びのまま収める。 */
			width: 6.4em;
			max-width: 6.4em;
			font-size: var(--font-size-sm3);
			line-height: var(--line-height-tight);
			padding: var(--space-1);
			white-space: normal;
			overflow-wrap: break-word;
			text-align: center;
			border: 0;
			border-radius: var(--radius-sm);
			background: var(--color-primary-soft);
			color: var(--color-text);
			cursor: pointer;
		}
		.team-suggest-action:hover:not(:disabled) {
			background: var(--color-border);
			color: var(--color-primary-strong);
		}
		.team-suggest-action:focus-visible {
			outline: thin solid var(--color-primary);
			outline-offset: var(--space-1);
		}
		.team-suggest-action:active:not(:disabled) {
			background: var(--color-primary);
			color: var(--color-primary-contrast);
		}
		.team-suggest-action:disabled {
			cursor: default;
			opacity: 0.6;
		}

	</style>

	<script>
		// チーム編集: ポケモン選択バー(左)と6枠(中央)を描画し、自動保存する。
		// 自動保存のデバウンス方式は box/[id].astro と同じ(700ms・保存ボタンは作らない・
		// topbar-statusスロットで状態表示)。初期表示データ(SSR取得済みのチーム)は
		// #team-edit-layout の data-initial-team から読む(fetch往復を待たずに6枠を描ける)。
		import { loadImageIdMap, officialArtworkUrl, championSpriteUrl, loadBaseStatsMap, loadMoveDetailMap } from "../../lib/pokemon-master-data";
		// 技チップにタイプアイコンを追加するため、typeIconUrlを追加importする(box/index.astroの
		// applyMoveChipTypeIconsと同じ用途)。
		import { itemIconUrl, teraTypeIconUrl, typeIconUrl } from "../../lib/sprite-urls";
		import { DEFAULT_TYPE_COLOR, TYPE_COLORS } from "../../lib/type-colors";
		import { resolveDexNo, resolveSpeciesTypes } from "../../lib/species-dex";
		import { selectionBlockReason, type SelectionCandidate, type SelectionBlockReason } from "../../lib/team-validation";
		import { STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";
		import {
			ownedPokemonDisplayName as displayName,
			renderBoxPokemonCard,
		} from "../../lib/box-pokemon-card";
		import { renderTeamMateSlots } from "../../lib/team-mate-card";
		import { renderTopBuildCard } from "../../lib/ranked-teams/card";
		import { calculateTeamSimilarity } from "../../lib/build-similarity";
		import type { RankedTeam } from "../../lib/ranked-teams";
		import { kanaIncludes } from "../../lib/kana";
		import { initializeSortDirectionToggle } from "../../lib/shared/sort-direction-toggle";
		// 表示ロジックは純粋関数として切り出してある(renderPreviewPanel/buildDamageCard の実装
		// コメント参照)。summarizeOpponentNoteが返すteraType/abilityName等
		// (相手ビルド=OpponentNoteSummary)は「相手がテラスタルを持っているか」という静的な
		// ビルド属性で、「この計算条件で実際にテラスタルしたか」とは別物(damage-summary.tsの
		// NormalizedNoteAttackが持つattackerTerastallized/defenderTerastallizedが後者に当たる、
        // box/[id].astro側のsrc/lib/box-id/right-panel.tsが同じ区別を使っている)。
		// このファイルの担当範囲はteam/[id].astroのみでdamage-summary.ts自体は変更しない方針の
		// ため、既に純粋関数としてexportされているnormalizeNoteAttacks/validNoteAttacksを
		// このファイル側でも呼び、noteのfield生データから実際のterastallized有無を導出する
		// (buildDamageCard参照)。
		import {
			computeBuildStatCells,
			summarizeOpponentNote,
			normalizeNoteAttacks,
			validNoteAttacks,
			type MoveCategory,
			type OpponentNoteLike,
		} from "../../lib/damage-summary";
		import { createMatchupPanel } from "../../lib/matchup-panel";

		interface OwnedPokemonRecord {
			id: string;
			nickname: string | null;
			species_name: string;
			// A-8: SSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方が既にability_nameを含んでいる。新規フェッチ・新規計算は不要で、この型に
			// 足すだけで枠カード・選択バーの両方から読める。
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			move_names: string[];
			// box/index.astroと同じ実数値計算(src/lib/stats.ts)に使う。level/nature/evs/ivsもSSR・
			// GET /api/owned-pokemonの両方に既に含まれているため、フロント側の型に足すだけでよい。
			level: number | null;
			nature: string | null;
			evs: number[];
			ivs: number[];
			// 「登録順」ソートに使う。SSR(lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon
			// (OWNED_POKEMON_COLUMNS)の両方に既にcreated_atを含んでいるため、この型に足すだけで
			// 読める(新規フェッチ不要)。
			created_at: string;
			// 一覧APIに既存の日時を、左パネルの利用目的別ソートに使う。
			updated_at: string;
			last_used_at: string | null;
			is_pinned: boolean;
			memo: string | null;
		}

		interface TeamMemberData {
			slot: number;
			owned_pokemon: OwnedPokemonRecord;
		}

		interface InitialTeam {
			id: string;
			memo: string | null;
			members: TeamMemberData[];
		}

		const layoutRoot = document.getElementById("team-edit-layout");
		if (layoutRoot) {
			const mobileTabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".app-header [data-mobile-tab]"));
			type MobileTab = "pokemon" | "formation" | "matchup" | "data";
			const setMobileTab = (tab: MobileTab) => {
				const tabChanged = layoutRoot.dataset.mobileTab !== tab;
				layoutRoot.dataset.mobileTab = tab;
				for (const button of mobileTabButtons) {
					const active = button.dataset.mobileTab === tab;
					button.dataset.active = active ? "true" : "false";
					if (active) button.setAttribute("aria-current", "page");
					else button.removeAttribute("aria-current");
				}
				if (tab === "matchup" && tabChanged) {
					// 初期URLの適用は相性DOM参照の初期化より前に行われるため、計算開始だけを
					// 現在の同期スクリプトの完了後へ送る。クリック時も同じ経路で即座に開始する。
					queueMicrotask(() => {
						if (layoutRoot.dataset.mobileTab === "matchup") void runMatchup();
					});
				}
			};
			const requestedMobileTab = new URLSearchParams(window.location.search).get("tab");
			setMobileTab(
				requestedMobileTab === "formation" || requestedMobileTab === "matchup" || requestedMobileTab === "data"
					? requestedMobileTab
					: "pokemon",
			);
			for (const button of mobileTabButtons) {
				button.addEventListener("click", () => {
					const tab = button.dataset.mobileTab;
					setMobileTab(tab === "formation" || tab === "matchup" || tab === "data" ? tab : "pokemon");
				});
			}
			const teamId = layoutRoot.dataset.teamId as string;
			const initialTeam: InitialTeam = JSON.parse(layoutRoot.dataset.initialTeam || "{}");

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) throw new Error(`要素が見つかりません: #${id}`);
				return found as T;
			}

			const memoInput = el<HTMLTextAreaElement>("team-memo");
			const overviewGrid = el<HTMLElement>("team-overview-grid");
			overviewGrid.insertAdjacentElement("afterend", memoInput);
			const dedupeToggle = el<HTMLInputElement>("team-select-dedupe-toggle");
			const favoriteFilterToggle = el<HTMLInputElement>("favorite-filter-toggle");
			const slotsRoot = el<HTMLElement>("team-slots");
			const formationMobileSlotsRoot = el<HTMLElement>("team-formation-mobile-slots");
			const formationMobileSuggestIcons = el<HTMLElement>("team-formation-mobile-suggest-icons");
			const teamDataMobileSlotsRoot = el<HTMLElement>("team-data-mobile-slots");
			const teamDataMobileSimilarRoot = el<HTMLElement>("team-data-mobile-similar");
			const formationMobileSearchInput = el<HTMLInputElement>("team-formation-mobile-search");
			const formationMobileSortSelect = el<HTMLSelectElement>("team-formation-mobile-sort-select");
			const formationMobileSortSelectWrap = el<HTMLElement>("team-formation-mobile-sort-select-wrap");
			const formationMobileSortDirToggle = el<HTMLButtonElement>("team-formation-mobile-sort-dir-toggle");
			const formationMobileSortDirToggleLabel = formationMobileSortDirToggle.querySelector<HTMLElement>(".sort-dir-toggle-label");
			if (!formationMobileSortDirToggleLabel) throw new Error("要素が見つかりません: .sort-dir-toggle-label");
			const formationMobileAddButton = el<HTMLButtonElement>("team-formation-mobile-add");
			const formationMobileStatus = el<HTMLElement>("team-formation-mobile-status");
			const formationMobileBoxGrid = el<HTMLElement>("team-formation-mobile-box-grid");
			let selectedFormationSlot: number | null = null;

			const searchInput = el<HTMLInputElement>("pokemon-search-input");
			const sortSelect = el<HTMLSelectElement>("pokemon-sort-select");
			const selectListRoot = el<HTMLElement>("pokemon-select-list");
			const selectLoadingMessage = el<HTMLElement>("select-loading-message");
			const selectErrorMessage = el<HTMLElement>("select-error-message");
			const selectEmptyState = el<HTMLElement>("select-empty-state");
			const selectNoMatchState = el<HTMLElement>("select-no-match-state");
			const pokemonCountBadge = el<HTMLElement>("pokemon-count-badge");

			const statusEl = el<HTMLElement>("autosave-status");
			const statusTextEl = el<HTMLElement>("autosave-status-text");
			const retryButton = el<HTMLButtonElement>("retry-button");
			const deleteTeamButton = el<HTMLButtonElement>("delete-team-button");

			const previewEmptyEl = el<HTMLElement>("team-preview-empty");
			const previewContentEl = el<HTMLElement>("team-preview-content");
			// チームポケモンのサジェストの描画先。
			const suggestEl = el<HTMLElement>("team-suggest");
			// サジェストの表示条件トグル。#team-suggestの中身は
			// renderSuggestionsがinnerHTMLで丸ごと書き換えるため、トグル自体は兄弟要素にしてある
			// (上の静的マークアップ参照)。表示/非表示はsuggestElと同じタイミングで切り替える。
			const suggestTogglesEl = el<HTMLElement>("team-suggest-toggles");
			const includeMegaToggle = el<HTMLInputElement>("team-suggest-mega-toggle");
			// カード外クリックでの選択解除判定に使う(右パネル内のクリックは選択解除の対象外にする)。
			const previewPanelEl = el<HTMLElement>("team-preview-panel");

			// 右パネル共通のタイトル帯。個体プレビュー(renderPreviewPanel)とサジェスト
			// (renderSuggestions)の見出しをここへ統一する。
			const panelHeaderBandEl = el<HTMLElement>("team-panel-header-band");
			const panelHeaderTitleEl = el<HTMLElement>("team-panel-header-title");
			function setPanelHeaderTitle(text: string): void {
				panelHeaderTitleEl.textContent = text;
				panelHeaderTitleEl.title = text;
				panelHeaderBandEl.hidden = false;
			}

			// dataTransferはドラッグ元(別ウィンドウ等)の互換性のため一応セットするが、
			// 同一ページ内のドラッグしか想定していないため、実際の受け渡しはこのモジュール内の
			// 変数(draggedPokemonId)で行う(dataTransfer.getData()はdragover中は読めない
			// ブラウザ実装が多く、dropまで値を保持する目的にも向かないため)。
			let draggedPokemonId: string | null = null;

			// 候補ポケモンのドラッグ(draggedPokemonId)とは別に、埋まっている枠自身をドラッグ
			// したときの移動元slot番号を保持する専用変数(renderSlots参照)。
			let draggedMemberSlot: number | null = null;

			const imageIdMapPromise = loadImageIdMap();
			const baseStatsMapPromise = loadBaseStatsMap();

			const STAT_LABELS: Record<(typeof STAT_KEYS)[number], string> = {
				hp: "H", atk: "A", def: "B", spa: "C", spd: "D", spe: "S",
			};

			// box/index.astroのapplyActualStatsと同じ式・同じフォールバック(level??50, iv??31, ev??0)。
			async function computeStats(p: OwnedPokemonRecord): Promise<{ key: string; label: string; value: number; ev: number; mod: "up" | "down" | null }[] | null> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return null;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				return STAT_KEYS.map((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const statMod = key === "hp" ? null : mod.up === key ? "up" : mod.down === key ? "down" : null;
					return { key, label: STAT_LABELS[key], value, ev, mod: statMod };
				});
			}

			// 6枠の現在状態(slot 1..6 -> 個体。無ければ空き)。
			const membersBySlot = new Map<number, OwnedPokemonRecord>();
			for (const m of initialTeam.members ?? []) {
				membersBySlot.set(m.slot, m.owned_pokemon);
			}

			// ボックスの全個体(選択バーの中身)。GET /api/owned-pokemon から取得する。
			let allPokemon: OwnedPokemonRecord[] = [];

			function candidateOf(p: OwnedPokemonRecord): SelectionCandidate {
				return {
					dexNo: resolveDexNo(p.species_name),
					itemName: p.item_name,
					ownedPokemonId: p.id,
				};
			}

			function currentCandidates(): SelectionCandidate[] {
				return Array.from(membersBySlot.values()).map(candidateOf);
			}

			// 既に埋まっている枠へドロップして入れ替える(=その枠自身の在籍は重複扱いしない)場合に
			// 使う。
			function currentCandidatesExcludingSlot(slot: number): SelectionCandidate[] {
				return Array.from(membersBySlot.entries())
					.filter(([s]) => s !== slot)
					.map(([, p]) => candidateOf(p));
			}

			function firstEmptySlot(): number | null {
				for (let slot = 1; slot <= 6; slot += 1) {
					if (!membersBySlot.has(slot)) return slot;
				}
				return null;
			}

			const BLOCK_REASON_LABELS: Record<Exclude<SelectionBlockReason, null>, string> = {
				"already-in-team": "編成済み",
				"team-full": "6体編成済み",
				"duplicate-species": "種族が重複",
				"duplicate-item": "アイテムが重複",
			};

			// 公式絵。取得できない場合は頭文字の丸バッジにフォールバックする
			// (box/index.astroのapplyCardSpriteと同じ方式。loading="lazy"は付けない
			// ---display:noneの<img>は遅延読み込みの対象外としてonloadが発火しない)。
			async function applySprite(
				imgEl: HTMLImageElement,
				fallbackEl: HTMLElement,
				name: string,
			): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				let triedArtworkFallback = false;
				imgEl.onerror = () => {
					if (!triedArtworkFallback) {
						triedArtworkFallback = true;
						imgEl.src = officialArtworkUrl(imageId);
						return;
					}
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = championSpriteUrl(imageId);
			}

			// 持ち物アイコン(アイコン+名前、R-8)。アイコンが解決できない/読み込み失敗のときも
			// 名前のテキストは残す(box/index.astroの持ち物行と同じ考え方)。
			function applyItemIcon(
				imgEl: HTMLImageElement,
				itemName: string,
				visibilityEl?: HTMLElement,
			): void {
				if (!itemName) {
					imgEl.style.display = "none";
					if (visibilityEl) visibilityEl.hidden = true;
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					if (visibilityEl) visibilityEl.hidden = true;
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					if (visibilityEl) visibilityEl.hidden = false;
				};
				imgEl.src = itemIconUrl(itemName);
			}

			// テラスタイプアイコン(アイコン+名前)。teraTypeIconUrlは同期解決(静的マップ)。
			function applyTeraIcon(imgEl: HTMLImageElement, teraName: string): void {
				const url = teraTypeIconUrl(teraName);
				if (!url) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = url;
			}

			// 技チップの前に置くタイプアイコン(box/index.astroのapplyMoveChipTypeIconsと
			// 同じ考え方)。技→タイプの解決はloadMoveDetailMapを使う(このファイルは右パネルの
			// 技分類判定(moveCategoryOf)で既にloadMoveDetailMap()を呼んでおり、内部でキャッシュ
			// される=fetchが増えるわけではない)。
			async function applySelectMoveChipTypeIcons(
				entries: { iconEl: HTMLImageElement; visibilityEl: HTMLElement; moveName: string }[],
			): Promise<void> {
				if (entries.length === 0) return;
				const detailMap = await loadMoveDetailMap();
				for (const { iconEl, visibilityEl, moveName } of entries) {
					const type = detailMap.get(moveName)?.type;
					if (!type) continue;
					const url = typeIconUrl(type);
					if (!url) continue;
					iconEl.onerror = () => {
						visibilityEl.hidden = true;
					};
					iconEl.onload = () => {
						visibilityEl.hidden = false;
					};
					iconEl.src = url;
				}
			}

			async function applyOverviewMoveTypeColors(
				entries: { colorEl: HTMLElement; moveName: string }[],
			): Promise<void> {
				if (entries.length === 0) return;
				const detailMap = await loadMoveDetailMap();
				for (const { colorEl, moveName } of entries) {
					const type = detailMap.get(moveName)?.type;
					if (!type) continue;
					colorEl.style.backgroundColor = TYPE_COLORS[type] ?? DEFAULT_TYPE_COLOR;
					colorEl.hidden = false;
				}
			}

			// 選んだ個体に登録済みの対戦相手メモ(opponent_notes)を、ワイヤーフレーム
			// docs/ui_proposal/ダメージカード_圧縮.png の構成
			// (アイコン | 種族名 / 攻撃or防御 / 特性 / H-A-B-C-D-S ‖ 技名 / 詳細設定 / 累計計算結果)
			// で一覧する。個体編集画面(/box/[id])のダメージカードを折りたたんだ状態と同じ内容で、
			// 表示ロジックは src/lib/damage-summary.ts(純粋関数・ユニットテスト済み)に置いてある。
			//
			// ⚠️ この画面では Pyodide(計算エンジン)を読み込まない。保存済みの client_result
			// スナップショットをそのまま読むだけで、再計算はしない(個体編集画面がエンジン初期化前に
			// スナップショットを即座に表示するのと同じ経路)。右パネルを見るためだけに数MBの
			// wheel を落とさせないため。
			//
			// 右パネルは1650px未満では非表示にする。チーム編成そのものには影響しない(membersBySlotを
			// 一切変更しない、見るだけの機能)。
			const notesCache = new Map<string, OpponentNoteLike[] | "error">();

			async function fetchOpponentNotes(ownedPokemonId: string): Promise<OpponentNoteLike[] | "error"> {
				const cached = notesCache.get(ownedPokemonId);
				if (cached) return cached;
				try {
					const res = await fetch(`/api/opponent-notes?owned_pokemon_id=${encodeURIComponent(ownedPokemonId)}`, {
						headers: { Accept: "application/json" },
					});
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const json = (await res.json()) as { data?: OpponentNoteLike[] };
					const data = Array.isArray(json.data) ? json.data : [];
					notesCache.set(ownedPokemonId, data);
					return data;
				} catch {
					// 失敗はキャッシュしない(次に選び直したときに再試行できるようにする)。
					return "error";
				}
			}

			// 技の分類(物理/特殊/変化)。詳細設定チップの「攻撃+1」/「特攻+1」の出し分けと、
			// 変化技のみのメモの判定に使う。マスタデータの解決前(初回fetch中)はnullが返り、
			// その場合は damage-summary.ts 側が物理扱いの表記にフォールバックする。
			let moveDetailMapCache: Map<string, { category: MoveCategory }> | null = null;
			void loadMoveDetailMap().then((m) => {
				moveDetailMapCache = m;
			});
			function moveCategoryOf(name: string): MoveCategory | null {
				return moveDetailMapCache?.get(name.trim())?.category ?? null;
			}

			function buildDamageCard(note: OpponentNoteLike, baseStats: Map<string, number[]>): HTMLElement {
				const summary = summarizeOpponentNote(note, moveCategoryOf);
				// summary.teraTypeは相手ビルドが持つテラスタイプ
				// (静的な設定値)であり、この計算条件下で実際にテラスタルしたかどうかは別に
				// field.attacks[].attackerTerastallized/defenderTerastallizedを見る必要がある。
				// summary.direction(この個体=owned_pokemonから見た向き)が "attack" なら相手は
				// 防御側なのでdefenderTerastallizedを、"defense"なら相手は攻撃側なので
				// attackerTerastallizedを見る(box/[id].astro側のsrc/lib/box-id/right-panel.tsと
				// 同じ側の対応付け)。複数技(複数列)のうちどれか1つでもテラスタルしていれば
				// 「このカードの計算でテラスタルした」とみなす。
				const noteAttacks = validNoteAttacks(normalizeNoteAttacks(note.field as never, note.move_name));
				const opponentTerastallized = noteAttacks.some((a) =>
					summary.direction === "attack" ? a.defenderTerastallized : a.attackerTerastallized,
				);
				const card = document.createElement("li");
				card.className = "team-damage-card";

				// --- 上段: アイコン + 種族名 / 攻撃or防御 / 特性 / 実数値 ---
				const buildRow = document.createElement("div");
				buildRow.className = "team-damage-build";

				const spriteBox = document.createElement("div");
				spriteBox.className = "team-damage-sprite";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-damage-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-damage-sprite-fallback";
				spriteBox.append(spriteImg, spriteFallback);
				// 右パネルのダメージ対象は公式画像ではなくドット絵で統一する。
				void applySprite(spriteImg, spriteFallback, summary.opponentName);
				buildRow.appendChild(spriteBox);

				const buildText = document.createElement("div");
				buildText.className = "team-damage-build-text";

				const metaRow = document.createElement("div");
				metaRow.className = "team-damage-meta-row";
				const directionEl = document.createElement("span");
				directionEl.className = "team-damage-direction";
				directionEl.textContent = summary.directionLabel;
				directionEl.dataset.role = summary.direction;
				const nameEl = document.createElement("span");
				nameEl.className = "team-damage-name";
				nameEl.textContent = summary.opponentName;
				nameEl.title = summary.opponentName;
				const abilityEl = document.createElement("span");
				abilityEl.className = "team-damage-ability";
				abilityEl.textContent = summary.abilityName;
				abilityEl.title = summary.abilityName;
				// 特性は種族名と同じ段に置き、長い場合だけ末尾を省略する。
				metaRow.append(directionEl, nameEl, abilityEl);

				const subRow = document.createElement("div");
				subRow.className = "team-damage-sub-row";
				// 個体編集画面と同じく、持ち物は名前の横幅を使わずスプライト右下へ重ねる。
				// クラスと名前DOMは既存契約を保つため残し、名前はCSSで視覚的に隠す。
				if (summary.itemName) {
					const itemInfo = document.createElement("span");
					itemInfo.className = "team-damage-item-info";
					const itemImg = document.createElement("img");
					itemImg.className = "team-damage-item-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, summary.itemName);
					const itemNameEl = document.createElement("span");
					itemNameEl.className = "team-damage-item-name";
					itemNameEl.textContent = summary.itemName;
					itemInfo.append(itemImg, itemNameEl);
					itemInfo.title = summary.itemName;
					spriteBox.appendChild(itemInfo);
				}
				// 相手がテラスタイプを持っていても、この条件で実際にテラスタルしていなければ
				// (opponentTerastallized === false)表示しない。
				if (summary.teraType && opponentTerastallized) {
					const teraInfo = document.createElement("span");
					teraInfo.className = "team-damage-tera-info";
					const teraImg = document.createElement("img");
					teraImg.className = "team-damage-tera-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, summary.teraType);
					const teraName = document.createElement("span");
					teraName.textContent = summary.teraType;
					teraInfo.append(teraImg, teraName);
					subRow.appendChild(teraInfo);
				}
				buildText.appendChild(metaRow);
				// 特性を移した後にテラスタル表示が無ければ空の2段目を作らない。
				if (subRow.childElementCount > 0) buildText.appendChild(subRow);

				const cells = computeBuildStatCells(
					note.opponent_build as never,
					baseStats.get((note.opponent_build as { name?: string } | null)?.name?.trim() ?? ""),
				);
				if (cells) {
					// ラベル行 + 実数値行の6列表(個体編集画面の折りたたみ表示と同じ形)。
					const statsEl = document.createElement("div");
					statsEl.className = "team-damage-stats";
					const labelLine = document.createElement("div");
					labelLine.className = "team-damage-stats-line";
					const valueLine = document.createElement("div");
					valueLine.className = "team-damage-stats-line";
					for (const cell of cells) {
						const labelEl = document.createElement("span");
						labelEl.className = "team-damage-stat-key";
						labelEl.textContent = cell.label;
						if (cell.mod) labelEl.dataset.mod = cell.mod;
						labelLine.appendChild(labelEl);
						const valueEl = document.createElement("span");
						valueEl.className = "team-damage-stat-value tnum";
						valueEl.textContent = String(cell.value);
						valueLine.appendChild(valueEl);
					}
					statsEl.append(labelLine, valueLine);
					buildText.appendChild(statsEl);
				}
				buildRow.appendChild(buildText);
				card.appendChild(buildRow);

				// --- 下段: 技名 / 詳細設定 / 累計計算結果 ---
				const moveLineEl = document.createElement("p");
				moveLineEl.className = "team-damage-move-line";
				moveLineEl.textContent = summary.moveLine;
				moveLineEl.title = summary.moveLine;
				card.appendChild(moveLineEl);

				if (summary.conditionLine) {
					const detailEl = document.createElement("p");
					detailEl.className = "team-damage-detail-line";
					detailEl.textContent = summary.conditionLine;
					detailEl.title = summary.conditionLine;
					card.appendChild(detailEl);
				}

				const resultEl = document.createElement("p");
				resultEl.className = "severity-bar team-damage-result";
				resultEl.dataset.severity = summary.verdict.severity;
				if (summary.verdict.label) {
					const verdictEl = document.createElement("span");
					verdictEl.className = "team-damage-result-verdict";
					verdictEl.textContent = summary.verdict.label;
					resultEl.appendChild(verdictEl);
				}
				if (summary.verdict.detail) {
					const detailEl = document.createElement("span");
					detailEl.className = "team-damage-result-detail";
					detailEl.textContent = summary.verdict.detail;
					resultEl.appendChild(detailEl);
				}
				if (summary.verdict.note) {
					// 一撃必殺技・はきだす・変化技のみ等の断り書き。数値だけを見て過信しないための注記。
					const noteEl = document.createElement("span");
					noteEl.className = "team-damage-result-note";
					noteEl.textContent = summary.verdict.note;
					resultEl.appendChild(noteEl);
				}
				card.appendChild(resultEl);

				if (summary.memo) {
					const memoEl = document.createElement("p");
					memoEl.className = "team-damage-memo";
					memoEl.textContent = summary.memo;
					memoEl.title = summary.memo;
					card.appendChild(memoEl);
				}
				return card;
			}

			// 「今どの個体を表示中か」。非同期のfetchが戻ってきたときに、その間にユーザーが
			// 別の個体を選んでいたら描画を捨てる(取り違え防止)。
			let previewRequestId = 0;

			async function renderPreviewPanel(p: OwnedPokemonRecord): Promise<void> {
				const requestId = (previewRequestId += 1);
				previewEmptyEl.hidden = true;
				previewContentEl.hidden = false;
				previewContentEl.innerHTML = "";
				// 個体を選んでいる間はニュートラル状態ではないのでサジェストを隠す
				// (closePreviewPanel が戻す)。中身は消さない ── 選択解除のたびに
				// 再fetchせず、そのまま出し直せるようにするため。
				suggestEl.hidden = true;
				suggestTogglesEl.hidden = true;

				// 見出しは右パネル共通のタイトル帯(#team-panel-header-title)へ表示する
				// (このページ内で.team-damage-ownerクラス自体は削除していない)。
				setPanelHeaderTitle("ダメージ計算");
				const titleSprite = document.createElement("span");
				titleSprite.className = "team-damage-title-sprite";
				// 寸法と配置は共通スタイルへ集約し、ここには表示状態の制御だけを残す。
				const titleSpriteImg = document.createElement("img");
				titleSpriteImg.alt = "";
				titleSpriteImg.style.cssText = "display:none;width:100%;height:100%;object-fit:contain";
				const titleSpriteFallback = document.createElement("span");
				titleSpriteFallback.style.cssText = "display:none;width:100%;height:100%";
				titleSprite.append(titleSpriteImg, titleSpriteFallback);
				const titleText = document.createTextNode("ダメージ計算");
				panelHeaderTitleEl.replaceChildren(titleSprite, titleText);
				panelHeaderTitleEl.title = `${displayName(p)} のダメージ計算`;
				// ダメージ計算の見出しもカードと同じドット絵を使う。
				void applySprite(titleSpriteImg, titleSpriteFallback, p.species_name);

				const statusEl = document.createElement("p");
				statusEl.className = "team-damage-status";
				statusEl.textContent = "読み込み中…";
				previewContentEl.appendChild(statusEl);

				const [notes, baseStats] = await Promise.all([fetchOpponentNotes(p.id), baseStatsMapPromise]);
				if (requestId !== previewRequestId) return; // 別の個体が選び直された

				if (notes === "error") {
					statusEl.textContent = "ダメージ計算を読み込めませんでした。";
					return;
				}
				if (notes.length === 0) {
					statusEl.textContent = "ダメージ計算は登録されていません。";
					return;
				}
				statusEl.remove();
				const listEl = document.createElement("ul");
				listEl.className = "team-damage-list";
				for (const note of notes) listEl.appendChild(buildDamageCard(note, baseStats));
				previewContentEl.appendChild(listEl);
			}

			// 「カード外クリックでハイライトを解除する」document click リスナー
			// (下部のdocument.addEventListener("click", ...)参照)は.card-team-slot から
			// is-selected クラスを外すだけで、右パネルの中身(previewContentEl、
			// renderPreviewPanelがinnerHTMLで書き込む)には触れない。そのままではカードの選択
			// ハイライトが消えても、直前に選んだ個体のダメージ計算が右パネルに残ってしまう。
			// previewRequestIdを進めてrenderPreviewPanel側の非同期処理(await後の
			// requestId !== previewRequestIdチェック、上のrenderPreviewPanel参照)も無効化しつつ、
			// previewContentElを空にして隠す(previewEmptyElは元々常時hidden・無テキストの設計
			// (上のマークアップのコメント参照)のため、ここで表示に戻す必要はない)。
			function closePreviewPanel(): void {
				previewRequestId += 1;
				previewContentEl.hidden = true;
				previewContentEl.innerHTML = "";
				// ニュートラル状態に戻ったのでサジェストを出し直す(下の renderSuggestions 参照)。
				suggestEl.hidden = false;
				suggestTogglesEl.hidden = false;
				// 個体プレビューの見出しで上書きされたままの共通タイトル帯を、ニュートラル状態
				// (サジェスト)の見出しに戻す。テキストはrenderSuggestions が使っているものと
				// 同じ固定文言。
				setPanelHeaderTitle("おすすめポケモン");
			}

			// =================================================================================
			// チームポケモンのサジェスト
			// 「現在のチームメンバーを参照して、残りの枠に入れるとよいポケモンを提案する」。
			// 集計は GET /api/team-suggestions(スコアリングは src/lib/team-suggest.ts、
			// 共起の集計は migrations/016 のSQL関数)。ここは表示と操作だけを担う。
			// =================================================================================

			interface TeamSuggestion {
				speciesName: string;
				dexNo: number | null;
				abilityName: string | null;
				itemName: string | null;
				role: "physical_attacker" | "special_attacker" | "bulky" | null;
				archetypeShare: number | null;
				archetypeTeams: number | null;
				usageTeams: number;
				totalTeams: number;
				itemConflict: boolean;
				reason: {
					seedSpeciesName: string;
					coTeams: number;
					seedTeams: number;
					ratio: number;
					lift: number;
				} | null;
			}

			const ROLE_LABELS: Record<string, string> = {
				physical_attacker: "物理",
				special_attacker: "特殊",
				bulky: "耐久",
			};

			// 「今どの編成に対する結果か」。メンバーを続けて操作したときに、古いリクエストの
			// 応答が後から届いて上書きするのを防ぐ(renderPreviewPanel の previewRequestId と同じ方式)。
			let suggestRequestId = 0;
			// 直近で問い合わせた編成。同じ編成での再描画では fetch を撃たない
			// (枠の入れ替えなど、メンバー集合が変わらない操作でも scheduleSuggestions は呼ばれるため)。
			let lastSuggestKey: string | null = null;
			let suggestTimer: number | undefined;

			function setSuggestStatus(message: string): void {
				suggestEl.innerHTML = "";
				const p = document.createElement("p");
				p.className = "team-suggest-status";
				p.textContent = message;
				suggestEl.appendChild(p);
			}

			// メガシンカ種族の判定用マスターデータ(「メガシンカを含める」トグル用)。
			// mega-stones.json は「種族名→メガストーン名」の対応表(src/lib/speed-chart/
			// chart-table.ts の loadMasterData と同じ要領でfetchする)。文字列の「メガ」接頭辞判定は
			// 誤判定・取り漏れの余地があるため使わず、このマスターデータのspeciesに載っているかどうか
			// だけで判定する。
			interface MegaStoneMasterEntry {
				species: string;
				item: string;
			}
			let megaSpeciesSetPromise: Promise<Set<string>> | null = null;
			function loadMegaSpeciesSet(): Promise<Set<string>> {
				if (!megaSpeciesSetPromise) {
					megaSpeciesSetPromise = fetch("/master-data/autocomplete/mega-stones.json")
						.then((res) => res.json() as Promise<MegaStoneMasterEntry[]>)
						.then((list) => new Set(list.map((entry) => entry.species)))
						.catch((err) => {
							console.warn("メガシンカ種族一覧の読み込みに失敗しました", err);
							megaSpeciesSetPromise = null;
							return new Set<string>();
						});
				}
				return megaSpeciesSetPromise;
			}

			// 提案された型に一致する手持ち個体を探す。種族が一致し、かつチームに入れられる
			// (selectionBlockReason が null)個体だけが対象。特性・持ち物まで一致するものを
			// 優先し、無ければ種族だけ一致する個体を返す ── 「型は違うが同じポケモンなら持っている」
			// 場合に、作り直しではなく手持ちを入れる導線を出せるようにするため。
			function findOwnedMatch(suggestion: TeamSuggestion): OwnedPokemonRecord | null {
				const candidates = currentCandidates();
				const usable = allPokemon.filter(
					(p) => p.species_name === suggestion.speciesName && selectionBlockReason(candidateOf(p), candidates) === null,
				);
				if (usable.length === 0) return null;
				const exact = usable.find(
					(p) =>
						(p.ability_name ?? "") === (suggestion.abilityName ?? "") &&
						(p.item_name ?? "") === (suggestion.itemName ?? ""),
				);
				return exact ?? usable[0];
			}

			// 表示条件トグル(「メガシンカを含める」トグル)。OFF時はメガシンカ種族を除外する。
			// APIを叩き直さず、直近の応答に対してクライアント側でフィルタする。
			async function filterSuggestions(suggestions: TeamSuggestion[]): Promise<TeamSuggestion[]> {
				let result = suggestions;
				if (!includeMegaToggle.checked) {
					const megaSpecies = await loadMegaSpeciesSet();
					result = result.filter((s) => !megaSpecies.has(s.speciesName));
				}
				return result;
			}

			// 「この型で個体を作る」: box/index.astro の createEmptyPokemon と同じ POST 経路で、
			// 空の個体ではなく提案された型(種族・特性・持ち物)を埋めた個体を作り、そのまま
			// 編集画面へ送る。努力値・技・性格は提案の識別キーに含まれない(型は
			// 種族・特性・持ち物・role の4つで決まる、migrations/015)ため空のままにする。
			async function createPokemonFromSuggestion(suggestion: TeamSuggestion, button: HTMLButtonElement): Promise<void> {
				button.disabled = true;
				// 登録失敗時に鉛筆アイコンを含む元の表示を復元する。
				const originalContent = Array.from(button.childNodes, (node) => node.cloneNode(true));
				button.textContent = "登録中…";
				try {
					const res = await fetch("/api/owned-pokemon", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							nickname: "",
							species_name: suggestion.speciesName,
							level: null,
							nature: "",
							ability_name: suggestion.abilityName ?? "",
							item_name: suggestion.itemName ?? "",
							tera_type: "",
							evs: [0, 0, 0, 0, 0, 0],
							ivs: [31, 31, 31, 31, 31, 31],
							move_names: [],
							memo: "",
							tags: [],
							is_pinned: false,
						}),
					});
					const body = (await res.json().catch(() => ({}))) as { data?: { id: string }; error?: string };
					if (!res.ok || !body.data) throw new Error(body.error ?? `登録に失敗しました (status=${res.status})`);
					window.location.href = `/box/${encodeURIComponent(body.data.id)}`;
				} catch (err) {
					console.error(err);
					button.disabled = false;
					button.replaceChildren(...originalContent);
					window.alert("個体の登録に失敗しました。時間をおいて再度お試しください。");
				}
			}

			// 順位 / 2行にまたがるスプライト / 本文 / 操作の4列構成。スプライトを本文外へ置き、
			// 種族名と持ち物の左端をそろえながら縦方向の情報密度を保つ。
			function buildSuggestionCard(suggestion: TeamSuggestion, rank: number): HTMLElement {
				const owned = findOwnedMatch(suggestion);

				const card = document.createElement("li");
				// 所有判定は操作の分岐だけに使い、育成済みを示す表示状態は付けない。
				card.className = "team-suggest-card";

				const rankEl = document.createElement("span");
				rankEl.className = "team-suggest-rank";
				rankEl.textContent = String(rank);
				card.appendChild(rankEl);

				const body = document.createElement("div");
				body.className = "team-suggest-body";

				// 1段目: スプライト(1.1倍、44px→48px) + 種族名。
				const nameRow = document.createElement("div");
				nameRow.className = "team-suggest-name-row";
				const spriteEl = document.createElement("span");
				spriteEl.className = "team-suggest-sprite";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-suggest-sprite-img";
				spriteImg.alt = "";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-suggest-sprite-fallback";
				spriteEl.append(spriteImg, spriteFallback);
				// おすすめポケモンは公式画像ではなくドット絵で表示する。
				void applySprite(spriteImg, spriteFallback, suggestion.speciesName);
				const nameEl = document.createElement("span");
				nameEl.className = "team-suggest-name";
				nameEl.textContent = suggestion.speciesName;
				nameEl.title = suggestion.speciesName;
				nameRow.appendChild(nameEl);
				card.appendChild(spriteEl);
				body.appendChild(nameRow);
				if (suggestion.itemName) {
					// 2段目は既存のbuild行を再利用し、1段目の種族名と左端をそろえる。
					const buildRow = document.createElement("div");
					buildRow.className = "team-suggest-build";
					const itemIcon = document.createElement("img");
					itemIcon.className = "team-suggest-item-icon";
					itemIcon.alt = "";
					void applyItemIcon(itemIcon, suggestion.itemName);
					const itemEl = document.createElement("span");
					itemEl.className = "team-suggest-item-name";
					itemEl.textContent = suggestion.itemName;
					buildRow.append(itemIcon, itemEl);
					body.appendChild(buildRow);
				}

				// 特性と役割はカード上にDOMを生成しない。作成処理で使う元データは維持する。

				// 根拠。共起ベースは種族名に「同時採用率」を括弧内で併記する。チームが空(reasonがnull)なら
				// 従来どおり採用率を出す。
				const reasonEl = document.createElement("div");
				reasonEl.className = "team-suggest-reason";
				if (suggestion.reason) {
					const percent = Math.round(suggestion.reason.ratio * 100);
					const reasonNameEl = document.createElement("span");
					reasonNameEl.className = "team-suggest-reason-name";
					reasonNameEl.textContent = suggestion.reason.seedSpeciesName;
					// 割合の意味を括弧内で明示する。
					reasonEl.append(reasonNameEl, ` (同時採用 ${percent}%)`);
					reasonEl.title = `共起 ${suggestion.reason.coTeams}/${suggestion.reason.seedTeams}チーム・lift ${suggestion.reason.lift.toFixed(2)}`;
				} else {
					const percent = Math.round((suggestion.usageTeams / Math.max(suggestion.totalTeams, 1)) * 100);
					// 集計元は上位入賞チームとアプリの登録データの合算プール(migrations/021)なので
					// 「上位チームの」とは書けない。分子は個体数、分母はチーム相当数
					// (ランキングの実チーム数 + アプリ登録個体数÷6)。
					reasonEl.textContent = `採用率 ${percent}%`;
					reasonEl.title = `${suggestion.usageTeams}体 / ${suggestion.totalTeams}チーム相当`;
				}
				body.appendChild(reasonEl);

				if (suggestion.itemConflict && suggestion.itemName) {
					const conflictEl = document.createElement("div");
					conflictEl.className = "team-suggest-conflict";
					conflictEl.textContent = `${suggestion.itemName}が重複`;
					body.appendChild(conflictEl);
				}

				card.appendChild(body);

				// 操作: 手持ちにあれば枠へ入れる、無ければその型で新規登録する。ラベルは
				// 「育成する」/「チームに追加」に統一し、個体名はtitleに残す。
				const action = document.createElement("button");
				action.type = "button";
				action.className = "team-suggest-action";
				if (owned) {
					const label = owned.nickname?.trim() || owned.species_name;
					action.textContent = "チームに追加";
					action.title = `手持ちの${label}を入れる`;
					action.disabled = firstEmptySlot() == null;
					action.addEventListener("click", () => {
						assignToSlot(owned);
					});
				} else {
					// 新規育成の操作だけ、既存UIと同じ鉛筆アイコンをラベル左へ添える。
					const editIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
					editIcon.setAttribute("width", "14");
					editIcon.setAttribute("height", "14");
					editIcon.setAttribute("viewBox", "0 0 24 24");
					editIcon.setAttribute("fill", "none");
					editIcon.setAttribute("stroke", "currentColor");
					editIcon.setAttribute("stroke-width", "2");
					editIcon.setAttribute("stroke-linecap", "round");
					editIcon.setAttribute("stroke-linejoin", "round");
					editIcon.setAttribute("aria-hidden", "true");
					const editBody = document.createElementNS("http://www.w3.org/2000/svg", "path");
					editBody.setAttribute("d", "M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z");
					const editTip = document.createElementNS("http://www.w3.org/2000/svg", "path");
					editTip.setAttribute("d", "m15 5 4 4");
					editIcon.append(editBody, editTip);
					action.append(editIcon, "育成する");
					action.title = "この型で個体を作る";
					action.addEventListener("click", () => {
						void createPokemonFromSuggestion(suggestion, action);
					});
				}
				card.appendChild(action);

				return card;
			}

			function buildSuggestIcon(suggestion: TeamSuggestion): HTMLElement {
				const owned = findOwnedMatch(suggestion);
				const button = document.createElement("button");
				button.type = "button";
				button.className = "team-formation-suggest-icon";
				button.title = suggestion.speciesName;
				button.setAttribute("aria-label", `${suggestion.speciesName}を育成`);
				const img = document.createElement("img");
				img.alt = "";
				const fallback = document.createElement("span");
				button.appendChild(img);
				void applySprite(img, fallback, suggestion.speciesName);
				if (owned) {
					const label = owned.nickname?.trim() || owned.species_name;
					button.title = `手持ちの${label}を入れる`;
					button.setAttribute("aria-label", `${label}をチームに追加`);
					button.disabled = firstEmptySlot() == null;
					button.addEventListener("click", () => {
						assignToSlot(owned);
					});
				} else {
					button.addEventListener("click", () => {
						void createPokemonFromSuggestion(suggestion, button);
					});
				}
				return button;
			}

			// 直近の応答。個体一覧(allPokemon)が後から届いたときに「手持ちにあるか」の
			// 判定をやり直して再描画するために保持する(APIは叩き直さない)。
			let lastSuggestResponse: { suggestions: TeamSuggestion[]; basis: string } | null = null;
			let suggestionSpeciesRanks = new Map<string, number>();
			// 「今どの描画が最新か」。トグル操作(filterSuggestionsのawait)の途中で別の描画要求が
			// 割り込んだとき、古い方がDOMを上書きしないようにする(previewRequestIdと同じ方式)。
			let suggestRenderId = 0;

			async function renderSuggestions(suggestions: TeamSuggestion[], basis: string): Promise<void> {
				const renderId = (suggestRenderId += 1);
				lastSuggestResponse = { suggestions, basis };
				suggestionSpeciesRanks = new Map<string, number>();
				const shouldShowFormationSuggestions = membersBySlot.size >= 1 && membersBySlot.size <= 6;
				renderSelectList();
				suggestEl.innerHTML = "";
				formationMobileSuggestIcons.replaceChildren();

				// 見出しは右パネル共通のタイトル帯へ表示する。
				// scheduleSuggestions/loadSuggestionsは編成が変わるたびに走るため、個体プレビュー中
				// (previewContentElが表示中)でも背後で呼ばれうる
				// (suggestElはその間hiddenのまま、renderSuggestions自体は元からそうだった)。
				// この場合、いま実際に表示中の状態の見出しを上書きしてはいけないので、サジェストが
				// 見えている状態のときだけ帯を更新する。
				if (previewContentEl.hidden) {
					setPanelHeaderTitle("おすすめポケモン");
				}

				const filtered = await filterSuggestions(suggestions);
				if (renderId !== suggestRenderId) return; // 途中でトグル操作等により新しい描画要求が来た
				if (shouldShowFormationSuggestions) {
					filtered.forEach((suggestion, index) => {
						if (!suggestionSpeciesRanks.has(suggestion.speciesName)) {
							suggestionSpeciesRanks.set(suggestion.speciesName, index);
						}
					});
				}
				renderFormationMobile();

				if (filtered.length === 0) {
					const empty = document.createElement("p");
					empty.className = "team-suggest-status";
					empty.textContent =
						suggestions.length === 0
							? "提案がありません。"
							: "条件に一致する提案がありません。";
					suggestEl.appendChild(empty);
					return;
				}

				const list = document.createElement("ul");
				list.className = "team-suggest-list";
				filtered.forEach((s, index) => list.appendChild(buildSuggestionCard(s, index + 1)));
				suggestEl.appendChild(list);
				if (shouldShowFormationSuggestions) {
					filtered.forEach((s) => formationMobileSuggestIcons.appendChild(buildSuggestIcon(s)));
				}
			}

			function currentMemberIds(): string[] {
				return Array.from(membersBySlot.values()).map((p) => p.id);
			}

			async function loadSuggestions(): Promise<void> {
				const memberIds = currentMemberIds();
				const key = memberIds.slice().sort().join(",");
				if (key === lastSuggestKey) return;
				lastSuggestKey = key;

				const requestId = (suggestRequestId += 1);
				setSuggestStatus("おすすめを計算中…");
				try {
					const query = memberIds.length > 0 ? `?member_ids=${encodeURIComponent(memberIds.join(","))}` : "";
					const res = await fetch(`/api/team-suggestions${query}`, { credentials: "same-origin" });
					if (!res.ok) throw new Error(`サジェストの取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: TeamSuggestion[]; meta?: { basis?: string } };
					if (requestId !== suggestRequestId) return; // 編成が変わった。この結果は捨てる
					void renderSuggestions(body.data ?? [], body.meta?.basis ?? "cooccurrence");
				} catch (err) {
					console.error(err);
					if (requestId !== suggestRequestId) return;
					// 次に編成が変わったときに再試行できるよう、失敗した編成は記憶しない。
					lastSuggestKey = null;
					setSuggestStatus("おすすめを読み込めませんでした。");
				}
			}

			// 編成の変更に追随する。自動保存(scheduleSave)と同じ700msのデバウンスにして、
			// 6枠を続けて操作したときに毎回APIを叩かないようにする。
			function scheduleSuggestions(): void {
				window.clearTimeout(suggestTimer);
				suggestTimer = window.setTimeout(() => {
					void loadSuggestions();
				}, 700);
			}

			// =================================================================================
			// 類似構築: 現在の編成(membersBySlot)と育成内容が近いランク入り構築を表示する。
			// 「データ」タブ→類似構築パネル(#team-data-mobile-similar)専用。対象は最新シーズンのみ。
			// ランキングデータは初回の1回だけ取得してキャッシュし、以後は編成が変わるたびに
			// クライアント側で並べ替えるだけにする(再フェッチしない)。
			// =================================================================================

			const rankedSeason = layoutRoot.dataset.rankedSeason || null;
			let rankedTeamsPromise: Promise<RankedTeam[]> | null = null;
			function loadRankedTeams(): Promise<RankedTeam[]> {
				if (!rankedSeason) return Promise.resolve([]);
				if (!rankedTeamsPromise) {
					rankedTeamsPromise = fetch(`/api/ranked-teams?season=${encodeURIComponent(rankedSeason)}`, { credentials: "same-origin" })
						.then(async (res) => {
							if (!res.ok) throw new Error(`類似構築の取得に失敗しました (status=${res.status})`);
							const body = (await res.json()) as { teams: RankedTeam[] };
							return body.teams ?? [];
						})
						.catch((err) => {
							rankedTeamsPromise = null;
							throw err;
						});
				}
				return rankedTeamsPromise;
			}

			function setSimilarBuildsStatus(message: string, state?: "loading" | "error"): void {
				teamDataMobileSimilarRoot.innerHTML = "";
				const p = document.createElement("p");
				p.className = "team-data-similar-status status-text";
				if (state) p.dataset.state = state;
				p.textContent = message;
				teamDataMobileSimilarRoot.appendChild(p);
			}

			function renderSimilarBuilds(teams: RankedTeam[]): void {
				const team = Array.from(membersBySlot.values());
				const scored = teams
					.map((t) => ({ team: t, similarity: calculateTeamSimilarity(team, t.members) }))
					.filter((entry) => entry.similarity > 0)
					.sort((a, b) => b.similarity - a.similarity || a.team.rank - b.team.rank);
				if (scored.length === 0) {
					setSimilarBuildsStatus("類似する上位構築がありません。");
					return;
				}
				const list = document.createElement("div");
				list.className = "team-grid";
				for (const entry of scored) list.appendChild(renderTopBuildCard(entry.team));
				teamDataMobileSimilarRoot.innerHTML = "";
				teamDataMobileSimilarRoot.appendChild(list);
			}

			let similarBuildsRequestId = 0;
			async function loadSimilarBuilds(): Promise<void> {
				const requestId = (similarBuildsRequestId += 1);
				setSimilarBuildsStatus("類似構築を計算中…", "loading");
				try {
					const teams = await loadRankedTeams();
					if (requestId !== similarBuildsRequestId) return;
					renderSimilarBuilds(teams);
				} catch (err) {
					console.error(err);
					if (requestId !== similarBuildsRequestId) return;
					setSimilarBuildsStatus("類似構築を読み込めませんでした。", "error");
				}
			}

			let similarBuildsTimer: number | undefined;
			function scheduleSimilarBuilds(): void {
				window.clearTimeout(similarBuildsTimer);
				similarBuildsTimer = window.setTimeout(() => {
					void loadSimilarBuilds();
				}, 700);
			}

			// =================================================================================
			// 相性チェック
			// 「使用率上位32体のポケモンとの攻守の相性を可視化する」。
			//
			// 取得・計算の駆動・カード描画は src/lib/matchup-panel.ts に共通化し、このページは
			// チーム枠への不利メンバーハイライトだけをコールバックで渡す。
			//
			// 相手の条件: 性格補正なし・努力値H32振り・Lv50・IV31。特性と持ち物は
			// 付けない(jpoke は空文字を渡すと特性なし・持ち物なしの個体になる)。
			// これは「環境の平均的な個体」ではなく「同じ土俵で並べるための基準個体」であり、
			// 20体を互いに比較するための基準として一貫していることを優先している。
			//
			// 計算量: 相手20体 × チーム6体 = 120組。組ごとに jpoke の Battle を1つ作るが、
			// 致死率(calc_lethal、Battle全体のdeepcopyを伴う)は使わず calc_damages だけを
			// 呼ぶため、WASMヒープを圧迫しない(pyodide-engine.ts の calc_max_damage_matrix_json
			// のdocstring参照)。相手1体ぶんずつ Python を呼び、その間に進捗を描く。
			// =================================================================================

			const matchupMobileSlotsRoot = el<HTMLElement>("team-matchup-mobile-slots");
			const matchupMobileStatusEl = el<HTMLElement>("team-matchup-mobile-status");
			const matchupMobileListEl = el<HTMLElement>("team-matchup-mobile-list");
			function matchupTeamMembers(): OwnedPokemonRecord[] {
				const members: OwnedPokemonRecord[] = [];
				for (let slot = 1; slot <= 6; slot += 1) {
					const p = membersBySlot.get(slot);
					if (p && p.species_name && p.species_name.trim() !== "") members.push(p);
				}
				return members;
			}

			const matchupPanel = createMatchupPanel({
				listElement: matchupMobileListEl,
				statusElement: matchupMobileStatusEl,
				getMembers: matchupTeamMembers,
			});

			function runMatchup(): Promise<void> {
				return matchupPanel.run();
			}

			function scheduleMatchup(): void {
				if (layoutRoot.dataset.mobileTab !== "matchup") return;
				matchupPanel.schedule();
			}
			// クリック単体での追加はプレビュー表示に譲り、実際の追加操作はダブルクリック/
			// ドラッグ&ドロップに一本化する。targetSlotを指定した場合はその枠へ(既に埋まっていれば
			// 入れ替え)、省略時は空き枠のうち最小番号に入れる。選択ルール(selectionBlockReason)は
			// 入れ替え先の枠自身の在籍を重複扱いしないよう、対象枠を除いた候補リストで判定する。
			function assignToSlot(p: OwnedPokemonRecord, targetSlot?: number): void {
				const slot = targetSlot ?? firstEmptySlot();
				if (slot == null) return;
				const candidates = currentCandidatesExcludingSlot(slot);
				const reason = selectionBlockReason(candidateOf(p), candidates);
				if (reason) return;
				membersBySlot.set(slot, p);
				renderSlots();
				renderSelectList();
				renderFormationMobile();
				scheduleSave();
				// 編成が変わったのでサジェストを取り直す。
				scheduleSuggestions();
				scheduleSimilarBuilds();
				// 相性チェックを開いている場合は、その計算もやり直す。
				scheduleMatchup();
			}

			// assignToSlotは候補ポケモン用の
			// 重複チェック(selectionBlockReason)を含むため、既に編成済みの2枠を入れ替える
			// (在籍総数は変わらない)操作には不適切(移動先に既にいる個体を「重複」と誤検知しうる)。
			// membersBySlotの中身を直接swapするだけの専用関数にする。片方が空きでもよい(=移動)。
			function swapMembersBetweenSlots(fromSlot: number, toSlot: number): void {
				const fromMember = membersBySlot.get(fromSlot);
				const toMember = membersBySlot.get(toSlot);
				if (toMember) membersBySlot.set(fromSlot, toMember);
				else membersBySlot.delete(fromSlot);
				if (fromMember) membersBySlot.set(toSlot, fromMember);
				else membersBySlot.delete(toSlot);
				renderSlots();
				renderSelectList();
				renderFormationMobile();
				scheduleSave();
			}

			// --- 6枠の描画(基準3: 常に6枠) ---
			// A-1: 選択バーで個体をクリックすると常に「空き枠のうち最小番号」に入る
			// (選択ルールは受け入れ基準4で確定済み・変更不可)。
			// 候補→枠のドラッグ&ドロップは既に実装済み(row.draggable /
			// dragstart・dragend、枠側のdragover/dragleave/drop、assignToSlot呼び出し。
			// renderSlots参照)。全ての空き枠を同じ非アクションの<div>にし、
			// D&Dで追加できることが伝わる文言にする。
			function buildEmptySlotContent(slot: number): HTMLElement {
				const wrap = document.createDocumentFragment();

				const watermark = document.createElement("span");
				watermark.className = "slot-watermark-number";
				watermark.setAttribute("aria-hidden", "true");
				watermark.textContent = String(slot);

				const placeholder = document.createElement("div");
				placeholder.className = "slot-empty-cta";
				placeholder.setAttribute("aria-label", `${slot}番目の枠は空きです。左の一覧からドラッグ&ドロップすると追加できます`);
				const label = document.createElement("span");
				label.textContent = "ドラッグまたは\nダブルクリックで追加";
				placeholder.appendChild(label);

				wrap.append(watermark, placeholder);
				return wrap as unknown as HTMLElement;
			}

			// カード自体のdblclickハンドラ(renderSlots参照)と削除ボタンで共有する
			// (挙動: membersBySlotから外す→再描画→自動保存)。
			function removeMemberFromSlot(slot: number): void {
				membersBySlot.delete(slot);
				if (selectedFormationSlot === slot) selectedFormationSlot = null;
				renderSlots();
				renderSelectList();
				renderFormationMobile();
				scheduleSave();
				// 編成が変わったのでサジェストを取り直す。
				scheduleSuggestions();
				scheduleSimilarBuilds();
				// 相性チェックを開いている場合は、その計算もやり直す。
				scheduleMatchup();
			}

			function buildFilledSlotContent(slot: number, p: OwnedPokemonRecord): HTMLElement {
				const wrap = document.createDocumentFragment();

				// 空き枠(buildEmptySlotContent)と同じクラス(.slot-watermark-number)を使い、
				// 同じ位置・同じスタイルにする(状態の違いはCSS側のopacity濃淡だけで表現、
				// data-filled属性で出し分ける)。
				const watermarkEl = document.createElement("span");
				watermarkEl.className = "slot-watermark-number";
				watermarkEl.setAttribute("aria-hidden", "true");
				watermarkEl.textContent = String(slot);

				const artEl = document.createElement("div");
				artEl.className = "slot-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "slot-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "slot-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const infoEl = document.createElement("div");
				infoEl.className = "slot-info";
				let teraItem: HTMLSpanElement | null = null;

				// nameRowは横並びflex(CSS参照)で、NN→テラスアイコン→編集ボタンの順に並べ、
				// 全体をカード幅の中で中央寄せする。種族名(R-8のspeciesEl)は表示しなくなったため、
				// この画面では生成しない。
				const nameRow = document.createElement("div");
				nameRow.className = "slot-name-row";
				const name = displayName(p);

				const nicknameEl = document.createElement("span");
				nicknameEl.className = "slot-nickname";
				nicknameEl.textContent = name;
				nameRow.appendChild(nicknameEl);

				// 値が無いときはteraItem自体を生成しない
				// (pitfalls.mdの「DOMは残す」方針は要素の削除を指示されたケースには当たらない)。
				// A-7: 「テラス」は口語短縮なので公式用語「テラスタイプ」に統一する。
				// アイコンだけのバッジにする。テラスタイプ名はtitle/aria-labelに
				// 残し、スクリーンリーダー・ホバー双方でアクセス可能にする。
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					teraItem = document.createElement("span");
					teraItem.className = "slot-meta-item slot-tera-cell";
					teraItem.title = `テラスタイプ: ${teraType}`;
					teraItem.setAttribute("aria-label", `テラスタイプ: ${teraType}`);
					const teraImg = document.createElement("img");
					teraImg.className = "slot-meta-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, teraType);
					teraItem.appendChild(teraImg);
				}
				infoEl.appendChild(nameRow);

				// box/index.astroの.card-item-row(grid 2列)/.card-item-row-cell(flex中央寄せ)と
				// 同じ作りに揃える(CSS参照、metaRowは特性・アイテムの2項目のみになる。
				// テラスタイプは上のnameRowへ移した)。
				const metaRow = document.createElement("div");
				metaRow.className = "slot-meta-row";

				// A-8: 特性は既にSSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon
				// (OWNED_POKEMON_COLUMNS)の両方でability_nameとして届いている。
				// アイコンは付けない(特性の画像素材が他画面にも無いため)。
				const abilityCell = document.createElement("div");
				abilityCell.className = "slot-meta-cell";
				const abilityName = p.ability_name?.trim() ?? "";
				const abilityLabel = document.createElement("span");
				// 幅が230pxしかなく、特性/持ち物のラベルにoverflow制御が無いと長い文字列が単語の
				// 途中で2行に折り返る(例: メガリザードンXの持ち物名が「リザードナイ」「トX」の
				// ように割れる)。nicknameEl(.slot-nickname)と同じ1行ellipsis制御をslot-meta-text
				// として共通化し、ability/itemの両ラベルに適用する(下のitemLabel参照)。
				abilityLabel.className = "slot-meta-text";
				// box/index.astroの.card-ability-nameはラベル無しの特性名だけを出すため、
				// ここも「特性: 」の接頭辞を外し値だけにする(未設定の強調自体は残す)。
				if (abilityName) {
					abilityLabel.textContent = abilityName;
				} else {
					// A-6と同じ理由(「特性なし」もゲーム上存在しない状態)で未設定を明示する。
					abilityLabel.textContent = "特性未設定";
					abilityLabel.classList.add("slot-meta-unset");
				}
				abilityCell.appendChild(abilityLabel);
				metaRow.appendChild(abilityCell);

				// 持ち物なし(null/空文字)は合法な対戦状態(G-3も対象外にしている)ため、
				// セル自体は常に出し、中身(アイコン+名前)だけ値がある場合に足す
				// (box/index.astroのcard-item-row-itemと同じく、セルの有無で2列グリッドが
				// 崩れないようにする)。
				const itemCell = document.createElement("div");
				itemCell.className = "slot-meta-cell";
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemImg = document.createElement("img");
					itemImg.className = "slot-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					// 上のabilityLabelと同じ理由でslot-meta-textを適用し、長い持ち物名が単語の途中で
					// 折り返るのを防ぐ。
					itemLabel.className = "slot-meta-text";
					itemLabel.textContent = itemName;
					itemCell.append(itemImg, itemLabel);
				}
				metaRow.appendChild(itemCell);
				infoEl.appendChild(metaRow);

				// 実数値表の重複を避け、性格と0以外の努力値をHABCDS順の1段へ置き換える。
				const trainingEl = document.createElement("div");
				trainingEl.className = "slot-training";
				const evLabels = ["H", "A", "B", "C", "D", "S"];
