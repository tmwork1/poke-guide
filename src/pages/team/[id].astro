		}
		.team-slots .slot-nickname {
			min-width: 0;
			font-size: 1rem;
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		/* UI改修依頼(チーム編集中央パネル、2026-08-02)「テラスタルはアイコンのみ(タイプ名の
		   テキストは表示しない)」。テキストラベルの<span>を生成しなくなった(buildFilledSlotContent
		   参照)ため、このチップはアイコン1個だけを収める小さな丸バッジになる。テラスタイプ名は
		   title/aria-labelに残しアクセシビリティ上の情報量は落とさない。
		   .slot-meta-item はこの名前段のテラスバッジ専用(ability/item行は.slot-meta-cellを使う)
		   なので、ここでの縮小がability/item側の見た目に影響することはない。 */
		.team-slots .slot-meta-item {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex: 0 0 auto;
			padding: 0.2rem;
