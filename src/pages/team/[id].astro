						</div>
					</section>
					<div class="team-edit-layout">
					{/* --- 左: ポケモン選択バー(帯)。R-7: 検索欄を上部に固定し、下にボックスの個体を
					    縦一列に並べる。行自体はJS(document.createElement)で生成するため、
					    pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」に従い
					    #pokemon-select-list の中身のスタイルは下の<style is:global>側に置く。 --- */}
					<section class="panel panel-left team-select-bar">
						<div class="team-select-search">
							{/* 検索と並べ替えを同列に置き、限られた左パネル幅を有効に使う。 */}
							<div class="team-select-search-row">
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="pokemon-search-input"
									type="search"
									class="field-control"
									{/* 虫眼鏡アイコンが既に「検索」の意味を担うため、placeholderは短縮し
									   「で検索」を省く。aria-labelはスクリーンリーダー向けに情報量を落とさず
									   全文のまま維持する。 */}
									placeholder="ポケモンを検索"
									aria-label="ポケモンを検索"
									autocomplete="off"
								/>
