---
// チーム編集ページ(docs/plan/pages/team.md「確定した設計 > 画面 > /team/[id](編集)」)。
// 初期表示データは box/[id].astro と同じ方針で、API経由のfetchではなくAstroのフロントマター
// (SSR)で src/lib/team.ts の getTeam() を直接呼び出す(初期表示が速く、「生のSupabaseクエリは
// lib層に集約する」という設計原則にも合致する)。
//
// 未ログイン時、および他人のチーム/存在しないIDの場合はいずれもログイン導線・見つからない旨の
// メッセージを表示するのみで、強制リダイレクトはしない(box/[id].astroと同じ既存方針)。
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import { getSupabaseAdminClient } from '../../lib/supabase';
import { getTeam, type Team } from '../../lib/team';

const user = Astro.locals.user;
const id = Astro.params.id;

let team: Team | null = null;
let loadError = false;

if (user && id) {
	const supabase = await getSupabaseAdminClient();
	const result = await getTeam(user.id, id, supabase);
	if (result.ok) {
		team = result.data;
	} else {
		loadError = true;
	}
	if (!team && !loadError) {
		Astro.response.status = 404;
	}
}

// 一覧(/team)の「無題のチーム」表記(R-14)とトップバー見出しを揃える。
function displayTeamName(t: Team): string {
	return t.name && t.name.trim() !== '' ? t.name : '無題のチーム';
}

const pageTitle = team ? displayTeamName(team) : 'チーム編集';

// 初期メンバー(0〜6要素、SSR取得済み)をクライアント<script>へそのまま引き渡す。
// Astroの属性値は自動でHTMLエスケープされるので、ニックネーム等に " や < が
// 含まれていても壊れない(pokemon.tsの data-tags={JSON.stringify(...)} と同じ手法)。
const initialTeamJson = team
	? JSON.stringify({ id: team.id, name: team.name, memo: team.memo, members: team.members })
	: '';
---
<AppLayout title={pageTitle} current="team" backHref="/team">
	{team && (
		<Fragment slot="topbar-status">
			<p id="autosave-status" class="status-text" data-state="saved">
				<span id="autosave-status-text">保存済み</span>
				<button id="retry-button" type="button" title="保存に失敗しました。クリックして再試行" aria-label="保存に失敗しました。クリックして再試行">再試行</button>
			</p>
		</Fragment>
	)}
	{/* UI改修依頼(チーム編集ヘッダー)「右端に削除ボタン追加」。box/[id].astroの
	    #delete-buttonと同じマークアップ・確認ダイアログ・アイコンにする。 */}
	{team && (
		<Fragment slot="topbar-actions">
			<button id="delete-team-button" class="btn-danger" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
				削除
			</button>
		</Fragment>
	)}
	<style>
		/* 基本のトークン・カード・ボタン・フォーム部品は src/styles/global.css に集約済み。
		   ここにはこのページ固有のレイアウト・状態表現だけを残す。 */
		#retry-button {
			display: none;
			margin-left: 0.4em;
		}
		#retry-button.visible {
			display: inline-flex;
		}
		#autosave-status {
			margin: 0;
		}
		/* pitfalls.md「[hidden]は詳細度で負ける」: global.cssの.status-textが
		   display: inline-flexを持つため、UA既定の[hidden]{display:none}に勝ってしまい
		   hidden=trueにしても消えない。明示的に上書きする。 */
		#select-loading-message[hidden],
		#select-error-message[hidden] {
			display: none;
		}

		/* --- 全体レイアウト: 左=ポケモン選択バー(帯)/ 中央=チーム名・メモ・6枠(可読幅1080px) ---
		   docs/plan/ui_rounds/00-foundation.md「レイアウト原則」どおり、選択バーは画面端から
		   画面端まで伸びる帯(.panel.panel-left)。中央は.panel-contentで1080pxに絞る(R-11)。
		   受け入れ検証で実測バグ修正: 閾値をもともと900pxにしていたが、900px幅ではサイドバー(256px)+
		   選択バー(約380px)を引くと中央カラムが約264pxしか残らず、そこへ横長の6枠カードを
		   入れていたため、ポケモン名・技名が1文字ずつ縦に折り返されて読めなくなっていた(実測で発覚)。
		   これはbox/[id].astroの.edit-layoutが900px→1200pxに引き上げた過去の罠
		   (docs/plan/ui_rounds/00-foundation.md 245行目)と同一原因なので、同じ閾値に揃える。 */
		.team-edit-layout {
			display: block;
		}
		@media (min-width: 1200px) {
			.team-edit-layout {
				display: grid;
				grid-template-columns: minmax(300px, 380px) 1fr;
				align-items: stretch;
			}
		}
		/* UI改修依頼(チーム編集左パネル)「右パネルを追加」対応。box/[id].astroの
		   .edit-layout(1600px以上で3カラム化、RightPanel.astro参照)と同じ閾値・考え方で
		   3カラム目(.team-preview-panel)を追加する。1200〜1599pxでは右パネルは
		   非表示にする(下の.team-preview-panel参照)、幅が無いところに無理に3カラム目を
		   押し込むと中央カラムの6枠カードが再び潰れるため(上のコメントの実測バグと同じ罠)。 */
		@media (min-width: 1600px) {
			.team-edit-layout {
				grid-template-columns: minmax(300px, 380px) 1fr minmax(280px, 340px);
			}
		}

		.team-select-bar {
			display: flex;
			flex-direction: column;
			min-width: 0;
		}
		/* box/[id].astroの.panel-leftと同じ考え方: トップバー直下から画面下端まで帯を伸ばす。
		   帯自体の高さはビューポート基準(calc(100vh - var(--topbar-height)))で決め、
		   個体数が少なくても背景色が画面下端まで届くようにする。1200px未満(縦積み)では
		   sticky/固定高さにせず、通常のブロックとして中央カラムの上に積む(box/[id].astroの
		   .edit-layout-leftがmin-width:1200pxのメディアクエリでだけheight:100%を付けているのと
		   同じ考え方。縦積み時に選択バーが画面いっぱいの高さを占有すると、6枠に到達するまで
		   1画面ぶん余計にスクロールする羽目になる)。閾値は.team-edit-layoutの2カラム化と
		   必ず揃えること。 */
		@media (min-width: 1200px) {
			.team-select-bar {
				position: sticky;
				top: var(--topbar-height);
				height: calc(100vh - var(--topbar-height));
			}
		}

		.team-select-search {
			flex: 0 0 auto;
			padding-bottom: var(--space-3);
			margin-bottom: var(--space-3);
			border-bottom: 1px solid var(--color-border);
		}
		.search-input-wrap {
			position: relative;
			display: flex;
			align-items: center;
		}
		.search-input-wrap .search-icon {
			position: absolute;
			left: 0.7em;
			color: var(--color-text-muted);
			pointer-events: none;
		}
		#pokemon-search-input {
			width: 100%;
			padding-left: 2.1em;
		}

		.team-select-list-wrap {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			/* B-1は実装後にCoordinatorが差し戻した(round-30.md「Coordinatorの実測検証で
			   差し戻した変更」節)。29-R1と同型の margin-block: auto による上下中央寄せを
			   一度入れたが、実機では検索欄の直下に約310pxの空白が空き、リストが宙に浮いて
			   「検索欄と選択リストが別の帯」に見えた。同じラウンドでユーザーが右パネルに
			   対して「最上部」(31-R1)を明示し 29-R1 の中央寄せ自体を撤回しているため、
			   この帯にだけ同じパターンを新規導入するのは最新の方針と逆行する。
			   下端の空白(657px)は個体が増えれば自然に埋まる性質のものなので、
			   上端起点のまま据え置く。 */
			display: flex;
			flex-direction: column;
		}
		/* 1200px未満(選択バーが帯ではなく縦積みの通常ブロックになる)では高さを固定せず、
		   代わりに際限なく伸びないよう上限を設ける(ボックスの個体数が多いユーザー向け)。 */
		@media (max-width: 1199px) {
			.team-select-list-wrap {
				max-height: 60vh;
			}
		}

		#pokemon-select-list {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		/* 選択バー内の空状態(0件/検索一致0件)。box/index.astroの.empty-stateと同じ語彙・見た目。 */
		.empty-state {
			margin-top: var(--space-4);
			padding: var(--space-5) var(--space-3);
			border: 1px dashed var(--color-border);
			border-radius: var(--radius-lg);
			text-align: center;
			color: var(--color-text-muted);
		}
		.empty-state-icon {
			font-size: 2rem;
			margin: 0 0 var(--space-2);
		}
		.empty-state-title {
			margin: 0 0 var(--space-1);
			font-size: var(--font-size-md);
			font-weight: 700;
			color: var(--color-text);
		}
		.empty-state-hint {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-sm);
		}

		/* --- 中央カラム: チーム名・メモ + 6枠(R-11: .panel-contentで1080pxに収める) --- */
		.team-edit-main {
			min-width: 0;
		}
		.team-meta-fields {
			margin-bottom: var(--space-6);
		}
		.team-name-input {
			width: 100%;
			/* global.cssの input[type="text"] { min-width: 12em } は、このinputのfont-size
			   (--font-size-xl、24px)基準だと288pxの下限になり、900px幅(2カラム化する最小幅)で
			   横スクロールを引き起こしていた(実測: scrollWidth 924px / clientWidth 900px)。
			   width:100%で親に追従させたいので明示的に打ち消す。 */
			min-width: 0;
			font-size: var(--font-size-xl);
			font-weight: 700;
		}
		/* UI改修依頼(チーム編集中央パネル)「メモは下に移動」により6枠の下へ動いたため、
		   margin-topではなく6枠との間隔をteam-slots側のmargin-bottomで確保する
		   (このinput自体は他の場所にmarginを持たない)。 */
		.team-memo-input {
			width: 100%;
			min-width: 0;
		}

		/* UI改修依頼(チーム編集中央パネル)「2x3配置に変更」。1列縦積みから3列2行のグリッドへ。 */
		.team-slots {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		/* --- 右: プレビューパネル(UI改修依頼、チーム編集左パネル)。box/[id].astroの
		   RightPanel.astroと同じく1600px未満では表示しない(グリッド自体も2カラムのため)。 --- */
		.team-preview-panel {
			display: none;
		}
		@media (min-width: 1600px) {
			.team-preview-panel {
				display: block;
				position: sticky;
				top: var(--topbar-height);
				height: calc(100vh - var(--topbar-height));
				overflow-y: auto;
			}
		}
		.team-preview-empty {
			color: var(--color-text-muted);
			font-size: var(--font-size-sm);
		}
	</style>

	<div class="page">
		{
			!user ? (
				<section class="panel">
					<div class="panel-content">
						<p>チームを編集するにはログインが必要です。</p>
						<a class="btn-primary" href="/api/auth/login">Googleでログイン</a>
					</div>
				</section>
			) : loadError ? (
				<section class="panel">
					<div class="panel-content">
						<p>チーム情報の取得に失敗しました。時間をおいて再度お試しください。</p>
					</div>
				</section>
			) : !team ? (
				<section class="panel">
					<div class="panel-content">
						<p>指定されたチームが見つかりませんでした(削除された、または他のアカウントのチームである可能性があります)。</p>
					</div>
				</section>
			) : (
				<div class="team-edit-layout" id="team-edit-layout" data-team-id={team.id} data-initial-team={initialTeamJson}>
					{/* --- 左: ポケモン選択バー(帯)。R-7: 検索欄を上部に固定し、下にボックスの個体を
					    縦一列に並べる。行自体はJS(document.createElement)で生成するため、
					    pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」に従い
					    #pokemon-select-list の中身のスタイルは下の<style is:global>側に置く。 --- */}
					<section class="panel panel-left team-select-bar">
						<div class="team-select-search">
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="pokemon-search-input"
									type="search"
									class="field-control"
									placeholder="ニックネーム・種族名で検索"
									aria-label="ニックネーム・種族名で検索"
									autocomplete="off"
								/>
							</div>
						</div>
						<div class="team-select-list-wrap">
							<p id="select-loading-message" class="status-text" data-state="loading">読み込み中...</p>
							<p id="select-error-message" class="status-text" data-state="error" hidden>個体一覧の取得に失敗しました。時間をおいて再度お試しください。</p>
							<div id="pokemon-select-list"></div>
							{/* R-9: ボックス0件のときの空状態。/boxの.empty-stateと同じ語彙 + /boxへのリンク。 */}
							<div id="select-empty-state" class="empty-state" hidden>
								<p class="empty-state-icon" aria-hidden="true">📦</p>
								<p class="empty-state-title">ボックスに個体がありません</p>
								<p class="empty-state-hint">先にボックスで個体を登録してください。</p>
								<a class="btn-primary" href="/box">ボックスへ</a>
							</div>
							<div id="select-no-match-state" class="empty-state" hidden>
								<p class="empty-state-icon" aria-hidden="true">🔍</p>
								<p class="empty-state-title">条件に一致する個体がいません</p>
								<p class="empty-state-hint">検索語を変更してください。</p>
							</div>
						</div>
					</section>

					{/* --- 中央: チーム名 + 6枠 + メモ。.panel-contentで可読幅1080pxに収める(R-11・基準23)。
					    UI改修依頼(チーム編集中央パネル)「未設定の場合...を削除」「メモは下に移動」により、
					    ヒント文言を削除しメモ欄を6枠の下へ移動した。 --- */}
					<div class="team-edit-main">
						<div class="panel-content">
							<div class="team-meta-fields">
								<input
									id="team-name"
									class="field-control team-name-input"
									type="text"
									placeholder="チーム名"
									aria-label="チーム名"
									autocomplete="off"
									value={team.name ?? ''}
								/>
							</div>

							{/* 6枠(基準3)。空き枠も枠として常に描く。中身はJS(renderSlots)が生成するため、
							    子要素(.card-team-slot)のスタイルは下の<style is:global>側に置く。
							    UI改修依頼(チーム編集中央パネル)「2x3配置に変更」により、1列縦積みから
							    3列2行のグリッドへ変更する(CSSは下の.team-slots参照)。 */}
							<div id="team-slots" class="team-slots"></div>

							<input
								id="team-memo"
								class="field-control team-memo-input"
								type="text"
								placeholder="メモ(この構成は誰向けか、など)"
								aria-label="メモ"
								autocomplete="off"
								value={team.memo ?? ''}
							/>
						</div>
					</div>

					{/* --- 右: 選択バーで1回クリックしたポケモンの詳細プレビュー(UI改修依頼
					    「右パネルを追加し、1回クリックでポケモンの詳細を見れるようにする」)。
					    中身はJS(renderPreviewPanel)が生成する。box/[id].astroのRightPanelと同じく
					    幅の無い環境(1600px未満)では非表示にする(下の.team-preview-panel参照)。 --- */}
					<aside class="panel team-preview-panel" id="team-preview-panel">
						<p class="team-preview-empty" id="team-preview-empty">左の一覧からポケモンをクリックすると、ここに詳細が表示されます。</p>
						<div class="team-preview-content" id="team-preview-content" hidden></div>
					</aside>
				</div>
			)
		}
	</div>

	{/* --- JS生成要素(選択バーの行・6枠カード)のスタイル。pitfalls.md「Astroのscoped styleは
	    JSで生成した要素に効かない」に従い is:global で定義する。.team-select-bar / .team-slots
	    配下に限定したセレクタにしてグローバルへ漏れないようにする。 --- */}
	<style is:global>
		/* ------------------------------------------------------------------ */
		/* 選択バーの1行(.pokemon-select-row)                                  */
		/* UI改修依頼(チーム編集左パネル)「特性/アイテム/ステータスも表示」「ダブルクリックと
		   ドラッグアンドドロップでチームに設定」「編集リンクを追加」対応で、行全体を1個の
		   <button>にする構造から「プレビュー用button(.select-row-main)」+
		   「編集リンク(.select-row-edit-link)」を横に並べる<div>構造へ組み替えた
		   (<button>の中に<a>を入れることはHTML的に無効なため)。 */
		/* ------------------------------------------------------------------ */
		.team-select-bar .pokemon-select-row {
			display: flex;
			align-items: stretch;
			gap: var(--space-2);
			width: 100%;
		}
		/* ドラッグ中の行自身を半透明にして「持ち上げている」感を出す(is-dragging、
		   <script>のdragstart/dragend参照)。 */
		.team-select-bar .pokemon-select-row.is-dragging {
			opacity: 0.5;
		}
		.team-select-bar .select-row-main {
			flex: 1 1 auto;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			text-align: left;
			cursor: pointer;
		}
		.team-select-bar .select-row-main:hover:not(:disabled) {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		.team-select-bar .select-row-main:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		/* 選択不可(基準6・7・21): グレーアウト + 理由を常時テキスト表示する(titleに頼らない)。
		   なお選択不可でもプレビュー(1回クリック)は引き続きできる(disabledはダブルクリックの
		   追加操作だけを止めるためのものではなく、ボタン全体を無効化する。プレビューはボタン
		   要素自体をclickするため、disabled中はプレビューも一緒に止まる。「選べない個体は
		   詳細も見られない」状態は既存のブロック理由表示(select-row-reason)と矛盾しないため
		   許容する)。 */
		.team-select-bar .select-row-main:disabled {
			cursor: not-allowed;
			opacity: 0.55;
		}
		.team-select-bar .select-row-art {
			flex: 0 0 auto;
			width: 36px;
			height: 36px;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}
		.team-select-bar .select-row-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
