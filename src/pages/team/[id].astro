				</section>
			) : loadError ? (
				<section class="panel">
					<div class="panel-content">
						<p>チーム情報の取得に失敗しました。時間をおいて再度お試しください。</p>
					</div>
				</section>
			) : !team ? (
				<section class="panel">
					<div class="panel-content">
						<p>指定されたチームが見つかりませんでした(削除された、または他のアカウントのチームである可能性があります)。</p>
					</div>
				</section>
			) : (
				<div class="team-edit-layout" id="team-edit-layout" data-team-id={team.id} data-initial-team={initialTeamJson}>
					{/* --- 左: ポケモン選択バー(帯)。R-7: 検索欄を上部に固定し、下にボックスの個体を
					    縦一列に並べる。行自体はJS(document.createElement)で生成するため、
					    pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」に従い
					    #pokemon-select-list の中身のスタイルは下の<style is:global>側に置く。 --- */}
					<section class="panel panel-left team-select-bar">
						<div class="team-select-search">
							<div class="search-input-wrap">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<input
									id="pokemon-search-input"
									type="search"
									class="field-control"
									{/* UI改修依頼(チーム編集左パネル、2026-08-01)「パネルの幅を20%狭くする」に伴う
									   実測修正: 380px時代のplaceholder全文(「ニックネーム・種族名で検索」)は304pxへの
									   縮小後、実機で末尾の1文字が枠内に収まりきらず見切れることを実測で確認した
									   (虫眼鏡アイコンが既に「検索」の意味を担うため、placeholderだけ短縮して
									   「で検索」を省く。aria-labelはスクリーンリーダー向けに情報量を落とさず
									   全文のまま維持する)。 */}
									placeholder="ニックネーム・種族名"
									aria-label="ニックネーム・種族名で検索"
									autocomplete="off"
								/>
							</div>
							{/* UI改修依頼(チーム編集左パネル)「ソート機能を追加する」。box/index.astroの
							    並べ替え(.sort-select-wrap、34-B2でラベル<label>を廃しアイコン重畳に統一
							    済み)と同じマークアップ・アイコンを踏襲する。選べる基準はOwnedPokemonRecord
							    が既に持つ値の中から自然なもの: 登録順(created_at、既定)・名前順
							    (表示名=displayNameのニックネーム優先、ja collateで自然順)・種族名順。
							    「タイプ順」は選択バーの個体データにタイプ情報が無く新規取得が必要になる
							    ため採用しない(依頼文の「例えば」は例示であり必須ではないと判断)。 */}
							{/* 🔴 UI改修依頼(チーム編集画面、2026-08-01)+ ユーザー確認(同日、
							    「絞り込みトグルを付ける」)。チームにレギュレーションが指定されている
							    ときだけ現れるトグルで、既定ON=そのレギュレーションで使える個体だけを
							    選択バーに出す。OFFにすると従来どおり全個体が出る。
							    「使える個体」= 個体のレギュレーションがチームと一致するもの + 個体側が
							    未指定のもの(未指定は「まだ決めていない」であって「使えない」ではないため、
							    隠すと既存の個体が軒並み消えて選べなくなる)。
							    チーム側が未指定のときは絞る基準が無いのでトグル自体を隠す
							    (下のsyncRegulationFilterToggle参照)。 */}
							<div class="team-select-regulation-filter" id="regulation-filter-wrap" hidden>
								<button
									type="button"
									id="regulation-filter-toggle"
									class="regulation-filter-toggle"
									data-active="true"
									aria-pressed="true"
								>
									<span id="regulation-filter-toggle-label">レギュレーション一致のみ</span>
								</button>
							</div>

							<div class="team-select-sort">
								<div class="sort-select-wrap">
									<svg class="sort-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M7 4v16" />
										<path d="M4 7l3-3 3 3" />
										<path d="M17 20V4" />
										<path d="M14 17l3 3 3-3" />
									</svg>
									<select id="pokemon-sort-select" class="field-control" aria-label="並べ替え">
										<option value="created_at">登録順</option>
										<option value="name">名前順</option>
										<option value="species_name">種族名順</option>
									</select>
								</div>
							</div>
						</div>
						<div class="team-select-list-wrap">
							<p id="select-loading-message" class="status-text" data-state="loading">読み込み中...</p>
							<p id="select-error-message" class="status-text" data-state="error" hidden>個体一覧の取得に失敗しました。時間をおいて再度お試しください。</p>
							<div id="pokemon-select-list"></div>
							{/* R-9: ボックス0件のときの空状態。/boxの.empty-stateと同じ語彙 + /boxへのリンク。 */}
							<div id="select-empty-state" class="empty-state" hidden>
								<p class="empty-state-icon" aria-hidden="true">📦</p>
								<p class="empty-state-title">ボックスに個体がありません</p>
								<p class="empty-state-hint">先にボックスで個体を登録してください。</p>
								<a class="btn-primary" href="/box">ボックスへ</a>
							</div>
							<div id="select-no-match-state" class="empty-state" hidden>
								<p class="empty-state-icon" aria-hidden="true">🔍</p>
								<p class="empty-state-title">条件に一致する個体がいません</p>
								<p class="empty-state-hint">検索語を変更してください。</p>
							</div>
						</div>
					</section>

					{/* --- 中央: チーム名 + 6枠 + メモ。.panel-contentで可読幅1080pxに収める(R-11・基準23)。
					    UI改修依頼(チーム編集中央パネル)「未設定の場合...を削除」「メモは下に移動」により、
					    ヒント文言を削除しメモ欄を6枠の下へ移動した。 --- */}
					<div class="team-edit-main">
						<div class="panel-content">
							<div class="team-meta-fields">
								{/* UI改修依頼(チーム編集中央パネル)「"チーム名"というラベルを追加する」。
								    既存のラベル付きフィールド規格(src/styles/global.cssの.field/.field-stack/
								    .field-label、他ページでは box/[id].astro 等が使用)をそのまま使う。
								    可視ラベルが増えたため、同じ意味を二重に持たせないようinputのaria-labelは
								    外す(<label for>がアクセシブルネームを提供する)。 */}
								<div class="field field-stack">
									<label for="team-name" class="field-label">チーム名</label>
									<input
										id="team-name"
										class="field-control team-name-input"
										type="text"
										placeholder="チーム名"
										autocomplete="off"
										value={team.name ?? ''}
									/>
								</div>
								{/* 🔴 UI改修依頼(チーム編集画面、2026-08-01)「個体編集と同様にレギュレーション
								    指定機能を追加」。個体編集側(LeftPanel.astroの#regulation)と同じく
								    「なし」を先頭のvalue=""のoptionが担い、保存時はnullに正規化される
								    (team-validation.tsのnormalizeOptionalString)。チーム名の隣に置く。
								    2026-08-01追記「"レギュレーション"というラベルを削除する。他のUIと同様に
								    placeholderの色を薄くする」: 可視ラベル(<label>)は撤去し、LeftPanel.astroの
								    #regulationと同じくplaceholder + aria-labelの方式に揃える(アクセシビリティ
								    上のaccessible nameはaria-labelが担う)。未選択時はLeftPanel.astroの
								    #regulation[data-empty="true"]と同じCSS(破線・薄い文字色)を適用するため
								    data-emptyを付ける(<script>のsyncRegulationPlaceholder参照)。 */}
								<div class="field team-regulation-field">
									<select id="team-regulation" class="field-control" aria-label="レギュレーション" data-empty={team.regulation ? undefined : 'true'}>
										<option value="">{REGULATION_PLACEHOLDER}</option>
										{REGULATIONS_NEWEST_FIRST.map((r) => <option value={r} selected={team.regulation === r}>{r}</option>)}
									</select>
								</div>
							</div>

							{/* 6枠(基準3)。空き枠も枠として常に描く。中身はJS(renderSlots)が生成するため、
							    子要素(.card-team-slot)のスタイルは下の<style is:global>側に置く。
							    UI改修依頼(チーム編集中央パネル)「2x3配置に変更」により、1列縦積みから
							    3列2行のグリッドへ変更する(CSSは下の.team-slots参照)。 */}
							<div id="team-slots" class="team-slots"></div>

							<input
								id="team-memo"
								class="field-control team-memo-input"
								type="text"
								placeholder="メモ(この構成は誰向けか、など)"
								aria-label="メモ"
								autocomplete="off"
								value={team.memo ?? ''}
							/>
						</div>
					</div>

					{/* --- 右: 選択バーで1回クリックしたポケモンの詳細プレビュー(UI改修依頼
					    「右パネルを追加し、1回クリックでポケモンの詳細を見れるようにする」)。
					    中身はJS(renderPreviewPanel)が生成する。box/[id].astroのRightPanelと同じく
					    幅の無い環境(1600px未満)では非表示にする(下の.team-preview-panel参照)。 --- */}
					<aside class="panel team-preview-panel" id="team-preview-panel">
						{/* UI改修依頼(右パネル、2026-08-01)「"左の一覧からポケモンをクリックすると、
						    ここに詳細が表示されます。"を削除する」。文言だけを消すと空の<p>が1行ぶんの
						    余白を残すため、要素自体を最初からhiddenにする(pitfalls.md「要素を消す指示
						    でもDOMは残す」に従い、#team-preview-emptyのid自体は<script>のel()参照
						    (previewEmptyEl)が必要とするため残す。renderPreviewPanelがこの要素を
						    hidden=trueにする処理は元々あり、二度と表示されない前提でも壊れない)。 */}
						<p class="team-preview-empty" id="team-preview-empty" hidden></p>
						<div class="team-preview-content" id="team-preview-content" hidden></div>
					</aside>
				</div>
			)
		}
	</div>

	{/* --- JS生成要素(選択バーの行・6枠カード)のスタイル。pitfalls.md「Astroのscoped styleは
	    JSで生成した要素に効かない」に従い is:global で定義する。.team-select-bar / .team-slots
	    配下に限定したセレクタにしてグローバルへ漏れないようにする。 --- */}
	<style is:global>
		/* UI改修依頼(チーム編集ヘッダー)「チーム名表示を削除する」。box/[id].astroの23-H1と
		   同じ手法(AppLayoutは編集禁止のため、bodyClass="team-edit-page"を起点にしたグローバル
		   セレクタで.app-topbar-title(AppLayout側の要素、このページのscoped<style>では選択
		   できない)だけを隠す。<title>タグ(ブラウザタブ)はpageTitleのまま残る)。 */
		body.team-edit-page .app-topbar-title {
			display: none;
		}

		/* ------------------------------------------------------------------ */
		/* 選択バーの1行(.pokemon-select-row)                                  */
		/* UI改修依頼(チーム編集左パネル)「特性/アイテム/ステータスも表示」「ダブルクリックと
		   ドラッグアンドドロップでチームに設定」「編集リンクを追加」対応で、行全体を1個の
		   <button>にする構造から「プレビュー用button(.select-row-main)」+
		   「編集リンク(.select-row-edit-link)」を横に並べる<div>構造へ組み替えた
		   (<button>の中に<a>を入れることはHTML的に無効なため)。 */
		/* ------------------------------------------------------------------ */
		.team-select-bar .pokemon-select-row {
			display: flex;
			align-items: stretch;
			gap: var(--space-2);
			width: 100%;
		}
		/* ドラッグ中の行自身を半透明にして「持ち上げている」感を出す(is-dragging、
		   <script>のdragstart/dragend参照)。 */
		.team-select-bar .pokemon-select-row.is-dragging {
			opacity: 0.5;
		}
		.team-select-bar .select-row-main {
			flex: 1 1 auto;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			text-align: left;
			cursor: pointer;
		}
		.team-select-bar .select-row-main:hover:not(:disabled) {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		.team-select-bar .select-row-main:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 1px;
		}
		/* 選択不可(基準6・7・21): グレーアウト + 理由を常時テキスト表示する(titleに頼らない)。
		   なお選択不可でもプレビュー(1回クリック)は引き続きできる(disabledはダブルクリックの
		   追加操作だけを止めるためのものではなく、ボタン全体を無効化する。プレビューはボタン
		   要素自体をclickするため、disabled中はプレビューも一緒に止まる。「選べない個体は
		   詳細も見られない」状態は既存のブロック理由表示(select-row-reason)と矛盾しないため
		   許容する)。 */
		.team-select-bar .select-row-main:disabled {
			cursor: not-allowed;
			opacity: 0.55;
		}
		.team-select-bar .select-row-art {
			flex: 0 0 auto;
			width: 36px;
			height: 36px;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}
		.team-select-bar .select-row-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-select-bar .select-row-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 0.9rem;
		}
		.team-select-bar .select-row-body {
			flex: 1 1 auto;
			min-width: 0;
			width: 0;
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
		}
		.team-select-bar .select-row-name {
			/* UI改修依頼(チーム編集左パネル、2026-08-01)「種族名以外の文字をもう少し大きくする」
			   により0.88rem(14.08px)から引き上げる。 */
			font-size: 0.95rem;
			font-weight: 700;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.team-select-bar .select-row-species {
			/* A-3(b): 0.74rem(11.84px)は12px下限を割っていた。0.75rem(12px)に是正。 */
			font-size: 0.75rem;
			color: var(--color-text-muted);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* UI改修依頼(チーム編集左パネル)「特性/アイテムも表示」。 */
		.team-select-bar .select-row-meta-row {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem;
			/* UI改修依頼(チーム編集左パネル、2026-08-01)「種族名以外の文字をもう少し大きくする」
			   により0.72rem(11.52px)から引き上げる。 */
			font-size: 0.8rem;
			color: var(--color-text-muted);
		}
		.team-select-bar .select-row-meta-item {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
		}
		.team-select-bar .select-row-meta-icon {
			width: 16px;
			height: 16px;
			object-fit: contain;
		}
		/* UI改修依頼(チーム編集左パネル)「ステータスも表示」。6値だと選択バーの1行としては
		   縦に伸びすぎるため、H/A/B/C/D/Sをラベル+数値の短いチップにして折り返す。 */
		.team-select-bar .select-row-stat-row {
			display: flex;
			flex-wrap: wrap;
			gap: 0.3rem;
		}
		.team-select-bar .select-row-stat-chip {
			/* UI改修依頼(チーム編集左パネル、2026-08-01)「種族名以外の文字をもう少し大きくする」
			   により0.68rem(10.88px)から引き上げる。 */
			font-size: 0.75rem;
			font-weight: 700;
			color: var(--color-text-muted);
			background: var(--color-surface-alt);
			border-radius: 3px;
			padding: 0.05rem 0.3rem;
		}
		.team-select-bar .select-row-stat-chip[data-mod="up"] { color: var(--color-danger-strong); }
		.team-select-bar .select-row-stat-chip[data-mod="down"] { color: var(--color-primary); }
		/* A-3(a): 「編成済み」(already-in-team、正常)と禁止3種(6体編成済み/種族が重複/
		   持ち物が重複)が同じ危険色・同じ書式だったため、4/6のように複数体が既に編成済み
		   だと選択バー全体が赤く見え「エラーが起きている」と誤読された。data-reasonで
		   実質3値(選べる/もう入っている/禁止)を色で伝える。--color-danger-strongは
		   自動保存失敗の表示(#autosave-status)と共有するトークンなので、正常状態からは
		   外す。新色は作らない。 */
		.team-select-bar .select-row-reason {
			/* A-3(b): 0.74rem(11.84px)は12px下限を割っていた。0.75rem(12px)に是正。
			   UI改修依頼(チーム編集左パネル、2026-08-01)「種族名以外の文字をもう少し大きくする」
			   によりさらに0.8rem(12.8px)へ引き上げる。 */
			font-size: 0.8rem;
			font-weight: 700;
		}
		.team-select-bar .select-row-reason[data-reason="already-in-team"] {
			color: var(--color-text-muted);
			font-weight: 600;
		}
		.team-select-bar .select-row-reason:not([data-reason="already-in-team"]) {
			color: var(--color-danger-strong);
		}
		/* ------------------------------------------------------------------ */
		/* 6枠カード(.card-team-slot)。中身はfilled/emptyのいずれか(R-8)。       */
		/* UI改修依頼(チーム編集中央パネル)「2x3配置に変更」「ポケモンの情報の見せ方を
		   ボックス画面と表記をそろえる」により、横並び(番号+絵+情報+操作)から
		   ボックス画面の.card-pokemonと同じ縦積み(絵を中央上・情報を下)へ組み替える
		   (3列グリッドの1マスは幅が半分弱に狭まるため、横並びのままだと窮屈になる)。
		   番号バッジは絵の左上に重ねる(box画面のバッジ重畳と同じ考え方)ため、
		   position:relativeを持たせる。 --- */
		.team-slots .card-team-slot {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 0.3rem;
			min-height: 108px;
		}
		/* ドラッグ&ドロップの受け入れ先であることを示すハイライト(左パネルのpokemon-select-rowを
		   ドラッグ中にこのカードの上に重なると付く。<script>のドラッグハンドラ参照)。 */
		.team-slots .card-team-slot.is-drop-target {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 90%, var(--color-primary) 10%);
		}
		/* UI改修依頼(チーム編集中央パネル)「シングルクリックで右パネルにプレビュー」
		   「ダブルクリックで削除」。埋まっている枠(<script>のrenderSlotsがdata-filled="true"の
		   ときだけclick/dblclickを付与)だけをクリック可能にする(空き枠は何も起きないため
		   カーソルを変えない)。 */
		.team-slots .card-team-slot[data-filled="true"] {
			cursor: pointer;
		}
		.team-slots .card-team-slot[data-filled="true"]:hover {
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-surface) 95%, var(--color-primary) 5%);
		}
		/* 空き枠プレースホルダー(要件6)。A-1: 実際に個体が入るのは常に選択ルール(受け入れ
		   基準4で確定済み、変更不可)が返す最小番号の空き枠だけなので、「＋ この枠に入れる」
		   が押せるのは<button>で描く最小番号の1枠だけにする(<script>のbuildEmptySlotContent
		   参照)。それ以外の空き枠は押しても何も起きない<div>で「選択すると若い番号から
		   埋まります」の非アクション文言にする(実態と食い違わせない)。共通のレイアウトは
		   ここでまとめ、押せる/押せないの違いはタグ名(button/div)セレクタで出し分ける。 */
		.team-slots .slot-empty-cta {
			flex: 1 1 auto;
			width: 100%;
			display: flex;
			/* UI改修依頼(チーム編集中央パネル)2x3グリッド化に伴い、カード全体を縦積みにした
			   (上の.card-team-slotコメント参照)。空き枠プレースホルダーも同じ縦積みに揃え、
			   カードの中央に番号+ラベルを配置する。 */
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-2);
			background: transparent;
			border: 0;
			/* global.cssの汎用button{ padding: 0.55em 1.1em }を打ち消す。<button>版だけ
			   このpaddingが残ると左インセットが付き、<div>版(空き枠の非アクション表示)と
			   番号のx座標がずれる(A-5の実測で発覚: button版のみx=665.7、div版はx=649)。 */
			padding: 0;
			color: var(--color-text-muted);
			font-weight: 600;
			font-size: var(--font-size-md);
			cursor: default;
			text-align: center;
		}
		.team-slots button.slot-empty-cta {
			cursor: pointer;
		}
		/* .cardのhover(border-color: primary / background色付け、global.css)は両方の
		   空き枠に等しく効くため、「押せそう」に見える文字色のホバー強調は実際に押せる
		   <button>版だけに限定する。 */
		.team-slots .card-team-slot:hover button.slot-empty-cta,
		.team-slots .card-team-slot:focus-within button.slot-empty-cta {
			color: var(--color-primary);
		}

		/* A-5: 埋まった枠(.slot-number)と空き枠(.slot-empty-number)の番号を、同じ円形
		   バッジ・同じ幅(2rem)・同じx位置(カード左端、.cardのpadding直後)に統一する。
		   以前は.slot-numberが幅2.2rem・枠線なしのプレーンテキストで.card-team-slotの
		   直接の子(x=649)、.slot-empty-numberは幅2remの円形バッジだが親の.slot-empty-cta
		   がjustify-content: centerだったためカード中央(x=1091.1)にずれていた
		   (align-items: stretchを持つ.card-team-slotの直接の子は明示的な高さを持つと
		   ストレッチされず既定でflex-start相当になるため、align-selfで明示的に中央寄せする)。
		   状態の違いは実線(埋まり)/破線(空き)の罫線スタイルだけで表現し、data-filled属性を
		   実際にCSSから参照する(以前はJSがセットするだけで参照するセレクタが0件だった)。 */
		.team-slots .slot-number,
		.team-slots .slot-empty-number {
			flex: 0 0 auto;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			height: 2rem;
			border-radius: 50%;
			font-weight: 800;
			font-size: 1rem;
			color: var(--color-text-muted);
			background: var(--color-surface);
		}
		.team-slots .card-team-slot[data-filled="true"] .slot-number {
			border: 1px solid var(--color-border);
			/* UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応で縦積みに
			   組み替えたため、番号バッジはbox画面のバッジ重畳と同じくカード左上に重ねて置く
			   (.card-team-slotのposition:relativeを基準にする)。 */
			position: absolute;
			top: var(--space-2);
			left: var(--space-2);
			box-shadow: var(--shadow-sm);
		}
		/* A-4: ダークで約1.18:1(#2d313d on #22252f)しか出ず「値がある/ない」を伝える罫線
		   として機能していなかったため、.slot-empty-numberに限りAA適合済みの補助色
		   --color-text-muted(ライト#5b6472/ダーク#9aa1b0)へ転用する。--color-borderを
		   使う他の「弱くてよい罫線」(カード外枠・検索欄の下罫線など)は対象外。
		   A-5(c): あわせてborder-styleをdashedにし、/team一覧の.card-team-thumb.is-empty
		   と同じ「空き=破線」の文法に揃える。 */
		.team-slots .card-team-slot[data-filled="false"] .slot-empty-number {
			border: 1px dashed var(--color-text-muted);
		}
		.team-slots .slot-art {
			flex: 0 0 auto;
			/* 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「カードを再レイアウトする」。
			   box/index.astroのカードは公式絵に幅の過半(min(56%, 113px))を割り当てて一覧性より
			   絵の存在感を優先している。このカード(1辺約290〜310px、box一覧の210〜240pxより
			   大きい)でも同じ考え方で88px→104pxへ拡大し、名前・メタ情報より絵が主役に見える
			   比率へ寄せる(3列グリッドの最小幅でも余裕がある範囲、実測は報告参照)。 */
			width: 104px;
			height: 104px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-slots .slot-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-slots .slot-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 1.4rem;
		}
		.team-slots .slot-info {
			flex: 1 1 auto;
			min-width: 0;
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.3rem;
		}
		.team-slots .slot-name-row {
			display: flex;
			align-items: baseline;
			justify-content: center;
			gap: 0.5em;
			flex-wrap: wrap;
		}
		.team-slots .slot-nickname {
			font-size: 1rem;
			font-weight: 700;
		}
		.team-slots .slot-species {
			font-size: 0.82rem;
			color: var(--color-text-muted);
		}
		.team-slots .slot-meta-row {
			display: flex;
			/* A-8で特性を足して項目が2→3になったことで、pitfalls.md「横スクロールが無い
			   ことは狭幅レイアウトの合格条件ではない」の実例と同型の破綻が390px幅で発生した
			   (flex-wrapが無いと、各項目が1文字ずつ縦積みになるまで潰れる)。wrapを許可し、
			   幅が足りない項目は単位(アイコン+ラベル)ごと次の行へ送る(2〜3行の折り返しは可)。 */
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			row-gap: 0.3rem;
			column-gap: var(--space-3);
			font-size: 0.82rem;
			color: var(--color-text-muted);
		}
		.team-slots .slot-meta-item {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			/* 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「カードを再レイアウトする」。
			   box/index.astroの.card-item-badge・.card-ability-nameや下の.slot-move-chipと
			   同じ「情報チップ」の視覚言語(背景+角丸)をability/item/teraにも適用し、単なる
			   並びのテキストではなく個別の要素として見分けやすくする(新しい配色トークンは
			   作らずvar(--color-surface-alt)を流用、move-chipと違い枠線は付けない)。 */
			padding: 0.15rem 0.5rem;
			background: var(--color-surface-alt);
			border-radius: var(--radius-md);
		}
		.team-slots .slot-meta-icon {
			width: 20px;
			height: 20px;
			object-fit: contain;
		}
		/* A-6: 特性が未設定のとき(ゲーム上「値が無い」状態が存在しない項目)を明示するための強調。
		   新色は作らず既存の--color-danger-strongを流用する。持ち物(合法な空)には使わない。
		   2026-08-01: テラスタイプは未設定時に行ごと非表示にする方針へ変更したため、この強調の
		   対象からは外れた(buildFilledSlotContent参照。クラス自体は特性向けに引き続き使う)。 */
		.team-slots .slot-meta-unset {
			color: var(--color-danger-strong);
			font-weight: 700;
		}
		.team-slots .slot-moves {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.3rem;
		}
		.team-slots .slot-move-chip {
			font-size: 0.78rem;
			font-weight: 600;
			color: var(--color-text-muted);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: 4px;
			padding: 0.1rem 0.45rem;
		}
		/* A-6: 技0件の明示。同じく--color-danger-strongを流用する。 */
		.team-slots .slot-move-chip-unset {
			color: var(--color-danger-strong);
			border-color: var(--color-danger-strong);
			font-weight: 700;
		}
		.team-slots .slot-actions {
			flex: 0 0 auto;
			width: 100%;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
			margin-top: 0.2rem;
		}
		.team-slots .slot-actions .btn-ghost,
		.team-slots .slot-actions .btn-danger {
			font-size: var(--font-size-sm);
			white-space: nowrap;
		}
		/* B-2: 「枠から外す」は自動保存つきで即座に確定する破壊操作なので、隣の「個体を編集」
		   (遷移・安全)と文字色だけ分ける(確認ダイアログは操作頻度から見て過剰と判断し追加
		   しない → round-30.md「Coordinatorの判断」)。新色は作らず既存トークンを流用する。
		   UI改修依頼(チーム編集中央パネル)「ゴミ箱ボタンで削除」により、文字ボタンから
		   アイコンのみの円形ボタンへ変更した。サイズ・枠線・背景はbox/index.astroの
		   .icon-button規格(28px円形+1px枠線+var(--color-surface))と同じ値を採用する
		   (global.cssの汎用button paddingを打ち消してアイコンを中央寄せする)。 */
		.team-slots .slot-actions .slot-remove-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-danger-strong);
			box-shadow: var(--shadow-sm);
		}
		.team-slots .slot-actions .slot-remove-btn:hover {
			background: var(--color-surface-alt);
		}
		/* 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「個体編集ボタンをアイコンのみの
		   表記にする」。上の.slot-remove-btnと同じ円形28pxアイコンボタン規格を採用し、
		   危険操作ではないため色だけ中立(--color-text-muted、ホバーで--color-primary)にする。 */
		.team-slots .slot-actions .slot-edit-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-text-muted);
			box-shadow: var(--shadow-sm);
		}
		.team-slots .slot-actions .slot-edit-link:hover {
			background: var(--color-surface-alt);
			color: var(--color-primary);
		}

		/* ------------------------------------------------------------------ */
		/* 右: プレビューパネル(UI改修依頼、チーム編集左パネル「右パネルを追加」)。       */
		/* box/[id].astroのRightPanel.astroと似た縦積み構成にする。                */
		/* ------------------------------------------------------------------ */
		.team-preview-panel .team-preview-content {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--space-2);
		}
		.team-preview-panel .team-preview-art {
			width: 120px;
			height: 120px;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.team-preview-panel .team-preview-sprite-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.team-preview-panel .team-preview-sprite-fallback {
			display: none;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			background: var(--color-primary-soft);
			color: var(--color-primary);
			font-weight: 700;
			font-size: 2rem;
		}
		.team-preview-panel .team-preview-name {
			margin: 0;
			font-size: var(--font-size-lg);
			font-weight: 800;
		}
		.team-preview-panel .team-preview-species {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-muted);
		}
		.team-preview-panel .team-preview-meta-row {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--space-3);
			font-size: 0.85rem;
			color: var(--color-text-muted);
		}
		.team-preview-panel .team-preview-meta-row > span {
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
		}
		.team-preview-panel .team-preview-meta-icon {
			width: 20px;
			height: 20px;
			object-fit: contain;
		}
		.team-preview-panel .team-preview-stat-grid {
			display: grid;
			grid-template-columns: repeat(6, minmax(0, 1fr));
			gap: 0.2rem 0.4rem;
			width: 100%;
		}
		.team-preview-panel .team-preview-stat-label {
			font-size: 0.75rem;
			font-weight: 700;
			color: var(--color-text-muted);
		}
		.team-preview-panel .team-preview-stat-label[data-mod="up"] { color: var(--color-danger-strong); }
		.team-preview-panel .team-preview-stat-label[data-mod="down"] { color: var(--color-primary); }
		.team-preview-panel .team-preview-stat-value {
			font-size: 0.9rem;
			font-weight: 800;
		}
		.team-preview-panel .team-preview-moves {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.3rem;
		}
		.team-preview-panel .team-preview-move-chip {
			font-size: 0.78rem;
			font-weight: 600;
			color: var(--color-text-muted);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: 4px;
			padding: 0.1rem 0.45rem;
		}
		.team-preview-panel .team-preview-edit-link {
			margin-top: var(--space-2);
		}
	</style>

	<script>
		// チーム編集: ポケモン選択バー(左)と6枠(中央)を描画し、自動保存する。
		// 自動保存のデバウンス方式は box/[id].astro と同じ(700ms・保存ボタンは作らない・
		// topbar-statusスロットで状態表示)。初期表示データ(SSR取得済みのチーム)は
		// #team-edit-layout の data-initial-team から読む(fetch往復を待たずに6枠を描ける)。
		import { loadImageIdMap, officialArtworkUrl, loadBaseStatsMap } from "../../lib/pokemon-master-data";
		import { loadItemSpriteMap, itemIconUrl, teraTypeIconUrl } from "../../lib/sprite-urls";
		import { resolveDexNo } from "../../lib/species-dex";
		import { selectionBlockReason, type SelectionCandidate, type SelectionBlockReason } from "../../lib/team-validation";
		import { STAT_KEYS, NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat } from "../../lib/stats";

		interface OwnedPokemonRecord {
			id: string;
			nickname: string | null;
			species_name: string;
			// A-8: SSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方が既にability_nameを含んでいる。新規フェッチ・新規計算は不要で、この型に
			// 足すだけで枠カード・選択バーの両方から読める。
			ability_name: string | null;
			item_name: string | null;
			tera_type: string | null;
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01): 選択バーのレギュレーション絞り込みに使う。
			// SSR(lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方に regulation を追加済みなので、この型に足すだけで両経路から読める。
			regulation: string | null;
			move_names: string[];
			// UI改修依頼(チーム編集左パネル)「ステータスも表示」対応で追加。box/index.astroと同じ
			// 実数値計算(src/lib/stats.ts)に使う。level/nature/evs/ivsもSSR・GET /api/owned-pokemon
			// の両方に既に含まれているため、フロント側の型に足すだけでよい。
			level: number | null;
			nature: string | null;
			evs: number[];
			ivs: number[];
			// UI改修依頼(チーム編集左パネル)「ソート機能を追加する」の「登録順」用。SSR
			// (lib/team.tsのTEAM_MEMBER_SELECT)・GET /api/owned-pokemon(OWNED_POKEMON_COLUMNS)の
			// 両方に既にcreated_atを含んでいるため、この型に足すだけで読める(新規フェッチ不要)。
			created_at: string;
			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」用。GET
			// /api/owned-pokemonのレスポンスには含まれるが、SSR(lib/team.tsのTEAM_MEMBER_SELECT)
			// には含まれていない(このファイル単体の変更ではlib/team.tsを直せないため)。そのため
			// SSR直後のmembersBySlot初期値ではundefinedになりうる値としてoptionalにし、GET
			// /api/owned-pokemon完了後にallPokemonの同IDレコードで補う
			// (refreshCollectionOptOutToggle参照)。
			collection_opt_out_until?: string | null;
		}

		interface TeamMemberData {
			slot: number;
			owned_pokemon: OwnedPokemonRecord;
		}

		interface InitialTeam {
			id: string;
			name: string | null;
			memo: string | null;
			regulation: string | null;
			members: TeamMemberData[];
		}

		const layoutRoot = document.getElementById("team-edit-layout");
		if (layoutRoot) {
			const teamId = layoutRoot.dataset.teamId as string;
			const initialTeam: InitialTeam = JSON.parse(layoutRoot.dataset.initialTeam || "{}");

			function el<T extends HTMLElement>(id: string): T {
				const found = document.getElementById(id);
				if (!found) throw new Error(`要素が見つかりません: #${id}`);
				return found as T;
			}

			const nameInput = el<HTMLInputElement>("team-name");
			const memoInput = el<HTMLInputElement>("team-memo");
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)「個体編集と同様にレギュレーション指定機能」。
			const regulationSelect = el<HTMLSelectElement>("team-regulation");
			const regulationFilterWrap = el<HTMLElement>("regulation-filter-wrap");
			const regulationFilterToggle = el<HTMLButtonElement>("regulation-filter-toggle");
			const slotsRoot = el<HTMLElement>("team-slots");

			const searchInput = el<HTMLInputElement>("pokemon-search-input");
			const sortSelect = el<HTMLSelectElement>("pokemon-sort-select");
			const selectListRoot = el<HTMLElement>("pokemon-select-list");
			const selectLoadingMessage = el<HTMLElement>("select-loading-message");
			const selectErrorMessage = el<HTMLElement>("select-error-message");
			const selectEmptyState = el<HTMLElement>("select-empty-state");
			const selectNoMatchState = el<HTMLElement>("select-no-match-state");

			const statusEl = el<HTMLElement>("autosave-status");
			const statusTextEl = el<HTMLElement>("autosave-status-text");
			const retryButton = el<HTMLButtonElement>("retry-button");
			const deleteTeamButton = el<HTMLButtonElement>("delete-team-button");
			const collectionOptOutToggle = el<HTMLInputElement>("team-collection-opt-out-toggle");
			const collectionOptOutStatusEl = el<HTMLElement>("team-collection-opt-out-status");

			const previewEmptyEl = el<HTMLElement>("team-preview-empty");
			const previewContentEl = el<HTMLElement>("team-preview-content");

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定できるように
			// する」。dataTransferはドラッグ元(別ウィンドウ等)の互換性のため一応セットするが、
			// 同一ページ内のドラッグしか想定していないため、実際の受け渡しはこのモジュール内の
			// 変数(draggedPokemonId)で行う(dataTransfer.getData()はdragover中は読めない
			// ブラウザ実装が多く、dropまで値を保持する目的にも向かないため)。
			let draggedPokemonId: string | null = null;

			const imageIdMapPromise = loadImageIdMap();
			const itemSpriteMapPromise = loadItemSpriteMap();
			const baseStatsMapPromise = loadBaseStatsMap();

			const STAT_LABELS: Record<(typeof STAT_KEYS)[number], string> = {
				hp: "H", atk: "A", def: "B", spa: "C", spd: "D", spe: "S",
			};

			// UI改修依頼(チーム編集左パネル/右パネル)「ステータスも表示」。box/index.astroの
			// applyActualStatsと同じ式・同じフォールバック(level??50, iv??31, ev??0)。
			async function computeStats(p: OwnedPokemonRecord): Promise<{ key: string; label: string; value: number; mod: "up" | "down" | null }[] | null> {
				const base = p.species_name ? (await baseStatsMapPromise).get(p.species_name) : undefined;
				if (!base) return null;
				const level = p.level ?? 50;
				const mod = NATURE_STAT_MODIFIERS[p.nature ?? ""] ?? { up: null, down: null };
				return STAT_KEYS.map((key, i) => {
					const iv = p.ivs[i] ?? 31;
					const ev = p.evs[i] ?? 0;
					const value =
						key === "hp"
							? calcHpStat(level, base[i], iv, ev)
							: calcOtherStat(level, base[i], iv, ev, mod.up === key ? 1.1 : mod.down === key ? 0.9 : 1.0);
					const statMod = key === "hp" ? null : mod.up === key ? "up" : mod.down === key ? "down" : null;
					return { key, label: STAT_LABELS[key], value, mod: statMod };
				});
			}

			// 6枠の現在状態(slot 1..6 -> 個体。無ければ空き)。
			const membersBySlot = new Map<number, OwnedPokemonRecord>();
			for (const m of initialTeam.members ?? []) {
				membersBySlot.set(m.slot, m.owned_pokemon);
			}

			// ボックスの全個体(選択バーの中身)。GET /api/owned-pokemon から取得する。
			let allPokemon: OwnedPokemonRecord[] = [];

			// nickname・species_nameのどちらも空の場合のフォールバック(/boxのdisplayNameと同じ語彙)。
			function displayName(p: OwnedPokemonRecord): string {
				if (p.nickname && p.nickname.trim() !== "") return p.nickname;
				if (p.species_name && p.species_name.trim() !== "") return p.species_name;
				return "(未設定)";
			}

			function candidateOf(p: OwnedPokemonRecord): SelectionCandidate {
				return {
					dexNo: resolveDexNo(p.species_name),
					itemName: p.item_name,
					ownedPokemonId: p.id,
				};
			}

			function currentCandidates(): SelectionCandidate[] {
				return Array.from(membersBySlot.values()).map(candidateOf);
			}

			// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップで設定」用。既に埋まっている
			// 枠へドロップして入れ替える(=その枠自身の在籍は重複扱いしない)場合に使う。
			function currentCandidatesExcludingSlot(slot: number): SelectionCandidate[] {
				return Array.from(membersBySlot.entries())
					.filter(([s]) => s !== slot)
					.map(([, p]) => candidateOf(p));
			}

			function firstEmptySlot(): number | null {
				for (let slot = 1; slot <= 6; slot += 1) {
					if (!membersBySlot.has(slot)) return slot;
				}
				return null;
			}

			const BLOCK_REASON_LABELS: Record<Exclude<SelectionBlockReason, null>, string> = {
				"already-in-team": "編成済み",
				"team-full": "6体編成済み",
				"duplicate-species": "種族が重複",
				"duplicate-item": "持ち物が重複",
			};

			// 公式絵。取得できない場合は頭文字の丸バッジにフォールバックする
			// (box/index.astroのapplyCardSpriteと同じ方式。loading="lazy"は付けない
			// ---display:noneの<img>は遅延読み込みの対象外としてonloadが発火しない)。
			async function applySprite(imgEl: HTMLImageElement, fallbackEl: HTMLElement, name: string): Promise<void> {
				const imageId = name ? (await imageIdMapPromise).get(name) : undefined;
				if (imageId == null) {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name ? name.charAt(0) : "?";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
					fallbackEl.style.display = "flex";
					fallbackEl.textContent = name.charAt(0);
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
					fallbackEl.style.display = "none";
				};
				imgEl.src = officialArtworkUrl(imageId);
			}

			// 持ち物アイコン(アイコン+名前、R-8)。アイコンが解決できない/読み込み失敗のときも
			// 名前のテキストは残す(box/index.astroの持ち物行と同じ考え方)。
			async function applyItemIcon(imgEl: HTMLImageElement, itemName: string): Promise<void> {
				const spritePath = (await itemSpriteMapPromise).get(itemName);
				if (!spritePath) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = itemIconUrl(spritePath);
			}

			// テラスタイプアイコン(アイコン+名前)。teraTypeIconUrlは同期解決(静的マップ)。
			function applyTeraIcon(imgEl: HTMLImageElement, teraName: string): void {
				const url = teraTypeIconUrl(teraName);
				if (!url) {
					imgEl.style.display = "none";
					return;
				}
				imgEl.onerror = () => {
					imgEl.style.display = "none";
				};
				imgEl.onload = () => {
					imgEl.style.display = "";
				};
				imgEl.src = url;
			}

			// UI改修依頼(チーム編集左パネル)「1回クリックでポケモンの詳細を見れるように」。
			// 右パネル(1600px未満では非表示)にプレビューを描く。チーム編成そのものには影響しない
			// (membersBySlotを一切変更しない、見るだけの機能)。
			async function renderPreviewPanel(p: OwnedPokemonRecord): Promise<void> {
				previewEmptyEl.hidden = true;
				previewContentEl.hidden = false;
				previewContentEl.innerHTML = "";

				const artEl = document.createElement("div");
				artEl.className = "team-preview-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "team-preview-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "team-preview-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);
				previewContentEl.appendChild(artEl);

				const name = displayName(p);
				const nameEl = document.createElement("p");
				nameEl.className = "team-preview-name";
				nameEl.textContent = name;
				previewContentEl.appendChild(nameEl);
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("p");
					speciesEl.className = "team-preview-species";
					speciesEl.textContent = p.species_name;
					previewContentEl.appendChild(speciesEl);
				}

				const metaRow = document.createElement("div");
				metaRow.className = "team-preview-meta-row";
				const abilityEl = document.createElement("span");
				abilityEl.textContent = p.ability_name?.trim() || "特性未設定";
				metaRow.appendChild(abilityEl);
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraEl = document.createElement("span");
					const teraImg = document.createElement("img");
					teraImg.className = "team-preview-meta-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, teraType);
					const teraLabel = document.createElement("span");
					teraLabel.textContent = teraType;
					teraEl.append(teraImg, teraLabel);
					metaRow.appendChild(teraEl);
				}
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					const itemImg = document.createElement("img");
					itemImg.className = "team-preview-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				previewContentEl.appendChild(metaRow);

				const statGrid = document.createElement("div");
				statGrid.className = "team-preview-stat-grid";
				const stats = await computeStats(p);
				if (stats) {
					for (const s of stats) {
						const labelEl = document.createElement("span");
						labelEl.className = "team-preview-stat-label";
						labelEl.textContent = s.label + (s.mod === "up" ? "▲" : s.mod === "down" ? "▼" : "");
						if (s.mod) labelEl.dataset.mod = s.mod;
						const valueEl = document.createElement("span");
						valueEl.className = "team-preview-stat-value";
						valueEl.textContent = String(s.value);
						statGrid.append(labelEl, valueEl);
					}
					previewContentEl.appendChild(statGrid);
				}

				const moves = p.move_names.filter((m) => m && m.trim() !== "");
				if (moves.length > 0) {
					const movesEl = document.createElement("div");
					movesEl.className = "team-preview-moves";
					for (const move of moves) {
						const chip = document.createElement("span");
						chip.className = "team-preview-move-chip";
						chip.textContent = move;
						movesEl.appendChild(chip);
					}
					previewContentEl.appendChild(movesEl);
				}

				const editLink = document.createElement("a");
				editLink.className = "btn-ghost team-preview-edit-link";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.textContent = "個体を編集";
				previewContentEl.appendChild(editLink);
			}

			// UI改修依頼(チーム編集左パネル)「ダブルクリックとドラッグアンドドロップでチームに
			// 設定できるように」。クリック単体での追加(旧仕様)はプレビュー表示に譲り、実際の
			// 追加操作はダブルクリック/ドラッグ&ドロップに一本化する。targetSlotを指定した場合は
			// その枠へ(既に埋まっていれば入れ替え)、省略時は空き枠のうち最小番号に入れる
			// (旧仕様のfirstEmptySlotと同じ)。選択ルール(selectionBlockReason)は入れ替え先の枠
			// 自身の在籍を重複扱いしないよう、対象枠を除いた候補リストで判定する。
			function assignToSlot(p: OwnedPokemonRecord, targetSlot?: number): void {
				const slot = targetSlot ?? firstEmptySlot();
				if (slot == null) return;
				const candidates = currentCandidatesExcludingSlot(slot);
				const reason = selectionBlockReason(candidateOf(p), candidates);
				if (reason) return;
				membersBySlot.set(slot, p);
				renderSlots();
				renderSelectList();
				scheduleSave();
				refreshCollectionOptOutToggle();
			}

			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」。現在のチームメンバー
			// (owned_pokemon)のIDだけを返す(重複はteam-validationの選択ルールで既に防がれている
			// ため考慮不要)。
			function currentMemberIds(): string[] {
				return Array.from(membersBySlot.values()).map((p) => p.id);
			}

			// collection_opt_out_until(null/過去=提供中、未来=拒否中)から「提供中かどうか」を
			// 判定する。box/[id].astroのformatOptOutRemaining(フロントマター側)と同じ判定式。
			function isProviding(p: OwnedPokemonRecord): boolean {
				if (!p.collection_opt_out_until) return true;
				return new Date(p.collection_opt_out_until).getTime() <= Date.now();
			}

			// トグルの表示(checked/disabled)を現在のチームメンバーの実際の状態から再計算する。
			// メンバーが1人もいなければ対象が無いためdisabled。allPokemon(GET /api/owned-pokemon、
			// 下部の初期化処理で取得)が届く前はSSR由来のmembersBySlotの値(collection_opt_out_until
			// を持たない)しか無いため、その場合は「全員提供中」を既定値として扱う(DBの既定値
			// =NULL=提供中と一致するため、fetch完了までの一瞬だけ生じる楽観値。fetch完了後に
			// このcronがもう一度呼ばれ正確な値に補正される→fetchハンドラ参照)。
			// 🔴 UI改修依頼(チーム編集ヘッダー、2026-08-01)「非公開」トグルへの改称に伴い、
			// checkedの向きを反転する: 「メンバー全員が提供中」のときだけfalse(=非公開ではない)、
			// 1人でも拒否中(非公開)ならtrueにする(旧: 全員提供中のときtrue)。DBを読む式
			// (isProviding)自体は変えていない、checkedへの反映だけを反転させている。
			function refreshCollectionOptOutToggle(): void {
				const ids = currentMemberIds();
				if (ids.length === 0) {
					collectionOptOutToggle.checked = false;
					collectionOptOutToggle.disabled = true;
					syncCollectionOptOutTitle();
					return;
				}
				collectionOptOutToggle.disabled = false;
				const allProviding = Array.from(membersBySlot.values()).every((p) => {
					const fresh = allPokemon.find((x) => x.id === p.id);
					return isProviding(fresh ?? p);
				});
				collectionOptOutToggle.checked = !allProviding;
				syncCollectionOptOutTitle();
			}

			// UI改修依頼(チーム編集ヘッダー、2026-08-01)「ホバーテキストはOFF時:育成データを匿名で
			// 提供する / ON時:30日間有効」。メンバー0人時(disabled)のtitleはSSR側の固定文言のまま
			// 変えない(<AppLayout>のtopbar-actionsスロット、上のフロントマター参照)。
			const collectionOptOutLabel = document.querySelector<HTMLLabelElement>(".collection-opt-out-toggle");
			function syncCollectionOptOutTitle(): void {
				if (!collectionOptOutLabel || collectionOptOutToggle.disabled) return;
				collectionOptOutLabel.title = collectionOptOutToggle.checked ? "30日間有効" : "育成データを匿名で提供する";
			}

			// --- 6枠の描画(基準3: 常に6枠) ---
			// A-1: 選択バーで個体をクリックすると常に「空き枠のうち最小番号」に入る
			// (選択ルールは受け入れ基準4で確定済み・変更不可)。4/6のように空き枠が複数
			// 同時にあるとき、以前は全ての空き枠が「＋ この枠に入れる」を表示し、
			// aria-labelも「{slot}番目の枠にポケモンを入れる」と個別の枠を特定していたが、
			// 実際にはどの空き枠を押しても最小番号にしか入らず、約束と実態が食い違っていた。
			// 表示側だけを実態に合わせる: isNextToFill(=firstEmptySlot()と一致)の1枠だけ
			// 実際に押せる<button>にし、それ以外は非アクションの<div>にする。
			function buildEmptySlotContent(slot: number, isNextToFill: boolean): HTMLElement {
				const number = document.createElement("span");
				number.className = "slot-empty-number";
				number.setAttribute("aria-hidden", "true");
				number.textContent = String(slot);

				if (isNextToFill) {
					const button = document.createElement("button");
					button.type = "button";
					button.className = "slot-empty-cta";
					button.setAttribute("aria-label", `${slot}番目の枠にポケモンを入れる`);
					const label = document.createElement("span");
					label.textContent = "＋ この枠に入れる";
					button.append(number, label);
					// 実際の追加操作は左の選択バーから行う(R-7)。このボタンは検索欄へ誘導するだけの
					// 補助動線(必須要件ではないが、6枠側からも選択バーに気付けるようにする)。
					button.addEventListener("click", () => {
						searchInput.focus();
						searchInput.scrollIntoView({ block: "nearest" });
					});
					return button;
				}

				const placeholder = document.createElement("div");
				placeholder.className = "slot-empty-cta";
				placeholder.setAttribute("aria-label", `${slot}番目の枠は空きです。選択すると若い番号から埋まります`);
				const label = document.createElement("span");
				label.textContent = "選択すると若い番号から埋まります";
				placeholder.append(number, label);
				return placeholder;
			}

			// UI改修依頼(チーム編集中央パネル)「ダブルクリックまたはゴミ箱ボタンで、その個体を
			// チームから削除できるようにする」。旧・removeButtonのクリックハンドラをここへ切り出し、
			// カード自体のdblclickハンドラ(renderSlots参照)と共有する(挙動は変えていない:
			// membersBySlotから外す→再描画→自動保存)。
			function removeMemberFromSlot(slot: number): void {
				membersBySlot.delete(slot);
				renderSlots();
				renderSelectList();
				scheduleSave();
				refreshCollectionOptOutToggle();
			}

			function buildFilledSlotContent(slot: number, p: OwnedPokemonRecord): HTMLElement {
				const wrap = document.createDocumentFragment();

				const numberEl = document.createElement("div");
				numberEl.className = "slot-number";
				numberEl.textContent = String(slot);

				const artEl = document.createElement("div");
				artEl.className = "slot-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "slot-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "slot-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const infoEl = document.createElement("div");
				infoEl.className = "slot-info";

				const nameRow = document.createElement("div");
				nameRow.className = "slot-name-row";
				const name = displayName(p);
				const nicknameEl = document.createElement("span");
				nicknameEl.className = "slot-nickname";
				nicknameEl.textContent = name;
				nameRow.appendChild(nicknameEl);
				// ニックネームと種族名が異なる場合のみ種族名を併記する(R-8)。
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("span");
					speciesEl.className = "slot-species";
					speciesEl.textContent = p.species_name;
					nameRow.appendChild(speciesEl);
				}
				infoEl.appendChild(nameRow);

				const metaRow = document.createElement("div");
				metaRow.className = "slot-meta-row";

				// A-8: 特性は既にSSR(TEAM_MEMBER_SELECT)・GET /api/owned-pokemon
				// (OWNED_POKEMON_COLUMNS)の両方でability_nameとして届いている。
				// アイコンは付けない(特性の画像素材が他画面にも無いため)。
				const abilityName = p.ability_name?.trim() ?? "";
				const abilityItem = document.createElement("span");
				abilityItem.className = "slot-meta-item";
				const abilityLabel = document.createElement("span");
				// UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応:
				// box/index.astroの.card-ability-nameはラベル無しの特性名だけを出すため、
				// ここも「特性: 」の接頭辞を外し値だけにする(未設定の強調自体は残す)。
				if (abilityName) {
					abilityLabel.textContent = abilityName;
				} else {
					// A-6と同じ理由(「特性なし」もゲーム上存在しない状態)で未設定を明示する。
					abilityLabel.textContent = "特性未設定";
					abilityLabel.classList.add("slot-meta-unset");
				}
				abilityItem.appendChild(abilityLabel);
				metaRow.appendChild(abilityItem);

				// 🔴 UI改修依頼(共通、2026-08-01)「テラスタイプが未設定の場合、"未設定"などと
				// 表示せず要素ごと非表示にする」。旧A-6の判断(常に行を出し「テラスタイプ未設定」を
				// 明示する)をこの指示により撤回する。持ち物(下記)と同じく、値が無いときはteraItem
				// 自体をmetaRowへappendしない(pitfalls.mdの「DOMは残す」方針は要素の削除を指示された
				// このケースには当たらない ── そもそも生成しないだけで、既存のDOM/IDを壊してはいない)。
				// A-7: 「テラス」は口語短縮なので公式用語「テラスタイプ」に統一する(この方針自体は維持)。
				const teraType = p.tera_type?.trim() ?? "";
				if (teraType) {
					const teraItem = document.createElement("span");
					teraItem.className = "slot-meta-item";
					const teraImg = document.createElement("img");
					teraImg.className = "slot-meta-icon";
					teraImg.alt = "";
					teraImg.style.display = "none";
					applyTeraIcon(teraImg, teraType);
					const teraLabel = document.createElement("span");
					// UI改修依頼(チーム編集中央パネル)「ボックス画面と表記をそろえる」対応:
					// box/index.astroのアイコン+値のみの表記に揃え「テラスタイプ: 」の接頭辞を外す。
					teraLabel.textContent = teraType;
					teraItem.append(teraImg, teraLabel);
					metaRow.appendChild(teraItem);
				}

				// 持ち物なし(null/空文字)は合法な対戦状態(G-3も対象外にしている)なので、
				// テラスタイプ・特性とは違い、これまでどおり行自体を出さない。
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					itemEl.className = "slot-meta-item";
					const itemImg = document.createElement("img");
					itemImg.className = "slot-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				// 特性は常に出すため(unset時も"特性未設定"を表示)、metaRowは常に非空になる
				// (2026-08-01: テラスタイプは未設定時に行ごと非表示にするため、この非空保証には含めない)。
				infoEl.appendChild(metaRow);

				// A-6: 技0件も行ごと消さず「未設定」を明示する(技0件・テラス未設定の
				// ディンルーが「情報が少ないだけのカード」に見え、対戦に出せない未完成状態だと
				// 伝わらなかったため)。
				const moves = p.move_names.filter((m) => m && m.trim() !== "");
				const movesEl = document.createElement("div");
				movesEl.className = "slot-moves";
				if (moves.length > 0) {
					for (const move of moves) {
						const chip = document.createElement("span");
						chip.className = "slot-move-chip";
						chip.textContent = move;
						movesEl.appendChild(chip);
					}
				} else {
					const chip = document.createElement("span");
					chip.className = "slot-move-chip slot-move-chip-unset";
					chip.textContent = "未設定";
					movesEl.appendChild(chip);
				}
				infoEl.appendChild(movesEl);

				const actionsEl = document.createElement("div");
				actionsEl.className = "slot-actions";
				// 🔴 UI改修依頼(チーム編集中央パネル、2026-08-01)「個体編集ボタンをアイコンのみの
				// 表記にする」。文字リンク(「個体を編集」)を、隣の削除ボタン(.slot-remove-btn、
				// box/index.astroの.icon-button規格=28px円形+1px枠線+var(--color-surface))と同じ
				// 円形アイコンボタンに揃える(CSSは下の.team-slots .slot-actions .slot-edit-link参照)。
				// アイコンはlucide風の鉛筆(編集)、他のインラインSVGと同じ書式(stroke=currentColor、
				// stroke-width=2)。視覚的な意味の手掛かりが無くなる分、title(ホバー)とaria-labelで
				// テキストの情報を維持する。
				const editLink = document.createElement("a");
				editLink.className = "btn-ghost slot-edit-link";
				editLink.href = `/box/${encodeURIComponent(p.id)}`;
				editLink.title = "個体を編集";
				editLink.setAttribute("aria-label", `${name}を編集`);
				editLink.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>';
				// カード自体にclick(プレビュー)/dblclick(削除)を付けたため(renderSlots参照)、
				// このリンクへのクリックがバブリングして意図せずプレビュー描画を誘発しないよう止める
				// (遷移自体には影響しない)。
				editLink.addEventListener("click", (event) => {
					event.stopPropagation();
				});
				// UI改修依頼(チーム編集中央パネル)「ダブルクリックまたはゴミ箱ボタンで、その個体を
				// チームから削除できるようにする」。旧「枠から外す」の文字ボタンをゴミ箱アイコンの
				// アイコンボタンに変更する(box/[id].astroの個体削除ボタンと同じ発想のインラインSVG。
				// 見た目のサイズ・円形・枠線はbox/index.astroの.icon-button規格(28px円形+枠線)を
				// 踏襲する。CSS側は.team-slots .slot-remove-btn参照)。危険操作であることは常時
				// --color-danger-strongの文字色で示す(B-2の判断を踏襲し確認ダイアログは追加しない。
				// チームからの除外は個体そのものの削除ではなく、いつでも選択バーから再度追加できる
				// 低リスクな操作のため)。
				const removeButton = document.createElement("button");
				removeButton.type = "button";
				removeButton.className = "btn-ghost slot-remove-btn";
				removeButton.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>';
				removeButton.title = "チームから外す";
				removeButton.setAttribute("aria-label", `${name}を${slot}番目の枠から外す`);
				removeButton.addEventListener("click", (event) => {
					event.stopPropagation();
					removeMemberFromSlot(slot);
				});
				actionsEl.append(editLink, removeButton);

				wrap.append(numberEl, artEl, infoEl, actionsEl);
				return wrap as unknown as HTMLElement;
			}

			function renderSlots(): void {
				slotsRoot.innerHTML = "";
				// A-1: 「押せる」空き枠は選択ルールが実際に埋める最小番号の1枠だけ。
				const nextEmptySlot = firstEmptySlot();
				for (let slot = 1; slot <= 6; slot += 1) {
					const card = document.createElement("article");
					card.className = "card card-team-slot";
					card.dataset.slot = String(slot);
					const p = membersBySlot.get(slot);
					if (p) {
						card.dataset.filled = "true";
						card.appendChild(buildFilledSlotContent(slot, p));
						// UI改修依頼(チーム編集中央パネル)
						// 「7. ダブルクリックまたはゴミ箱ボタンで、その個体をチームから削除できる」
						// 「8. シングルクリックで、右パネルにその個体の詳細を表示する」。
						// 左パネルの選択行(mainButton)と全く同じ操作割り当て(1回クリック=プレビュー、
						// ダブルクリック=変更操作)をカード全体に適用する。ゴミ箱ボタン自身のクリックは
						// stopPropagation済みなので、ここでの2重発火(プレビュー→即削除)は起きない。
						card.addEventListener("click", () => {
							void renderPreviewPanel(p);
						});
						card.addEventListener("dblclick", () => {
							removeMemberFromSlot(slot);
						});
					} else {
						card.dataset.filled = "false";
						card.appendChild(buildEmptySlotContent(slot, slot === nextEmptySlot));
					}

					// UI改修依頼(チーム編集左パネル)「ドラッグアンドドロップでチームに設定」。
					// 空き枠・埋まっている枠のどちらにもドロップできる(埋まっている枠は入れ替え)。
					card.addEventListener("dragover", (event) => {
						if (!draggedPokemonId) return;
						event.preventDefault();
						card.classList.add("is-drop-target");
					});
					card.addEventListener("dragleave", () => {
						card.classList.remove("is-drop-target");
					});
					card.addEventListener("drop", (event) => {
						event.preventDefault();
						card.classList.remove("is-drop-target");
						const id = draggedPokemonId;
						draggedPokemonId = null;
						if (!id) return;
						const p = allPokemon.find((x) => x.id === id);
						if (!p) return;
						assignToSlot(p, slot);
					});
					slotsRoot.appendChild(card);
				}
			}

			// --- 選択バーの描画(R-7・R-10) ---
			function matchesSearch(p: OwnedPokemonRecord, term: string): boolean {
				if (!term) return true;
				const haystack = [p.nickname ?? "", p.species_name].join(" ").toLowerCase();
				return term
					.toLowerCase()
					.split(/\s+/)
					.filter((t) => t.length > 0)
					.every((token) => haystack.includes(token));
			}

			// UI改修依頼(チーム編集左パネル)「チームに含まれる個体を(左パネルの一覧から)
			// 非表示にする」。以前は「編成済み」(already-in-team、選択ルールの3禁止理由とは別扱い)
			// としてグレーアウト表示していたが、この依頼により一覧そのものから除外する。
			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)+ ユーザー確認「絞り込みトグルを付ける」。
			// チームにレギュレーションが指定されていて、かつトグルがONのときだけ、
			// 「そのレギュレーションで使える個体」(= 一致 or 個体側が未指定)に絞る。
			let regulationFilterOn = true;

			function currentTeamRegulation(): string | null {
				const value = regulationSelect.value.trim();
				return value === "" ? null : value;
			}

			function matchesTeamRegulation(p: OwnedPokemonRecord): boolean {
				const teamRegulation = currentTeamRegulation();
				if (teamRegulation === null || !regulationFilterOn) return true;
				return !p.regulation || p.regulation === teamRegulation;
			}

			// チーム側が未指定のときは絞る基準が無いのでトグル自体を出さない
			// (出しても押した瞬間に何も変わらず、機能していないように見えるため)。
			// ラベルには現在のレギュレーション名を入れて、何で絞っているかを一目で分かるようにする。
			function syncRegulationFilterToggle(): void {
				const teamRegulation = currentTeamRegulation();
				regulationFilterWrap.hidden = teamRegulation === null;
				const label = document.getElementById("regulation-filter-toggle-label");
				if (label) label.textContent = teamRegulation ? `${teamRegulation} の個体のみ` : "レギュレーション一致のみ";
				regulationFilterToggle.dataset.active = String(regulationFilterOn);
				regulationFilterToggle.setAttribute("aria-pressed", String(regulationFilterOn));
			}

			// UI改修依頼(チーム編集中央パネル、2026-08-01)「"レギュレーション"ラベルを削除する。
			// 他のUIと同様にplaceholderの色を薄くする」。LeftPanel.astro(個体編集)の
			// syncRegulationPlaceholderと同じ考え方: <select>には:placeholder-shownが無いため、
			// 値が空のときだけdata-empty="true"を付け外しする(CSSは上のscoped<style>参照)。
			function syncRegulationPlaceholder(): void {
				if (currentTeamRegulation() === null) regulationSelect.dataset.empty = "true";
				else delete regulationSelect.dataset.empty;
			}

			function isCurrentMember(id: string): boolean {
				for (const p of membersBySlot.values()) {
					if (p.id === id) return true;
				}
				return false;
			}

			// UI改修依頼(チーム編集左パネル)「ソート機能を追加する」。box/index.astroのsortPokemon
			// と同じ考え方(選択中の並べ替え基準で毎回ソートし直す)。基準は3つ:
			//   - 登録順(既定): created_at昇順(古い=先に登録した個体を先頭に。box/index.astroの
			//     「最終更新順」は降順=新しい順だったが、「登録順」は文字通り登録した順序を素直に
			//     表す方が自然だと判断し昇順にした)
			//   - 名前順: displayName(ニックネーム優先、無ければ種族名)のja collate
			//   - 種族名順: species_nameのja collate
			function sortPokemon(list: OwnedPokemonRecord[]): OwnedPokemonRecord[] {
				const sort = sortSelect.value;
				return [...list].sort((a, b) => {
					if (sort === "name") {
						return displayName(a).localeCompare(displayName(b), "ja");
					}
					if (sort === "species_name") {
						return a.species_name.localeCompare(b.species_name, "ja");
					}
					return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
				});
			}

			// UI改修依頼(チーム編集左パネル)「個体編集ボタンを削除する」により、旧・編集リンク
			// (<a>「編集」、/box/{id}への遷移)は撤去した。以前はrow全体を1個の<button>にできず、
			// 「プレビュー用のbutton」+「編集リンク」を横に並べた<div>構造にしていたが、編集リンクが
			// 無くなった今もこの<div>ラップ構造自体は変えていない(ドラッグ&ドロップのdraggable属性を
			// row側に持たせる都合上、rowとmainButtonを分けておく設計は引き続き必要なため)。
			// 操作の割り当て:
			//   - 1回クリック(mainButton) : 右パネルにプレビュー表示(チーム編成は変更しない)
			//   - ダブルクリック(mainButton): 空き枠のうち最小番号に追加(旧・単クリックの動作を踏襲)
			//   - ドラッグ&ドロップ(row全体): ドラッグ先の枠(空き/埋まり問わず)に設定
			function buildSelectRow(p: OwnedPokemonRecord): HTMLElement {
				const row = document.createElement("div");
				row.className = "pokemon-select-row";
				row.draggable = true;

				const mainButton = document.createElement("button");
				mainButton.type = "button";
				mainButton.className = "select-row-main";

				const artEl = document.createElement("span");
				artEl.className = "select-row-art";
				const spriteImg = document.createElement("img");
				spriteImg.className = "select-row-sprite-img";
				spriteImg.alt = "";
				spriteImg.style.display = "none";
				const spriteFallback = document.createElement("span");
				spriteFallback.className = "select-row-sprite-fallback";
				artEl.append(spriteImg, spriteFallback);
				void applySprite(spriteImg, spriteFallback, p.species_name);

				const bodyEl = document.createElement("span");
				bodyEl.className = "select-row-body";
				const name = displayName(p);
				const nameEl = document.createElement("span");
				nameEl.className = "select-row-name";
				nameEl.textContent = name;
				bodyEl.appendChild(nameEl);
				if (p.species_name && p.species_name.trim() !== "" && p.species_name !== name) {
					const speciesEl = document.createElement("span");
					speciesEl.className = "select-row-species";
					speciesEl.textContent = p.species_name;
					bodyEl.appendChild(speciesEl);
				}

				// UI改修依頼(チーム編集左パネル)「特性/アイテム/ステータスも表示」。
				const metaRow = document.createElement("span");
				metaRow.className = "select-row-meta-row";
				const abilityEl = document.createElement("span");
				abilityEl.className = "select-row-meta-item";
				abilityEl.textContent = p.ability_name?.trim() || "特性未設定";
				metaRow.appendChild(abilityEl);
				const itemName = p.item_name?.trim() ?? "";
				if (itemName) {
					const itemEl = document.createElement("span");
					itemEl.className = "select-row-meta-item";
					const itemImg = document.createElement("img");
					itemImg.className = "select-row-meta-icon";
					itemImg.alt = "";
					itemImg.style.display = "none";
					void applyItemIcon(itemImg, itemName);
					const itemLabel = document.createElement("span");
					itemLabel.textContent = itemName;
					itemEl.append(itemImg, itemLabel);
					metaRow.appendChild(itemEl);
				}
				bodyEl.appendChild(metaRow);

				const statRow = document.createElement("span");
				statRow.className = "select-row-stat-row";
				void computeStats(p).then((stats) => {
					if (!stats) return;
					statRow.innerHTML = "";
					for (const s of stats) {
						const chip = document.createElement("span");
						chip.className = "select-row-stat-chip";
						if (s.mod) chip.dataset.mod = s.mod;
						chip.textContent = `${s.label}${s.value}`;
						statRow.appendChild(chip);
					}
				});
				bodyEl.appendChild(statRow);

				const reason = selectionBlockReason(candidateOf(p), currentCandidates());
				if (reason) {
					mainButton.disabled = true;
					const reasonEl = document.createElement("span");
					reasonEl.className = "select-row-reason";
					// A-3(a): 「編成済み」(already-in-team、正常)と禁止3種を色で書き分けるため、
					// data-reasonをCSSセレクタのフックにする(is:globalスタイル側で参照)。
					reasonEl.dataset.reason = reason;
					reasonEl.textContent = BLOCK_REASON_LABELS[reason];
					bodyEl.appendChild(reasonEl);
					mainButton.setAttribute("aria-label", `${name}(${BLOCK_REASON_LABELS[reason]}、選択できません)の詳細を見る`);
				} else {
					mainButton.setAttribute("aria-label", `${name}の詳細を見る(ダブルクリックで空き枠に追加)`);
					mainButton.addEventListener("dblclick", () => {
						assignToSlot(p);
					});
				}
				mainButton.addEventListener("click", () => {
					void renderPreviewPanel(p);
				});

				mainButton.append(artEl, bodyEl);
				row.appendChild(mainButton);

				row.addEventListener("dragstart", () => {
					draggedPokemonId = p.id;
					row.classList.add("is-dragging");
				});
				row.addEventListener("dragend", () => {
					draggedPokemonId = null;
					row.classList.remove("is-dragging");
				});

				return row;
			}

			function renderSelectList(): void {
				if (allPokemon.length === 0) {
					selectListRoot.innerHTML = "";
					selectEmptyState.hidden = false;
					selectNoMatchState.hidden = true;
					return;
				}
				selectEmptyState.hidden = true;

				const term = searchInput.value.trim();
				// UI改修依頼(チーム編集左パネル)「チームに含まれる個体を一覧から非表示にする」
				// 「ソート機能を追加する」。isCurrentMemberで除外してからsortPokemonで並べ替える
				// (除外により、既存の選択ルール由来の"already-in-team"理由は表示上到達しなくなる。
				// selectionBlockReason自体・BLOCK_REASON_LABELSは他の禁止理由(6体編成済み/種族重複/
				// 持ち物重複)で引き続き使うため残す)。
				const filtered = sortPokemon(
					allPokemon.filter((p) => !isCurrentMember(p.id) && matchesTeamRegulation(p) && matchesSearch(p, term)),
				);
				selectListRoot.innerHTML = "";
				if (filtered.length === 0) {
					selectNoMatchState.hidden = false;
					return;
				}
				selectNoMatchState.hidden = true;
				for (const p of filtered) {
					selectListRoot.appendChild(buildSelectRow(p));
				}
			}

			// --- 自動保存(box/[id].astroと同じデバウンス方式。保存ボタンは作らない) ---
			function buildPayload(): {
				name: string | null;
				memo: string | null;
				regulation: string | null;
				members: { slot: number; owned_pokemon_id: string }[];
			} {
				const members = Array.from(membersBySlot.entries())
					.sort((a, b) => a[0] - b[0])
					.map(([slot, p]) => ({ slot, owned_pokemon_id: p.id }));
				const name = nameInput.value.trim();
				const memo = memoInput.value.trim();
				return {
					name: name === "" ? null : name,
					memo: memo === "" ? null : memo,
					// PUT /api/teams/:id は全項目上書きの契約(team-validation.tsの
					// REPLACE_REQUIRED_FIELDS)なので、未指定でもキー自体は必ず送る。
					regulation: currentTeamRegulation(),
					members,
				};
			}

			const DEBOUNCE_MS = 700;
			let debounceTimer: ReturnType<typeof setTimeout> | undefined;
			let saving = false;
			let pendingRetry = false;

			async function saveNow(): Promise<void> {
				if (saving) {
					pendingRetry = true;
					return;
				}
				const payload = buildPayload();
				saving = true;
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "保存中...";
				retryButton.classList.remove("visible");

				try {
					const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					if (!res.ok) {
						const body = (await res.json().catch(() => ({}))) as { error?: string };
						throw new Error(body.error ?? `保存に失敗しました (status=${res.status})`);
					}
					statusEl.dataset.state = "saved";
					statusTextEl.textContent = "保存済み";
				} catch (err) {
					console.error(err);
					statusEl.dataset.state = "error";
					statusTextEl.textContent = err instanceof Error ? err.message : "保存に失敗しました。";
					retryButton.classList.add("visible");
				} finally {
					saving = false;
					if (pendingRetry) {
						pendingRetry = false;
						void saveNow();
					}
				}
			}

			function scheduleSave(): void {
				statusEl.dataset.state = "saving";
				statusTextEl.textContent = "編集中...";
				retryButton.classList.remove("visible");
				if (debounceTimer) clearTimeout(debounceTimer);
				debounceTimer = setTimeout(() => {
					void saveNow();
				}, DEBOUNCE_MS);
			}

			retryButton.addEventListener("click", () => {
				void saveNow();
			});

			// UI改修依頼(チーム編集ヘッダー)「右端に削除ボタン追加」。box/[id].astroの
			// deleteButtonハンドラと同じ確認ダイアログ→DELETE→遷移のパターン。
			deleteTeamButton.addEventListener("click", () => {
				void (async () => {
					if (!window.confirm("このチームを削除します。よろしいですか?")) return;
					deleteTeamButton.disabled = true;
					try {
						const res = await fetch(`/api/teams/${encodeURIComponent(teamId)}`, {
							method: "DELETE",
							credentials: "same-origin",
						});
						if (!res.ok) throw new Error(`削除に失敗しました (status=${res.status})`);
						window.location.href = "/team";
					} catch (err) {
						console.error(err);
						window.alert("削除に失敗しました。時間をおいて再度お試しください。");
						deleteTeamButton.disabled = false;
					}
				})();
			});

			// A-2(実バグ): トップバーはSSR時点のpageTitleで固定され、#team-nameのinputイベントで
			// 追随する処理が存在しなかった(トップバーへの参照が本ファイルに0件だった)。
			// box/[id].astroのupdateHeaderIdentity()(:4239-4257)と同じ手法を移植する:
			// AppLayout.astroは編集禁止(全ページ共通)なので、トップバー側の要素はclass経由で
			// このページのscriptから直接更新する。
			const topbarTitleEl = document.querySelector<HTMLElement>(".app-topbar-title");
			function updateHeaderIdentity(): void {
				const name = nameInput.value.trim();
				if (topbarTitleEl) {
					topbarTitleEl.textContent = name || "無題のチーム";
				}
			}

			nameInput.addEventListener("input", () => {
				updateHeaderIdentity();
				scheduleSave();
			});
			memoInput.addEventListener("input", scheduleSave);
			searchInput.addEventListener("input", renderSelectList);
			sortSelect.addEventListener("change", renderSelectList);

			// 🔴 UI改修依頼(チーム編集画面、2026-08-01)。レギュレーションを変えると
			// 「選択バーに出す個体」も変わるため、保存と同時に一覧を描き直す。
			regulationSelect.addEventListener("change", () => {
				syncRegulationFilterToggle();
				syncRegulationPlaceholder();
				renderSelectList();
				scheduleSave();
			});
			regulationFilterToggle.addEventListener("click", () => {
				regulationFilterOn = !regulationFilterOn;
				syncRegulationFilterToggle();
				renderSelectList();
			});
			// 初期表示(SSRで選択済みのレギュレーション)にもトグルの状態を合わせる。
			syncRegulationFilterToggle();
			syncRegulationPlaceholder();

			// UI改修依頼(チーム編集ヘッダー)「匿名でデータ提供するトグル」。個体編集画面
			// (src/lib/box-id/left-panel.ts)と同じPATCH経路を、現在のチームメンバー全員に対して
			// 一括で呼ぶ(既存の1個体用APIをそのまま流用。新しいAPI・DB列は追加していない)。
			// 失敗時はcheckedを元に戻しエラーメッセージを表示する(個体編集画面と同じ温度感)。
			// 🔴 2026-08-01「非公開」トグルへの改称により、checkedの意味が反転している
			// (checked=true が「非公開」=collection_opt_out=true)。保存するペイロード自体
			// (collection_opt_out の真偽値)は変えていない ── nextProviding は反転後のcheckedから
			// 「提供中かどうか」を計算し直しているだけで、PATCHボディの式(!nextProviding)は
			// 変更前と同一。
			collectionOptOutToggle.addEventListener("change", () => {
				void (async () => {
					// checked_after(クリック直後の値)は「非公開かどうか」を表す。
					// nextProviding は「提供中かどうか」(旧来の意味のまま)に変換する。
					const nextProviding = !collectionOptOutToggle.checked;
					syncCollectionOptOutTitle();
					const ids = currentMemberIds();
					collectionOptOutToggle.disabled = true;
					try {
						const results = await Promise.all(
							ids.map((id) =>
								fetch(`/api/owned-pokemon/${encodeURIComponent(id)}`, {
									method: "PATCH",
									credentials: "same-origin",
									headers: { "Content-Type": "application/json" },
									body: JSON.stringify({ collection_opt_out: !nextProviding }),
								}),
							),
						);
						if (results.some((res) => !res.ok)) throw new Error("更新に失敗しました");
						collectionOptOutStatusEl.hidden = true;
						delete collectionOptOutStatusEl.dataset.state;
					} catch (err) {
						console.error(err);
						// クリック前の状態(checked)= nextProviding(「非公開」= !提供中 = nextProviding)。
						collectionOptOutToggle.checked = nextProviding;
						syncCollectionOptOutTitle();
						collectionOptOutStatusEl.textContent = "更新に失敗しました";
						collectionOptOutStatusEl.hidden = false;
						collectionOptOutStatusEl.dataset.state = "error";
					} finally {
						collectionOptOutToggle.disabled = currentMemberIds().length === 0;
						syncCollectionOptOutTitle();
					}
				})();
			});

			// --- 初期化 ---
			// SSR取得済みのメンバーは fetch を待たずに即描画する(6枠が空でも一瞬も待たせない)。
			renderSlots();
			refreshCollectionOptOutToggle();

			fetch("/api/owned-pokemon", { credentials: "same-origin" })
				.then(async (res) => {
					if (!res.ok) throw new Error(`個体一覧の取得に失敗しました (status=${res.status})`);
					const body = (await res.json()) as { data: OwnedPokemonRecord[] };
					allPokemon = body.data;
					// SSR由来のmembersBySlotの値はcollection_opt_out_until等、GET専用の列を
					// 持たないため、fetch完了後にallPokemonの同IDレコードへ差し替えて以後の計算
					// (匿名トグルの状態など)を正確にする(表示中の6枠の見た目は変わらない列のみ
					// なので再描画は不要)。
					for (const [slot, p] of membersBySlot.entries()) {
						const fresh = allPokemon.find((x) => x.id === p.id);
						if (fresh) membersBySlot.set(slot, fresh);
					}
					selectLoadingMessage.hidden = true;
					renderSelectList();
					refreshCollectionOptOutToggle();
				})
				.catch((err) => {
					console.error(err);
					selectLoadingMessage.hidden = true;
					selectErrorMessage.hidden = false;
				});
		}
	</script>
</AppLayout>
