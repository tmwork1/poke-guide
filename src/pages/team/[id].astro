			border-radius: var(--radius-md);
		}
		.team-slots .slot-meta-icon {
			width: 16px;
			height: 16px;
			object-fit: contain;
		}
		/* UI改修依頼(チーム編集中央パネル、2026-08-02)「特性とアイテムを同じ段に配置する
		   (ボックス画面と同様)」。box/index.astroの.card-item-row(grid 2列)/
		   .card-item-row-cell(flex中央寄せ)と同じ作りに揃える(値そのものは変えない)。 */
		.team-slots .slot-meta-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			width: 100%;
			column-gap: var(--space-2);
