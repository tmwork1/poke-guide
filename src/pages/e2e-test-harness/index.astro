---
// E2E回帰テスト専用の最小ハーネスページ。
//
// **これはPlaywrightのE2Eテスト (tests/e2e/damage-calc.spec.ts,
// tests/e2e/stats-lethal-sequence.spec.ts) からのみ使う、テスト専用ページです。**
// 本番導線には一切リンクされない。
//
// damage-calc-poc (動作確認ページ) はDOM入力フォーム経由でしか
// 計算を実行できず、努力値・特性・持ち物・フィールド状態などを網羅的に
// スクリプトから叩けない。このページは `src/lib/pyodide-engine.ts` の
// `initEngine()` / `calcDamages()` / `calcStats()` / `calcLethalSequence()` を
// そのまま `window` に晒すだけの薄いラッパーで、Playwright は `page.evaluate()` で
// 直接これらの関数を呼び出し、任意の PokemonSpec / FieldSpec / CalcDamagesOptions /
// SequenceAttack を渡してブラウザ内Pyodide経由の計算結果を取得する。
//
// `calcStats`/`calcLethalSequence` も、`/box/[id].astro` が実際に使う関数として
// ネイティブjpoke実行との一致確認の対象にするため、`calc` と同様にここで公開する
// (`.claude/skills/jpoke/references/integration.md` §6 参照)。
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="E2Eテストハーネス (非公開・テスト専用)" current="dev">
	<div class="page">
		<h1 class="page-title">E2Eテストハーネス</h1>
		<p>
			このページはPlaywright E2Eテスト (Phase 2-5) 専用です。UIはありません。
			<code>window.__pyodideEngine__</code> 経由で <code>src/lib/pyodide-engine.ts</code> の
			API を直接呼び出せます。
		</p>
		<p id="harness-ready" data-ready="false">initializing</p>

		<script>
			import {
				initEngine,
				calcDamages,
				calcStats,
				calcLethalSequence,
				isEngineReady,
				getEngineProgress,
			} from "../../lib/pyodide-engine";
			import type {
				PokemonSpec,
				CalcDamagesOptions,
				CalcDamagesResult,
				Stats,
				SequenceAttack,
				CalcLethalSequenceResult,
			} from "../../lib/pyodide-engine";

			// Playwrightからテスト対象APIを直接呼び出せるよう window に公開する。
			// テスト専用のグローバル変数であり、本番ページ (damage-calc-poc / damage-calc) には
			// 一切登録しない。
			declare global {
				interface Window {
					__pyodideEngine__: {
						init: () => Promise<{ status: string; message: string }>;
						calc: (
							attacker: PokemonSpec,
							defender: PokemonSpec,
							moveName: string,
							options?: CalcDamagesOptions,
						) => Promise<CalcDamagesResult>;
						// /box/[id].astro が実際に使う calcStats()/calcLethalSequence() も
						// ネイティブjpoke実行との一致確認の対象にするため公開する。
						calcStats: (spec: PokemonSpec) => Promise<{ stats: Stats }>;
						calcLethalSequence: (
							attacker: PokemonSpec,
							defender: PokemonSpec,
							attacks: SequenceAttack[],
							options?: CalcDamagesOptions,
						) => Promise<CalcLethalSequenceResult>;
						isReady: () => boolean;
					};
				}
			}

			window.__pyodideEngine__ = {
				init: () =>
					new Promise((resolve, reject) => {
						initEngine((progress) => {
							if (progress.status === "ready") {
								resolve({ status: progress.status, message: progress.message });
							} else if (progress.status === "error") {
								reject(new Error(progress.message));
							}
						}).catch(reject);
					}),
				calc: (attacker, defender, moveName, options) =>
					calcDamages(attacker, defender, moveName, options ?? {}),
				calcStats: (spec) => calcStats(spec),
				calcLethalSequence: (attacker, defender, attacks, options) =>
					calcLethalSequence(attacker, defender, attacks, options ?? {}),
				isReady: () => isEngineReady(),
			};

			const readyEl = document.getElementById("harness-ready") as HTMLElement;
			readyEl.dataset.ready = "true";
			readyEl.textContent = "harness ready: " + JSON.stringify(getEngineProgress());
		</script>
	</div>
</AppLayout>
