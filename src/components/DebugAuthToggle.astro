---
interface Props {
  currentUser: boolean;
}

const { currentUser } = Astro.props;
---

<label class="debug-auth-toggle" aria-label="開発用ゲストモード切り替え">
  <input id="debug-auth-toggle-input" type="checkbox" checked={!currentUser} />
  <span class="debug-auth-toggle__track" aria-hidden="true">
    <span class="debug-auth-toggle__thumb"></span>
  </span>
  <span class="debug-auth-toggle__state">ゲストモード</span>
</label>

<script>
  // `npm run dev` はセッションを見ずに常にダミーのログイン済みユーザーを返す
  // (src/lib/user-session.ts の DEV_SESSION_USER)。そのため /api/auth/login・
  // /api/auth/logout を実際に呼んでも次のリクエストで即座に上書きされてしまい、
  // このトグルの見た目が常にONへ戻る不具合が実測で確認された。
  // 代わりに同ファイルが読む dev 専用cookieを直接書き換えて表示を切り替える。
  const COOKIE_NAME = 'poke-dev-force-guest';
  const toggle = document.getElementById('debug-auth-toggle-input') as HTMLInputElement | null;
  toggle?.addEventListener('change', () => {
    document.cookie = toggle.checked
      ? `${COOKIE_NAME}=1; path=/`
      : `${COOKIE_NAME}=; path=/; max-age=0`;
    window.location.reload();
  });
</script>

<style>
  .debug-auth-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem auto 0;
    width: fit-content;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .debug-auth-toggle input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }
  .debug-auth-toggle__track {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    inline-size: 2.2rem;
    block-size: 1.2rem;
    padding: 0.12rem;
    background: #9ca3af;
    border-radius: 999px;
    transition: background-color 160ms ease;
  }
  .debug-auth-toggle__thumb {
    inline-size: 0.96rem;
    block-size: 0.96rem;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 160ms ease;
  }
  .debug-auth-toggle input:checked + .debug-auth-toggle__track { background: #dc2626; }
  .debug-auth-toggle input:checked + .debug-auth-toggle__track .debug-auth-toggle__thumb { transform: translateX(1rem); }
  .debug-auth-toggle input:focus-visible + .debug-auth-toggle__track { outline: 2px solid #991b1b; outline-offset: 2px; }
</style>
