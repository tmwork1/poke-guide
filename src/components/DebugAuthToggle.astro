---
interface Props {
  currentUser: boolean;
}

const { currentUser } = Astro.props;
import '../styles/debug-auth-toggle.css';
---

<label class="debug-auth-toggle" aria-label="開発用匿名ユーザー切り替え">
  <input id="debug-auth-toggle-input" type="checkbox" checked={!currentUser} />
  <span class="debug-auth-toggle__track" aria-hidden="true">
    <span class="debug-auth-toggle__thumb"></span>
  </span>
  <span class="debug-auth-toggle__state">匿名ユーザー</span>
</label>

<script>
  // `npm run dev` は固定の通常ユーザーを返す。ONでは固定の匿名ユーザーへ切り替え、
  // `signInAnonymously()` を使わずに匿名画面と初期データを確認できる。
  const COOKIE_NAME = 'poke-dev-force-guest';
  const toggle = document.getElementById('debug-auth-toggle-input') as HTMLInputElement | null;
  toggle?.addEventListener('change', () => {
    document.cookie = toggle.checked
      ? `${COOKIE_NAME}=1; path=/`
      : `${COOKIE_NAME}=; path=/; max-age=0`;
    window.location.reload();
  });
</script>
