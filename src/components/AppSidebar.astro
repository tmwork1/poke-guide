---
// 全ページ共通のサイドバー(UI刷新、2026-07-25)。docs/ui_proposal/Box.png 等のワイヤーフレームに準拠する。
// アイコンは外部ライブラリを使わず、lucide風の線画をインラインSVGとして自前定義する。
interface Props {
	current?: "box" | "team" | "dev" | "speed-chart";
	/**
	 * 2026-07-27 ラウンド20 20-H2: ログイン情報をサイドバー最下段に表示するため、
	 * AppLayout.astro が Astro.locals.user から読んだ値をそのまま受け取る。
	 * AppSidebar は chrome="public"(/share 等)では描画されないため、ここに渡らない
	 * = 未ログインの第三者にログイン情報が漏れることはない。
	 */
	user?: { email?: string | null; displayName?: string | null; id?: string } | null;
}

const { current, user } = Astro.props;

const ICONS = {
	// ボックス(/box)用: 2パーツ構成のモンスターボール(塗りつぶしシルエット、strokeなし)。
	// 上ドーム片(下端中央に半円の切り欠き)と下ボウル片(上端中央に半円の切り欠き)を
	// 隙間を空けて上下に配置し、間の帯と2つの切り欠きが向き合ってできる中央の丸い穴は
	// あえて塗らない透明部分のままにする(SVGに背景矩形が無いのでページ背景が自然に透ける)。
	home: `<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.75 A9 9 0 0 1 21 10.75 L14.8 10.75 A2.8 2.8 0 0 0 9.2 10.75 L3 10.75 Z" fill="currentColor"/><path d="M21 13.25 A9 9 0 0 1 3 13.25 L9.2 13.25 A2.8 2.8 0 0 0 14.8 13.25 L21 13.25 Z" fill="currentColor"/></svg>`,
	// チーム(/team)用: 同じ2パーツ構成のボールを2つ、左右にずらして重ねて配置。
	// 背後のボール(右上寄り)を先に描画し、前面のボール(左下寄り)を後で描画することで自然な重なりにする。
	// 前面ボール中央の透明な穴から背面ボールが覗いて見えるのは許容(奥行きが出る)。
	users: `<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7.15 A6 6 0 0 1 20 7.15 L15.9 7.15 A1.9 1.9 0 0 0 12.1 7.15 L8 7.15 Z" fill="currentColor"/><path d="M20 8.85 A6 6 0 0 1 8 8.85 L12.1 8.85 A1.9 1.9 0 0 0 15.9 8.85 L20 8.85 Z" fill="currentColor"/><path d="M3.5 13.1 A6.5 6.5 0 0 1 16.5 13.1 L12 13.1 A2 2 0 0 0 8 13.1 L3.5 13.1 Z" fill="currentColor"/><path d="M16.5 14.9 A6.5 6.5 0 0 1 3.5 14.9 L8 14.9 A2 2 0 0 0 12 14.9 L16.5 14.9 Z" fill="currentColor"/></svg>`,
	"trending-up": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
	// 開発者向け(/e2e-test-harness)用: レンチの塗りつぶしシルエット(Material Iconsの"build"相当のパス)。
	// 元のpathはviewBox 24x24のほぼ端から端(bbox約22x22)を占め、他の線画4アイコン(概ね20x20に
	// 収まる余白設計)より一回り大きく見えていたため、2026-08-02に transform で0.9077倍に縮小し
	// 中央寄せした(縮小後のbboxはx:2.0-22.0, y:2.06-21.94 ≒ 20x20相当)。
	code: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" transform="translate(1.133 1.062) scale(0.9077)"/></svg>`,
	// すばやさ早見表(/speed-chart)用: スピードメーター(lucideの"gauge"アイコンのパスをそのまま使用)。
	zap: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>`,
} as const;

type IconKey = keyof typeof ICONS;

interface SidebarItem {
	key: string;
	label: string;
	icon: IconKey;
	href?: string;
	disabled?: boolean;
}

const SECTIONS: { heading: string; items: SidebarItem[] }[] = [
	{
		heading: "育成",
		items: [
			{ key: "box", label: "ボックス", href: "/box", icon: "home" },
			{ key: "team", label: "チーム", href: "/team", icon: "users" },
			{ key: "speed-chart", label: "すばやさ早見表", href: "/speed-chart", icon: "zap" },
			{ key: "trend", label: "トレンド", icon: "trending-up", disabled: true },
		],
	},
	{
		heading: "その他",
		items: [
			{ key: "dev", label: "開発者向け", href: "/e2e-test-harness", icon: "code" },
		],
	},
];
---

<aside class="app-sidebar" id="app-sidebar">
	<a class="app-sidebar-brand" href="/box">Poke-Commons</a>
	<nav class="app-sidebar-nav" aria-label="サイドナビゲーション">
		{SECTIONS.map((section) => (
			<div class="app-sidebar-section">
				<p class="app-sidebar-heading">{section.heading}</p>
				<ul class="app-sidebar-list">
					{section.items.map((item) => {
						const isActive = !item.disabled && current === item.key;
						return (
							<li>
								{item.disabled ? (
									<span class="app-sidebar-link app-sidebar-link-disabled" aria-disabled="true">
										<span class="app-sidebar-icon" set:html={ICONS[item.icon]} />
										<span class="app-sidebar-label">{item.label}</span>
										<span class="badge badge-muted app-sidebar-badge">準備中</span>
									</span>
								) : (
									<a
										class="app-sidebar-link"
										href={item.href}
										data-active={isActive ? "true" : "false"}
										aria-current={isActive ? "page" : undefined}
									>
										<span class="app-sidebar-icon" set:html={ICONS[item.icon]} />
										<span class="app-sidebar-label">{item.label}</span>
									</a>
								)}
							</li>
						);
					})}
				</ul>
			</div>
		))}
	</nav>
	<div class="app-sidebar-account">
		{
			user ? (
				<Fragment>
					{/* UI改善ラウンド33 33-G1(ユーザー判断待ちキューの回答「接頭辞を削除」): 可視テキストからは
					    「ログイン中: 」を削除しメールアドレスのみ表示する(移設先がログアウトボタンの真上のため
					    文脈で伝わる、というユーザーの判断)。読み上げでは引き続き「ログイン中のアカウントである」
					    ことが伝わるよう、aria-labelに接頭辞付きの文言を残す(28-R9と同じ「視覚的に消しても
					    読み上げ情報は落とさない」方針)。クラス名 app-sidebar-account-email は改名しない
					    (global.cssのモバイル二重表示打ち消しが依存している)。 */}
					<span class="app-sidebar-account-email" aria-label={`ログイン中: ${user.email ?? user.displayName ?? user.id}`}>{user.email ?? user.displayName ?? user.id}</span>
					<form method="POST" action="/api/auth/logout">
						<button type="submit" class="btn-ghost">ログアウト</button>
					</form>
				</Fragment>
			) : (
				<a class="btn-primary" href="/api/auth/login">ログイン</a>
			)
		}
	</div>
</aside>

<style>
	/* サイドバーの固定位置・開閉(transform)は global.css の .app-sidebar 側で定義する。
	   ここではサイドバー内部の見た目(余白・タイポグラフィ・アクティブ表示)のみを扱う。 */
	.app-sidebar-brand {
		display: block;
		padding: var(--space-5) var(--space-5) var(--space-4);
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.app-sidebar-brand:hover {
		color: var(--color-primary);
	}

	.app-sidebar-nav {
		padding: var(--space-1) 0 var(--space-6);
	}

	.app-sidebar-section + .app-sidebar-section {
		margin-top: var(--space-5);
	}

	.app-sidebar-heading {
		margin: 0 0 var(--space-2);
		padding: 0 var(--space-5);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	.app-sidebar-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.app-sidebar-link {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0.15rem var(--space-3);
		padding: var(--space-3) var(--space-3);
		border-radius: var(--radius-md);
		font-size: var(--font-size-md);
		font-weight: 500;
		color: var(--color-text);
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
	}

	a.app-sidebar-link:hover {
		background: var(--color-surface-alt);
	}

	/* アクティブ項目: primary-soft背景+primary文字色に加え、サイドバー左端に4pxの
	   インジケータを出す(margin分だけ左にはみ出させ、サイドバー本体の縁に接触させる)。 */
	.app-sidebar-link[data-active="true"] {
		background: var(--color-primary-soft);
		color: var(--color-primary);
		font-weight: 700;
	}

	.app-sidebar-link[data-active="true"]::before {
		content: "";
		position: absolute;
		left: calc(var(--space-3) * -1);
		top: var(--space-2);
		bottom: var(--space-2);
		width: 4px;
		border-radius: 0 4px 4px 0;
		background: var(--color-primary);
	}

	.app-sidebar-link-disabled {
		color: var(--color-text-muted);
		cursor: default;
	}

	.app-sidebar-icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.app-sidebar-label {
		flex: 1;
	}

	.app-sidebar-badge {
		/* 2026-07-27 ラウンド20 20-G3: 0.65rem(10.4px)は下限12pxを割っていた。
		   --font-size-xs(0.75rem=12px)に是正する。 */
		font-size: var(--font-size-xs);
		padding: 0.15em 0.55em;
		flex-shrink: 0;
	}

	/* 2026-07-27 ラウンド20 20-H2: ログイン情報をサイドバー最下段に固定表示する。
	   global.css 側で .app-sidebar を display:flex; flex-direction:column にしてあるので、
	   margin-top: auto でこのブロックだけ下端に押し出す。 */
	.app-sidebar-account {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5);
		border-top: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
	}

	.app-sidebar-account-email {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
