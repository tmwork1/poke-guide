---
interface Props { class?: string; width?: number | string; height?: number | string; }
const { class: className, width, height } = Astro.props;
---
<svg class={className} width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
  <rect x="4" y="3" width="16" height="18" rx="2.5" />
  <rect x="7" y="6.25" width="10" height="2.5" rx=".75" fill="currentColor" stroke="none" />
  <g fill="currentColor" stroke="none"><circle cx="8.5" cy="13" r="1.25"/><circle cx="12" cy="13" r="1.25"/><circle cx="15.5" cy="13" r="1.25"/><circle cx="8.5" cy="17" r="1.25"/><circle cx="12" cy="17" r="1.25"/><circle cx="15.5" cy="17" r="1.25"/></g>
</svg>
