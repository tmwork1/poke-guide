---
import '../../styles/species-select-dialog.css';
---

<div id="species-select-backdrop" class="species-select-backdrop" hidden></div>
<div
	id="species-select-dialog"
	class="species-select-dialog"
	role="dialog"
	aria-modal="true"
	aria-labelledby="species-select-dialog-title"
	tabindex="-1"
	hidden
>
	<div class="species-select-header">
		<h2 id="species-select-dialog-title" class="species-select-title">ポケモン選択</h2>
		<div class="species-select-sort-wrap">
			<button type="button" id="species-select-sort-button" class="species-select-sort-button" aria-haspopup="true" aria-expanded="false">⇅</button>
			<div id="species-select-sort-panel" class="species-select-sort-panel" hidden>
				<button type="button" class="species-select-sort-option" data-sort="popularity">人気順</button>
				<button type="button" class="species-select-sort-option" data-sort="dex">図鑑番号順</button>
				<button type="button" class="species-select-sort-option" data-sort="kana">50音順</button>
			</div>
		</div>
		<button type="button" id="species-select-close-button" class="btn-ghost species-select-close" aria-label="閉じる">×</button>
	</div>
	<div class="species-select-grid-wrap">
		<div id="species-select-grid" class="species-select-grid" role="listbox" aria-label="ポケモンを選択"></div>
		<p id="species-select-empty" class="species-select-empty" hidden>条件に一致するポケモンがいません</p>
	</div>
	<div class="species-select-filters">
		<input type="text" id="species-select-search-input" class="species-select-search-input" placeholder="種族名・特性・覚える技で検索" aria-label="種族名・特性・覚える技で検索" autocomplete="off" />
	</div>
	<div id="species-select-type-row" class="species-select-type-row" role="group" aria-label="タイプで絞り込み"></div>
</div>

<script>
	import '../../lib/box-id/species-select-dialog';
</script>
