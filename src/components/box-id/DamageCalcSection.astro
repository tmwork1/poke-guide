	}
	@media (prefers-reduced-motion: reduce) {
		#opponent-notes-section .damage-row-collapse-toggle-button { transition: none; }
	}

	/* 36-1: 折りたたみ時に代わりに出す「相手ポケモン名(読み取り専用)+攻守の向き」の
