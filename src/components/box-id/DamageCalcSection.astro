	#opponent-notes-section .add-card-tile {
		min-height: 0;
		padding: 0.6em 1em;
		font-size: 0.9rem;
	}

	/* ラウンド3 B-5: 以前は点線パネル2枚(説明文+追加タイル)が重なり、主CTAが下の小さい
	   ほうに埋もれていた上、説明文3行の最終行が「できます。」1語だけで間延びしていた。
	   1枚に統合し、実体のあるprimaryボタン(.damage-empty-state-cta)を中央に置く。
	   max-width:720pxにして1900px幅いっぱいの空パネルにしない(左寄せ)。 */
	#opponent-notes-section .damage-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		max-width: 720px;
		padding: 2.2rem 1.5rem;
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface-alt);
		margin-bottom: 0.6rem;
	}
	#opponent-notes-section .damage-empty-state-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-text);
	}
	#opponent-notes-section .damage-empty-state-hint {
		margin: 0 0 0.3rem;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		max-width: 34em;
	}
	#opponent-notes-section .damage-empty-state-cta {
		font-size: 0.95rem;
	}

	/* ラウンド6ユーザー指示: モバイル対応はこのラウンドのスコープ外(デスクトップ1920px基準)。
	   以前あった「640px以下では.damage-columnを180px固定幅にする」ルールは、技列を
	   横スクロールで並べていた時代の詰め対応であり、縦積み+width:100%の現行レイアウトとは
	   噛み合わない(固定180pxが右カラムの実幅より狭くなり不自然)ため削除した。 */

	/* UI品質改善(ラウンド8 A-6ダーク側): ダークで --color-border #2d313d が
	   .card(--color-surface-alt #22252f)に対し1.18:1しか無く、相手ビルド箱・技列箱の
	   輪郭がほぼ見えなかった(カード全体が1枚の黒い塊に見え、「2つの箱が並んでいる」構造が
	   伝わらない。ライトは白背景+影で分離が読めるが、ダークは影が効かない)。
	   新色は作らず既存中立色の明度違いをページscopedで使う(--color-border自体は変えない。
	   全ページの罫線が太く見えてしまうため)。#5a6377はカード背景に対し2.73:1。
	   is:globalブロックに置く理由: .damage-row-build/.damage-columnはJSの
	   document.createElement()で生成される要素なので、scoped<style>側に書いても
	   data-astro-cid-*が付かず一切効かない(pitfalls.mdの既知の罠と同じ)。 */
	@media (prefers-color-scheme: dark) {
		#opponent-notes-section .damage-row-build,
		#opponent-notes-section .damage-column {
			border-color: #5a6377;
		}
	}

	/* ==========================================================================
	   UI改善ラウンド36ユーザー指示(第18弾・機能追加)「ダメージカードの折りたたみ機能」。
	   既存のラウンド3〜35のルールは並べ替えず、このセクション末尾に新規ルールとして
	   追記する(このファイル冒頭コメントの「適用順序に依存するルールが複数あるため
	   分割・並べ替えはしない」という既存方針を踏襲。新規ルールはdata-collapsed属性を
	   含む詳細度の高いセレクタで書くため、追記位置による優先順位の影響は受けない)。
	   ========================================================================== */

	/* 36-3で新設した「すべて折りたたむ・展開する」ツールバー(#damage-rows-toolbar、2ボタン版・
	   このセクション直上の薄い行)は、🔴 UI改善ラウンド38ユーザー指示(38-H1)によりページ共通
	   ヘッダー(トップバー)の単一トグルボタンへ移設した(box/[id].astroの
	   #damage-collapse-toggle-button、下の「38-H1」コメント参照)。マークアップ自体を
	   撤去したため、この#opponent-notes-section .damage-rows-toolbar系のCSSも死んだ
	   セレクタになり削除する(重複UIを残さない、という38-H1の指示どおり)。 */

	/* 36-2: 折りたたみ/展開の切り替えボタン。削除ボタン(.damage-row-delete-button、
	   上でtop基準に戻した)が退いた右下の座席(bottom: var(--space-2); right: var(--space-2);)を
	   引き継ぐ。サイズ・円形28px・shadow-smは既存の.damage-row-icon-button規格を流用する。
	   削除(破壊的操作)ではないため、hoverはdanger色ではなくprimary色にする。
	   🔴 UI改善ラウンド38ユーザー指示(38-D5)「>>を90度回転させたデザインにする。ボタンに
	   枠は表示しない」により、border(1px)を撤去する(.btn-ghost本来のborder-color:transparentに
	   戻る形。global.css編集は不要)。文字自体は<script>のsetCollapsed手前で"»"固定にし、
	   ここでtransformにより90度回転させる(展開中=aria-expanded="true"で反時計回り90度回転
	   =上向き"^^"、折りたたみ中=aria-expanded="false"で時計回り90度回転=下向き"vv"。
	   回転軸は円形ボタンの中心(transform-originの既定=50% 50%)のため位置は動かない)。 */
	#opponent-notes-section .damage-row-collapse-toggle-button {
		position: absolute;
		bottom: var(--space-2);
		right: var(--space-2);
		z-index: 2;
		background: var(--color-surface);
		border: none;
		transition: background 0.15s, color 0.15s, transform 0.15s;
	}
	#opponent-notes-section .damage-row-collapse-toggle-button[aria-expanded="true"] {
		transform: rotate(-90deg);
	}
	#opponent-notes-section .damage-row-collapse-toggle-button[aria-expanded="false"] {
		transform: rotate(90deg);
	}
	#opponent-notes-section .damage-row-collapse-toggle-button:hover:not(:disabled) {
		border-color: var(--color-primary);
		color: var(--color-primary);
		background: var(--color-primary-soft);
	}
	#opponent-notes-section .damage-row-collapse-toggle-button:focus-visible {
		outline: 2px solid var(--color-primary);
