---
import type { OpponentNoteRecord } from '../../lib/opponent-notes';

interface Props {
	pokemonId: string;
	/** JS 無効時にも保存済みカードであることを示すための SSR フォールバック。 */
	initialNotes?: OpponentNoteRecord[];
}

const { pokemonId, initialNotes = [] } = Astro.props;

function stringValue(value: unknown): string {
	return typeof value === 'string' ? value : '';
}

function attackNames(value: unknown): string[] {
	if (!value || typeof value !== 'object') return [];
	const attacks = (value as { attacks?: unknown }).attacks;
	if (!Array.isArray(attacks)) return [];
	return attacks
		.map((attack) => attack && typeof attack === 'object' ? stringValue((attack as { moveName?: unknown }).moveName) : '')
		.filter((name) => name !== '');
}
import '../../styles/box-damage-page.css';
import '../../styles/box-add-button.css';
import '../../styles/box-damage-card.css';
---


<section id="opponent-notes-section" class="damage-calc-area" data-owned-pokemon-id={pokemonId}>



	{/* エンジンの準備中はカードを先に表示し、計算結果だけ後から反映する。
	    状態文が出入りするとカード一覧の開始位置が動くため、失敗時だけ表示する。 */}
	<p id="damage-calc-engine-status" class="status-text damage-calc-engine-status" data-state="idle" hidden>

		<span id="damage-calc-engine-status-text">準備中…</span>

		<button id="damage-calc-engine-reload-button" type="button" class="btn-ghost" hidden>再試行</button>

	</p>

	<div id="damage-rows-list" class="damage-rows-list">
		{initialNotes.map((note) => {
			const opponentName = stringValue(note.opponent_build.name);
			const moves = attackNames(note.field);
			return (
				<article class="card card-damage" data-opponent-note-id={note.id}>
					<h2 class="card-title">{opponentName || '対戦相手'}</h2>
					<p class="card-hint">{moves.length > 0 ? moves.join(' → ') : note.move_name ?? '技未設定'}</p>
				</article>
			);
		})}
	</div>

	{/* 右下固定の追加ボタン。box/index.astroの.floating-list-add-button(常設1つの丸い
	    ボタンをCSSで画面に浮かせ、一覧の登録有無を問わず常時表示する)と同じ考え方だが、
	    見た目・配置トークン(--damage-card-floating-add-right/-bottom、
	    #stat-adjust-sheet展開時のz-index調整)はこのタブ専用に既存のbox-add-button.cssへ
	    集約済みのため、そちらのbox-add-buttonクラスをそのまま再利用する
	    (floating-list-controls.cssは導入しない)。カードが0枚のとき(damage-empty-add-tileと
	    併存)・1枚以上のとき(technique一覧の末尾ではなく常時この1つのボタンだけで運用する)の
	    どちらでも常に表示する。クリック処理はdamage-calc.tsのaddNewRowAndFocus
	    (「カードを追加」処理そのもの)を直接呼ぶ。 */}
	<button type="button" id="damage-floating-add-button" class="add-card-tile box-add-button" aria-label="ダメージ計算を追加">
		<svg class="add-card-tile-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 5v14" />
			<path d="M5 12h14" />
		</svg>
		<span class="add-card-tile-label">ダメージ計算を追加</span>
	</button>

	{/* よく行われるダメージ計算のサジェスト。以前は#damage-detail-panel-body(技の詳細設定
	    モーダル)の「何も選択していない」状態としてだけ表示していたが、開閉しなくても常に
	    見えるほうが便利という要望で、カード一覧の直下に常設表示する形へ変更した。中身は
	    damage-suggest.tsのrenderDamageSuggestSection()がJSで描画する(0件のときはhidden、
	    1件以上あれば表示)。 */}
	<section id="damage-suggest-section" class="damage-suggest-section" hidden>
		<p class="damage-suggest-section-heading">人気の計算</p>
		<ul id="damage-suggest-list" class="damage-suggest-list"></ul>
	</section>

</section>



<script>
	// /box/[id] だけは編集パネルを最初から使うので、静的 import で同じバンドルに入れる
	// (PokemonEditPanel.astro 側の動的 import は同じモジュールを指すので二重評価されず、
	// 取得の往復も増えない)。damage-calc より先に評価してブリッジ登録を済ませる。
	import "../../lib/box-id/pokemon-edit-panel";
	import "../../lib/box-id/damage-calc";

</script>
