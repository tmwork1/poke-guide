---
// box/[id].astro 構造分割ラウンド(フェーズ2)。
//
// ダメージ計算(#opponent-notes-section)専用のテンプレート・<style is:global>ブロックを
// 切り出したコンポーネント。ロジック(スクリプト)は src/lib/box-id/damage-calc.ts へ
// 切り出し済みで、下の<script>から副作用importする(モジュール読み込み時に自身で
// document.getElementById("opponent-notes-section")を取得し初期化する。LeftPanel.astro/
// left-panel.tsと同じ構成)。
//
// <style is:global>ブロック(2,065行)は元のbox/[id].astroにあった内容を、内部の順序を
// 一切変えずにそのままここへ移した(docs/plan/ui_parallelization.md 3節: 適用順序に依存する
// ルールが複数あるため分割・並べ替えはしない、という方針どおり)。is:globalの大半が
// ダメージ計算カード関連のためこのファイルに置いたが、RightPanel.astro(詳細設定サイドバー)が
// 必要とするグローバルスタイル(#damage-detail-panel-body配下の動的生成要素向けルール等)も
// 同じブロック内にあるため、そのまま一緒に持ってきている(RightPanel.astroを分けて
// 呼び出しても、is:globalはページ全体に効くため問題なく届く)。
interface Props {
	pokemonId: string;
}
const { pokemonId } = Astro.props;
---
{/* battle-assistant同様、ダメージ計算カードは「ダメージ計算」パネル(=.cardの枠+見出し)の
    中に入れず、ページ直下にカードを直接並べる(要件)。そのため<section>には.cardを付けず、
    見出し・説明文も置かない(カード自体が何であるかは中身の入力欄とボタンで分かる)。
    id="opponent-notes-section"は<style is:global>のスコープ接頭辞とJSの初期化ガードが
    参照しているため、枠を外しても維持する。 */}
<section id="opponent-notes-section" class="damage-calc-area" data-owned-pokemon-id={pokemonId}>
	{/* ラウンド3 B-12: 読み込みに失敗した場合、以前はpyodide-engine.ts由来の生の
	    メッセージ(CDN URLを含みうる)をそのまま表示していた。テキストをspanに分離し、
	    エラー時だけ<script>側で内部URLを含まない文言に差し替えたうえで再読み込み
	    ボタンを出す(テキストをtextContentで丸ごと差し替えるとボタンごと消えるため分離した)。 */}
	<p id="damage-calc-engine-status" class="status-text damage-calc-engine-status" data-state="idle">
		<span id="damage-calc-engine-status-text">計算エンジンを準備しています(自動で開始します)...</span>
		<button id="damage-calc-engine-reload-button" type="button" class="btn-ghost" hidden>再読み込み</button>
	</p>
	{/* UI改善ラウンド36ユーザー指示(36-3)で新設した「すべて折りたたむ・展開する」の専用行
	    (#damage-rows-toolbar、2ボタン版)は、UI改善ラウンド38ユーザー指示(38-H1)
	    「ヘッダーに移動し単一ボタンで交互切り替え」によりページ共通ヘッダー(トップバー、
	    src/pages/box/[id].astroの<Fragment slot="topbar-actions">)へ一度移設していたが、
	    🔴 UI改善ラウンド40ユーザー指示(40-H1)「ダメージカード領域の上に置く」により撤回し、
	    この#damage-rows-list直上に単一ボタン(38-H1の交互切り替えロジックはそのまま)として
	    再設置する。ロジック(状態判定・setAllRowsCollapsedの呼び出し・ラベルの出し分け)は
	    <script>のupdateCollapseToggleButtonLabel/damageCollapseToggleButtonEl(src/lib/box-id/
	    damage-calc.ts)に集約されており、el("damage-collapse-toggle-button")はDOM上の位置に
	    依存しないgetElementById経由のため、置き場所を変えてもidさえ変えなければ動く。
	    ダメージ計算カードが1件も無い個体では押しても意味が無いため、<script>側でdisabled
	    切り替えを行う(初期表示はdisabled、フェッチ完了後にJSが調整する)。 */}
	<div class="damage-rows-toolbar">
		<button id="damage-collapse-toggle-button" class="btn-ghost" type="button" disabled>
			すべて折りたたむ
		</button>
	</div>
	<div id="damage-rows-list" class="damage-rows-list">
		<p>読み込み中...</p>
	</div>
</section>

<style is:global>
	/* ダメージ計算カード(UI刷新): AstroのScoped<style>はJSがdocument.createElement()で生成した
	   要素には適用されない(data-astro-cid-*が付与されないため)。行(対戦相手1体につき1行)・
	   列(攻撃1つにつき1列)・詳細状況設定ダイアログはすべて<script>側で動的生成するため、
	   以下は#opponent-notes-section限定のグローバルセレクタとして定義する(他ページへの漏出を
	   防ぐため、必ずこの接頭辞を付ける)。
	   .card/.card-hint/.severity-bar/.status-text/.badge/.add-card-tile/.sprite-icon/.sprite-fallback/
	   .row/.spinner/input・select・textareaの基本装飾は src/styles/global.css 側の真のグローバル
	   スタイルなので動的生成要素にも効く。ここではこのページ固有の構造のみを追加定義する。 */
	/* ラウンド23ユーザー指示(23-H1): 「種族名を削除」。トップバー左の見出し
	   (.app-topbar-title)はAppLayout.astro側のマークアップで、このページの<script>から見ると
	   種族名がそのまま表示され続けている。AppLayoutは編集禁止(全ページ共通レイアウトのため)
	   なので、フロントマターでbodyClass="box-edit-page"(pokemonが存在するときだけ)を
	   AppLayoutへ渡し、bodyのクラスを起点にこのページだけへ効くグローバルセレクタで隠す。
	   <title>タグ(ブラウザタブ・履歴)は同じpageTitleを使うが、こちらは影響を受けない
	   (<head>内でCSSの対象外のため)。要素ごと消すとトップバー左側の内容が
	   「← 戻る」だけになる(状態表示#autosave-statusはラウンド11で既にテキストを常時非表示
	   済みのため実質空、エラー時のみ「再試行」が現れる)。実際に見て帯として成立するかを
	   確認済み(検証セクション参照)。 */
	body.box-edit-page .app-topbar-title {
		display: none;
	}

	/* ラウンド21(21-L6)で導入した#edit-form .tera-select-btn(アイコントグルボタン、
	   document.createElement("button")で動的生成)は、ラウンド23(23-L3)でテラスタイプを
	   <select>に戻したことで完全に不要になったため削除した(22-B-2の重複解消と合わせて、
	   buildIconToggleGroup()の左パネル側の複製呼び出しも<script>から削除済み)。 */

	#opponent-notes-section .pokemon-name-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: nowrap;
	}

	/* UI品質改善(デザイン原則整合): ダメージ計算1件=対戦相手1体は「追加/削除できる
	   コレクション要素」なのでカード(.card)として扱う。旧来はここに「battle-assistant
	   同様、カードを囲むパネルを持たないため枠も背景も付けない」と書いていたが、これは
	   骨格領域としてパネルで包まない旨の説明であり今も有効(この.damage-rows-list自体は
	   パネルにしない)。変わったのは個々のカード側で、基底.card(global.css)の枠線+
	   box-shadowを持つようになったため、カード同士の区切りは各カードの枠線・影と、この
	   gap の両方で表現する(影が付いた分、詰めて並べても1枚ずつが浮いて見え、区切りが
	   以前より明瞭になる)。
	   UI品質改善(2026-07-26 第4弾): 1920pxで右カラムにデッドスペースが残る問題は
	   align-items:flex-start(カードを内容幅までしか広げない)で解消を試みたが、
	   .damage-row-columns-wrapのflex-grow:1(flex-basis:0)と組み合わせると、コンテナの
	   利用可能幅が不定になり.damage-row-body全体のレイアウトが崩れる回帰が実機で発生したため
	   撤回した(flex-basis:0はflex-wrap誤爆防止の安全策として変更不可、と第3弾の知見にある)。
	   デッドスペース自体は.damage-row-build/.damage-columnの拡幅(320→340px/190→205px)で
	   ある程度緩和するに留める。 */
	/* ラウンド3 C-3: カード枠・内箱枠・フッター罫線が同じ濃さで多層に並び切れ目が読みにくかった
	   (A-4でフッター罫線自体は定常時に消えるので改善するが、gapも広げる)。
	   A-2で1枚303pxを達成し、3枚でも1080pxに収まる(実測1064〜1072px)ため8→12pxに広げる。 */
	/* ラウンド10: 「カードを2×2に並べる」案を実装したが、ユーザー判断により中止して
	   1列の縦積みに戻した。撤去したのは #opponent-notes-section / .card-damage の
	   container化と、@container dmgsection (min-width: 740px) による2列グリッド、
	   および2列時に相手ビルド箱を行いっぱいへ広げる @container dmgcard の指定。
	   実測での比較(1920px・カード4枚): 1列=1210px / 2×2=1144px。総高さは2×2が66px短いが、
	   カード1枚が276〜289px → 407〜559pxに伸び、1画面に入る枚数が3枚→2枚半に減る。
	   左右の行で高さが揃わない段差(実測152px)も出る。**再提案しないこと。** */
	#opponent-notes-section .damage-rows-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	/* エンジン初期化状況の1行。パネルの見出しを廃したので、この行だけが浮いて見えないよう
	   控えめな文字サイズにし、準備完了後は表示自体を隠す(JS側でhidden属性を付ける)。 */
	#opponent-notes-section .damage-calc-engine-status {
		margin: 0 0 0.4rem;
		font-size: 0.8rem;
	}
	#opponent-notes-section .damage-calc-engine-status[hidden] {
		display: none;
	}
	/* ラウンド20ユーザー指示(20-D1、ラウンド17 A-5の判断を撤回): 確N/乱N/未撃破の凡例は
	   「未撃破」の語を20-D4で廃止し必要性が下がったうえ、ユーザーから明示的に
	   「確N=...の説明書きを削除」と指示されたため、DOM(下記JSX)ごと削除した。 */
	/* ラウンド3 B-11の積み残し: 相手ビルドの箱・技名入力も左パネルと同じく、
	   placeholder表示中(空欄)は破線+透明背景にする(#edit-form側と同じ考え方)。 */
	#opponent-notes-section input:placeholder-shown:not(:focus) {
		border-style: dashed;
		background: transparent;
	}

	/* コンパクト化(battle_assistant.jpg / DamageCard.jpg準拠): このセクションの余白・
	   フォントサイズはここから下、意図的に通常より詰めている。
	   なお当初あった「1行160px以下」の目安は、DamageCard.pngで相手ビルドの箱に
	   攻守切り替え・実数値・加算後の結果が縦に積まれる構成が指定されたため撤回した
	   (図の構成では1行あたり240px前後になる)。「複数のカードを縦に並列表示できる」
	   という要件自体は、行を縦積みにするこのレイアウトで引き続き満たしている。 */
	#opponent-notes-section .card-damage {
		/* ラウンド24ユーザー指示(24-D1)「カード全体の縦サイズを縮小」対応: 上下paddingを詰める
		   (0.3rem→0.22rem)。 */
		padding: 0.2rem 0.6rem;
		margin: 0;
		max-width: 100%;
		/* ラウンド21ユーザー指示(21-D3): 削除ボタン(.damage-row-delete-button)をカード右上に
		   position:absoluteで置くための基準にする。 */
		position: relative;
	}
	/* 🔴 ラウンド25ユーザー指示(25-D1)「全体カードの選択ハイライトを廃止、ダメージカード
	   ごとのハイライトは残す」により、このカード全体(.card-damage)へのリング付与
	   (旧 #opponent-notes-section .card-damage.is-selected { box-shadow: ... }、
	   ラウンド21(21-D2)〜23(23-D6)の経緯を経て導入されていたもの)を廃止した。
	   <script>のclearSelectionMarks/applySelectionMarksからrow.root(このカード自体)
	   への is-selected 付け外しを削除したため、このルールはもう付与されない死んだCSSに
	   なる(grepで.card-damageへのis-selected付与経路が他に無いことを確認済み)。
	   選択のハイライトは技列(.damage-column.is-selected、下記参照)だけに残す。
	   ⚠️ グローバル基底の .card.is-selected(global.css)自体はこのラウンドの対象外
	   (他ページの選択状態にも使われる共通ルールのため)。このカードは class="card
	   card-damage" を持つが、is-selectedクラス自体がもう付与されないため基底ルールも
	   このページでは発火しない。 */

	/* 🔴 UI改善ラウンド31ユーザー指示(31-D1)「全体カードのホバーハイライトを廃止」により、
	   .card-damageのhover/focus-within時の変化(box-shadow: shadow-sm→shadow-md、
	   background: color-mixによる薄いprimary着色)を打ち消す。translateY(-2px)自体は
	   ラウンド20(20-G2)で既に撤去済みでもう存在しない(hover時に位置が動くことはない)。
	   ⚠️ .card共通のhover効果(global.css)自体は変更しない(全ページに波及するため)。
	   この打ち消しは.card-damageだけに限定したセレクタ(#opponent-notes-section
	   .card-damage:hover、ID+2クラス=global.cssの`.card:hover`(1クラス)より詳細度が高い)で行う。
	   選択中(.is-selected)の表現は元々このカード自体には付与されない(25-D1参照、上の
	   コメント)ため、打ち消す対象がそもそも存在せず、technical的にも意図せず消していない。 */
	#opponent-notes-section .card-damage:hover,
	#opponent-notes-section .card-damage:focus-within {
		box-shadow: var(--shadow-sm);
		background: var(--color-surface-alt);
		border-color: var(--color-border);
	}

	/* 🔴 ラウンド21ユーザー指示(21-D4)で導入し、ラウンド23(23-D6)で8%→12%に濃くした
	   「カード全体の背景色を攻撃なら薄い赤、防御なら薄い青にする」(.card-damage[data-direction]の
	   color-mix着色)は、ラウンド26ユーザー指示(26-D1)「攻守を参照したカード全体の背景色の
	   切り替えを廃止。代わりに、攻撃・防御選択ボタンのハイライト色を赤・青に変更」により
	   実質的に撤回した。カードの背景は方向によらず基底の--color-surface-altに戻る
	   (root.dataset.direction自体はrefreshDirectionUi()に残しているが、このCSSルールが
	   無くなったことで見た目には反映されない。将来別用途で使う可能性を考慮しdatasetは
	   残す判断)。方向の見分けは下のdamage-row-direction-option(セグメントボタン)の色で
	   伝える(WCAG 1.4.1対応として、ボタンの文字自体(「攻撃」「防御」)も引き続き残る)。 */

	/* ラウンド4で「相手ビルドの箱と技列の箱をalign-items:stretchで同じ高さに揃える」設計を
	   破棄し、技列側をalign-self:flex-startで「行の高さに合わせて伸びる」対象から外したが、
	   ラウンド5ユーザー指示で「まだ空きが目立つ」と再指摘され、一度は相手ビルドの箱を上段
	   (カード全幅)・技列を下段(横スクロール可)の2段組に作り直した。
	   ラウンド6ユーザー指示(更新された設計図): 技列を横並びから縦積みに変更したところ、
	   「技列3つぶんの縦積み高さ」が「相手ビルドの箱の高さ」と自然に近い値になったため、
	   ラウンド5で問題視されていた「高さの違うものを横に並べる」ことによる大きな余白が
	   生じにくくなった。設計図(ダメージ計算カード.png)どおり左=相手ビルドの箱・右=技列の
	   縦積みという横並び2カラム構成に戻す(.damage-row-bodyをflex-direction:rowに戻す)。
	   両側の高さは意図的に強制一致(stretch)させない: 技数が少ない行まで無理に伸ばすと
	   ラウンド5で指摘された空白が再発するため、align-items:flex-startで両箱とも内容の
	   高さのぶんだけを占め、技列3つのときに実測値がおおむね揃うよう内側の余白側で調整する
	   (下の.damage-row-build/.damage-columnの実測コメント参照)。
	   クラス名(.damage-row-build/.damage-row-columns-wrap/.damage-row-columns等)は
	   このラウンドでも改名・削除していない(JS/E2E依存を壊さないため)。 */
	/* UI品質改善(ラウンド8 A-3): 技列が1〜2つのカードは、右カラム(techniquesRow)の
	   自然な高さが左の相手ビルド箱より短く、下端に「意味のない空白」が残っていた
	   (align-items:flex-startだと右カラムは内容ぶんの高さしか占めない)。
	   align-items:stretchに変え、右カラムの高さを箱の高さに揃える
	   (=空白を「末尾の穴」から「意図的な余白」に変える)。
	   技列3つ(=右カラムの内容が箱より高い)側は右カラムが基準になり、箱側が
	   その高さまでstretchされるだけで、内容が窮屈になることはない。
	   ラウンド20ユーザー指示(20-D5): 「+技を追加」をmargin-top:autoで下端へ押し出す
	   設計は撤回した。技カードと同サイズの破線枠にしたことで技列1〜2つのときの
	   余白自体がほぼ解消されたため、最後の技カードの直後に自然に置く方式に変えた
	   (詳細は.damage-add-column-slotのコメント参照)。 */
	/* ラウンド10で発見した既存バグの修正: .damage-row-build は全幅で300px固定なので、
	   狭いビューポートでも横並びが維持され、技列が潰れていた(実測: 幅390pxで
	   .damage-row-body 329px のうち箱が300pxを取り、技列は残り19px)。
	   19pxの技列に連続技のヒット回数行(数値入力51px + 「回」22px)が入ると
	   right=427px まで飛び出し、幅390pxで37pxの横スクロールが発生していた
	   (ラウンド8の検証に連続技のカードを含めていなかったため見逃していた)。
	   → flex-wrapを許可し、技列に最小幅を与えて「箱+技列が入らない幅では
	   技列を次の行へ折り返す」ようにする。
	   実測での安全性: 1920px(body 758) / 1600px(459) では 300+9.6+150=460 が
	   body幅以下なので折り返さず、既存のデスクトップ2カラムは一切変わらない。 */
	#opponent-notes-section .damage-row-body {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.6rem;
		/* 24-D1: 0.3rem→0.2remに詰める(カード全体の縦サイズ縮小)。 */
		padding-bottom: 0.2rem;
	}

	/* 左: 相手ビルドの箱(DamageCard.pngの左側のボックス)。ラウンド6ユーザー指示で
	   左右2カラム構成に戻したため、右の技列(縦積み)と横並びになる固定幅を持つ。
	   攻守切り替えボタン・相手種族名+アイコン・特性・アイテム・テラスタイプ・
	   努力値・実数値を内包し、一番下に区切り線と「加算後のダメ・致死率」を置く。
	   幅300pxは技列(下の.damage-columnはこの右側の残り幅いっぱいに伸びる)との
	   横幅バランスと、努力値グリッド7列(3.4em+6列)が窮屈にならない実測値。
	   ラウンド23ユーザー指示(23-D3、ラウンド21の21-D3ではなく初出): 「相手ビルドカードの
	   外枠を削除。ダメージカードはそのまま」。border(旧: 1px solid var(--color-border))を
	   撤去した。技列(.damage-column)側は指示対象外(「ダメージカードはそのまま」)なので
	   border/border-radiusを維持しており、結果としてこの箱だけ縁が無くなる非対称な
	   見た目になる(意図どおり)。background: var(--color-surface)は残す判断にした
	   ——外側の.card-damage(surface-alt)との階調差で箱の輪郭が読めることを実機で
	   確認した(borderが無くてもcolor-mixで着色した.card-damage背景との明度差が
	   十分にあるため、技列の箱との区別も付く。判断根拠は報告参照)。border-radiusは
	   backgroundの角を丸めるためそのまま残す。 */
	/* UI改善ラウンド26ユーザー指示(26-D3)「攻撃・防御ボタンの幅を短縮し、空いた分で
	   ポケモンアイコンを大きくする。相手ビルドカード領域を右に伸ばしてよい」により
	   300px→340pxに広げる(技列側(.damage-row-columns-wrap)の幅はその分縮む)。
	   ⚠️ ラウンド10で発見した「箱を固定幅にした結果、狭い幅で技列が潰れて横スクロールが
	   発生した」実バグと同型の事故が、この箱自体の固定幅拡大で新たに発生することを実測で
	   発見した: 300pxのときは360px幅ビューポートでも箱がぎりぎり収まっていたが、340pxに
	   広げたことで箱自体が.damage-row-bodyの折り返し後の1行(≒330px)にも収まりきらず、
	   ページ全体で約10.6pxの横スクロールが発生した(flex-shrink:0だと.damage-row-bodyが
	   折り返しても箱自体は縮まないため)。flex-shrinkを1にしてmax-width:100%を足し、
	   箱が入りきらない狭幅では340pxを上限に縮小できるようにする(340pxはあくまで
	   「デスクトップでの望ましい幅」であり、下限を保証する値ではない)。
	   1920/1600/1440/1280/1024/900/700/390/360pxすべてで横スクロールが起きないことを
	   実測確認済み(報告参照)。 */
	#opponent-notes-section .damage-row-build {
		flex: 0 1 340px;
		width: 340px;
		max-width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		border-radius: var(--radius-md);
		padding: 0.35rem 0.6rem;
		background: var(--color-surface);
	}
	/* ラウンド7ユーザー指示(方針転換): 相手ビルドの箱のクリックは無反応にする(サイドバーを
	   開くのは技列の箱だけ)確定仕様になったため、この箱自体のis-selectedマーカー・
	   選択時transitionは廃止した(以前は.damage-column.is-selectedと対になっていた)。
	   ラウンド8指摘(B-4): 「クリック非反応であることが画面から分からない」の積み残しに
	   対応し、cursor:defaultを明示する(.damage-columnのcursor:pointerと対比させる)。 */
	#opponent-notes-section .damage-row-build { cursor: default; }
	/* UI品質改善(ラウンド8 A-1): 相手名input(29px)の右に公式絵72pxが乗っていたため、
	   名前行だけで72pxを占有し43pxが空気になっていた(特性/持ち物/テラスの3入力はその
	   下から始まる縦積み一本道だったため)。スプライトを名前行の外へ出し、入力ボックス一式と
	   横に並べる(.damage-row-build-main)。
	   ラウンド26ユーザー指示(26-D3)でスプライト(.damage-sprite-box)を攻守セグメントの行
	   (.damage-row-actions)へ一時的に移設していたが、🔴 ラウンド27ユーザー指示(27-D1)
	   「相手アイコンの左側スペースに入力ボックスを配置する(以前のように)」により、
	   このdamage-row-build-mainへ戻す。今回は「名前・特性・持ち物・テラス選択・
	   努力値グリッド」の入力ボックス一式(.damage-row-build-left、下記)をまとめてスプライトの
	   左に置く2カラム構成にする(以前は名前+3セレクトだけがスプライトの隣で、努力値
	   グリッドはさらに下の全幅行だったが、今回はユーザー指示によりEVグリッドも含める)。
	   クラス自体は改名していない(JS/E2E依存を壊さないため)。 */
	/* UI改善ラウンド28ユーザー指示(28-D1)「ポケモンアイコンは最初の5段分使う」で
	   align-items を flex-start → stretch にし、buildLeft(1段目=攻守トグル+2〜5段目=
	   種族名/特性/持ち物/テラス)の実高さにspriteBoxを丈いっぱい追随させていた。
	   🔴 UI改善ラウンド39ユーザー指示(39-D4)「展開状態のアイコン配置に折りたたみ後の
	   デザインを適用する(位置だけでなく見た目のデザイン自体を圧縮後基準に統一する)」
	   により28-D1のstretch方針を撤回し、折りたたみ状態(下の
	   .card-damage[data-collapsed="true"] .damage-row-build-main)と同じcenterにする。
	   spriteBox自体も固定80×80(下の.damage-sprite-box参照)にしたため、centerで
	   spriteBox/collapsedSummaryそれぞれの内容ぶんの高さだけを占める形になり、
	   折りたたみ状態の.damage-row-build-mainと展開状態とで同じ配置ルールになる
	   (折りたたみ専用の.card-damage[data-collapsed="true"] .damage-row-build-main
	   align-items:centerの上書きは、基底がcenterになったことで冗長になったため削除した)。 */
	#opponent-notes-section .damage-row-build-main {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	/* 🔴 UI改善ラウンド38ユーザー指示(38-D3)「折りたたみの前後でアイコンの表示位置が
	   変わらないように、折りたたみ前のアイコン群を左上に移動する」。DOM順(<script>の
	   buildMain.appendChild呼び出し順)はbuildLeft→spriteBox→collapsedSummaryのままで
	   変えず(他のロジックへの影響を避けるため)、flexのorderだけで視覚順を
	   spriteBox→collapsedSummary→buildLeftに並べ替える。折りたたみ時は
	   .damage-row-build-left自体がdisplay:noneになる(既存ルール、下方参照)ため、
	   結果として展開時は「アイコン→入力欄」、折りたたみ時は「アイコン→名前/攻守summary」の
	   順になり、どちらもアイコンが最左(=左上)に来る。align-items:stretch(上のルール)は
	   orderの影響を受けない(cross-axisのサイズ決定はDOM順・視覚順どちらにも依存しないため)、
	   アイコンの縦位置(top)・高さは今回のorder変更による影響を受けない。 */
	#opponent-notes-section .damage-sprite-box {
		order: 1;
	}
	#opponent-notes-section .damage-row-collapsed-summary {
		order: 2;
	}
	#opponent-notes-section .damage-row-build-left {
		order: 3;
	}
	/* ラウンド27ユーザー指示(27-D1)で新設。damage-row-build-main内でスプライト
	   (.damage-sprite-box、幅112px固定・flex-shrink:0)の左隣に置く列。
	   🔴 UI改善ラウンド28ユーザー指示(28-D1/28-D2/28-D3)により、この列の中身は
	   actionsRow(1段目、攻守切替)+ buildFields(2〜5段目、種族名/特性/持ち物/テラス)の
	   2つだけになった(以前ここに含めていたdamage-ev-gridは、28-D3によりbuildElの
	   直接の子=相手ビルド領域の全幅に移した。下のdamage-ev-grid参照)。
	   スプライトぶんの幅(112px+gap)を差し引いた残り幅を占める(flex:1 1 auto+min-width:0)。 */
	#opponent-notes-section .damage-row-build-left {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		flex: 1 1 auto;
	}
	#opponent-notes-section .damage-row-build-fields {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}
	#opponent-notes-section .damage-row-build select,
	#opponent-notes-section .damage-row-build input[type="text"] {
		width: 100%;
		min-width: 0;
		/* ラウンド3 A-1: global.cssの input/select { min-height: 2.35rem }(=37.6px)が
		   ここで一度も打ち消されておらず、内容高さ24.6px(font-size 0.82rem/padding 0.28em)が
		   37.6pxに引き伸ばされて1行あたり13pxが空気になっていた(414px膨張の主因)。
		   タップ対象28pxの要件はアイコンボタン側(.damage-row-icon-button等)の話であり、
		   このページのテキスト入力には適用されないため、min-height自体を打ち消す。
		   フォントサイズは第4弾の底上げを維持し、変更しない。 */
		min-height: 0;
	}
	/* 名前行(アイコン+相手名input+アイコンボタン2つ)は上のwidth:100%を打ち消し、
	   flexで残り幅いっぱいまで伸ばす(打ち消さないと相手名inputが行全体の幅を
	   取ろうとして、隣のアイコンボタンが28px未満に潰れてしまう)。
	   font-size/paddingも他の入力欄同様に詰める(既定のinput[type=text]は
	   line-height:1.6を継承するため、詰めないとこの1個の入力欄だけ突出して高くなる)。 */
	#opponent-notes-section .pokemon-name-row input[type="text"] {
		width: auto;
		flex: 1 1 0;
		min-width: 0;
		font-size: 0.92rem;
		font-weight: 700;
		padding: 0.32em 0.45em;
		line-height: 1.2;
	}

	/* 相手ビルドの箱の1行目: 攻守切り替えボタン(⚙詳細ボタンはラウンド6で廃止し、箱自体の
	   クリックに置き換えた)。
	   DamageCard.pngで最上段に置かれている「攻守切り替えボタン」の行にあたる。
	   ラウンド21ユーザー指示(21-D3): 「この相手を削除」(🗑→×)はこの行から
	   カード右上(.damage-row-delete-button、position:absolute)へ移した。以前は
	   このactionsRowに攻守切り替えと同居していたが、移設後はこの行に攻守切り替えの
	   セグメントコントロールだけが残る(ラウンド20 20-D2で作ったレイアウトはそのまま)。 */
	/* ラウンド26ユーザー指示(26-D3)で、内容量に応じた幅に縮めた攻守セグメント
	   (.damage-row-direction-toggle)の隣にポケモンアイコン(.damage-sprite-box)を
	   一時的に並べていたが、ラウンド27ユーザー指示(27-D1)によりスプライトは
	   damage-row-build-main側(入力ボックス一式の右)へ戻したため、この行はもう
	   攻守セグメントだけになる。justify-content:space-betweenは子が1個だと無害
	   (単に左寄せになるだけ)なので、害が無い設定として残す。
	   🔴 UI改善ラウンド28ユーザー指示(28-D1)により、この行はbuildEl直下ではなく
	   buildLeft(名前/特性/持ち物/テラス入力欄と同じ列)の1段目になった。display:flexの
	   直下でwidth指定が無いブロックはデフォルトで親(buildLeft)の全幅に伸びるため、
	   直下の.damage-row-direction-toggleがwidth:100%(下記28-D2)を指定すれば
	   入力欄と同じ幅になる。 */
	#opponent-notes-section .damage-row-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.3rem;
	}

	/* ラウンド20ユーザー指示(20-D2、旧・単一トグルボタンを撤回): 「攻撃」「防御」の
	   2値セグメントコントロールにする。1個のボタンで「今どちらか」を読んで理解するのでは
	   なく、両方の選択肢が常に見えていて片方が選ばれている形にする方が直感的、というのが
	   ユーザーの弁。「この個体が」は冗長として省き、ラベルは「攻撃」「防御」の2語のみにした
	   (絵文字⚔🛡も判断に委ねられていたが、両方が並んで見える形なら文字だけで十分伝わる
	   ため外した)。role="radiogroup"+role="radio"+aria-checkedで実装し、どちらが選択中かを
	   スクリーンリーダーにも伝える。field.directionの保存形式("attack"|"defense")・
	   向きに追随する既存の言い換え(技列のplaceholder、詳細パネルの見出し、壁のラベル)は
	   一切変えない(<script>のrefreshDirectionUi/renderColumns参照)。 */
	/* UI改善ラウンド26ユーザー指示(26-D3)「攻撃・防御ボタンの幅を短縮し、空いた分で
	   ポケモンアイコンを大きくする」により、行全幅を占有していたflex:1 1 0を撤回し、
	   内容量に応じた幅(flex:0 0 auto)にしていた(pitfalls.mdの「flex:1 1 0は余白を全部飲む」
	   と同型の是正)。
	   🔴 UI改善ラウンド28ユーザー指示(28-D2)「攻撃・防御切り替えボタンは種族名などの
	   入力欄と同じ幅にする」により、26-D3の幅短縮部分だけを撤回する(赤/青ハイライトの
	   配色=.damage-row-direction-option[data-role=...][aria-checked="true"]は維持)。
	   実測75px→種族名等の入力欄と同じ202px相当(width:100%、buildLeftの全幅)にする。
	   スプライトの拡大は28-D1で「箱の高さをbuildLeftの高さに追随させる」形に変わった
	   ため、このボタンの幅短縮でスプライトの横幅を捻出する必要はもう無い。 */
	#opponent-notes-section .damage-row-direction-toggle {
		display: flex;
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	#opponent-notes-section .damage-row-direction-option {
		flex: 1 1 0;
		min-width: 0;
		border: none;
		background: var(--color-surface);
		color: var(--color-text-muted);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.25em 0.4em;
		line-height: 1.2;
		cursor: pointer;
		transition: background 0.15s, color 0.15s;
	}
	#opponent-notes-section .damage-row-direction-option + .damage-row-direction-option {
		border-left: 1px solid var(--color-border);
	}
	#opponent-notes-section .damage-row-direction-option:hover:not([aria-checked="true"]) {
		color: var(--color-primary);
		background: var(--color-primary-soft);
	}
	#opponent-notes-section .damage-row-direction-option:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
	}
	/* UI改善ラウンド26ユーザー指示(26-D1)「攻撃・防御選択ボタンのハイライト色を赤・青に
	   変更」対応: attackOption/defenseOptionを区別する属性が無かったため、<script>の
	   renderRowでattackOption.dataset.role="attack"/defenseOption.dataset.role="defense"を
	   新設し、選択中(aria-checked="true")の配色を方向ごとに分ける。
	   防御側(青)は既存の配色をそのまま維持する(コントラストはライト4.62:1/ダーク8.87:1、
	   いずれもWCAG AA 4.5:1を満たす。--color-primary背景+--color-primary-contrast文字という
	   素直な組み合わせは、ライトモードで実測2.66:1しか無く不合格だったため(pitfalls.mdの
	   「結果チップの低コントラスト事故」と同型)、背景を一段暗い--color-primary-strongに
	   差し替えて解決した経緯がある)。
	   攻撃側(赤)は新色を作らず、global.cssのbutton.btn-danger/.delete-buttonで既に
	   採用済みの組み合わせ(--color-danger-strong背景+--color-primary-contrast文字)を
	   流用する。この組み合わせは同ファイルのコメント(ラウンド22 22-A-1)によりライト5.96:1・
	   ダーク7.93:1で選定済み(ダークは--color-danger-strongが--color-dangerにエイリアスされる)、
	   いずれもWCAG AA 4.5:1に適合する。素の--color-danger+白文字はライト2.82:1で不合格
	   だった実例が既にあるため、-strong側を使う。 */
	#opponent-notes-section .damage-row-direction-option[data-role="attack"][aria-checked="true"] {
		background: var(--color-danger-strong);
		color: var(--color-primary-contrast);
	}
	#opponent-notes-section .damage-row-direction-option[data-role="defense"][aria-checked="true"] {
		background: var(--color-primary-strong);
		color: var(--color-primary-contrast);
	}

	/* 相手ビルドの入力欄(特性・アイテム・テラスタイプ)は、DamageCard.png準拠で
	   1項目1行の縦積みを既定にする。ラベルは置かずplaceholder/aria-labelのみ(既存方針を維持)。 */
	#opponent-notes-section .damage-row-build-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		/* ラウンド3 A-2(e): 0.2rem→0.15remに詰める。 */
		gap: 0.15rem;
	}
	/* ラウンド5で「箱が全幅のときは3列に並べる」@containerクエリを追加していたが、
	   ラウンド6で箱を固定300px幅の左カラムに戻したため480px以上になることがなく
	   常に不発になる。実体のないルールを残すと紛らわしいため削除し、1列縦積み
	   (上の基本定義)のみにする。 */
	/* ラウンド5ユーザー指示: 「特性などの入力ボックスが無駄に大きい。さらに詰める」。
	   font-size/paddingを一段階詰める(0.82rem/0.28em 0.4em → 0.76rem/0.2em 0.35em)。
	   UI改善ラウンド26ユーザー指示(26-D4)「相手ビルドの種族名以外の文字が小さい」により、
	   一段階上げる(0.76rem(12.16px)→0.86rem(13.76px)、+1.6px)。26-D3でアイコンを
	   大きくした際に生まれた縦の余白を、ここでの文字サイズ拡大にも充てる(カード3枚が
	   1080pxに収まる制約は実測のうえ維持。before/afterの実測値は報告参照)。 */
	#opponent-notes-section .damage-row-build-grid select,
	#opponent-notes-section .damage-row-build-grid input[type="text"] {
		font-size: 0.86rem;
		padding: 0.22em 0.38em;
		line-height: 1.15;
		/* ラウンド3 A-1: 相手ビルド箱の性格/特性/持ち物/テラスの4行がglobal.cssの
		   min-height:2.35remで各行13px膨らんでいた(4行で52px)。打ち消す。 */
		min-height: 0;
		/* ラウンド4の積み残し: 特性・持ち物欄が長い値で見切れる(全文はtitle属性で確認)。 */
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* ドロップダウン統一(ラウンド4): 上のpadding(shorthand)がpadding-rightも
	   戻してしまうため、矢印ぶんの余白をselectだけ個別に広げ直す
	   (このルールの方が後ろにあるので勝つ)。 */
	#opponent-notes-section .damage-row-build-grid select {
		padding-right: 1.3em;
	}

	/* 🔴 UI改善ラウンド40ユーザー指示(40-D1)「テラスタイプ選択ボックスは、左パネルのもの
	   (選択肢にアイコンが見えるカスタムドロップダウン)と共通化する。高さはアイテムなどの
	   他UIとそろえる」により、31-D4b/32-D2/34-D2/38-D1で個別に積み上げてきた
	   「<select>+左に絶対配置したアイコン+見た目トークンの個別すり合わせ」を全面的に撤回し、
	   左パネルの#tera-dropdown-button/#tera-dropdown-list(LeftPanel.astro 226〜249行目・
	   left-panel.ts 500〜613行目)と同じ「ボタン+リストボックス」のカスタムドロップダウンに
	   置き換える。左パネル側はページに1個しか無い前提でid固定のgetElementById()を使うが、
	   ダメージカードは1枚につき1個(相手のテラスタイプ)・複数枚同時に存在しうるため、
	   <script>のbuildTeraDropdown()はidを使わずクロージャで状態を閉じ込め、
	   呼び出すたびに独立したインスタンス(ボタン+リスト一式)を生成する(damage-calc.ts参照)。
	   高さ・書体は左パネルの値をそのまま流用する(#edit-form .tera-dropdown-button、
	   LeftPanel.astro参照。「アイテムなど他のUIとそろえる」という要件は、このセクション内の
	   他の入力欄(.damage-row-build-grid select/input、上方の共通ルール)がmin-height:2.35rem
	   を持たない0.86rem/0.22em系の詰めた規格である一方、テラス欄だけ左パネルの規格
	   (min-height:2.35rem・font-size:0.94rem)に揃える、という34-D2以来の既存判断を維持する
	   形になる)。ボタン・リストとも<script>がdocument.createElement()で生成するため、
	   Astroのscoped<style>は一切効かない(pitfalls.md参照)。#opponent-notes-section接頭辞の
	   グローバルセレクタとしてここに定義する。 */
	#opponent-notes-section .damage-row-tera-field { position: relative; width: 100%; }
	#opponent-notes-section .tera-dropdown-button {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem;
		width: 100%;
		min-height: 2.35rem;
		padding: 0.42em 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		cursor: pointer;
		font-size: 0.94rem;
		font-weight: 600;
		line-height: var(--line-height-snug);
		color: var(--color-text);
		text-align: left;
	}
	#opponent-notes-section .tera-dropdown-button:hover { border-color: var(--color-primary); }
	#opponent-notes-section .tera-dropdown-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}
	/* ラウンド24ユーザー指示(24-L3)「テラスなしを目立たなくする」と同じ視覚言語
	   (input:placeholder-shownと同じ破線枠+透明背景)を、テラスなし選択中のボタンにも
	   適用する(左パネルの.tera-dropdown-button.is-tera-unselectedと同じ考え方)。 */
	#opponent-notes-section .tera-dropdown-button.is-tera-unselected {
		border-style: dashed;
		background: transparent;
	}
	#opponent-notes-section .tera-dropdown-image { width: var(--icon-size-sm); height: var(--icon-size-sm); object-fit: contain; flex-shrink: 0; }
	#opponent-notes-section .tera-dropdown-placeholder {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--color-text-muted);
	}
	#opponent-notes-section .tera-dropdown-placeholder.is-tera-value-text { color: var(--color-text); }
	/* リストボックス: ボタン直下に開く。左パネルと同じ19タイプ+テラスなしの20項目を
	   縦スクロールで収める。 */
	#opponent-notes-section .tera-dropdown-list {
		position: absolute;
		top: calc(100% + 0.25rem);
		left: 0;
		right: 0;
		z-index: 5;
		margin: 0;
		padding: 0.3rem;
		list-style: none;
		max-height: 16rem;
		overflow-y: auto;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}
	#opponent-notes-section .tera-dropdown-list[hidden] { display: none; }

	/* UI改善ラウンド23(23-G3): 左パネル(#edit-form #item.is-autofilled、上の
	   scoped<style>参照)と同じ内容。JS生成要素にはscoped<style>が効かないため
	   (pitfalls.md「AstroのscopedスタイルはJSで生成した要素に効かない」)、
	   ここに複製する。 */
	#opponent-notes-section .damage-row-build-grid input.is-autofilled {
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 30%, transparent);
	}

	/* 種族アイコン(公式絵)+ 右上テラスタイプバッジ + 右下持ち物バッジ。
	   #edit-form側の.species-icon-box/.type-badge等はAstroのscoped<style>で定義されており
	   動的生成要素には適用されないため、同等の見た目をここに再定義する。
	   ラウンド4で32px/28pxから56px/48pxに拡大、ラウンド5ユーザー指示で「まだ小さい」との
	   再指摘があり72px/64pxへ拡大、ラウンド8指摘(A-1)で名前行から出したぶんの余白を使い
	   96px/88pxへさらに拡大、ラウンド26ユーザー指示(26-D3)で112px/104pxへさらに拡大した。
	   🔴 UI改善ラウンド28ユーザー指示(28-D1)「ポケモンアイコンは最初の5段分使う」により、
	   固定height(112px)をやめてheight:autoにし、親(.damage-row-build-main、
	   align-items:stretch)が決める高さ(=buildLeftの1〜5段目ぶんの高さ)にstretchで
	   追随させる。widthは112px固定のまま(buildLeftの隣に残る余白から算出される値と
	   ほぼ一致する)。画像自体はobject-fit:containで箱いっぱいに収め、縦横比は保つ
	   (下のimg.sprite-icon参照)。 */
	/* UI改善ラウンド32ユーザー指示(32-D1)「相手ポケモンのアイコンを6%ほど小さくする」により、
	   112px→105.28px(112×0.94)に縮小していた。実測対象としてround-32.mdが挙げている
	   `.sprite-icon`(相手側のimg)はwidth:100%;height:100%でこの.damage-sprite-box箱に
	   フィットしているだけの共有クラス(src/styles/global.css)なので、.sprite-icon自体は
	   一切変更しない(global.css編集禁止)。
	   🔴 UI改善ラウンド39ユーザー指示(39-D4)「展開状態のアイコン配置に折りたたみ後の
	   デザインを適用する」により、展開時だけの固定幅105.28px+height:auto(28-D1の
	   stretch追随)を撤回し、折りたたみ状態(下の.card-damage[data-collapsed="true"]
	   .damage-sprite-box)と全く同じ固定80×80に統一する(「位置だけ揃える」ではなく
	   「サイズ・デザイン自体を圧縮後基準に統一する」という要件どおり)。この結果、
	   折りたたみ専用の80×80上書きルールは基底と同値になり冗長になったため削除した。
	   持ち物バッジ(.damage-item-badge、下記)の絶対配置オフセット(bottom/right -4px)は
	   折りたたみ状態で既にこの80×80の箱に対して問題なく収まっている実績があるため、
	   展開状態でも同じ配置のまま流用できる(調整不要)。 */
	#opponent-notes-section .damage-sprite-box {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		border-radius: var(--radius-md);
		/* UI改善ラウンド31ユーザー指示(31-D3)「ポケモン画像の背景色を削除」(31-L1と同じ処置を
		   相手側にも行う)により透明にする。 */
		background: transparent;
		flex-shrink: 0;
	}
	/* 🔴 UI改善ラウンド31ユーザー指示(31-D3)追加対応: 背景色の出どころは.damage-sprite-box
	   (このファイル内、下で透明化済み)ではなく、img自身が持つ共通クラス.sprite-icon
	   (src/styles/global.css、`.sprite-icon { background: var(--color-surface-alt);
	   border-radius: 50%; }`)だった。.sprite-iconは複数ページで共有される真のグローバル
	   スタイルのため、global.css側は変更せず、このページ限定のセレクタで打ち消す
	   (#opponent-notes-section接頭辞があるため/box一覧・/teamのimg.sprite-iconには影響しない。
	   実測で確認済み)。border-radius:50%も外す: 背景を消しても円形トリミング自体は画像
	   コンテンツを角で切り抜き続ける(公式絵は正方形いっぱいに手足・尻尾が伸びる個体がある)。
	   31-L1(左パネルの.species-sprite-img)は円形トリミングを持たず全身が見えるため、
	   これと見た目を揃える意味でもborder-radiusを外す判断とした(実装者の判断)。 */
	#opponent-notes-section .damage-sprite-box img.sprite-icon {
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: transparent;
		border-radius: 0;
	}
	#opponent-notes-section .damage-sprite-box .sprite-fallback {
		font-size: 2.1rem;
	}
	/* 🔴 UI改善ラウンド31ユーザー指示(31-D4a)「テラスタイプ画像は…ポケモン画像の右上の表示を
	   廃止」により常時非表示にする。DOMは残す(<script>のrefreshTypeBadge/applyTeraImageが
	   引き続きtypeBadgeImg/typeBadgeFallbackを参照するため要素自体は削除しない)。
	   applyTeraImage()はこの2要素のstyle.displayを直接インライン指定するだけ(親span自体の
	   displayは触らない)なので、親.damage-type-badgeをdisplay:noneにするだけで両方隠れる
	   (31-L3の.top-block-tera-imageと違い、こちらは!important不要)。 */
	#opponent-notes-section .damage-type-badge {
		display: none;
		position: absolute;
		top: -6px;
		right: -6px;
		align-items: center;
		justify-content: center;
	}
	/* ラウンド20ユーザー指示(20-G1): 18px→var(--icon-size-sm)(20px、global.css定義済み)に
	   拡大する。密なグリッド内の小アイコン規格(20-G1のトークン表「ダメージ計算カードの
	   相手ビルド箱」)に合わせる。持ち物画像(.damage-item-badge、下記)は既に22pxで
	   20px以上を満たしているため今回は変更しない。
	   ⚠️ このバッジは通常のタイプバッジではなく、applyTeraImage(row.teraType)が唯一のソース
	   (このファイル内のtypeBadgeImg/typeBadgeFallback、<script>のrefreshTypeBadge参照)、
	   つまりテラスタイプ専用のバッジである。UI改善ラウンド28ユーザー指示(28-G1)「テラスタイプ
	   画像には専用アイコンを使う」によりapplyTeraImage()がteraTypeIconUrl(宝石型・ジグザグの
	   尖った縁を持つ正方形画像)を返すようになったため、border-radius: 50%による丸トリミングを
	   外す(掛けたままだと縁が削れてユーザーが直した意味が無くなる)。ラウンド5時点のコメントは
	   このバッジが「通常タイプアイコンと同じ丸トリミング」だった頃の記述で、28-G1により
	   そのままでは成立しなくなったため削除した(ダメージ計算カード自体のレイアウトは
	   別担当エージェントの範囲だが、border-radiusの撤去はapplyTeraImage側の変更に伴う
	   1点修正としてこのラウンドで対応する)。 */
	#opponent-notes-section .damage-type-badge-img {
		height: var(--icon-size-sm);
		width: var(--icon-size-sm);
		filter: drop-shadow(0 0 1px var(--color-surface));
	}
	#opponent-notes-section .damage-type-badge-fallback {
		display: none;
		width: var(--icon-size-sm);
		height: var(--icon-size-sm);
		border-radius: 50%;
		border: 1px solid var(--color-border);
	}
	/* #species-type-badge自体は静的マークアップだが、中の<img>/<span>はapplyTypeBadge()が
	   document.createElement()で動的追加するため、上のscoped <style>の.type-badge-imgは
	   付与されない(data-astro-cid-*が無い要素にはscoped <style>が効かない。
	   #opponent-notes-section .damage-type-badge-imgと同じ理屈)。同じ値をここに複製する。
	   ラウンド5ユーザー指示: 正方形の事前生成アイコンに切り替えたため object-fit:cover 等の
	   切り出しは不要(border-radius:50%だけで円形に見える)。 */
	/* ラウンド20ユーザー指示(20-G1): 14px→--icon-size-sm(20px、global.css定義済み)に
	   拡大する。is:globalブロック内(:root継承)なのでカスタムプロパティは通常どおり参照できる。 */
	#species-type-badge .type-badge-img {
		height: var(--icon-size-sm);
		width: var(--icon-size-sm);
		border-radius: 50%;
		filter: drop-shadow(0 0 1px var(--color-surface));
	}
	#species-type-badge .type-badge-fallback {
		display: none;
		width: var(--icon-size-sm);
		height: var(--icon-size-sm);
		border-radius: 50%;
		border: 1px solid var(--color-border);
	}
	/* UI改善ラウンド28ユーザー指示(28-G1/28-L4): テラスタル選択ボックスのリスト項目
	   (#tera-dropdown-list配下の<li>、<script>のbuildTeraDropdownがdocument.createElement()で
	   動的生成する)は、上の#species-type-badgeと同じ理由でscoped <style>が効かない
	   (data-astro-cid-*が無い要素には効かない。pitfalls.md参照)。実際のスタイルはここに置く。
	   専用アイコン(teraTypeIconUrl、宝石型)は幅を持て余すため固定サイズにし
	   (通常タイプアイコンと同じ--icon-size-sm、20px)、隣にタイプ名テキストを並べる。
	   宝石型アイコンはジグザグの尖った縁を持つため、border-radius: 50%は掛けない
	   (掛けると縁が削れる)。
	   🔴 UI改善ラウンド40ユーザー指示(40-D1)「テラス選択ボックスを左パネルと共通化する」により、
	   damage-calc.tsのbuildTeraDropdown()が生成する<li>(#opponent-notes-section配下)も
	   同じクラス名(.tera-dropdown-option等)を使うため、セレクタに#opponent-notes-section
	   を追加してどちらの由来でも同じ見た目になるようにする(値そのものは変更しない、
	   「共通化」の趣旨どおり1箇所の定義を両方で使う)。 */
	#edit-form .tera-dropdown-option,
	#opponent-notes-section .tera-dropdown-option {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25em 0.4em;
		border-radius: var(--radius-sm);
		cursor: pointer;
	}
	#edit-form .tera-dropdown-option:hover,
	#edit-form .tera-dropdown-option:focus-visible,
	#opponent-notes-section .tera-dropdown-option:hover,
	#opponent-notes-section .tera-dropdown-option:focus-visible {
		background: var(--color-surface-alt);
		outline: none;
	}
	#edit-form .tera-dropdown-option.is-active,
	#opponent-notes-section .tera-dropdown-option.is-active {
		background: var(--color-primary-soft);
	}
	#edit-form .tera-dropdown-option-image,
	#opponent-notes-section .tera-dropdown-option-image { width: var(--icon-size-sm); height: var(--icon-size-sm); object-fit: contain; flex-shrink: 0; }
	#edit-form .tera-dropdown-option-text,
	#opponent-notes-section .tera-dropdown-option-text { font-size: 0.9rem; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	/* 持ち物画像: 名前行の横幅を圧迫しないよう、種族アイコンに小さなバッジとして重ねる
	   (要件: テラスバッジ=右上と衝突しない対角に配置)。
	   ラウンド8指摘(A-1由来): 以前はbottom:-6px/left:-6pxで名前inputとの継ぎ目に浮いて
	   見えていた。
	   ラウンド23ユーザー指示(23-G1「アイテム画像の丸枠を廃止し直接表示する」+23-D1
	   「アイテム画像を2/3に縮小」): 55px→37pxに縮小し、白丸+枠+影(border-radius/
	   background/border/box-shadow/padding)を撤去して画像を直接表示する(左パネルの
	   .item-image-badgeと同じ変更内容・同じ最終サイズ)。overflow:hiddenも円形クリップ用
	   だったため不要になり撤去した。position:absoluteでのbottom/rightオフセット(-4px)と
	   種族アイコンへの重ね配置は維持する。 */
	/* 🔴 UI改善ラウンド34ユーザー指示(34-D1)「アイテムアイコンのサイズを-10%」により、
	   37px→33px(37×0.9=33.3を四捨五入)に縮小する。.damage-sprite-box(96px固定)基準の
	   絶対配置(bottom:-4px; right:-4px)のままなので、縮小してもカード全体の高さには
	   影響しない。 */
	#opponent-notes-section .damage-item-badge {
		position: absolute;
		bottom: -4px;
		right: -4px;
		width: 33px;
		height: 33px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	/* ラウンド8の回帰修正: display:flexを持つクラスはUAの[hidden]{display:none}に
	   詳細度で勝ってしまう(pitfalls.md「[hidden]は詳細度で負ける」)。枠を撤去した後も
	   バッジ自体([hidden]対象)と中の<img>([hidden]とは別に、applyItemImage()側で
	   display:noneにする)の二重の隠蔽ロジックは変わらず必要(持ち物なしの相手で
	   alt文字や壊れ画像アイコンが出ないようにするため)。23-G1適用後も実機で
	   持ち物なしの相手に空バッジが出ないことを確認済み。 */
	#opponent-notes-section .damage-item-badge[hidden] {
		display: none;
	}
	/* ラウンド23ユーザー指示(23-D1): 55px→37pxに縮小(左パネルの.item-image-badgeと同じ
	   最終サイズ)。.damage-item-badge はposition:absoluteで.damage-sprite-box
	   (width/height固定96px)基準に重なるだけで通常のフローに参加しないため、
	   縮小してもカード自体の高さには影響しない。
	   pixelatedの扱い: 23-G1の指示文は「/boxと左パネルはpixelatedを撤去した」という
	   前提だったが、実装時に確認したところ左パネルの.item-image(37px)は実際には
	   pixelatedを維持したまま「37pxなら実解像度32×32に近くボケが判別できない」という
	   判断で据え置かれていた(このファイル958行目のコメント参照)。このバッジも同じ
	   37px・同じPokeAPIドット絵ソースのため、左パネルと揃える形でpixelatedを維持する
	   (ライト・ダーク双方でdeviceScaleFactor:3の拡大クロップを確認し、有無での見え方の
	   差が実測で判別できないことを確認済み。判断根拠は報告参照)。 */
	#opponent-notes-section .damage-item-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
		image-rendering: pixelated;
	}

	/* 努力値/実数値グリッド(DamageCard.pngの「努力値 ＨＡＢＣＤＳ」「実数値 ＨＡＢＣＤＳ」の2行)。
	   1列目に行ラベル(努力値/実数値)を置き、その右にH/A/B/C/D/Sの6列を並べる3段構成
	   (1段目はH/A/B/C/D/Sの見出し)。DOMも行優先(見出し7セル→努力値7セル→実数値7セル)で
	   生成すること。列ごとに縦積みしていた旧構造では行ラベルを付けられなかったため入れ替えた。
	   UI品質改善(2026-07-26 第4弾): 文字が実測~10pxと小さすぎたため、行ラベル/列見出し/
	   数値のフォントサイズを底上げした(桁揃えのため.tnumも<script>側の生成コードに追加)。
	   🔴 UI改善ラウンド28ユーザー指示(28-D3)「ステータスは相手ビルド領域の全幅を使う」により、
	   親を.damage-row-build-left(202px相当)からbuildEl(相手ビルド領域そのもの、321px相当)へ
	   変更した(<script>のrenderRow、buildEl.appendChild(evGrid)参照)。CSS自体は
	   width:100%(buildElへのstretch)がデフォルトで効くため変更不要。 */
	#opponent-notes-section .damage-ev-grid {
		display: grid;
		grid-template-columns: 3.4em repeat(6, minmax(0, 1fr));
		gap: 0.15rem 0.15rem;
		align-items: center;
		margin-top: 0.15rem;
	}
	#opponent-notes-section .damage-ev-row-label {
		/* 20-G3: 0.66rem(10.6px)→0.76rem(12.16px、12px下限を満たす)。
		   ラウンド26ユーザー指示(26-D4)「相手ビルドの種族名以外の文字が小さい」により
		   0.76rem→0.86rem(13.76px、+1.6px)へさらに一段上げる。 */
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	#opponent-notes-section .damage-ev-col-label {
		/* 20-G3: 0.68rem(10.9px)→0.76rem(12.16px、12px下限を満たす)。
