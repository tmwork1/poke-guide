---
import '../../styles/stat-adjust-sheet.css';
---

<div id="stat-adjust-sheet" class="stat-adjust-sheet">
	<div class="stat-adjust-sheet-handle-row">
		<span id="stat-adjust-sheet-remaining" class="stat-adjust-sheet-remaining tnum"></span>
	{/* つまみ行。展開中は左端に「残りXX」(努力値の残数)、中央につまみ、右端に「耐久調整」を
	    並べる。閉じている間は中央のつまみだけを見せる(CSS側で左右を display:none)。
	    残数の更新は src/lib/box-id/stat-adjust-sheet.ts の updateRemainingDisplay()。 */}
	<button
		type="button"
		id="stat-adjust-sheet-toggle"
		class="stat-adjust-sheet-toggle"
		aria-label="ステータス調整"
		aria-expanded="false"
		aria-controls="stat-status-adjust-body"
	>
		<span class="stat-adjust-sheet-toggle-icon" aria-hidden="true">︿</span>
	</button>
		<button type="button" id="bulk-adjust-button" class="btn-control stat-adjust-sheet-bulk-adjust-button" disabled aria-label="守カードを追加すると耐久調整が使えます" title="守カードを追加すると耐久調整が使えます">耐久調整</button>
	</div>
	<div id="stat-status-adjust-body" class="stat-adjust-sheet-body"></div>
</div>

<script>
	import '../../lib/box-id/stat-adjust-sheet';
</script>
