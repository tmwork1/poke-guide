	#edit-form .field-grid > .field > .field-with-image,
	#edit-form .top-block-fields > .field > .field-with-image { flex: 1 1 auto; width: 100%; min-width: 0; }

	#edit-form #item.is-autofilled {
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 30%, transparent);
	}

	#edit-form .tera-dropdown-wrap { position: relative; width: 100%; }
	#edit-form .tera-dropdown-button {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem;
		width: 100%;
		min-height: 2.35rem;
		padding: 0.42em 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		cursor: pointer;
		font-size: var(--font-size-sm1);
		font-weight: 400;
		line-height: var(--line-height-snug);
		color: var(--color-text);
