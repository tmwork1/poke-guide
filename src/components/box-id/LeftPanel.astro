---
// 左サイド(ポケモン編集パネル、.panel-left)のテンプレート・scoped style・スクリプトを持つ
// コンポーネント。呼び出し元(box/[id].astro)は pokemon(SSRで取得済み、存在確認済み=非null)
// だけをpropsで渡す。
//
// スクリプト本体は src/lib/box-id/left-panel.ts に切り出してあり、下の<script>から
// 副作用importする(共有コア関数は src/lib/box-id/shared-core.ts 経由で left-panel.ts が使う)。
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { TERA_TYPES } from '../../lib/tera-types';
import SpeciesSelectDialog from './SpeciesSelectDialog.astro';
import '../../styles/move-picker-dialog.css';

interface Props {
	pokemon: OwnedPokemonRecord;
}
const { pokemon } = Astro.props;

// 能力値ラベルは全角表記(「素早さ」等)だとラベル列(最大幅)がスライダー列(最狭・操作対象)を
// 圧迫するため、表示上はH/A/B/C/D/Sの1文字表記に統一する(相手ビルド箱・/box一覧の
// STAT_LABELS = ["H","A","B","C","D","S"]と表記を揃える)。full(素早さ等の正式名称)は
// aria-label/titleに必ず残し、アクセシビリティ上「短縮表記だけになる」ことを避ける。
const STAT_LABELS: Array<{ key: string; label: string; short: string }> = [
	{ key: "hp", label: "HP", short: "H" },
	{ key: "atk", label: "攻撃", short: "A" },
	{ key: "def", label: "防御", short: "B" },
	{ key: "spa", label: "特攻", short: "C" },
	{ key: "spd", label: "特防", short: "D" },
	{ key: "spe", label: "素早さ", short: "S" },
];

const MOVE_SLOTS = [1, 2, 3, 4];

function statAt(values: number[] | undefined, index: number, fallback: number): number {
	return values && typeof values[index] === "number" ? values[index] : fallback;
}
---
<form
	id="edit-form"
	data-id={pokemon.id}
	data-level={pokemon.level ?? ""}
	data-tags={JSON.stringify(pokemon.tags)}
	data-nature={pokemon.nature ?? ""}
>
	<section class="panel panel-left">
		<div class="top-block">
			{/* 画像はいずれも初期状態が display:none で、読み込み成功時(onload)に表示する方式。
			    そのため loading="lazy" を付けてはいけない — display:none の画像は遅延読み込みの
			    対象外として一切fetchされず、onloadが永久に発火しないまま隠れ続ける。
			    実装: .top-block-icon自体をflexでjustify-content:centerにし、#species-icon-boxに
			    margin-inline:autoを与えて残り幅の中で中央寄せする。.top-block-icon-cornerは
			    flex: 0 0 auto の固定幅カラム(中身: 上=タイプバッジ、下=アイテム(画像+名前)+
			    テラス画像の2段)で、#species-icon-boxとの重なりはフレックスレイアウトが
			    自動的に回避する。 */}
			<div class="top-block-icon">
				<div id="species-icon-box" class="species-icon-box">
					<img id="species-sprite" class="species-sprite-img" width="72" height="72" alt="" style="display:none;" />
					<span id="species-sprite-fallback" class="sprite-fallback species-sprite-fallback-lg"></span>
				</div>
				<div class="top-block-icon-corner">
					{/* <script>のapplyTypeBadge()がtypes全件ぶんの<img>をこの空コンテナに動的に
					    追加する(複合タイプ種族はtypesが2件になるため、先頭要素だけ見ると
					    片方のタイプが欠落する。タイプ数は種族によって1〜2件で可変のため、
					    静的に<img>を並べず空コンテナにした)。.type-badge-inlineは
					    position:staticにするクラス。 */}
					<span id="species-type-badge" class="type-badge type-badge-multi type-badge-inline"></span>
					{/* #item-name-displayは読み取り専用の<span>で、#itemの値をそのまま反映する
					    だけ(保存経路は#item自体、buildPayloadは変えない。<script>の
					    updateItemNameDisplay参照)。item-image-badgeは通常フローの1項目として
					    アイテム名の隣に並べる。
					    .top-block-icon-info内は「1段目=アイテム(画像+名前)、2段目=テラスタイプ
					    画像(読み取り専用、下記#top-block-tera-image参照)」の縦2段構成。 */}
					<div class="top-block-icon-info">
						<div class="top-block-item-display">
							<span id="item-image-badge" class="item-image-badge" hidden>
								<img id="item-image" class="item-image" width="30" height="30" alt="" style="display:none;" />
							</span>
							<span id="item-name-display" class="item-name-display"></span>
						</div>
						{/* 読み取り専用の<img>(クリックしても開かない。値の選択はテラスタル選択
						    ボックス側で行う)。表示ロジックはapplyTeraImage()を再利用する
						    (<script>のrefreshTopBlockTeraImage参照。テラス未設定時は画像・
						    フォールバックとも隠れ、高さも詰まる)。 */}
						<img id="top-block-tera-image" class="top-block-tera-image" alt="" style="display:none;" />
						<span id="top-block-tera-image-fallback" class="top-block-tera-image-fallback" style="display:none;"></span>
					</div>
				</div>
			</div>

			{/* ラベル要素は使わずplaceholder + aria-labelにする(値が入るとplaceholderは
			    消えるが、値は短いことが多いため実運用上大きな問題にはならない)。aria-labelは
			    スクリーンリーダー対応のため必ず残す。.field/.field-controlはflexコンテナ
			    なのでlabel(1つ目の子)を無くしても崩れない(global.css参照)。 */}
			<div class="top-block-fields">
				<div class="field">
					<input
						id="species-name"
						type="text"
						autocomplete="off"
						value={pokemon.species_name}
						hidden
					/>
					<button
						type="button"
						id="species-select-trigger-button"
						class="species-select-trigger"
						aria-haspopup="dialog"
					>
						<span id="species-select-trigger-label" class="species-select-trigger-label">種族</span>
					</button>
				</div>
				<div class="field field-ability">
					<select id="ability" class="field-control" aria-label="特性" title={pokemon.ability_name ?? ""}>
						<option value={pokemon.ability_name ?? ""} selected>{pokemon.ability_name || "特性"}</option>
					</select>
				</div>
				<div class="field">
					<div class="field-with-image item-dropdown-wrap">
						<input id="item" type="text" list="item-list" autocomplete="off" aria-label="もちもの" value={pokemon.item_name ?? ""} title={pokemon.item_name ?? ""} hidden />
						<button
							type="button"
							id="item-dropdown-button"
							class="item-dropdown-button"
							aria-haspopup="listbox"
							aria-expanded="false"
						>
							<img id="item-dropdown-image" class="item-dropdown-image" alt="" style="display:none;" />
							<span id="item-dropdown-placeholder" class="item-dropdown-placeholder">もちものなし</span>
						</button>
						<div id="item-dropdown-panel" class="item-dropdown-panel" hidden>
							<input
								type="text"
								id="item-dropdown-search"
								class="item-dropdown-search"
								placeholder="もちもの名で絞り込み"
								aria-label="もちもの候補を絞り込み"
								autocomplete="off"
							/>
							<ul
								id="item-dropdown-list"
								class="item-dropdown-list"
								role="listbox"
								aria-label="もちものを選択"
							>
							</ul>
						</div>
					</div>
				</div>
				{/* テラスタルは特性の下に配置する(特性=行2左列のため、DOM順でここに置けば
				    2列グリッドの次のセル=行3左列に自然と収まる)。以前はレギュレーションで
				    対応世代を判定して隠していたが、レギュレーション属性の廃止に伴い常時表示する。 */}
				<div class="field field-tera" id="tera-field">
					<div class="field-with-image tera-dropdown-wrap">
						<select id="tera" aria-label="テラスタイプ" title="テラスタイプ" hidden>
							<option value="">テラスタルなし</option>
							{TERA_TYPES.map((t) => <option value={t} selected={pokemon.tera_type === t}>{t}</option>)}
						</select>
						<button
							type="button"
							id="tera-dropdown-button"
							class="tera-dropdown-button"
							aria-haspopup="listbox"
							aria-expanded="false"
						>
							<img id="tera-dropdown-image" class="tera-dropdown-image" alt="" style="display:none;" />
							<span id="tera-dropdown-placeholder" class="tera-dropdown-placeholder">テラスタルなし</span>
						</button>
						<ul
							id="tera-dropdown-list"
							class="tera-dropdown-list"
							role="listbox"
							aria-label="テラスタイプを選択"
							hidden
						>
						</ul>
					</div>
				</div>
			</div>
		</div>



		<div class="mobile-move-actions">
			<button type="button" class="mobile-move-toggle btn-control" aria-haspopup="dialog" aria-label="わざ選択を開く">
				<span class="mobile-edit-action-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
				<span class="mobile-edit-action-label">わざ選択</span>
			</button>
			<button
				type="button"
				class="mobile-speed-adjust-button btn-control"
				data-speed-adjust-trigger
				aria-label="すばやさ早見表を開く"
				title="すばやさ早見表を開く"
			>
				<span class="mobile-edit-action-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="m12 12 4-3"/></svg></span>
				<span class="mobile-edit-action-label">すばやさ調整</span>
			</button>
		</div>
		<div id="mobile-move-fields" class="field-grid move-fields-grid is-mobile-collapsed">
			{MOVE_SLOTS.map((slot, i) => (
				<div class="field">
					<div class="field-with-image move-input-group" data-move-slot={slot}>
						<span class="move-type-icon" hidden>
							<img alt="" width="20" height="20" />
						</span>
						<input
							id={`move-${slot}`}
							type="text"
							autocomplete="off"
							placeholder={`技${slot}`}
							aria-label={`技${slot}`}
							value={pokemon.move_names[i] ?? ""}
						/>
						<span class="move-drag-handle" aria-hidden="true" title="ドラッグして並べ替え"></span>
					</div>
				</div>
			))}
		</div>

		<div id="stat-adjustment-section" class="stat-adjustment-section">
			<div class="stat-table">
			<div class="stat-table-header">
				<span class="stat-table-header-label" aria-hidden="true"></span>
				<span class="stat-table-header-nature">
					<span
						id="nature-readout-value"
						aria-label="性格"
					>{pokemon.nature ?? ""}</span>
				</span>
				<span>種族値</span>
				<span class="stat-table-header-ev-label">努力値</span>
				<span class="stat-table-header-real-label">実数値</span>
			</div>
			<div class="stat-row stat-row-remaining">
				<span class="stat-row-label" aria-hidden="true"></span>
				<span class="stat-row-nature" aria-hidden="true"></span>
				<span class="stat-row-base tnum" aria-hidden="true"></span>
				<span class="stat-row-remaining-value">
					<span id="ev-remaining" class="ev-remaining tnum"></span>
				</span>
				<span class="stat-row-real-wrap">
					<span id="hp-16n-indicator" class="ev-remaining tnum"></span>
				</span>
			</div>
			{STAT_LABELS.map(({ key, label: statLabel, short: statShort }, i) => (
				<div class="stat-row">
					<span id={`nature-label-${key}`} class="stat-row-label" aria-label={statLabel} title={statLabel}>
						{statShort}
					</span>
					{key === "hp" ? (
						<span class="stat-row-nature" aria-hidden="true"></span>
					) : (
						<span class="stat-row-nature">
							<button
								type="button"
								id={`nature-toggle-${key}`}
								class="stat-nature-btn"
								data-nature-state="none"
								aria-label={`${statLabel}の性格補正`}
								title={`${statLabel}の性格補正を切り替える`}
							></button>
						</span>
					)}
					<span id={`base-${key}`} class="stat-row-base tnum">-</span>
					{/* 努力値の入力欄には可視ラベルが無い(左端の .stat-row-label は入力と紐づいていない)ため、
					    スライダー・数値入力の両方に aria-label で「どの能力の努力値か」を持たせる。 */}
					<div class="stat-input-controls">
						<div class="stat-ev-range-controls">
							<span class="number-stepper stat-ev-stepper">
								<button type="button" class="btn-ghost stat-ev-step-button" data-ev-target={`ev-${key}-range`} data-ev-step="-1" aria-label={`${statShort}の努力値を1減らす`}>−</button>
								<button type="button" id={`ev-${key}-picker`} class="number-stepper-value tnum" aria-haspopup="dialog" aria-expanded="false" aria-controls={`ev-${key}-options`} aria-label={`${statLabel}の努力値を選ぶ`}>{statAt(pokemon.evs, i, 0)}</button>
								<input
									id={`ev-${key}`}
									type="hidden"
									value={statAt(pokemon.evs, i, 0)}
								/>
								<button type="button" class="btn-ghost stat-ev-step-button" data-ev-target={`ev-${key}-range`} data-ev-step="1" aria-label={`${statShort}の努力値を1増やす`}>+</button>
								<div id={`ev-${key}-options`} class="number-stepper-picker" role="dialog" aria-label={`${statLabel}の努力値を選ぶ`} hidden>
									{Array.from({ length: 33 }, (_, value) => <button type="button" class="tnum" data-ev-value={value} aria-current={value === statAt(pokemon.evs, i, 0) ? "true" : undefined}>{value}</button>)}
								</div>
							</span>
							<input
								type="range"
								id={`ev-${key}-range`}
								min="0"
								max="32"
								step="1"
								aria-label={`${statLabel}の努力値(スライダー)`}
								value={statAt(pokemon.evs, i, 0)}
							/>
						</div>
					</div>
					<span class="stat-row-real-wrap">
						<span id={`stat-${key}`} class="stat-row-real stat-value tnum">-</span>
					</span>
				</div>
			))}
		</div>
		<p id="hp-fixed-note" class="hp-fixed-note" hidden>
			H(種族値1で固定): このポケモンはHPの種族値が1のため、努力値を振っても実数値は常に1のままです。
		</p>
		<div class="stat-adjust-actions">
			<button
				type="button"
				id="durability-index-button"
				class="btn-control stat-adjust-action-button"
				disabled
				aria-label="耐久最大化の候補を表示する"
				title="耐久最大化の候補を表示する"
			>
				<span class="stat-adjust-action-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m9 12 2 2 4-4"/></svg></span>
				<span class="stat-adjust-action-label">耐久最大化</span>
			</button>
			<button type="button" id="bulk-adjust-button" class="btn-control stat-adjust-action-button" disabled>
				<span class="bulk-adjust-button-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 4h-7"/><path d="M10 4H3"/><path d="M21 12h-9"/><path d="M8 12H3"/><path d="M21 20h-5"/><path d="M12 20H3"/><circle cx="12" cy="4" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="14" cy="20" r="2"/></svg></span><span class="bulk-adjust-button-label">耐久調整</span>
			</button>
			<button
				type="button"
				class="btn-control stat-adjust-action-button"
				data-speed-adjust-trigger
				aria-label="すばやさ早見表を開く"
				title="すばやさ早見表を開く"
			>
				<span class="stat-adjust-action-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="m12 12 4-3"/></svg></span>
				<span class="stat-adjust-action-label">すばやさ調整</span>
			</button>
		</div>
		</div>
		<div id="stat-adjustment-home" hidden></div>


		{/* 「その他の設定(レベル・タグ・ピン留め・共有)」は要件により廃止した。
		    ただし PUT /api/owned-pokemon/:id は全項目上書きの契約なので、送らないと
		    既存の値が消える。そのためSSRで読んだ値を data 属性に持たせ、自動保存の
		    ペイロードにそのまま載せ直す(下の <script> の buildPayload を参照)。 */}
		<textarea id="memo" class="memo-input" rows="3" placeholder="メモ" aria-label="メモ">{pokemon.memo ?? ""}</textarea>

		{/* 削除ボタン。以前はbox/[id].astro側でSSRし、mobile-edit-tabs.tsがJSで
		    #mobile-edit-actionsへ移設していたが、移設が終わるまでの一瞬ヘッダーより上に表示される
		    バグがあったため、最終的な表示位置(メモの下、画面幅いっぱいの横長ボタン)に直接置く。
		    アイコンはインラインSVGのゴミ箱(絵文字🗑はOS/フォントで見た目が変わるため定番デザインに
		    向かない)。誤操作の抑止は色を抑える代わりに既存のwindow.confirm()
		    (<script>のdeleteButtonクリックハンドラ)に委ねる。スタイルはsrc/styles/box-edit-page.cssの
		    #delete-button参照。 */}
		<div class="training-delete-actions">
			<button id="delete-button" class="btn-danger" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				削除
			</button>
		</div>

		<SpeciesSelectDialog />

	</section>
</form>
<style>
	/* UI刷新: 実数値の常時表示。性格補正は文字色で表現する(旧battle-assistant-svの表現を
	   踏襲。上昇=赤系、下降=青系、補正なしは既定色のまま)。--color-stat-up/--color-stat-downは
	   global.cssで定義し、CSSカスタムプロパティはAstroのスコープ属性に影響されず参照できる。 */
	#edit-form .field-control:not(:disabled):not(:placeholder-shown),
	#edit-form .field-control:not(:disabled):focus,
	#edit-form .stat-row input[type="number"]:not(:disabled),
	#edit-form .mobile-move-toggle:not(:disabled),
	#edit-form .btn-control:not(:disabled),
	#edit-form .memo-input:not(:disabled):not(:placeholder-shown),
	#edit-form .memo-input:not(:disabled):focus {
		background: var(--color-surface);
	}
	/* 薄い文字色でも判別しやすくするため、既存ウェイトの次段階へ上げる。 */
	.stat-value { display: inline-block; margin-top: 0.15em; font-size: var(--font-size-base); font-weight: 400; color: var(--color-text); }
	.stat-value[data-mod="up"] { color: var(--color-stat-up); }
	.stat-value[data-mod="down"] { color: var(--color-stat-down); }

	.stat-adjustment-section {
		/* 表の操作要素と下部アクションの端をそろえ、パネル端への張り付きを防ぐ。 */
		padding-inline-start: var(--stat-table-inline-start-padding);
		padding-inline-end: var(--stat-table-inline-end-padding);
	}
	.stat-table { display: flex; flex-direction: column; gap: var(--stat-table-gap); }
	.stat-table-header {
		display: grid;
		align-items: center;
		grid-template-columns: var(--stat-grid-template-columns);
		gap: var(--stat-column-gap);
		/* UI統一感レビュー(32-U-B1): 同じ行内の.ev-remaining(「残りN」)が持つ
		   共通トークンvar(--font-size-sm3)(12px)に対し、ここだけ直値0.78rem(12.48px)
		   だった。共通トークンを持つ側を基準に寄せる(太さ600/700の差は階層差として維持)。 */
		font-size: var(--font-size-sm3);
		font-weight: 600;
		color: var(--color-text-muted);
		padding: var(--stat-header-padding);
		margin-bottom: var(--stat-header-margin-bottom);
		border-bottom: 1px solid var(--color-border);
	}
	/* 「努力値」ラベルと「残りN」カウンターは、EV列(努力値の実際の操作UIと同じ1列)に
	   一緒に収める。列を分けていた頃の名残でクラス名にev-labelが残るが、実体は
	   このヘッダーセル1つで努力値列全体を表す。 */
	.stat-table-header-ev-label {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.35em;
	}
	.stat-table-header-real-label {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.stat-table-header-nature {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
	}
	.stat-table-header-nature > span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.stat-table-header > span { text-align: center; }
	.stat-row {
		display: grid;
		grid-template-columns: var(--stat-grid-template-columns);
		align-items: center;
		gap: var(--stat-column-gap);
	}
	/* 努力値のスライダーと数値入力は1つの列に収める。これにより、ラベル・性格補正・
	   種族値・努力値・実数値の5列が常に同じ間隔で並び、残り努力値も数値入力の直上に揃う。 */
	.stat-row .stat-input-controls {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--stat-control-gap);
		min-width: 0;
	}
	.stat-row:not(.stat-row-remaining) .stat-row-real-wrap {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-width: 0;
	}
	/* 36pxへ拡大した端点ボタン2個を380px程度の左パネル内へ収めるため、rangeの最小幅も
	   5rem(80px)から3.5rem(56px)へ下げ、固定グリッドの3列目から溢れないようにする。 */
	.stat-ev-range-controls { display: flex; align-items: center; gap: var(--stat-control-gap); min-width: 0; }
	.stat-ev-range-controls input[type="range"] { flex: 1 1 var(--stat-range-min-width); min-width: var(--stat-range-min-width); }
	.stat-ev-endpoint-button { flex: 0 0 var(--stat-endpoint-button-size); width: var(--stat-endpoint-button-size); height: var(--stat-endpoint-button-size); min-height: var(--stat-endpoint-button-size); padding: 0; border-color: transparent; }
	/* 端点操作は性格補正色と競合させず、淡色トークンの二重山形で示す。 */
	.stat-ev-endpoint-button { color: var(--color-text-muted); }
	.stat-ev-endpoint-button svg { width: 1.25em; height: 1.25em; transition: transform 0.2s; }
	.stat-ev-endpoint-button[data-ev-endpoint="min"] svg { transform: rotate(180deg); }
	.stat-ev-step-button {
		display: none;
		flex: 0 0 var(--stat-step-button-size);
		width: var(--stat-step-button-size);
		height: var(--stat-step-button-size);
		min-height: var(--stat-step-button-size);
		padding: 0;
		font-size: var(--font-size-sm2);
		font-weight: 700;
		line-height: 1;
	}
	/* モバイル専用の努力値操作。スライダーは値保持・同期用のDOMとして残しつつ非表示にし、
	   DOM順(0ボタン→-→スライダー→+→32ボタン、LeftPanel.astro本体側コメント参照)を使って
	   「0 / - / + / 32」のボタン操作を常時表示する。 */
	.stat-row .stat-ev-range-controls input[type="range"] { display: none; }
	.stat-row .stat-ev-step-button { display: inline-flex; }
	.stat-row .stat-input-controls { display: flex; align-items: center; justify-content: flex-end; gap: calc(var(--space-1) + 1px); min-width: 0; grid-column: 4; }
	.stat-row .stat-ev-range-controls { gap: var(--stat-control-gap); }
	.stat-row .stat-ev-step-button[data-ev-step="-1"] { order: 2; }
	/* 基底の .stat-row input[type="number"] は width:100% なので、flex行に置くと
	   余った横幅を全部吸って左右のボタンが両端へ離れてしまう(実測、700px幅)。
	   4ボタンと1つのまとまりに見えるよう固定幅にして、行ごと中央へ寄せる
	   (.stat-input-controls の justify-content: center)。 */
	.stat-row .stat-input-controls > input[type="number"] { order: 3; flex: 0 0 var(--stat-number-input-width); width: var(--stat-number-input-width); }
	.stat-row .stat-input-controls > input[type="number"] {
		height: var(--stat-number-input-height);
		min-height: var(--stat-number-input-height);
		padding: var(--stat-number-input-mobile-padding);
		line-height: 1;
	}
	/* 残り努力値は、操作群の中央にある数値ボタンの真上へ揃える。 */
	.stat-row-remaining .stat-row-remaining-value {
		justify-content: center;
		padding-inline-end: 0;
	}
	.stat-row .stat-ev-step-button[data-ev-step="1"] { order: 4; }
	.stat-row .stat-ev-endpoint-button[data-ev-toggle] { order: 5; }
	/* わざ選択と同じsurfaceを下地にし、端点・増減操作を控えめに浮かせる。
	   端点ボタン(»アイコンのみ)と増減ボタン(-/+)は同じ役割の並びなので等幅の正方形にする。 */
	.stat-row .stat-ev-endpoint-button,
	.stat-row .stat-ev-step-button {
		box-sizing: border-box;
		flex: 0 0 var(--stat-ev-mobile-button-block-size);
		width: var(--stat-ev-mobile-button-block-size);
		min-width: var(--stat-ev-mobile-button-block-size);
		height: var(--stat-ev-mobile-button-block-size);
		min-height: var(--stat-ev-mobile-button-block-size);
		padding: 0;
		color: var(--color-text-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-zero);
		box-shadow: var(--shadow-sm);
		font-size: var(--font-size-sm1);
		font-weight: 400;
	}
	.stat-ev-toggle-spacer { display: none; }
	/* 努力値の数値入力も左パネル用の詰めた寸法に揃える(6行あるので効き方が大きい)。 */
	.stat-row input[type="number"] { font-size: var(--font-size-sm1); padding: 0.3em 0.5em; width: 100%; text-align: center; }
	.stat-row input[type="range"] { width: 100%; }
	.stat-row input[type="range"]:focus {
		outline: none;
	}
	.stat-row input[type="range"]:focus-visible::-webkit-slider-thumb {
		outline: none;
	}
	.stat-row input[type="range"]:focus-visible::-moz-range-thumb {
		outline: none;
	}
	/* 色トークンは維持し、ラベルだけ既存ウェイトの次段階へ上げて読みやすくする。
	   ラベル列は5列構成(ラベル|性格補正|種族値|努力値|実数値)の1列目単独になったため、
	   性格補正ボタンを収めていた頃のgap/margin-inlineは不要になった。 */
	.stat-row-label { font-weight: var(--stat-label-font-weight); white-space: nowrap; display: flex; align-items: center; justify-content: center; line-height: var(--stat-row-label-line-height); }
	.stat-row-label[data-mod="up"] { color: var(--color-stat-up); }
	.stat-row-label[data-mod="down"] { color: var(--color-stat-down); }
	.stat-row-base { color: var(--color-text-muted); text-align: right; }
	.stat-row-real-wrap { display: contents; align-items: center; justify-content: center; gap: var(--space-1); min-width: 0; }
	.stat-row-real {
		padding-inline-end: var(--space-1);
		text-align: right;
		font-size: var(--font-size-base);
		margin-top: 0;
	}
	.hp-fixed-note {
		margin: var(--space-1) 0 0;
		font-size: var(--font-size-sm3);
		color: var(--color-text-muted);
	}

	.stat-adjust-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: var(--space-2);
		margin: 0.6rem 0 0;
	}
	.stat-adjustment-section { font-size: var(--font-size-sm1); }
	/* ボタン本体は.btn-ghost(global.css、透明背景+ホバーでsurfaceとprimaryの混色)をそのまま使う。パネル幅に
	   対して「耐久指数最大化」(7文字)を含む3ボタンが横並びで収まるよう、.btn-ghostの既定
	   (padding: var(--space-2) 1.1em、font-size: 継承=1rem)より一段階詰めた既存トークンの組み
	   合わせに絞る(新しい値ではなく、旧.stat-adjust-button等でも使っていたvar(--font-size-sm2)/
	   var(--space-1)/var(--space-2)を再利用)。flex: 1 1 auto + flex-wrap: wrapで、3つ全体が
	   収まらない狭幅では自然に折り返す(テキストが見切れることを避ける)。 */
	.stat-adjust-action-button {
		flex: 1 1 auto;
		justify-content: center;
		min-height: 40px;
		gap: 0.35em;
		font-size: var(--font-size-sm1);
		padding: var(--space-1) var(--space-2);
		white-space: nowrap;
		/* 共通buttonの強めのウェイトを一段細くし、補助操作としての階層に合わせる。 */
		font-weight: 400;
	}
	/* わざ選択ボタンと同じ.btn-controlを付与しているため、背景・枠線・文字色・ホバー色は
	   共通ルール(src/styles/buttons.css)から同じ算出値になる。 */
	/* box/[id].astroのトップバーにあった#bulk-adjust-buttonが持っていた「アイコンspan+ラベルspanを
	   inline-flexで縦位置中央揃えにする」パターン(インラインSVGは既定でbaseline基準の余白が乗り、
	   隣のラベルテキストと縦位置がズレるための対策)を、新設の.stat-adjust-action-iconにも同じ
	   考え方で適用する。.bulk-adjust-button-icon(既存クラス、bulk-adjust.ts参照)はここへ移設した
	   ことで見た目の親(.stat-adjust-action-button)が変わるため、同じ整列ルールをここでも定義する
	   (box/[id].astro側の定義はそちらのファイルのスコープにしか効かないため引き継がれない)。 */
	.stat-adjust-action-icon,
	.bulk-adjust-button-icon {
		display: inline-flex;
		align-items: center;
	}
	/* 実図形に詰めた横長viewBoxでは隣の正方形アイコンより間延びして見えるため、
	   図形自体が正方形の枠を縦にも使うゲージにし、3つの操作アイコンの大きさを揃える。 */
	.bulk-adjust-button-icon svg {
		width: 16px;
		height: 16px;
		vertical-align: middle;
	}
	/* モバイル専用では、このテンプレート上の操作群はJSがツールバーへ再配置するため常時非表示にする。 */
	.stat-adjust-actions { display: none; }

	@media (max-width: 460px) {
		.stat-table-header { display: none; }
		/* 努力値ボタンは常に固定サイズ(--stat-ev-mobile-button-block-size)を保つため、
		   列幅がボタンの必要幅を下回る画面では行ごと実数値列へオーバーラップしていた
		   (minmax(0, 1fr)が列を0まで潰せたため)。列の下限をボタンの実寸(max-content)に
		   固定して重なりを止め、それでも収まらない極端な狭幅では行を横スクロールさせる
		   (ボタンを縮めない)。 */
		.stat-table { overflow-x: auto; }
		.stat-row { grid-template-columns: var(--stat-mobile-row-grid-template-columns); row-gap: var(--stat-mobile-row-gap); min-width: max-content; }
		.stat-row-remaining .stat-row-remaining-value {
			grid-column: var(--stat-mobile-input-grid-column);
		}
		/* 460px以下では努力値のボタン行(0/-/+/32)+数値入力を1つのflex行にまとめる
		   (デスクトップの5列グリッドは幅が無いと成立しないため)。 */
		.stat-row .stat-input-controls { display: flex; align-items: center; justify-content: flex-end; gap: calc(var(--stat-control-gap) + 1px); min-width: 0; grid-column: var(--stat-mobile-input-grid-column); }
		/* 390px級の実機幅では 0/−/数値/+/32 の5要素が1行に収まりきらないため、
		   ボタンの最小幅だけ 30px → 26px(WCAG 2.5.8の24px下限は満たす)へ詰める。 */
		.stat-row .stat-ev-endpoint-button,
		.stat-row .stat-ev-step-button { min-width: var(--stat-ev-mobile-button-block-size); }
		.stat-row .stat-input-controls input[type="number"] { flex: 0 0 var(--stat-number-input-width); width: var(--stat-number-input-width); }
	.stat-row-real-wrap { display: flex; grid-column: var(--stat-mobile-real-grid-column); justify-content: flex-end; min-width: 0; }
		.stat-row-base,
		.stat-row-real { padding-inline-end: 0; text-align: right; font-weight: 400; }
	}


	.panel-left {
		background: var(--color-bg);
		padding-top: 1rem;
	}

	.species-icon-box {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 176px;
		height: 176px;
		border-radius: var(--radius-md);
		background: transparent;
		flex-shrink: 0;
	}
	/* 画像の描画寸法を保ったまま上下の空白だけを約30%減らす必要があるため、箱の横幅は
	   176pxのまま、高さだけを142px+上下12px=166pxへ詰める。 */
	#species-icon-box { height: 166px; }
	/* 現在値158pxの90%=142.2pxを整数化。 */
	.species-sprite-img { width: 142px; height: 142px; object-fit: contain; }
	/* フォールバック(画像取得失敗時の代替表示)も本体画像と同じ1.1倍率で拡大し、
	   本体と入れ替わっても箱内のサイズ感が変わらないようにする。 */
	.species-sprite-fallback-lg { width: 142px; height: 142px; font-size: 3.2rem; }

	.top-block { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.4rem; }
	.top-block-fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.4rem 0.6rem;
		width: 100%;
	}

	#edit-form .top-block-fields .field { margin: 0; }

	/* 種族の右の空きも使い、種族・特性 / アイテム・テラスタルの2段に並べる。 */

	/* [hidden] は display:flex を持つ .field(global.css)に詳細度で負けるため明示する
	   (pitfalls.md「[hidden]が効かない」)。 */
	#edit-form .top-block-fields > .field[hidden] { display: none; }

	#edit-form .top-block-fields .field > input.field-control,
	#edit-form .top-block-fields .field > select.field-control {
		min-width: 0;
		width: 100%;
		min-height: 2.35rem;
		margin: 0;
		font-size: var(--font-size-sm1);
		padding: 0.42em 0.6em;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	#edit-form .top-block-fields .field > select.field-control {
		min-height: 2.35rem;
	}

	#edit-form .top-block-fields .field > select.field-control:hover,
	#edit-form .top-block-fields .field > select.field-control:focus,
	#edit-form .top-block-fields .field > select.field-control:focus-visible {
		background-image: none;
	}

	#edit-form .field-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.4rem 0.4rem;
		margin-bottom: var(--space-2);
	}
	#edit-form .field-grid > .field { margin: 0; }
	#edit-form .field-grid.move-fields-grid {
		margin-top: var(--space-3);
		margin-bottom: var(--space-4);
	}
	/* 2列に詰めたぶん1つあたりの幅が狭いので、この左パネル内だけ文字と余白を少し詰めて
	   「ブーストエナジー」「こだいかっせい」クラスの長さが枠内に収まるようにする。 */
	#edit-form .field-grid .field-with-image > input,
	#edit-form .field-grid .field-with-image > select,
	#edit-form .top-block-fields .field-with-image > input,
	#edit-form .top-block-fields .field-with-image > select {
		min-width: 0;
		width: 100%;
		margin: 0;
		font-size: var(--font-size-sm1);
