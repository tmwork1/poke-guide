	}

	#edit-form .tera-dropdown-wrap { position: relative; width: 100%; }
	#edit-form .tera-dropdown-button {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem;
		width: 100%;
		min-height: 2.35rem;
		padding: 0.42em 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		cursor: pointer;
		font-size: var(--font-size-sm1);
		font-weight: 400;
		line-height: var(--line-height-snug);
		color: var(--color-text);
		text-align: left;
	}
	@media (hover: hover) and (pointer: fine) {
		#edit-form .tera-dropdown-button:hover { border-color: var(--color-primary); }
	}
	#edit-form .tera-dropdown-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}
	#edit-form .tera-dropdown-image { width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; }
	#edit-form .tera-dropdown-placeholder {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--color-text-muted);
	}
	#edit-form .tera-dropdown-placeholder.is-tera-value-text { color: var(--color-text); }
	#edit-form .tera-dropdown-placeholder[hidden] { display: none; }
	/* リストボックス: ボタン直下に開く。19タイプ+テラスなしの20項目を縦スクロールで収める。 */
	#edit-form .tera-dropdown-list {
		position: absolute;
		top: calc(100% + 0.25rem);
		left: 0;
		right: 0;
		z-index: 5;
		margin: 0;
		padding: var(--space-1);
