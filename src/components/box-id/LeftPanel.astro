	/* ⚠️ .tera-dropdown-option/.tera-dropdown-option-image/.tera-dropdown-option-text は
	   <script>のbuildTeraDropdownがdocument.createElement()で動的生成する要素(<li>/<img>/
	   <span>)なので、このscoped <style>は一切効かない(pitfalls.md「Astroのscoped styleは
	   JSで生成した要素に効かない」参照。data-astro-cid-*が付かないため)。実際のスタイルは
	   box/[id].astro側の<style is:global>に定義する(#species-type-badge .type-badge-fallbackの
	   直後)。 */

	#edit-form .item-dropdown-wrap { position: relative; width: 100%; }
	#edit-form .item-dropdown-button {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem;
		width: 100%;
		min-height: 2.35rem;
		padding: 0.42em 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		cursor: pointer;
		font-size: var(--font-size-sm1);
		font-weight: 400;
		line-height: var(--line-height-snug);
		color: var(--color-text);
		text-align: left;
	}
	@media (hover: hover) and (pointer: fine) {
		#edit-form .item-dropdown-button:hover { border-color: var(--color-primary); }
	}
	#edit-form .item-dropdown-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}
	/* メガシンカ中は持ち物をメガストーンに固定するため操作不能にする(applyLeftMegaStoneAutofill
