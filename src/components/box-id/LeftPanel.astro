---
// box/[id].astro 構造分割ラウンド(フェーズ1)。
// 左サイド(ポケモン編集パネル、.panel-left)のテンプレート・scoped style・スクリプトを
// src/pages/box/[id].astro から切り出したコンポーネント。見た目・ロジックは一切変更していない
// (定義位置の移動のみ)。呼び出し元(box/[id].astro)は pokemon(SSRで取得済みの個体データ、
// 存在確認済み=非null)だけをpropsで渡す。
//
// スクリプト本体は src/lib/box-id/left-panel.ts に切り出してあり、下の<script>から
// 副作用importする(共有コア関数は src/lib/box-id/shared-core.ts 経由で left-panel.ts が使う)。
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import { TERA_TYPES } from '../../lib/tera-types';

interface Props {
	pokemon: OwnedPokemonRecord;
}
const { pokemon } = Astro.props;

// ラウンド12指摘(A-3): 能力値ラベルは全角表記(「素早さ」等)だとラベル列(最大幅)が
// スライダー列(最狭・操作対象)を圧迫していたため、表示上はH/A/B/C/D/Sの1文字表記に
// 統一する(相手ビルド箱・/box一覧のSTAT_LABELS = ["H","A","B","C","D","S"]と表記を揃える。
// 統一感の要件でもある)。full(素早さ等の正式名称)はaria-label/titleに必ず残し、
// アクセシビリティ上「短縮表記だけになる」ことを避ける。
const STAT_LABELS: Array<{ key: string; label: string; short: string }> = [
	{ key: "hp", label: "HP", short: "H" },
	{ key: "atk", label: "攻撃", short: "A" },
	{ key: "def", label: "防御", short: "B" },
	{ key: "spa", label: "特攻", short: "C" },
	{ key: "spd", label: "特防", short: "D" },
	{ key: "spe", label: "素早さ", short: "S" },
];

const MOVE_SLOTS = [1, 2, 3, 4];

function statAt(values: number[] | undefined, index: number, fallback: number): number {
	return values && typeof values[index] === "number" ? values[index] : fallback;
}
---
<form
	id="edit-form"
	data-id={pokemon.id}
	data-level={pokemon.level ?? ""}
	data-tags={JSON.stringify(pokemon.tags)}
	data-pinned={String(pokemon.is_pinned)}
	data-nature={pokemon.nature ?? ""}
>
	<section class="panel panel-left">
		<div class="top-block">
			{/* UI改善ラウンド26ユーザー指示(26-L2)「今のポケモンアイコンサイズのまま、
			    アイコン領域を全幅に拡大。タイプ画像、アイテム画像+アイテム名、テラスタイプ画像を
			    余裕をもって配置する。もともとアイコン横に配置していた入力欄は下に移動。」
			    .top-block-icon(アイコン領域)を.top-block-fields(種族/ニックネーム/特性/性格)
			    と横並びだった2カラム構成から、アイコン領域を上段・入力欄を下段に積む縦2段構成に
			    変える(横並び2カラム→縦積み2段。アイコン自体のサイズ=.species-icon-box
			    160px/144pxは変えない)。画像はいずれも初期状態が display:none で、読み込み成功時
			    (onload)に表示する方式。そのため loading="lazy" を付けてはいけない —
			    display:none の画像は遅延読み込みの対象外として一切fetchされず、onloadが
			    永久に発火しないまま隠れ続ける。
			    🔴 UI改善ラウンド28ユーザー指示(28-L1)「ポケモン画像が帯の左半分に配置されているが、
			    帯の全幅を使って中央配置する」により、ラウンド27(27-H1)の「中央寄せゾーン
			    (.top-block-icon-center、flex:1)+右コーナー列(.top-block-icon-corner、
			    flex:0 0 auto)」の2分割flexを撤回する。27-H1が絶対配置を避けた理由(種族アイコン
			    160px+テラスドロップダウン170px+アイテム表示分がコンテナ幅約400pxの中で
			    重なる恐れ)は、28-L4でテラスドロップダウンを帯の外(下の.field-grid-single、
			    持ち物入力欄の右)へ出したことで解消した。帯に残るのはタイプバッジ・アイテム
			    表示・テラス画像(読み取り専用、28-L2)だけになり必要幅が大きく減るため、
			    絶対配置のオーバーレイを使っても実測上重ならない(検証時にgetBoundingClientRect
			    で必ず確認する)。
			    実装: .top-block-icon自体をflexでjustify-content:centerにし、#species-icon-box
			    (もう.top-block-icon-centerで包まない)を直接の子にして帯の全幅に対して
			    中央寄せする。.top-block-icon-corner はposition:absoluteでinset-block:0; right:0の
			    オーバーレイにし、通常フローから外すことで中央寄せの計算に一切影響しないように
			    する(中身: 上=タイプバッジ、下=アイテム(画像+名前)+テラス画像の2段、
			    28-L2)。 */}
			<div class="top-block-icon">
				<div id="species-icon-box" class="species-icon-box">
					<img id="species-sprite" class="species-sprite-img" width="72" height="72" alt="" style="display:none;" />
					<span id="species-sprite-fallback" class="sprite-fallback species-sprite-fallback-lg"></span>
				</div>
				<div class="top-block-icon-corner">
					{/* ラウンド3 B-6: 以前はtypes配列の先頭(types?.[0])しか見ておらず、複合タイプ
					    (例: メガリザードンX=ほのお/ドラゴン)が単一タイプとして表示されていた。
					    <script>のapplyTypeBadge()がtypes全件ぶんの<img>をこの空コンテナに
					    動的に追加する(タイプ数は種族によって1〜2件で可変のため、静的に
					    <img>を並べず空コンテナにした)。ラウンド21(21-L1)で横並びに変更。
					    ラウンド26ユーザー指示(26-L2)により、種族アイコン右上の重ね表示(絶対配置)
					    から、アイコン脇に並ぶ通常フローの1項目へ移した。position:staticにする
					    .type-badge-inline(23-L3で導入して以後どこからも参照されていなかった
					    クラス。position:staticという効果がそのまま使えるため新規クラスを作らず
					    再利用する)を追加する。ラウンド28ユーザー指示(28-L2)により、この
					    コーナー列(top-block-icon-corner、28-L1で絶対配置のオーバーレイに変更)の
					    先頭=右上に置く。 */}
					<span id="species-type-badge" class="type-badge type-badge-multi type-badge-inline"></span>
					{/* ラウンド26ユーザー指示(26-L2)「アイテム画像+アイテム名(テキスト)を余裕を
					    もって配置する」。アイテム名の文字表示はこれまで#item入力欄(下の.field-grid内)
					    にしか無かった(新規の表示要素)。#item-name-displayは読み取り専用の<span>で、
					    #itemの値をそのまま反映するだけ(保存経路はこれまでどおり#item自体、
					    buildPayloadは変えない。<script>のupdateItemNameDisplay参照)。
					    ラウンド21ユーザー指示(21-L2)由来のアイテム画像バッジ(#item-image-badge)は、
					    以前は種族アイコンの右下に重ねる絶対配置(親の.top-block-icon-sub、
					    position:absolute)だったが、このアイコン領域が全幅になり重ねる必要が
					    無くなったため、通常フローの1項目としてアイテム名の隣に並べる
					    (.top-block-icon-sub自体は廃止。item-image-badge自体はposition:absoluteを
					    持たないクラスなのでそのまま使い回せる)。
					    🔴 UI改善ラウンド28ユーザー指示(28-L2)「タイプアイコンは右上、アイテム
					    (画像+名前)とテラスタイプ(画像)は上下に重ねて右下に配置」により、この
					    .top-block-icon-info(既存クラス)をコーナー列の下側に置く(タイプバッジと
					    縦に並ぶ)構成は維持しつつ、中身を「1段目=アイテム(画像+名前)、
					    2段目=テラスタイプ画像(読み取り専用、下記#top-block-tera-image参照)」の
					    縦2段にする。旧26-L2で同居していたテラスタル選択ボックス(#tera-dropdown-*)は
					    28-L4で下の.field-grid-single(持ち物入力欄の右)へ移設した。 */}
					<div class="top-block-icon-info">
						<div class="top-block-item-display">
							<span id="item-image-badge" class="item-image-badge" hidden>
								<img id="item-image" class="item-image" width="30" height="30" alt="" style="display:none;" />
							</span>
							<span id="item-name-display" class="item-name-display"></span>
						</div>
						{/* UI改善ラウンド28ユーザー指示(28-L2)「テラスタイプ(画像)は…上下に重ねて
						    右下に配置」。読み取り専用の<img>(クリックしても開かない。値の選択は
						    28-L4で移設したテラスタル選択ボックス側で行う)。表示ロジックは
						    applyTeraImage()を再利用する(<script>のrefreshTopBlockTeraImage参照。
						    テラス未設定時は画像・フォールバックとも隠れ、高さも詰まる)。 */}
						<img id="top-block-tera-image" class="top-block-tera-image" alt="" style="display:none;" />
						<span id="top-block-tera-image-fallback" class="top-block-tera-image-fallback" style="display:none;"></span>
					</div>
				</div>
			</div>

			{/* ラウンド5ユーザー指示: ラウンド3 A-8で「横並びラベルに統一」したのを撤回し、
			    ラベル要素を廃止してplaceholder + aria-labelに戻す(値が入ると何の欄か
			    分からなくなるという第4弾ラウンド4の指摘は、値が短いうちは placeholder が
			    透けて見えるので実運用上大きな問題にならないというユーザー判断)。
			    aria-labelはスクリーンリーダー対応のため必ず残す。.field/.field-controlは
			    flexコンテナなのでlabel(1つ目の子)を無くしても崩れない(global.css参照)。 */}
			{/* ラウンド17指摘(B-4)で「種族→ニックネーム→特性」から「種族→特性→ニックネーム」に
			    入れ替えていたが、ラウンド21ユーザー指示(21-L3)「ニックネームは種族名の下に
			    配置する」により再度「種族→ニックネーム→特性」へ戻す(ユーザー指示のため
			    ラウンド17の判断を撤回。順序を変えるだけで#nickname/#abilityのid・
			    textInputIds/buildPayloadの参照は一切変えていない)。
			    ラウンド26ユーザー指示(26-L2)により、この入力欄一式(.top-block-fields)は
			    アイコン領域(.top-block-icon)の下段に移動した(横並び2カラム→縦積み2段。
			    空いた全幅を活かすため2列グリッドに詰める。#species-name/#nickname/#ability/
			    #nature-readout-valueのid・値・保存経路は一切変えていない)。 */}
			<div class="top-block-fields">
				<div class="field">
					<input
						id="species-name"
						class="field-control"
						type="text"
						list="pokemon-list"
						autocomplete="off"
						required
						autofocus
						placeholder="種族"
						aria-label="種族"
						value={pokemon.species_name}
					/>
				</div>
				<div class="field">
					<input id="nickname" class="field-control" type="text" autocomplete="off" placeholder="ニックネーム" aria-label="ニックネーム" value={pokemon.nickname ?? ""} />
				</div>
				<div class="field">
					{/* ラウンド21ユーザー指示(21-L5)「特性はそのポケモンに属する特性だけを候補と
					    する選択ボックスにする」により<input list=...>から<select>へ置き換える。
					    <script>のrebuildAbilityOptions()が種族確定後にloadAbilitiesMap()から
					    候補を作り直すため、SSR側はpokemon.ability_nameを唯一の<option>として
					    仮置きするだけでよい(JS初期化直後にすぐ置き換わる)。#ability-list
					    datalist自体は右パネル(相手ビルド)がまだ使うため削除しない。 */}
					<select id="ability" class="field-control" aria-label="特性" title={pokemon.ability_name ?? ""}>
						<option value={pokemon.ability_name ?? ""} selected>{pokemon.ability_name || "特性"}</option>
					</select>
				</div>
				<div class="field">
					{/* ラウンド23ユーザー指示(23-L2)「性格は、特性の下に入力ボックスを配置する。
					    ただし入力不可にしておき自動決定の仕組みを続投。」ラウンド21(21-L4)は
					    「<input readonly>にしない、操作できる部品に見えると疑問を生む」と
					    明記していたが、今回はユーザーが逆(readonlyの入力ボックスにする)を
					    明示的に指示しているためユーザー指示を優先し、21-L4の判断を撤回する。
					    disabledではなくreadonlyにする(disabledはフォーム送信対象から外れ、
					    見た目も薄くなりすぎるため)。なぜ編集できないかはtitleの注記で伝える
					    (21-L4の懸念=「なぜ押せないのか分からない」をここで緩和する)。
					    自動決定の仕組み(currentLeftNature()/refreshNatureButtons())は一切
					    変えない。保存ペイロード(buildPayload)はcurrentLeftNature()から
					    直接性格名を取っており、この<input>の値は保存に使わない
					    (二重管理を避ける。<script>もvalueをセットするだけでchange/input
					    リスナーは登録しない)。 */}
					<input
						id="nature-readout-value"
						class="field-control"
						type="text"
						readonly
						tabindex={-1}
						aria-label="性格(能力値の上下選択から自動的に決まります。ここでは編集できません)"
						title="能力値のA/B/C/D/Sラベルの▲▼から自動的に決まります。ここでは編集できません。"
						placeholder="性格"
					/>
				</div>
			</div>
		</div>

		{/* ラウンド5ユーザー指示: ラベル要素は撤去しplaceholder + aria-labelに統一する。
		    ラウンド11(11-2): アイテム画像は種族アイコンへ移設済みで、ここには入力欄のみを残す。
		    🔴 UI改善ラウンド28ユーザー指示(28-L4)「テラスタル選択ボックスはアイテム入力欄の
		    右側に配置」により、ラウンド26(26-L2)「テラスタイプ画像(カスタムドロップダウン)を
		    アイコン領域内に移設する」を撤回する(ラウンド25で入力行にあった状態に戻す形になる。
		    帯の中央配置(28-L1)の邪魔になっていたことと、ユーザーが入力欄として扱いたい意図の
		    両方が理由)。#tera(<select>)+#tera-dropdown-*一式(ウィジェットのロジック=開閉・選択・
		    保存は<script>のbuildTeraDropdown参照、一切変えていない)を、この行(持ち物入力欄)の
		    右側へ移動する。IDは変えていない、DOM上の位置だけが変わった。この行は持ち物+テラスの
		    2列になるため、.field-grid-single(クラス名はそのまま維持)を2列グリッドに戻す
		    (下のCSS参照。列幅は.top-block-fields/.move-fields-gridと同じ.field-gridの基本定義
		    repeat(2, minmax(0, 1fr))に揃う)。 */}
		<div class="field-grid field-grid-single">
			<div class="field">
				<div class="field-with-image">
					<input id="item" type="text" list="item-list" autocomplete="off" placeholder="持ち物" aria-label="持ち物" value={pokemon.item_name ?? ""} title={pokemon.item_name ?? ""} />
				</div>
			</div>
			<div class="field">
				{/* UI改善ラウンド28ユーザー指示(28-L4)により、旧.top-block-icon-info内にあった
				    テラスタル選択ボックス一式をここへ移設した(マークアップはラウンド25(25-L2)当時と
				    ほぼ同じ、.top-block-tera-wrap(帯専用の固定幅170pxオーバーライド)は不要になった
				    ため外した)。ボタンの中身は28-G1で専用アイコン(正方形)に変わったことに伴い、
				    アイコン+テラスタイプ名のテキストを並べる形にする(<script>のupdateTeraDropdownButton
				    参照。未設定時は従来どおり「テラスなし」のplaceholder)。 */}
				<div class="field-with-image tera-dropdown-wrap">
					<select id="tera" aria-label="テラスタイプ" title="テラスタイプ" hidden>
						<option value="">テラスなし</option>
						{TERA_TYPES.map((t) => <option value={t} selected={pokemon.tera_type === t}>{t}</option>)}
					</select>
					<button
						type="button"
						id="tera-dropdown-button"
						class="tera-dropdown-button"
						aria-haspopup="listbox"
						aria-expanded="false"
					>
						<img id="tera-dropdown-image" class="tera-dropdown-image" alt="" style="display:none;" />
						<span id="tera-dropdown-placeholder" class="tera-dropdown-placeholder">テラスなし</span>
					</button>
					<ul
						id="tera-dropdown-list"
						class="tera-dropdown-list"
						role="listbox"
						aria-label="テラスタイプを選択"
						hidden
					>
					</ul>
				</div>
			</div>
		</div>

		{/* ラウンド23ユーザー指示(23-L2)により、性格の読み取り専用表示は特性の直下
		    (.top-block-fields内の#nature-readout-value<input readonly>)へ移設した。
		    ここにあった<p class="nature-readout">は撤去済み(値の更新先はJSで
		    id="nature-readout-value"のまま維持しているため<script>は変更不要)。 */}

		{/* UI改善ラウンド26ユーザー指示(26-L3)「アイテム段と技段の間にも横棒を配置」。
		    既存の区切り線トークン(border-top: 1px solid var(--color-border)、
		    .damage-row-footer等で使っている定石と同じ色・太さ)をこの技グリッド
		    (.move-fields-grid、下のCSS参照)にだけ追加する。 */}
		{/* 技は2列×2段に詰める(縦1080に収めるため)。
		    ラウンド4ユーザー指示: 「技1〜4でそれぞれラベルを置かず、"わざ" と1個
		    置いておけばよい」。個別の技1〜技4ラベル(A-8で横並びラベルに統一した
		    もの)をやめ、グループ見出し1つ(.field-group-label)にしていたが、
		    ラウンド20ユーザー指示(20-L1)で他の項目(種族・特性・ニックネーム)と同じく
		    placeholder方式に揃えるため、この見出し自体を撤去し各inputに
		    placeholder="技N"を付ける(aria-label="技N"は維持してa11yを保つ)。
		    ラウンド20ユーザー指示(20-L2): 技の詳細ホバー表示(旧.move-detail-trigger、
		    ⓘアイコン+ツールチップ)は撤去した。
		    ラウンド21ユーザー指示(21-L8)「技に背景色をつけると選択中のハイライト表示の
		    ように見えてしまう。背景色はつけず、タイプアイコンを技名の左に置く」。
		    <input>の中には画像を入れられないため、入力欄の左に絶対配置し、
		    input側のpadding-leftで文字と重ならないようにする(検索欄の虫眼鏡アイコンと
		    同じ定石)。ラウンド23ユーザー指示(23-L4)「技の選択ボックスの枠色をタイプごとに
		    変えない」により、border-colorをタイプ色にしていたupdateMoveTypeColor()は
		    関数ごと削除した(タイプアイコンで足りるため)。枠色は他の入力欄と同じ既定色。 */}
		{/* UI改善ラウンド38ユーザー指示(38-L1)「技の順番をドラッグアンドドロップで入れ替え」。
		    各技入力欄の右端に専用のドラッグハンドル(.move-drag-handle)を追加する。
		    ハンドルを入力欄自体ではなく別要素にした理由: 入力欄自体をdraggable/pointerの
		    起点にすると、ラウンド37の技選択ウィンドウ(setupMovePickerWindow、
		    input.mousedownでopenPicker)やテキスト選択・キャレット移動と操作が競合する。
		    ハンドルはinputの兄弟要素(#move-N入力欄自体はDOM上の位置・idを一切動かさない)
		    なので、input側の既存リスナー(mousedown→openPicker、setupDatalistRefocus等)には
		    無関係。装飾的なグリップ(CSSのドット格子、下記.move-drag-handle参照)のみで、
		    aria-hidden="true"にしてスクリンリーダーには公開しない(マウス操作専用の追加手段
		    という位置づけ。技名の直接入力・技選択ウィンドウはキーボードでも引き続き
		    全機能利用できるため、代替経路が失われるわけではない)。
		    並び替えの実装はleft-panel.tsのsetupMoveReorderDrag()参照(値をスワップする方式、
		    詳細は同関数のコメント)。 */}
		<div class="field-grid move-fields-grid">
			{MOVE_SLOTS.map((slot, i) => (
				<div class="field">
					<div class="field-with-image move-input-group" data-move-slot={slot}>
