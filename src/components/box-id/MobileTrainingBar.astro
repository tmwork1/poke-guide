---
import AppHeader from '../AppHeader.astro';
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import pokemonDetailRaw from '../../../public/master-data/detail/pokemon.json';
import { NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat, type StatKey } from '../../lib/stats';
import { championSpriteUrl, officialArtworkUrl } from '../../lib/pokemon-master-data';
import { itemIconUrl } from '../../lib/sprite-urls';
import '../../styles/box-pokemon-preview.css';
import '../../styles/app-header.css';

interface Props {
  pokemon: OwnedPokemonRecord;
  activeTab?: 'training' | 'battle-data' | 'ranked-teams' | 'matchup';
}

const { pokemon, activeTab = 'training' } = Astro.props;
const moves = pokemon.move_names ?? [];
const master = (pokemonMasterRaw as Array<{name:string;imageId:number}>).find((entry) => entry.name === pokemon.species_name);
const detail = (pokemonDetailRaw as Array<{name:string;baseStats:number[]}>).find((entry) => entry.name === pokemon.species_name);
const statKeys: StatKey[] = ['hp', 'atk', 'def', 'spa', 'spd', 'spe'];
const nature = NATURE_STAT_MODIFIERS[pokemon.nature ?? ''] ?? { up: null, down: null };
const previewStats = detail ? statKeys.map((key, index) => index === 0 ? calcHpStat(pokemon.level ?? 50, detail.baseStats[index], pokemon.ivs[index] ?? 31, pokemon.evs[index] ?? 0) : calcOtherStat(pokemon.level ?? 50, detail.baseStats[index], pokemon.ivs[index] ?? 31, pokemon.evs[index] ?? 0, nature.up === key ? 1.1 : nature.down === key ? 0.9 : 1)) : [];
---

<div class="mobile-training-ui" id="mobile-training-ui" data-mobile-tab={activeTab}>
  <AppHeader id="mobile-training-bar" ariaLabel="個体編集メニュー">
    <div class="app-header__list">
      {activeTab === 'training' ? (
        <button type="button" class="app-header__item" data-mobile-tab="training" data-active="true" aria-current="page"><span>育成</span></button>
      ) : (
        <a class="app-header__item" href={`/box/${encodeURIComponent(pokemon.id)}`}><span>育成</span></a>
      )}
      {activeTab === 'training' ? (
        <button type="button" class="app-header__item" data-mobile-tab="damage"><span>ダメージ</span></button>
      ) : (
        <a class="app-header__item" href={`/box/${encodeURIComponent(pokemon.id)}?tab=damage`}><span>ダメージ</span></a>
      )}
      <a class="app-header__item" href={`/box/data?pokemon=${encodeURIComponent(pokemon.id)}`} data-active={activeTab === 'battle-data' ? 'true' : undefined} aria-current={activeTab === 'battle-data' ? 'page' : undefined}>
        <span>バトルデータ</span>
      </a>
      <a class="app-header__item" href={`/box/ranked?pokemon=${encodeURIComponent(pokemon.id)}`} data-active={activeTab === 'ranked-teams' ? 'true' : undefined} aria-current={activeTab === 'ranked-teams' ? 'page' : undefined}>
        <span>上位チーム</span>
      </a>
      <a class="app-header__item" href={`/box/matchup?pokemon=${encodeURIComponent(pokemon.id)}`} data-active={activeTab === 'matchup' ? 'true' : undefined} aria-current={activeTab === 'matchup' ? 'page' : undefined}>
        <span>相性</span>
      </a>
    </div>
  </AppHeader>

  <section class="pokemon-preview" aria-label="ポケモンプレビュー" data-species-name={pokemon.species_name} data-item-name={pokemon.item_name ?? ''}>
    <div class="pokemon-preview-main">
    <div class="pokemon-preview-left">
      <div class="pokemon-preview-details">
        <div class="pokemon-preview-species-line">
          <div id="pokemon-preview-species-name">{pokemon.species_name || '-'}</div>
          <span class="pokemon-preview-type-icons" id="pokemon-preview-type-icons" aria-label="タイプ"></span>
        </div>
        <div id="pokemon-preview-ability">{pokemon.ability_name || '-'}</div>
      </div>
      <ol class="pokemon-preview-moves" aria-label="技">
        {[0, 1, 2, 3].map((index) => (
          <li>
            <span class="pokemon-preview-move-type-bar" id={`pokemon-preview-move-type-${index + 1}`} hidden></span>
            <span id={`pokemon-preview-move-${index + 1}`}>{moves[index] || '-'}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="pokemon-preview-identity">
      <button type="button" class="pokemon-preview-sprite-wrap" aria-label="ポケモンプレビュー">
        <img id="pokemon-preview-species-sprite" src={master ? championSpriteUrl(master.imageId) : undefined} onerror={master ? `this.onerror=null;this.src='${officialArtworkUrl(master.imageId)}';` : undefined} alt={pokemon.species_name} style={master ? undefined : 'display:none;'} />
        <span id="pokemon-preview-species-sprite-fallback" style={master ? 'display:none;' : undefined}>{pokemon.species_name.slice(0, 1)}</span>
      </button>
    </div>
    <div class="pokemon-preview-right">
      <div class="pokemon-preview-item pokemon-preview-icon-text">
        <img id="pokemon-preview-item-image" src={pokemon.item_name ? itemIconUrl(pokemon.item_name) : undefined} alt="" class={pokemon.item_name ? 'pokemon-preview-item-image' : 'pokemon-preview-item-image-hidden'} onerror="this.style.display='none'" />
        <span id="pokemon-preview-item" data-empty={pokemon.item_name ? undefined : 'true'}>{pokemon.item_name || 'アイテムなし'}</span>
      </div>
      <table class="pokemon-preview-stats" aria-label="実数値と努力値">
        <tbody>
          {[['hp', 'H'], ['atk', 'A'], ['def', 'B'], ['spa', 'C'], ['spd', 'D'], ['spe', 'S']].map(([key, label], index) => (
            <tr>
              <th data-mod={nature.up === key ? 'up' : nature.down === key ? 'down' : undefined}>{label}</th>
              <td id={`pokemon-preview-stat-${key}`} data-mod={nature.up === key ? 'up' : nature.down === key ? 'down' : undefined}>{previewStats[index] ?? '-'}</td>
              <td id={`pokemon-preview-ev-${key}`}>{pokemon.evs[index] ? `+${pokemon.evs[index]}` : '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
  </section>

</div>

<script>
  import '../../lib/box-id/mobile-edit-tabs';
  import { setupMegaPreviewToggle } from '../../lib/box-id/mega-preview-toggle';
  import { setupAppHeaderSwipe } from '../../lib/app-header-swipe';
  import { applyPreviewMoveTypeBarsFromDom } from '../../lib/box-id/preview-move-type-bar';

  setupMegaPreviewToggle();
  // 育成タブでは直後にleft-panel.tsのフォーム同期が上書きする(想定内・害はない)。
  // バトルデータ/上位チーム/相性タブには編集フォームの同期処理が無いため、この初期化が
  // 技名の左の色バーを塗る唯一の経路になる。
  applyPreviewMoveTypeBarsFromDom();

  setupAppHeaderSwipe(
    document.getElementById('mobile-training-bar'),
    document.getElementById('mobile-training-ui')?.closest<HTMLElement>('.page') ?? null,
  );
</script>
