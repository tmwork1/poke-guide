---
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import '../../styles/box-pokemon-preview.css';

interface Props {
  pokemon: OwnedPokemonRecord;
}

const { pokemon } = Astro.props;
const moves = pokemon.move_names ?? [];
const displayNickname = pokemon.nickname?.trim() || pokemon.species_name;
---

<div class="mobile-training-ui" id="mobile-training-ui" data-mobile-tab="training">
  <nav class="training-screen-bar" id="mobile-training-bar" aria-label="個体編集メニュー">
    <div class="training-screen-bar-list">
      <span class="training-screen-bar-item is-disabled" aria-disabled="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v9h9"/><path d="M20.5 15.5A9 9 0 1 1 8.5 3.7"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15V3.5Z"/></svg>
        <span>データ</span>
      </span>
      <span class="training-screen-bar-item is-disabled" aria-disabled="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
        <span>すばやさ</span>
      </span>
      <button type="button" class="training-screen-bar-item" data-mobile-tab="training" data-active="true" aria-current="page">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h6m6 0h6"/><circle cx="12" cy="12" r="3"/></svg>
        <span>育成</span>
      </button>
      <button type="button" class="training-screen-bar-item" data-mobile-tab="damage">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" y1="14" x2="9" y2="18"/><line x1="7" y1="17" x2="4" y2="20"/><line x1="3" y1="19" x2="5" y2="21"/></svg>
        <span>VS</span>
      </button>
      <span class="training-screen-bar-item is-disabled" aria-disabled="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m7 8 1.5 1.5L11 7"/><path d="M13 8h4"/><path d="m7 14 1.5 1.5L11 13"/><path d="M13 14h4"/></svg>
        <span>相性チェック</span>
      </span>
    </div>
  </nav>

  <section class="pokemon-preview" aria-label="ポケモンプレビュー" data-species-name={pokemon.species_name}>
    <div class="pokemon-preview-main">
    <div class="pokemon-preview-left">
      <div class="pokemon-preview-details">
        <div id="pokemon-preview-ability">{pokemon.ability_name || '-'}</div>
        <span class="pokemon-preview-type-icons" id="pokemon-preview-type-icons" aria-label="タイプ"></span>
      </div>
      <ol class="pokemon-preview-moves" aria-label="技">
        {[0, 1, 2, 3].map((index) => (
          <li>
            <span class="move-type-icon" id={`pokemon-preview-move-type-${index + 1}`} hidden><img alt="" /></span>
            <span id={`pokemon-preview-move-${index + 1}`}>{moves[index] || '-'}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="pokemon-preview-identity">
      <div class="pokemon-preview-sprite-wrap">
        <img id="pokemon-preview-species-sprite" width="72" height="72" alt={pokemon.species_name} style="display:none;" />
        <span id="pokemon-preview-species-sprite-fallback">{pokemon.species_name.slice(0, 1)}</span>
      </div>
    </div>
    <div class="pokemon-preview-right">
      <div class="pokemon-preview-item pokemon-preview-icon-text">
        <img id="pokemon-preview-item-image" alt="" style="display:none;" />
        <span id="pokemon-preview-item">{pokemon.item_name || 'アイテムなし'}</span>
      </div>
      <table class="pokemon-preview-stats" aria-label="実数値と努力値">
        <tbody>
          {[['hp', 'H'], ['atk', 'A'], ['def', 'B'], ['spa', 'C'], ['spd', 'D'], ['spe', 'S']].map(([key, label]) => (
            <tr>
              <th>{label}</th>
              <td id={`pokemon-preview-stat-${key}`}>-</td>
              <td id={`pokemon-preview-ev-${key}`}>-</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
    <div class="pokemon-preview-nickname-row">
      <span id="pokemon-preview-nickname">{displayNickname}</span>
    </div>
  </section>

  <div class="mobile-damage-toolbar" id="mobile-damage-toolbar">
    <div class="mobile-damage-toolbar-actions" id="mobile-damage-toolbar-actions"></div>
  </div>
</div>

<script>
  import '../../lib/box-id/mobile-edit-tabs';
  import { loadTypesMap } from '../../lib/pokemon-master-data';
  import { typeIconUrl } from '../../lib/sprite-urls';
  import { DEFAULT_TYPE_COLOR, TYPE_COLORS } from '../../lib/type-colors';

  const pokemonPreview = document.querySelector<HTMLElement>('.pokemon-preview');
  const speciesName = pokemonPreview?.dataset.speciesName;
  const pokemonPreviewMain = pokemonPreview?.querySelector<HTMLElement>('.pokemon-preview-main');
  const pokemonPreviewNicknameRow = pokemonPreview?.querySelector<HTMLElement>('.pokemon-preview-nickname-row');
  const pokemonPreviewTypeIcons = pokemonPreview?.querySelector<HTMLElement>('.pokemon-preview-type-icons');

  if (pokemonPreviewMain && speciesName) {
    loadTypesMap()
      .then((typesMap) => {
        const types = typesMap.get(speciesName);
        if (!types || types.length === 0) return;

        const toMixedColor = (typeName: string): string => {
          const hex = TYPE_COLORS[typeName] ?? DEFAULT_TYPE_COLOR;
          return `color-mix(in srgb, ${hex} 26%, var(--color-surface-alt))`;
        };

        const mainBackground =
          types.length >= 2
            ? `linear-gradient(to right, ${toMixedColor(types[0])}, ${toMixedColor(types[1])})`
            : toMixedColor(types[0]);
        pokemonPreviewMain.style.background = mainBackground;
        if (pokemonPreviewNicknameRow) {
          pokemonPreviewNicknameRow.style.background =
            `linear-gradient(rgb(0 0 0 / 14%), rgb(0 0 0 / 14%)), ${mainBackground}`;
        }
        if (pokemonPreviewTypeIcons) {
          pokemonPreviewTypeIcons.replaceChildren(
            ...types.map((typeName) => {
              const icon = document.createElement('img');
              icon.src = typeIconUrl(typeName) ?? '';
              icon.alt = typeName;
              icon.title = typeName;
              return icon;
            }),
          );
        }
      })
      .catch((error) => {
        console.warn('ポケモンプレビューのタイプ色取得に失敗しました', error);
      });
  }
</script>
