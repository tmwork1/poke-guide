---
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import pokemonDetailRaw from '../../../public/master-data/detail/pokemon.json';
import { NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat, type StatKey } from '../../lib/stats';
import { officialArtworkUrl } from '../../lib/pokemon-master-data';
import '../../styles/box-pokemon-preview.css';

interface Props {
  pokemon: OwnedPokemonRecord;
  activeTab?: 'training' | 'battle-data' | 'ranked-teams';
  backHref?: string;
}

const { pokemon, activeTab = 'training', backHref = '/box' } = Astro.props;
const moves = pokemon.move_names ?? [];
const master = (pokemonMasterRaw as Array<{name:string;imageId:number}>).find((entry) => entry.name === pokemon.species_name);
const detail = (pokemonDetailRaw as Array<{name:string;baseStats:number[]}>).find((entry) => entry.name === pokemon.species_name);
const statKeys: StatKey[] = ['hp', 'atk', 'def', 'spa', 'spd', 'spe'];
const nature = NATURE_STAT_MODIFIERS[pokemon.nature ?? ''] ?? { up: null, down: null };
const previewStats = detail ? statKeys.map((key, index) => index === 0 ? calcHpStat(pokemon.level ?? 50, detail.baseStats[index], pokemon.ivs[index] ?? 31, pokemon.evs[index] ?? 0) : calcOtherStat(pokemon.level ?? 50, detail.baseStats[index], pokemon.ivs[index] ?? 31, pokemon.evs[index] ?? 0, nature.up === key ? 1.1 : nature.down === key ? 0.9 : 1)) : [];
---

<div class="mobile-training-ui" id="mobile-training-ui" data-mobile-tab={activeTab}>
  <nav class="second-bar" id="mobile-training-bar" aria-label="個体編集メニュー">
    <div class="second-bar__list">
      <a class="second-bar__item" href={backHref}>戻る</a>
      {activeTab === 'training' ? (
        <button type="button" class="second-bar__item" data-mobile-tab="training" data-active="true" aria-current="page"><span>育成</span></button>
      ) : (
        <a class="second-bar__item" href={`/box/${encodeURIComponent(pokemon.id)}`}><span>育成</span></a>
      )}
      {activeTab === 'training' ? (
        <button type="button" class="second-bar__item" data-mobile-tab="damage"><span>ダメージ</span></button>
      ) : (
        <a class="second-bar__item" href={`/box/${encodeURIComponent(pokemon.id)}?tab=damage`}><span>ダメージ</span></a>
      )}
      <a class="second-bar__item" href={`/box/data?pokemon=${encodeURIComponent(pokemon.id)}`} data-active={activeTab === 'battle-data' ? 'true' : undefined} aria-current={activeTab === 'battle-data' ? 'page' : undefined}>
        <span>バトルデータ</span>
      </a>
      <a class="second-bar__item" href={`/box/ranked?pokemon=${encodeURIComponent(pokemon.id)}`} data-active={activeTab === 'ranked-teams' ? 'true' : undefined} aria-current={activeTab === 'ranked-teams' ? 'page' : undefined}>
        <span>上位チーム</span>
      </a>
      <span class="second-bar__item is-disabled" aria-disabled="true">
        <span>相性</span>
      </span>
    </div>
  </nav>

  <section class="pokemon-preview" aria-label="ポケモンプレビュー" data-species-name={pokemon.species_name}>
    <div class="pokemon-preview-main">
    <div class="pokemon-preview-left">
      <div class="pokemon-preview-details">
        <div id="pokemon-preview-ability">{pokemon.ability_name || '-'}</div>
        <span class="pokemon-preview-type-icons" id="pokemon-preview-type-icons" aria-label="タイプ"></span>
      </div>
      <ol class="pokemon-preview-moves" aria-label="技">
        {[0, 1, 2, 3].map((index) => (
          <li>
            <span class="move-type-icon" id={`pokemon-preview-move-type-${index + 1}`} hidden><img alt="" /></span>
            <span id={`pokemon-preview-move-${index + 1}`}>{moves[index] || '-'}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="pokemon-preview-identity">
      <div class="pokemon-preview-sprite-wrap">
        <img id="pokemon-preview-species-sprite" src={master ? officialArtworkUrl(master.imageId) : undefined} alt={pokemon.species_name} style={master ? undefined : 'display:none;'} />
        <span id="pokemon-preview-species-sprite-fallback" style={master ? 'display:none;' : undefined}>{pokemon.species_name.slice(0, 1)}</span>
      </div>
    </div>
    <div class="pokemon-preview-right">
      <div class="pokemon-preview-item pokemon-preview-icon-text">
        <img id="pokemon-preview-item-image" alt="" style="display:none;" />
        <span id="pokemon-preview-item">{pokemon.item_name || 'アイテムなし'}</span>
      </div>
      <table class="pokemon-preview-stats" aria-label="実数値と努力値">
        <tbody>
          {[['hp', 'H'], ['atk', 'A'], ['def', 'B'], ['spa', 'C'], ['spd', 'D'], ['spe', 'S']].map(([key, label], index) => (
            <tr>
              <th>{label}</th>
              <td id={`pokemon-preview-stat-${key}`} data-mod={nature.up === key ? 'up' : nature.down === key ? 'down' : undefined}>{previewStats[index] ?? '-'}</td>
              <td id={`pokemon-preview-ev-${key}`}>{pokemon.evs[index] ? `+${pokemon.evs[index]}` : '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
  </section>

  <div class="mobile-damage-toolbar" id="mobile-damage-toolbar">
    <div class="mobile-damage-toolbar-actions" id="mobile-damage-toolbar-actions"></div>
  </div>
</div>

<script>
  import '../../lib/box-id/mobile-edit-tabs';
  import { loadTypesMap } from '../../lib/pokemon-master-data';
  import { typeIconUrl } from '../../lib/sprite-urls';
  import { DEFAULT_TYPE_COLOR, TYPE_COLORS } from '../../lib/type-colors';

  const pokemonPreview = document.querySelector<HTMLElement>('.pokemon-preview');
  const speciesName = pokemonPreview?.dataset.speciesName;
  const pokemonPreviewMain = pokemonPreview?.querySelector<HTMLElement>('.pokemon-preview-main');
  const pokemonPreviewTypeIcons = pokemonPreview?.querySelector<HTMLElement>('.pokemon-preview-type-icons');

  if (pokemonPreviewMain && speciesName) {
    loadTypesMap()
      .then((typesMap) => {
        const types = typesMap.get(speciesName);
        if (!types || types.length === 0) return;

        const toMixedColor = (typeName: string): string => {
          const hex = TYPE_COLORS[typeName] ?? DEFAULT_TYPE_COLOR;
          return `color-mix(in srgb, ${hex} 26%, var(--color-surface-alt))`;
        };

        const mainBackground =
          types.length >= 2
            ? `linear-gradient(to right, ${toMixedColor(types[0])}, ${toMixedColor(types[1])})`
            : toMixedColor(types[0]);
        pokemonPreviewMain.style.background = mainBackground;
        if (pokemonPreviewTypeIcons) {
          pokemonPreviewTypeIcons.replaceChildren(
            ...types.map((typeName) => {
              const icon = document.createElement('img');
              icon.src = typeIconUrl(typeName) ?? '';
              icon.alt = typeName;
              icon.title = typeName;
              return icon;
            }),
          );
        }
      })
      .catch((error) => {
        console.warn('ポケモンプレビューのタイプ色取得に失敗しました', error);
      });
  }
</script>
