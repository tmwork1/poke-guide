---
import '../../styles/speed-adjust-dialog.css';

interface Props {
	pokemonId: string;
}

const { pokemonId } = Astro.props;
const speedChartSrc = `/speed-chart?owned=${encodeURIComponent(pokemonId)}&embed=1`;
---

<div id="speed-adjust-backdrop" class="speed-adjust-backdrop" hidden></div>
<section
	id="speed-adjust-dialog"
	class="speed-adjust-dialog"
	role="dialog"
	aria-modal="true"
	aria-label="すばやさ調整"
	tabindex="-1"
	hidden
>
	<iframe id="speed-adjust-dialog-frame" class="speed-adjust-dialog-frame" title="すばやさ調整" data-src={speedChartSrc}></iframe>
</section>

<script>
	import { bindModalDismissal } from "../../lib/modal-dismiss";
	import { OWNED_EDIT_CHANGED_EVENT, type OwnedEditChangedDetail } from "../../lib/box-id/owned-edit-events";
	const triggers = document.querySelectorAll<HTMLButtonElement>("[data-speed-adjust-trigger]");
	const backdrop = document.getElementById("speed-adjust-backdrop");
	const dialog = document.getElementById("speed-adjust-dialog");
	const frame = document.getElementById("speed-adjust-dialog-frame") as HTMLIFrameElement | null;
	let opener: HTMLButtonElement | null = null;

	function closeDialog() {
		if (!dialog || !backdrop || !frame) return;
		dialog.hidden = true;
		backdrop.hidden = true;
		opener?.focus();
	}

	function openDialog(trigger: HTMLButtonElement) {
		if (!dialog || !backdrop || !frame) return;
		opener = trigger;
		// アイドル時に読み込み済みのiframeを再代入すると再読込になり、一瞬白く点滅する。
		if (!frame.getAttribute("src")) frame.src = frame.dataset.src ?? "";
		backdrop.hidden = false;
		dialog.hidden = false;
		dialog.focus();
		// 表示されて初めてiframe内でスクロールが効くようになる。保留されている初回スクロール
		// (現在値への移動)をiframeに実行させる。
		notifyShown();
	}

	triggers.forEach((trigger) => trigger.addEventListener("click", () => openDialog(trigger)));

	// iframeは開いた時点のSSRデータで動くため、育成パネル側で持ち物・特性・性格・努力値・種族を
	// 変えても中身は古いままになる。編集中の内容をそのまま流し込んで即時反映させる(保存の完了は
	// 待たない。待つと、保存前に開いたときに古い表を見せてしまう)。
	let latestEdit: OwnedEditChangedDetail | null = null;
	let frameLoaded = false;
	let postTimer: number | undefined;

	function postLatestEdit() {
		if (!frame || !frameLoaded || !latestEdit) return;
		frame.contentWindow?.postMessage(
			{ type: "speed-chart:owned-record-updated", record: latestEdit, visible: !dialog?.hidden },
			window.location.origin,
		);
	}

	function notifyShown() {
		if (!frame || !frameLoaded) return;
		frame.contentWindow?.postMessage({ type: "speed-chart:shown" }, window.location.origin);
	}

	frame?.addEventListener("load", () => {
		frameLoaded = true;
		// 読み込み前に来ていた編集内容は、読み込み完了後に改めて送る。開いた状態で読み込みが
		// 完了した場合(初回クリックで開いたときなど)は表示通知も送り直す。
		postLatestEdit();
		if (!dialog?.hidden) notifyShown();
	});

	document.addEventListener(OWNED_EDIT_CHANGED_EVENT, (event) => {
		latestEdit = (event as CustomEvent<OwnedEditChangedDetail>).detail;
		// 持ち物名の手入力など1文字ごとに飛んでくる経路があるため、表の再描画はまとめる。
		if (postTimer !== undefined) window.clearTimeout(postTimer);
		postTimer = window.setTimeout(postLatestEdit, 150);
	});
	// iframe の初期化は重いため、編集画面の初期描画を妨げないアイドル時間に済ませる。
	// 一度読み込んだ内容は閉じた後も保持し、二回目以降も即座に開けるようにする。
	const preload = () => {
		if (frame && !frame.getAttribute("src")) frame.src = frame.dataset.src ?? "";
	};
	if ("requestIdleCallback" in window) window.requestIdleCallback(preload, { timeout: 1200 });
	else window.setTimeout(preload, 300);
	if (backdrop && dialog) bindModalDismissal({ backdrop, dialog, isOpen: () => !dialog.hidden, onDismiss: closeDialog });
	window.addEventListener("message", (event) => {
		if (event.origin !== window.location.origin) return;
		const data = event.data as { type?: string } | null;
		if (data?.type === "speed-chart:close") closeDialog();
		if (data?.type === "speed-chart:applied") window.location.reload();
	});
</script>
