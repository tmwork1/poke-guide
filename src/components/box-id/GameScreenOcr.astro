---
// ポケモン読み取りモーダル。ゲーム画面(ポケモンチャンピオンズのボックス画面右側)の写真をOCRして、
// /box/new の登録フォームへ種族・努力値・性格・わざ・特性を反映する。
// 開く条件・OCR・反映のロジックは src/lib/box-id/game-screen-ocr.ts、見た目は src/styles/game-screen-ocr.css。
import '../../styles/game-screen-ocr.css';
---

<div id="game-screen-ocr-backdrop" class="game-screen-ocr-backdrop" hidden></div>
<div id="game-screen-ocr-dialog" class="game-screen-ocr-dialog" role="dialog" aria-modal="true" aria-labelledby="game-screen-ocr-title" tabindex="-1" hidden>
	<div class="game-screen-ocr-dialog-header">
		<h2 id="game-screen-ocr-title" class="game-screen-ocr-dialog-title">ポケモン読み取り</h2>
		<button id="game-screen-ocr-close" class="btn-ghost game-screen-ocr-close" type="button" aria-label="閉じる">×</button>
	</div>
	{/* 写真を選ぶ前の案内。認識中は隠して進捗だけを出す */}
	<div id="game-screen-ocr-picker" class="game-screen-ocr-picker">
		<p class="game-screen-ocr-description">ボックス画面の右側を撮影してください。</p>
		<img class="game-screen-ocr-guide" src="/images/game-screen-ocr-guide.webp" width="480" height="643" alt="ボックス画面の右側にある、ステータス・わざ・特性が並んだ欄" />
		{/* capture 付きは端末のカメラを直接起動し、無しはカメラロール(ファイル選択)を開く */}
		<input id="game-screen-ocr-camera-file" class="game-screen-ocr-file" type="file" accept="image/*" capture="environment" />
		<input id="game-screen-ocr-library-file" class="game-screen-ocr-file" type="file" accept="image/*" />
		<div class="game-screen-ocr-picker-actions">
			{/* アイコンは /box のカメラFABと同じ線画のカメラと、画像ライブラリ定番の「山と太陽の写真」 */}
			<button id="game-screen-ocr-camera-button" class="btn-primary game-screen-ocr-picker-button" type="button">
				<svg class="game-screen-ocr-picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 7h3l1.5-2h7L17 7h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z" />
					<circle cx="12" cy="13" r="3.5" />
				</svg>
				カメラで撮影
			</button>
			<button id="game-screen-ocr-library-button" class="btn-control game-screen-ocr-picker-button" type="button">
				<svg class="game-screen-ocr-picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="18" height="18" rx="2" />
					<circle cx="15.5" cy="8.5" r="1.8" />
					<path d="M3 17l6-6 4.5 4.5L17 12l4 4" />
				</svg>
				写真を選ぶ
			</button>
		</div>
	</div>
	<p id="game-screen-ocr-progress" class="game-screen-ocr-progress" role="status" aria-live="polite" hidden></p>
</div>

<script>
	import '../../lib/box-id/game-screen-ocr';
</script>
