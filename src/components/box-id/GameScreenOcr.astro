---
import '../../styles/game-screen-ocr.css';
---

<div id="game-screen-ocr-backdrop" class="game-screen-ocr-backdrop" hidden></div>
<div id="game-screen-ocr-dialog" class="game-screen-ocr-dialog" role="dialog" aria-modal="true" aria-labelledby="game-screen-ocr-title" tabindex="-1" hidden>
	<div class="game-screen-ocr-dialog-header">
		<h2 id="game-screen-ocr-title" class="game-screen-ocr-dialog-title">ゲーム画面を読み取り</h2>
		<button id="game-screen-ocr-close" class="btn-ghost game-screen-ocr-close" type="button" aria-label="閉じる">×</button>
	</div>
	<p id="game-screen-ocr-progress" class="game-screen-ocr-progress" role="status" aria-live="polite"></p>
	<div id="game-screen-ocr-result" class="game-screen-ocr-result" hidden></div>
	<div class="game-screen-ocr-actions">
		<button id="game-screen-ocr-cancel" class="btn-ghost" type="button">キャンセル</button>
		<button id="game-screen-ocr-apply" class="btn-primary" type="button" hidden>適用</button>
	</div>
</div>
