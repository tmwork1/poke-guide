---
import AppHeader from '../AppHeader.astro';
import type { OwnedPokemonRecord } from '../../lib/owned-pokemon';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';
import pokemonDetailRaw from '../../../public/master-data/detail/pokemon.json';
import { NATURE_STAT_MODIFIERS, calcHpStat, calcOtherStat, type StatKey } from '../../lib/stats';
import { championSpriteUrl, officialArtworkUrl } from '../../lib/pokemon-master-data';
import { itemIconUrl } from '../../lib/sprite-urls';
import '../../styles/mobile-pokemon-preview.css';
import '../../styles/app-header.css';

interface Props {
  pokemon: OwnedPokemonRecord | null;
  activeTab?: 'training' | 'damage' | 'battle-data' | 'ranked-teams' | 'matchup';
}

const { pokemon, activeTab = 'training' } = Astro.props;
const hasPokemon = pokemon !== null;
const previewPokemon: OwnedPokemonRecord = pokemon ?? {
  id: '', user_id: '', guest_local_id: null, species_name: '', level: null, nature: null,
  ability_name: null, item_name: null, tera_type: null, evs: [0, 0, 0, 0, 0, 0],
  ivs: [31, 31, 31, 31, 31, 31], move_names: [], memo: null, tags: [], source_build_slug: null,
  share_slug: null, is_public: false, created_at: '', updated_at: '', last_used_at: null,
  collection_opt_out_until: null, archetype_id: null,
};
const isNew = !previewPokemon.id;
const moves = previewPokemon.move_names ?? [];
const itemName = previewPokemon.item_name?.trim() ?? '';
// データ系タブのプレビューは編集フォームと同期しないため、持ち物がなければ
// アイコン用の要素そのものを出さない。育成タブは入力中にアイコンを差し替えるので
// 常に要素を保持する。
const shouldRenderItemIcon = activeTab === 'training' || itemName !== '';
const master = (pokemonMasterRaw as Array<{name:string;imageId:number}>).find((entry) => entry.name === previewPokemon.species_name);
const detail = (pokemonDetailRaw as Array<{name:string;baseStats:number[]}>).find((entry) => entry.name === previewPokemon.species_name);
const statKeys: StatKey[] = ['hp', 'atk', 'def', 'spa', 'spd', 'spe'];
const nature = NATURE_STAT_MODIFIERS[previewPokemon.nature ?? ''] ?? { up: null, down: null };
const previewStats = detail ? statKeys.map((key, index) => index === 0 ? calcHpStat(previewPokemon.level ?? 50, detail.baseStats[index], previewPokemon.ivs[index] ?? 31, previewPokemon.evs[index] ?? 0) : calcOtherStat(previewPokemon.level ?? 50, detail.baseStats[index], previewPokemon.ivs[index] ?? 31, previewPokemon.evs[index] ?? 0, nature.up === key ? 1.1 : nature.down === key ? 0.9 : 1)) : [];
---

<style is:inline>#mobile-training-ui { visibility: hidden; }</style>

<div class="mobile-training-ui" id="mobile-training-ui" data-mobile-tab={activeTab}>
  <AppHeader id="mobile-training-bar" ariaLabel="個体編集メニュー">
    <div class="app-header__list">
      {!hasPokemon ? (
        <a class="app-header__item" href="/box"><span>ポケモン</span></a>
      ) : activeTab === 'training' ? (
        <button type="button" class="app-header__item" data-mobile-tab="training" data-active="true" aria-current="page"><span>ポケモン</span></button>
      ) : (
        <a class="app-header__item" href={`/box/${encodeURIComponent(previewPokemon.id)}`}><span>ポケモン</span></a>
      )}
		{!hasPokemon ? (
			<>
				<span class="app-header__item" aria-disabled="true"><span>ダメージ</span></span>
				{activeTab === 'battle-data' ? <button type="button" class="app-header__item" data-active="true" aria-current="page"><span>バトルデータ</span></button> : <span class="app-header__item" aria-disabled="true"><span>バトルデータ</span></span>}
				{activeTab === 'ranked-teams' ? <button type="button" class="app-header__item" data-active="true" aria-current="page"><span>上位チーム</span></button> : <span class="app-header__item" aria-disabled="true"><span>上位チーム</span></span>}
				{activeTab === 'matchup' ? <button type="button" class="app-header__item" data-active="true" aria-current="page"><span>相性</span></button> : <span class="app-header__item" aria-disabled="true"><span>相性</span></span>}
			</>
		) : !isNew && (
			<>
				{activeTab === 'training' ? (
					<button type="button" class="app-header__item" data-mobile-tab="damage"><span>ダメージ</span></button>
				) : activeTab === 'damage' ? (
					<button type="button" class="app-header__item" data-mobile-tab="damage" data-active="true" aria-current="page"><span>ダメージ</span></button>
				) : (
					<a class="app-header__item" href={`/box/${encodeURIComponent(previewPokemon.id)}?tab=damage`}><span>ダメージ</span></a>
				)}
				<a class="app-header__item" href={`/box/data?pokemon=${encodeURIComponent(previewPokemon.id)}`} data-active={activeTab === 'battle-data' ? 'true' : undefined} aria-current={activeTab === 'battle-data' ? 'page' : undefined}>
					<span>バトルデータ</span>
				</a>
				<a class="app-header__item" href={`/box/ranked?pokemon=${encodeURIComponent(previewPokemon.id)}`} data-active={activeTab === 'ranked-teams' ? 'true' : undefined} aria-current={activeTab === 'ranked-teams' ? 'page' : undefined}>
					<span>上位チーム</span>
				</a>
				<a class="app-header__item" href={`/box/matchup?pokemon=${encodeURIComponent(previewPokemon.id)}`} data-active={activeTab === 'matchup' ? 'true' : undefined} aria-current={activeTab === 'matchup' ? 'page' : undefined}>
					<span>相性</span>
				</a>
			</>
		)}
    </div>
  </AppHeader>

  {hasPokemon && <section
    class="pokemon-preview"
    aria-label="ポケモンプレビュー"
    data-species-name={previewPokemon.species_name}
    data-item-name={itemName}
    data-level={previewPokemon.level ?? 50}
    data-nature={previewPokemon.nature ?? ''}
    data-ivs={JSON.stringify(previewPokemon.ivs ?? [31, 31, 31, 31, 31, 31])}
    data-evs={JSON.stringify(previewPokemon.evs ?? [0, 0, 0, 0, 0, 0])}
  >
    <div class="pokemon-preview-main">
    <div class="pokemon-preview-left">
      <div class="pokemon-preview-details">
        {/* タップで種族選択モーダル(#species-select-trigger-button、LeftPanel.astro)を開く。
            他のタップ起点(ステータス調整・もちもの)と同じくpreview-quick-open.tsが配線し、
            対象ボタンが存在しない他ページ(battle-data/ranked-teams/matchup)では安全にno-opにする。 */}
        <div class="pokemon-preview-species-line" id="pokemon-preview-species-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-label="ポケモンを選択">
          <div id="pokemon-preview-species-name">{previewPokemon.species_name || '-'}</div>
          <span class="pokemon-preview-type-icons" id="pokemon-preview-type-icons" aria-label="タイプ"></span>
        </div>
        <div id="pokemon-preview-ability">{previewPokemon.ability_name || '-'}</div>
      </div>
      {/* 各行タップで、その技スロットのわざ選択(#move-${slot}へのfocusで開く、
          left-panel.tsのopenPicker参照)を開く。preview-quick-open.tsが配線する。 */}
      <ol class="pokemon-preview-moves" aria-label="技">
        {[0, 1, 2, 3].map((index) => (
          <li class="pokemon-preview-move-trigger" data-move-slot={index + 1} role="button" tabindex="0" aria-label={`技${index + 1}を選択`}>
            <span class="pokemon-preview-move-type-bar" id={`pokemon-preview-move-type-${index + 1}`} hidden></span>
            <span id={`pokemon-preview-move-${index + 1}`}>{moves[index] || '-'}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="pokemon-preview-identity">
      <button type="button" class="pokemon-preview-sprite-wrap" aria-label="ポケモンプレビュー">
        <img id="pokemon-preview-species-sprite" src={master ? championSpriteUrl(master.imageId) : undefined} onerror={master ? `this.onerror=null;this.src='${officialArtworkUrl(master.imageId)}';` : undefined} alt={previewPokemon.species_name} style={master ? undefined : 'display:none;'} />
        <span id="pokemon-preview-species-sprite-fallback" style={master ? 'display:none;' : undefined}>{previewPokemon.species_name.slice(0, 1)}</span>
      </button>
    </div>
    <div class="pokemon-preview-right">
      {/* タップでもちもの選択モーダル(#item-dropdown-button、LeftPanel.astro)を開く。 */}
      <div class="pokemon-preview-item pokemon-preview-icon-text" id="pokemon-preview-item-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-label="もちものを選択">
        {shouldRenderItemIcon && <img id="pokemon-preview-item-image" src={itemName ? itemIconUrl(itemName) : undefined} alt="" class={itemName ? 'pokemon-preview-item-image' : 'pokemon-preview-item-image-hidden'} onerror="this.style.display='none'" />}
        <span id="pokemon-preview-item" data-empty={itemName ? undefined : 'true'}>{itemName || 'もちものなし'}</span>
      </div>
      {/* この表をタップすると育成タブのステータス調整欄(#stat-adjustment-section、
          LeftPanel.astro)をモーダルで開く(StatAdjustmentDialog.astro/
          stat-adjustment-dialog.ts参照)。box/[id].astroでは育成・ダメージタブが
          同一ページ内のCSS切り替えで、LeftPanel(モーダル本体を含む)はどちらのタブでも
          常にDOMに存在するため、activeTabで対話属性を出し分けない(SSR時の
          initialMobileTabに関わらず、タブを切り替えたあとも正しく開けるようにするため)。
          battle-data/ranked-teams/matchupは別ページでモーダル本体が存在しないため、
          要素の有無はstat-adjustment-dialog.ts側で確認し、安全にno-opにする。 */}
      <div
        class="pokemon-preview-stats-wrap"
        id="pokemon-preview-stats-trigger"
        role="button"
        tabindex={0}
        aria-haspopup="dialog"
        aria-label="ステータス調整を開く"
      >
        <table class="pokemon-preview-stats" aria-label="実数値と努力値">
          <tbody>
            {[['hp', 'H'], ['atk', 'A'], ['def', 'B'], ['spa', 'C'], ['spd', 'D'], ['spe', 'S']].map(([key, label], index) => (
              <tr>
                <th data-mod={nature.up === key ? 'up' : nature.down === key ? 'down' : undefined}>{label}</th>
                <td id={`pokemon-preview-stat-${key}`} data-mod={nature.up === key ? 'up' : nature.down === key ? 'down' : undefined}>{previewStats[index] ?? '-'}</td>
                <td id={`pokemon-preview-ev-${key}`}>{previewPokemon.evs[index] ? `+${previewPokemon.evs[index]}` : '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    </div>
  </section>}

</div>

<script>
  import '../../lib/box-id/mobile-edit-tabs';
  import '../../lib/box-id/stat-adjustment-dialog';
  import '../../lib/box-id/preview-quick-open';
  import { setupMegaPreviewToggle } from '../../lib/box-id/mega-preview-toggle';
  import { setupAppHeaderSwipe } from '../../lib/app-header-swipe';
  import { applyPreviewMoveTypeBarsFromDom } from '../../lib/box-id/preview-move-type-bar';

  setupMegaPreviewToggle();
  // 育成タブでは直後にleft-panel.tsのフォーム同期が上書きする(想定内・害はない)。
  // バトルデータ/上位チーム/相性タブには編集フォームの同期処理が無いため、この初期化が
  // 技名の左の色バーを塗る唯一の経路になる。
  applyPreviewMoveTypeBarsFromDom();

  setupAppHeaderSwipe(
    document.getElementById('mobile-training-bar'),
    document.getElementById('mobile-training-ui')?.closest<HTMLElement>('.page') ?? null,
  );
</script>
