---
import '../../styles/item-select-dialog.css';
---

<div id="item-select-backdrop" class="item-select-backdrop" hidden></div>
<div
	id="item-select-dialog"
	class="item-select-dialog"
	role="dialog"
	aria-modal="true"
	aria-labelledby="item-select-dialog-title"
	tabindex="-1"
	hidden
>
	<div class="item-select-header">
		<h2 id="item-select-dialog-title" class="item-select-title">もちもの選択</h2>
		<button type="button" id="item-select-close-button" class="btn-ghost item-select-close" aria-label="閉じる">×</button>
	</div>
	<div class="item-select-search-row">
		<div class="search-input-wrap item-select-search-wrap">
			<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="7" />
				<line x1="21" y1="21" x2="16.65" y2="16.65" />
			</svg>
			<input type="text" id="item-select-search-input" class="item-select-search-input field-control" placeholder="もちもの" aria-label="もちもの候補を絞り込み" autocomplete="off" />
		</div>
	</div>
	<div id="item-select-grid-wrap" class="item-select-grid-wrap">
		<div id="item-select-grid" class="item-select-grid" role="listbox" aria-label="もちものを選択"></div>
		<p id="item-select-empty" class="item-select-empty" hidden>条件に一致するもちものがありません</p>
	</div>
</div>

<script>
	import '../../lib/box-id/item-select-dialog';
</script>
