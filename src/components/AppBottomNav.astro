---
import '../styles/app-bottom-nav.css';
interface Props {
	current?: "home" | "box" | "team" | "dev" | "speed-chart" | "data";
}

const { current } = Astro.props;
---

<nav class="app-bottom-nav" aria-label="メインナビゲーション">
	<div class="app-bottom-nav-list">
		<a class="app-bottom-nav-item" href="/" data-active={current === "home" ? "true" : undefined} aria-current={current === "home" ? "page" : undefined}>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10Z"/><path d="M9 21v-6h6v6"/></svg>
			<span>ホーム</span>
		</a>
		<a class="app-bottom-nav-item" href="/box" data-active={current === "box" ? "true" : undefined} aria-current={current === "box" ? "page" : undefined}>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.5 12 3 3 7.5v9L12 21l9-4.5v-9Z"/><path d="M3.5 7.3 12 12l8.5-4.7"/><path d="M12 12v9"/></svg>
			<span>ボックス</span>
		</a>
		<a class="app-bottom-nav-item" href="/team" data-active={current === "team" ? "true" : undefined} aria-current={current === "team" ? "page" : undefined}>
			<svg width="26" height="26" viewBox="0 0 26 26" fill="currentColor" aria-hidden="true"><rect x="2" y="4" width="6" height="8" rx="1.3"/><rect x="10" y="4" width="6" height="8" rx="1.3"/><rect x="18" y="4" width="6" height="8" rx="1.3"/><rect x="2" y="14" width="6" height="8" rx="1.3"/><rect x="10" y="14" width="6" height="8" rx="1.3"/><rect x="18" y="14" width="6" height="8" rx="1.3"/></svg>
			<span>チーム</span>
		</a>
		<a class="app-bottom-nav-item" href="/data" data-active={current === "data" ? "true" : undefined} aria-current={current === "data" ? "page" : undefined}>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
			<span>データ</span>
		</a>
		<span class="app-bottom-nav-item is-disabled" aria-disabled="true">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M6 7h12M6 11h3m6 0h3M6 15h3m6 0h3M6 18h3m6 0h3"/></svg>
			<span>ダメージ</span>
		</span>
	</div>
</nav>
