---
// バトルデータカード(特性/性格/アイテム/わざ/努力値/同時採用ポケモンの2x3グリッド、
// docs/ui/mobile/7.png)。/box/data(個体ごと)と /data のバトルデータタブ(全体
// ランキング)でマークアップを完全に一致させるため、実装をここへ一本化する。
// スタイルは src/styles/battle-data-card.css(利用側ページが各自import)。
import { evSpreadLabel, usageRateLabel, type SingleFormatData } from '../../lib/battle-data-card';
import { championSpriteUrl, officialArtworkUrl } from '../../lib/pokemon-master-data';
import { itemIconUrl, typeIconUrl } from '../../lib/sprite-urls';
import movesMasterRaw from '../../../public/master-data/autocomplete/moves.json';
import pokemonMasterRaw from '../../../public/master-data/autocomplete/pokemon.json';

interface Props {
  single: SingleFormatData | null | undefined;
}

const { single } = Astro.props;
const moveTypeByName = new Map(
  (movesMasterRaw as Array<{ name: string; type: string | null }>)
    .filter((move) => move.type !== null)
    .map((move) => [move.name, move.type!] as const),
);
const imageIdByName = new Map(
  (pokemonMasterRaw as Array<{ name: string; imageId: number }>).map((pokemon) => [pokemon.name, pokemon.imageId]),
);
const abilities = single?.abilities ?? [];
const natures = single?.natures ?? [];
const items = single?.items ?? [];
const moves = single?.moves ?? [];
const evs = single?.evs ?? [];
const teammates = single?.teammates ?? [];
---

<div class="trend-detail-card">
  <div class="trend-detail-cell">
    <span>特性</span>
    <div class="trend-cell-body">
      {abilities.length ? <ul class="trend-rank-list">{abilities.map((row) => <li class="trend-rank-row trend-rank-row--text2"><span class="trend-rank-name">{row.name}</span><span class="trend-rank-rate">{usageRateLabel(row.usageRate)}</span></li>)}</ul> : <strong>データなし</strong>}
    </div>
  </div>
  <div class="trend-detail-cell">
    <span>性格</span>
    <div class="trend-cell-body">
      {natures.length ? <ul class="trend-rank-list">{natures.map((row) => <li class="trend-rank-row trend-rank-row--text2"><span class="trend-rank-name">{row.name}</span><span class="trend-rank-rate">{usageRateLabel(row.usageRate)}</span></li>)}</ul> : <strong>データなし</strong>}
    </div>
  </div>
  <div class="trend-detail-cell">
    <span>アイテム</span>
    <div class="trend-cell-body">
      {items.length ? <ul class="trend-rank-list">{items.map((row) => <li class="trend-rank-row trend-rank-row--icon3"><span class="trend-rank-icon"><img src={itemIconUrl(row.name)} onerror="this.parentElement.hidden=true;this.closest('.trend-rank-row').classList.replace('trend-rank-row--icon3','trend-rank-row--text2')" alt="" loading="lazy" /></span><span class="trend-rank-name">{row.name}</span><span class="trend-rank-rate">{usageRateLabel(row.usageRate)}</span></li>)}</ul> : <strong>データなし</strong>}
    </div>
  </div>
  <div class="trend-detail-cell">
    <span>わざ</span>
    <div class="trend-cell-body">
      {moves.length ? <ul class="trend-rank-list">{moves.map((row) => { const iconUrl = typeIconUrl(moveTypeByName.get(row.name) ?? ''); return <li class:list={['trend-rank-row', iconUrl ? 'trend-rank-row--icon3' : 'trend-rank-row--text2']}>{iconUrl && <span class="trend-rank-icon"><img class="trend-rank-icon--type" src={iconUrl} alt="" loading="lazy" /></span>}<span class="trend-rank-name">{row.name}</span><span class="trend-rank-rate">{usageRateLabel(row.usageRate)}</span></li>; })}</ul> : <strong>データなし</strong>}
    </div>
  </div>
  <div class="trend-detail-cell">
    <span>努力値</span>
    <div class="trend-cell-body">
      {evs.length ? <ul class="trend-rank-list">{evs.map((row) => <li class="trend-rank-row trend-rank-row--text2"><span class="trend-rank-name">{evSpreadLabel(row.values)}</span><span class="trend-rank-rate">{usageRateLabel(row.usageRate)}</span></li>)}</ul> : <strong>データなし</strong>}
    </div>
  </div>
  <div class="trend-detail-cell">
    <span>同時採用</span>
    <div class="trend-cell-body">
      {teammates.length ? <ul class="trend-rank-list">{teammates.map((row) => { const imageId = imageIdByName.get(row.name) ?? null; return <li class:list={['trend-rank-row', imageId !== null ? 'trend-rank-row--icon2' : 'trend-rank-row--name1']}>{imageId !== null && <span class="trend-rank-icon"><img class="trend-rank-icon--pokemon" src={championSpriteUrl(imageId)} onerror={`this.onerror=null;this.src='${officialArtworkUrl(imageId)}';`} alt="" loading="lazy" /></span>}<span class="trend-rank-name">{row.name}</span></li>; })}</ul> : <strong>データなし</strong>}
    </div>
  </div>
</div>
