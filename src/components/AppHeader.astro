---
interface Props {
  id?: string;
  ariaLabel?: string;
  toolbar?: boolean;
  showGuestBadge?: boolean;
  class?: string;
}

const { id, ariaLabel, toolbar = false, showGuestBadge = false, class: className } = Astro.props;
const showGuestModeBadge = showGuestBadge && !Astro.locals.user;
---

<nav id={id} class={`app-header${toolbar ? ' app-header--toolbar' : ''}${className ? ` ${className}` : ''}`} {ariaLabel}>
  <button type="button" class="app-header__back app-header-back" aria-label="戻る" onclick="history.back()">
    <svg class="app-header-back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 14 4 9l5-5" />
      <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11" />
    </svg>
  </button>
  <slot />
  {showGuestModeBadge && (
    <div class="app-header__guest-badge">
      <span class="app-header__guest-badge-label">お試しモード</span>
      <span class="app-header__guest-badge-message">ログインするとデータをアカウントに保存できます。</span>
      <a class="app-header__guest-badge-login" href="/api/auth/login" aria-label="ログインするとデータをアカウントに保存できます。">ログイン</a>
    </div>
  )}
</nav>
