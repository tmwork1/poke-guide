---
// すばやさ早見表(/speed-chart)本体のテンプレート。
// 行は共有表示モデルを使ってSSRし、chart-table.tsは初期DOMを採用してイベントを付ける。
// 操作用の生データと?owned=の埋め込みレコードは index.astro がJSONで橋渡しする。
import OwnedPanel from './OwnedPanel.astro';
import { speedChartSpriteUrl, type SpeedChartPhysicalRowView } from '../../lib/speed-chart/row-display-model';

interface Props {
	regulation: string;
	ownedId: string | null;
	hasOwnedPanel: boolean;
	embedded?: boolean;
	displayRows: SpeedChartPhysicalRowView[];
}
const { regulation, ownedId, hasOwnedPanel, embedded = false, displayRows } = Astro.props;
import '../../styles/speed-chart-table.css';
---
<section
	class="speed-chart-table"
	data-regulation={regulation}
	data-owned-id={ownedId ?? ''}
	data-has-owned-panel={String(hasOwnedPanel)}
	data-embedded={String(embedded)}
>
	<div class="speed-chart-layout">
		{/* ダメージ詳細パネルは個体調整専用のUI。hasOwnedPanelがfalseのときはレンダリングしない。
		    1200px以上で表の右に常設(sticky)、それ未満では表の上に積む。 */}
		{hasOwnedPanel && (
			<aside class="speed-chart-side panel panel-border-start">
				<OwnedPanel hasOwnedPanel={hasOwnedPanel} ownedId={ownedId} />
				{/* 「とりうるすばやさのみ」トグル。checked/uncheckedの解釈は
				    chart-table.ts側で行う。 */}
			</aside>
		)}

		<div id="speed-chart-minimap" class="speed-chart-minimap" aria-hidden="true">
			<div class="speed-chart-minimap-track">
				{displayRows.filter((row) => row.classNames.includes('speed-chart-row-value-end')).map(() => <span class="speed-chart-minimap-marker"></span>)}
				<div class="speed-chart-minimap-viewport"></div>
			</div>
		</div>

		<div class="panel-content speed-chart-content">
			{/* 列見出しは廃止(自明なため)。上余白は.speed-chart-content側に持たせる。 */}
			<p id="speed-chart-status" class="speed-chart-status loading-center" hidden>読み込み中…</p>
			<div id="speed-chart-rows" class="speed-chart-rows">
				<div id="speed-chart-rows-body">
					{displayRows.map((row) => (
						<div class:list={row.classNames} data-value={row.value} data-base-speed={row.group?.baseSpeed} data-ssr-row>
							<div class="speed-chart-value-cell tnum">{row.valueText}</div>
							{row.group && <>
								<div class="speed-chart-meta-cell">
									<span class="speed-chart-base-speed-label">{row.group.baseSpeedLabel}</span>
									<span class="speed-chart-spread-badge" data-spread={row.group.spreadKind}>{row.group.spreadLabel}</span>
									{row.group.magnitudeLabel && <span class="speed-chart-magnitude-badge">{row.group.magnitudeLabel}</span>}
								</div>
								<div class="speed-chart-chips-cell"><div class="speed-chart-chips-row">
									{row.group.entries.map((entry) => <div class="speed-chart-chip-unit">
										<span class="speed-chart-chip">
											{entry.imageId && <img class="sprite-icon speed-chart-chip-icon" src={speedChartSpriteUrl(entry.imageId)} data-image-id={entry.imageId} alt="" loading="lazy" />}
											<span class="speed-chart-chip-name">{entry.formName}</span>
										</span>
										{entry.originName && <span class="speed-chart-chip-origin">{entry.originName}</span>}
									</div>)}
								</div></div>
							</>}
							{hasOwnedPanel && <div class="speed-chart-owned-cell"></div>}
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initSpeedChartPage } from '../../lib/speed-chart/chart-table';
	void initSpeedChartPage();
</script>
