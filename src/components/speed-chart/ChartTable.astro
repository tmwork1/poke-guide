---
// すばやさ早見表(/speed-chart)本体のテンプレート。
// 実データの取得・行の描画は chart-table.ts に委譲する。
// SSR側(index.astro)はレギュレーション一覧・初期レギュレーション・?owned=の有無だけを
// 渡す。マスターデータ本体・採用率データ・埋め込みレコードは index.astro が
// <script type="application/json"> で埋め込み、data-*属性で chart-table.ts へ橋渡しする。
import OwnedPanel from './OwnedPanel.astro';

interface Props {
	regulation: string;
	ownedId: string | null;
	hasOwnedPanel: boolean;
	embedded?: boolean;
}
const { regulation, ownedId, hasOwnedPanel, embedded = false } = Astro.props;
---
<section
	class="speed-chart-table"
	data-regulation={regulation}
	data-owned-id={ownedId ?? ''}
	data-has-owned-panel={String(hasOwnedPanel)}
	data-embedded={String(embedded)}
>
	<div class="speed-chart-layout">
		{/* 右パネルは個体調整専用のUI。hasOwnedPanelがfalseのときはレンダリングしない。
		    1200px以上で表の右に常設(sticky)、それ未満では表の上に積む。 */}
		{hasOwnedPanel && (
			<aside class="speed-chart-side panel panel-right">
				<OwnedPanel hasOwnedPanel={hasOwnedPanel} ownedId={ownedId} />
				{/* 「とりうるすばやさのみ」トグル。checked/uncheckedの解釈は
				    chart-table.ts側で行う。 */}
			</aside>
		)}

		<div id="speed-chart-minimap" class="speed-chart-minimap" aria-hidden="true">
			<div class="speed-chart-minimap-track">
				<div class="speed-chart-minimap-viewport"></div>
			</div>
		</div>

		<div class="panel-content speed-chart-content">
			{/* 列見出しは廃止(自明なため)。上余白は.speed-chart-content側に持たせる。 */}
			<p id="speed-chart-status" class="speed-chart-status">読み込み中…</p>
			<div id="speed-chart-rows" class="speed-chart-rows" hidden>
				<div id="speed-chart-rows-body"></div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initSpeedChartPage } from '../../lib/speed-chart/chart-table';
	void initSpeedChartPage();
</script>

<style>
	/* 要件A/B: 表(左)と右パネルの2カラム。DOM順は「右パネル → 表」なので、グリッドを
	   適用しない狭幅では右パネルが表の上に積まれる(追加のメディアクエリ不要)。
	   1200px以上でだけグリッドにし、列を明示配置して見た目の左右を入れ替える。
	   右パネル自体がhasOwnedPanel=falseのとき描画されなくなった(テンプレート側で分岐)ため、
	   グリッド定義は data-has-owned-panel='true' のときだけ効くようスコープする。falseのときは
	   .speed-chart-layoutが素のdisplay: blockのままになり、表だけの1カラムになる
	   (:has()は使わず、既存のdata-has-owned-panel属性で分岐する)。 */
	.speed-chart-layout {
		display: block;
	}
	.speed-chart-minimap {
		display: none;
		box-sizing: border-box;
	}
	@media (min-width: 1200px) {
		.speed-chart-layout {
			display: grid;
			/* 俯瞰位置を読み取りやすくするため、従来18pxのミニマップ幅を3倍にする。 */
			grid-template-columns: 54px minmax(0, 1fr);
			align-items: start;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-layout {
			grid-template-columns: 54px minmax(0, 1fr) 260px;
		}
		.speed-chart-minimap {
			display: block;
			grid-column: 1;
			grid-row: 1;
			position: sticky;
			top: var(--topbar-height);
			height: calc(100vh - var(--topbar-height));
			/* 横パディングを除き、トラック右端を表の左端へ隣接させる。 */
			padding: var(--space-2) 0;
		}
		.speed-chart-content {
			grid-column: 2;
			grid-row: 1;
			/* 通常の本文余白は維持しつつ、ミニマップとの間だけ空けない。 */
			padding-left: 0;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-content {
			grid-column: 2;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-side {
			grid-column: 3;
			grid-row: 1;
			position: sticky;
			/* 要件B: 共通トップバー復活により画面上端はposition: sticky; top: 0のトップバーが
			   占有する(高さ--topbar-height、global.cssが:rootと@mediaでデスクトップ/モバイル
			   それぞれの値を公開)。0固定だとトップバーの下に潜り込むため、stickyの吸着位置・
			   高さの上限/下限をすべて--topbar-height分ずらす(値をベタ書きしない)。 */
			top: var(--topbar-height);
			max-height: calc(100vh - var(--topbar-height));
			overflow-y: auto;
			/* 見た目修正3: 中身が短いと.panel-right の帯(背景・左罫線)がページ途中で
			   終わり、その下がページ背景のままになっていた。min-heightを足して画面端まで
			   帯を伸ばす。max-heightと同値にしてあるので、中身がこれを超える場合は
			   従来通りmax-height側が効いてパネル内スクロール(overflow-y: auto)になり、
			   sticky+スクロールの挙動は変わらない(min/max-heightは競合しない別プロパティで
			   どちらを先に書いても結果は同じだが、意図が伝わるようmax-heightの直後に置く)。
			   1200px未満では表の上に積まれるだけなので、このmin-heightはこのメディアクエリの
			   内側にだけ入れる(狭幅で画面高さぶんの空白帯にならないように)。 */
			min-height: calc(100vh - var(--topbar-height));
		}
	}
	.speed-chart-minimap-track {
		position: relative;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-surface-alt);
		cursor: pointer;
	}
	.speed-chart-minimap-viewport {
		position: absolute;
		z-index: 2;
		left: 0;
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--color-primary);
		background: var(--color-primary-soft);
		cursor: grab;
	}

	/* 右パネル本体。 */
	.speed-chart-side {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
	}
	/* 狭幅(1カラム時)は下辺で表と区切る(.panel-rightの左罫線は縦並びでは意味を持たない)。 */
	@media (max-width: 1199px) {
		.speed-chart-side {
			border-left: 0;
			border-bottom: 1px solid var(--color-border);
		}
	}
	/* トグルスイッチ本体は複数ページで使うためglobal.cssの共通定義を参照する。 */
	/* 列構成は「実数値 / 族・配分・倍率 / ポケモン・補正要因」の3列。
	   ?owned= 連携時のみ「調整」を4列目として足す。JS生成行(下の is:global 側)が
	   この列幅を参照するよう、テンプレートをカスタムプロパティで1箇所に持つ
	   (:rootではなく領域ルートに置くので他ページへは漏れない)。 */
	.speed-chart-table {
		--speed-chart-columns: 80px 168px minmax(0, 1fr);
	}
	.speed-chart-table[data-has-owned-panel='true'] {
		--speed-chart-columns: 80px 168px minmax(0, 1fr) 200px;
	}
	.speed-chart-status {
		color: var(--color-text-muted);
		margin: var(--space-4) 0;
	}
	/* サイドバーと表の間に余白。列見出し廃止に伴い、上方向にも余白を確保。 */
	.speed-chart-content {
		padding: var(--space-4) var(--space-5) 0;
	}
	/* 本文の可読幅制限を打ち消す(.panel-contentの1080pxを解除)。
	   表は「横に広いほど良い」ため。 */
	.speed-chart-content {
		max-width: none;
	}
	/* 埋め込み時は「早見表 + 下部調整バー」レイアウト。 */
	.speed-chart-table[data-embedded='true'] {
		height: 100%;
		min-height: 0;
	}
	.speed-chart-table[data-embedded='true'] .speed-chart-layout {
		display: grid;
		height: 100%;
		min-height: 0;
		grid-template: minmax(0, 1fr) auto / minmax(0, 1fr);
	}
	.speed-chart-table[data-embedded='true'] .speed-chart-content {
		grid-column: 1;
		grid-row: 1;
		min-height: 0;
		overflow-y: auto;
		padding: var(--space-3) var(--space-4);
	}
	.speed-chart-table[data-embedded='true'] .speed-chart-minimap {
		display: none;
	}
	.speed-chart-table[data-embedded='true'][data-has-owned-panel='true'] .speed-chart-side {
		grid-column: 1;
		grid-row: 2;
		position: static;
		min-height: 0;
		max-height: 172px;
		overflow: auto;
		padding: var(--space-2) var(--space-3);
		border-top: 1px solid var(--color-border);
		border-bottom: 0;
		background: var(--color-surface-alt);
	}
	/* 個体の更新操作は、対象の実数値と対応づけて読めるよう実数値セルの直下へ置く。 */
	.speed-chart-table[data-embedded='true'] .speed-chart-row {
		grid-template-rows: auto auto;
		row-gap: var(--space-2);
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-cell) {
		grid-column: 1;
		grid-row: 2;
		align-self: start;
		justify-self: center;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned) {
		align-items: center;
		min-height: 30px;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-apply-button) {
		box-sizing: border-box;
		display: grid;
		min-width: 64px;
		min-height: 38px;
		padding: var(--space-1) var(--space-2);
		line-height: 1.15;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-apply-label) {
		display: grid;
		gap: 2px;
		white-space: nowrap;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-apply-label > :first-child) {
		font-size: 0.625rem;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary) {
		display: grid;
		grid-template-columns: 56px minmax(105px, 1fr) minmax(72px, auto) minmax(112px, auto);
		grid-template-rows: auto auto;
		align-items: center;
		column-gap: var(--space-3);
		row-gap: var(--space-2);
		width: 100%;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-profile) {
		grid-column: 1;
		grid-row: 1;
		width: auto;
		padding: 0;
		background: transparent;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-header) { align-self: auto; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-sprite) { width: 48px; height: 48px; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-edit-button),
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-species),
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-profile .speed-chart-owned-summary-badges) { display: none; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary > .speed-chart-owned-summary-badges) {
		grid-column: 2;
		grid-row: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-raw-value) {
		display: grid;
		grid-column: 3;
		grid-row: 1;
		gap: 2px;
		font-size: var(--font-size-sm3);
		white-space: nowrap;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-raw-value strong) { font-size: var(--font-size-sm1); }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-value-row) {
		grid-column: 4;
		grid-row: 1;
		align-items: center;
		gap: var(--space-1);
		white-space: nowrap;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-value)::before {
		content: '補正後';
		display: block;
		font-size: var(--font-size-sm3);
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-value) {
		display: grid;
		gap: 2px;
		font-size: var(--font-size-sm1);
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-controls) {
		display: flex;
		grid-column: 1 / -1;
		grid-row: 2;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		width: 100%;
		padding-top: var(--space-1);
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-modifier-toggles) {
		order: 1;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: nowrap;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field) {
		order: 2;
		margin-left: auto;
		display: grid;
		grid-template-columns: var(--space-6) 3.4em var(--space-6);
		align-items: center;
		gap: var(--space-1);
		flex: 0 0 auto;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field > label) { display: none; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-modifier-consider) { display: none; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field > input) { grid-column: 2; }
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field .rank-stepper-group) { display: contents; }
	:global(.speed-chart-table[data-embedded='true'] #speed-chart-rank-decrement) { grid-column: 1; grid-row: 1; }
	:global(.speed-chart-table[data-embedded='true'] #speed-chart-rank-increment) { grid-column: 3; grid-row: 1; }
	/* 個体編集の努力値調整と同じ、角張った枠付きの−/＋ボタンにそろえる。 */
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field .rank-stepper) {
		box-sizing: border-box;
		width: 30px;
		min-width: 30px;
		height: 30px;
		min-height: 30px;
		padding: 0;
		color: var(--color-text-muted);
		background: var(--color-surface-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-zero);
		font-size: var(--font-size-sm1);
		font-weight: 400;
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field .rank-stepper:hover:not(:disabled)) {
		background: var(--color-surface);
		color: var(--color-text);
	}
	:global(.speed-chart-table[data-embedded='true'] .speed-chart-rank-field input[type='number']) {
		height: 30px;
		min-height: 30px;
		padding: 0 var(--space-1);
		line-height: 1;
		background: var(--color-surface);
	}
	@media (max-width: 699px) {
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary) {
			grid-template-columns: 44px minmax(72px, 1fr) minmax(48px, auto) minmax(78px, auto);
			column-gap: var(--space-1);
		}
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-sprite) { width: 40px; height: 40px; }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary > .speed-chart-owned-summary-badges) { gap: 2px; }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary > .speed-chart-owned-summary-badges .badge) { padding: 0.15em 0.35em; font-size: 0.6875rem; }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-summary-value-row) { flex-wrap: nowrap; }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-jump-button) { padding: 0.15em 0.3em; }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-controls) { gap: var(--space-2); }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-modifier-toggles) { gap: var(--space-2); }
		:global(.speed-chart-table[data-embedded='true'] .speed-chart-owned-modifier-toggle) { gap: var(--space-1); }
	}
</style>

<style is:global>
	/* chart-table.ts が再描画ごとに生成する、実数値グループ境界の密度マーカー。 */
	.speed-chart-table .speed-chart-minimap-marker {
		position: absolute;
		z-index: 1;
		left: 1px;
		right: 1px;
		height: 1px;
		background: var(--color-text-muted);
		opacity: 0.35;
		pointer-events: none;
	}
	.speed-chart-table .speed-chart-minimap.is-dragging,
	.speed-chart-table .speed-chart-minimap.is-dragging .speed-chart-minimap-viewport {
		cursor: grabbing;
		user-select: none;
	}

	.speed-chart-table .speed-chart-row {
		display: grid;
		grid-template-columns: var(--speed-chart-columns);
		gap: var(--space-4);
		padding: var(--space-2) 0;
		align-items: center;
	}
	/* 補正要因が2段目にある行だけは、数値・メタ情報をチップの上端に揃える。 */
	.speed-chart-table .speed-chart-row:has(.speed-chart-chip-origin) {
		align-items: start;
	}
	/* 補正要因があっても実数値グループが1段だけなら、1・2列目を行の垂直中央へ戻す。 */
	.speed-chart-table .speed-chart-row.speed-chart-row-single-group {
		align-items: center;
	}
	.speed-chart-table .speed-chart-row.speed-chart-row-value-end {
		border-bottom: 1px solid var(--color-border);
	}
	.speed-chart-table .speed-chart-row.is-current-row {
		background: var(--color-success-soft);
	}
	/* 実数値: 同じページ内に「ポケモン群」「この個体」という他の主コンテンツが並ぶ比較用の表
	   なので、00-foundation.mdの「脇役の数値グリッド」区分(16.8px=1.05em/700)を採用する
	   (/box/[id]の.stat-row-realと同じ階層)。列幅(80px)に対して数値だけが左寄りだと
	   詰まって見えるため中央寄せにする。 */
	.speed-chart-table .speed-chart-value-cell {
		font-size: var(--font-size-lg1);
		font-weight: 700;
		padding-top: 0;
		text-align: center;
		padding-left: var(--space-2);
		padding-right: var(--space-2);
	}
	/* 2列目: 族(すばやさ種族値)・配分バッジ(最速/準速/無振り)・倍率(x1.5等)を1行に。
	   3列目の1段目(ポケモンチップ)と視覚的な高さが揃うよう、チップのpadding分だけ
	   上に余白を持たせる。
	   要件D: 太字はやめ(バッジ.speed-chart-spread-badgeだけは既存の太字意匠を維持、下で個別に
	   font-weight: 700を指定)、文字サイズを1段上げる(--font-size-sm3 → --font-size-sm2)。 */
	.speed-chart-table .speed-chart-meta-cell {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35em;
		min-width: 0;
		padding-top: 0;
		font-size: var(--font-size-sm2);
		font-weight: 500;
		color: var(--color-text);
		line-height: var(--line-height-snug);
	}
	.speed-chart-table .speed-chart-base-speed-label {
		color: var(--color-text-muted);
		font-weight: 500;
		font-size: var(--font-size-sm1);
	}
	/* 3列目: ポケモンを1段目、その補正要因を2段目・左寄せ(チップの並び自体は左寄せのまま)。 */
	.speed-chart-table .speed-chart-chips-cell {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		min-width: 0;
	}
	/* 要件E: 補正要因は「グループに1つ」ではなく「チップ(=ポケモン)ごとに1つ」表示する
	   (chart-table.tsが.speed-chart-chip-unitでチップと要因を1組にまとめて出す。
	   旧.speed-chart-group-originはグループ単位1個描画だったため廃止)。
	   1組の中で要因をチップの下・中央揃えにする。 */
	.speed-chart-table .speed-chart-chip-unit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}
	/* 補正要因(特性名/わざ名/持ち物名)。ポケモンより一段軽い扱い(色を薄く・太字にしない)に
	   して「ポケモンが主・要因が補足」という情報の主従を示す。補正なしグループ(素の実数値)には
	   要因が無いため、その場合はこの要素自体を出力しない(chart-table.ts参照)。 */
	.speed-chart-table .speed-chart-chip-origin {
		font-size: var(--font-size-sm3);
		font-weight: 500;
		color: var(--color-text-muted);
