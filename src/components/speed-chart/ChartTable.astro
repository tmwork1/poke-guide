---
// すばやさ早見表(/speed-chart)本体のテンプレート(確定した設計のファイル分割表:
// 「表全体のテンプレート(3列とも含む)」)。実データの取得・行の描画は一切ここでは行わず、
// src/lib/speed-chart/chart-table.ts(<script>からimportして呼び出すだけ)に委譲する。
// SSR側(index.astro)はレギュレーション一覧・初期レギュレーション・?owned=の有無だけを
// このコンポーネントへ渡す。マスターデータ本体・採用率データ・埋め込みレコードは
// index.astro が <script type="application/json"> で直接埋め込む(このコンポーネントの
// 外側)ため、ここではdata-*属性だけを介してchart-table.tsへ橋渡しする。
//
// UI改修(2026-08-02 第3弾。ユーザー指示):
//   1. 常設UI(レギュレーション選択・実数値ジャンプ)は共通トップバー(index.astro側が
//      hideTopbarをやめてAppLayoutの<header class="app-topbar">を復活させる)へ移した。
//      このコンポーネントはもう持たない(id="speed-chart-regulation-select"/
//      "speed-chart-jump-input" はAppLayout側のトップバーに存在する)。
//   2. 右パネル(.speed-chart-side)は個体調整専用のUIだけにする: OwnedPanel(個体情報)→
//      「とりうるすばやさのみ」トグル。ハンバーガー・戻るリンクは
//      共通トップバー復活により不要(id重複を避けるためこのファイルからは削除)。
//      UI改修依頼(2026-08-02)「現在地へ戻るボタンを削除し、すばやさxxx表示自体をボタン化する」:
//      旧#speed-chart-back-to-currentボタンはOwnedPanel.astroの「すばやさ xxx」表示
//      (#speed-chart-owned-summary-value)がボタン化されて同じ役割を引き継いだため、
//      このファイル内の記述からは外した(要素自体はDOM保持のままCSSで非表示。下記参照)。
//   3. hasOwnedPanelがfalseのときは右パネル自体をレンダリングしない(空の帯を防ぐ)。
//      その場合レイアウトは1カラムになる(data-has-owned-panel属性で分岐、:has()は使わない)。
//   4. トップバーが復活しsticky(position: sticky; top: 0)で常に画面上端に残るため、
//      右パネルのsticky位置は--topbar-height(global.cssが:rootと@mediaで公開)ぶん
//      下げる。表のヘッダー行(.speed-chart-columns-header)は自明な列名のため廃止。
//   5. 2列目(族・配分・倍率)は太字をやめ、文字サイズを1段上げる。
//   6. 3列目の補正要因は、グループ単位ではなくポケモンのチップごとに中央揃えで表示する
//      (chart-table.ts側が.speed-chart-chip-unitでチップと要因を1組にまとめて出す)。
import OwnedPanel from './OwnedPanel.astro';

interface Props {
	regulation: string;
	ownedId: string | null;
	hasOwnedPanel: boolean;
}
const { regulation, ownedId, hasOwnedPanel } = Astro.props;
---
<section
	class="speed-chart-table"
	data-regulation={regulation}
	data-owned-id={ownedId ?? ''}
	data-has-owned-panel={String(hasOwnedPanel)}
>
	<div class="speed-chart-layout">
		{/* 右パネルは「個体調整専用のUI」だけ(要件): OwnedPanel(個体情報)→
		    「現在地へ戻る」→「とりうるすばやさのみ」トグル。常設UI(レギュレーション・
		    実数値ジャンプ)は共通トップバー(index.astro/AppLayout)に移ったのでここには置かない。
		    hasOwnedPanelがfalseのとき(?owned=なし)は個体調整の対象が無いため、右パネル自体を
		    レンダリングしない(空の帯が残るのを防ぐ。1200px以上のグリッド定義も
		    data-has-owned-panel='true'の場合だけ効くようスコープしてある。下のstyle参照)。
		    1200px以上で表の右に常設(sticky)、それ未満では表の上に積む(DOM順が
		    パネル→表なので、狭幅ではメディアクエリ無しでそのまま上に来る)。
		    2カラム化の閾値を900pxではなく1200pxにしているのは、サイドバー256px+
		    右パネル分を引いた残りにこの表(4列)を入れると900px前後では列が潰れるため
		    (pitfalls.md「左右2カラムの新規ページは最初から1200pxに揃える」)。 */}
		{hasOwnedPanel && (
			<aside class="speed-chart-side panel panel-right">
				<OwnedPanel hasOwnedPanel={hasOwnedPanel} ownedId={ownedId} />
				{/* UI改修依頼(すばやさ早見表、2026-08-02)「現在地へ戻るボタンを削除し、
				    すばやさxxx表示自体をボタン化して同じ動作を担わせる」: このボタンの機能は
				    OwnedPanel.astroの「すばやさ xxx」表示(#speed-chart-owned-summary-value)へ
				    移した。src/lib/speed-chart/chart-table.tsから引き続きid参照されている
				    (pitfalls.md「要素を消す指示はDOMを残しCSSで見せない方針にする」)ため、
				    要素自体は削除せずhidden属性で非表示にする(クリックハンドラの登録先も
				    chart-table.ts側でこの新しいボタンへ切り替え済み)。 */}
				<button type="button" id="speed-chart-back-to-current" class="speed-chart-side-button" hidden>現在地へ戻る</button>
				<label class="speed-chart-reachable-toggle">
					<span class="toggle-switch">
						{/* UI改修(2026-08-02第4弾)要件3: 「とりうるすばやさのみ」(絞り込み)から
						    「すべて表示」(展開)へ意味を反転させる。idは変えない(chart-table.tsが
						    参照)。checkedを外し既定OFF=絞り込み表示のまま、ONで全件表示にする
						    (checked/uncheckedの解釈反転はchart-table.ts側の担当)。 */}
						<input type="checkbox" id="speed-chart-reachable-only-toggle" class="toggle-switch-input" aria-label="すべて表示" />
						<span class="toggle-switch-track" aria-hidden="true">
							<span class="toggle-switch-thumb"></span>
						</span>
					</span>
					<span>すべて表示</span>
				</label>
			</aside>
		)}

		<div id="speed-chart-minimap" class="speed-chart-minimap" aria-hidden="true">
			<div class="speed-chart-minimap-track">
				<div class="speed-chart-minimap-viewport"></div>
			</div>
		</div>

		<div class="panel-content speed-chart-content">
			{/* 要件C: 列見出し(実数値/族・配分・倍率/…)は自明なので廃止。表の1行目が
			    直接来るため、詰まりすぎないよう.speed-chart-content側に上余白を持たせる
			    (下のstyleブロック参照)。 */}
			<p id="speed-chart-status" class="speed-chart-status">読み込み中...</p>
			<div id="speed-chart-rows" class="speed-chart-rows" hidden>
				<div id="speed-chart-rows-body"></div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initSpeedChartPage } from '../../lib/speed-chart/chart-table';
	void initSpeedChartPage();
</script>

<style>
	/* 要件A/B: 表(左)と右パネルの2カラム。DOM順は「右パネル → 表」なので、グリッドを
	   適用しない狭幅では右パネルが表の上に積まれる(追加のメディアクエリ不要)。
	   1200px以上でだけグリッドにし、列を明示配置して見た目の左右を入れ替える。
	   右パネル自体がhasOwnedPanel=falseのとき描画されなくなった(テンプレート側で分岐)ため、
	   グリッド定義は data-has-owned-panel='true' のときだけ効くようスコープする。falseのときは
	   .speed-chart-layoutが素のdisplay: blockのままになり、表だけの1カラムになる
	   (:has()は使わず、既存のdata-has-owned-panel属性で分岐する)。 */
	.speed-chart-layout {
		display: block;
	}
	.speed-chart-minimap {
		display: none;
		box-sizing: border-box;
	}
	@media (min-width: 1200px) {
		.speed-chart-layout {
			display: grid;
			/* 俯瞰位置を読み取りやすくするため、従来18pxのミニマップ幅を3倍にする。 */
			grid-template-columns: 54px minmax(0, 1fr);
			align-items: start;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-layout {
			grid-template-columns: 54px minmax(0, 1fr) 260px;
		}
		.speed-chart-minimap {
			display: block;
			grid-column: 1;
			grid-row: 1;
			position: sticky;
			top: var(--topbar-height);
			height: calc(100vh - var(--topbar-height));
			/* 横パディングを除き、トラック右端を表の左端へ隣接させる。 */
			padding: var(--space-2) 0;
		}
		.speed-chart-content {
			grid-column: 2;
			grid-row: 1;
			/* 通常の本文余白は維持しつつ、ミニマップとの間だけ空けない。 */
			padding-left: 0;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-content {
			grid-column: 2;
		}
		.speed-chart-table[data-has-owned-panel='true'] .speed-chart-side {
			grid-column: 3;
			grid-row: 1;
			position: sticky;
			/* 要件B: 共通トップバー復活により画面上端はposition: sticky; top: 0のトップバーが
			   占有する(高さ--topbar-height、global.cssが:rootと@mediaでデスクトップ/モバイル
			   それぞれの値を公開)。0固定だとトップバーの下に潜り込むため、stickyの吸着位置・
			   高さの上限/下限をすべて--topbar-height分ずらす(値をベタ書きしない)。 */
			top: var(--topbar-height);
			max-height: calc(100vh - var(--topbar-height));
			overflow-y: auto;
			/* 見た目修正3: 中身が短いと.panel-right の帯(背景・左罫線)がページ途中で
			   終わり、その下がページ背景のままになっていた。min-heightを足して画面端まで
			   帯を伸ばす。max-heightと同値にしてあるので、中身がこれを超える場合は
			   従来通りmax-height側が効いてパネル内スクロール(overflow-y: auto)になり、
			   sticky+スクロールの挙動は変わらない(min/max-heightは競合しない別プロパティで
			   どちらを先に書いても結果は同じだが、意図が伝わるようmax-heightの直後に置く)。
			   1200px未満では表の上に積まれるだけなので、このmin-heightはこのメディアクエリの
			   内側にだけ入れる(狭幅で画面高さぶんの空白帯にならないように)。 */
			min-height: calc(100vh - var(--topbar-height));
		}
	}
	.speed-chart-minimap-track {
		position: relative;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-surface-alt);
		cursor: pointer;
	}
	.speed-chart-minimap-viewport {
		position: absolute;
		z-index: 2;
		left: 0;
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--color-primary);
		background: var(--color-primary-soft);
		cursor: grab;
	}

	/* 右パネル本体。個体調整専用のUI(OwnedPanel/現在地へ戻る/とりうるすばやさのみ)を縦に積む。 */
	.speed-chart-side {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
	}
	/* 狭幅(1カラム時)は下辺で表と区切る(.panel-rightの左罫線は縦並びでは意味を持たない)。 */
	@media (max-width: 1199px) {
		.speed-chart-side {
			border-left: 0;
			border-bottom: 1px solid var(--color-border);
		}
	}
	.speed-chart-side-button {
		align-self: flex-start;
	}
	/* UI改修依頼(すばやさ早見表、2026-08-02): 上のhidden属性を確実に効かせる。このクラス自体は
	   displayを明示していないため[hidden]のUA既定(display:none)で足りるはずだが、
	   pitfalls.md「[hidden]は詳細度で負ける」の教訓により念のため明示しておく。 */
	.speed-chart-side-button[hidden] {
		display: none;
	}

	/* トグルスイッチ本体は複数ページで使うためglobal.cssの共通定義を参照する。
	   UI改修(2026-08-02第2弾)要件1: 「すばやさ上昇要因を表示」トグルは廃止し常に表示する
	   ようにしたため、ここに残るのは「とりうるすばやさのみ」(?owned=連携時のみ)だけ。 */
	.speed-chart-reachable-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		cursor: pointer;
		/* UI改修(2026-08-02第4弾)要件3: ラベルの文字サイズを一段上げる(--font-size-xs →
		   --font-size-sm)。「すべて表示」に文言変更した際、他の右パネル要素と比べて
		   小さすぎて目立たなかったため。 */
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
	}
	/* 列構成は「実数値 / 族・配分・倍率 / ポケモン・補正要因」の3列。
	   ?owned= 連携時のみ「調整」を4列目として足す。JS生成行(下の is:global 側)が
	   この列幅を参照するよう、テンプレートをカスタムプロパティで1箇所に持つ
	   (:rootではなく領域ルートに置くので他ページへは漏れない)。 */
	.speed-chart-table {
		--speed-chart-columns: 80px 168px minmax(0, 1fr);
	}
	.speed-chart-table[data-has-owned-panel='true'] {
		--speed-chart-columns: 80px 168px minmax(0, 1fr) 200px;
	}
	.speed-chart-status {
		color: var(--color-text-muted);
		margin: var(--space-4) 0;
	}
	/* サイドバーと表の間に余白を設ける(/box/[id]の.box-content { padding: 0 var(--space-5); }
	   と同種)。要件C: 列見出し(.speed-chart-columns-header)を廃止し表の1行目が直接来る
	   ようになったため、上端が詰まりすぎないよう上方向にも余白を確保する
	   (旧見出し行が持っていたpadding-top: var(--space-3)相当)。 */
	.speed-chart-content {
		padding: var(--space-4) var(--space-5) 0;
	}
	/* 見た目修正1: このラッパーは共有クラス.panel-content(global.css)を持ち、
	   本文の可読幅を1080pxに制限する前提が付いている。しかしこの表は「横に広いほど良い」
	   (3列目のポケモンチップが幅で足切りされ「+N件」表示が多発する)ため、
	   このページに限り上限を意図的に打ち消す。scoped styleは[data-astro-cid-*]付与により
	   .panel-contentより詳細度で確実に勝つ(global.css自体は編集しない)。 */
	.speed-chart-content {
		max-width: none;
	}
</style>

<style is:global>
	/* chart-table.ts が再描画ごとに生成する、実数値グループ境界の密度マーカー。 */
	.speed-chart-table .speed-chart-minimap-marker {
		position: absolute;
		z-index: 1;
		left: 1px;
		right: 1px;
		height: 1px;
		background: var(--color-text-muted);
		opacity: 0.35;
		pointer-events: none;
	}
	.speed-chart-table .speed-chart-minimap.is-dragging,
	.speed-chart-table .speed-chart-minimap.is-dragging .speed-chart-minimap-viewport {
		cursor: grabbing;
		user-select: none;
	}

	/* --- 行・グループ・チップ(src/lib/speed-chart/chart-table.ts が動的生成する要素) ---
	   pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」への対応。
	   領域ルートクラス .speed-chart-table で必ず絞る(確定仕様)。
	   UI改修(2026-08-02第2弾)要件2: 1物理行 = 1グループ(振り方+補正の組)になった
	   (以前は1物理行=1族で、族の中の複数グループを縦に積んでいた)。族・配分・倍率は
	   2列目に、ポケモンと補正要因は3列目に分かれる。同じ実数値に属する行は
	   .speed-chart-row-value-end が付いた最後の行の下にだけ罫線を引く。 */
	.speed-chart-table .speed-chart-row {
		display: grid;
		grid-template-columns: var(--speed-chart-columns);
		gap: var(--space-4);
		/* UI改修(2026-08-02第5弾)要件3: 1つの実数値の中に族(baseSpeed)ごとの行が縦に並ぶ
		   構成で、var(--space-3)は段間が間延びして見えたため1段詰める(var(--space-2))。
		   実数値のまとまり自体は.speed-chart-row-value-endの罫線(下記)で区切られており、
		   段間パディングを詰めても罫線がある限りグルーピングは読み取れる(1920px・390px
		   双方でスクリーンショット確認済み)。 */
		padding: var(--space-2) 0;
		align-items: center;
	}
	/* 補正要因が2段目にある行だけは、数値・メタ情報をチップの上端に揃える。 */
	.speed-chart-table .speed-chart-row:has(.speed-chart-chip-origin) {
		align-items: start;
	}
	/* 補正要因があっても実数値グループが1段だけなら、1・2列目を行の垂直中央へ戻す。 */
	.speed-chart-table .speed-chart-row.speed-chart-row-single-group {
		align-items: center;
	}
	.speed-chart-table .speed-chart-row.speed-chart-row-value-end {
		border-bottom: 1px solid var(--color-border);
	}
	.speed-chart-table .speed-chart-row.is-current-row {
		background: var(--color-success-soft);
	}
	/* 実数値: 同じページ内に「ポケモン群」「この個体」という他の主コンテンツが並ぶ比較用の表
	   なので、00-foundation.mdの「脇役の数値グリッド」区分(16.8px=1.05em/700)を採用する
	   (/box/[id]の.stat-row-realと同じ階層)。列幅(80px)に対して数値だけが左寄りだと
	   詰まって見えるため中央寄せにする。 */
	.speed-chart-table .speed-chart-value-cell {
		font-size: 1.05em;
		font-weight: 700;
		padding-top: 0;
		text-align: center;
		padding-left: var(--space-2);
		padding-right: var(--space-2);
	}
	/* 2列目: 族(すばやさ種族値)・配分バッジ(最速/準速/無振り)・倍率(x1.5等)を1行に。
	   3列目の1段目(ポケモンチップ)と視覚的な高さが揃うよう、チップのpadding分だけ
	   上に余白を持たせる。
	   要件D: 太字はやめ(バッジ.speed-chart-spread-badgeだけは既存の太字意匠を維持、下で個別に
	   font-weight: 700を指定)、文字サイズを1段上げる(--font-size-xs → --font-size-sm)。 */
	.speed-chart-table .speed-chart-meta-cell {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35em;
		min-width: 0;
		padding-top: 0;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
		line-height: 1.4;
	}
	.speed-chart-table .speed-chart-base-speed-label {
		color: var(--color-text-muted);
		font-weight: 500;
		font-size: var(--font-size-md);
	}
	/* 3列目: ポケモンを1段目、その補正要因を2段目・左寄せ(チップの並び自体は左寄せのまま)。 */
	.speed-chart-table .speed-chart-chips-cell {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		min-width: 0;
	}
	/* 要件E: 補正要因は「グループに1つ」ではなく「チップ(=ポケモン)ごとに1つ」表示する
	   (chart-table.tsが.speed-chart-chip-unitでチップと要因を1組にまとめて出す。
	   旧.speed-chart-group-originはグループ単位1個描画だったため廃止)。
	   1組の中で要因をチップの下・中央揃えにする。 */
	.speed-chart-table .speed-chart-chip-unit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}
	/* 補正要因(特性名/わざ名/持ち物名)。ポケモンより一段軽い扱い(色を薄く・太字にしない)に
	   して「ポケモンが主・要因が補足」という情報の主従を示す。補正なしグループ(素の実数値)には
	   要因が無いため、その場合はこの要素自体を出力しない(chart-table.ts参照)。 */
	.speed-chart-table .speed-chart-chip-origin {
		font-size: var(--font-size-xs);
		font-weight: 500;
