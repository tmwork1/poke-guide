---
// すばやさ早見表(/speed-chart)「この個体」領域の静的テンプレート部分。
// 確定した設計のファイル分割表: 「凡例・個体サマリ・エラー表示のテンプレート」。
// R-13により「この個体」列自体は独立したカラムではなく、ChartTable.astro が組み立てる各行の
// 3列目のセルとして描かれる(実際のセルDOMは src/lib/speed-chart/owned-panel.ts が
// document.createElement() で生成する)。このコンポーネントが担うのは行の外にある
// 常設のUI(R-9凡例、個体サマリ、R-10保存失敗バナー)だけ。
//
// 個体サマリの中身は、SSR時点ではまだ種族値・スプライトID
// (public/master-data/detail・autocomplete/pokemon.json、ブラウザ側でfetchする設計)が無く
// 計算できないため、空のプレースホルダとして描画し、owned-panel.ts の初期化完了時にテキスト・
// 画像srcを差し込む(id経由。テーブル本体が「読み込み中...」→行描画に切り替わるのと同じ
// 非同期パターン)。
//
// UI改修(2026-08-02第3弾)要件1: 右パネルを「個体調整専用」にする一環で、個体サマリを
// 上から5段構成に組み替えた: ①アイコン ②ニックネーム ③特性・アイテム ④性格・努力値
// ⑤S実数値。旧「この個体:」ラベル+種族名+性格/持ち物バッジ+S実数値の4段構成から、
// アイコン段を追加し性格/持ち物バッジ段を「特性・アイテム」「性格・努力値」の2段に
// 分割した(バッジ4つを1行に詰め込むと260px幅で窮屈になるため)。
interface Props {
  hasOwnedPanel: boolean;
  /**
   * UI改修(2026-08-02第4弾)要件1: アイコン右の編集ボタン(/box/<id>への遷移)用。
   * ChartTable.astro が data-owned-id を持つ ownedId をそのまま渡す(?owned=なしのときは
   * null で、その場合ボタン自体を出さない)。
   */
  ownedId: string | null;
}
const { hasOwnedPanel, ownedId } = Astro.props;
---
<div class="speed-chart-owned-panel-static">
	{hasOwnedPanel && (
		<div class="speed-chart-owned-summary" id="speed-chart-owned-summary">
			{/* UI改修(2026-08-02第4弾)要件1: アイコン(1段目)の右に個体編集(/box/<id>)への
			    編集ボタンを並べる。img自体のid/classは変えない(owned-panel.tsがid経由で
			    src/hiddenを出し分けるため)。ラッパーはこの段専用(2段目以降には影響しない)。 */}
			<div class="speed-chart-owned-summary-header">
				<img id="speed-chart-owned-summary-sprite" class="sprite-icon speed-chart-owned-summary-sprite" alt="" hidden />
				{ownedId && (
					<a class="btn-ghost speed-chart-owned-edit-button" href={`/box/${ownedId}`} aria-label="個体を編集">
						{/* pitfalls.md「配色」節: 新しい色は作らずfill="none" stroke="currentColor"で
						    ボタンの文字色を継承させる。パスはteam/[id].astroの編集リンク
						    (slot-edit-link)と同じ鉛筆アイコンを再利用し、アイコンの意匠を統一する。 */}
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
							<path d="m15 5 4 4" />
						</svg>
						編集
					</a>
				)}
			</div>
			<span id="speed-chart-owned-summary-species" class="speed-chart-owned-summary-species"></span>
			<span class="speed-chart-owned-summary-badges">
				<span id="speed-chart-owned-summary-ability" class="badge badge-muted"></span>
				<span id="speed-chart-owned-summary-item" class="badge badge-muted"></span>
			</span>
			<span class="speed-chart-owned-summary-badges">
				<span id="speed-chart-owned-summary-nature" class="badge badge-muted"></span>
				<span id="speed-chart-owned-summary-evs" class="badge badge-muted"></span>
			</span>
			<span id="speed-chart-owned-summary-value" class="tnum speed-chart-owned-summary-value"></span>
		</div>
	)}
	{/*
		不具合修正(2026-08-02): ?owned=個体の種族が選択中レギュレーションの母集団に
		存在しない(例: フィクスチャのハバタクカミのようにregulationsが空配列)と、
		chart-table.tsのrender()内でformsByName.get()がundefinedになりownedControllerが
		nullのままになる。その結果owned-panel.tsのupdateSummary()が一度も呼ばれず、
		#speed-chart-owned-summaryは中身の無い灰色の箱として残ってしまう
		(pitfalls.md「空状態・0件・未入力を必ず見る」= 「データ破損に見える空箱」)。
		既定hiddenの注記をここに用意しておき、chart-table.ts側でownedControllerの
		有無に応じてこの要素とサマリ本体のhiddenを出し分ける(render()はレギュレーション
		切替のたびに呼ばれるため、切替で母集団に入った/出た場合も追随する)。
		レギュレーション名はハードコードしない(切替のたびに対象が変わるため)。
	*/}
	{hasOwnedPanel && (
		<p class="speed-chart-owned-unavailable" id="speed-chart-owned-unavailable" hidden>
			この個体(種族)は選択中のレギュレーションでは使えないため、調整候補を出せません。
		</p>
	)}
	{hasOwnedPanel && (
		<p class="severity-bar" data-severity="lethal" id="speed-chart-owned-error" hidden></p>
	)}
</div>

<style>
	/* 静的マークアップ(scoped styleで足りる。JS生成されるのは行内の「この個体」セルのみで、
	   これらの要素とは別)。
	   UI改修(2026-08-02第2弾): 旧トップバー(画面幅いっぱいの帯)から幅260pxの
	   サイドバー(ChartTable.astroの.speed-chart-side、gap: var(--space-4)で
	   縦に項目を積む)最下段のカードへ移植。帯前提だった左右padding・border-bottomは
	   やめ、サイドバー内の1ブロックとして自己完結する角丸カード(.cardと同じ
	   --radius-md、背景はそのまま.speed-chart-side自体の背景(--color-surface)に対して
	   区別が付く--color-surface-altを踏襲)にする。 */
	.speed-chart-owned-panel-static {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-3);
		background: var(--color-surface-alt);
		border-radius: var(--radius-md);
		font-size: var(--font-size-sm);
	}
	/* hasOwnedPanel=falseのときは子要素が一切描画されず空になる。空の背景ボックスだけが
	   サイドバーに残らないよう、空のときはこの要素自体を消す。 */
	.speed-chart-owned-panel-static:empty {
		display: none;
	}
	/* 幅260pxではニックネーム・特性/アイテム・性格/努力値・S実数値を横一列
	   (旧flex-wrap)に並べると1文字ずつ折り返されて潰れる(pitfalls.md「潰れて
	   読めなくなる破綻」)。各段を縦積みにする(長い名前は行内で2行に折り返すのは
	   許容)。 */
	.speed-chart-owned-summary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
	}
	/* 不具合修正(2026-08-02): 母集団に居ない個体のときchart-table.tsがhidden属性を立てる
	   (「データ破損に見える空箱」を防ぐため)。displayをflexで明示しているクラスなので、
	   pitfalls.mdの罠どおり[hidden]の詳細度勝ち負けが起きる。明示的に上書きする。 */
	.speed-chart-owned-summary[hidden] {
		display: none;
	}
	/* UI改修(2026-08-02第4弾)要件1: アイコンと編集ボタンを横並びにするラッパー(1段目)。
	   カード全体が左揃えのため、ラッパー自体も左寄せのまま子要素だけ横に並べる。 */
	.speed-chart-owned-summary-header {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	/* アイコン段(1段目)。48〜56pxの正方形。カード全体が左揃え
	   (align-items: flex-start)のため画像も左寄せに揃える。src/hiddenの出し分けは
	   owned-panel.tsが行う(spriteImageIdが無い個体はhiddenのまま=何も表示しない)。 */
	.speed-chart-owned-summary-sprite {
		width: 52px;
		height: 52px;
	}
	/* 編集ボタン。global.cssの a.btn-ghost(枠なし・透明背景・ホバーでsurface-alt)をそのまま
	   使い、新しい配色は作らない。260px幅のカード内でも詰まらないよう、既存のbutton基底より
	   ひとまわり小さいpaddingにページ限定で調整する(a.btn-ghost自体はglobal.css編集禁止のため
	   触らない)。 */
	.speed-chart-owned-edit-button {
		padding: 0.2em 0.6em;
		font-size: var(--font-size-xs);
		font-weight: 600;
		flex-shrink: 0;
	}
	.speed-chart-owned-summary-species {
		font-weight: 700;
	}
	/* 特性/アイテム(3段目)・性格/努力値(4段目)の2項目バッジは、.badgeの左paddingぶん
	   単独で縦積みにするとニックネーム・実数値(いずれもpaddingなしの素のテキスト)と
	   左端がズレて見える(実測でインデントが揃わない不具合)。2つのバッジを1つの行に
	   まとめて横並びにすることで、この行自体は他の行と同じくpaddingなしで左端0から
	   始まり、「バッジが並ぶ1行」であることが視覚的にも明確になる。260px幅では
	   折り返さず収まる想定だが、念のためflex-wrapは許容しておく(1文字ずつの折り返しには
	   ならない)。 */
	.speed-chart-owned-summary-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1);
	}
	.speed-chart-owned-summary-value {
		font-weight: 700;
		font-size: var(--font-size-md);
		color: var(--color-primary-strong);
	}
	/* .severity-bar[data-severity]は基底(global.css)がdisplay指定を持たないブロック要素なので、
	   [hidden]の詳細度勝ち負けは発生しない(pitfalls.mdの罠は「displayを明示したクラス」限定)。
	   念のため明示しておく。 */
	.severity-bar[hidden] {
		display: none;
	}
	/* 不具合修正(2026-08-02): 個体サマリの代わりに出す控えめな注記。displayを明示していない
	   (素の<p>のブロック表示のまま)ためUAの[hidden]{display:none}で足りるが、
	   このファイルの他要素と同じく念のため明示しておく。 */
	.speed-chart-owned-unavailable {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}
	.speed-chart-owned-unavailable[hidden] {
		display: none;
	}
</style>

<style is:global>
	/* --- 「この個体」セルの中身(src/lib/speed-chart/owned-panel.ts が動的生成する要素) ---
	   pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」への対応。
	   領域ルートクラス .speed-chart-owned で必ず絞り、ファイルの読み込み順に依存させない
	   (docs/plan/pages/speed-chart.md 確定仕様)。 */
	.speed-chart-owned {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		min-height: 1.6em;
	}
	.speed-chart-owned .speed-chart-owned-current {
		background: var(--color-success-soft);
		color: var(--color-success-strong);
		font-weight: 700;
	}
	.speed-chart-owned .speed-chart-owned-dash {
		color: var(--color-text-muted);
	}
	.speed-chart-owned .speed-chart-owned-option {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		width: 100%;
	}
	/* UI改修(2026-08-02第3弾)要件2・3: ボタンテキストを「[アイコン] いじっぱり 努力値6」
	   の形にする(下の内訳テキストは廃止し、ボタン単体で結果とページ遷移することの
	   両方が分かるようにする)。アイコン(owned-panel.tsがSVGをDOM生成して先頭に挿入)と
	   テキストを横並びにするため、ボタン自体をinline-flexにしてgapで間隔を作る。 */
	.speed-chart-owned .speed-chart-apply-button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--font-size-xs);
		padding: 0.2em 0.8em;
		/* UI改修(2026-08-02第4弾)要件4: 太字をやめる。global.css の
		   button.btn-primary { font-weight: 700 } は(0,1,1)、こちらは.speed-chart-owned
		   (領域ルート)経由の(0,2,0)で詳細度が上回るため確実に上書きできる。 */
		font-weight: 500;
	}
	.speed-chart-owned .speed-chart-apply-icon {
		flex-shrink: 0;
	}
	.speed-chart-owned .speed-chart-ev-warning {
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-risky-strong);
	}
</style>
