---
// すばやさ早見表(/speed-chart)「この個体」領域の静的テンプレート部分。
// 確定した設計のファイル分割表: 「凡例・個体サマリ・エラー表示のテンプレート」。
// R-13により「この個体」列自体は独立したカラムではなく、ChartTable.astro が組み立てる各行の
// 3列目のセルとして描かれる(実際のセルDOMは src/lib/speed-chart/owned-panel.ts が
// document.createElement() で生成する)。このコンポーネントが担うのは行の外にある
// 常設のUI(R-9凡例、個体サマリ、R-10保存失敗バナー)だけ。
//
// 個体サマリの中身は、SSR時点ではまだ種族値・スプライトID
// (public/master-data/detail・autocomplete/pokemon.json、ブラウザ側でfetchする設計)が無く
// 計算できないため、空のプレースホルダとして描画し、owned-panel.ts の初期化完了時にテキスト・
// 画像srcを差し込む(id経由。テーブル本体が「読み込み中...」→行描画に切り替わるのと同じ
// 非同期パターン)。
//
// UI改修(2026-08-02第3弾)要件1: 右パネルを「個体調整専用」にする一環で、個体サマリを
// 上から5段構成に組み替えた: ①アイコン ②ニックネーム ③特性・アイテム ④性格・努力値
// ⑤S実数値。旧「この個体:」ラベル+種族名+性格/持ち物バッジ+S実数値の4段構成から、
// アイコン段を追加し性格/持ち物バッジ段を「特性・アイテム」「性格・努力値」の2段に
// 分割した(バッジ4つを1行に詰め込むと260px幅で窮屈になるため)。
interface Props {
  hasOwnedPanel: boolean;
  /**
   * UI改修(2026-08-02第4弾)要件1: アイコン右の編集ボタン(/box/<id>への遷移)用。
   * ChartTable.astro が data-owned-id を持つ ownedId をそのまま渡す(?owned=なしのときは
   * null で、その場合ボタン自体を出さない)。
   */
  ownedId: string | null;
}
const { hasOwnedPanel, ownedId } = Astro.props;
---
<div class="speed-chart-owned-panel-static">
	{hasOwnedPanel && (
		<div class="speed-chart-owned-summary" id="speed-chart-owned-summary">
			<div class="speed-chart-owned-profile">
			{/* UI改修(2026-08-02第4弾)要件1: アイコン(1段目)の右に個体編集(/box/<id>)への
			    編集ボタンを並べる。img自体のid/classは変えない(owned-panel.tsがid経由で
			    src/hiddenを出し分けるため)。ラッパーはこの段専用(2段目以降には影響しない)。 */}
			<div class="speed-chart-owned-summary-header">
				<img id="speed-chart-owned-summary-sprite" class="sprite-icon speed-chart-owned-summary-sprite" alt="" hidden />
				{ownedId && (
					<a class="btn-ghost speed-chart-owned-edit-button" href={`/box/${ownedId}`} aria-label="個体を編集">
						{/* pitfalls.md「配色」節: 新しい色は作らずfill="none" stroke="currentColor"で
						    ボタンの文字色を継承させる。パスはteam/[id].astroの編集リンク
						    (slot-edit-link)と同じ鉛筆アイコンを再利用し、アイコンの意匠を統一する。 */}
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
							<path d="m15 5 4 4" />
						</svg>
						編集
					</a>
				)}
			</div>
			<span id="speed-chart-owned-summary-species" class="speed-chart-owned-summary-species"></span>
			<span class="speed-chart-owned-summary-badges">
				<span id="speed-chart-owned-summary-ability" class="badge badge-muted"></span>
				<span id="speed-chart-owned-summary-item" class="badge badge-muted speed-chart-owned-summary-item"></span>
			</span>
			</div>
			<span class="speed-chart-owned-summary-badges">
				<span id="speed-chart-owned-summary-nature" class="badge badge-muted"></span>
				<span id="speed-chart-owned-summary-evs" class="badge badge-muted"></span>
			</span>
			<span class="speed-chart-owned-raw-value">
				<span>すばやさ</span>
				<strong id="speed-chart-owned-summary-raw-value" class="tnum"></strong>
			</span>
			{/* UI改修依頼(すばやさ早見表、2026-08-02)
			    「S実数値 xxx を すばやさ xxx に変える」「現在地へ戻るボタンを削除し、この表示自体を
			    ボタン化して同じ動作(現在地へスクロール)を担わせる」: 表示文言はowned-panel.tsの
			    updateSummary()側で変更する(このファイルはid/クラスの器のみ)。<span>から<button>に
			    変え、クリックで現在地へスクロールするハンドラをsrc/lib/speed-chart/chart-table.ts側で
			    このidに対して登録する(旧#speed-chart-back-to-currentと同じ動作)。
			    title="現在地へ戻る"は静的(状態に依らず同じ文言)なのでここで固定、
			    aria-labelは実数値込みの文言をowned-panel.tsが動的に設定する(WCAG 2.5.3
			    Label in Name対応。可視テキスト「すばやさ xxx」を含めた文言にし、アクセシブルネームが
			    可視ラベルを包含するようにする)。ボタンであることが見た目でも分かるよう、
			    既存の「ボーダー同色の塗り→ホバーで白地に反転」方式(global.css button.btn-primary、
			    新色は作らない)のクラスを付与する。 */}
			{/* UI改修(2026-08-06): 値は通常テキスト、スクロール操作は控えめな専用ボタンに分ける。 */}
			<div class="speed-chart-owned-summary-value-row">
				<span id="speed-chart-owned-summary-value" class="tnum speed-chart-owned-summary-value"></span>
				<button type="button" id="speed-chart-owned-jump-button" class="btn-ghost speed-chart-owned-jump-button" title="現在地へ戻る">移動</button>
			</div>
			{/* UI改修(2026-08-06): 保存対象に含めない表示専用のすばやさランク入力。 */}
			<div class="speed-chart-owned-controls">
			<div class="speed-chart-rank-field rank-field">
				<label for="speed-chart-rank-input">ランク</label>
				<input id="speed-chart-rank-input" type="number" min="-6" max="6" step="1" inputmode="numeric" value="0" />
				<span class="rank-stepper-group">
					<button type="button" id="speed-chart-rank-increment" class="speed-chart-rank-stepper rank-stepper" aria-label="すばやさランクを1上げる">＋</button>
					<button type="button" id="speed-chart-rank-decrement" class="speed-chart-rank-stepper rank-stepper" aria-label="すばやさランクを1下げる">－</button>
				</span>
			</div>
			<div class="speed-chart-owned-modifier-toggles">
				<label class="speed-chart-owned-modifier-toggle">
					<span class="toggle-switch">
						<input type="checkbox" id="speed-chart-ability-toggle" class="toggle-switch-input" aria-label="特性を考慮" />
						<span class="toggle-switch-track" aria-hidden="true"><span class="toggle-switch-thumb"></span></span>
					</span>
					<span>特性<span class="speed-chart-modifier-consider">を考慮</span></span>
				</label>
				<label class="speed-chart-owned-modifier-toggle">
					<span class="toggle-switch">
						<input type="checkbox" id="speed-chart-item-toggle" class="toggle-switch-input" aria-label="アイテムを考慮" checked />
						<span class="toggle-switch-track" aria-hidden="true"><span class="toggle-switch-thumb"></span></span>
					</span>
					<span>アイテム<span class="speed-chart-modifier-consider">を考慮</span></span>
				</label>
			</div>
			</div>
		</div>
	)}
	{/*
		不具合修正(2026-08-02): ?owned=個体の種族が選択中レギュレーションの母集団に
		存在しない(例: フィクスチャのハバタクカミのようにregulationsが空配列)と、
		chart-table.tsのrender()内でformsByName.get()がundefinedになりownedControllerが
		nullのままになる。その結果owned-panel.tsのupdateSummary()が一度も呼ばれず、
		#speed-chart-owned-summaryは中身の無い灰色の箱として残ってしまう
		(pitfalls.md「空状態・0件・未入力を必ず見る」= 「データ破損に見える空箱」)。
		既定hiddenの注記をここに用意しておき、chart-table.ts側でownedControllerの
		有無に応じてこの要素とサマリ本体のhiddenを出し分ける。
		種族の情報を読み込めずcontrollerを初期化できない場合だけ表示する。
	*/}
	{hasOwnedPanel && (
		<p class="speed-chart-owned-unavailable" id="speed-chart-owned-unavailable" hidden>
			このポケモンの調整候補を読み込めませんでした。
		</p>
	)}
	{hasOwnedPanel && (
		<p class="severity-bar" data-severity="lethal" id="speed-chart-owned-error" hidden></p>
	)}
</div>

<style>
	/* 静的マークアップ(scoped styleで足りる。JS生成されるのは行内の「この個体」セルのみで、
	   これらの要素とは別)。
	   UI改修(2026-08-02第2弾): 旧トップバー(画面幅いっぱいの帯)から幅260pxの
	   サイドバー(ChartTable.astroの.speed-chart-side、gap: var(--space-4)で
	   縦に項目を積む)最下段のカードへ移植。帯前提だった左右padding・border-bottomは
	   やめ、サイドバー内の1ブロックとして自己完結する角丸カード(.cardと同じ
	   --radius-md、背景はそのまま.speed-chart-side自体の背景(--color-surface)に対して
	   区別が付く--color-surface-altを踏襲)にする。 */
	.speed-chart-owned-panel-static {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-3);
		background: var(--color-surface-alt);
		border-radius: var(--radius-md);
		font-size: var(--font-size-sm2);
	}
	/* hasOwnedPanel=falseのときは子要素が一切描画されず空になる。空の背景ボックスだけが
	   サイドバーに残らないよう、空のときはこの要素自体を消す。 */
	.speed-chart-owned-panel-static:empty {
		display: none;
	}
	/* 幅260pxではニックネーム・特性/アイテム・性格/努力値・S実数値を横一列
	   (旧flex-wrap)に並べると1文字ずつ折り返されて潰れる(pitfalls.md「潰れて
	   読めなくなる破綻」)。各段を縦積みにする(長い名前は行内で2行に折り返すのは
	   許容)。 */
	.speed-chart-owned-summary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
	}
	.speed-chart-owned-profile {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		width: 100%;
		padding: var(--space-2);
		background: var(--color-surface);
		border-radius: var(--radius-sm);
	}
	/* 不具合修正(2026-08-02): 母集団に居ない個体のときchart-table.tsがhidden属性を立てる
	   (「データ破損に見える空箱」を防ぐため)。displayをflexで明示しているクラスなので、
	   pitfalls.mdの罠どおり[hidden]の詳細度勝ち負けが起きる。明示的に上書きする。 */
	.speed-chart-owned-summary[hidden] {
		display: none;
	}
	/* UI改修(2026-08-02第5弾): 「アイコン、NNは中央配置」要件。カード全体は
	   align-items: flex-start(3段目以降=特性/アイテム・性格/努力値・S実数値は左揃えのまま)
	   を維持しつつ、1段目(このラッパー)だけ align-self: center で中央に寄せる。
	   ラッパー自体の幅はflex-basis auto=コンテンツ幅(アイコン+gap+編集ボタン)のままなので、
	   「アイコンだけ中央でボタンがはみ出す」ではなく「アイコンと編集ボタンの2つセットごと」
	   中央に来る。 */
	.speed-chart-owned-summary-header {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		align-self: center;
	}
	/* アイコン段(1段目)。48〜56pxの正方形。中央寄せは親の.speed-chart-owned-summary-header
	   側(align-self: center)で行うため、画像自体には左右位置の指定を持たせない。src/hiddenの
	   出し分けはowned-panel.tsが行う(spriteImageIdが無い個体はhiddenのまま=何も表示しない)。 */
	.speed-chart-owned-summary-sprite {
		width: 52px;
		height: 52px;
	}
	/* 編集ボタン。global.cssの a.btn-ghost(枠なし・透明背景・ホバーでsurface-alt)をそのまま
	   使い、新しい配色は作らない。260px幅のカード内でも詰まらないよう、既存のbutton基底より
	   ひとまわり小さいpaddingにページ限定で調整する(a.btn-ghost自体はglobal.css編集禁止のため
	   触らない)。 */
	.speed-chart-owned-edit-button {
		padding: 0.2em 0.6em;
		font-size: var(--font-size-sm3);
		font-weight: 600;
		flex-shrink: 0;
	}
	/* UI改修(2026-08-02第5弾): ニックネーム(2段目)も1段目と同じ理由で中央配置。
	   align-self: centerだけだと「1行に収まる長さのときは中央、260px幅を使い切って
	   折り返すときはボックス自体が親幅いっぱいまで広がり文字は左端に残る」という
	   ズレが起きる(flexアイテムの自動幅がfit-contentのため)。text-align: centerを
	   併記することで、2行に折り返した場合も各行が中央揃えのまま崩れない。 */
	.speed-chart-owned-summary-species {
		font-weight: 700;
		align-self: center;
		text-align: center;
	}
	/* 特性/アイテム(3段目)・性格/努力値(4段目)の2項目バッジは、.badgeの左paddingぶん
	   単独で縦積みにするとニックネーム・実数値(いずれもpaddingなしの素のテキスト)と
	   左端がズレて見える(実測でインデントが揃わない不具合)。2つのバッジを1つの行に
	   まとめて横並びにすることで、この行自体は他の行と同じくpaddingなしで左端0から
	   始まり、「バッジが並ぶ1行」であることが視覚的にも明確になる。260px幅では
	   折り返さず収まる想定だが、念のためflex-wrapは許容しておく(1文字ずつの折り返しには
	   ならない)。 */
	.speed-chart-owned-summary-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1);
	}
	/* UI改修依頼(すばやさ早見表、2026-08-02)「すばやさxxx表示自体をボタン化する」:
	   <button class="btn-primary">化(global.css)により背景・枠線・文字色・太字・paddingは
	   既にbtn-primaryが提供する(「ボーダー同色の塗り→ホバーで白地に反転」方式。新色は
	   作らない)。ここではこの値を主役として見せるためのfont-sizeだけをページ固有に足す
	   (旧<span>時代のfont-weight:700/color:var(--color-primary-strong)はbtn-primaryの
	   指定と重複・矛盾するため削除し、btn-primary側に委ねる)。 */
	.speed-chart-owned-summary-value {
		font-size: var(--font-size-sm1);
	}
	.speed-chart-owned-summary-value-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.speed-chart-owned-raw-value { display: none; }
	.speed-chart-owned-jump-button {
		padding: 0.2em 0.5em;
		font-size: var(--font-size-sm3);
		font-weight: 500;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
	}
	/* UI改修(2026-08-06): /box/[id]のランク入力と同じ密度・強調・端点状態を再現する。 */
	.speed-chart-rank-field {
		align-self: flex-start;
	}
	.speed-chart-rank-field input[type='number'] {
		width: 3.4em;
		min-height: 0;
		padding: 0.3em;
		font-size: var(--font-size-sm3);
		text-align: center;
		background: var(--color-surface-alt);
		appearance: textfield;
	}
	.speed-chart-rank-field input[type='number']::-webkit-inner-spin-button,
	.speed-chart-rank-field input[type='number']::-webkit-outer-spin-button { appearance: none; }
	.speed-chart-rank-field input.is-nonzero {
		font-weight: 700;
		color: var(--color-primary-strong);
		border-color: var(--color-primary-strong);
	}
	.speed-chart-owned-modifier-toggles {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
	}
	.speed-chart-owned-controls { display: contents; }
	.speed-chart-owned-modifier-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm3);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	.speed-chart-owned-summary-item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-width: 0;
		max-width: 100%;
		overflow: hidden;
		white-space: nowrap;
	}
	/* .severity-bar[data-severity]は基底(global.css)がdisplay指定を持たないブロック要素なので、
	   [hidden]の詳細度勝ち負けは発生しない(pitfalls.mdの罠は「displayを明示したクラス」限定)。
	   念のため明示しておく。 */
	.severity-bar[hidden] {
		display: none;
	}
	/* 不具合修正(2026-08-02): 個体サマリの代わりに出す控えめな注記。displayを明示していない
	   (素の<p>のブロック表示のまま)ためUAの[hidden]{display:none}で足りるが、
	   このファイルの他要素と同じく念のため明示しておく。 */
	.speed-chart-owned-unavailable {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm2);
	}
	.speed-chart-owned-unavailable[hidden] {
		display: none;
	}
</style>

<style is:global>
	/* UI不具合修正(2026-08-06): アイテム画像と名称はowned-panel.tsが後から生成するため、
	   scoped styleではなくglobal側でサイズ固定と一行省略を適用する。 */
	#speed-chart-owned-summary-item img {
		width: var(--space-5);
		height: var(--space-5);
		object-fit: contain;
		flex: 0 0 auto;
	}
	#speed-chart-owned-summary-item > span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	/* --- 「この個体」セルの中身(src/lib/speed-chart/owned-panel.ts が動的生成する要素) ---
	   pitfalls.md「Astroのscoped styleはJSで生成した要素に効かない」への対応。
	   領域ルートクラス .speed-chart-owned で必ず絞り、ファイルの読み込み順に依存させない
	   (docs/plan/pages/speed-chart.md 確定仕様)。 */
	.speed-chart-owned {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		min-height: 1.6em;
	}
	.speed-chart-owned .speed-chart-owned-current {
		background: var(--color-success-soft);
		color: var(--color-success-strong);
		font-weight: 700;
	}
	.speed-chart-owned .speed-chart-owned-dash {
		color: var(--color-text-muted);
	}
	.speed-chart-owned .speed-chart-owned-option {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-1);
		width: 100%;
	}
	/* UI改修(2026-08-02第3弾)要件2・3: ボタンテキストを「[アイコン] いじっぱり 努力値6」
	   の形にする(下の内訳テキストは廃止し、ボタン単体で結果とページ遷移することの
	   両方が分かるようにする)。アイコン(owned-panel.tsがSVGをDOM生成して先頭に挿入)と
	   テキストを横並びにするため、ボタン自体をinline-flexにしてgapで間隔を作る。 */
	.speed-chart-owned .speed-chart-apply-button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-width: 0;
		font-size: var(--font-size-sm3);
		padding: 0.2em 0.8em;
		/* UI改修(2026-08-02第4弾)要件4: 太字をやめる。global.css の
		   button.btn-primary { font-weight: 700 } は(0,1,1)、こちらは.speed-chart-owned
		   (領域ルート)経由の(0,2,0)で詳細度が上回るため確実に上書きできる。 */
		font-weight: 500;
