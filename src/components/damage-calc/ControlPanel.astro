---
<section class="panel damage-calc-control-panel" aria-labelledby="damage-calc-control-title">
  <div class="panel-content damage-calc-control-content"><h2 id="damage-calc-control-title">コントロールパネル</h2>
    <div class="damage-calc-controls-grid">
      <fieldset class="damage-calc-side-controls"><legend>自分</legend><div class="damage-calc-ranks" data-side="self"></div><label>状態異常<select id="damage-calc-self-ailment"></select></label><button id="damage-calc-self-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span><input id="damage-calc-self-tera" type="checkbox" tabindex="-1" /></button></fieldset>
      <fieldset class="damage-calc-field-controls"><legend>フィールド</legend><div class="damage-calc-choice-field"><span>天候</span><div id="damage-calc-weather-buttons" class="damage-calc-icon-group is-row4"></div><select id="damage-calc-weather" class="damage-calc-native-control"></select></div><div class="damage-calc-choice-field"><span>フィールド</span><div id="damage-calc-terrain-buttons" class="damage-calc-icon-group is-row4"></div><select id="damage-calc-terrain" class="damage-calc-native-control"></select></div></fieldset>
      <fieldset class="damage-calc-side-controls"><legend>相手</legend><div class="damage-calc-ranks" data-side="opponent"></div><label>状態異常<select id="damage-calc-opponent-ailment"></select></label><button id="damage-calc-opponent-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span><input id="damage-calc-opponent-tera-toggle" type="checkbox" tabindex="-1" /></button></fieldset>
    </div>
  </div>
</section>
