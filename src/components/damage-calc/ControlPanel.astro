---
---
<section class="damage-calc-control-bar" aria-label="コントロールパネル">
  <div class="damage-calc-control-inner">
    <div class="damage-calc-control-header"><span>自分</span><span>相手</span></div>
    <div class="damage-calc-control-row">
      <div class="damage-calc-control-cell" data-side="self">
        <div class="damage-calc-ranks" data-side="self"></div>
        <button id="damage-calc-self-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span><input id="damage-calc-self-tera" type="checkbox" tabindex="-1" /></button>
      </div>
      <div class="damage-calc-control-cell damage-calc-control-cell--field">
        <span class="damage-calc-control-cell-label">天候</span>
        <div id="damage-calc-weather-buttons" class="damage-calc-icon-group is-row4"></div>
        <select id="damage-calc-weather" class="damage-calc-native-control"></select>
      </div>
      <div class="damage-calc-control-cell" data-side="opponent">
        <div class="damage-calc-ranks" data-side="opponent"></div>
        <button id="damage-calc-opponent-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span><input id="damage-calc-opponent-tera-toggle" type="checkbox" tabindex="-1" /></button>
      </div>
    </div>
    <div class="damage-calc-control-row">
      <div class="damage-calc-control-cell"><label class="damage-calc-ailment-field">状態異常<select id="damage-calc-self-ailment"></select></label></div>
      <div class="damage-calc-control-cell damage-calc-control-cell--field">
        <span class="damage-calc-control-cell-label">フィールド</span>
        <div id="damage-calc-terrain-buttons" class="damage-calc-icon-group is-row4"></div>
        <select id="damage-calc-terrain" class="damage-calc-native-control"></select>
      </div>
      <div class="damage-calc-control-cell"><label class="damage-calc-ailment-field">状態異常<select id="damage-calc-opponent-ailment"></select></label></div>
    </div>
  </div>
</section>
