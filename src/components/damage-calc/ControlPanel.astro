---
import TeraSelectDialog from '../box-id/TeraSelectDialog.astro';
---
<section class="damage-calc-control-bar" aria-label="コントロールパネル">
  <div class="damage-calc-control-inner">
    {/* 自分/相手の2列グリッド。「自分」「相手」ラベルはランクステッパーと同じ段に表示し、
        テラスタルボタンは状態異常の行へ移す。下段は天候(左)・フィールド(右)を横並びボタンで表示する。 */}
    <div class="damage-calc-control-grid">
      <div class="damage-calc-control-cell damage-calc-control-row-1" data-side="self">
        <span class="damage-calc-control-label">自分</span>
        <div class="damage-calc-ranks" data-side="self"></div>
      </div>
      <div class="damage-calc-control-cell damage-calc-control-row-1" data-side="opponent">
        <div class="damage-calc-ranks" data-side="opponent"></div>
        <span class="damage-calc-control-label">相手</span>
      </div>

      <div class="damage-calc-control-cell damage-calc-control-row-2" data-side="self">
        <div class="damage-calc-ailment-field"><select id="damage-calc-self-ailment" aria-label="状態異常"></select></div>
        <button id="damage-calc-self-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span></button>
      </div>
      <div class="damage-calc-control-cell damage-calc-control-row-2" data-side="opponent">
        <button id="damage-calc-opponent-tera-button" class="damage-calc-tera-toggle" type="button" aria-pressed="false" aria-label="テラスタル"><span class="damage-calc-tera-icon-wrap" aria-hidden="true"><img class="damage-calc-tera-icon" alt="" hidden /></span></button>
        <div class="damage-calc-ailment-field"><select id="damage-calc-opponent-ailment" aria-label="状態異常"></select></div>
      </div>

      <div class="damage-calc-control-cell damage-calc-control-cell--field damage-calc-control-row-3" data-side="self">
        <div id="damage-calc-weather-buttons" class="damage-calc-icon-group" role="radiogroup" aria-label="天候"></div>
        <select id="damage-calc-weather" class="damage-calc-native-control"></select>
      </div>
      <div class="damage-calc-control-cell damage-calc-control-cell--field damage-calc-control-row-3" data-side="opponent">
        <div id="damage-calc-terrain-buttons" class="damage-calc-icon-group" role="radiogroup" aria-label="フィールド"></div>
        <select id="damage-calc-terrain" class="damage-calc-native-control"></select>
      </div>
    </div>
  </div>
</section>
<TeraSelectDialog idPrefix="damage-calc-self-" />
<TeraSelectDialog idPrefix="damage-calc-opponent-" />
