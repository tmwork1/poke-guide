<section class="panel damage-calc-control-panel" aria-labelledby="damage-calc-control-title">
  <div class="panel-content damage-calc-control-content"><h2 id="damage-calc-control-title">コントロールパネル</h2>
    <div class="damage-calc-controls-grid">
      <fieldset class="damage-calc-side-controls"><legend>自分</legend><div class="damage-calc-ranks" data-side="self"></div><label>状態異常<select id="damage-calc-self-ailment"></select></label><label class="damage-calc-tera-toggle"><input id="damage-calc-self-tera" type="checkbox" />テラスタル済み</label></fieldset>
      <fieldset class="damage-calc-field-controls"><legend>フィールド</legend><label>天候<select id="damage-calc-weather"></select></label><label>フィールド<select id="damage-calc-terrain"></select></label></fieldset>
      <fieldset class="damage-calc-side-controls"><legend>相手</legend><div class="damage-calc-ranks" data-side="opponent"></div><label>状態異常<select id="damage-calc-opponent-ailment"></select></label><label class="damage-calc-tera-toggle"><input id="damage-calc-opponent-tera-toggle" type="checkbox" />テラスタル済み</label></fieldset>
    </div>
  </div>
</section>
