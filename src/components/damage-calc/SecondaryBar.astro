---
import SecondHeader from "../SecondHeader.astro";
---

<SecondHeader ariaLabel="対面の選択" class="damage-calc-secondary-bar">
    <div class="toolbar-item damage-calc-secondary-actions">
      <button id="damage-calc-pokemon-button" type="button" class="damage-calc-secondary-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.5 12 3 3 7.5v9L12 21l9-4.5v-9Z"/><path d="M3.5 7.3 12 12l8.5-4.7"/><path d="M12 12v9"/></svg><span>ボックス</span></button>
      <button id="damage-calc-team-button" type="button" class="damage-calc-secondary-button"><svg viewBox="0 0 28 18" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="8" height="8" rx="1.7"/><rect x="10" y="0" width="8" height="8" rx="1.7"/><rect x="20" y="0" width="8" height="8" rx="1.7"/><rect x="0" y="10" width="8" height="8" rx="1.7"/><rect x="10" y="10" width="8" height="8" rx="1.7"/><rect x="20" y="10" width="8" height="8" rx="1.7"/></svg><span>チーム</span></button>
      <div class="damage-calc-opponent-select-wrap">
        <svg class="damage-calc-opponent-select-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"></circle><path d="m15 15 5 5"></path></svg>
        <select id="damage-calc-opponent-select" class="damage-calc-opponent-select" aria-label="相手ポケモンを選択"></select>
      </div>
    </div>
</SecondHeader>
