<section class="damage-calc-matchups panel">
  <div class="panel-content damage-calc-summary-layout">
    <div id="damage-calc-summary-list" class="damage-calc-summary-list">
      <article class="damage-calc-matchup-card" aria-labelledby="damage-calc-matchup-title">
        <header class="damage-calc-matchup-card__header">
          <div class="damage-calc-matchup-card__pokemon">
            <img src="/pokemon-artwork/149.webp" alt="カイリュー" class="damage-calc-matchup-card__artwork" />
            <div><p class="damage-calc-matchup-card__side">自分</p><h2 id="damage-calc-matchup-title">カイリュー</h2><p class="damage-calc-matchup-card__item">こだわりハチマキ</p></div>
          </div>
          <span class="damage-calc-matchup-card__versus" aria-label="対">VS</span>
          <div class="damage-calc-matchup-card__pokemon damage-calc-matchup-card__pokemon--opponent">
            <div><p class="damage-calc-matchup-card__side">相手</p><h2>サーフゴー</h2><p class="damage-calc-matchup-card__item">たべのこし</p></div>
            <img src="/pokemon-artwork/1000.webp" alt="サーフゴー" class="damage-calc-matchup-card__artwork" />
          </div>
        </header>
        <section class="damage-calc-matchup-card__section" aria-labelledby="damage-calc-attack-title">
          <h3 id="damage-calc-attack-title" class="damage-calc-matchup-card__section-title damage-calc-matchup-card__section-title--attack">攻撃</h3>
          <div class="damage-calc-matchup-card__table-wrap"><table class="damage-calc-matchup-card__table"><colgroup><col class="damage-calc-matchup-card__move-column" /><col /><col /><col /></colgroup><thead><tr><th scope="col" aria-label="技名"></th><th scope="col">無振り</th><th scope="col">32振り</th><th scope="col">特化</th></tr></thead><tbody>
            <tr><th scope="row">しんそく</th><td><strong>39〜46%</strong><small>確3</small></td><td><strong>36〜43%</strong><small>確3</small></td><td><strong>31〜37%</strong><small>乱3 (92%)</small></td></tr>
            <tr><th scope="row">じしん</th><td><strong>75〜89%</strong><small>確2</small></td><td><strong>70〜83%</strong><small>確2</small></td><td><strong>60〜71%</strong><small>確2</small></td></tr>
            <tr><th scope="row">げきりん</th><td><strong>61〜73%</strong><small>確2</small></td><td><strong>57〜68%</strong><small>確2</small></td><td><strong>48〜57%</strong><small>確2</small></td></tr>
            <tr><th scope="row">ほのおのパンチ</th><td><strong>44〜52%</strong><small>乱2 (21%)</small></td><td><strong>41〜49%</strong><small>確3</small></td><td><strong>35〜42%</strong><small>確3</small></td></tr>
          </tbody></table></div>
        </section>
        <section class="damage-calc-matchup-card__section" aria-labelledby="damage-calc-defense-title">
          <h3 id="damage-calc-defense-title" class="damage-calc-matchup-card__section-title damage-calc-matchup-card__section-title--defense">防御</h3>
          <ul class="damage-calc-matchup-card__defense-list"><li><span>ゴールドラッシュ</span><strong>42〜50%</strong><small>乱2 (1%)</small></li><li><span>シャドーボール</span><strong>32〜38%</strong><small>確3</small></li><li><span>きあいだま</span><strong>67〜80%</strong><small>確2</small></li></ul>
        </section>
      </article>
    </div>
    <nav id="damage-calc-summary-rail" class="damage-calc-summary-rail" aria-label="相手ポケモンを選択"></nav>
  </div>
</section>
