            <tr><th scope="row">げきりん</th><td><strong>61〜73%</strong><small>確2</small></td><td><strong>57〜68%</strong><small>確2</small></td><td><strong>48〜57%</strong><small>確2</small></td></tr>
            <tr><th scope="row">ほのおのパンチ</th><td><strong>44〜52%</strong><small>乱2 (21%)</small></td><td><strong>41〜49%</strong><small>確3</small></td><td><strong>35〜42%</strong><small>確3</small></td></tr>
