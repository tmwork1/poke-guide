---
import SecondHeader from '../SecondHeader.astro';
import { ALL_SEASONS_PARAM } from '../../lib/ranked-teams-validation';

interface Props {
	idPrefix: string;
	seasons: Array<{ season: string }>;
	defaultSeason: string | null;
	searchPlaceholder?: string;
	ariaLabel?: string;
	class?: string;
}

const {
	idPrefix,
	seasons,
	defaultSeason,
	searchPlaceholder = 'ポケモン・もちもの・わざ',
	ariaLabel = '上位チームを検索・切り替え',
	class: className,
} = Astro.props;
const searchId = `${idPrefix}-search`;
const seasonId = `${idPrefix}-season`;
const densityToggleId = `${idPrefix}-display-density-toggle`;
---

<SecondHeader ariaLabel={ariaLabel} class={`ranked-teams-search-header${className ? ` ${className}` : ''}`}>
	<div class="second-header-search">
		<div class="search-input-wrap">
			<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input id={searchId} type="search" class="field-control" placeholder={searchPlaceholder} aria-label={`${searchPlaceholder}を検索`} autocomplete="off" />
		</div>
	</div>
	<div class="ranked-teams-season-field top-builds-season-field">
		<label for={seasonId}>シーズン</label>
		<select id={seasonId} class="field-control" disabled={seasons.length === 0}>
			<option value={ALL_SEASONS_PARAM}>すべて</option>
			{seasons.map((entry) => <option value={entry.season} selected={entry.season === defaultSeason}>{entry.season}</option>)}
		</select>
	</div>
	<div class="second-header-density toolbar-item toolbar-density">
		<button
			type="button"
			id={densityToggleId}
			class="density-toggle btn-control"
			data-mode="expanded"
			aria-label="圧縮表示に切り替える"
		>
			<svg class="density-toggle-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="2" y="4" width="5" height="5" rx="1" />
				<rect x="10" y="4" width="5" height="5" rx="1" />
				<rect x="18" y="4" width="5" height="5" rx="1" />
				<rect x="2" y="12" width="5" height="5" rx="1" />
				<rect x="10" y="12" width="5" height="5" rx="1" />
				<rect x="18" y="12" width="5" height="5" rx="1" />
			</svg>
		</button>
	</div>
</SecondHeader>
