---
import '../styles/global.css';
import '../styles/form-controls.css';
import '../styles/buttons.css';
import AppBottomNav from '../components/AppBottomNav.astro';

interface Props {
	title: string;
	description?: string;
	current?: "home" | "box" | "team" | "dev" | "speed-chart" | "data";
	bodyClass?: string;
	/**
	 * "public" では AppSidebar とオーバーレイを描画せず、第三者にアカウント情報や
	 * 利用できないナビゲーションを表示しない。
	 */
	chrome?: "app" | "public";
}

const { title, description, current, bodyClass, chrome = "app" } = Astro.props;
const isPublicChrome = chrome === "public";

const pageTitle = title === "ポケガイド" ? title : `${title} | ポケガイド`;

---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<div class={`app-shell${isPublicChrome ? " is-public" : ""}`}>
			{!isPublicChrome && <AppBottomNav current={current} />}

			<main class="app-main">
				<slot />
			</main>
		</div>

	</body>
</html>
