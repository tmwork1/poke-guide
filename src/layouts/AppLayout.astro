---
import '../styles/global.css';
import '../styles/form-controls.css';
import '../styles/buttons.css';
import AppBottomNav from '../components/AppBottomNav.astro';
import { webfontCorePreloadUrls } from '../lib/webfont-core-preload';

interface Props {
	title: string;
	description?: string;
	current?: "home" | "box" | "team" | "dev" | "speed-chart" | "data" | "damage-calc";
	bodyClass?: string;
	/**
	 * "public" では AppSidebar とオーバーレイを描画せず、第三者にアカウント情報や
	 * 利用できないナビゲーションを表示しない。
	 */
	chrome?: "app" | "public";
}

const { title, description, current, bodyClass, chrome = "app" } = Astro.props;
const isPublicChrome = chrome === "public";
const isGuestMode = !Astro.locals.user;

const pageTitle = title === "ポケガイド" ? title : `${title} | ポケガイド`;

---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* ポケモンのマスタ(名前→imageId/タイプ)。立ち絵・アイコンを出すJSは、この146KBの
		    JSONが届くまで<img>のsrcを決められないため、これが画像表示の律速になっている
		    (/box の実測で 取得完了381ms → 最初の画像リクエスト506ms、初回描画は360ms。
		    つまり画面が出てから150ms以上、アイコンが枠だけの状態が続いていた)。
		    JSの起動を待たずにHTMLの解析時点で取りにいかせる。 */}
		<link rel="preload" as="fetch" href="/master-data/autocomplete/pokemon.json" />
		{/* 初回描画後に必要な unicode-range 分割フォントを待つと字幅が変わるため、画面に出る
		    文字を集めたコアサブセットを先に取得する。フォント取得は CORS モードなので、同一
		    オリジンでも crossorigin を付けて CSS 側の取得と共有し、二重取得を防ぐ。 */}
		{webfontCorePreloadUrls.map((url) => (
			<link rel="preload" as="font" type="font/woff2" crossorigin href={url} />
		))}
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body class={bodyClass} data-guest-mode={isGuestMode ? "true" : undefined}>
		<div class={`app-shell${isPublicChrome ? " is-public" : ""}`}>
			{!isPublicChrome && <AppBottomNav current={current} />}

			<main class="app-main">
				<slot />
			</main>
		</div>

		<script>
			import { setupSelectOnFocus } from "../lib/select-on-focus";
			setupSelectOnFocus();
		</script>
	</body>
</html>
