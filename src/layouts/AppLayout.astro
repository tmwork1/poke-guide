---
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';
import AppBottomNav from '../components/AppBottomNav.astro';

interface Props {
	title: string;
	description?: string;
	current?: "box" | "team" | "dev" | "speed-chart" | "ranked-teams";
	bodyClass?: string;
	/** 指定すると「← 戻る」リンクをトップバー左端に出す。省略時は表示しない。 */
	backHref?: string;
	/** backHref 指定時のみ使用。省略時は「戻る」。 */
	backLabel?: string;
	/**
	 * "public" では AppSidebar とオーバーレイを描画せず、第三者にアカウント情報や
	 * 利用できないナビゲーションを表示しない。
	 */
	chrome?: "app" | "public";
	/**
	 * true のときは --topbar-height を 0 にし、.app-main の min-height 計算を
	 * 実際に描画されるトップバーの高さと同期する。
	 */
	hideTopbar?: boolean;
}

const { title, description, current, bodyClass, backHref, backLabel, chrome = "app", hideTopbar = false } = Astro.props;
const isPublicChrome = chrome === "public";

const pageTitle = title === "Poke-Commons" ? title : `${title} | Poke-Commons`;

// 個体管理機能専用のログインレーン(src/middleware.ts が locals.user にセットする)。
// ダメージ計算・検索等の既存の匿名機能はこの値を参照しないため、ここで読むだけでは
// 既存ページの挙動に影響しない。chrome="public" のときはこの値の有無に関わらず
// 常にログイン導線のみを出す(第三者に自分のログイン状態・メールアドレスを見せないため)。
const user = Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<div class={`app-shell${isPublicChrome ? " is-public" : ""}${hideTopbar ? " no-topbar" : ""}`}>
			{!hideTopbar && (
			<header class="app-topbar">
				<div class="app-topbar-row app-topbar-row-brand">
					<div class="app-topbar-row-left">
						<span class="app-topbar-brand">Poke-Commons</span>
					</div>
					{
						isPublicChrome && (
							<div class="app-topbar-account app-topbar-account-mobile">
								<a class="btn-primary" href="/api/auth/login">自分の育成を管理する</a>
							</div>
						)
					}
				</div>

				<div class="app-topbar-row app-topbar-row-main">
					<div class="app-topbar-left">
						{
							backHref && (
								<a class="app-topbar-back" href={backHref}>
									<svg class="app-topbar-back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M15 6l-6 6 6 6" />
									</svg>
									{backLabel ?? "戻る"}
								</a>
							)
						}
						<span class="app-topbar-title">{title}</span>
						{Astro.slots.has("topbar-status") && (
							<span class="app-topbar-status">
								<slot name="topbar-status" />
							</span>
						)}
					</div>
					<div class="app-topbar-right">
						{Astro.slots.has("topbar-actions") && (
							<div class="app-topbar-actions">
								<slot name="topbar-actions" />
							</div>
						)}
						{
							isPublicChrome && (
								<div class="app-topbar-account app-topbar-account-desktop">
									<a class="btn-primary" href="/api/auth/login">自分の育成を管理する</a>
								</div>
							)
						}
					</div>
				</div>
			</header>
			)}

			{!isPublicChrome && <AppSidebar current={current} user={user} />}

			{!isPublicChrome && <AppBottomNav current={current} />}

			{!isPublicChrome && <div class="app-sidebar-overlay" id="app-sidebar-overlay"></div>}

			<main class="app-main">
				<slot />
			</main>
		</div>

		<script>
			// ドロワー開閉(モバイル専用): ハンバーガー / オーバーレイクリック / Esc / リンククリックで閉じる。
			const toggle = document.getElementById("app-sidebar-toggle");
			const sidebar = document.getElementById("app-sidebar");
			const overlay = document.getElementById("app-sidebar-overlay");

			function openDrawer() {
				sidebar?.classList.add("is-open");
				overlay?.classList.add("is-open");
				toggle?.setAttribute("aria-expanded", "true");
			}

			function closeDrawer() {
				sidebar?.classList.remove("is-open");
				overlay?.classList.remove("is-open");
				toggle?.setAttribute("aria-expanded", "false");
			}

			toggle?.addEventListener("click", () => {
				if (sidebar?.classList.contains("is-open")) {
					closeDrawer();
				} else {
					openDrawer();
				}
			});

			overlay?.addEventListener("click", closeDrawer);

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeDrawer();
				}
			});

			sidebar?.addEventListener("click", (event) => {
				const target = event.target as HTMLElement;
				if (target.closest("a")) {
					closeDrawer();
				}
			});
		</script>
	</body>
</html>

<style>
	/* 位置・高さ(sticky/z-index/--topbar-height)は global.css の .app-topbar 側で定義する
	   (左右の帯が参照する --topbar-height を :root で公開する必要があるため)。
	   ここではトップバー内部の見た目(余白・タイポグラフィ)のみを扱う
	   (AppSidebar.astro と同じ役割分担)。 */
	.app-topbar-row-left {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.app-topbar-brand {
		font-weight: 800;
		font-size: var(--font-size-lg1);
		white-space: nowrap;
	}

	.app-topbar-back {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-size: var(--font-size-sm1);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.app-topbar-back-icon {
		flex-shrink: 0;
		transition: transform 0.15s ease;
	}

	.app-topbar-back:hover {
		color: var(--color-primary);
	}

	.app-topbar-back:hover .app-topbar-back-icon {
		transform: translateX(-2px);
	}

	.app-topbar-title {
		font-weight: 800;
		font-size: var(--font-size-lg1);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.app-topbar-status {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm2);
		white-space: nowrap;
	}

	/* 独立コントロール同士の間隔を、8pxと .second-bar--toolbar の24pxの中間にして
	   共通トップバー内で詰まりすぎないようにする。 */
	.app-topbar-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	/* この表示切り替えは scoped style 内に置く。global.css 側で
	   `.app-topbar-account-desktop { display: none }` を書くと、
	   scoped styleの実質詳細度 0,2,0 に付ける `.app-topbar-account { display: flex }` に負けて
	   モバイルで二重表示と横スクロールが起きる。 */
	.app-topbar-account {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm2);
		color: var(--color-text-muted);
		white-space: nowrap;
		/* 狭い幅でページ固有操作と共存しても横スクロールしないよう縮小を許可する。 */
		min-width: 0;
	}

	.app-topbar-account-desktop {
		display: none;
	}

	@media (min-width: 900px) {
		.app-topbar-account-mobile {
			display: none;
		}

		.app-topbar-account-desktop {
			display: flex;
		}
	}

	@media (max-width: 899px) {
		/* ページ固有操作を折り返し、狭い幅での横スクロールを防ぐ。 */
		.app-topbar-row-main {
			flex-wrap: wrap;
			row-gap: var(--space-2);
		}
	}
</style>
