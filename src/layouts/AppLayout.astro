---
// 全ページ共通レイアウト(UI刷新、2026-07-25)。AppSidebar を常設し、
// デスクトップは固定サイドバー、モバイルはハンバーガーで開閉するドロワーにする。
//
// 2026-07-26 トップバー新設: docs/ui_proposal/個体編集_全体レイアウト.png のワイヤーフレーム
// (画面上端にサイドバー右隣から画面右端まで伸びる「トップバー 画面操作系」の帯があり、
// 左右の帯はその直下から始まる)に合わせ、デスクトップでも常設のトップバーを表示する。
// 個体編集ページ等の左右の帯が `height: calc(100vh - var(--topbar-height))` を組めるよう、
// トップバーの実測高さと一致する --topbar-height を global.css の :root で公開している
// (デスクトップ/モバイルで値が異なるため @media 内で上書きする。値がずれると左右の帯の
// 高さが狂うため、変更時は必ず実測して合わせ直すこと)。
//
// スロット構成(このレイアウトを使う各ページはこれに合わせて中身を差し込む):
//   slot="topbar-status"  … タイトル右の状態表示(例: 保存済み)。省略可。
//   slot="topbar-actions" … トップバー右側のページ固有操作(ボタン類)。省略可。
//   slot(default)         … 本文。
//   slot="head"           … <head> 内への追加(既存)。
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';
import AppBottomNav from '../components/AppBottomNav.astro';

interface Props {
	title: string;
	description?: string;
	current?: "box" | "team" | "dev" | "speed-chart" | "ranked-teams";
	bodyClass?: string;
	/** 指定すると「← 戻る」リンクをトップバー左端に出す。省略時は表示しない。 */
	backHref?: string;
	/** backHref 指定時のみ使用。省略時は「戻る」。 */
	backLabel?: string;
	/**
	 * ラウンド13 A-1: "public" にすると第三者向けの公開ページ用シェルにする
	 * (AppSidebar と .app-sidebar-overlay を描画しない)。既定 "app"(従来どおり
	 * ログイン中ユーザー向けのシェル)。公開ページのスクリーンショットがそのまま
	 * メールアドレス("ログイン中: dev@localhost")や未ログイン第三者には1つも
	 * 成立しないサイドバー4項目を晒していた問題への対応。
	 * 2026-07-27 ラウンド20 20-H2: ログイン中ユーザー向けのアカウント情報表示
	 * (ログイン状態表示・ログイン/ログアウト導線)はトップバーから AppSidebar.astro の
	 * 最下段へ移設した。この移設作業の際、"public" 専用の「自分の育成を管理する」誘導リンクも
	 * 巻き添えで削除してしまっていた(未ログインの第三者が使える唯一の導線だったため、
	 * サインアップ導線の欠落という回帰だった)。
	 * 2026-07-28 ラウンド21: 上記の巻き添え削除を修正。"public" のときだけトップバーに
	 * 「自分の育成を管理する」CTAを復元した(AppSidebar は chrome="public" では描画されないため
	 * ログイン導線と一緒にサイドバーへは移せず、トップバーに残す必要がある)。
	 * ログイン中ユーザー向けのアカウント表示は引き続きサイドバー側のみで、トップバーには戻さない。
	 */
	chrome?: "app" | "public";
	/**
	 * UI改修依頼(2026-08-02): ボックス/チームトップ/すばやさ早見表の3画面は、共通の
	 * <header class="app-topbar"> を描画せず、各ページ自身のセカンドトップバー(検索/絞り込み
	 * バー等)をトップバーとして扱う。true のときはこのレイアウトの<header>を描画しない。
	 * .app-shell に "no-topbar" クラスを自動付与する(下記)。global.css側で
	 *     --topbar-height を0に上書きし、.app-main の min-height 計算のズレを防いでいる。
	 */
	hideTopbar?: boolean;
}

const { title, description, current, bodyClass, backHref, backLabel, chrome = "app", hideTopbar = false } = Astro.props;
const isPublicChrome = chrome === "public";

const pageTitle = title === "Poke-Commons" ? title : `${title} | Poke-Commons`;

// 個体管理機能専用のログインレーン(src/middleware.ts が locals.user にセットする)。
// ダメージ計算・検索等の既存の匿名機能はこの値を参照しないため、ここで読むだけでは
// 既存ページの挙動に影響しない。chrome="public" のときはこの値の有無に関わらず
// 常にログイン導線のみを出す(第三者に自分のログイン状態・メールアドレスを見せないため)。
const user = Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<div class={`app-shell${isPublicChrome ? " is-public" : ""}${hideTopbar ? " no-topbar" : ""}`}>
			{!hideTopbar && (
			<header class="app-topbar">
				<!-- モバイル(900px未満)専用の1段目: ハンバーガー + サイト名 (+ chrome="public" 限定でCTA)。
				     デスクトップでは非表示(サイドバーに常時ブランドリンクがあるため不要)。
				     2026-07-27 ラウンド20 20-H2: ログイン中ユーザー向けのアカウント情報表示
				     (「ログイン中: xxx」+ ログアウト)はここに重複表示していたが、
				     AppSidebar.astro の最下段(.app-sidebar-account)へ1箇所に統合したため削除した。
				     2026-07-28 ラウンド21: ただし chrome="public" 専用の「自分の育成を管理する」CTAは
				     AppSidebar 自体が chrome="public" では描画されないため移設できず、20-H2で誤って
				     道連れに削除されていた(未ログインの第三者向け唯一の導線)。ここに復元する。 -->
				<div class="app-topbar-row app-topbar-row-brand">
					<div class="app-topbar-row-left">
						<span class="app-topbar-brand">Poke-Commons</span>
					</div>
					{
						isPublicChrome && (
							<div class="app-topbar-account app-topbar-account-mobile">
								<a class="btn-primary" href="/api/auth/login">自分の育成を管理する</a>
							</div>
						)
					}
				</div>

				<!-- 全画面幅で使う本体行: 左=戻る+タイトル+状態、右=ページ固有操作 (+ chrome="public" 限定でCTA)。
				     デスクトップではこれが唯一の行、モバイルでは2段目になる。
				     2026-07-27 ラウンド20 20-H2: ログイン中ユーザー向けのアカウント情報表示はここにもあったが、
				     AppSidebar.astro の最下段(.app-sidebar-account)へ1箇所に統合したため削除した
				     (chrome="public" 専用CTAの復元経緯は上のコメント参照)。 -->
				<div class="app-topbar-row app-topbar-row-main">
					<div class="app-topbar-left">
						{
							backHref && (
								<a class="app-topbar-back" href={backHref}>
									<svg class="app-topbar-back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M15 6l-6 6 6 6" />
									</svg>
									{backLabel ?? "戻る"}
								</a>
							)
						}
						<span class="app-topbar-title">{title}</span>
						{Astro.slots.has("topbar-status") && (
							<span class="app-topbar-status">
								<slot name="topbar-status" />
							</span>
						)}
					</div>
					<div class="app-topbar-right">
						{Astro.slots.has("topbar-actions") && (
							<div class="app-topbar-actions">
								<slot name="topbar-actions" />
							</div>
						)}
						{
							isPublicChrome && (
								<div class="app-topbar-account app-topbar-account-desktop">
									<a class="btn-primary" href="/api/auth/login">自分の育成を管理する</a>
								</div>
							)
						}
					</div>
				</div>
			</header>
			)}

			{!isPublicChrome && <AppSidebar current={current} user={user} />}

			{!isPublicChrome && <AppBottomNav current={current} />}

			{!isPublicChrome && <div class="app-sidebar-overlay" id="app-sidebar-overlay"></div>}

			<main class="app-main">
				<slot />
			</main>
		</div>

		<script>
			// ドロワー開閉(モバイル専用): ハンバーガー / オーバーレイクリック / Esc / リンククリックで閉じる。
			const toggle = document.getElementById("app-sidebar-toggle");
			const sidebar = document.getElementById("app-sidebar");
			const overlay = document.getElementById("app-sidebar-overlay");

			function openDrawer() {
				sidebar?.classList.add("is-open");
				overlay?.classList.add("is-open");
				toggle?.setAttribute("aria-expanded", "true");
			}

			function closeDrawer() {
				sidebar?.classList.remove("is-open");
				overlay?.classList.remove("is-open");
				toggle?.setAttribute("aria-expanded", "false");
			}

			toggle?.addEventListener("click", () => {
				if (sidebar?.classList.contains("is-open")) {
					closeDrawer();
				} else {
					openDrawer();
				}
			});

			overlay?.addEventListener("click", closeDrawer);

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeDrawer();
				}
			});

			sidebar?.addEventListener("click", (event) => {
				const target = event.target as HTMLElement;
				if (target.closest("a")) {
					closeDrawer();
				}
			});
		</script>
	</body>
</html>

<style>
	/* 位置・高さ(sticky/z-index/--topbar-height)は global.css の .app-topbar 側で定義する
	   (左右の帯が参照する --topbar-height を :root で公開する必要があるため)。
	   ここではトップバー内部の見た目(余白・タイポグラフィ)のみを扱う
	   (AppSidebar.astro と同じ役割分担)。 */
	.app-topbar-row-left {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.app-topbar-brand {
		font-weight: 800;
		font-size: var(--font-size-lg);
		white-space: nowrap;
	}

	.app-topbar-back {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-size: var(--font-size-md);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.app-topbar-back-icon {
		flex-shrink: 0;
		transition: transform 0.15s ease;
	}

	.app-topbar-back:hover {
		color: var(--color-primary);
	}

	.app-topbar-back:hover .app-topbar-back-icon {
		transform: translateX(-2px);
	}

	.app-topbar-title {
		font-weight: 800;
		font-size: var(--font-size-lg);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.app-topbar-status {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		white-space: nowrap;
	}

	/* 独立コントロール同士の間隔を、8pxと .second-bar--toolbar の24pxの中間にして
	   共通トップバー内で詰まりすぎないようにする。 */
	.app-topbar-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	/* 2026-07-27 ラウンド20 20-H2: ログイン中ユーザー向けのアカウント情報自体
	   (「ログイン中: xxx」+ ログアウト、および .app-topbar-account-email)は
	   AppSidebar.astro の最下段(.app-sidebar-account)へ移設したため削除したまま。
	   2026-07-28 ラウンド21: ただし chrome="public" 専用CTA用に .app-topbar-account と
	   そのモバイル/デスクトップ切り替えだけは復元する。旧ラウンド8 A-5で踏んだ罠
	   (global.css 側で `.app-topbar-account-desktop { display: none }` を書くと、
	   scoped styleの実質詳細度 0,2,0 に付ける `.app-topbar-account { display: flex }` に負けて
	   モバイルで2重表示・横スクロールが起きた)を再発させないため、この切り替えは
	   このファイルの scoped style 内だけで完結させ、global.css 側には一切書かない。 */
	.app-topbar-account {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
		/* 旧ラウンド8 A-5: flex-shrink:0 だとこのブロックが縮まず、幅900px境界かつ
		   ページ固有操作がある画面で右にはみ出して横スクロールしていた。
		   flex-shrink を既定値(1)に戻し min-width: 0 を足して他の帯と同じ縮小方針に揃える。 */
		min-width: 0;
	}

	.app-topbar-account-desktop {
		display: none;
	}

	@media (min-width: 900px) {
		.app-topbar-account-mobile {
			display: none;
		}

		.app-topbar-account-desktop {
			display: flex;
		}
	}

	@media (max-width: 899px) {
		/* 2026-07-26 ラウンド8 A-5: 幅390pxでページ固有操作(例: /box/[id]の「この個体を削除」)が
		   原因で本体行が横に収まらず横スクロールしていた。ページ固有操作(.app-topbar-actions)を
		   2行目に折り返せるようにする。 */
		.app-topbar-row-main {
			flex-wrap: wrap;
			row-gap: var(--space-2);
		}
	}
</style>
