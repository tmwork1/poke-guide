---
// 全ページ共通レイアウト(UI刷新、2026-07-25)。AppSidebar を常設し、
// デスクトップは固定サイドバー、モバイルはハンバーガーで開閉するドロワーにする。
//
// 2026-07-26 トップバー新設: docs/ui_proposal/個体編集_全体レイアウト.png のワイヤーフレーム
// (画面上端にサイドバー右隣から画面右端まで伸びる「トップバー 画面操作系」の帯があり、
// 左右の帯はその直下から始まる)に合わせ、デスクトップでも常設のトップバーを表示する。
// 個体編集ページ等の左右の帯が `height: calc(100vh - var(--topbar-height))` を組めるよう、
// トップバーの実測高さと一致する --topbar-height を global.css の :root で公開している
// (デスクトップ/モバイルで値が異なるため @media 内で上書きする。値がずれると左右の帯の
// 高さが狂うため、変更時は必ず実測して合わせ直すこと)。
//
// スロット構成(このレイアウトを使う各ページはこれに合わせて中身を差し込む):
//   slot="topbar-status"  … タイトル右の状態表示(例: 保存済み)。省略可。
//   slot="topbar-actions" … トップバー右側のページ固有操作(ボタン類)。省略可。
//   slot(default)         … 本文。
//   slot="head"           … <head> 内への追加(既存)。
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';

interface Props {
	title: string;
	description?: string;
	current?: "box" | "dev";
	bodyClass?: string;
	/** 指定すると「← 戻る」リンクをトップバー左端に出す。省略時は表示しない。 */
	backHref?: string;
	/** backHref 指定時のみ使用。省略時は「戻る」。 */
	backLabel?: string;
}

const { title, description, current, bodyClass, backHref, backLabel } = Astro.props;

const pageTitle = title === "Poke-Commons" ? title : `${title} | Poke-Commons`;

// 個体管理機能専用のログインレーン(src/middleware.ts が locals.user にセットする)。
// ダメージ計算・検索等の既存の匿名機能はこの値を参照しないため、ここで読むだけでは
// 既存ページの挙動に影響しない。
const user = Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<div class="app-shell">
			<header class="app-topbar">
				<!-- モバイル(900px未満)専用の1段目: ハンバーガー + サイト名 + アカウント情報。
				     デスクトップでは非表示(サイドバーに常時ブランドリンクがあるため不要)。 -->
				<div class="app-topbar-row app-topbar-row-brand">
					<div class="app-topbar-row-left">
						<button
							type="button"
							class="app-topbar-menu-button btn-ghost"
							id="app-sidebar-toggle"
							aria-controls="app-sidebar"
							aria-expanded="false"
							aria-label="メニューを開く"
						>
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="4" y1="7" x2="20" y2="7" />
								<line x1="4" y1="12" x2="20" y2="12" />
								<line x1="4" y1="17" x2="20" y2="17" />
							</svg>
						</button>
						<span class="app-topbar-brand">Poke-Commons</span>
					</div>
					<div class="app-topbar-account app-topbar-account-mobile">
						{
							user ? (
								<Fragment>
									<span class="app-topbar-account-email">ログイン中: {user.email ?? user.displayName ?? user.id}</span>
									<form method="POST" action="/api/auth/logout">
										<button type="submit" class="btn-ghost">ログアウト</button>
									</form>
								</Fragment>
							) : (
								<a class="btn-primary" href="/api/auth/login">ログイン</a>
							)
						}
					</div>
				</div>

				<!-- 全画面幅で使う本体行: 左=戻る+タイトル+状態、右=ページ固有操作+アカウント情報。
				     デスクトップではこれが唯一の行、モバイルでは2段目になる。 -->
				<div class="app-topbar-row app-topbar-row-main">
					<div class="app-topbar-left">
						{
							backHref && (
								<a class="app-topbar-back" href={backHref}>
									← {backLabel ?? "戻る"}
								</a>
							)
						}
						<span class="app-topbar-title">{title}</span>
						{Astro.slots.has("topbar-status") && (
							<span class="app-topbar-status">
								<slot name="topbar-status" />
							</span>
						)}
					</div>
					<div class="app-topbar-right">
						{Astro.slots.has("topbar-actions") && (
							<div class="app-topbar-actions">
								<slot name="topbar-actions" />
							</div>
						)}
						<div class="app-topbar-account app-topbar-account-desktop">
							{
								user ? (
									<Fragment>
										<span class="app-topbar-account-email">ログイン中: {user.email ?? user.displayName ?? user.id}</span>
										<form method="POST" action="/api/auth/logout">
											<button type="submit" class="btn-ghost">ログアウト</button>
										</form>
									</Fragment>
								) : (
									<a class="btn-primary" href="/api/auth/login">ログイン</a>
								)
							}
						</div>
					</div>
				</div>
			</header>

			<AppSidebar current={current} />

			<div class="app-sidebar-overlay" id="app-sidebar-overlay"></div>

			<main class="app-main">
				<slot />
			</main>
		</div>

		<script>
			// ドロワー開閉(モバイル専用): ハンバーガー / オーバーレイクリック / Esc / リンククリックで閉じる。
			const toggle = document.getElementById("app-sidebar-toggle");
			const sidebar = document.getElementById("app-sidebar");
			const overlay = document.getElementById("app-sidebar-overlay");

			function openDrawer() {
				sidebar?.classList.add("is-open");
				overlay?.classList.add("is-open");
				toggle?.setAttribute("aria-expanded", "true");
			}

			function closeDrawer() {
				sidebar?.classList.remove("is-open");
				overlay?.classList.remove("is-open");
				toggle?.setAttribute("aria-expanded", "false");
			}

			toggle?.addEventListener("click", () => {
				if (sidebar?.classList.contains("is-open")) {
					closeDrawer();
				} else {
					openDrawer();
				}
			});

			overlay?.addEventListener("click", closeDrawer);

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeDrawer();
				}
			});

			sidebar?.addEventListener("click", (event) => {
				const target = event.target as HTMLElement;
				if (target.closest("a")) {
					closeDrawer();
				}
			});
		</script>
	</body>
</html>

<style>
	/* 位置・高さ(sticky/z-index/--topbar-height)は global.css の .app-topbar 側で定義する
	   (左右の帯が参照する --topbar-height を :root で公開する必要があるため)。
	   ここではトップバー内部の見た目(余白・タイポグラフィ)のみを扱う
	   (AppSidebar.astro と同じ役割分担)。 */
	.app-topbar-menu-button {
		padding: var(--space-2);
		flex-shrink: 0;
	}

	.app-topbar-row-left {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.app-topbar-brand {
		font-weight: 800;
		font-size: var(--font-size-lg);
		white-space: nowrap;
	}

	.app-topbar-back {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-size: var(--font-size-md);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.app-topbar-back:hover {
		color: var(--color-primary);
	}

	.app-topbar-title {
		font-weight: 800;
		font-size: var(--font-size-lg);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.app-topbar-status {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		white-space: nowrap;
	}

	.app-topbar-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.app-topbar-account {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
		/* 2026-07-26 ラウンド8 A-5 検証中に発見: flex-shrink:0 だとこのブロックが一切縮まず、
		   幅900px(モバイル/デスクトップの境界)かつページ固有アクション(例: /box/[id]の
		   「この個体を削除」)がある画面で .app-topbar-account-email の overflow:hidden による
		   自動収縮(0まで縮む設計、下の.app-topbar-account-email参照)が効かず、
		   アカウント情報ブロックごと画面右にはみ出して横スクロールになっていた
		   (実測 scrollWidth 928 / clientWidth 900)。flex-shrink を既定値(1)に戻し
		   min-width: 0 を足して .app-topbar-left/.app-topbar-right と同じ縮小方針に揃える。 */
		min-width: 0;
	}

	.app-topbar-account-email {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 16em;
	}

	/* 2026-07-26 ラウンド8 A-5: このデスクトップ/モバイルのdisplay切り替えは元は global.css 側にあったが、
	   このブロック内の `.app-topbar-account { display: flex }` は Astro の scoped style により
	   実質詳細度 0,2,0 になる(`[data-astro-cid-*]` が付くため)。global.css 側の
	   `.app-topbar-account-desktop { display: none }`(詳細度 0,1,0)は scoped styleより先に
	   注入されるため、同じ詳細度でも後勝ちのscoped側に負けて常に `flex` のままだった
	   (アカウント情報がモバイル行・本体行の両方に重複表示され、横スクロールの原因になっていた)。
	   同じscoped詳細度レイヤーに揃える必要があるため、この切り替えは移設してここに置く。 */
	.app-topbar-account-desktop {
		display: none;
	}

	@media (min-width: 900px) {
		.app-topbar-account-mobile {
			display: none;
		}

		.app-topbar-account-desktop {
			display: flex;
		}
	}

	/* 2026-07-26 ラウンド8 A-5: 幅390pxでメールアドレスとページ固有操作が原因で
	   1段目・2段目とも横に収まらず横スクロールしていた。メールアドレスはモバイルでは
	   必須情報ではないため隠し、本体行(.app-topbar-row-main)はページ固有操作
	   (.app-topbar-actions)を2行目に折り返せるようにする。
	   上のdisplay切り替えと必ず同じファイル・同じscoped詳細度レイヤーに置くこと
	   (別ファイルに分けると詳細度の事故が再発する)。 */
	@media (max-width: 899px) {
		.app-topbar-account-email {
			display: none;
		}

		.app-topbar-row-main {
			flex-wrap: wrap;
			row-gap: var(--space-2);
		}
	}
</style>
